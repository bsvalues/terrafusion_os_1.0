#!/bin/bash
# ============================================================================
# TerraFusion Agent Governance Pre-Commit Hook
# ============================================================================
# This hook ENFORCES the rules in .ralph/AGENT_RULES.yml
# It runs BEFORE every commit and BLOCKS violations
#
# Installation:
#   cp .ralph/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
# ============================================================================

set -e

RALPH_ROOT="$(git rev-parse --show-toplevel)/.ralph"
LOG_DIR="$RALPH_ROOT/logs"
LOG_FILE="$LOG_DIR/pre-commit-$(date +%Y%m%d_%H%M%S).log"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

mkdir -p "$LOG_DIR" 2>/dev/null || true

log() {
    echo -e "$1" | tee -a "$LOG_FILE" 2>/dev/null || echo -e "$1"
}

log ""
log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
log "🔒 TerraFusion Agent Governance Pre-Commit Hook"
log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ============================================================================
# CHECK 1: Forbidden Path Violations
# ============================================================================
log ""
log "${YELLOW}[1/4] Checking forbidden paths...${NC}"

STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || echo "")
VIOLATIONS=""

# Forbidden patterns from AGENTS.md
FORBIDDEN_PATTERNS=(
    "ARCHIVE/"
    "specialized/"
    "applications/"
    "os-platform/ai-systems/ai-systems/ai-swarm/"
)

for file in $STAGED_FILES; do
    for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
        if [[ "$file" == *"$pattern"* ]]; then
            VIOLATIONS="$VIOLATIONS\n  ❌ $file (matches forbidden: $pattern)"
        fi
    done
done

if [[ -n "$VIOLATIONS" ]]; then
    log "${RED}❌ GOVERNANCE VIOLATION: Forbidden paths modified${NC}"
    log "$VIOLATIONS"
    log ""
    log "${RED}These paths are protected by AGENTS.md${NC}"
    log "Remove these files from your commit or get explicit authorization."
    exit 1
fi

log "${GREEN}✅ No forbidden path violations${NC}"

# ============================================================================
# CHECK 2: Hardcoded Port Violations (ZERO TOLERANCE)
# ============================================================================
log ""
log "${YELLOW}[2/4] Checking for hardcoded ports (ZERO TOLERANCE)...${NC}"

PORT_VIOLATIONS=""

# Forbidden port patterns
FORBIDDEN_PORTS=(
    "localhost:3000[^0-9]"
    "localhost:5000[^0-9]"
    "localhost:3001[^0-9]"
    "localhost:3002[^0-9]"
    ":5173"
    "port=3000"
    "port=5000"
    "PORT=3000"
    "PORT=5000"
)

for file in $STAGED_FILES; do
    if [[ -f "$file" && ! "$file" =~ \.md$ && ! "$file" =~ \.yml$ && ! "$file" =~ \.yaml$ ]]; then
        for port_pattern in "${FORBIDDEN_PORTS[@]}"; do
            if grep -qE "$port_pattern" "$file" 2>/dev/null; then
                PORT_VIOLATIONS="$PORT_VIOLATIONS\n  ❌ $file contains hardcoded port"
            fi
        done
    fi
done

if [[ -n "$PORT_VIOLATIONS" ]]; then
    log "${RED}❌ PORT VIOLATION (ZERO TOLERANCE)${NC}"
    log "$PORT_VIOLATIONS"
    log ""
    log "${YELLOW}Required format:${NC}"
    log "  Bash:       \${TF_API_PORT:-5046}"
    log "  JavaScript: process.env.TF_API_PORT || 5046"
    log "  Python:     os.environ.get('TF_API_PORT', 5046)"
    log ""
    log "See: AI_AGENT_PORT_RULES_STRICT.md"
    exit 1
fi

log "${GREEN}✅ No hardcoded port violations${NC}"

# ============================================================================
# CHECK 3: Frontend Path Validation
# ============================================================================
log ""
log "${YELLOW}[3/4] Checking frontend path compliance...${NC}"

FRONTEND_VIOLATIONS=""

for file in $STAGED_FILES; do
    # Check for legacy frontend paths (but not frontend-v2)
    if [[ "$file" =~ ^frontend/ && ! "$file" =~ ^frontend-v2/ ]]; then
        FRONTEND_VIOLATIONS="$FRONTEND_VIOLATIONS\n  ❌ $file (forbidden: legacy frontend)"
    fi
    if [[ "$file" =~ terrafusion/frontend/ ]]; then
        FRONTEND_VIOLATIONS="$FRONTEND_VIOLATIONS\n  ❌ $file (forbidden: old structure)"
    fi
done

if [[ -n "$FRONTEND_VIOLATIONS" ]]; then
    log "${RED}❌ FRONTEND VIOLATION${NC}"
    log "$FRONTEND_VIOLATIONS"
    log ""
    log "${YELLOW}Authorized frontend paths:${NC}"
    log "  ✅ experience-suite/temp-extract/experience-suite-v5/"
    log "  ✅ frontend-v2/"
    log ""
    log "See: AI_AGENT_FRONTEND_PROTECTION.md"
    exit 1
fi

log "${GREEN}✅ Frontend paths valid${NC}"

# ============================================================================
# CHECK 4: Evidence-Based Commit (Advisory)
# ============================================================================
log ""
log "${YELLOW}[4/4] Checking commit hygiene...${NC}"

# Count staged files
FILE_COUNT=$(echo "$STAGED_FILES" | wc -l)
if [[ $FILE_COUNT -gt 20 ]]; then
    log "${YELLOW}⚠️ Large commit detected ($FILE_COUNT files)${NC}"
    log "   Consider smaller, focused commits per AGENTS.md"
fi

log "${GREEN}✅ Commit hygiene check complete${NC}"

# ============================================================================
# ALL CHECKS PASSED
# ============================================================================
log ""
log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
log "${GREEN}✅ All governance checks passed${NC}"
log "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
log ""

exit 0
