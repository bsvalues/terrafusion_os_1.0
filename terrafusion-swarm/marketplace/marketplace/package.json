{
  "name": "@terrafusion/marketplace-api",
  "version": "2.0.0",
  "description": "TerraFusion Government Marketplace API - TypeScript implementation with FISMA compliance",
  "main": "dist/submission-api.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/submission-api.js",
    "dev": "ts-node-dev --respawn --transpile-only submission-api.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "terrafusion",
    "government",
    "marketplace",
    "api",
    "typescript",
    "fisma",
    "compliance"
  ],
  "author": "TerraFusion OS Team",
  "license": "Government-Use",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/terrafusion-os"
  },
  "bugs": {
    "url": "https://github.com/terrafusion/terrafusion-os/issues"
  },
  "homepage": "https://terrafusion.gov"
}