{
  "name": "devops-pipeline-config",
  "version": "2.0.0",
  "description": "DevOps Pipeline Configuration for TerraFusion OS",
  "environments": {
    "development": {
      "name": "Development",
      "url": "https://dev.terrafusion.local",
      "auto_deploy": true,
      "require_approval": false,
      "health_check_timeout": 30,
      "rollback_enabled": true
    },
    "staging": {
      "name": "Staging",
      "url": "https://staging.terrafusion.local", 
      "auto_deploy": false,
      "require_approval": true,
      "health_check_timeout": 60,
      "rollback_enabled": true
    },
    "production": {
      "name": "Production",
      "url": "https://terrafusion.gov",
      "auto_deploy": false,
      "require_approval": true,
      "health_check_timeout": 120,
      "rollback_enabled": true,
      "government_compliance": true
    },
    "disaster-recovery": {
      "name": "Disaster Recovery",
      "url": "https://dr.terrafusion.gov",
      "auto_deploy": false,
      "require_approval": true,
      "health_check_timeout": 180,
      "rollback_enabled": true,
      "government_compliance": true
    }
  },
  "pipeline_stages": [
    {
      "name": "checkout",
      "description": "Source code checkout from repository",
      "timeout": 300,
      "retry_count": 3,
      "required": true
    },
    {
      "name": "build",
      "description": "Build TerraFusion OS components",
      "timeout": 900,
      "retry_count": 2,
      "required": true,
      "commands": [
        "npm install",
        "npm run build",
        "npm run compile:backend"
      ]
    },
    {
      "name": "test",
      "description": "Run comprehensive test suite",
      "timeout": 1200,
      "retry_count": 1,
      "required": true,
      "commands": [
        "npm run test:unit",
        "npm run test:integration",
        "npm run test:e2e",
        "npm run test:government"
      ],
      "coverage_threshold": 85
    },
    {
      "name": "security-scan",
      "description": "Government security compliance scan",
      "timeout": 600,
      "retry_count": 1,
      "required": true,
      "tools": [
        "snyk",
        "npm-audit",
        "docker-security-scan",
        "government-compliance-scanner"
      ],
      "thresholds": {
        "critical": 0,
        "high": 2,
        "medium": 10
      }
    },
    {
      "name": "compliance-check",
      "description": "Government compliance validation",
      "timeout": 480,
      "retry_count": 1,
      "required": true,
      "standards": [
        "FISMA",
        "NIST_800_53",
        "Section_508",
        "FedRAMP"
      ],
      "minimum_score": 95
    },
    {
      "name": "deploy",
      "description": "Deploy to target environment",
      "timeout": 900,
      "retry_count": 2,
      "required": true,
      "strategies": [
        "blue-green",
        "rolling",
        "canary"
      ]
    },
    {
      "name": "post-deploy-tests",
      "description": "Post-deployment validation tests",
      "timeout": 600,
      "retry_count": 1,
      "required": true,
      "tests": [
        "health-check",
        "smoke-tests",
        "integration-tests",
        "performance-tests"
      ]
    }
  ],
  "government_compliance": {
    "FISMA": {
      "enabled": true,
      "level": "moderate",
      "controls": [
        "access_control",
        "audit_accountability", 
        "configuration_management",
        "identification_authentication",
        "incident_response",
        "risk_assessment",
        "system_communications_protection"
      ]
    },
    "NIST_800_53": {
      "enabled": true,
      "revision": "5",
      "baseline": "moderate",
      "control_families": [
        "AC", "AU", "CM", "IA", "IR", "RA", "SC", "SI"
      ]
    },
    "Section_508": {
      "enabled": true,
      "version": "refresh",
      "accessibility_standards": [
        "WCAG_2.1_AA",
        "keyboard_navigation",
        "screen_reader_compatibility"
      ]
    },
    "FedRAMP": {
      "enabled": false,
      "authorization": "low",
      "cloud_service_model": "SaaS"
    }
  },
  "notification_settings": {
    "email": {
      "enabled": true,
      "recipients": [
        "devops@terrafusion.gov",
        "security@terrafusion.gov",
        "compliance@terrafusion.gov"
      ],
      "events": [
        "pipeline_failure",
        "security_violation",
        "compliance_failure",
        "deployment_success",
        "rollback_initiated"
      ]
    },
    "slack": {
      "enabled": true,
      "webhook_url": "${SLACK_WEBHOOK_URL}",
      "channels": [
        "#devops-alerts",
        "#security-alerts",
        "#deployment-status"
      ]
    },
    "government_reporting": {
      "enabled": true,
      "report_frequency": "daily",
      "compliance_dashboard": true,
      "audit_trail": true
    }
  },
  "security_settings": {
    "vulnerability_scanning": {
      "enabled": true,
      "daily_scans": true,
      "auto_fix": false,
      "report_format": "government_standard"
    },
    "dependency_checking": {
      "enabled": true,
      "auto_update": false,
      "government_approved_only": true
    },
    "container_security": {
      "enabled": true,
      "base_image_scanning": true,
      "runtime_protection": true
    },
    "secrets_management": {
      "enabled": true,
      "vault_integration": true,
      "rotation_policy": "90_days"
    }
  },
  "performance_monitoring": {
    "enabled": true,
    "metrics": [
      "build_time",
      "test_duration", 
      "deployment_time",
      "success_rate",
      "mean_time_to_recovery"
    ],
    "thresholds": {
      "build_time_max": 900,
      "test_duration_max": 1200,
      "deployment_time_max": 900,
      "success_rate_min": 95
    },
    "alerting": {
      "enabled": true,
      "threshold_breach": true,
      "trend_analysis": true
    }
  },
  "backup_and_recovery": {
    "enabled": true,
    "backup_frequency": "daily",
    "retention_period": "90_days",
    "government_encryption": true,
    "offsite_storage": true,
    "recovery_testing": "monthly"
  },
  "audit_logging": {
    "enabled": true,
    "events": [
      "pipeline_execution",
      "deployment_actions",
      "user_activities",
      "security_events",
      "compliance_checks"
    ],
    "retention": "7_years",
    "government_format": true,
    "real_time_monitoring": true
  }
}