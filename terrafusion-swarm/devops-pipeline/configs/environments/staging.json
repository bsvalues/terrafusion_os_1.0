{
  "name": "staging",
  "url": "https://staging.terrafusion.local",
  "database": {
    "host": "staging-db.terrafusion.local",
    "port": \${{TF_POSTGRES_PORT:-5432}},
    "ssl": true
  },
  "redis": {
    "host": "staging-cache.terrafusion.local",
    "port": \${{TF_POSTGRES_PORT:-5432}}
  },
  "auto_deploy": false,
  "require_approval": true,
  "health_checks": {
    "enabled": true,
    "timeout": 60,
    "endpoints": [
      "/health",
      "/api/health",
      "/modules/health"
    ]
  }
}
