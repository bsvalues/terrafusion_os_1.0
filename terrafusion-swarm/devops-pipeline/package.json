{
  "name": "terrafusion-devops-pipeline",
  "version": "2.0.0",
  "description": "TerraFusion OS Enterprise DevOps Pipeline - Government-grade CI/CD",
  "type": "commonjs",
  "main": "pipeline-orchestrator.js",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "ws": "^8.13.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "rate-limiter-flexible": "^2.4.1",
    "node-cron": "^3.0.2",
    "axios": "^1.4.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "winston": "^3.10.0",
    "express-rate-limit": "^6.8.1",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.1",
    "node-cache": "^5.1.2",
    "redis": "^4.6.7",
    "dockerode": "^3.3.5",
    "yaml": "^2.3.1",
    "tar": "^6.1.15",
    "node-ssh": "^13.1.0",
    "pm2": "^5.3.0",
    "nodemailer": "^6.9.4",
    "simple-git": "^3.19.1"
  },
  "devDependencies": {
    "jest": "^29.6.1",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.1",
    "@types/node": "^20.4.5",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0"
  },
  "scripts": {
    "start": "node pipeline-orchestrator.js",
    "dev": "nodemon pipeline-orchestrator.js",
    "test": "jest",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "jest --config=jest.e2e.config.js",
    "test:government": "jest --testPathPattern=government",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write .",
    "build": "node build-pipeline.js",
    "deploy": "node deploy-pipeline.js",
    "deploy:dev": "node deploy-pipeline.js --env=development",
    "deploy:staging": "node deploy-pipeline.js --env=staging",
    "deploy:production": "node deploy-pipeline.js --env=production",
    "docker:build": "docker build -t terrafusion-devops .",
    "docker:run": "docker run -p 5002:5002 terrafusion-devops",
    "security:scan": "node security-scanner.js",
    "compliance:audit": "node compliance-auditor.js",
    "performance:test": "node performance-tester.js",
    "rollback": "node rollback-manager.js",
    "monitoring:start": "node monitoring-agent.js",
    "backup:create": "node backup-manager.js",
    "validate:config": "node config-validator.js"
  },
  "keywords": [
    "devops",
    "ci-cd",
    "government",
    "terrafusion",
    "pipeline",
    "automation"
  ],
  "author": "TerraFusion Development Team",
  "license": "GOVERNMENT"
}