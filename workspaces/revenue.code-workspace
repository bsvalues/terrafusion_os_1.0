{
  "folders": [
    {
      "path": "../marketplace/revenue/tax-collection",
      "name": "💰 Tax Collection Engine"
    },
    {
      "path": "../marketplace/revenue/billing-automation",
      "name": "📋 Billing Automation"
    },
    {
      "path": "../marketplace/revenue/payment-processing",
      "name": "💳 Payment Processing"
    },
    {
      "path": "../marketplace/revenue/revenue-forecasting",
      "name": "📈 Revenue Forecasting"
    },
    {
      "path": "../marketplace/revenue/financial-analytics",
      "name": "📊 Financial Analytics"
    },
    {
      "path": "../marketplace/revenue/compliance-reporting",
      "name": "📋 Compliance Reporting"
    },
    {
      "path": "../marketplace/revenue/testing",
      "name": "🧪 Revenue Tests"
    },
    {
      "path": "../SDK",
      "name": "📦 Platform SDK (read-only)"
    },
    {
      "path": "../backend",
      "name": "🔧 Shared Backend (read-only)"
    },
    {
      "path": "../docs/revenue",
      "name": "📚 Revenue Docs"
    },
    {
      "path": "../config",
      "name": "⚙️ Config (shared)"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/out": true,
      "**/.pytest_cache": true,
      "../marketplace/*/": true,
      "!../marketplace/revenue": false,
      "../frontend": true,
      "../backend": true,
      "../os-platform": true,
      "../terrafusion-cos": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/out": true,
      "../frontend": true,
      "../backend": true,
      "../os-platform": true
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "python.defaultInterpreter": "./marketplace/revenue/.venv/bin/python",
    "eslint.workingDirectories": [
      "./marketplace/revenue/tax-collection",
      "./marketplace/revenue/billing-automation"
    ],
    "terrafusion.sync": {
      "autoSync": true,
      "syncInterval": 10,
      "conflictResolution": "prompt",
      "sharedState": {
        "backend": "read-only",
        "sdk": "read-only",
        "config": "shared-write"
      },
      "revenueIntegration": true
    },
    "terrafusion.revenue": {
      "enableTaxCollection": true,
      "billingAutomation": true,
      "paymentProcessing": true,
      "revenueForecasting": true,
      "financialAnalytics": true,
      "complianceReporting": true
    },
    "terrafusion.financial": {
      "paymentGateway": "stripe",
      "taxCalculation": "automated",
      "billGeneration": "scheduled",
      "forecastingModel": "ml-enhanced",
      "analyticsEngine": "advanced"
    },
    "terrafusion.compliance": {
      "fismaMode": "HIGH",
      "nist80053": true,
      "pciDss": true,
      "soxCompliance": true,
      "financialReporting": true,
      "auditTrail": "comprehensive"
    },
    "terrafusion.security": {
      "financialDataEncryption": "AES-256-GCM",
      "paymentSecurity": "tokenization",
      "fraudDetection": true,
      "accessControl": "strict"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.debugpy",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "streetsidesoftware.code-spell-checker",
      "ms-toolsai.jupyter",
      "ms-azuretools.vscode-docker",
      "redhat.vscode-yaml",
      "ms-vscode.vscode-json",
      "usernamehw.errorlens"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Start Tax Collection Engine",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/revenue/tax-collection",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "console": "integratedTerminal",
        "env": {
          "TERRAFUSION_SERVICE": "revenue",
          "TAX_MODE": "development",
          "COLLECTION_ENGINE": "enabled"
        }
      },
      {
        "name": "Debug Payment Processing",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/revenue/payment-processing",
        "program": "payment_processor.js",
        "console": "integratedTerminal",
        "env": {
          "PAYMENT_DEBUG": "true",
          "STRIPE_SECRET_KEY": "${env:STRIPE_SECRET_KEY}"
        }
      },
      {
        "name": "Debug Revenue Forecasting",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/revenue/revenue-forecasting",
        "program": "forecasting_engine.py",
        "console": "integratedTerminal",
        "env": {
          "FORECAST_DEBUG": "true",
          "ML_MODELS_ENABLED": "true"
        }
      },
      {
        "name": "Start Financial Analytics",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/revenue/financial-analytics",
        "program": "analytics_dashboard.py",
        "console": "integratedTerminal",
        "env": {
          "ANALYTICS_DEBUG": "true",
          "DASHBOARD_MODE": "development"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build Revenue System",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "build:revenue"
        ],
        "problemMatcher": [
          "$tsc"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Test Revenue System",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "test:revenue"
        ],
        "problemMatcher": [],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      },
      {
        "label": "Generate Tax Bills",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "generate:bills"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/revenue/billing-automation"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Process Payments",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "process:payments"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/revenue/payment-processing"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Train Forecasting Models",
        "type": "shell",
        "command": "python",
        "args": [
          "train_models.py"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/revenue/revenue-forecasting"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Generate Revenue Report",
        "type": "shell",
        "command": "python",
        "args": [
          "generate_revenue_report.py"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/revenue/financial-analytics"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Compliance Audit",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "audit:compliance"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/revenue/compliance-reporting"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "PCI DSS Validation",
        "type": "shell",
        "command": "./SDK/tools/compliance-check.sh",
        "args": [
          "--service=revenue",
          "--pci-dss"
        ],
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Financial Security Scan",
        "type": "shell",
        "command": "./SDK/tools/security-scan.sh",
        "args": [
          "--service=revenue",
          "--financial-security"
        ],
        "problemMatcher": [],
        "group": "none"
      }
    ]
  }
}