{
  "folders": [
    {
      "path": "../marketplace/government-edition",
      "name": "🏛️ Government Applications"
    },
    {
      "path": "../SDK",
      "name": "📦 Government SDK"
    },
    {
      "path": "../config",
      "name": "⚙️ Government Configuration"
    },
    {
      "path": "../tests",
      "name": "🧪 Government Tests"
    },
    {
      "path": "../docs",
      "name": "📚 Government Documentation"
    }
  ],
  "settings": {
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#03DAC6",
      "titleBar.activeForeground": "#000000"
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/backend": true,
      "**/frontend": true,
      "**/platform": true
    },
    "terrafusion.role": "government_applications",
    "terrafusion.responsibility": "compliance_features"
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.vscode-typescript-next",
      "ms-dotnettools.csharp",
      "gruntfuggly.todo-tree"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Government Edition",
        "type": "node",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build Government Edition",
        "type": "shell",
        "command": "echo 'Build task for ${workspaceFolder}'",
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Test Government Edition",
        "type": "shell",
        "command": "echo 'Test task for ${workspaceFolder}'",
        "problemMatcher": [],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      }
    ]
  }
}
