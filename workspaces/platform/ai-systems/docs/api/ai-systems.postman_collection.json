{
  "info": {
    "name": "Ai Systems API",
    "description": "AI infrastructure and model management APIs - TerraFusion Government API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "tokenUrl",
        "value": "https://auth.terrafusionmarket.com/oauth/token",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "https://auth.terrafusionmarket.com/oauth/authorize",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "ai-systems:read ai-systems:write",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.terrafusionmarket.com/api/v1/ai",
      "type": "string"
    },
    {
      "key": "workspace",
      "value": "ai-systems",
      "type": "string"
    },
    {
      "key": "version",
      "value": "1.0.0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "AI model registry",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/models",
          "host": ["{{baseUrl}}"],
          "path": ["models"]
        }
      },
      "response": []
    },
    {
      "name": "AI inference requests",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/inference",
          "host": ["{{baseUrl}}"],
          "path": ["inference"]
        }
      },
      "response": []
    },
    {
      "name": "Model training jobs",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/training",
          "host": ["{{baseUrl}}"],
          "path": ["training"]
        }
      },
      "response": []
    },
    {
      "name": "AI system monitoring",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/monitoring",
          "host": ["{{baseUrl}}"],
          "path": ["monitoring"]
        }
      },
      "response": []
    }
  ]
}
