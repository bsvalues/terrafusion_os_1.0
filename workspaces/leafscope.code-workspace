{
  "folders": [
    {
      "path": "../marketplace/LeafScope/api",
      "name": "🌿 LeafScope API"
    },
    {
      "path": "../marketplace/LeafScope/core-services",
      "name": "📊 Environmental Analytics Core"
    },
    {
      "path": "../marketplace/LeafScope/mapping-engine",
      "name": "🗺️ GIS Mapping Engine"
    },
    {
      "path": "../marketplace/LeafScope/sensor-integration",
      "name": "📡 IoT Sensor Integration"
    },
    {
      "path": "../marketplace/LeafScope/data-visualization",
      "name": "📈 Environmental Data Visualization"
    },
    {
      "path": "../marketplace/LeafScope/testing",
      "name": "🧪 LeafScope Tests"
    },
    {
      "path": "../SDK",
      "name": "📦 Platform SDK (read-only)"
    },
    {
      "path": "../backend",
      "name": "🔧 Shared Backend (read-only)"
    },
    {
      "path": "../docs/leafscope",
      "name": "📚 LeafScope Docs"
    },
    {
      "path": "../config",
      "name": "⚙️ Config (shared)"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/__pycache__": true,
      "**/venv": true,
      "../marketplace/*/": true,
      "!../marketplace/LeafScope": false,
      "../frontend": true,
      "../backend": true,
      "../os-platform": true,
      "../terrafusion-cos": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/__pycache__": true,
      "../frontend": true,
      "../backend": true,
      "../os-platform": true
    },
    "python.defaultInterpreterPath": "./marketplace/LeafScope/sensor-integration/venv/bin/python",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "eslint.workingDirectories": [
      "./marketplace/LeafScope/api"
    ],
    "terrafusion.sync": {
      "autoSync": true,
      "syncInterval": 25,
      "conflictResolution": "prompt",
      "sharedState": {
        "backend": "read-only",
        "sdk": "read-only",
        "config": "shared-write"
      },
      "environmentalDataProtection": true
    },
    "terrafusion.environmental": {
      "enableGISMapping": true,
      "iotSensorIntegration": true,
      "environmentalAnalytics": true,
      "dataVisualization": true
    },
    "terrafusion.compliance": {
      "fismaMode": "MODERATE",
      "nist80053": true,
      "section508": true,
      "auditTrail": "comprehensive",
      "environmentalCompliance": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "streetsidesoftware.code-spell-checker",
      "usernamehw.errorlens",
      "eamodio.gitlens",
      "ms-vscode.vscode-json",
      "ms-azuretools.vscode-docker"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Start LeafScope API",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/LeafScope/api",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "console": "integratedTerminal",
        "env": {
          "TERRAFUSION_SERVICE": "leafscope",
          "ENVIRONMENTAL_ANALYTICS": "true"
        }
      },
      {
        "name": "Start Environmental Analytics Core",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/LeafScope/core-services",
        "program": "analytics_engine.py",
        "console": "integratedTerminal",
        "env": {
          "ENVIRONMENTAL_DEBUG": "true",
          "GIS_INTEGRATION": "true"
        }
      },
      {
        "name": "Debug IoT Sensor Integration",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/LeafScope/sensor-integration",
        "program": "sensor_manager.py",
        "console": "integratedTerminal",
        "env": {
          "IOT_DEBUG": "true",
          "SENSOR_SIMULATION": "true"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build LeafScope",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "build:leafscope"
        ],
        "problemMatcher": [
          "$tsc"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Test LeafScope",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "test:leafscope"
        ],
        "problemMatcher": [],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      },
      {
        "label": "Train Environmental Models",
        "type": "shell",
        "command": "python",
        "args": [
          "train_environmental_models.py",
          "--dataset=environmental"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/LeafScope/core-services"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Test IoT Sensor Connection",
        "type": "shell",
        "command": "python",
        "args": [
          "test_sensors.py",
          "--simulate"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/LeafScope/sensor-integration"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Generate GIS Maps",
        "type": "shell",
        "command": "python",
        "args": [
          "generate_maps.py",
          "--region=benton-county"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/LeafScope/mapping-engine"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Sync with Backend Changes",
        "type": "shell",
        "command": "./SDK/tools/sync-backend-changes.sh",
        "args": [
          "--service=leafscope"
        ],
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Validate Integration",
        "type": "shell",
        "command": "./SDK/tools/validate-integration.sh",
        "args": [
          "--service=leafscope",
          "--environmental-systems"
        ],
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Security Compliance Scan",
        "type": "shell",
        "command": "./SDK/tools/security-scan.sh",
        "args": [
          "--service=leafscope",
          "--fisma-moderate",
          "--environmental-compliance"
        ],
        "problemMatcher": [],
        "group": "none"
      }
    ]
  }
}