{
  "folders": [
    {
      "path": "../terra-sync/api",
      "name": "🌐 TerraSync API"
    },
    {
      "path": "../terra-sync/core-services",
      "name": "⚡ C# .NET 8 Core"
    },
    {
      "path": "../terra-sync/harris-pacs-integration",
      "name": "🏛️ Harris PACS v12.4.7"
    },
    {
      "path": "../terra-sync/tyler-integration",
      "name": "📊 Tyler Technologies"
    },
    {
      "path": "../terra-sync/aumentum-integration",
      "name": "📈 Aumentum Systems"
    },
    {
      "path": "../terra-sync/county-connectors",
      "name": "🏢 County System Connectors"
    },
    {
      "path": "../terra-sync/testing",
      "name": "🧪 TerraSync Tests"
    },
    {
      "path": "../SDK",
      "name": "📦 Platform SDK (read-only)"
    },
    {
      "path": "../backend",
      "name": "🔧 Shared Backend (read-only)"
    },
    {
      "path": "../docs/terra-sync",
      "name": "📚 TerraSync Docs"
    },
    {
      "path": "../config",
      "name": "⚙️ Config (shared)"
    },
    {
      "path": "../docs/terra_sync",
      "name": "📚 Terra-Sync Docs"
    },
    {
      "path": "../../OneDrive/Desktop/from D/TerraFusionSync_PRODUCTION"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/bin": true,
      "**/obj": true,
      "**/.vs": true,
      "**/packages": true,
      "../marketplace": true,
      "../frontend": true,
      "../os-platform": true,
      "../terrafusion-cos": true,
      "../costforge-ai": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/bin": true,
      "**/obj": true,
      "../marketplace": true,
      "../frontend": true,
      "../os-platform": true,
      "../costforge-ai": true
    },
    "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
    "dotnet.inlayHints.enableInlayHintsForParameters": true,
    "dotnet.inlayHints.enableInlayHintsForLiteralParameters": true,
    "dotnet.inlayHints.enableInlayHintsForIndexerParameters": true,
    "dotnet.inlayHints.enableInlayHintsForObjectCreationParameters": true,
    "dotnet.inlayHints.enableInlayHintsForOtherParameters": true,
    "dotnet.inlayHints.enableInlayHintsForTypeParameters": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "eslint.workingDirectories": [
      "./terra-sync/api"
    ],
    "terrafusion.sync": {
      "autoSync": true,
      "syncInterval": 15,
      "conflictResolution": "prompt",
      "sharedState": {
        "backend": "read-only",
        "sdk": "read-only",
        "config": "shared-write"
      },
      "countyDataProtection": true
    },
    "terrafusion.integration": {
      "harrisPacsVersion": "12.4.7",
      "tylerTechnologies": true,
      "aumentumSystems": true,
      "enableRealTimeSync": true,
      "syncBatchSize": 1000,
      "maxRetryAttempts": 3
    },
    "terrafusion.compliance": {
      "fismaMode": "HIGH",
      "nist80053": true,
      "section508": true,
      "auditTrail": "comprehensive",
      "countyDataSovereignty": true
    },
    "terrafusion.performance": {
      "connectionPoolSize": 20,
      "queryTimeout": 30,
      "maxConcurrentSyncs": 10,
      "enableBentonOptimizations": true
    },
    "powershell.cwd": "🌐 TerraSync API"
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csharp",
      "ms-dotnettools.vscode-dotnet-runtime",
      "ms-dotnettools.csdevkit",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "streetsidesoftware.code-spell-checker",
      "usernamehw.errorlens",
      "eamodio.gitlens",
      "ms-vscode.vscode-json",
      "ms-azuretools.vscode-docker",
      "redhat.vscode-yaml",
      "ms-vscode.powershell",
      "humao.rest-client"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Start TerraSync API",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/terra-sync/api",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "console": "integratedTerminal",
        "env": {
          "TERRAFUSION_SERVICE": "terra-sync",
          "HARRIS_PACS_VERSION": "12.4.7"
        }
      },
      {
        "name": "Start C# Core Services",
        "type": "coreclr",
        "request": "launch",
        "cwd": "${workspaceFolder}/terra-sync/core-services",
        "program": "${workspaceFolder}/terra-sync/core-services/bin/Debug/net8.0/TerraSync.Core.dll",
        "console": "integratedTerminal",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "TERRAFUSION_SERVICE": "terra-sync-core",
          "BENTON_COUNTY_OPTIMIZATION": "true"
        }
      },
      {
        "name": "Debug Harris PACS Integration",
        "type": "coreclr",
        "request": "launch",
        "cwd": "${workspaceFolder}/terra-sync/harris-pacs-integration",
        "program": "${workspaceFolder}/terra-sync/harris-pacs-integration/bin/Debug/net8.0/TerraSync.HarrisPacs.dll",
        "console": "integratedTerminal",
        "args": [
          "--debug",
          "--version=12.4.7"
        ],
        "env": {
          "HARRIS_PACS_DEBUG": "true",
          "PARCEL_COUNT": "89247"
        }
      },
      {
        "name": "Debug Tyler Integration",
        "type": "coreclr",
        "request": "launch",
        "cwd": "${workspaceFolder}/terra-sync/tyler-integration",
        "program": "${workspaceFolder}/terra-sync/tyler-integration/bin/Debug/net8.0/TerraSync.Tyler.dll",
        "console": "integratedTerminal",
        "env": {
          "TYLER_DEBUG": "true",
          "VISION_INTEGRATION": "true"
        }
      },
      {
        "name": "Debug Aumentum Integration",
        "type": "coreclr",
        "request": "launch",
        "cwd": "${workspaceFolder}/terra-sync/aumentum-integration",
        "program": "${workspaceFolder}/terra-sync/aumentum-integration/bin/Debug/net8.0/TerraSync.Aumentum.dll",
        "console": "integratedTerminal",
        "env": {
          "AUMENTUM_DEBUG": "true"
        }
      }
    ],
    "compounds": [
      {
        "name": "Start Full TerraSync System",
        "configurations": [
          "Start TerraSync API",
          "Start C# Core Services"
        ],
        "presentation": {
          "hidden": false,
          "group": "terra-sync",
          "order": 1
        }
      },
      {
        "name": "Debug All County Integrations",
        "configurations": [
          "Debug Harris PACS Integration",
          "Debug Tyler Integration",
          "Debug Aumentum Integration"
        ],
        "presentation": {
          "hidden": false,
          "group": "county-integrations",
          "order": 2
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build TerraSync",
        "type": "shell",
        "command": "dotnet",
        "args": [
          "build",
          "--configuration",
          "Debug"
        ],
        "options": {
          "cwd": "${workspaceFolder}/terra-sync/core-services"
        },
        "problemMatcher": [
          "$msCompile"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Test TerraSync",
        "type": "shell",
        "command": "dotnet",
        "args": [
          "test",
          "--configuration",
          "Debug",
          "--logger",
          "console;verbosity=detailed"
        ],
        "options": {
          "cwd": "${workspaceFolder}/terra-sync/testing"
        },
        "problemMatcher": [
          "$msCompile"
        ],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      },
      {
        "label": "Restore NuGet Packages",
        "type": "shell",
        "command": "dotnet",
        "args": [
          "restore"
        ],
        "options": {
          "cwd": "${workspaceFolder}/terra-sync"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Build Harris PACS Integration",
        "type": "shell",
        "command": "dotnet",
        "args": [
          "build",
          "--configuration",
          "Debug"
        ],
        "options": {
          "cwd": "${workspaceFolder}/terra-sync/harris-pacs-integration"
        },
        "problemMatcher": [
          "$msCompile"
        ],
        "group": "none"
      },
      {
        "label": "Test Harris PACS v12.4.7 Connection",
        "type": "shell",
        "command": "dotnet",
        "args": [
          "run",
          "--",
          "--test-connection",
          "--version=12.4.7"
        ],
        "options": {
          "cwd": "${workspaceFolder}/terra-sync/harris-pacs-integration"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Sync Benton County Data",
        "type": "shell",
        "command": "dotnet",
        "args": [
          "run",
          "--",
          "--county=benton",
          "--parcels=89247",
          "--batch-size=1000"
        ],
        "options": {
          "cwd": "${workspaceFolder}/terra-sync/core-services"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Validate County Data Integrity",
        "type": "shell",
        "command": "dotnet",
        "args": [
          "run",
          "--",
          "--validate-integrity",
          "--county=benton"
        ],
        "options": {
          "cwd": "${workspaceFolder}/terra-sync/testing"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Sync with Backend Changes",
        "type": "shell",
        "command": "./SDK/tools/sync-backend-changes.sh",
        "args": [
          "--service=terra-sync"
        ],
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Validate Integration",
        "type": "shell",
        "command": "./SDK/tools/validate-integration.sh",
        "args": [
          "--service=terra-sync",
          "--county-systems"
        ],
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Security Compliance Scan",
        "type": "shell",
        "command": "./SDK/tools/security-scan.sh",
        "args": [
          "--service=terra-sync",
          "--fisma-high",
          "--county-data-protection"
        ],
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Performance Benchmark",
        "type": "shell",
        "command": "dotnet",
        "args": [
          "run",
          "--",
          "--benchmark",
          "--parcels=89247",
          "--target-latency=50ms"
        ],
        "options": {
          "cwd": "${workspaceFolder}/terra-sync/testing"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Deploy to Staging",
        "type": "shell",
        "command": "./SDK/tools/deploy-staging.sh",
        "args": [
          "--service=terra-sync",
          "--county-ready"
        ],
        "problemMatcher": [],
        "group": "none"
      }
    ]
  }
}
