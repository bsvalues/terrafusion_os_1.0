{
  "devDependencies": {
    "eslint": "^8.0.0",
    "typescript": "^5.0.0",
    "prettier": "^3.0.0",
    "jest": "^29.0.0",
    "@types/node": "^20.0.0"
  },
  "main": "index.js",
