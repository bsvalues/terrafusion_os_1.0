{
  "info": {
    "name": "Terra Justice API",
    "description": "Justice system operations and case management APIs - TerraFusion Government API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "tokenUrl",
        "value": "https://auth.terrafusion.gov/oauth/token",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "https://auth.terrafusion.gov/oauth/authorize",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "terra-justice:read terra-justice:write",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.terrafusion.gov/api/v1/justice",
      "type": "string"
    },
    {
      "key": "workspace",
      "value": "terra-justice",
      "type": "string"
    },
    {
      "key": "version",
      "value": "1.0.0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "Justice case management",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cases",
          "host": ["{{baseUrl}}"],
          "path": ["cases"]
        }
      },
      "response": []
    },
    {
      "name": "Defendant information",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/defendants",
          "host": ["{{baseUrl}}"],
          "path": ["defendants"]
        }
      },
      "response": []
    },
    {
      "name": "Court proceeding records",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/court-proceedings",
          "host": ["{{baseUrl}}"],
          "path": ["court-proceedings"]
        }
      },
      "response": []
    },
    {
      "name": "Sentencing information",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/sentencing",
          "host": ["{{baseUrl}}"],
          "path": ["sentencing"]
        }
      },
      "response": []
    }
  ]
}
