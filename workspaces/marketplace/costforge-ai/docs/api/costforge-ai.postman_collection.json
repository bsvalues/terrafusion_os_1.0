{
  "info": {
    "name": "Costforge Ai API",
    "description": "Cost analysis and budget optimization APIs - TerraFusion Government API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "tokenUrl",
        "value": "https://auth.terrafusion.gov/oauth/token",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "https://auth.terrafusion.gov/oauth/authorize",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "costforge-ai:read costforge-ai:write",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.terrafusion.gov/api/v1/cost-analysis",
      "type": "string"
    },
    {
      "key": "workspace",
      "value": "costforge-ai",
      "type": "string"
    },
    {
      "key": "version",
      "value": "1.0.0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "AI-powered cost analysis",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cost-analysis",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cost-analysis"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Budget optimization recommendations",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/budget-optimization",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "budget-optimization"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Cost forecasting models",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/forecasting",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "forecasting"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Cost analysis reports",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reports",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "reports"
          ]
        }
      },
      "response": []
    }
  ]
}