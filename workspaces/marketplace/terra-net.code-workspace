{
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "cwd": "../../marketplace/terra-net/frontend",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "name": "Start Terra Net Frontend"
      },
      {
        "type": "debugpy",
        "cwd": "../../marketplace/terra-net/backend",
        "program": "../../marketplace/terra-net/backend/main.py",
        "name": "Start Terra Net Backend"
      },
      {
        "type": "node",
        "cwd": "../../marketplace/terra-net/mcp-server",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "name": "Start Terra Net MCP Server"
      }
    ]
  },
  "tasks": {
    "tasks": [
      {
        "cwd": "../../marketplace/terra-net",
        "args": [
          "run",
          "build"
        ],
        "command": "npm",
        "label": "Build Terra Net"
      },
      {
        "cwd": "../../marketplace/terra-net",
        "args": [
          "run",
          "test"
        ],
        "command": "npm",
        "label": "Test Terra Net"
      }
    ],
    "version": "2.0.0"
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.black-formatter"
    ]
  },
  "folders": [
    {
      "name": "💼 Terra Net",
      "path": "../../marketplace/terra-net"
    },
    {
      "name": "📦 Platform SDK (read-only)",
      "path": "../../platform/sdk"
    },
    {
      "name": "🎨 Design System (read-only)",
      "path": "../../platform/design-system"
    },
    {
      "name": "🧪 Tests",
      "path": "../../tests/marketplace/terra-net"
    },
    {
      "name": "📚 Terra Net Docs",
      "path": "../../docs/marketplace/terra-net.md"
    }
  ],
  "settings": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    },
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#f59e0b",
      "titleBar.activeForeground": "#ffffff"
    },
    "files.exclude": {
      "../../os-platform": true,
      "**/node_modules": true,
      "../../terrafusion-cos": true,
      "../../marketplace/*": true,
      "!../../marketplace/terra-net": true,
      "../../backend": true,
      "**/dist": true,
      "../../frontend": true
    },
    "editor.formatOnSave": true
  }
}

