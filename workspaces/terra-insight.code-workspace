{
  "folders": [
    {
      "path": "../terra-insight/api",
      "name": "📊 TerraInsight API"
    },
    {
      "path": "../terra-insight/analytics-engine",
      "name": "🧠 Analytics Engine"
    },
    {
      "path": "../terra-insight/reporting-services",
      "name": "📈 Reporting Services"
    },
    {
      "path": "../terra-insight/data-visualization",
      "name": "📉 Data Visualization"
    },
    {
      "path": "../terra-insight/ai-analytics",
      "name": "🤖 AI-Powered Analytics"
    },
    {
      "path": "../terra-insight/testing",
      "name": "🧪 TerraInsight Tests"
    },
    {
      "path": "../SDK",
      "name": "📦 Platform SDK (read-only)"
    },
    {
      "path": "../backend",
      "name": "🔧 Shared Backend (read-only)"
    },
    {
      "path": "../docs/terra-insight",
      "name": "📚 TerraInsight Docs"
    },
    {
      "path": "../config",
      "name": "⚙️ Config (shared)"
    },
    {
      "path": "../docs/terra_insight",
      "name": "📚 Terra-Insight Docs"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/__pycache__": true,
      "**/venv": true,
      "../marketplace": true,
      "../frontend": true,
      "../os-platform": true,
      "../terrafusion-cos": true
    },
    "python.defaultInterpreterPath": "./terra-insight/ai-analytics/venv/bin/python",
    "editor.formatOnSave": true,
    "terrafusion.sync": {
      "autoSync": true,
      "syncInterval": 20,
      "analyticsDataProtection": true,
      "aiSwarmIntegration": true,
      "conflictResolution": "terra-priority",
      "sharedState": {
        "backend": "read-only",
        "sdk": "read-only",
        "config": "shared-write"
      }
    },
    "terrafusion.ai": {
      "enableAnalyticsAI": true,
      "predictiveModeling": true,
      "swarmCoordination": true,
      "commandPortalIntegration": true
    },
    "terrafusion.compliance": {
      "fismaMode": "MODERATE",
      "analyticsCompliance": true,
      "dataVisualizationCompliance": true,
      "nist80053": true,
      "auditTrail": "comprehensive"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "streetsidesoftware.code-spell-checker",
      "usernamehw.errorlens",
      "eamodio.gitlens",
      "ms-toolsai.jupyter"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Start TerraInsight API",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/terra-insight/api",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "console": "integratedTerminal",
        "env": {
          "TERRAFUSION_SERVICE": "terra-insight",
          "AI_ANALYTICS": "true"
        }
      },
      {
        "name": "Start Analytics Engine",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/terra-insight/ai-analytics",
        "program": "analytics_engine.py",
        "console": "integratedTerminal",
        "env": {
          "ANALYTICS_DEBUG": "true",
          "SWARM_INTEGRATION": "true"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build TerraInsight",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "build:terra-insight"
        ],
        "problemMatcher": [
          "$tsc"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Test TerraInsight",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "test:terra-insight"
        ],
        "problemMatcher": [],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      },
      {
        "label": "Train AI Models",
        "type": "shell",
        "command": "python",
        "args": [
          "train_models.py",
          "--analytics"
        ],
        "options": {
          "cwd": "${workspaceFolder}/terra-insight/ai-analytics"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Sync with Command Portal",
        "type": "shell",
        "command": "./SDK/tools/sync-command-portal.sh",
        "args": [
          "--service=terra-insight"
        ],
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "AI Swarm Integration Test",
        "type": "shell",
        "command": "./SDK/tools/test-swarm-integration.sh",
        "args": [
          "--service=terra-insight",
          "--analytics"
        ],
        "problemMatcher": [],
        "group": "none"
      }
    ]
  }
}