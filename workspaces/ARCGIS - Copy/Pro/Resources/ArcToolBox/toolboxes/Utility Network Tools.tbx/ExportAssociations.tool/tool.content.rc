{
    "map": {
        "association_type.descr": "<xdoc><p>Specifies the type of association to export.</p><ul><li><span title=\"ALL\">All</span>—All association types in the utility network will be exported to a .csv file.</li><li><span title=\"JUNCTION_JUNCTION_CONNECTIVITY\">Junction-junction connectivity</span>—Connectivity associations allowing two junction subtypes to connect via a connectivity association (features are offset geometrically) will be exported to a .csv file.</li><li><span title=\"CONTAINMENT\">Containment</span>—The containment association type will be exported to a .csv file.</li><li><span title=\"STRUCTURAL_ATTACHMENT\">Attachment</span>—The structural attachment association type will be exported to a .csv file.</li><li><span title=\"JUNCTION_EDGE_FROM_CONNECTIVITY\">Junction-edge connectivity (from side of edge)</span>—The junction-edge (from side of edge) connectivity association type will be exported to a .csv file.</li><li><span title=\"JUNCTION_EDGE_MIDSPAN_CONNECTIVITY\">Junction-edge connectivity (midspan)</span>—The junction-edge (midspan) connectivity association type will be exported to a .csv file.</li><li><span title=\"JUNCTION_EDGE_TO_CONNECTIVITY\">Junction-edge connectivity (to side of edge)</span>—The junction-edge (to side of edge) connectivity association type will be exported to a .csv file.</li></ul></xdoc>",
        "association_type.domain.ALL": "All",
        "association_type.domain.CONTAINMENT": "Containment",
        "association_type.domain.JUNCTION_EDGE_FROM_CONNECTIVITY": "Junction-edge connectivity (from side of edge)",
        "association_type.domain.JUNCTION_EDGE_MIDSPAN_CONNECTIVITY": "Junction-edge connectivity (midspan)",
        "association_type.domain.JUNCTION_EDGE_TO_CONNECTIVITY": "Junction-edge connectivity (to side of edge)",
        "association_type.domain.JUNCTION_JUNCTION_CONNECTIVITY": "Junction-junction connectivity",
        "association_type.domain.STRUCTURAL_ATTACHMENT": "Attachment",
        "association_type.title": "Association Type",
        "description": "Exports associations from a utility network to a comma-separated-values file (.csv). \nThis tool can be used in conjunction with the Import Associations tool.",
        "in_utility_network.descr": "The utility network containing the associations to export.",
        "in_utility_network.title": "Input Utility Network",
        "out_csv_file.descr": "The name and location of the .csv file that will be generated.",
