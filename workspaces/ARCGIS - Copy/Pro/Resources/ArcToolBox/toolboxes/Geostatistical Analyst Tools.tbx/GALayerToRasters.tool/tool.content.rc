{
    "map": {
        "additional_rasters.descr": "<xdoc><p>Provide the name, output type, and quantile or probability value for each additional output raster. See the descriptions of parameters above for more information. These additional rasters will be saved in the same location as the <span class=\"esri_uicontrol\">Output raster</span>.</p></xdoc>",
        "additional_rasters.domain.item2.CONDITION_NUMBER": "Condition number",
        "additional_rasters.domain.item2.PREDICTION": "Prediction",
        "additional_rasters.domain.item2.PREDICTION_STANDARD_ERROR": "Prediction standard error",
        "additional_rasters.domain.item2.PROBABILITY": "Probability",
        "additional_rasters.domain.item2.QUANTILE": "Quantile",
        "additional_rasters.domain.item2.STANDARD_ERROR_INDICATORS": "Standard error of indicators",
        "additional_rasters.dt.title1": "Output raster",
        "additional_rasters.dt.title2": "Output surface type",
        "additional_rasters.dt.title3": "Quantile or probability threshold value",
        "additional_rasters.title": "Additional output rasters",
        "cell_size.descr": "<xdoc><p>The cell size of the output rasters. This value will be shared by the <span class=\"esri_uicontrol\">Output raster</span> and the <span class=\"esri_uicontrol\">Additional output rasters</span> parameters.</p></xdoc>",
        "cell_size.title": "Output cell size",
        "description": "Exports a geostatistical layer to one or multiple rasters.",
        "in_geostat_layer.descr": "The geostatistical layer to be analyzed.",
        "in_geostat_layer.title": "Input geostatistical layer",
        "out_additional_rasters.title": "Additional rasters",
        "out_elevation.descr": "For 3D interpolation models, you can export rasters at any elevation. Use this parameter to specify the elevation you want to export. If left empty, the elevation will be inherited from the input layer. The units will default to the same units of the input layer.",
        "out_elevation.title": "Output elevation",
        "out_raster.descr": "<xdoc><p>The primary output raster to be created. Additional rasters can be created with the <span class=\"esri_uicontrol\">Additional output rasters</span> parameter.</p></xdoc>",
        "out_raster.title": "Output raster",
        "output_type.descr": "<xdoc><p>The surface type of the output raster.</p><p>For more information, see What output surface types can the interpolation models generate?</p><ul><li><span title=\"PREDICTION\">Prediction</span>—A raster of predicted values.</li><li><span title=\"PREDICTION_STANDARD_ERROR\">Prediction standard error</span>—A raster of standard errors of prediction.</li><li><span title=\"PROBABILITY\">Probability</span>—A raster predicting the probability that a threshold is exceeded.</li><li><span title=\"QUANTILE\">Quantile</span>—A raster predicting the quantile of the predicted value.</li><li><span title=\"STANDARD_ERROR_INDICATORS\">Standard error of indicators</span>—A raster of standard errors of indicators.</li><li><span title=\"CONDITION_NUMBER\">Condition number</span>—A raster showing the condition number for predictions in Local Polynomial Interpolation. The condition number surface indicates the stability of calculations at a particular location. The larger the condition number, the more unstable the prediction, so locations with large condition numbers may be prone to artifacts and erratic predicted values.</li></ul></xdoc>",
        "output_type.domain.CONDITION_NUMBER": "Condition number",
        "output_type.domain.PREDICTION": "Prediction",
        "output_type.domain.PREDICTION_STANDARD_ERROR": "Prediction standard error",
        "output_type.domain.PROBABILITY": "Probability",
        "output_type.domain.QUANTILE": "Quantile",
        "output_type.domain.STANDARD_ERROR_INDICATORS": "Standard error of indicators",
        "output_type.title": "Output Surface Type",
        "points_per_block_horz.descr": "The number of predictions for each cell in the horizontal direction for block interpolation. The default is 1.",
        "points_per_block_horz.title": "Number of points in the cell (horizontal)",
        "points_per_block_vert.descr": "The number of predictions for each cell in the vertical direction for block interpolation. The default is 1.",
        "points_per_block_vert.title": "Number of points in the cell (vertical)",
        "quantile_probability_value.descr": "<xdoc><p>If the <span class=\"esri_uicontrol\">Output surface type</span> is set to <span class=\"esri_uicontrol\">Quantile</span>, use this parameter to enter the requested quantile. If the <span class=\"esri_uicontrol\">Output surface type</span> is set to <span class=\"esri_uicontrol\">Probability</span>, use this parameter to enter the requested threshold value, then the probability that the threshold is exceeded will be calculated.</p></xdoc>",
        "quantile_probability_value.title": "Quantile or probability value",
        "title": "GA Layer To Rasters"
    }
}
