        "in_locations.title": "Input point observation locations",
        "minrange_calc_times.descr": "<xdoc><p>Number of Minor Range values randomly sampled from the Minor Range span.</p><p>If Anisotropy has been set in the <span class=\"esri_uicontrol\">input geostatistical model source</span>, a value is required.</p></xdoc>",
        "minrange_calc_times.title": "Number of calculations for Minor Range",
