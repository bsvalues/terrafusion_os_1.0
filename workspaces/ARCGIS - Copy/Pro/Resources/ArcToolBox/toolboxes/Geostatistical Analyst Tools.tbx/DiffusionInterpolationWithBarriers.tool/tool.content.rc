{
    "map": {
        "bandwidth.descr": "Used to specify the maximum distance at which data points are used for prediction. With increasing bandwidth, prediction bias increases and prediction variance decreases.",
        "bandwidth.title": "Bandwidth",
        "cell_size.descr": "<xdoc><p>The cell size at which the output raster will be created.</p><p>This value can be explicitly set in the <span class=\"esri_uicontrol\">Environments</span> by the <span class=\"esri_uicontrol\">Cell Size</span> parameter.</p><p>If not set, it is the shorter of the width or the height of the extent of the input point features, in the input spatial reference, divided by 250.</p></xdoc>",
        "cell_size.title": "Output cell size",
        "description": "Interpolates a surface using a kernel that is based upon the heat equation and allows one to use raster and feature  barriers to redefine distances between input points.",
        "in_additive_barrier_raster.descr": "<xdoc><p>The travel distance from one raster cell to the next based on this formula:</p><p>(average cost value in the neighboring cells) x (distance between cell centers)</p></xdoc>",
        "in_additive_barrier_raster.title": "Input additive barrier raster",
        "in_barrier_features.descr": "Absolute barrier features using non-Euclidean distances rather than line-of-sight distances.",
        "in_barrier_features.title": "Input absolute barrier features",
        "in_cumulative_barrier_raster.descr": "<xdoc><p>The travel distance from one raster cell to the next based on this formula:</p><p>(difference between cost values in the neighboring cells) + (distance between cell centers)</p></xdoc>",
        "in_cumulative_barrier_raster.title": "Input cumulative barrier raster",
        "in_features.descr": "The input point features containing the z-values to be interpolated.",
        "in_features.title": "Input features",
        "in_flow_barrier_raster.descr": "<xdoc><p>A flow barrier is used when interpolating data with preferential direction of data variation, based on this formula:</p><p>Indicator (cost values in the <i>to</i> neighboring cell &gt; cost values in the <i>from</i> neighboring cell) * (cost values in the <i>to</i> neighboring cell - cost values in the <i>from</i> neighboring cell) + (distance between cell centers),</p><p>where indicator(true) = 1 and indicator(false) = 0.</p></xdoc>",
        "in_flow_barrier_raster.title": "Input flow barrier raster",
        "number_iterations.descr": "The iteration count controls the accuracy of the numerical solution because the model solves the diffusion equation numerically. The larger this number, the more accurate the predictions, yet the longer the processing time. The more complex the barrier's geometry and the larger the bandwidth, the more iterations are required for accurate predictions.",
        "number_iterations.title": "Number of iterations",
        "out_ga_layer.descr": "The geostatistical layer produced. This layer is required output only if no output raster is requested.",
        "out_ga_layer.title": "Output geostatistical layer",
        "out_raster.descr": "The output raster. This raster is required output only if no output geostatistical layer is requested.",
        "out_raster.title": "Output raster",
        "params.category1": "Additional raster barriers",
        "summary": "Interpolates a surface using a kernel that is based upon the heat equation and allows one to use raster and feature barriers to redefine distances between input points.",
        "title": "Diffusion Interpolation With Barriers",
        "weight_field.descr": "Used to emphasize an observation. The larger the weight, the more impact it has on the prediction. For coincident observations, assign the largest weight to the most reliable measurement.",
        "weight_field.title": "Weight field",
        "z_field.descr": "Field that holds a height or magnitude value for each point. This can be a numeric field or the Shape field if the input features contain z-values or m-values.",
        "z_field.title": "Z value field"
    }
}
