{
    "map": {
        "area_overlap.descr": "<xdoc><p>Specifies whether overlapping area relationships will be analyzed and included in the output.<ul><li>Unchecked—Overlapping relationships will not be analyzed or included in the output. This is the default.</li><li>Checked—Overlapping relationships will be analyzed and included in the output.</li></ul></p></xdoc>",
        "area_overlap.title": "Include area overlaps",
        "both_sides.descr": "<xdoc><p>Specifies whether both sides of neighbor relationships will be included in the output.<ul><li>Checked—For a pair of neighboring polygons, both neighboring information of one polygon being the source and the other being the neighbor and vice versa will be included. This is the default.</li><li>Unchecked—For a pair of neighboring polygons, only neighboring information of one polygon being the source and the other being the neighbor will be included. The reciprocal relationship will not be included.</li></ul></p></xdoc>",
        "both_sides.title": "Include both sides of neighbor relationship",
        "cluster_tolerance.descr": "<xdoc><p>The minimum distance between coordinates before they will be considered equal. By default, this is the x,y tolerance of the input features.</p><note type=\"caution\"/><p group=\"note\">Changing this parameter&apos;s value may cause failure or unexpected results. It is recommended that you do not modify this parameter. It has been removed from view on the tool dialog box. By default, the input feature class&apos;s spatial reference x,y tolerance property is used.</p></xdoc>",
        "cluster_tolerance.title": "XY Tolerance",
        "description": "Creates a table with statistics based on polygon contiguity (overlaps, coincident edges, or nodes).",
        "in_features.descr": "The input polygon features.",
        "in_features.title": "Input Features",
        "in_fields.descr": "The input attribute field or fields that will be used to identify unique polygons or polygon groups and represent them in the output.",
        "in_fields.title": "Report By Fields",
        "out_area_units.descr": "<xdoc><p>Specifies the units that will be used to report the area overlap of neighboring polygons. The default is the input feature units. This parameter is only active when the <span class=\"esri_uicontrol\">Include area overlaps</span> parameter is checked.</p><ul><li><span title=\"UNKNOWN\">Unknown</span>—The area unit will be square unknown.</li><li><span title=\"SQUARE_KILOMETERS\">Square Kilometers</span>—The area unit will be square kilometers.</li><li><span title=\"SQUARE_METERS\">Square Meters</span>—The area unit will be square meters.</li><li><span title=\"SQUARE_DECIMETERS\">Square Decimeters</span>—The area unit will be square decimeters.</li><li><span title=\"SQUARE_CENTIMETERS\">Square Centimeters</span>—The area unit will be square centimeters.</li><li><span title=\"SQUARE_MILLIMETERS\">Square Millimeters</span>—The area unit will be square millimeters.</li><li><span title=\"SQUARE_MILES\">Square Statute Miles</span>—The area unit will be square statute miles.</li><li><span title=\"SQUARE_YARDS\">Square International Yards</span>—The area unit will be square international yards.</li><li><span title=\"SQUARE_FEET\">Square International Feet</span>—The area unit will be square international feet.</li><li><span title=\"SQUARE_INCHES\">Square International Inches</span>—The area unit will be square international inches.</li><li><span title=\"SQUARE_MILES_US\">Square US Survey Miles</span>—The area unit will be square US survey miles.</li><li><span title=\"SQUARE_YARDS_US\">Square US Survey Yards</span>—The area unit will be square US survey yards.</li><li><span title=\"SQUARE_FEET_US\">Square US Survey Feet</span>—The area unit will be square US survey feet.</li><li><span title=\"SQUARE_INCHES_US\">Square US Survey Inches</span>—The area unit will be square US survey inches.</li><li><span title=\"ACRES_US\">US Survey Acres</span>—The area unit will be US survey acres.</li><li><span title=\"HECTARES\">Hectares</span>—The area unit will be hectares.</li><li><span title=\"ACRES\">Acres</span>—The area unit will be international acres.</li><li><span title=\"ARES\">Ares</span>—The area unit will be ares.</li></ul></xdoc>",
        "out_area_units.domain.ACRES": "Acres",
        "out_area_units.domain.ACRES_US": "US Survey Acres",
        "out_area_units.domain.ARES": "Ares",
        "out_area_units.domain.HECTARES": "Hectares",
        "out_area_units.domain.SQUARE_CENTIMETERS": "Square Centimeters",
        "out_area_units.domain.SQUARE_DECIMETERS": "Square Decimeters",
        "out_area_units.domain.SQUARE_FEET": "Square International Feet",
        "out_area_units.domain.SQUARE_FEET_US": "Square US Survey Feet",
        "out_area_units.domain.SQUARE_INCHES": "Square International Inches",
        "out_area_units.domain.SQUARE_INCHES_US": "Square US Survey Inches",
        "out_area_units.domain.SQUARE_KILOMETERS": "Square Kilometers",
        "out_area_units.domain.SQUARE_METERS": "Square Meters",
        "out_area_units.domain.SQUARE_MILES": "Square Statute Miles",
        "out_area_units.domain.SQUARE_MILES_US": "Square US Survey Miles",
        "out_area_units.domain.SQUARE_MILLIMETERS": "Square Millimeters",
        "out_area_units.domain.SQUARE_YARDS": "Square International Yards",
        "out_area_units.domain.SQUARE_YARDS_US": "Square US Survey Yards",
        "out_area_units.domain.UNKNOWN": "Unknown",
        "out_area_units.title": "Output Area Units",
        "out_linear_units.descr": "<xdoc><p>Specifies the units that will be used to report the total length of the coincident edge between neighboring polygons. The default is the input feature units.</p><ul><li><span title=\"UNKNOWN\">Unknown</span>—The length unit will be unknown.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The length unit will be kilometers.</li><li><span title=\"METERS\">Meters</span>—The length unit will be meters.</li><li><span title=\"DECIMETERS\">Decimeters</span>—The length unit will be decimeters.</li><li><span title=\"CENTIMETERS\">Centimeters</span>—The length unit will be centimeters.</li><li><span title=\"MILLIMETERS\">Millimeters</span>—The length unit will be millimeters.</li><li><span title=\"MILES_INTERNATIONAL\">Statute Miles</span>—The length unit will be statute miles.</li><li><span title=\"NAUTICAL_MILES_INTERNATIONAL\">International Nautical Miles</span>—The length unit will be international nautical miles.</li><li><span title=\"YARDS_INTERNATIONAL\">International Yards</span>—The length unit will be international yards.</li><li><span title=\"FEET_INTERNATIONAL\">International Feet</span>—The length unit will be international feet.</li><li><span title=\"INCHES_INTERNATIONAL\">International Inches</span>—The length unit will be international inches.</li><li><span title=\"MILES\">US Survey Miles</span>—The length unit will be US survey miles.</li><li><span title=\"NAUTICAL_MILES\">US Survey Nautical Miles</span>—The length unit will be US survey nautical miles.</li><li><span title=\"YARDS\">US Survey Yards</span>—The length unit will be US survey yards.</li><li><span title=\"FEET\">US Survey Feet</span>—The length unit will be US survey feet.</li><li><span title=\"INCHES\">US Survey Inches</span>—The length unit will be US survey inches.</li><li><span title=\"DECIMAL_DEGREES\">Decimal Degrees</span>—The length unit will be decimal degrees.</li><li><span title=\"POINTS\">Points</span>—The length unit will be points.</li></ul></xdoc>",
        "out_linear_units.domain.CENTIMETERS": "Centimeters",
        "out_linear_units.domain.DECIMAL_DEGREES": "Decimal Degrees",
        "out_linear_units.domain.DECIMETERS": "Decimeters",
