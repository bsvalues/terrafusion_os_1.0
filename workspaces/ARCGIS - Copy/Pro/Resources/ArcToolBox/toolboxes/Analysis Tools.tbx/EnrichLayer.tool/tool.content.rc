        "data_collection.descr": "The collection of data used to enrich the input. You can specify a data collection without selecting any variables to enrich your data with all variables included in that collection. The Global country code only includes one data collection, KeyGlobalFacts.",
        "data_collection.title": "Data Collection",
        "description": "Enriches your data by adding demographic and landscape facts about the people and places that surround or are inside your data locations. The output is a duplicate of your input with new attribute fields added to the table. This tool requires an ArcGIS Online organizational account and consumes credits.",
        "distance.descr": "<xdoc><p>The value that determines the straight-line distance or drive time around the input features for areas to enrich. The unit of the distance or time should be supplied in the <span class=\"esri_uicontrol\">Unit</span> parameter.</p></xdoc>",
        "distance.title": "Distance or time",
        "in_features.descr": "The features to enrich with new data.",
        "in_features.title": "Input Features",
        "out_feature_class.descr": "The output feature class, which is a copy of the input features with new attribute fields added.",
        "out_feature_class.title": "Output Feature Class",
        "summary": "<xdoc><p>Enriches your data by adding demographic and landscape facts about the people and places that surround or are inside your data locations. The output is a duplicate of your input with new attribute fields added to the table. This tool requires an ArcGIS Online organizational account and consumes credits.</p><note type=\"legacy\"/><p group=\"note\">This is a deprecated tool. This functionality has been replaced by the Enrich tool.</p></xdoc>",
        "title": "Enrich Layer",
        "unit.descr": "<xdoc><p>Specifies the unit for <span class=\"esri_uicontrol\">Distance or time</span> parameter value.</p><ul><li><span title=\"MILES\">Miles</span>—Miles</li><li><span title=\"YARDS\">Yards</span>—Yards</li><li><span title=\"FEET\">Feet</span>—Feet</li><li><span title=\"KILOMETERS\">Kilometers</span>—Kilometers</li><li><span title=\"METERS\">Meters</span>—Meters</li><li><span title=\"HOURS\">Hours</span>—Hours</li><li><span title=\"MINUTES\">Minutes</span>—Minutes</li><li><span title=\"SECONDS\">Seconds</span>—Seconds</li></ul></xdoc>",
        "unit.domain.FEET": "Feet",
