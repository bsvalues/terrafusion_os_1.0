{
    "type": "FunctionTool",
    "displayname": "$rc:title",
    "app_ver": "13.4",
    "product": "100",
    "tool_Execute": "GPBAFunctions.dll/GPGenerateGridsAndHexagonsInternal_Execute",
    "params": {
        "area_of_interest": {
            "displayname": "$rc:area_of_interest.title",
            "datatype": {
                "type": "GPFeatureLayer"
            }
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "area_of_interest"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "cell_type": {
            "type": "optional",
            "displayname": "$rc:cell_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SQUARE",
                        "code": "$rc:cell_type.domain.SQUARE"
                    },
                    {
                        "value": "HEXAGON",
                        "code": "$rc:cell_type.domain.HEXAGON"
                    },
                    {
                        "value": "H3_HEXAGON",
                        "code": "$rc:cell_type.domain.H3_HEXAGON"
                    }
                ]
            },
            "value": "H3_HEXAGON"
        },
        "cell_size": {
            "type": "optional",
            "displayname": "$rc:cell_size.title",
            "datatype": {
                "type": "GPArealUnit"
            }
        },
        "h3_resolution": {
            "type": "optional",
            "displayname": "$rc:h3_resolution.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "7"
        }
    }
}
