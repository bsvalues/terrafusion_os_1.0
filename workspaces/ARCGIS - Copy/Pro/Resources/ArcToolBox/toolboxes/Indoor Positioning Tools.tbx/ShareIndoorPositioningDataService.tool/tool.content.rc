{
    "map": {
        "description": "Publishes an Indoor Positioning Data Service to ArcGIS Enterprise or ArcGIS Online. An Indoor Positioning Data Service contains the data required for enabling indoor positioning. It is used by the IndoorsLocationDataSource objects of the ArcGIS Maps SDKs to compute an estimated position.",
        "folder.descr": "The name of an existing folder on the portal where the Indoor Positioning Data Service will be stored.",
        "folder.title": "Folder",
        "group_sharing.descr": "The groups with which the Indoor Positioning Data Service will be shared. You can select multiple values from the groups to which you belong.",
        "group_sharing.title": "Group Sharing",
        "in_ips_datasets.descr": "The feature class from the ArcGIS IPS Data Model containing one feature per Indoor Positioning Dataset.",
        "in_ips_datasets.title": "IPS Positioning Datasets",
        "ips_dataset_name.descr": "<xdoc><p>The name of the Indoor Positioning Dataset. Options will be a list of dataset names derived from the <span class=\"esri_uicontrol\">IPS Positioning Datasets</span> parameter value.</p></xdoc>",
        "ips_dataset_name.title": "IPS Dataset Name",
        "out_positioning_item_id.title": "Indoor Positioning Data Service Item ID",
        "out_positioning_item_url.title": "Indoor Positioning Data Service Item URL",
        "sharing_level.descr": "<xdoc><p>Specifies the sharing permissions that will be used for the service.</p><ul><li><span title=\"OWNER\">Owner</span>—Only the owner of the Indoor Positioning Data Service will have access. This is the default.</li><li><span title=\"ORGANIZATION\">Organization</span>—All members of the organization will have access.</li><li><span title=\"EVERYONE\">Everyone (public)</span>—Everyone, including people outside the organization, will have access.</li></ul></xdoc>",
        "sharing_level.domain.EVERYONE": "Everyone (public)",
        "sharing_level.domain.ORGANIZATION": "Organization",
        "sharing_level.domain.OWNER": "Owner",
        "sharing_level.title": "Sharing Level",
        "summary.descr": "A short description for the Indoor Positioning Data Service.",
        "summary.title": "Summary",
        "tags.descr": "The keywords or terms that describe the Indoor Positioning Data Service. Separate multiple tags with a comma.",
        "tags.title": "Tags",
        "title": "Share Indoor Positioning Data Service",
        "title.descr": "The title of the Indoor Positioning Data Service.",
        "title.title": "Title",
        "update_existing.descr": "<xdoc><p>Specifies whether an existing Indoor Positioning Data Service will be overwritten.<ul><li>Checked—An existing Indoor Positioning Data Service will be overwritten.</li><li>Unchecked—An existing Indoor Positioning Data Service will not be overwritten, and a new service will be shared. This is the default.</li></ul></p></xdoc>",
        "update_existing.title": "Update an Existing Indoor Positioning Data Service"
