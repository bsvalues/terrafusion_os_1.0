{
    "map": {
        "average_points_per_cell.descr": "<xdoc><p>Specifies whether the average will be calculated when multiple training points fall into one cell. This parameter is applicable only when the input target is a point feature class.<ul><li>Unchecked—All points will be used when multiple training points fall into a single cell. This is the default.</li><li>Checked—The average value of the training points in a cell will be calculated.</li></ul></p><ul><li><span title=\"KEEP_ALL_POINTS\">Keep all points</span>—All points will be used when multiple training points fall into a single cell. This is the default.</li><li><span title=\"AVERAGE_POINTS_PER_CELL\">Average points per cell</span>—The average value of the training points in a cell will be calculated.</li></ul></xdoc>",
        "average_points_per_cell.title": "Average Points Per Cell",
        "description": "Models the relationship between explanatory variables (independent variables) and a target dataset (dependent variable).",
        "in_rasters.descr": "The single-band, multidimensional, or multiband raster datasets, or mosaic datasets containing explanatory variables.",
        "in_rasters.title": "Input Rasters",
        "in_target_data.descr": "The raster or point feature class containing the target variable (dependant variable) data.",
        "in_target_data.title": "Target Raster or Points",
        "max_num_trees.descr": "The maximum number of trees in the forest. Increasing the number of trees will lead to higher accuracy rates, although this improvement will level off. The number of trees increases the processing time linearly. The default is 50.",
        "max_num_trees.title": "Max Number of Trees",
        "max_samples.descr": "The maximum number of samples that will be used for the regression analysis. A value that is less than or equal to 0 means that the system will use all the samples from the input target raster or point feature class to train the regression model. The default value is 10,000.",
        "max_samples.title": "Max Number of Samples",
        "max_tree_depth.descr": "The maximum depth of each tree in the forest. Depth determines the number of rules each tree can create, resulting in a decision. Trees will not grow any deeper than this setting. The default is 30.",
        "max_tree_depth.title": "Max Tree Depth",
        "out_importance_table.descr": "A table containing information describing the importance of each explanatory variable used in the model. A larger number indicates the corresponding variable is more correlated to the predicted variable and will contribute more in prediction. Values range between 0 and 1, and the sum of all the values equals 1.",
        "out_importance_table.title": "Output Importance Table",
        "out_regression_definition.descr": "A JSON format file with an .ecd extension that contains attribute information, statistics, or other information for the classifier.",
        "out_regression_definition.title": "Output Regression Definition File",
        "out_sample_features.descr": "The output feature class that will contain target values and predicted values for training points, test points, and location test points.",
        "out_sample_features.title": "Output Sample Features",
        "out_scatterplots.descr": "The output scatter plots in PDF or HTML format. The output will include scatter plots of training data, test data, and location test data.",
        "out_scatterplots.title": "Output Scatter Plots (pdf or html)",
        "params.category1": "Additional Outputs",
        "params.category2": "Training Options",
        "percent_testing.descr": "The percentage of test points that will be used for error checking. The tool checks for three types of errors: errors on training points, errors on test points, and errors on test location points. The default is 10.",
        "percent_testing.title": "Percent of Samples for Testing",
        "raster_dimension.descr": "The dimension name of the input multidimensional raster (explanatory variables) that links to the dimension in the target data.",
        "raster_dimension.title": "Raster Dimension",
        "target_dimension_field.descr": "A date field or numeric field in the input point feature class that defines the dimension values.",
        "target_dimension_field.title": "Target Dimension Field",
        "target_value_field.descr": "The field name of the information to model in the target point feature class or raster dataset.",
        "target_value_field.title": "Target Value Field",
