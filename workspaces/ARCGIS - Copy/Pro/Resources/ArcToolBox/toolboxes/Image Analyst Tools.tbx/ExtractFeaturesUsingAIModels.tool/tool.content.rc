{
    "map": {
        "additional_models.descr": "<xdoc><p>The deep learning models that can be used on the provided input raster and the postprocessing workflow that will be used for additional model files (.dlpk and .emd). Available postprocessing workflows are as follows:</p><p><ul><li>Line Regularization—The postprocessing workflow will extract line features from a single band raster with binary classification and generate a polyline feature class after refining it. This workflow also supports deep learning models that generate polyline feature classes.</li><li>Parcel Regularization—The postprocessing workflow will extract parcels from a single band raster with binary classification and generate a polygon feature class after refining it.</li><li>Polygon Regularization—The postprocessing workflow will generate a polygon feature class after refining it. This workflow is only compatible with object detection models.</li><li>Polygon Segmentation—The postprocessing workflow will generate a polygon feature class containing the detected objects using their centroid or bounding box. The segmentation method is specified using the <span class=\"esri_uicontrol\">Prompt</span> parameter.</li><li>None—No postprocessing workflow will be applied. This is the default.</li></ul></p></xdoc>",
        "additional_models.domain.item2.Line Regularization": "Line Regularization",
        "additional_models.domain.item2.None": "None",
        "additional_models.domain.item2.Parcel Regularization": "Parcel Regularization",
        "additional_models.domain.item2.Polygon Regularization": "Polygon Regularization",
        "additional_models.domain.item2.Polygon Segmentation": "Polygon Segmentation",
        "additional_models.dt.title1": "Model Path",
        "additional_models.dt.title2": "Postprocessing Workflow",
        "additional_models.title": "Additional Models",
        "area_of_interest.descr": "The geographical extent that will be used to extract features. Only features within the area of interest will be extracted.",
        "area_of_interest.title": "Area of Interest",
        "buffer_distance.descr": "The distance that will be used to buffer polyline features before they are used in postprocessing. The default is 15 meters.",
        "buffer_distance.title": "Buffer Distance",
        "confidence_threshold.descr": "The minimum confidence of deep learning model that will be used when detecting objects. The value must be between 0 and 1.",
        "confidence_threshold.title": "Confidence Threshold",
        "dangle_length.descr": "The length at which line segments that do not touch another line at both endpoints (dangles) will be trimmed. The default is 5 meters.",
        "dangle_length.title": "Dangle Length",
        "description": "Runs one or more pretrained deep learning models on an input raster to extract features and automate the postprocessing of the inferenced outputs.",
        "extend_length.descr": "The maximum distance a line segment will be extended to an intersecting feature. The default is 25 meters.",
        "extend_length.title": "Extend Length",
        "in_features.descr": "<xdoc><p>The feature class on which postprocessing will be performed. This parameter is only supported when the <span class=\"esri_uicontrol\">Post Processing Workflow</span> parameter is set to <span class=\"esri_uicontrol\">Line Regularization</span> or <span class=\"esri_uicontrol\">Polygon Regularization</span>.</p><p>The feature class on which postprocessing will be performed. This parameter is only supported when the post_processing_workflow parameter is set to Line Regularization or Polygon Regularization.</p></xdoc>",
        "in_features.title": "Input Features",
        "in_raster.descr": "<xdoc><p>The input raster on which processing will be performed.</p><p>If the <span class=\"esri_uicontrol\">Mode</span> parameter is specified as <span class=\"esri_uicontrol\">Only Postprocess</span>, a raster with binary classification is required for this parameter.</p></xdoc>",
        "in_raster.title": "Input Raster",
        "in_road_features.descr": "A road feature class that will be used for refining the parcels. The input can be a polygon or polyline feature class.",
        "in_road_features.title": "Input Road Features",
        "mode.descr": "<xdoc><p>Specifies the mode that will be used for the processing of the input raster.</p><ul><li><span title=\"Infer and Postprocess\">Infer and Postprocess</span>—Features will be extracted from the imagery and postprocessed. This is the default.</li><li><span title=\"Only Postprocess\">Only Postprocess</span>—The input raster will be directly postprocessed. A single band raster with binary classification is required for this option.</li></ul></xdoc>",
        "mode.domain.Infer and Postprocess": "Infer and Postprocess",
        "mode.domain.Only Postprocess": "Only Postprocess",
        "mode.title": "Mode",
        "out_features.descr": "The feature class containing the postprocessed output.",
        "out_features.title": "Output Features",
        "out_location.descr": "The file geodatabase where the intermediate output from the models and the final postprocessed output will be stored.",
        "out_location.title": "Output Location",
        "out_prefix.descr": "A prefix that will be added to the name of the outputs that will be saved to the output location. The prefix will also be used as the name of a group layer that will be used to display all outputs.",
        "out_prefix.title": "Output Prefix",
        "out_summary.descr": "The table that will contain a list of outputs that were generated along with their respective paths.",
        "out_summary.title": "Output Summary",
        "params.category1": "Models",
        "params.category2": "Inferencing Options",
        "params.category3": "Line Regularization Options",
        "params.category4": "Parcel Regularization Options",
        "params.category5": "Polygon Regularization Options",
        "params.category6": "Polygon Segmentation Options",
        "parcel_tolerance.descr": "The minimum distance between coordinates before they are considered equal. This parameter is used to reduce slivers between extracted parcels. The default is 3 meters.",
        "parcel_tolerance.title": "Tolerance Between Adjacent Parcels",
        "poly_tolerance.descr": "The maximum distance that the regularized footprint can deviate from the boundary of its originating feature. The default is 1 meter.",
        "poly_tolerance.title": "Tolerance",
        "post_processing_workflow.descr": "<xdoc><p>Specifies the postprocessing workflow that will be used.</p><ul><li><span title=\"Line Regularization\">Line Regularization</span>—Line features will be extracted from a single band raster with binary classification and a polyline feature class will be generated after refining it.</li><li><span title=\"Parcel Regularization\">Parcel Regularization</span>—Parcels will be extracted from a single band raster with binary classification and a polygon feature class will be generated after refining it.</li><li><span title=\"Polygon Regularization\">Polygon Regularization</span>— A polygon feature class will be generated after refining it. This workflow is only compatible with object detection models.</li></ul></xdoc>",
        "post_processing_workflow.domain.Line Regularization": "Line Regularization",
        "post_processing_workflow.domain.Parcel Regularization": "Parcel Regularization",
        "post_processing_workflow.domain.Polygon Regularization": "Polygon Regularization",
        "post_processing_workflow.title": "Post Processing Workflow",
        "pretrained_models.descr": "The ArcGIS pretrained models from ArcGIS Living Atlas of the World that can be used on the provided input raster. This parameter requires an internet connection to download the pretrained models.",
        "pretrained_models.title": "Pretrained Models",
        "prompt.descr": "<xdoc><p>Specifies the segmentation method that will be used when the <span class=\"esri_uicontrol\">Additional Models</span> parameter is set to <span class=\"esri_uicontrol\">Polygon Segmentation</span>.</p><ul><li><span title=\"Centroid\">Centroid</span>— The centroid of the detections will be used to indicate to the polygon segmentation model what to segment in the input raster.</li><li><span title=\"Bounding Box\">Bounding Box</span>— The bounding box of the detections will be used to indicate to the polygon segmentation model what to segment in the input raster.</li><li><span title=\"None\">None</span>—No segmentation method will be used. This is the default</li></ul></xdoc>",
        "prompt.domain.Bounding Box": "Bounding Box",
        "prompt.domain.Centroid": "Centroid",
        "prompt.domain.None": "None",
        "prompt.title": "Prompt",
        "regularization_method.descr": "<xdoc><p>Specifies the regularization method that will be used in postprocessing.</p><ul><li><span title=\"Right Angles\">Right Angles</span>—Shapes composed of 90° angles between adjoining edges will be constructed. This is the default.</li><li><span title=\"Right Angles and Diagonals\">Right Angles and Diagonals</span>—Shapes composed of 45° and 90° angles between adjoining edges will be constructed.</li><li><span title=\"Any Angles\">Any Angles</span>—Shapes that form any angles between adjoining edges will be constructed.</li><li><span title=\"Circle\">Circle</span>—The maximum distance from the boundary of the feature being processed will be used.</li></ul></xdoc>",
        "regularization_method.domain.Any Angles": "Any Angles",
        "regularization_method.domain.Circle": "Circle",
        "regularization_method.domain.Right Angles": "Right Angles",
        "regularization_method.domain.Right Angles and Diagonals": "Right Angles and Diagonals",
        "regularization_method.title": "Regularization Method",
        "regularize_parcels.descr": "<xdoc><p>Specifies whether extracted parcels will be normalized by eliminating undesirable artifacts in their geometry.</p><ul><li>Checked—Extracted parcels will be normalized. This is the default.</li><li>Unchecked—Extracted parcels will not be normalized.</li></ul></xdoc>",
        "regularize_parcels.title": "Regularize Parcels",
        "road_buffer_width.descr": "The buffer distance that will be used for the input road features. The default value is 5 meters for polyline features and 0 meters for polygon features.",
        "road_buffer_width.title": "Road Buffer Width",
        "save_intermediate_output.descr": "<xdoc><p>Specifies whether the intermediate outputs will be saved to the output location. The term intermediate outputs refers to the results generated after the model has been inferenced.</p><ul><li>Checked—The intermediate outputs will be saved to the output location.</li><li>Unchecked—The intermediate outputs will not be saved. This is the default.</li></ul></xdoc>",
        "save_intermediate_output.title": "Save Intermediate Output",
        "smoothing_tolerance.descr": "The tolerance used by the Polynomial Approximation with Exponential Kernel (PAEK) algorithm. The default is 30 meters.",
        "smoothing_tolerance.title": "Smoothing Tolerance",
        "test_time_augmentation.descr": "<xdoc><p>Specifies whether predictions of flipped and rotated variants of the input image will be merged into the final output.<ul><li>Checked—Predictions of flipped and rotated variants of the input image will be merged into the final output.</li><li>Unchecked—Predictions of flipped and rotated variants of the input image will not be merged into the final output. This is the default.</li></ul></p></xdoc>",
        "test_time_augmentation.title": "Test Time Augmentation",
        "title": "Extract Features Using AI Models"
    }
}
