{
    "map": {
        "description": "Calculates the inverse tangent (based on x,y) of cells in a raster.",
        "in_raster_or_constant1.descr": "<xdoc><p>The input that specifies the numerator, or y value, to use when calculating the inverse tangent.</p><p>A number can be used as an input for this parameter, provided a raster is specified for the other parameter. To specify a number for both inputs, the cell size and extent must first be set in the environment.</p></xdoc>",
        "in_raster_or_constant1.title": "Input raster or constant value 1",
        "in_raster_or_constant2.descr": "<xdoc><p>The input that specifies the denominator, or x value, to use when calculating the inverse tangent.</p><p>A number can be used as an input for this parameter, provided a raster is specified for the other parameter. To specify a number for both inputs, the cell size and extent must first be set in the environment.</p></xdoc>",
        "in_raster_or_constant2.title": "Input raster or constant value 2",
        "out_raster.descr": "<xdoc><p>The output raster.</p><p>The values are the inverse tangent angle of the input values.</p></xdoc>",
        "out_raster.title": "Output raster",
        "title": "ATan2"
    }
}
