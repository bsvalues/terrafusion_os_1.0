{
    "map": {
        "background_error_corr_length.descr": "<xdoc><p>The correlation length between background measurements. The default is three times the cell size of the <span class=\"esri_uicontrol\">Input Background Raster</span> parameter value.</p></xdoc>",
        "background_error_corr_length.title": "Background Error Correlation Length",
        "background_error_var.descr": "<xdoc><p>The error variance of the background measurements.</p><p>The input can be a single value or an error variance raster. If a single value is provided, the value will be used as the error variance for all background measurements. If an error variance raster is provided, each cell in the background data will obtain its error variance from the corresponding background error variance raster. The error variance raster must have the same cell size and extent as the background data.</p></xdoc>",
        "background_error_var.title": "Background Error Variance",
        "description": "Statistically assimilates data combined from multiple sources to produce an output raster. The tool can be used to merge background data, such as model outputs, with observation data, such as point measurements, to perform interpolation.",
        "in_background_raster.descr": "The input background raster also known as the background field.",
        "in_background_raster.title": "Input Background Raster",
        "in_obs_data.descr": "The input point features that will be used for interpolation.",
        "in_obs_data.title": "Input Observation Data",
        "obs_error_var.descr": "The error variance of the observations. The input can be a single value or a field from the observation data. If a single value is provided, the value will be used as the error variance for all observations. If a field in the observation data is provided, values in the field will be used as the error variance for each corresponding observation point.",
        "obs_error_var.title": "Observation Error Variance",
        "obs_field.descr": "The field containing observation values that will be used for interpolation.",
        "obs_field.title": "Observation Field",
        "out_raster.descr": "The output multidimensional raster dataset.",
        "out_raster.title": "Output Raster",
        "title": "Optimal Interpolation"
    }
}
