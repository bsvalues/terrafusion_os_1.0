{
    "type": "FunctionTool",
    "guid": "{33724566-2738-4FE2-903A-A8C439127E50}/CustomerDerivedTA",
    "displayname": "$rc:title",
    "helpcontent": "62030001",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "33",
        "35"
    ],
    "params": {
        "in_stores_layer": {
            "displayname": "$rc:in_stores_layer.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_stores_layer.descr"
        },
        "store_id_field": {
            "displayname": "$rc:store_id_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Text",
                    "Short",
                    "BigInteger",
                    "Long",
                    "Float",
                    "Double",
                    "GUID",
                    "GlobalID"
                ]
            },
            "depends": [
                "in_stores_layer"
            ],
            "description": "$rc:store_id_field.descr"
        },
        "in_customers_layer": {
            "displayname": "$rc:in_customers_layer.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_customers_layer.descr"
        },
        "link_field": {
            "displayname": "$rc:link_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Text",
                    "Short",
                    "BigInteger",
                    "Long",
                    "Float",
                    "Double",
                    "GUID",
                    "GlobalID"
                ]
            },
            "depends": [
                "in_customers_layer"
            ],
            "description": "$rc:link_field.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "in_stores_layer"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "featuretype.rule": "AsSpecified",
                "featuretype": "Simple",
                "geometrytype.rule": "AsSpecified",
                "geometrytype": "Polygon",
                "extenttype.rule": "Union",
                "fields.rule": "None",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "method": {
            "displayname": "$rc:method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SIMPLE",
                        "code": "$rc:method.domain.SIMPLE"
                    },
                    {
                        "value": "AMOEBA",
                        "code": "$rc:method.domain.AMOEBA"
                    },
                    {
                        "value": "DETAILED",
                        "code": "$rc:method.domain.DETAILED"
                    },
                    {
                        "value": "DETAILED_WITH_SMOOTHING",
                        "code": "$rc:method.domain.DETAILED_WITH_SMOOTHING"
                    },
                    {
                        "value": "THRESHOLD_RINGS",
                        "code": "$rc:method.domain.THRESHOLD_RINGS"
                    },
                    {
                        "value": "THRESHOLD_DRIVETIMES",
                        "code": "$rc:method.domain.THRESHOLD_DRIVETIMES"
                    }
                ]
            },
            "value": "DETAILED_WITH_SMOOTHING",
            "description": "$rc:method.descr"
        },
        "rings": {
            "displayname": "$rc:rings.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPDouble"
                }
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                },
                "high": {
                    "allow": "true",
                    "val": "100"
                }
            },
            "description": "$rc:rings.descr"
        },
        "customer_aggregation_type": {
            "displayname": "$rc:customer_aggregation_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "COUNT",
                        "code": "$rc:customer_aggregation_type.domain.COUNT"
                    },
                    {
                        "value": "WEIGHT",
                        "code": "$rc:customer_aggregation_type.domain.WEIGHT"
                    }
                ]
            },
            "value": "COUNT",
            "description": "$rc:customer_aggregation_type.descr"
        },
        "customer_weight_field": {
            "type": "optional",
            "displayname": "$rc:customer_weight_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "BigInteger",
                    "Long",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "in_customers_layer"
            ],
            "description": "$rc:customer_weight_field.descr"
        },
        "exclude_outlying_customers": {
            "type": "optional",
            "displayname": "$rc:exclude_outlying_customers.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "EXCLUDE_OUTLIERS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "ALL_POINTS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:exclude_outlying_customers.descr"
        },
        "cutoff_distance": {
            "type": "optional",
            "displayname": "$rc:cutoff_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:cutoff_distance.descr"
        },
        "dissolve_option": {
            "type": "optional",
            "displayname": "$rc:dissolve_option.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "OVERLAP",
                        "code": "$rc:dissolve_option.domain.OVERLAP"
                    },
                    {
                        "value": "SPLIT",
                        "code": "$rc:dissolve_option.domain.SPLIT"
                    }
                ]
            },
            "value": "OVERLAP",
            "description": "$rc:dissolve_option.descr"
        },
        "use_customer_centroids": {
            "type": "optional",
            "displayname": "$rc:use_customer_centroids.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "USE_CENTROIDS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "USE_STORES"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:use_customer_centroids.descr"
        },
        "distance_type": {
            "type": "optional",
            "displayname": "$rc:distance_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:distance_type.descr"
        },
        "units": {
            "type": "optional",
            "displayname": "$rc:units.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:units.descr"
        },
        "travel_direction": {
            "type": "optional",
            "displayname": "$rc:travel_direction.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TOWARD_STORES",
                        "code": "$rc:travel_direction.domain.TOWARD_STORES"
                    },
                    {
                        "value": "AWAY_FROM_STORES",
                        "code": "$rc:travel_direction.domain.AWAY_FROM_STORES"
                    }
                ]
            },
            "value": "TOWARD_STORES",
            "description": "$rc:travel_direction.descr"
        },
        "time_of_day": {
            "type": "optional",
            "displayname": "$rc:time_of_day.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_of_day.descr"
        },
        "time_zone": {
            "type": "optional",
            "displayname": "$rc:time_zone.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UTC",
                        "code": "$rc:time_zone.domain.UTC"
                    },
                    {
                        "value": "TIME_ZONE_AT_LOCATION",
                        "code": "$rc:time_zone.domain.TIME_ZONE_AT_LOCATION"
                    }
                ]
            },
            "value": "TIME_ZONE_AT_LOCATION",
            "description": "$rc:time_zone.descr"
        },
        "search_tolerance": {
            "type": "optional",
            "displayname": "$rc:search_tolerance.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:search_tolerance.descr"
        },
        "polygon_detail": {
            "type": "optional",
            "displayname": "$rc:polygon_detail.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "STANDARD",
                        "code": "$rc:polygon_detail.domain.STANDARD"
                    },
                    {
                        "value": "GENERALIZED",
                        "code": "$rc:polygon_detail.domain.GENERALIZED"
                    },
                    {
                        "value": "HIGH",
                        "code": "$rc:polygon_detail.domain.HIGH"
                    }
                ]
            },
            "value": "STANDARD",
            "description": "$rc:polygon_detail.descr"
        },
        "iterations_limit": {
            "type": "optional",
            "displayname": "$rc:iterations_limit.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "1"
                }
            },
            "description": "$rc:iterations_limit.descr"
        },
        "minimum_step": {
            "type": "optional",
            "displayname": "$rc:minimum_step.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true"
            },
            "description": "$rc:minimum_step.descr"
        },
        "target_percent_diff": {
            "type": "optional",
            "displayname": "$rc:target_percent_diff.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "high": {
                    "allow": "false",
                    "val": "100"
                }
            },
            "value": "5",
            "description": "$rc:target_percent_diff.descr"
        }
    },
    "environments": [
        "baDataSource",
        "baNetworkSource",
        "workspace"
    ]
}
