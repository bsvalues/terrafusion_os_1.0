{
    "map": {
        "area_of_interest.descr": "The input feature class used to define the extent of the grid or hexagon layer.",
        "area_of_interest.title": "Area of Interest",
        "cell_size.descr": "The size of the cell to generate squares or hexagons. The default value is 1 square mile.",
        "cell_size.title": "Cell Size",
        "cell_type.descr": "<xdoc><p>Specifies the cell type that will be created in the output.</p><ul><li><span title=\"SQUARE\">Square</span>—Regular four-sided polygons with equal side lengths will be created. This is the default.</li><li><span title=\"HEXAGON\">Hexagon</span>—Regular six-sided polygons with equal side lengths will be created.</li><li><span title=\"H3_HEXAGON\">H3 Hexagon</span>—Regular six-sided polygons with equal side lengths based on Uber&apos;s hexagonal hierarchical spatial index will be created.</li></ul></xdoc>",
        "cell_type.domain.H3_HEXAGON": "H3 Hexagon",
        "cell_type.domain.HEXAGON": "Hexagon",
        "cell_type.domain.SQUARE": "Square",
        "cell_type.title": "Cell Geometry Type",
        "description": "Creates features with vector-based square grid cells, hexagons, or H3 hexagons for a given area.",
        "distance.descr": "The distance that will be used for the buffer calculations.",
        "distance.title": "Distance",
        "distance_type.descr": "The method of travel that will be used for the buffer calculation.",
        "distance_type.title": "Distance Type",
        "enrich_type.descr": "<xdoc><p>Specifies the method that will be used for variable enrichment.</p><ul><li><span title=\"ENRICH_CELL\">Enrich Cell</span>—Enrichment will be performed on the <span class=\"esri_uicontrol\">Cell Geometry Type</span> parameter value.</li><li><span title=\"ENRICH_BUFFER\">Enrich Buffer</span>—Enrichment will be performed on a buffer around the centroid of the grid or hexagon.</li></ul></xdoc>",
        "enrich_type.domain.ENRICH_BUFFER": "Enrich Buffer",
        "enrich_type.domain.ENRICH_CELL": "Enrich Cell",
        "enrich_type.title": "Enrichment Type",
        "h3_resolution.descr": "The resolution that will be used to generate the H3 hexagons. A value of 15 represents the finest resolution. The default value is 7.",
        "h3_resolution.title": "H3 Resolution",
        "out_centroids.descr": "The feature class that will contain the cell centroids.",
        "out_centroids.title": "Centroids Output Feature Class",
        "out_enriched_buffers.descr": "The feature class that will contain the enriched buffers.",
        "out_enriched_buffers.title": "Output Enriched Buffers",
        "out_feature_class.descr": "The feature class that will contain the grid or hexagon features.",
        "out_feature_class.title": "Output Feature Class",
        "params.category1": "Buffer Parameters",
        "params.category2": "Network Parameters",
        "params.category3": "Cell Centroids",
        "polygon_detail.descr": "<xdoc><p>Specifies the level of detail that will be used for the output drive time polygons.</p><ul><li><span title=\"STANDARD\">Standard</span>—The optimal setting that combines processing speed with overall accuracy will be used. This is the default.</li><li><span title=\"GENERALIZED\">Generalized</span>—The fastest method will be used.</li><li><span title=\"HIGH\">High</span>—The highest level of detail will be used.</li></ul></xdoc>",
        "polygon_detail.domain.GENERALIZED": "Generalized",
        "polygon_detail.domain.HIGH": "High",
        "polygon_detail.domain.STANDARD": "Standard",
        "polygon_detail.title": "Polygon Detail",
        "search_tolerance.descr": "The maximum distance that input points can be from the network. Points located beyond the search tolerance will be excluded from processing.",
        "search_tolerance.title": "Search Tolerance",
        "time_of_day.descr": "The time at which the travel will begin.",
        "time_of_day.title": "Time of Day",
        "time_zone.descr": "<xdoc><p>Specifies the time zone that will be used for the <span class=\"esri_uicontrol\">Time of Day</span> parameter.</p><ul><li><span title=\"UTC\">UTC</span>—Coordinated universal time (UTC) will be used. Choose this option if you want the best location for a specific time, such as now, but aren&apos;t certain of the time zone.</li><li><span title=\"TIME_ZONE_AT_LOCATION\">Local time at locations</span>—The time zone in which the <span class=\"esri_uicontrol\">Area of Interest</span> value is located will be used. This is the default.</li></ul></xdoc>",
        "time_zone.domain.TIME_ZONE_AT_LOCATION": "Local time at locations",
        "time_zone.domain.UTC": "UTC",
        "time_zone.title": "Time Zone",
        "title": "Generate Grids and Hexagons",
        "travel_direction.descr": "<xdoc><p>Specifies the direction of travel that will be used between the center of the cell and the buffer boundary.</p><ul><li><span title=\"TOWARD_STORES\">Toward Input Features</span>—The direction of travel will be from location points to input features. This is the default.</li><li><span title=\"AWAY_FROM_STORES\">Away from Input Features</span>—The direction of travel will be from input features to location points.</li></ul></xdoc>",
        "travel_direction.domain.AWAY_FROM_STORES": "Away from Input Features",
        "travel_direction.domain.TOWARD_STORES": "Toward Input Features",
        "travel_direction.title": "Travel Direction",
        "units.descr": "<xdoc><p>The units that will be used for the <span class=\"esri_uicontrol\">Distance</span> parameter.</p></xdoc>",
        "units.title": "Distance Units",
        "variables.descr": "A list of variables that will be appended to the output.",
        "variables.title": "Variables"
    }
}
