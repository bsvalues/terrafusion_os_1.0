{
    "type": "FunctionTool",
    "guid": "{33724566-2738-4FE2-903A-A8C439127E50}/GenerateGridsAndHexagons",
    "displayname": "$rc:title",
    "helpcontent": "62010006",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "33",
        "35"
    ],
    "params": {
        "area_of_interest": {
            "displayname": "$rc:area_of_interest.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:area_of_interest.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "area_of_interest"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "featuretype.rule": "AsSpecified",
                "featuretype": "Simple",
                "geometrytype.rule": "AsSpecified",
                "geometrytype": "Polygon",
                "extenttype.rule": "Union",
                "fields.rule": "None",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "cell_type": {
            "type": "optional",
            "displayname": "$rc:cell_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SQUARE",
                        "code": "$rc:cell_type.domain.SQUARE"
                    },
                    {
                        "value": "HEXAGON",
                        "code": "$rc:cell_type.domain.HEXAGON"
                    },
                    {
                        "value": "H3_HEXAGON",
                        "code": "$rc:cell_type.domain.H3_HEXAGON"
                    }
                ]
            },
            "value": "SQUARE",
            "description": "$rc:cell_type.descr"
        },
        "enrich_type": {
            "type": "optional",
            "displayname": "$rc:enrich_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ENRICH_CELL",
                        "code": "$rc:enrich_type.domain.ENRICH_CELL"
                    },
                    {
                        "value": "ENRICH_BUFFER",
                        "code": "$rc:enrich_type.domain.ENRICH_BUFFER"
                    }
                ]
            },
            "description": "$rc:enrich_type.descr"
        },
        "cell_size": {
            "type": "optional",
            "displayname": "$rc:cell_size.title",
            "datatype": {
                "type": "GPArealUnit"
            },
            "value": "1 SquareMiles",
            "description": "$rc:cell_size.descr"
        },
        "h3_resolution": {
            "type": "optional",
            "displayname": "$rc:h3_resolution.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                },
                "high": {
                    "allow": "true",
                    "val": "15"
                }
            },
            "value": "7",
            "description": "$rc:h3_resolution.descr"
        },
        "variables": {
            "type": "optional",
            "control_guid": "{C3227C61-E4D3-4D26-B7F7-4C3FF17BA2D9}",
            "displayname": "$rc:variables.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "description": "$rc:variables.descr"
        },
        "distance_type": {
            "type": "optional",
            "displayname": "$rc:distance_type.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "value": "STRAIGHT_LINE_DISTANCE",
            "description": "$rc:distance_type.descr"
        },
        "distance": {
            "type": "optional",
            "displayname": "$rc:distance.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "1",
            "description": "$rc:distance.descr"
        },
        "units": {
            "type": "optional",
            "displayname": "$rc:units.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:units.descr"
        },
        "out_enriched_buffers": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_enriched_buffers.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "symbologylayer": "GridsAndHexagons_buffer.lyrx",
            "schema": {
                "type": "GPFeatureSchema",
                "featuretype.rule": "AsSpecified",
                "featuretype": "Simple",
                "geometrytype.rule": "AsSpecified",
                "geometrytype": "Polygon",
                "extenttype.rule": "Union",
                "fields.rule": "None",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_enriched_buffers.descr"
        },
        "travel_direction": {
            "type": "optional",
            "displayname": "$rc:travel_direction.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TOWARD_STORES",
                        "code": "$rc:travel_direction.domain.TOWARD_STORES"
                    },
                    {
                        "value": "AWAY_FROM_STORES",
                        "code": "$rc:travel_direction.domain.AWAY_FROM_STORES"
                    }
                ]
            },
            "value": "TOWARD_STORES",
            "description": "$rc:travel_direction.descr"
        },
        "time_of_day": {
            "type": "optional",
            "displayname": "$rc:time_of_day.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_of_day.descr"
        },
        "time_zone": {
            "type": "optional",
            "displayname": "$rc:time_zone.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UTC",
                        "code": "$rc:time_zone.domain.UTC"
                    },
                    {
                        "value": "TIME_ZONE_AT_LOCATION",
                        "code": "$rc:time_zone.domain.TIME_ZONE_AT_LOCATION"
                    }
                ]
            },
            "value": "TIME_ZONE_AT_LOCATION",
            "description": "$rc:time_zone.descr"
        },
        "search_tolerance": {
            "type": "optional",
            "displayname": "$rc:search_tolerance.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:search_tolerance.descr"
        },
        "polygon_detail": {
            "type": "optional",
            "displayname": "$rc:polygon_detail.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "STANDARD",
                        "code": "$rc:polygon_detail.domain.STANDARD"
                    },
                    {
                        "value": "GENERALIZED",
                        "code": "$rc:polygon_detail.domain.GENERALIZED"
                    },
                    {
                        "value": "HIGH",
                        "code": "$rc:polygon_detail.domain.HIGH"
                    }
                ]
            },
            "value": "STANDARD",
            "description": "$rc:polygon_detail.descr"
        },
        "out_centroids": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_centroids.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "featuretype.rule": "AsSpecified",
                "featuretype": "Simple",
                "geometrytype.rule": "AsSpecified",
                "geometrytype": "Polygon",
                "extenttype.rule": "Union",
                "fields.rule": "None",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_centroids.descr"
        }
    },
    "environments": [
        "baDataSource",
        "baNetworkSource",
        "geographicTransformations",
        "outputCoordinateSystem",
        "workspace"
    ]
}
