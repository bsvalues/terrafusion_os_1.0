{
    "map": {
        "description": "Creates a feature class of trade areas around point features based on travel time and distance.",
        "dissolve_option.descr": "<xdoc><p>Specifies whether overlapping or nonoverlapping service areas for a single location will be used when multiple distances are specified.</p><ul><li><span title=\"OVERLAP\">Overlap</span>— Each polygon will include the area reachable from the facility up to the distance value. This is the default.</li><li><span title=\"SPLIT\">Split</span>— Each polygon will include only the area between consecutive distance values.</li></ul></xdoc>",
        "dissolve_option.domain.OVERLAP": "Overlap",
        "dissolve_option.domain.SPLIT": "Split",
        "dissolve_option.title": "Dissolve Option",
        "distance_type.descr": "The method of travel that will be used for drive time calculation.",
        "distance_type.title": "Distance Type",
        "distances.descr": "The distances that will be used for drive time calculations.",
        "distances.title": "Distances",
        "expression.descr": "A fields-based expression used to calculate drive time.",
        "expression.title": "Distance Expression",
        "id_field.descr": "A unique ID field for existing facilities.",
        "id_field.title": "ID Field",
        "in_features.descr": "The input point feature layer.",
        "in_features.title": "Input Features",
        "input_method.descr": "<xdoc><p>Specifies the type of value that will be used for each drive time.</p><ul><li><span title=\"VALUES\">Values</span>—A constant value will be used (all trade areas will be the same size). This is the default.</li><li><span title=\"EXPRESSION\">Expression</span>— The values from a field or an expression will be used (trade areas can be different sizes).</li></ul></xdoc>",
        "input_method.domain.EXPRESSION": "Expression",
        "input_method.domain.VALUES": "Values",
        "input_method.title": "Input Method",
        "out_feature_class.descr": "The output feature class containing the drive time polygons.",
        "out_feature_class.title": "Output Feature Class",
        "params.category1": "Network Parameters",
        "polygon_detail.descr": "<xdoc><p>Specifies the level of detail that will be used for the output drive time polygons.</p><ul><li><span title=\"STANDARD\">Standard</span>— Polygons with a standard level of detail will be created. This is the default.</li><li><span title=\"GENERALIZED\">Generalized</span>—Generalized polygons will be created using the hierarchy present in the network data source to produce results quickly.</li><li><span title=\"HIGH\">High</span>— Polygons with a high level of detail will be created for applications in which precise results are important.</li></ul></xdoc>",
        "polygon_detail.domain.GENERALIZED": "Generalized",
        "polygon_detail.domain.HIGH": "High",
        "polygon_detail.domain.STANDARD": "Standard",
        "polygon_detail.title": "Polygon Detail",
        "remove_overlap.descr": "<xdoc><p>Specifies whether overlapping concentric rings will be created or overlap will be removed from multiple locations in relation to one another.</p><ul><li>Checked—Polygons will be split and the overlap between output features will be removed.</li><li>Unchecked—Output features will be created with overlap. This is the default.</li></ul></xdoc>",
        "remove_overlap.title": "Remove Overlap",
        "search_tolerance.descr": "<xdoc><p>The maximum distance that input points can be from the network. Points located beyond the search tolerance will be excluded from processing.</p><p>This parameter requires a distance value and units for the tolerance. The default value is 5000 meters.</p></xdoc>",
        "search_tolerance.title": "Search Tolerance",
        "time_of_day.descr": "The time and date that will be used when calculating distance.",
        "time_of_day.title": "Time of Day",
        "time_zone.descr": "<xdoc><p>Specifies the time zone that will be used for the <span class=\"esri_uicontrol\">Time of Day</span> parameter.</p><ul><li><span title=\"TIME_ZONE_AT_LOCATION\">Time Zone at Location</span>—The time zone in which the territories are located will be used. This is the default.</li><li><span title=\"UTC\">UTC</span>—Coordinated universal time (UTC) will be used.</li></ul></xdoc>",
        "time_zone.domain.TIME_ZONE_AT_LOCATION": "Time Zone at Location",
        "time_zone.domain.UTC": "UTC",
        "time_zone.title": "Time Zone",
        "title": "Generate Drive Time Trade Areas",
        "travel_direction.descr": "<xdoc><p>Specifies the direction of travel toward or away from stores.</p><ul><li><span title=\"TOWARD_STORES\">Toward stores</span>— The direction of travel will be toward stores. This is the default.</li><li><span title=\"AWAY_FROM_STORES\">Away from stores</span>— The direction of travel will be away from stores.</li></ul></xdoc>",
        "travel_direction.domain.AWAY_FROM_STORES": "Away from stores",
        "travel_direction.domain.TOWARD_STORES": "Toward stores",
        "travel_direction.title": "Travel Direction",
        "units.descr": "The units that will be used for the distance values. The default value is miles.",
        "units.title": "Distance Units"
    }
}
