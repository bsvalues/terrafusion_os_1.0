{
    "map": {
        "attractiveness_variables.descr": "<xdoc><p>The attribute fields that indicate the attractiveness of each competitor. In many cases, the size of the facility is used as a substitute for attractiveness and will be a multivalue table.</p><p>An additional attractiveness variable is needed. The attractiveness field must be present in the existing facilities (competitors) and the candidate facilities layer.</p><ul><li>Existing Facilities Value—Numeric field in the <span class=\"esri_uicontrol\">Input Facility Features</span> parameter layer that represents attractiveness.</li><li>Candidates Location Value—Numeric Field in the <span class=\"esri_uicontrol\">Input Candidate Features</span> parameter layer that matches the attractiveness value from the <span class=\"esri_uicontrol\">Input Facility Features</span> parameter layer. Distance does not require a matching field.</li><li>Exponent—The value that determines how much of a factor the variable is to the attractiveness value. The default value is 1.</li></ul></xdoc>",
        "attractiveness_variables.dt.title1": "Existing Facilities Value",
        "attractiveness_variables.dt.title2": "Candidates Location Value",
        "attractiveness_variables.dt.title3": "Exponent",
        "attractiveness_variables.title": "Attractiveness Variables",
        "candidate_id_field.descr": "A unique ID field for candidate facilities.",
        "candidate_id_field.title": "Candidate ID Field",
        "description": "Creates a probability surface to predict the sales potential of an area based on distance and an attractiveness factor.",
        "distance_exponent.descr": "The distance exponent is generally a negative number because attractiveness decreases when distance increases. The default value is -1.5.",
        "distance_exponent.title": "Distance Exponent",
        "distance_type.descr": "The type of distance, based on method of travel, that will be used. The default value is Straight Line.",
        "distance_type.title": "Distance Type",
        "distance_units.descr": "The distance-measuring units that will be used when calculating distance.",
        "distance_units.title": "Distance Units",
        "facility_id_field.descr": "A unique ID field for existing facilities.",
        "facility_id_field.title": "Facility ID Field",
        "in_candidate_features.descr": "An input point feature layer representing new candidate facility locations. It is the first feature from the layer or the feature selected when a selection is available.",
        "in_candidate_features.title": "Input Candidate Features",
        "in_facility_features.descr": "An input point feature layer representing existing facility locations. It is the first feature from the layer or the feature selected when a selection is available.",
        "in_facility_features.title": "Input Facility Features",
        "in_sales_potential_features.descr": "An input point or polygon feature layer used to calculate the sales potential. It is either all features from a layer or only selected features when a selection is available.",
        "in_sales_potential_features.title": "Input Sales Potential Features",
        "out_distance_matrix.descr": "<xdoc><p>The name and location of the matrix table of distance calculations. The IDs for the <span class=\"esri_uicontrol\">Input Facilitates Features</span> and <span class=\"esri_uicontrol\">Input Candidate Features</span> parameters must be unique.</p></xdoc>",
        "out_distance_matrix.title": "Output Distance Matrix",
        "out_feature_class.descr": "The output feature class that will contain the tool results representing the probability of sales.",
        "out_feature_class.title": "Output feature Class",
        "out_predicted_sales.title": "Predicted Sales",
        "params.category1": "Network Parameters",
        "sales_potential_field.descr": "The field containing the values that will be used to calculate the sales potential.",
        "sales_potential_field.title": "Sales Potential Field",
        "sales_potential_id_field.descr": "A unique ID field for sales potential features.",
        "sales_potential_id_field.title": "Sales Potential ID Field",
        "time_of_day.descr": "The time and date that will be used when calculating distance.",
        "time_of_day.title": "Time of Day",
        "time_zone.descr": "<xdoc><p>Specifies the time zone that will be used for the <span class=\"esri_uicontrol\">Time of Day</span> parameter.</p><ul><li><span title=\"TIME_ZONE_AT_LOCATION\">Time Zone at Location</span>—The time zone in which the territories are located will be used. This is the default.</li><li><span title=\"UTC\">UTC</span>—Coordinated universal time (UTC) will be used.</li></ul></xdoc>",
        "time_zone.domain.TIME_ZONE_AT_LOCATION": "Time Zone at Location",
        "time_zone.domain.UTC": "UTC",
        "time_zone.title": "Time Zone",
        "title": "Huff Model",
        "travel_direction.descr": "<xdoc><p>Specifies the direction of travel that will be used between stores and sales potential features.</p><ul><li><span title=\"TOWARD_STORES\">Toward Stores</span>—The direction of travel will be from sales potential features to stores. This is the default.</li><li><span title=\"AWAY_FROM_STORES\">Away from Stores</span>—The direction of travel will be from stores to sales potential features.</li></ul></xdoc>",
        "travel_direction.domain.AWAY_FROM_STORES": "Away from Stores",
        "travel_direction.domain.TOWARD_STORES": "Toward Stores",
        "travel_direction.title": "Travel Direction"
    }
}
