{
    "map": {
        "add_angle_field.descr": "<xdoc><p>Specifies whether a <span class=\"esri_fieldname\">LOC_ANGLE</span> field will be added to the temporary layer that is created. This parameter is only valid when the event type is point.</p><ul><li>Unchecked—A field to store locating angles will not be added. This is the default.</li><li>Checked—A field to store locating angles will be added.</li></ul></xdoc>",
        "add_angle_field.title": "Generate an angle field",
        "add_error_field.descr": "<xdoc><p>Specifies whether a <span class=\"esri_fieldname\">LOC_ERROR</span> field will be added to the temporary layer that is created.</p><ul><li>Unchecked—A field to store locating errors will not be added. This is the default.</li><li>Checked—A field to store locating errors will be added.</li></ul></xdoc>",
        "add_error_field.title": "Generate a field for locating errors",
        "angle_type.descr": "<xdoc><p>Specifies the type of locating angle that will be calculated. This parameter is only valid if <span class=\"esri_uicontrol\">Generate an angle field</span> is checked.</p><ul><li><span title=\"NORMAL\">Normal</span>—The normal (perpendicular) angle will be calculated. This is the default.</li><li><span title=\"TANGENT\">Tangent</span>—The tangent angle will be calculated.</li></ul></xdoc>",
        "angle_type.domain.NORMAL": "Normal",
        "angle_type.domain.TANGENT": "Tangent",
        "angle_type.title": "Calculated Angle Type",
        "complement_angle.descr": "<xdoc><p>Specifies whether the complement of the locating angle will be written. This parameter is only valid if <span class=\"esri_uicontrol\">Generate an angle field</span> is checked.</p><ul><li>Unchecked—The complement of the angle will not be written. Only the calculated angle will be written. This is the default.</li><li>Checked—The complement of the angle will be written.</li></ul></xdoc>",
        "complement_angle.title": "Write the complement of the angle to the angle field",
        "description": "Creates a temporary feature layer using routes and route events.",
        "in_event_properties.descr": "<xdoc><p>The route location fields and the type of events in the input event table.</p><ul><li>Route Identifier Field—The field containing values that indicate the route on which each event is located. This field can be a numeric, text, or GUID field.</li><li>Event Type—The type of events in the input event table (<span class=\"esri_uicontrol\">Point</span> or <span class=\"esri_uicontrol\">Line</span>).<ul><li>Point—Point events occur at a precise location along a route. Only a from-measure field must be specified.</li><li>Line—Line events define a portion of a route. Both from- and to-measure fields must be specified.</li></ul></li><li>From-Measure Field—A field containing measure values. This field must be numeric and is required when the event type is <span class=\"esri_uicontrol\">Point</span> or <span class=\"esri_uicontrol\">Line</span>. When the <span class=\"esri_uicontrol\">Event Type</span> value is <span class=\"esri_uicontrol\">Point</span>, the label for this parameter becomes <span class=\"esri_uicontrol\">Measure Field</span>.</li><li>To-Measure Field—A field containing measure values. This field must be numeric and is required when the event type is <span class=\"esri_uicontrol\">Line</span>.</li></ul></xdoc>",
        "in_event_properties.title": "Event Table Properties",
        "in_routes.descr": "The route features on which events will be located.",
        "in_routes.title": "Input Route Features",
        "in_table.descr": "The table whose rows will be located along routes.",
        "in_table.title": "Input Event Table",
        "offset_direction.descr": "<xdoc><p>Specifies the side on which the route events with a positive offset will be displayed. This parameter is only valid if an offset field has been specified.</p><ul><li>Unchecked—Events with a positive offset will be displayed to the left of the route. The side of the route is determined by the measures and not necessarily the digitized direction. This is the default.</li><li>Checked—Events with a positive offset will be displayed to the right of the route. The side of the route is determined by the digitized direction.</li></ul></xdoc>",
        "offset_direction.title": "Events with a positive offset will be placed to the right of the routes",
        "offset_field.descr": "The field containing the values that will be used to offset events from their underlying route. This field must be numeric.",
        "offset_field.title": "Offset Field",
        "out_layer.descr": "The layer that will be created. This layer is stored in memory, so a path is not necessary.",
        "out_layer.title": "Layer Name or Table View",
        "point_event_type.descr": "<xdoc><p>Specifies whether point events will be treated as point features or multipoint features.</p><ul><li>Unchecked—Point events will be treated as point features. This is the default.</li><li>Checked—Point events will be treated as multipoint features.</li></ul></xdoc>",
        "point_event_type.title": "Point events will be generated as multipoint features",
        "route_id_field.descr": "The field containing values that uniquely identify each route. The field can be a numeric, text, or GUID field.",
        "route_id_field.title": "Route Identifier Field",
        "summary": "<xdoc><p>Creates a temporary feature layer using routes and route events.</p><p>When the temporary layer is used (displayed on a map or used by another geoprocessing tool), dynamic segmentation is performed.</p></xdoc>",
        "title": "Make Route Event Layer"
    }
}
