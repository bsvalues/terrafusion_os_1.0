{
    "map": {
        "build_index.descr": "<xdoc><p>Specifies whether an attribute index will be created for the route identifier field that is written to the <span class=\"esri_uicontrol\">Output Route Feature Class</span> parameter value.</p><ul><li>Checked—An attribute index will be created. This is the default.</li><li>Unchecked—An attribute index will not be created.</li></ul></xdoc>",
        "build_index.title": "Build index",
        "calibrate_method.descr": "<xdoc><p>Specifies how route measures will be recalculated.</p><ul><li><span title=\"DISTANCE\">Distance</span>—Measures will be recalculated using the shortest path distance between the calibration points. This is the default.</li><li><span title=\"MEASURES\">Measures</span>—Measures will be recalculated using the pre-existing measure distance between the calibration points.</li></ul></xdoc>",
        "calibrate_method.domain.DISTANCE": "Distance",
        "calibrate_method.domain.MEASURES": "Measures",
        "calibrate_method.title": "Measure Calculation Method",
        "description": "Recalculates route measures using points.",
        "extrapolate_after.descr": "<xdoc><p>Specifies whether measure values will be extrapolated after the calibration points.</p><ul><li>Checked—Measure values will be extrapolated after the calibration points. This is the default.</li><li>Unchecked—Measure values will not be extrapolated after the calibration points.</li></ul></xdoc>",
        "extrapolate_after.title": "Extrapolate after calibration points",
        "extrapolate_before.descr": "<xdoc><p>Specifies whether measure values will be extrapolated before the calibration points.</p><ul><li>Checked—Measure values will be extrapolated before the calibration points. This is the default.</li><li>Unchecked—Measure values will not be extrapolated before the calibration points.</li></ul></xdoc>",
        "extrapolate_before.title": "Extrapolate before calibration points",
        "ignore_gaps.descr": "<xdoc><p>Specifies whether spatial gaps will be ignored when recalculating the measures on disjointed routes.</p><ul><li>Checked—Spatial gaps will be ignored. Measure values will be continuous for disjointed routes. This is the default.</li><li>Unchecked—Spatial gaps will not be ignored . The measure values on disjointed routes will have gaps. The gap distance is calculated using the straight-line distance between the endpoints of the disjointed parts.</li></ul></xdoc>",
        "ignore_gaps.title": "Ignore spatial gaps",
        "in_point_features.descr": "The point features that will be used to calibrate the routes.",
        "in_point_features.title": "Input Point Features",
        "in_route_features.descr": "The route features that will be calibrated.",
        "in_route_features.title": "Input Route Features",
        "interpolate_between.descr": "<xdoc><p>Specifies whether measure values will be interpolated between the calibration points.</p><ul><li>Checked—Measure values will be interpolated between the calibration points. This is the default.</li><li>Unchecked—Measure values will not be interpolated between the calibration points.</li></ul></xdoc>",
        "interpolate_between.title": "Interpolate between calibration points",
        "keep_all_routes.descr": "<xdoc><p>Specifies whether route features with no calibration points will be included in the output feature class.</p><ul><li>Checked—All route features will be included in the output feature class. This is the default.</li><li>Unchecked—All route features will not necessarily be included in the output feature class. Features with no calibration points will be excluded.</li></ul></xdoc>",
        "keep_all_routes.title": "Include all features in the output feature class",
        "measure_field.descr": "The field containing the measure value for each calibration point. This field must be numeric.",
        "measure_field.title": "Measure Field",
        "out_feature_class.descr": "The feature class that will be created. It can be a shapefile or a geodatabase feature class.",
        "out_feature_class.title": "Output Route Feature Class",
        "point_id_field.descr": "The field that identifies the route on which each calibration point is located. The values in this field match those in the route identifier field. This field can be a numeric, text, or GUID field.",
        "point_id_field.title": "Point Identifier Field",
        "route_id_field.descr": "The field containing values that uniquely identify each route. The field can be a numeric, text, or GUID field.",
        "route_id_field.title": "Route Identifier Field",
        "search_radius.descr": "Limits how far a calibration point can be from a route by specifying the distance and its unit of measure. If the unit of measure is unknown, the units of the coordinate system of the route feature class will be used.",
        "search_radius.title": "Search Radius",
        "title": "Calibrate Routes"
    }
}
