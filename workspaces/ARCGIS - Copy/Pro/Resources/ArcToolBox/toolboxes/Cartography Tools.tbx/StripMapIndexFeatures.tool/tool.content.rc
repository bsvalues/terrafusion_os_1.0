{
    "map": {
        "description": "Creates a series of rectangular polygons, or index features, that follow a single linear feature or a group of linear features. These index features can be used with spatial map series to define pages in a strip map or a set of maps that follow a linear feature. The resulting index features contain attributes that can be used to rotate and orient the map on the page and determine which index features, or pages, are next to the current page (to the left and right or to the top and bottom).",
        "direction_type.descr": "<xdoc><p>Specifies the initial direction of the strip maps.</p><ul><li><span title=\"WE_NS\">West to East and North to South</span>—If the line&apos;s directional trend is West to East, the starting point will be at the westernmost end of the line, or if the line&apos;s direction trend is North to South, the starting point will be at the northernmost end of the line. This is the default.</li><li><span title=\"WE_SN\">West to East and South to North</span>—If the line&apos;s directional trend is West to East, the starting point will be at the westernmost end of the line, or if the line&apos;s direction trend is South to North, the starting point will be at the southernmost end of the line.</li><li><span title=\"EW_NS\">East to West and North to South</span>—If the line&apos;s directional trend is East to West, the starting point will be at the easternmost end of the line, or if the line&apos;s direction trend is North to South, the starting point will be at the northernmost end of the line.</li><li><span title=\"EW_SN\">East to West and South to North</span>—If the line&apos;s directional trend is East to West, the starting point will be at the easternmost end of the line, or if the line&apos;s direction trend is South to North, the starting point will be at the southernmost end of the line.</li></ul></xdoc>",
        "direction_type.domain.EW_NS": "East to West and North to South",
        "direction_type.domain.EW_SN": "East to West and South to North",
        "direction_type.domain.WE_NS": "West to East and North to South",
        "direction_type.domain.WE_SN": "West to East and South to North",
        "direction_type.title": "Strip Map Direction",
        "in_features.descr": "The input polyline features defining the path of the strip map index features.",
        "in_features.title": "Input Line Features",
        "length_along_line.descr": "The length of the polygon index feature along the input line feature specified in either map or page units. The default value is determined by the spatial reference of the input line feature or features. This value will be 1/100 of the input feature class extent along the x axis.",
        "length_along_line.title": "Length Along the Line",
        "length_perpendicular_to_line.descr": "The length of the polygon index feature perpendicular to the input line feature specified in either map or page units. The default value is determined by the spatial reference of the input line feature or features. This value will be one-half the number used for the length along the line.",
        "length_perpendicular_to_line.title": "Length Perpendicular to the Line",
        "out_feature_class.descr": "The output feature class of polygon index features.",
        "out_feature_class.title": "Output Feature Class",
        "overlap_percentage.descr": "The approximate percentage of geographic overlap between an individual map page and its adjoining pages in the series. The default is 10.",
        "overlap_percentage.title": "Percentage of Overlap",
        "page_orientation.descr": "<xdoc><p>Specifies the orientation of the input line features on the layout page.</p><ul><li><span title=\"VERTICAL\">Vertical</span>—The direction of the strip map series on the page is top to bottom.</li><li><span title=\"HORIZONTAL\">Horizontal</span>—The direction of the strip map series on the page is left to right. This is the default.</li></ul></xdoc>",
        "page_orientation.domain.HORIZONTAL": "Horizontal",
        "page_orientation.domain.VERTICAL": "Vertical",
        "page_orientation.title": "Page Orientation",
        "scale.descr": "Map scale must be specified if index feature lengths (along the line and perpendicular to the line) are to be calculated in page units. If you're using ArcGIS Pro, the default value will be the scale of the active data frame; otherwise, the default will be 1.",
        "scale.title": "Map Scale",
        "starting_page_number.descr": "The page number of the starting page. Each grid index feature is assigned a sequential page number beginning with the specified starting page number. The default is 1.",
        "starting_page_number.title": "Starting Page Number",
        "title": "Strip Map Index Features",
        "use_page_unit.descr": "<xdoc><p>Specifies whether index feature size input is in page units.</p><ul><li>Checked—Index polygon height and width are calculated in page units.</li><li>Unchecked—Index polygon height and width are calculated in map units. This is the default.</li></ul></xdoc>",
        "use_page_unit.title": "Use Page Unit and Scale"
    }
}
