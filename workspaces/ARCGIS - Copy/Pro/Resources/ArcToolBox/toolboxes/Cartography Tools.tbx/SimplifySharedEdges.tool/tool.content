{
    "type": "FunctionTool",
    "guid": "{ac923ff9-9133-448e-a38d-5c13afe12bdc}",
    "displayname": "$rc:title",
    "helpcontent": "10000004",
    "description": "$rc:description",
    "product": "200",
    "attributes": [
        "edit_session",
        "input_data_change"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple",
                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexEdge",
                    "RasterCatalogItem"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "algorithm": {
            "displayname": "$rc:algorithm.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POINT_REMOVE",
                        "code": "$rc:algorithm.domain.POINT_REMOVE"
                    },
                    {
                        "value": "BEND_SIMPLIFY",
                        "code": "$rc:algorithm.domain.BEND_SIMPLIFY"
                    },
                    {
                        "value": "WEIGHTED_AREA",
                        "code": "$rc:algorithm.domain.WEIGHTED_AREA"
                    },
                    {
                        "value": "EFFECTIVE_AREA",
                        "code": "$rc:algorithm.domain.EFFECTIVE_AREA"
                    }
                ]
            },
            "value": "POINT_REMOVE",
            "description": "$rc:algorithm.descr"
        },
        "tolerance": {
            "displayname": "$rc:tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:tolerance.descr"
        },
        "shared_edge_features": {
            "type": "optional",
            "displayname": "$rc:shared_edge_features.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple",
                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexEdge",
                    "RasterCatalogItem"
                ]
            },
            "description": "$rc:shared_edge_features.descr"
        },
        "minimum_area": {
            "type": "optional",
            "displayname": "$rc:minimum_area.title",
            "datatype": {
                "type": "GPArealUnit"
            },
            "depends": [
                "in_features"
            ],
            "value": "0 Unknown",
            "description": "$rc:minimum_area.descr"
        },
        "in_barriers": {
            "type": "optional",
            "displayname": "$rc:in_barriers.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "description": "$rc:in_barriers.descr"
        },
        "out_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "depends": [
                "in_features"
            ]
        },
        "out_shared_edge_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_shared_edge_feature_class.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "depends": [
                "shared_edge_features"
            ]
        }
    },
    "environments": [
        "cartographicPartitions"
    ]
}
