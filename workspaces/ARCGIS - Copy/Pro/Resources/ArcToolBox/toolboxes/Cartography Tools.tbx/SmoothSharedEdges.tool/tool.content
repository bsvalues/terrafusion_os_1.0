                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple",
                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexEdge",
                    "RasterCatalogItem"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "algorithm": {
            "displayname": "$rc:algorithm.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PAEK",
                        "code": "$rc:algorithm.domain.PAEK"
                    },
                    {
                        "value": "BEZIER_INTERPOLATION",
                        "code": "$rc:algorithm.domain.BEZIER_INTERPOLATION"
                    }
                ]
            },
            "value": "PAEK",
            "description": "$rc:algorithm.descr"
        },
        "tolerance": {
            "displayname": "$rc:tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:tolerance.descr"
        },
        "shared_edge_features": {
            "type": "optional",
            "displayname": "$rc:shared_edge_features.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple",
                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexEdge",
                    "RasterCatalogItem"
                ]
            },
            "description": "$rc:shared_edge_features.descr"
        },
        "in_barriers": {
            "type": "optional",
            "displayname": "$rc:in_barriers.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
