{
    "map": {
        "description": "Creates a layer with calculated field values.",
        "existing_field.descr": "The existing field that will have values calculated.",
        "existing_field.title": "Existing Field",
        "expression.descr": "<xdoc><p>Calculates values in the field. Expressions are written in Arcade and can include [+ - * / ] operators and multiple fields. Calculated values are applied in the units of the spatial reference of the input unless you are using a geographic coordinate system, in which case they will be in meters.</p><p>If the layer is added to the map, the <span class=\"esri_uicontrol\">Fields</span> and <span class=\"esri_uicontrol\">Helpers</span> filters can be used to build an expression.</p></xdoc>",
        "expression.title": "Expression",
        "field_name.descr": "The new field that will have values calculated.",
        "field_name.title": "New Field Name",
        "field_to_calculate.descr": "<xdoc><p>Specifies whether values will be calculated for a newly created field or an existing field.</p><ul><li><span title=\"NEW_FIELD\">New field</span>—Values will be calculated for a newly created field.</li><li><span title=\"EXISTING_FIELD\">Existing field</span>—Values will be calculated for an existing field.</li></ul></xdoc>",
        "field_to_calculate.domain.EXISTING_FIELD": "Existing field",
        "field_to_calculate.domain.NEW_FIELD": "New field",
        "field_to_calculate.title": "Field to Calculate",
        "field_type.descr": "<xdoc><p>Specifies the field type for the calculated field.</p><ul><li><span title=\"STRING\">String</span>—Any string of characters</li><li><span title=\"INTEGER\">Integer</span>—Whole numbers</li><li><span title=\"DOUBLE\">Double</span>— Fractional numbers</li><li><span title=\"DATE\">Date</span>— Date</li></ul></xdoc>",
        "field_type.domain.DATE": "Date",
        "field_type.domain.DOUBLE": "Double",
        "field_type.domain.INTEGER": "Integer",
        "field_type.domain.STRING": "String",
        "field_type.title": "Field Type",
        "input_layer.descr": "The input features that will have a field calculated.",
        "input_layer.title": "Input Layer",
        "output.descr": "A new dataset with calculated fields.",
        "output.title": "Output Dataset",
        "time_boundary_reference.descr": "The reference time used to split the input data into for analysis. Time boundaries will be created for the entire span of the data, and the reference time does not need to occur at the start. If no reference time is specified, January 1, 1970, is used.",
        "time_boundary_reference.title": "Time Boundary Reference",
        "time_boundary_split.descr": "A time span to split the input data into for analysis. A time boundary allows you to analyze values within a defined time span. For example, if you use a time boundary of 1 day, and set the time boundary reference to January 1, 1980, tracks will be split at the beginning of every day.",
        "time_boundary_split.title": "Time Boundary Split",
        "title": "Calculate Field",
        "track_aware.descr": "<xdoc><p>Specifies whether the expression will use a track-aware expression.<ul><li>Checked—The expression will use a track-aware expression, and a track field must be specified.</li><li>Unchecked—The expression will not use a track-aware expression. This is the default.</li></ul></p></xdoc>",
        "track_aware.title": "Track Aware",
        "track_fields.descr": "One or more fields that will be used to identify unique tracks.",
        "track_fields.title": "Track Fields"
    }
