{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "69000025",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "spark"
    ],
    "params": {
        "bdc_file": {
            "displayname": "$rc:bdc_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "bdc",
                    "mfc"
                ]
            },
            "description": "$rc:bdc_file.descr"
        },
        "visible_geometry": {
            "type": "optional",
            "displayname": "$rc:visible_geometry.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "GEOMETRY_VISIBLE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "GEOMETRY_NOT_VISIBLE"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:visible_geometry.descr"
        },
        "visible_time": {
            "type": "optional",
            "displayname": "$rc:visible_time.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "TIME_VISIBLE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "TIME_NOT_VISIBLE"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:visible_time.descr"
        },
        "updated_bdc": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_bdc.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "bdc",
                    "mfc"
                ]
            }
        }
    }
}
