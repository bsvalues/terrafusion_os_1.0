{
    "map": {
        "buffer_expression.descr": "<xdoc><p>The expression that will be used to buffer input features. Fields must be numeric, and the expression can include [+ - * / ] operators and multiple fields. Calculated values are applied in the units of the spatial reference of the input unless you are using a geographic coordinate system, in which case they will be in meters.</p><p>Use Arcade expressions such as as_kilometers($feature.distance) * 2 + as_meters(15).</p><p>If the layer is added to the map, the <span class=\"esri_uicontrol\">Fields</span> and <span class=\"esri_uicontrol\">Helpers</span> filters can be used to build an expression.</p></xdoc>",
        "buffer_expression.title": "Buffer Expression",
        "buffer_field.descr": "The field that will be used to buffer the input features. Field values are applied in the units of the spatial reference of the input unless you are using a geographic coordinate system, in which case they will be in meters.",
        "buffer_field.title": "Buffer Field",
        "buffer_type.descr": "<xdoc><p>Specifies how the buffer distance will be defined.</p><ul><li><span title=\"FIELD\">Field</span>—A single field will be used to define the buffer distance.</li><li><span title=\"EXPRESSION\">Expression</span>—An equation using fields and mathematical operators will be used to define the buffer distance.</li></ul></xdoc>",
        "buffer_type.domain.EXPRESSION": "Expression",
        "buffer_type.domain.FIELD": "Field",
        "buffer_type.title": "Buffer Type",
        "description": "Creates line or polygon tracks from time-enabled input data.",
        "distance_split.descr": "Features that are farther apart in distance than the distance split value will be split into separate tracks.",
        "distance_split.title": "Distance Split",
        "input_layer.descr": "The points or polygons to be reconstructed into tracks. The input must be a time-enabled layer that represents an instant in time.",
        "input_layer.title": "Input Layer",
        "method.descr": "<xdoc><p>Specifies the criteria that will be used to reconstruct tracks. If a buffer is used, the <span class=\"esri_uicontrol\">Method</span> parameter determines the type of buffer.</p><ul><li><span title=\"GEODESIC\">Geodesic</span>— If the spatial reference can be panned, tracks will cross the date line when appropriate. If the spatial reference cannot be panned, tracks will be limited to the coordinate system extent and may not wrap.</li><li><span title=\"PLANAR\">Planar</span>—Planar buffers will be created.</li></ul></xdoc>",
        "method.domain.GEODESIC": "Geodesic",
        "method.domain.PLANAR": "Planar",
        "method.title": "Method",
        "out_feature_class.descr": "A new feature class with the resulting tracks.",
        "out_feature_class.title": "Output Feature Class",
        "params.category1": "Track Split Options",
        "split_expression.descr": "An expression that splits tracks based on values, geometry, or time values. Expressions that validate to true will be split.",
        "split_expression.title": "Split Expression",
        "split_type.descr": "<xdoc><p>Specifies how the track segment between two features is created when a track is split. The split type is applied to split expressions, distance splits, and time splits.</p><ul><li><span title=\"GAP\">Gap</span>—No segment is created between the two features. This is the default.</li><li><span title=\"FINISH_LAST\">Finish After</span>—A segment is created between the two features that ends after the split.</li><li><span title=\"START_NEXT\">Start Before</span>—A segment is created between the two features that ends before the split.</li></ul></xdoc>",
        "split_type.domain.FINISH_LAST": "Finish After",
        "split_type.domain.GAP": "Gap",
        "split_type.domain.START_NEXT": "Start Before",
        "split_type.title": "Split Type",
        "summary_fields.descr": "<xdoc><p>The statistics that will be calculated on specified fields.</p><p><ul><li>Count—The number of nonnull values. It can be used on numeric fields or strings. The count of [null, 0, 2] is 2.</li><li>Sum—The sum of numeric values in a field. The sum of [null, null, 3] is 3.</li><li>Mean—The mean of numeric values. The mean of [0, 2, null] is 1.</li><li>Min—The minimum value of a numeric field. The minimum of [0, 2, null] is 0.</li><li>Max—The maximum value of a numeric field. The maximum value of [0, 2, null] is 2.</li><li>Standard Deviation—The standard deviation of a numeric field. The standard deviation of [1] is null. The standard deviation of [null, 1,1,1] is null.</li><li>Variance—The variance of a numeric field in a track. The variance of [1] is null. The variance of [null, 1, 1, 1] is null.</li><li>Range—The range of a numeric field. This is calculated as the minimum value subtracted from the maximum value. The range of [0, null, 1] is 1. The range of [null, 4] is 0.</li><li>Any—A sample string from a field of type string.</li><li>First—The first value of a specified field in a track.</li><li>Last—The last value of a specified field in a track.</li></ul></p></xdoc>",
        "summary_fields.domain.item2.ANY": "Any",
        "summary_fields.domain.item2.COUNT": "Count",
        "summary_fields.domain.item2.FIRST": "First",
        "summary_fields.domain.item2.LAST": "Last",
        "summary_fields.domain.item2.MAX": "Maximum",
        "summary_fields.domain.item2.MEAN": "Mean",
        "summary_fields.domain.item2.MIN": "Minimum",
        "summary_fields.domain.item2.RANGE": "Range",
        "summary_fields.domain.item2.STDDEV": "Standard deviation",
        "summary_fields.domain.item2.SUM": "Sum",
        "summary_fields.domain.item2.VAR": "Variance",
        "summary_fields.dt.title1": "Field",
        "summary_fields.dt.title2": "Statistics",
        "summary_fields.title": "Summary Fields",
        "time_boundary_reference.descr": "The reference time used to split the input data into for analysis. Time boundaries will be created for the entire span of the data, and the reference time does not need to occur at the start. If no reference time is specified, January 1, 1970, is used.",
        "time_boundary_reference.title": "Time Boundary Reference",
        "time_boundary_split.descr": "A time span to split the input data into for analysis. A time boundary allows you to analyze values within a defined time span. For example, if you use a time boundary of 1 day, and set the time boundary reference to January 1, 1980, tracks will be split at the beginning of every day.",
        "time_boundary_split.title": "Time Boundary Split",
        "time_split.descr": "Features that are farther apart in time than the time-split duration will be split into separate tracks.",
        "time_split.title": "Time Split",
        "title": "Reconstruct Tracks",
        "track_fields.descr": "One or more fields that will be used to identify unique tracks.",
        "track_fields.title": "Track Fields"
    }
