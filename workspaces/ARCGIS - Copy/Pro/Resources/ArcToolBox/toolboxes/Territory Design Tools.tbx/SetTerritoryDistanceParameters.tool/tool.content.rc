{
    "map": {
        "buffer_distance.descr": "The radius of the territory buffer.",
        "buffer_distance.title": "Territory Buffer Distance",
        "build_index.descr": "<xdoc><p>Specifies whether a network index will be built. A network index will improve performance when solving the territory solution.</p><ul><li>Checked—A network index will be built. This is the default.</li><li>Unchecked—A network index will not be built.</li></ul></xdoc>",
        "build_index.title": "Build Network Index",
        "description": "Defines the type of distance calculation or distance constraints to use when creating territories.",
        "distance_type.descr": "<xdoc><p>Specifies the method of travel that will be used for the distance calculation.</p><ul><li><span title=\"STRAIGHT_LINE\">Straight Line</span>—Straight line, or Euclidean distance, will be used as the distance measure. This is the default.</li></ul><p>When a network data source is selected, additional travel mode options will be dynamically populated.</p><p>The following distance methods are supported:<ul><li>Driving Time</li><li>Driving Distance</li><li>Trucking Time</li><li>Trucking Distance</li><li>Walking Time</li><li>Walking Distance</li><li>Rural Trucking Time</li><li>Rural Trucking Distance</li></ul></p></xdoc>",
        "distance_type.domain.STRAIGHT_LINE": "Straight Line",
        "distance_type.title": "Distance Type",
        "in_territory_solution.descr": "The Territory Design solution layer that will be used in the analysis.",
        "in_territory_solution.title": "Input Territory Solution",
        "level.descr": "The level to which the distance parameters will be applied.",
        "level.title": "Level",
        "max_radius.descr": "The maximum radius of the territory.",
        "max_radius.title": "Maximum Territory Radius",
        "min_distance.descr": "The minimum distance between territory centers.",
        "min_distance.title": "Minimum Distance Between Centers",
        "network_datasource.descr": "The network dataset on which the network distance calculation will be performed. The parameter requires a locally installed dataset.",
        "network_datasource.title": "Network Data Source",
        "out_territory_solution.title": "Updated Territory Solution",
        "params.category1": "Additional Distance Settings",
        "params.category2": "Network Parameters",
        "search_tolerance.descr": "<xdoc><p>The search tolerance that will be used for locating territories on the network. Territories that are outside the search tolerance will be left unlocated.</p><p>This parameter requires a distance value and units for the tolerance. The default value is 5000 meters.</p></xdoc>",
        "search_tolerance.title": "Search Tolerance",
        "time_of_day.descr": "The time and date that will be used when calculating distance.",
        "time_of_day.title": "Time of Day",
        "time_zone.descr": "<xdoc><p>Specifies the time zone of the <span class=\"esri_uicontrol\">Time of Day</span> parameter.</p><ul><li><span title=\"TIME_ZONE_AT_LOCATION\">Time Zone at Location</span>—The time zone in which the territories are located will be used. This is the default.</li><li><span title=\"UTC\">UTC</span>—Coordinated universal time (UTC) will be used.</li></ul></xdoc>",
        "time_zone.domain.TIME_ZONE_AT_LOCATION": "Time Zone at Location",
        "time_zone.domain.UTC": "UTC",
        "time_zone.title": "Time Zone",
        "title": "Set Territory Distance Parameters",
        "travel_direction.descr": "<xdoc><p>Specifies the direction of travel between stores and customers.</p><ul><li><span title=\"TOWARD_STORES\">Toward Stores</span>—Direction of travel will be from customers to stores. This is the default.</li><li><span title=\"AWAY_FROM_STORES\">Away from Stores</span>—Direction of travel will be from stores to customers.</li></ul></xdoc>",
        "travel_direction.domain.AWAY_FROM_STORES": "Away from Stores",
        "travel_direction.domain.TOWARD_STORES": "Toward Stores",
        "travel_direction.title": "Travel Direction",
        "units.descr": "<xdoc><p>Specifies the type of measuring units that will be used.</p><ul><li><span title=\"METERS\">Meters</span>—The distance unit will be meters.</li><li><span title=\"MILES\">Miles</span>—The distance unit will be miles.</li><li><span title=\"NAUTICAL_MILES\">Nautical Miles</span>—The distance unit will be nautical miles.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The distance unit will be kilometers.</li><li><span title=\"YARDS\">Yards</span>—The distance unit will be yards.</li><li><span title=\"FEET\">Feet</span>—The distance unit will be feet.</li><li><span title=\"INCHES\">Inches</span>—The distance unit will be inches.</li><li><span title=\"DECIMETERS\">Decimeters</span>—The distance unit will be decimeters.</li><li><span title=\"CENTIMETERS\">Centimeters</span>—The distance unit will be centimeters.</li><li><span title=\"MILLIMETERS\">Millimeters</span>—The distance unit will be millimeters.</li><li><span title=\"DECIMAL_DEGREES\">Decimal Degrees</span>—The distance unit will be decimal degrees.</li><li><span title=\"MINUTES\">Minutes</span>—The time unit will be minutes.</li><li><span title=\"HOURS\">Hours</span>—The time unit will be hours.</li><li><span title=\"DAYS\">Days</span>—The time unit will be days.</li><li><span title=\"SECONDS\">Seconds</span>—The time unit will be seconds.</li></ul></xdoc>",
        "units.domain.CENTIMETERS": "Centimeters",
        "units.domain.DAYS": "Days",
        "units.domain.DECIMAL_DEGREES": "Decimal Degrees",
        "units.domain.DECIMETERS": "Decimeters",
        "units.domain.FEET": "Feet",
        "units.domain.HOURS": "Hours",
        "units.domain.INCHES": "Inches",
        "units.domain.KILOMETERS": "Kilometers",
