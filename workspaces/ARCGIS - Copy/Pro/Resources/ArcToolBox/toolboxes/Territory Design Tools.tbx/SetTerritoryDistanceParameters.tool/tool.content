                    {
                        "type": "GPGroupLayer"
                    },
                    {
                        "type": "DEFeatureDataset"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "description": "$rc:in_territory_solution.descr"
        },
        "level": {
            "displayname": "$rc:level.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "depends": [
                "in_territory_solution"
            ],
            "description": "$rc:level.descr"
        },
        "distance_type": {
            "type": "optional",
            "displayname": "$rc:distance_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "STRAIGHT_LINE",
                        "code": "$rc:distance_type.domain.STRAIGHT_LINE"
                    }
                ]
            },
            "description": "$rc:distance_type.descr"
        },
        "units": {
            "type": "optional",
            "displayname": "$rc:units.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "METERS",
                        "code": "$rc:units.domain.METERS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:units.domain.MILES"
                    },
                    {
