            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "BUILD_INDEX"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_BUILD_INDEX"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:build_index.descr"
        },
        "travel_direction": {
            "enabled": "false",
