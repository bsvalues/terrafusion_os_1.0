                        "code": "$rc:units.domain.NAUTICAL_MILES"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:units.domain.KILOMETERS"
                    },
                    {
                        "value": "YARDS",
                        "code": "$rc:units.domain.YARDS"
                    },
                    {
                        "value": "FEET",
                        "code": "$rc:units.domain.FEET"
                    },
                    {
                        "value": "INCHES",
                        "code": "$rc:units.domain.INCHES"
                    },
                    {
                        "value": "DECIMETERS",
                        "code": "$rc:units.domain.DECIMETERS"
                    },
                    {
                        "value": "CENTIMETERS",
                        "code": "$rc:units.domain.CENTIMETERS"
                    },
                    {
                        "value": "MILLIMETERS",
                        "code": "$rc:units.domain.MILLIMETERS"
                    },
                    {
                        "value": "DECIMAL_DEGREES",
                        "code": "$rc:units.domain.DECIMAL_DEGREES"
                    },
                    {
                        "value": "MINUTES",
                        "code": "$rc:units.domain.MINUTES"
                    },
                    {
                        "value": "HOURS",
                        "code": "$rc:units.domain.HOURS"
                    },
                    {
                        "value": "DAYS",
                        "code": "$rc:units.domain.DAYS"
                    },
                    {
                        "value": "SECONDS",
                        "code": "$rc:units.domain.SECONDS"
                    }
                ]
            },
            "depends": [
                "distance_type"
            ],
            "description": "$rc:units.descr"
        },
        "max_radius": {
            "type": "optional",
            "displayname": "$rc:max_radius.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true"
            },
            "description": "$rc:max_radius.descr"
        },
        "buffer_distance": {
            "type": "optional",
            "displayname": "$rc:buffer_distance.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
