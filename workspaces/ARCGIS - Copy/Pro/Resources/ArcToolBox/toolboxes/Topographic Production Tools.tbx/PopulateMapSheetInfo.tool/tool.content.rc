{
    "map": {
        "area_of_interest.descr": "A feature layer with a selection set containing one AOI feature. This parameter only accepts only polygon features. The tool writes attribute values from this feature to tagged text strings in defense-specific graphic elements.",
        "area_of_interest.title": "Area of Interest",
        "description": "Populates text in graphic elements on a map layout.",
        "in_layout.descr": "The input layout that contains graphic elements with tagged text strings to be updated.",
        "in_layout.title": "Input Layout",
        "lookup_table.descr": "<xdoc><p>An input table that contains the <span class=\"esri_fieldname\">Field_Name</span> and <span class=\"esri_fieldname\">DM_Tag</span> fields.</p></xdoc>",
        "lookup_table.title": "Lookup Table",
        "summary": "<xdoc><p>Populates text in graphic elements on a map layout.</p><p>Text is populated with feature attribute values from a selected area of interest (AOI) feature in the map. The tool searches each graphic element for tagged (&lt;tag&gt;&lt;/tag&gt;) text. It compares tagged text to values in the PopMapInfo table. Any matching values are replaced in the graphic element with an attribute value from the selected AOI feature.</p><p>The PopMapInfo table, similar to a lookup table, maintains the relationship between feature attributes and tagged text strings. The table contains the <span class=\"esri_fieldname\">Field_Name</span> and <span class=\"esri_fieldname\">DM_Tag</span> fields, which control the mapping between feature attributes and graphic elements. For example, the table maps the Sheet attribute to text with the SHEET tag (&lt;dm021&gt;text&lt;/dm021&gt;). All text within the tag will be updated; therefore, the tool can be run as needed when feature attributes are updated. Custom <span class=\"esri_fieldname\">Field_Name</span> and <span class=\"esri_fieldname\">DM_Tag</span> fields can be added to the table to allow for use of new feature attributes and associated graphic elements.</p><note type=\"note\"/><p group=\"note\">Defense Mapping map templates often use graphic elements with bracketed ([ ]) text to indicate text that should be updated to meet the product specification. However, brackets are not required by the Populate Map Sheet Info tool.</p></xdoc>",
        "title": "Populate Map Sheet Info",
        "updated_layout.title": "Updated Layout"
    }
}
