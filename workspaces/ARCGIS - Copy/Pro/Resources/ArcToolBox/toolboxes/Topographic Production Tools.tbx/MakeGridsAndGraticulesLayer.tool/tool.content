{
    "type": "FunctionTool",
    "guid": "{87fc2b0d-8d5d-44f7-8356-0d50a5bad59a}",
    "displayname": "$rc:title",
    "helpcontent": "10070002",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "params": {
        "in_grid_xml": {
            "displayname": "$rc:in_grid_xml.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xml"
                ]
            },
            "description": "$rc:in_grid_xml.descr"
        },
        "area_of_interest": {
            "control_guid": "{BEDF969C-20D2-4C41-96DA-32408CA72BF6}",
            "displayname": "$rc:area_of_interest.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPFeatureLayer"
                    },
                    {
                        "type": "GPExtent"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFeatureClassDomain",
                        "geometrytype": [
                            "Polygon"
                        ],
                        "featuretype": [
                            "Simple"
                        ]
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:area_of_interest.descr"
        },
        "target_feature_dataset": {
            "displayname": "$rc:target_feature_dataset.title",
            "datatype": {
                "type": "DEFeatureDataset"
            },
            "description": "$rc:target_feature_dataset.descr"
        },
        "out_layer_name": {
            "direction": "out",
            "control_guid": "{DA8EA072-AD53-11D5-A685-0008C711C8C1}",
            "displayname": "$rc:out_layer_name.title",
            "datatype": {
                "type": "GPGroupLayer"
            },
            "description": "$rc:out_layer_name.descr"
        },
        "grid_name": {
            "type": "optional",
            "control_guid": "{BEDF969C-20D2-4C41-96DA-32408CA72BF6}",
            "displayname": "$rc:grid_name.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPString"
                    },
                    {
                        "type": "Field"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Text"
                        ]
                    }
                ]
            },
            "depends": [
                "area_of_interest"
            ],
            "description": "$rc:grid_name.descr"
        },
        "configure_layout": {
            "type": "optional",
            "displayname": "$rc:configure_layout.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CONFIGURE_LAYOUT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_CONFIGURE_LAYOUT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:configure_layout.descr"
        },
        "layout": {
            "type": "optional",
            "displayname": "$rc:layout.title",
            "datatype": {
                "type": "GPLayout"
            },
            "description": "$rc:layout.descr"
        },
        "map_frame": {
            "type": "optional",
            "displayname": "$rc:map_frame.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:map_frame.descr"
        },
        "reference_scale": {
            "type": "optional",
            "displayname": "$rc:reference_scale.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "false",
                    "val": "1"
                }
            },
            "description": "$rc:reference_scale.descr"
        },
        "rotation": {
            "type": "optional",
            "displayname": "$rc:rotation.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:rotation.descr"
        },
        "mask_size": {
            "type": "optional",
            "displayname": "$rc:mask_size.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:mask_size.descr"
        },
        "xy_tolerance": {
            "type": "optional",
            "displayname": "$rc:xy_tolerance.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:xy_tolerance.descr"
        },
        "primary_coordinate_system": {
            "type": "optional",
            "displayname": "$rc:primary_coordinate_system.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "description": "$rc:primary_coordinate_system.descr"
        },
        "ancillary_coordinate_system_1": {
            "type": "optional",
            "displayname": "$rc:ancillary_coordinate_system_1.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "description": "$rc:ancillary_coordinate_system_1.descr"
        },
        "ancillary_coordinate_system_2": {
            "type": "optional",
            "displayname": "$rc:ancillary_coordinate_system_2.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "description": "$rc:ancillary_coordinate_system_2.descr"
        },
        "ancillary_coordinate_system_3": {
            "type": "optional",
            "displayname": "$rc:ancillary_coordinate_system_3.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "description": "$rc:ancillary_coordinate_system_3.descr"
        },
        "ancillary_coordinate_system_4": {
            "type": "optional",
            "displayname": "$rc:ancillary_coordinate_system_4.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "description": "$rc:ancillary_coordinate_system_4.descr"
        }
    },
    "environments": [
        "cartographicCoordinateSystem",
        "configKeyword",
        "outputMFlag",
        "outputZFlag",
        "referenceScale"
    ]
}
