{
    "map": {
        "area_of_interest.descr": "The AOI for the area where the elevation bands will be created. The AOI is typically stored in an index feature class that contains the extents for standard map sheets. A single feature must be selected on the feature class that is specified.",
        "area_of_interest.title": "Area of Interest",
        "band_interval.descr": "<xdoc><p>The interval specified when the band interval type is regular. This parameter is only available when <span class=\"esri_uicontrol\">Custom</span> is specified as the <span class=\"esri_uicontrol\">Product</span> parameter value.</p></xdoc>",
        "band_interval.title": "Band Interval",
        "band_values.descr": "<xdoc><p>The low and high values in the bands that will be created. These values will be populated automatically from an .xml file if a particular product is specified for the <span class=\"esri_uicontrol\">Product</span> parameter value; however, these values must be provided manually if <span class=\"esri_uicontrol\">Custom</span> is specified for the <span class=\"esri_uicontrol\">Product</span> parameter value and at least one pair of <span class=\"esri_uicontrol\">Low</span> and <span class=\"esri_uicontrol\">High</span> values is required. If no product is specified, at least one pair of <span class=\"esri_uicontrol\">Low</span> and <span class=\"esri_uicontrol\">High</span> values is still required.</p></xdoc>",
        "band_values.dt.title1": "Low",
        "band_values.dt.title2": "High",
        "band_values.title": "Band Values",
        "contour_features.descr": "The polyline feature layer that contains the contours. The information for the output bands will be derived from these features.",
        "contour_features.title": "Contour Features",
        "description": "Generates band features that represent elevation levels on a map product. The tool can be run with set values from standardized product specifications or with custom-defined values.",
        "elevation_field.descr": "<xdoc><p>The field in the <span class=\"esri_uicontrol\">Contour Features</span> feature layer from which the elevation values will be derived.</p></xdoc>",
        "elevation_field.title": "Elevation Field",
        "exclusion_features.descr": "The feature layers that define areas where bands will not be created.",
        "exclusion_features.title": "Exclusion Features",
        "out_feature_class.descr": "The feature class that will contain the banding features.",
        "out_feature_class.title": "Output Feature Class",
        "product.descr": "<xdoc><p>A supported map product, which determines the values for the <span class=\"esri_uicontrol\">Band Values</span> parameter unless <span class=\"esri_uicontrol\">Custom</span> is specified for this parameter. If left blank, at least one pair of <span class=\"esri_uicontrol\">Low</span> and <span class=\"esri_uicontrol\">High</span> values is required for the <span class=\"esri_uicontrol\">Band Values</span> parameter.</p><ul><li>JOG-A—The Joint Operations Graphic-Air product</li><li>ONC—The Operational Navigation Chart product</li><li>TPC—The Tactical Pilotage Chart product</li><li>Custom—A custom product</li></ul></xdoc>",
        "product.title": "Product",
        "title": "Generate Elevation Bands From Features"
    }
}
