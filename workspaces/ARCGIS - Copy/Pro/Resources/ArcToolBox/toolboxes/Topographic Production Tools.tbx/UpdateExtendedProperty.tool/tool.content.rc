{
    "map": {
        "database_path.descr": "The Workflow Manager (Classic) database connection file (.jtc) that contains the job information. If no connection file is specified, the current default Workflow Manager (Classic) database will be used.",
        "database_path.title": "Input Database Path",
        "description": "Updates an extended property in the identified properties table for the chosen job.",
        "increment_value.descr": "<xdoc><p>If a value already exists for the chosen property, this parameter specifies whether the increment value will be added to the current value or will replace the current value.</p><ul><li>Checked—The specified value will be added to any existing value for the property.</li><li>Unchecked—The specified value will replace the existing value for the property.</li></ul></xdoc>",
        "increment_value.title": "Increment Value",
        "job_id.descr": "The Job ID of the Workflow Manager (Classic) job that will be updated.",
        "job_id.title": "Job ID",
        "properties_table_name.descr": "The name of the extended properties table that will be updated.",
        "properties_table_name.title": "Properties Table Name",
        "property_field.descr": "The property to be updated in the extended properties table.",
        "property_field.title": "Property Field",
        "summary": "<xdoc><p>Updates an extended property in the identified properties table for the chosen job.</p><note type=\"caution\"/><p group=\"note\">This tool is designed to be run as a step in a Workflow Manager (Classic) workflow. Running this tool outside of Workflow Manager (Classic) does not honor all Workflow Manager (Classic) constraints such as job assignment, dependencies, or holds and may cause a job to enter an unusable state.</p><note type=\"caution\"/><p group=\"note\">This tool is intended for use with the Topographic Mapping production workflows and will not support an improperly configured Workflow Manager (Classic) repository. Sample workflows and instructions for configuring Topographic Mapping production workflows are available as part of the product file installer.</p><note type=\"tip\"/><p group=\"note\">It is recommended that current Workflow Manager (Classic) users begin new projects using the services-driven version of ArcGIS Workflow Manager for ArcGIS Pro.</p></xdoc>",
        "title": "Update Extended Property",
        "updated_job_id.title": "Updated Job ID",
        "value.descr": "The value that will be set for the extended property.",
        "value.title": "Value"
    }
}
