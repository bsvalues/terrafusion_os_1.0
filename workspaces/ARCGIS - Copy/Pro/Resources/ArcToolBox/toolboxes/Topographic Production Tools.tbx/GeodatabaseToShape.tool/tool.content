{
    "type": "FunctionTool",
    "guid": "{26B17338-CB00-45A9-AB9C-858C2E0122C9}/GeodatabaseToShape",
    "displayname": "$rc:title",
    "helpcontent": "46040002",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "description": "$rc:in_features.descr"
        },
        "output_folder": {
            "displayname": "$rc:output_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:output_folder.descr"
        },
        "coded_value_domain_export_mode": {
            "displayname": "$rc:coded_value_domain_export_mode.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "VALUES",
                        "code": "$rc:coded_value_domain_export_mode.domain.VALUES"
                    },
                    {
                        "value": "DESCRIPTIONS",
                        "code": "$rc:coded_value_domain_export_mode.domain.DESCRIPTIONS"
                    },
                    {
                        "value": "VALUES_AND_DESCRIPTIONS",
                        "code": "$rc:coded_value_domain_export_mode.domain.VALUES_AND_DESCRIPTIONS"
                    }
                ]
            },
            "value": "VALUES",
            "description": "$rc:coded_value_domain_export_mode.descr"
        },
        "conversion_method": {
            "displayname": "$rc:conversion_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DEFENSE_BY_FEATURECLASS",
                        "code": "$rc:conversion_method.domain.DEFENSE_BY_FEATURECLASS"
                    },
                    {
                        "value": "DEFENSE_BY_SUBTYPE",
                        "code": "$rc:conversion_method.domain.DEFENSE_BY_SUBTYPE"
                    },
                    {
                        "value": "GENERIC_BY_FEATURECLASS",
                        "code": "$rc:conversion_method.domain.GENERIC_BY_FEATURECLASS"
                    },
                    {
                        "value": "GENERIC_BY_SUBTYPE",
                        "code": "$rc:conversion_method.domain.GENERIC_BY_SUBTYPE"
                    },
                    {
                        "value": "MGCP",
                        "code": "$rc:conversion_method.domain.MGCP"
                    },
                    {
                        "value": "MUVD",
                        "code": "$rc:conversion_method.domain.MUVD"
                    }
                ]
            },
            "value": "DEFENSE_BY_SUBTYPE",
            "description": "$rc:conversion_method.descr"
        },
        "create_empties": {
            "displayname": "$rc:create_empties.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_CREATE_EMPTIES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE_EMPTIES"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:create_empties.descr"
        },
        "derived_folder": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:derived_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "depends": [
                "output_folder"
            ]
        }
    },
    "environments": [
        "extent",
        "workspace"
    ]
}
