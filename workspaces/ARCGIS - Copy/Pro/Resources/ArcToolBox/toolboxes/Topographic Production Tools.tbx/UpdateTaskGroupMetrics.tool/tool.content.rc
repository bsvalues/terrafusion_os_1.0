        "job_id.title": "Job ID",
        "status_field.descr": "<xdoc><p>The text or date field in which the last modified date will be stored. This parameter is enabled if a <span class=\"esri_uicontrol\">Status Layer</span> parameter value is defined.</p></xdoc>",
        "status_field.title": "Status Field",
        "status_layer.descr": "The feature class containing status polygons that keep track of the last time work occurred over an extent. Only use this parameter to update a polygon feature class that is not the standard status polygons created by the Topographic Workflow.",
        "status_layer.title": "Status Layer",
        "summary": "<xdoc><p>Updates and summarizes task group metrics that are part of the standard Topographic Workflow deployment of Workflow Manager (Classic).</p><note type=\"caution\"/><p group=\"note\">This tool is designed to be run as a step in a Workflow Manager (Classic) workflow. Running this tool outside of Workflow Manager (Classic) does not honor all Workflow Manager (Classic) constraints such as job assignment, dependencies, or holds and may cause a job to enter an unusable state.</p><note type=\"caution\"/><p group=\"note\">This tool is intended for use with the Topographic Mapping production workflows and will not support an improperly configured Workflow Manager (Classic) repository. Sample workflows and instructions for configuring Topographic Mapping production workflows are available as part of the product file installer.</p><note type=\"tip\"/><p group=\"note\">It is recommended that current Workflow Manager (Classic) users begin new projects using the services-driven version of ArcGIS Workflow Manager for ArcGIS Pro.</p></xdoc>",
        "title": "Update Task Group Metrics",
        "updated_job_id.title": "Updated Job ID",
        "updated_status_layer.title": "Updated Status Layer"
    }
