{
    "type": "FunctionTool",
    "guid": "{26B17338-CB00-45A9-AB9C-858C2E0122C9}/ValidateSpotHeights",
    "displayname": "$rc:title",
    "helpcontent": "76100001",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "attributes": [
        "input_data_change",
        "param_nocount:in_contour_features"
    ],
    "params": {
        "in_contour_features": {
            "displayname": "$rc:in_contour_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPLayerDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:in_contour_features.descr"
        },
        "contour_height_field": {
            "displayname": "$rc:contour_height_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Double",
                    "Long",
                    "Short"
                ]
            },
            "depends": [
                "in_contour_features"
            ],
            "description": "$rc:contour_height_field.descr"
        },
        "contour_interval": {
            "displayname": "$rc:contour_interval.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "20",
            "description": "$rc:contour_interval.descr"
        },
        "in_rasters": {
            "displayname": "$rc:in_rasters.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPComposite",
                    "datatypes": [
                        {
                            "type": "GPRasterLayer"
                        },
                        {
                            "type": "GPMosaicLayer"
                        }
                    ]
                }
            },
            "description": "$rc:in_rasters.descr"
        },
        "in_spot_features": {
            "displayname": "$rc:in_spot_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPLayerDomain",
                "geometrytype": [
                    "Point"
                ]
            },
            "description": "$rc:in_spot_features.descr"
        },
        "spot_height_field": {
            "displayname": "$rc:spot_height_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Double",
                    "Long",
                    "Short"
                ]
            },
            "depends": [
                "in_spot_features"
            ],
            "description": "$rc:spot_height_field.descr"
        },
        "area_of_interest": {
            "type": "optional",
            "displayname": "$rc:area_of_interest.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPLayerDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:area_of_interest.descr"
        },
        "z_factor": {
            "type": "optional",
            "displayname": "$rc:z_factor.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "1",
            "description": "$rc:z_factor.descr"
        },
        "updated_spot_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_spot_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_spot_features"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "clonedependency": "true"
            }
        },
        "use_rasters": {
            "type": "optional",
            "displayname": "$rc:use_rasters.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "USE_RASTERS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_USE_RASTERS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:use_rasters.descr"
        }
    }
}
