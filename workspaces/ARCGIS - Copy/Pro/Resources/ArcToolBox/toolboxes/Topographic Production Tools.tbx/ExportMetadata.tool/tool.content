{
    "type": "FunctionTool",
    "guid": "{26B17338-CB00-45A9-AB9C-858C2E0122C9}/ExportMetadata",
    "displayname": "$rc:title",
    "helpcontent": "46040001",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "49"
    ],
    "params": {
        "in_cell_features": {
            "displayname": "$rc:in_cell_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:in_cell_features.descr"
        },
        "export_location": {
            "displayname": "$rc:export_location.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:export_location.descr"
        },
        "out_export_location": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_export_location.title",
            "datatype": {
                "type": "DEFolder"
            },
            "depends": [
                "export_location"
            ]
        },
        "metadata_type": {
            "type": "optional",
            "displayname": "$rc:metadata_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "MGCP",
                        "code": "$rc:metadata_type.domain.MGCP"
                    },
                    {
                        "value": "MUVD",
                        "code": "$rc:metadata_type.domain.MUVD"
                    }
                ]
            },
            "value": "MGCP",
            "description": "$rc:metadata_type.descr"
        }
    }
}
