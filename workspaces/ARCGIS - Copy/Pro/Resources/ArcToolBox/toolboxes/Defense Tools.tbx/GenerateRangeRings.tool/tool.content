{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\GenerateRangeRings",
    "displayname": "$rc:title",
    "helpcontent": "74010001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_feature_class_rings": {
            "direction": "out",
            "display_order": "8",
            "displayname": "$rc:out_feature_class_rings.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "symbologylayer": "MT_RangeRings.lyrx",
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class_rings.descr"
        },
        "range_rings_type": {
            "display_order": "1",
            "displayname": "$rc:range_rings_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INTERVAL",
                        "code": "$rc:range_rings_type.domain.INTERVAL"
                    },
                    {
                        "value": "MIN_MAX",
                        "code": "$rc:range_rings_type.domain.MIN_MAX"
                    }
                ]
            },
            "value": "INTERVAL",
            "description": "$rc:range_rings_type.descr"
        },
        "out_feature_class_radials": {
            "type": "optional",
            "direction": "out",
            "display_order": "9",
            "displayname": "$rc:out_feature_class_radials.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "symbologylayer": "MT_RangeRadials.lyrx",
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class_radials.descr"
        },
        "number_of_radials": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:number_of_radials.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:number_of_radials.descr"
        },
        "distance_units": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:distance_units.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "METERS",
                        "code": "$rc:distance_units.domain.METERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:distance_units.domain.KILOMETERS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:distance_units.domain.MILES"
                    },
                    {
                        "value": "NAUTICAL_MILES",
                        "code": "$rc:distance_units.domain.NAUTICAL_MILES"
                    },
                    {
                        "value": "FEET",
                        "code": "$rc:distance_units.domain.FEET"
                    },
                    {
                        "value": "US_SURVEY_FEET",
                        "code": "$rc:distance_units.domain.US_SURVEY_FEET"
                    }
                ]
            },
            "value": "METERS",
            "category": "$rc:params.category1",
            "description": "$rc:distance_units.descr"
        },
        "number_of_rings": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:number_of_rings.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "4",
            "description": "$rc:number_of_rings.descr"
        },
        "interval_between_rings": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:interval_between_rings.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "100",
            "description": "$rc:interval_between_rings.descr"
        },
        "minimum_range": {
            "enabled": "false",
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:minimum_range.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "200",
            "description": "$rc:minimum_range.descr"
        },
        "maximum_range": {
            "enabled": "false",
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:maximum_range.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "1000",
            "description": "$rc:maximum_range.descr"
        }
    },
    "environments": [
        "outputCoordinateSystem",
        "scratchWorkspace",
        "workspace"
    ]
}
