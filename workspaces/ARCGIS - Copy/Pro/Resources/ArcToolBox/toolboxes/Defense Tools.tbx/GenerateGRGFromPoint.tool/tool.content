{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\GenerateGRGFromPoint",
    "displayname": "$rc:title",
    "helpcontent": "74030001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_feature": {
            "displayname": "$rc:in_feature.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_feature.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "symbologylayer": "MT_GRG.lyrx",
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "horizontal_cells": {
            "type": "optional",
            "displayname": "$rc:horizontal_cells.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "value": "10",
            "description": "$rc:horizontal_cells.descr"
        },
        "vertical_cells": {
            "type": "optional",
            "displayname": "$rc:vertical_cells.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "value": "10",
            "description": "$rc:vertical_cells.descr"
        },
        "cell_width": {
            "type": "optional",
            "displayname": "$rc:cell_width.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "1000",
            "description": "$rc:cell_width.descr"
        },
        "cell_height": {
            "type": "optional",
            "displayname": "$rc:cell_height.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "1000",
            "description": "$rc:cell_height.descr"
        },
        "cell_units": {
            "type": "optional",
            "displayname": "$rc:cell_units.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "METERS",
                        "code": "$rc:cell_units.domain.METERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:cell_units.domain.KILOMETERS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:cell_units.domain.MILES"
                    },
                    {
                        "value": "NAUTICAL_MILES",
                        "code": "$rc:cell_units.domain.NAUTICAL_MILES"
                    },
                    {
                        "value": "FEET",
                        "code": "$rc:cell_units.domain.FEET"
                    },
                    {
                        "value": "US_SURVEY_FEET",
                        "code": "$rc:cell_units.domain.US_SURVEY_FEET"
                    }
                ]
            },
            "value": "METERS",
            "description": "$rc:cell_units.descr"
        },
        "label_start_position": {
            "type": "optional",
            "displayname": "$rc:label_start_position.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UPPER_LEFT",
                        "code": "$rc:label_start_position.domain.UPPER_LEFT"
                    },
                    {
                        "value": "LOWER_LEFT",
                        "code": "$rc:label_start_position.domain.LOWER_LEFT"
                    },
                    {
                        "value": "UPPER_RIGHT",
                        "code": "$rc:label_start_position.domain.UPPER_RIGHT"
                    },
                    {
                        "value": "LOWER_RIGHT",
                        "code": "$rc:label_start_position.domain.LOWER_RIGHT"
                    }
                ]
            },
            "value": "UPPER_LEFT",
            "description": "$rc:label_start_position.descr"
        },
        "label_format": {
            "type": "optional",
            "displayname": "$rc:label_format.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ALPHA_NUMERIC",
                        "code": "$rc:label_format.domain.ALPHA_NUMERIC"
                    },
                    {
                        "value": "ALPHA_ALPHA",
                        "code": "$rc:label_format.domain.ALPHA_ALPHA"
                    },
                    {
                        "value": "NUMERIC",
                        "code": "$rc:label_format.domain.NUMERIC"
                    }
                ]
            },
            "value": "ALPHA_NUMERIC",
            "description": "$rc:label_format.descr"
        },
        "label_separator": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:label_separator.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "-",
                        "code": "$rc:label_separator.domain.-"
                    },
                    {
                        "value": ",",
                        "code": "$rc:label_separator.domain.,"
                    },
                    {
                        "value": ".",
                        "code": "$rc:label_separator.domain.."
                    },
                    {
                        "value": "/",
                        "code": "$rc:label_separator.domain.¦"
                    }
                ]
            },
            "value": "-",
            "description": "$rc:label_separator.descr"
        },
        "grid_angle": {
            "type": "optional",
            "displayname": "$rc:grid_angle.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0",
            "description": "$rc:grid_angle.descr"
        },
        "grid_angle_units": {
            "type": "optional",
            "displayname": "$rc:grid_angle_units.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DEGREES",
                        "code": "$rc:grid_angle_units.domain.DEGREES"
                    },
                    {
                        "value": "MILS",
                        "code": "$rc:grid_angle_units.domain.MILS"
                    },
                    {
                        "value": "RADS",
                        "code": "$rc:grid_angle_units.domain.RADS"
                    },
                    {
                        "value": "GRADS",
                        "code": "$rc:grid_angle_units.domain.GRADS"
                    }
                ]
            },
            "value": "DEGREES",
            "description": "$rc:grid_angle_units.descr"
        }
    },
    "environments": [
        "outputCoordinateSystem",
        "scratchWorkspace",
        "workspace"
    ]
}
