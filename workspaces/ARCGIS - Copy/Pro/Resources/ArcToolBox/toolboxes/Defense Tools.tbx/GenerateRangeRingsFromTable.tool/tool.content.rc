{
    "map": {
        "description": "Creates a set of concentric circles from a center based on values stored in a lookup table.",
        "distance_units.descr": "<xdoc><p>Specifies the linear unit of measurement for the <span class=\"esri_uicontrol\">Ring Interval Field</span> parameter or the <span class=\"esri_uicontrol\">Input Table Minimum Range</span> and <span class=\"esri_uicontrol\">Input Table Maximum Range</span> parameters.</p><ul><li><span title=\"METERS\">Meters</span>—The unit will be meters. This is the default.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The unit will be kilometers.</li><li><span title=\"MILES\">Miles</span>—The unit will be miles.</li><li><span title=\"NAUTICAL_MILES\">Nautical miles</span>—The unit will be nautical miles.</li><li><span title=\"FEET\">Feet</span>—The unit will be feet.</li><li><span title=\"US_SURVEY_FEET\">US survey feet</span>—The unit will be U.S. survey feet.</li></ul></xdoc>",
        "distance_units.domain.FEET": "Feet",
        "distance_units.domain.KILOMETERS": "Kilometers",
        "distance_units.domain.METERS": "Meters",
        "distance_units.domain.MILES": "Miles",
        "distance_units.domain.NAUTICAL_MILES": "Nautical miles",
        "distance_units.domain.US_SURVEY_FEET": "US survey feet",
        "distance_units.title": "Distance Units",
        "in_features.descr": "The point feature set that identifies the center of the range ring. The input must have at least one point.",
        "in_features.title": "Input Features (Center Points)",
        "in_table.descr": "The input table that contains values for creating rings.",
        "in_table.title": "Input Lookup Table",
        "lookup_name.descr": "<xdoc><p>The row from the <span class=\"esri_uicontrol\">Input Lookup Table</span> that contains the input values for minimum and maximum values or number of rings and interval.</p></xdoc>",
        "lookup_name.title": "Selected Name",
        "lookup_name_field.descr": "<xdoc><p>The field from the input table that contains the <span class=\"esri_uicontrol\">Selected Name</span> value. The default field name is <span class=\"esri_fieldname\">Name</span>.</p></xdoc>",
        "lookup_name_field.title": "Input Table Selected Name Field",
        "max_range_field.descr": "<xdoc><p>The field from the input table that contains the maximum range value. The default field name is <span class=\"esri_fieldname\">Max</span>.</p></xdoc>",
        "max_range_field.title": "Input Table Maximum Range",
        "min_range_field.descr": "<xdoc><p>The field from the input table that contains the minimum range value. The default field name is <span class=\"esri_fieldname\">Min</span>.</p></xdoc>",
        "min_range_field.title": "Input Table Minimum Range",
        "number_of_radials.descr": "The number of radials to create.",
        "number_of_radials.title": "Number of Radials",
        "number_of_rings_field.descr": "<xdoc><p>The field from the input table that contains the number of rings value. The default field name is <span class=\"esri_fieldname\">Rings</span>.</p></xdoc>",
        "number_of_rings_field.title": "Number of Rings Field",
        "out_feature_class_radials.descr": "The feature class containing the output radial features.",
        "out_feature_class_radials.title": "Output Feature Class (Radials)",
        "out_feature_class_rings.descr": "The output feature class containing the ring features.",
        "out_feature_class_rings.title": "Output Feature Class (Rings)",
        "params.category1": "Input Table Options",
        "range_rings_type.descr": "<xdoc><p>Specifies the method used to create the range rings.</p><ul><li><span title=\"INTERVAL\">Interval</span>—Range rings will be generated based on the number of rings and distance between rings. This the default.</li><li><span title=\"MIN_MAX\">Minimum and maximum</span>—Range rings will be generated based on a minimum and maximum distance.</li></ul></xdoc>",
        "range_rings_type.domain.INTERVAL": "Interval",
        "range_rings_type.domain.MIN_MAX": "Minimum and maximum",
        "range_rings_type.title": "Range Ring Type",
        "ring_interval_field.descr": "<xdoc><p>The field from the input table that contains the ring interval value. The default field name is <span class=\"esri_fieldname\">Interval</span>.</p></xdoc>",
        "ring_interval_field.title": "Ring Interval Field",
        "summary": "<xdoc><p>Creates a set of concentric circles from a center based on values stored in a lookup table.</p><p><note type=\"legacy\"/><p group=\"note\">This is a deprecated tool. This functionality has been replaced by the Generate Range Rings From Features tool.</p></p></xdoc>",
        "title": "Generate Range Rings From Lookup Table"
    }
}
