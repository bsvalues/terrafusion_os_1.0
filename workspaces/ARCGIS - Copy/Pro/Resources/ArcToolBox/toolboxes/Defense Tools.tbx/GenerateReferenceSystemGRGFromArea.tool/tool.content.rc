{
    "map": {
        "description": "Creates Gridded Reference Graphics (GRG) based on Military Grid Reference System (MGRS) or United States National Grid (USNG) reference grids.",
        "grid_reference_system.descr": "<xdoc><p>Specifies the reference system the GRG will use.</p><ul><li><span title=\"MGRS\">Military Grid Reference System</span>—Military Grid Reference System will be used. This is the default.</li><li><span title=\"USNG\">United States National Grid</span>—United States National Grid will be used.</li></ul></xdoc>",
        "grid_reference_system.domain.MGRS": "Military Grid Reference System",
        "grid_reference_system.domain.USNG": "United States National Grid",
        "grid_reference_system.title": "Grid Reference System",
        "grid_square_size.descr": "<xdoc><p>Specifies the grid square size that will be used for the cells in the GRG.</p><ul><li><span title=\"GRID_ZONE_DESIGNATOR\">Grid Zone Designator</span>—The size of the grid cells will be a Grid Zone. This is the default.</li><li><span title=\"100000M_GRID\">100,000 m grid</span>—The size of the grid cells will be 100,000-meter grid squares.</li><li><span title=\"10000M_GRID\">10,000 m grid</span>—The size of the grid cells will be 10,000-meter grid squares.</li><li><span title=\"1000M_GRID\">1,000 m grid</span>—The size of the grid cells will be 1,000-meter grid squares.</li><li><span title=\"100M_GRID\">100 m grid</span>—The size of the grid cells will be 100-meter grid squares.</li><li><span title=\"50M_GRID\">50 m grid</span>—The size of the grid cells will be 50-meter grid squares.</li><li><span title=\"25M_GRID\">25 m grid</span>—The size of the grid cells will be 25-meter grid squares.</li><li><span title=\"10M_GRID\">10 m grid</span>—The size of the grid cells will be 10-meter grid squares.</li></ul></xdoc>",
        "grid_square_size.domain.100000M_GRID": "100,000 m grid",
        "grid_square_size.domain.10000M_GRID": "10,000 m grid",
        "grid_square_size.domain.1000M_GRID": "1,000 m grid",
        "grid_square_size.domain.100M_GRID": "100 m grid",
        "grid_square_size.domain.10M_GRID": "10 m grid",
        "grid_square_size.domain.25M_GRID": "25 m grid",
        "grid_square_size.domain.50M_GRID": "50 m grid",
        "grid_square_size.domain.GRID_ZONE_DESIGNATOR": "Grid Zone Designator",
        "grid_square_size.title": "Grid Square Size",
        "in_features.descr": "The input polygon feature on which the GRG will be based.",
        "in_features.title": "Input Feature",
        "large_grid_handling.descr": "<xdoc><p>Specifies how large input areas that may contain many features will be handled.</p><ul><li><span title=\"NO_LARGE_GRIDS\">No large grids</span>—Processing will stop when 2000 features are created. This is the default.</li><li><span title=\"ALLOW_LARGE_GRIDS\">Allow large grids</span>—Large grids are supported.</li></ul></xdoc>",
        "large_grid_handling.domain.ALLOW_LARGE_GRIDS": "Allow large grids",
        "large_grid_handling.domain.NO_LARGE_GRIDS": "No large grids",
        "large_grid_handling.title": "Large Grid Handling",
        "output_feature_class.descr": "The output polygon feature class containing the GRG.",
        "output_feature_class.title": "Output Feature Class",
        "title": "Generate Reference System Grid From Area"
    }
}
