{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\LetterIntersections",
    "displayname": "$rc:title",
    "helpcontent": "74030007",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "field_to_letter": {
            "displayname": "$rc:field_to_letter.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Text"
                ]
            },
            "description": "$rc:field_to_letter.descr"
        },
        "in_area": {
            "type": "optional",
            "displayname": "$rc:in_area.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_area.descr"
        },
        "spatial_sort_method": {
            "type": "optional",
            "displayname": "$rc:spatial_sort_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UR",
                        "code": "$rc:spatial_sort_method.domain.UR"
                    },
                    {
                        "value": "UL",
                        "code": "$rc:spatial_sort_method.domain.UL"
                    },
                    {
                        "value": "LR",
                        "code": "$rc:spatial_sort_method.domain.LR"
                    },
                    {
                        "value": "LL",
                        "code": "$rc:spatial_sort_method.domain.LL"
                    },
                    {
                        "value": "PEANO",
                        "code": "$rc:spatial_sort_method.domain.PEANO"
                    },
                    {
                        "value": "CENTER",
                        "code": "$rc:spatial_sort_method.domain.CENTER"
                    },
                    {
                        "value": "COUNTERCLOCKWISE",
                        "code": "$rc:spatial_sort_method.domain.COUNTERCLOCKWISE"
                    },
                    {
                        "value": "CLOCKWISE",
                        "code": "$rc:spatial_sort_method.domain.CLOCKWISE"
                    },
                    {
                        "value": "NONE",
                        "code": "$rc:spatial_sort_method.domain.NONE"
                    }
                ]
            },
            "value": "UR",
            "description": "$rc:spatial_sort_method.descr"
        },
        "lettering_format": {
            "type": "optional",
            "displayname": "$rc:lettering_format.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "A_B_C",
                        "code": "$rc:lettering_format.domain.A_B_C"
                    },
                    {
                        "value": "AA_AB_AC",
                        "code": "$rc:lettering_format.domain.AA_AB_AC"
                    },
                    {
                        "value": "AA_BB_CC",
                        "code": "$rc:lettering_format.domain.AA_BB_CC"
                    }
                ]
            },
            "value": "A_B_C",
            "description": "$rc:lettering_format.descr"
        },
        "starting_letter": {
            "type": "optional",
            "displayname": "$rc:starting_letter.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "A",
            "description": "$rc:starting_letter.descr"
        },
        "omit_letters": {
            "type": "optional",
            "displayname": "$rc:omit_letters.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "description": "$rc:omit_letters.descr"
        },
        "min_out_point_distance": {
            "type": "optional",
            "displayname": "$rc:min_out_point_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "value": "50 Meters",
            "description": "$rc:min_out_point_distance.descr"
        },
        "center_point": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:center_point.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:center_point.descr"
        },
        "add_distance_and_bearing": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:add_distance_and_bearing.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_DISTANCE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DONT_ADD_DISTANCE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:add_distance_and_bearing.descr"
        }
    },
    "environments": [
        "extent",
        "scratchWorkspace",
        "workspace"
    ]
}
