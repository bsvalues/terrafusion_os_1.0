{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\GenerateRangeRingsFromFeatures",
    "displayname": "$rc:title",
    "helpcontent": "74010005",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "output_feature_class": {
            "direction": "out",
            "displayname": "$rc:output_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "symbologylayer": "MT_RangeRings.lyrx",
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_feature_class.descr"
        },
        "range_rings_type": {
            "displayname": "$rc:range_rings_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INTERVAL",
                        "code": "$rc:range_rings_type.domain.INTERVAL"
                    },
                    {
                        "value": "MIN_MAX",
                        "code": "$rc:range_rings_type.domain.MIN_MAX"
                    }
                ]
            },
            "value": "INTERVAL",
            "description": "$rc:range_rings_type.descr"
        },
        "out_feature_class_radials": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_feature_class_radials.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "symbologylayer": "MT_RangeRadials.lyrx",
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class_radials.descr"
        },
        "radial_count_field": {
            "type": "optional",
            "displayname": "$rc:radial_count_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:radial_count_field.descr"
        },
        "min_range_field": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:min_range_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short",
                    "Double",
                    "Float"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:min_range_field.descr"
        },
        "max_range_field": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:max_range_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short",
                    "Double",
                    "Float"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:max_range_field.descr"
        },
        "ring_count_field": {
            "type": "optional",
            "displayname": "$rc:ring_count_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:ring_count_field.descr"
        },
        "ring_interval_field": {
            "type": "optional",
            "displayname": "$rc:ring_interval_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short",
                    "Double",
                    "Float"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:ring_interval_field.descr"
        },
        "distance_units": {
            "type": "optional",
            "displayname": "$rc:distance_units.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "METERS",
                        "code": "$rc:distance_units.domain.METERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:distance_units.domain.KILOMETERS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:distance_units.domain.MILES"
                    },
                    {
                        "value": "NAUTICAL_MILES",
                        "code": "$rc:distance_units.domain.NAUTICAL_MILES"
                    },
                    {
                        "value": "FEET",
                        "code": "$rc:distance_units.domain.FEET"
                    },
                    {
                        "value": "US_SURVEY_FEET",
                        "code": "$rc:distance_units.domain.US_SURVEY_FEET"
                    }
                ]
            },
            "value": "METERS",
            "description": "$rc:distance_units.descr"
        }
    },
    "environments": [
        "outputCoordinateSystem",
        "scratchWorkspace",
        "workspace"
    ]
}
