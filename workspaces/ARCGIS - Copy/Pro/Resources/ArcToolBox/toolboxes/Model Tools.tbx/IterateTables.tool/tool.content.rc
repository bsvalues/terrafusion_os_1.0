{
    "map": {
        "description": "Iterates over tables in a workspace.",
        "in_workspace.descr": "A workspace containing the tables to iterate.",
        "in_workspace.title": "Workspace",
        "name.title": "Name",
        "recursive.descr": "<xdoc><p>Specifies whether subfolders in the main folder will be iterated recursively.</p><ul><li>Checked—All subfolders in the main folder will be iterated recursively. Keep this parameter checked to enable iterating through multiple file geodatabase tables or SQLite tables in the input workspace.</li><li>Unchecked—Subfolders in the main folder will not be iterated recursively. Only the main folder will be used.</li></ul></xdoc>",
        "recursive.title": "Recursive",
        "table.title": "Table",
        "table_type.descr": "<xdoc><p>Specifies the table type for folder workspaces (coverages).</p><ul><li><span title=\"DBASE\">dBASE</span>—The table type will be dBASE tables.</li><li><span title=\"INFO\">INFO (coverages)</span>—The table type will be INFO tables (coverages).</li><li><span title=\"FILE_GDB\">File geodatabase</span>—The table type will be file geodatabase tables.</li><li><span title=\"EXCEL\">Excel</span>—The table type will be Microsoft Excel tables.</li><li><span title=\"TEXT\">Delimited text file</span>—The table type will be delimited text files. This includes .csv files.</li><li><span title=\"SQLITE\">SQLite</span>—The table type will be SQLite tables.</li><li><span title=\"ENTERPRISE_GDB\">Enterprise geodatabase</span>—The table type will be enterprise geodatabase tables.</li><li><span title=\"OLE_DB\">OLE DB</span>—The table type will be OLE DB connection tables.</li></ul></xdoc>",
        "table_type.domain.DBASE": "dBASE",
        "table_type.domain.ENTERPRISE_GDB": "Enterprise geodatabase",
        "table_type.domain.EXCEL": "Excel",
        "table_type.domain.FILE_GDB": "File geodatabase",
        "table_type.domain.INFO": "INFO (coverages)",
        "table_type.domain.OLE_DB": "OLE DB",
        "table_type.domain.SQLITE": "SQLite",
        "table_type.domain.TEXT": "Delimited text file",
        "table_type.title": "Table Type",
        "title": "Iterate Tables",
        "wildcard.descr": "A combination of * and characters that help to limit the results. The asterisk is the same as specifying ALL. If no wildcard is specified, all inputs will be returned. You can use this parameter to restrict iteration over input names starting with a certain character or word (for example, A* or Ari* or Land* and so on).",
        "wildcard.title": "Wildcard"
    }
}
