    "map": {
        "derived_out_tin.title": "Updated TIN",
        "description": "Redefines the data area, or interpolation zone, of a triangulated irregular network (TIN) based on its triangle edge length.",
        "in_tin.descr": "The TIN dataset that will be processed.",
        "in_tin.title": "Input TIN",
        "max_edge_length.descr": "The two-dimensional distance that defines the maximum length of a TIN triangle edge in the TIN's data area. Triangles with one or more edges that exceed this value will be considered outside the TIN's interpolation zone and will not be rendered in maps or used in surface analysis.",
        "max_edge_length.title": "Maximum Edge Length",
        "method.descr": "<xdoc><p>The TIN edges that will be evaluated when delineating the TIN&apos;s data area.</p><ul><li><span title=\"PERIMETER_ONLY\">Perimeter Edges</span>—Iterates through triangles from the TIN&apos;s outer extent inward and will stop when the current iteration of boundary triangle edges does not exceed the <span class=\"esri_uicontrol\">Maximum Edge Length</span>. This is the default.</li><li><span title=\"ALL\">All Edges</span>—Classifies the entire collection of TIN triangles by edge length.</li></ul></xdoc>",
        "method.domain.ALL": "All Edges",
        "method.domain.PERIMETER_ONLY": "Perimeter Edges",
