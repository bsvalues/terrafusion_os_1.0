{
    "map": {
        "description": "Creates building models using rooftop points in a LAS dataset.",
        "ground.descr": "The source of ground height values can be either a numeric field in the building footprint attribute table or a raster or TIN surface. A field-based ground source will be processed faster than a surface-based ground source.",
        "ground.title": "Ground Height",
        "in_features.descr": "The polygon features that define the building footprint.",
        "in_features.title": "Input Features",
        "in_las_dataset.descr": "The LAS dataset containing the points that will define the building rooftop.",
        "in_las_dataset.title": "Input LAS Dataset",
        "max_height_field.descr": "The numeric field containing the maximum height of the points that will be used to define the rooftop. Any numeric field can be specified. Points that are higher than the value in this field will be ignored.",
        "max_height_field.title": "Maximum Height Field",
        "min_height_field.descr": "The numeric field containing the minimum height of the points that will be used to define the rooftop. Any numeric field can be specified. Points that are lower than the value in this field will be ignored.",
        "min_height_field.title": "Minimum Height Field",
        "out_feature_class.descr": "The multipatch feature class that will store the output building models.",
        "out_feature_class.title": "Output Multipatch Feature Class",
        "point_selection.descr": "<xdoc><p>Specifies the LAS points that will be used to define the building rooftop.</p><ul><li><span title=\"BUILDING_CLASSIFIED_POINTS\">Building Classified Points</span>—LAS points assigned a class code value of 6 will be used. This is the default.</li><li><span title=\"LAYER_FILTERED_POINTS\">Layer Filtered Points</span>—LAS points that are filtered by the input layer will be used.</li><li><span title=\"ALL_POINTS\">All Points</span>—All LAS points that overlay the building footprint will be used.</li></ul></xdoc>",
        "point_selection.domain.ALL_POINTS": "All Points",
        "point_selection.domain.BUILDING_CLASSIFIED_POINTS": "Building Classified Points",
        "point_selection.domain.LAYER_FILTERED_POINTS": "Layer Filtered Points",
        "point_selection.title": "LAS Rooftop Point Selection",
        "sampling_resolution.descr": "The binning size used to thin the point cloud before constructing the rooftop surface.",
        "sampling_resolution.title": "Sampling Resolution",
        "simplification.descr": "A z-tolerance value that will be used to simplify the rooftop geometry. This value defines the maximum deviation of the output rooftop model from the TIN surface created using the LAS points.",
        "simplification.title": "Simplification Tolerance",
        "title": "LAS Building Multipatch"
