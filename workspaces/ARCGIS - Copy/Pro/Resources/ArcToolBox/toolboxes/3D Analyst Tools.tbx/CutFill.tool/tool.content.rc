{
    "map": {
        "description": "Calculates the volume change between two surfaces. This is typically used for cut and fill operations.",
        "in_after_surface.descr": "The input representing the surface after the cut or fill operation.",
        "in_after_surface.title": "Input after raster surface",
        "in_before_surface.descr": "The input representing the surface before the cut or fill operation.",
        "in_before_surface.title": "Input before raster surface",
        "out_raster.descr": "<xdoc><p>The output raster defining regions of cut and of fill.</p><p>The values show the locations and amounts where the surface has been added to or removed from.</p></xdoc>",
        "out_raster.title": "Output raster",
        "summary": "<xdoc><p>Calculates the volume change between two surfaces. This is typically used for cut and fill operations.</p><p>Learn more about how Cut Fill works</p></xdoc>",
        "title": "Cut Fill",
        "z_factor.descr": "<xdoc><p>The number of ground x,y units in one surface z-unit.</p><p>The z-factor adjusts the units of measure for the z-units when they are different from the x,y units of the input surface. The z-values of the input surface are multiplied by the z-factor when calculating the final output surface.</p><p>If the x,y units and z-units are in the same units of measure, the z-factor is 1. This is the default.</p><p>If the x,y units and z-units are in different units of measure, the z-factor must be set to the appropriate factor or the results will be incorrect. For example, if the z-units are feet and the x,y units are meters, use a z-factor of 0.3048 to convert the z-units from feet to meters (1 foot = 0.3048 meter).</p></xdoc>",
        "z_factor.title": "Z factor"
    }
}
