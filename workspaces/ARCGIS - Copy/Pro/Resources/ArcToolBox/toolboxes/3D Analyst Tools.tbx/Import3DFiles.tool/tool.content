{
    "type": "FunctionTool",
    "guid": "{52bdd636-15d9-4672-a09f-91e38560fc5a}",
    "displayname": "$rc:title",
    "helpcontent": "5020005",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_files": {
            "displayname": "$rc:in_files.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPComposite",
                    "datatypes": [
                        {
                            "type": "DEFolder"
                        },
                        {
                            "type": "DEFile"
                        }
                    ]
                }
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "GPFileDomain",
                        "filetypes": [
                            "dae",
                            "3ds",
                            "flt",
                            "wrl",
                            "obj"
                        ]
                    }
                ]
            },
            "description": "$rc:in_files.descr"
        },
        "out_featureClass": {
            "direction": "out",
            "displayname": "$rc:out_featureclass.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "description": "$rc:out_featureclass.descr"
        },
        "root_per_feature": {
            "type": "optional",
            "displayname": "$rc:root_per_feature.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ONE_FILE_ONE_FEATURE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "ONE_ROOT_ONE_FEATURE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:root_per_feature.descr"
        },
        "spatial_reference": {
            "type": "optional",
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:spatial_reference.descr"
        },
        "y_is_up": {
            "type": "optional",
            "displayname": "$rc:y_is_up.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "Y_IS_UP"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "Z_IS_UP"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:y_is_up.descr"
        },
        "file_suffix": {
            "type": "optional",
            "displayname": "$rc:file_suffix.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "3DS",
                        "code": "$rc:file_suffix.domain.3DS"
                    },
                    {
                        "value": "WRL",
                        "code": "$rc:file_suffix.domain.WRL"
                    },
                    {
                        "value": "FLT",
                        "code": "$rc:file_suffix.domain.FLT"
                    },
                    {
                        "value": "DAE",
                        "code": "$rc:file_suffix.domain.DAE"
                    },
                    {
                        "value": "OBJ",
                        "code": "$rc:file_suffix.domain.OBJ"
                    },
                    {
                        "value": "*",
                        "code": "$rc:file_suffix.domain.*"
                    }
                ]
            },
            "value": "*",
            "description": "$rc:file_suffix.descr"
        },
        "in_featureClass": {
            "type": "optional",
            "displayname": "$rc:in_featureclass.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ]
            },
            "description": "$rc:in_featureclass.descr"
        },
        "symbol_field": {
            "type": "optional",
            "displayname": "$rc:symbol_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "OID",
                    "Short",
                    "Long",
                    "Text",
                    "Float",
                    "Double",
                    "Date"
                ]
            },
            "depends": [
                "in_featureClass"
            ],
            "description": "$rc:symbol_field.descr"
        }
    },
    "environments": [
        "XYDomain",
        "ZDomain",
        "autoCommit",
        "configKeyword",
        "outputCoordinateSystem",
        "workspace"
    ]
}
