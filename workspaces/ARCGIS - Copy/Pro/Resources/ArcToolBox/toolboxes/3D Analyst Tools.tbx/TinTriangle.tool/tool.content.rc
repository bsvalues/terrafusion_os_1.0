{
    "map": {
        "description": "Exports triangle faces from a TIN dataset to polygon features  and provides slope, aspect, and optional attributes of hillshade and tag values for each triangle.",
        "hillshade.descr": "Specifies the azimuth and altitude angles of the light source when applying a hillshade effect for the feature layer output. Azimuth can range from 0 to 360 degrees, whereas altitude can range from 0 to 90. An azimuth of 45 degrees and altitude of 30 degrees would be entered as \"HILLSHADE 45, 30\".",
        "hillshade.domain.HILLSHADE": "HILLSHADE",
        "hillshade.title": "HILLSHADE azimuth, altitude",
        "in_tin.descr": "The TIN dataset that will be processed.",
        "in_tin.title": "Input TIN",
        "out_feature_class.descr": "The feature class that will be produced.",
        "out_feature_class.title": "Output Feature Class",
        "summary": "Exports triangle faces from a TIN dataset to polygon features and provides slope, aspect, and optional attributes of hillshade and tag values for each triangle.",
        "tag_field.descr": "The field name in the output feature that will store the triangle tag value. This parameter is empty by default, which will result in tag values not being written to the output.",
        "tag_field.title": "Tag Value Field",
        "title": "TIN Triangle",
        "units.descr": "<xdoc><p>The units of measure to be used in calculating slope.</p><ul><li><span title=\"PERCENT\">Percent</span>—Slope is expressed as a percentage value. This is the default.</li><li><span title=\"DEGREE\">Degree</span>—Slope is expressed as the angle of inclination from a horizontal plane.</li></ul></xdoc>",
        "units.domain.DEGREE": "Degree",
        "units.domain.PERCENT": "Percent",
        "units.title": "Slope Units",
        "z_factor.descr": "The factor by which z-values will be multiplied. This is typically used to convert z linear units to match x,y linear units. The default is 1, which leaves elevation values unchanged. This parameter is not available if the spatial reference of the input surface has a z-datum with a specified linear unit.",
        "z_factor.title": "Z Factor"
    }
}
