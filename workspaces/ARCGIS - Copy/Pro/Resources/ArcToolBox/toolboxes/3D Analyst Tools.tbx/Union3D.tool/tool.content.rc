{
    "map": {
        "description": "Merges closed, overlapping multipatch features from an input feature class.",
        "disable_optimization.descr": "<xdoc><p>Specifies whether optimization will be performed on the input data. Optimization will preprocess the input data by grouping it to improve performance and create unique outputs for each set of overlapping features.</p><ul><li>Unchecked—Optimization will be performed on the input data. The grouping field will be ignored. This is the default.</li><li>Checked—Optimization will not be performed on the input data. Features will either be stored in a single output feature or be unioned according to their grouping field, if one is provided.</li></ul></xdoc>",
        "disable_optimization.title": "Disable Optimization",
        "group_field.descr": "The field that will be used to identify the features to group together.",
        "group_field.title": "Grouping Field",
        "in_feature_class.descr": "The multipatch features that will be unioned.",
        "in_feature_class.title": "Input Multipatch Features",
        "out_feature_class.descr": "The output multipatch feature class that will store the aggregated features.",
        "out_feature_class.title": "Output Feature Class",
        "out_table.descr": "A many-to-one table that identifies the input features that contribute to each output.",
        "out_table.title": "Output Table",
        "output_all.descr": "<xdoc><p>Specifies whether the output feature class will contain all features or only the overlapping features that were unioned.</p><ul><li>Checked—All input features will be written to the output. This is the default.</li><li>Unchecked—Only unioned features will be written to the output. Nonoverlapping features will be ignored.</li></ul></xdoc>",
        "output_all.title": "Output All Solids",
        "title": "Union 3D"
    }
}
