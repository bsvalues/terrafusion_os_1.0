{
    "map": {
        "description": "Calculates the volume and surface area between a polygon of a constant height and a surface.",
        "in_feature_class.descr": "The polygon features that define the region being processed.",
        "in_feature_class.title": "Input Polygons",
        "in_height_field.descr": "The field in the polygon's attribute table that defines the height of the reference plane that will be used in determining volumetric calculations.",
        "in_height_field.title": "Height Field",
        "in_surface.descr": "The TIN, terrain, or LAS dataset surface that will be processed.",
        "in_surface.title": "Input Surface",
        "out_volume_above_field.descr": "<xdoc><p>The name of the field that will contain the volume calculated above the polygon height. The default is <span class=\"esri_fieldname\">Above_Vol</span>.</p></xdoc>",
        "out_volume_above_field.title": "Volume Field",
        "out_volume_below_field.descr": "<xdoc><p>The name of the field that will contain the volume calculated below the polygon height. The default is <span class=\"esri_fieldname\">Below_Vol</span>.</p></xdoc>",
        "out_volume_below_field.title": "Volume Field",
        "out_volume_field.descr": "<xdoc><p>The name of the field that will contain volumetric calculations. The default is <span class=\"esri_fieldname\">Volume</span>.</p></xdoc>",
        "out_volume_field.title": "Volume Field",
        "output_feature_class.title": "Output Feature Class",
        "pyramid_level_resolution.descr": "The z-tolerance or window-size resolution of the terrain pyramid level that will be used. The default is 0, or full resolution.",
        "pyramid_level_resolution.title": "Pyramid Level Resolution",
        "reference_plane.descr": "<xdoc><p>Specifies the direction from the reference plane that volume and surface area will be calculated.</p><ul><li><span title=\"ABOVE\">Calculate above the plane</span>—Volume and surface area will be calculated above the reference plane height of the polygons.</li><li><span title=\"BELOW\">Calculate below the plane</span>—Volume and surface area will be calculated below the reference plane height of the polygons. This is the default.</li><li><span title=\"BOTH\">Calculate above and below the plane</span>—Volume and surface area will be calculated above and below the reference plane height of the polygons.</li></ul></xdoc>",
        "reference_plane.domain.ABOVE": "Calculate above the plane",
        "reference_plane.domain.BELOW": "Calculate below the plane",
        "reference_plane.domain.BOTH": "Calculate above and below the plane",
        "reference_plane.title": "Reference Plane",
        "surface_area_above_field.descr": "<xdoc><p>The name of the field that will contain the surface area calculated above the polygon height. The default is <span class=\"esri_fieldname\">Above_SA</span>.</p></xdoc>",
        "surface_area_above_field.title": "Surface Area Above Field",
        "surface_area_below_field.descr": "<xdoc><p>The name of the field that will contain the surface area calculated below the polygon height. The default is <span class=\"esri_fieldname\">Below_SA</span>.</p></xdoc>",
        "surface_area_below_field.title": "Surface Area Below Field",
        "surface_area_field.descr": "<xdoc><p>The name of the field that will contain the surface area calculations. The default is <span class=\"esri_fieldname\">SArea</span>.</p></xdoc>",
        "surface_area_field.title": "Surface Area Field",
        "title": "Polygon Volume"
    }
}
