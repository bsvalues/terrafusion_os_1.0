        "batch_size.descr": "The number of blocks from the input point cloud that will be simultaneously processed. When no value is provided, one block will be processed at a time.",
        "batch_size.title": "Batch Size",
        "boundary.descr": "The polygon feature or features that will define the area to be processed.",
