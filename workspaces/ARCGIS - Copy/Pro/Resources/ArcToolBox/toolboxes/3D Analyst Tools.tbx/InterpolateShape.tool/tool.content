            "display_order": "3",
            "displayname": "$rc:sample_distance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:sample_distance.descr"
        },
        "z_factor": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:z_factor.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "1",
            "description": "$rc:z_factor.descr"
        },
        "method": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "LINEAR",
                        "code": "$rc:method.domain.LINEAR"
                    },
                    {
                        "value": "NATURAL_NEIGHBORS",
                        "code": "$rc:method.domain.NATURAL_NEIGHBORS"
                    },
                    {
