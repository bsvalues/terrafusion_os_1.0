        },
        "in_feature_class": {
            "displayname": "$rc:in_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline",
                    "Polygon",
                    "Point",
                    "Multipoint"
                ]
            },
            "description": "$rc:in_feature_class.descr"
        },
        "out_feature_class": {
