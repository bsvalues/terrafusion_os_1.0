                    },
                    {
                        "value": "CONFLATE_ZMAX",
                        "code": "$rc:method.domain.CONFLATE_ZMAX"
                    },
                    {
                        "value": "CONFLATE_NEAREST",
                        "code": "$rc:method.domain.CONFLATE_NEAREST"
                    },
                    {
                        "value": "CONFLATE_CLOSEST_TO_MEAN",
                        "code": "$rc:method.domain.CONFLATE_CLOSEST_TO_MEAN"
                    },
                    {
                        "value": "BILINEAR",
                        "code": "$rc:method.domain.BILINEAR"
                    },
                    {
                        "value": "NEAREST",
                        "code": "$rc:method.domain.NEAREST"
                    }
                ]
            },
            "value": "LINEAR",
            "description": "$rc:method.descr"
        },
        "vertices_only": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:vertices_only.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "VERTICES_ONLY"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DENSIFY"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:vertices_only.descr"
        },
        "pyramid_level_resolution": {
            "enabled": "false",
