{
    "type": "FunctionTool",
    "guid": "{831698ad-da16-4a84-8bfe-4afe6b08f9e8}",
    "displayname": "$rc:title",
    "helpcontent": "68000006",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_unit_features": {
            "displayname": "$rc:in_unit_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:in_unit_features.descr"
        },
        "in_detail_features": {
            "displayname": "$rc:in_detail_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:in_detail_features.descr"
        },
        "door_detail_expression": {
            "displayname": "$rc:door_detail_expression.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "in_detail_features"
            ],
            "description": "$rc:door_detail_expression.descr"
        },
        "wall_detail_expression": {
            "displayname": "$rc:wall_detail_expression.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "in_detail_features"
            ],
            "description": "$rc:wall_detail_expression.descr"
        },
        "target_openings": {
            "displayname": "$rc:target_openings.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:target_openings.descr"
        },
        "wall_thickness_tolerance": {
            "type": "optional",
            "displayname": "$rc:wall_thickness_tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLinearUnit",
                        "value": "Meters",
                        "code": "Meters"
                    },
                    {
                        "type": "GPLinearUnit",
                        "value": "Centimeters",
                        "code": "Centimeters"
                    },
                    {
                        "type": "GPLinearUnit",
                        "value": "Feet",
                        "code": "Feet"
                    },
                    {
                        "type": "GPLinearUnit",
                        "value": "Inches",
                        "code": "Inches"
                    }
                ]
            },
            "value": "2 Feet",
            "description": "$rc:wall_thickness_tolerance.descr"
        },
        "delete_existing_openings": {
            "type": "optional",
            "displayname": "$rc:delete_existing_openings.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "KEEP_EXISTING"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DELETE_EXISTING"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:delete_existing_openings.descr"
        },
        "updated_openings": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_openings.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "target_openings"
            ]
        }
    },
    "environments": [
        "workspace"
    ]
