{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "68000001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "target_gdb": {
            "display_order": "0",
            "displayname": "$rc:target_gdb.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "defaultenvironmentname": "workspace",
            "description": "$rc:target_gdb.descr"
        },
        "updated_gdb": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_gdb.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "depends": [
                "target_gdb"
            ],
            "schema": {
                "type": "GPContainerSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "create_network": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:create_network.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE_NETWORK"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_CREATE_NETWORK"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:create_network.descr"
        },
        "spatial_reference": {
            "type": "optional",
            "display_order": "1",
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "description": "$rc:spatial_reference.descr"
        },
        "create_attribute_rules": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:create_attribute_rules.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE_RULES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_CREATE_RULES"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:create_attribute_rules.descr"
        }
    },
    "environments": [
        "workspace"
    ]
}
