{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "68010003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "facility_features": {
            "display_order": "0",
            "displayname": "$rc:facility_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:facility_features.descr"
        },
        "transition_unit_features": {
            "display_order": "1",
            "displayname": "$rc:transition_unit_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:transition_unit_features.descr"
        },
        "pathway_features": {
            "display_order": "4",
            "displayname": "$rc:pathway_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:pathway_features.descr"
        },
        "target_transitions": {
            "display_order": "5",
            "displayname": "$rc:target_transitions.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:target_transitions.descr"
        },
        "elevator_delay": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:elevator_delay.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "1000"
            },
            "description": "$rc:elevator_delay.descr"
        },
        "delete_existing_transitions": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:delete_existing_transitions.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DELETE_FEATURES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_DELETE_FEATURES"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:delete_existing_transitions.descr"
        },
        "stairway_unit_exp": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:stairway_unit_exp.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "transition_unit_features"
            ],
            "description": "$rc:stairway_unit_exp.descr"
        },
        "elevator_unit_exp": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:elevator_unit_exp.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "transition_unit_features"
            ],
            "description": "$rc:elevator_unit_exp.descr"
        },
        "updated_transitions": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_transitions.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "target_transitions"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    }
}
