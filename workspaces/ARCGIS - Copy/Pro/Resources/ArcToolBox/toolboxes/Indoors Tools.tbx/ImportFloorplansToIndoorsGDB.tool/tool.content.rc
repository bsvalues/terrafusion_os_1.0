{
    "map": {
        "area_unit_of_measure.descr": "<xdoc><p>Specifies the unit of measure that will be used to calculate area for the area fields when importing floor plans.</p><ul><li><span title=\"SQUARE_FEET\">Square Feet</span>—Area will be defined in square feet. This is default.</li><li><span title=\"SQUARE_METERS\">Square Meters</span>—Area will be defined in square meters.</li></ul></xdoc>",
        "area_unit_of_measure.domain.SQUARE_FEET": "Square Feet",
        "area_unit_of_measure.domain.SQUARE_METERS": "Square Meters",
        "area_unit_of_measure.title": "Area Unit of Measure",
        "description": "Imports floor plans from CAD files into an Indoors workspace that conforms to the ArcGIS Indoors Information Model. The output of this tool can be used to create floor-aware maps and scenes for use in floor-aware apps, as well as to generate an indoor network for routing.",
        "door_close_buffer.descr": "The distance, in inches, that will be searched from a door to find and snap to the nearest wall. This parameter is used when the CLOSE_DOORS column is set to Y in the input Excel template file. The default is 0.",
        "door_close_buffer.title": "Door Close Buffer",
        "in_excel_template.descr": "An Excel spreadsheet (.xls or .xlsx file) that contains input and configuration parameters.",
        "in_excel_template.title": "Input Excel Template File",
        "measurement_mode.descr": "<xdoc><p>Specifies the measurement mode that will be used to calculate the area fields when importing floor plans.</p><ul><li><span title=\"GEODESIC\">Geodesic</span>—Area will be calculated using geodesic distance. Geodesic distance is calculated in a 3D spherical space as the distance across the curved surface of the world. This is default.</li><li><span title=\"PLANAR\">Planar</span>—Area will be calculated using planar distance. Planar distance is straight-line Euclidean distance calculated in a 2D Cartesian coordinate system.</li></ul></xdoc>",
        "measurement_mode.domain.GEODESIC": "Geodesic",
        "measurement_mode.domain.PLANAR": "Planar",
        "measurement_mode.title": "Measurement Mode",
        "sliver_threshold.descr": "The ratio of perimeter to area that defines a sliver polygon. It is used when importing Unit polygons to improve the quality of the imported data. Unit polygons that are determined to be slivers are placed in a review geodatabase located in the scratch folder of the ArcGIS Pro project. The default is 2.",
        "sliver_threshold.title": "Sliver Threshold",
        "target_detail_features.descr": "The target Details feature layer, feature class, or feature service that conforms to the ArcGIS Indoors Information Model and resides in the same workspace as the target Facilities, Levels, and Units features.",
        "target_detail_features.title": "Target Detail Features",
        "target_facility_features.descr": "The target Facilities feature layer, feature class, or feature service that conforms to the ArcGIS Indoors Information Model and resides in the same workspace as the target Levels, Units, and Details features.",
        "target_facility_features.title": "Target Facility Features",
        "target_level_features.descr": "The target Levels feature layer, feature class, or feature service that conforms to the ArcGIS Indoors Information Model and resides in the same workspace as the target Facilities, Units, and Details features.",
        "target_level_features.title": "Target Level Features",
        "target_section_features.descr": "The target Sections feature layer, feature class, or feature service that conforms to the ArcGIS Indoors Information Model and resides in the same workspace as the target Facilities, Levels, Units, and Details features.",
        "target_section_features.title": "Target Section Features",
        "target_unit_features.descr": "The target Units feature layer, feature class, or feature service that conforms to the ArcGIS Indoors Information Model and resides in the same workspace as the target Facilities, Levels, and Details features.",
        "target_unit_features.title": "Target Unit Features",
        "target_zone_features.descr": "The target Zones feature layer, feature class, or feature service that conforms to the ArcGIS Indoors Information Model and resides in the same workspace as the target Facilities, Levels, Units, and Details features.",
        "target_zone_features.title": "Target Zone Features",
        "title": "Import Floorplans To Indoors Geodatabase",
        "uniqueid_delimiter.descr": "<xdoc><p>Specifies the delimiter that will separate key values in the Indoors model hierarchy.</p><ul><li><span title=\"PERIOD\">Period</span>—The ID will include key values separated by periods. This is default.</li><li><span title=\"HYPHEN\">Hyphen</span>—The ID will include key values separated by hyphens.</li><li><span title=\"UNDERSCORE\">Underscore</span>—The ID will include key values separated by underscores.</li></ul></xdoc>",
        "uniqueid_delimiter.domain.HYPHEN": "Hyphen",
        "uniqueid_delimiter.domain.PERIOD": "Period",
        "uniqueid_delimiter.domain.UNDERSCORE": "Underscore",
        "uniqueid_delimiter.title": "Unique ID Delimiter",
        "updated_units.title": "Updated Units"
    }
}
