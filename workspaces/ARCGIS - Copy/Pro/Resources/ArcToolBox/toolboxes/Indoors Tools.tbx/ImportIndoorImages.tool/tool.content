{
    "type": "FunctionTool",
    "guid": "{df304dcf-b279-40a1-a58f-f35ff43ce0f8}",
    "displayname": "$rc:title",
    "helpcontent": "68000015",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_data": {
            "display_order": "0",
            "displayname": "$rc:in_data.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "e57"
                ]
            },
            "description": "$rc:in_data.descr"
        },
        "in_level_features": {
            "displayname": "$rc:in_level_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:in_level_features.descr"
        },
        "target_image_folder": {
            "displayname": "$rc:target_image_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:target_image_folder.descr"
        },
        "target_oriented_imagery": {
            "displayname": "$rc:target_oriented_imagery.title",
            "datatype": {
                "type": "GPOrientedImageryLayer"
            },
            "description": "$rc:target_oriented_imagery.descr"
        },
        "in_coordinate_system": {
            "type": "optional",
            "display_order": "1",
            "displayname": "$rc:in_coordinate_system.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "description": "$rc:in_coordinate_system.descr"
        },
        "elevation_adjustment": {
            "type": "optional",
            "displayname": "$rc:elevation_adjustment.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLinearUnit",
                        "value": "Meters",
                        "code": "Meters"
                    },
                    {
                        "type": "GPLinearUnit",
                        "value": "FeetInt",
                        "code": "FeetInt"
                    }
                ]
            },
            "value": "0 Meters",
            "category": "$rc:params.category1",
            "description": "$rc:elevation_adjustment.descr"
        },
        "horizontal_field_of_view": {
            "type": "optional",
            "displayname": "$rc:horizontal_field_of_view.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                },
                "high": {
                    "allow": "true",
                    "val": "360"
                }
            },
            "value": "360",
            "category": "$rc:params.category1",
            "description": "$rc:horizontal_field_of_view.descr"
        },
        "vertical_field_of_view": {
            "type": "optional",
            "displayname": "$rc:vertical_field_of_view.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                },
                "high": {
                    "allow": "true",
                    "val": "180"
                }
            },
            "value": "180",
            "category": "$rc:params.category1",
            "description": "$rc:vertical_field_of_view.descr"
        },
        "updated_target_oriented_imagery": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_target_oriented_imagery.title",
            "datatype": {
                "type": "GPOrientedImageryLayer"
            },
            "depends": [
                "target_oriented_imagery"
            ]
        }
    }
