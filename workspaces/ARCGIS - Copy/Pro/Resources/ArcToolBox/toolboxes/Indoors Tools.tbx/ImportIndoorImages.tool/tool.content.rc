{
    "map": {
        "description": "Imports 360-degree and panoramic images from an .e57 file to an oriented imagery dataset. The output of this tool can be added to floor-aware maps and scenes in ArcGIS Pro.",
        "elevation_adjustment.descr": "<xdoc><p>The value by which the z-values of imported images will be adjusted. If the imported images are reprojected, the adjustment will be applied after projection. The default value is 0 meters.</p><ul><li>A value of -300 feet reduces the z-value of imported images by 300 feet.</li><li>A value of 250 meters increases the z-value of imported images by 250 meters.</li></ul></xdoc>",
        "elevation_adjustment.title": "Elevation Adjustment",
        "horizontal_field_of_view.descr": "The effective width of the field of view of imported images, in degrees. Valid values range from 0 to 360. The default value is 360.",
        "horizontal_field_of_view.title": "Horizontal Field of View",
        "in_coordinate_system.descr": "The spatial reference of the input image file. A coordinate system can be selected if none are specified in the input data file.",
        "in_coordinate_system.title": "Input Coordinate System",
        "in_data.descr": "The .e57 file containing the target oriented imagery file that will be imported.",
        "in_data.title": "Input Data",
        "in_level_features.descr": "The associated Levels layer from the ArcGIS Indoors Information Model that resides in the same workspace as the target images layer.",
        "in_level_features.title": "Input Level Features",
        "params.category1": "Advanced Options",
        "target_image_folder.descr": "The existing folder where the imagery files will be written.",
        "target_image_folder.title": "Target Image Folder",
        "target_oriented_imagery.descr": "The target oriented imagery layer to which features will be added.",
        "target_oriented_imagery.title": "Target Oriented Imagery",
        "title": "Import Indoor Images",
        "updated_target_oriented_imagery.title": "Updated Target Oriented Imagery",
        "vertical_field_of_view.descr": "The effective height of the field of view of imported images, in degrees. Valid values range from 0 to 180. The default value is 180.",
        "vertical_field_of_view.title": "Vertical Field of View"
