{
    "type": "FunctionTool",
    "guid": "{d7c1219a-d151-4980-8f76-4ea298c31d4e}",
    "displayname": "$rc:title",
    "helpcontent": "68010008",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_level_features": {
            "displayname": "$rc:in_level_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:in_level_features.descr"
        },
        "in_unit_features": {
            "displayname": "$rc:in_unit_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:in_unit_features.descr"
        },
        "in_obstacle_features": {
            "displayname": "$rc:in_obstacle_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:in_obstacle_features.descr"
        },
        "target_indoor_pathways": {
            "displayname": "$rc:target_indoor_pathways.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:target_indoor_pathways.descr"
        },
        "target_floor_transitions": {
            "type": "optional",
            "displayname": "$rc:target_floor_transitions.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:target_floor_transitions.descr"
        },
        "obstacle_expression": {
            "type": "optional",
            "displayname": "$rc:obstacle_expression.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "in_obstacle_features"
            ],
            "description": "$rc:obstacle_expression.descr"
        },
        "routable_locations": {
            "type": "optional",
            "displayname": "$rc:routable_locations.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ]
            },
            "description": "$rc:routable_locations.descr"
        },
        "generation_method": {
            "type": "optional",
            "displayname": "$rc:generation_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UCN",
                        "code": "$rc:generation_method.domain.UCN"
                    },
                    {
                        "value": "TRANSITIONS_ONLY",
                        "code": "$rc:generation_method.domain.TRANSITIONS_ONLY"
                    }
                ]
            },
            "value": "UCN",
            "description": "$rc:generation_method.descr"
        },
        "stairway_unit_exp": {
            "type": "optional",
            "displayname": "$rc:stairway_unit_exp.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "in_unit_features"
            ],
            "category": "$rc:params.category1",
            "description": "$rc:stairway_unit_exp.descr"
        },
        "elevator_unit_exp": {
            "type": "optional",
            "displayname": "$rc:elevator_unit_exp.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "in_unit_features"
            ],
            "category": "$rc:params.category1",
            "description": "$rc:elevator_unit_exp.descr"
        },
        "elevator_delay": {
            "type": "optional",
            "displayname": "$rc:elevator_delay.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                }
            },
            "value": "0",
            "category": "$rc:params.category1",
            "description": "$rc:elevator_delay.descr"
        },
        "obstacle_buffer": {
            "type": "optional",
            "displayname": "$rc:obstacle_buffer.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLinearUnit",
                        "value": "Meters",
                        "code": "Meters"
                    },
                    {
                        "type": "GPLinearUnit",
                        "value": "FeetInt",
                        "code": "FeetInt"
                    }
                ]
            },
            "value": "0.4 Meters",
            "category": "$rc:params.category2",
            "description": "$rc:obstacle_buffer.descr"
        },
        "search_radius": {
            "type": "optional",
            "displayname": "$rc:search_radius.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLinearUnit",
                        "value": "Meters",
                        "code": "Meters"
                    },
                    {
                        "type": "GPLinearUnit",
                        "value": "FeetInt",
                        "code": "FeetInt"
                    }
                ]
            },
            "value": "10 Meters",
            "category": "$rc:params.category2",
            "description": "$rc:search_radius.descr"
        },
        "updated_pathways": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_pathways.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "target_indoor_pathways"
            ]
        },
        "updated_transitions": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_transitions.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "target_floor_transitions"
            ]
        }
    },
    "environments": [
        "parallelProcessingFactor"
    ]
}
