        "title": "Import CAD To Indoor Dataset",
        "updated_units.title": "Updated Units",
        "vertical_order.descr": "An ordinal integer representing the vertical order of each floor. The vertical order of the ground floor is zero (0). Floors above the ground floor have positive vertical order values, and floors below the ground floor have negative values.",
        "vertical_order.title": "Vertical Order"
