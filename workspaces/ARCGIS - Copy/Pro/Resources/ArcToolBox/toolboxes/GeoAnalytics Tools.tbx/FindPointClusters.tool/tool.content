{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "51010004",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "spark"
    ],
    "params": {
        "input_points": {
            "display_order": "0",
            "displayname": "$rc:input_points.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "featuretype": [
                    "Simple"
                ],
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:input_points.descr"
        },
        "output_name": {
            "display_order": "1",
            "displayname": "$rc:output_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:output_name.descr"
        },
        "minimum_points": {
            "display_order": "3",
            "displayname": "$rc:minimum_points.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:minimum_points.descr"
        },
        "search_distance": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:search_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:search_distance.descr"
        },
        "data_store": {
            "type": "optional",
            "displayname": "$rc:data_store.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SPATIOTEMPORAL_DATA_STORE",
                        "code": "$rc:data_store.domain.SPATIOTEMPORAL_DATA_STORE"
                    },
                    {
                        "value": "RELATIONAL_DATA_STORE",
                        "code": "$rc:data_store.domain.RELATIONAL_DATA_STORE"
                    }
                ]
            },
            "value": "SPATIOTEMPORAL_DATA_STORE",
            "description": "$rc:data_store.descr"
        },
        "output": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "clustering_method": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:clustering_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DBSCAN",
                        "code": "$rc:clustering_method.domain.DBSCAN"
                    },
                    {
                        "value": "HDBSCAN",
                        "code": "$rc:clustering_method.domain.HDBSCAN"
                    }
                ]
            },
            "value": "DBSCAN",
            "description": "$rc:clustering_method.descr"
        },
        "use_time": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:use_time.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "TIME"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_TIME"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:use_time.descr"
        },
        "search_duration": {
            "enabled": "false",
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:search_duration.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:search_duration.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
