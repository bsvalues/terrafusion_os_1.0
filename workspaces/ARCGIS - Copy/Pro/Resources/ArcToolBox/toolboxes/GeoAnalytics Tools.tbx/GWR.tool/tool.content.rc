{
    "map": {
        "data_store.descr": "<xdoc><p>Specifies the ArcGIS Data Store where the output will be stored. All results stored in a spatiotemporal big data store will be stored in WGS84. Results stored in a relational data store will maintain their coordinate system.</p><ul><li><span title=\"SPATIOTEMPORAL_DATA_STORE\">Spatiotemporal big data store</span>—Output will be stored in a spatiotemporal big data store. This is the default.</li><li><span title=\"RELATIONAL_DATA_STORE\">Relational data store</span>—Output will be stored in a relational data store.</li></ul></xdoc>",
        "data_store.domain.RELATIONAL_DATA_STORE": "Relational data store",
        "data_store.domain.SPATIOTEMPORAL_DATA_STORE": "Spatiotemporal big data store",
        "data_store.title": "Data Store",
        "dependent_variable.descr": "The numeric field containing the observed values that will be modeled.",
        "dependent_variable.title": "Dependent Variable",
        "description": "Performs Geographically Weighted Regression (GWR), which is a local form of linear regression that is used to model spatially varying relationships.",
        "distance_band.descr": "The spatial extent of the neighborhood.",
        "distance_band.title": "Distance Band",
        "explanatory_variables.descr": "A list of fields representing independent explanatory variables in the regression model.",
        "explanatory_variables.title": "Explanatory Variable(s)",
        "in_features.descr": "The point feature class containing the dependent and explanatory variables.",
        "in_features.title": "Input Features",
        "local_weighting_scheme.descr": "<xdoc><p>Specifies the kernel type that will be used to provide the spatial weighting in the model. The kernel defines how each feature is related to other features within its neighborhood.</p><ul><li><span title=\"BISQUARE\">Bisquare</span>—A weight of 0 will be assigned to any feature outside the neighborhood specified. This is the default.</li><li><span title=\"GAUSSIAN\">Gaussian</span>—All features will receive weights, but weights become exponentially smaller the farther away they are from the target feature.</li></ul></xdoc>",
        "local_weighting_scheme.domain.BISQUARE": "Bisquare",
        "local_weighting_scheme.domain.GAUSSIAN": "Gaussian",
        "local_weighting_scheme.title": "Local Weighting Scheme",
        "model_type.descr": "<xdoc><p>Specifies the type of data that will be modeled.</p><ul><li><span title=\"CONTINUOUS\">Continuous (Gaussian)</span>— The <span class=\"esri_uicontrol\">Dependent Variable</span> value is continuous. The Gaussian model will be used, and the tool performs ordinary least squares regression.</li></ul></xdoc>",
        "model_type.domain.CONTINUOUS": "Continuous (Gaussian)",
        "model_type.title": "Model Type",
        "neighborhood_selection_method.descr": "<xdoc><p>Specifies how the neighborhood size will be determined.</p><ul><li><span title=\"USER_DEFINED\">User defined</span>— The neighborhood size will be determined by either the <span class=\"esri_uicontrol\">Number of Neighbors</span> or <span class=\"esri_uicontrol\">Distance Band</span> parameter.</li></ul></xdoc>",
        "neighborhood_selection_method.domain.USER_DEFINED": "User defined",
        "neighborhood_selection_method.title": "Neighborhood Selection Method",
        "neighborhood_type.descr": "<xdoc><p>Specifies whether the neighborhood used is constructed as a fixed distance or allowed to vary in spatial extent depending on the density of the features.</p><ul><li><span title=\"NUMBER_OF_NEIGHBORS\">Number of neighbors</span>— The neighborhood size is a function of a specified number of neighbors included in calculations for each feature. Where features are dense, the spatial extent of the neighborhood is smaller; where features are sparse, the spatial extent of the neighborhood is larger.</li><li><span title=\"DISTANCE_BAND\">Distance band</span>—The neighborhood size is a constant or fixed distance for each feature.</li></ul></xdoc>",
        "neighborhood_type.domain.DISTANCE_BAND": "Distance band",
        "neighborhood_type.domain.NUMBER_OF_NEIGHBORS": "Number of neighbors",
        "neighborhood_type.title": "Neighborhood Type",
        "number_of_neighbors.descr": "The closest number of neighbors (up to 1000) to consider for each feature. The number must be an integer between 2 and 1000.",
        "number_of_neighbors.title": "Number of Neighbors",
        "output.title": "Output",
        "output_features.descr": "The name of the output feature service.",
        "output_features.title": "Output Features",
        "params.category1": "Additional Options",
        "params.category2": "Data Store",
        "summary": "<xdoc><p>Performs Geographically Weighted Regression (GWR), which is a local form of linear regression that is used to model spatially varying relationships.</p><p><note type=\"legacy\"/><p group=\"note\">The ArcGIS GeoAnalytics Server extension is being deprecated in ArcGIS Enterprise. The final release of GeoAnalytics Server was included with ArcGIS Enterprise 11.3. This geoprocessing tool is available through ArcGIS Enterprise 11.3 and earlier versions.</p></p><note type=\"note\"/><p group=\"note\">This tool is a subset of capabilities added to the Geographically Weighted Regression (GWR) tool introduced at ArcGIS Pro 2.3.</p><p>For an understanding of the algorithms of the tool, see How Geographically Weighted Regression (GWR) works. This topic describes the Spatial Statistics toolbox tool; not all capabilities are included in the GeoAnalytics Server Toolbox tool at this time.</p></xdoc>",
        "title": "Geographically Weighted Regression (GWR)"
    }
}
