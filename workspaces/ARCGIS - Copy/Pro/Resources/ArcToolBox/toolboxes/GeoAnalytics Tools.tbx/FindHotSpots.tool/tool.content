{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "51010003",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "spark"
    ],
    "params": {
        "point_layer": {
            "displayname": "$rc:point_layer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "featuretype": [
                    "Simple"
                ],
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:point_layer.descr"
        },
        "output_name": {
            "displayname": "$rc:output_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:output_name.descr"
        },
        "bin_size": {
            "type": "optional",
            "displayname": "$rc:bin_size.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:bin_size.descr"
        },
        "neighborhood_size": {
            "type": "optional",
            "displayname": "$rc:neighborhood_size.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:neighborhood_size.descr"
        },
        "time_step_interval": {
            "type": "optional",
            "displayname": "$rc:time_step_interval.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_step_interval.descr"
        },
        "time_step_alignment": {
            "type": "optional",
            "displayname": "$rc:time_step_alignment.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "START_TIME",
                        "code": "$rc:time_step_alignment.domain.START_TIME"
                    },
                    {
                        "value": "END_TIME",
                        "code": "$rc:time_step_alignment.domain.END_TIME"
                    },
                    {
                        "value": "REFERENCE_TIME",
                        "code": "$rc:time_step_alignment.domain.REFERENCE_TIME"
                    }
                ]
            },
            "value": "START_TIME",
            "description": "$rc:time_step_alignment.descr"
        },
        "time_step_reference": {
            "type": "optional",
            "displayname": "$rc:time_step_reference.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_step_reference.descr"
        },
        "output": {
            "enabled": "false",
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "data_store": {
            "type": "optional",
            "displayname": "$rc:data_store.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SPATIOTEMPORAL_DATA_STORE",
                        "code": "$rc:data_store.domain.SPATIOTEMPORAL_DATA_STORE"
                    },
                    {
                        "value": "RELATIONAL_DATA_STORE",
                        "code": "$rc:data_store.domain.RELATIONAL_DATA_STORE"
                    }
                ]
            },
            "value": "SPATIOTEMPORAL_DATA_STORE",
            "description": "$rc:data_store.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
