{
    "map": {
        "calibrate_rule.descr": "<xdoc><p>Specifies the event behavior rule that will be defined for the calibrate activity.</p><ul><li><span title=\"STAY_PUT\">Stay put</span>—The geographic location of the event will be preserved; measures may change. This is the default.</li><li><span title=\"RETIRE\">Retire</span>—Both measure and geographic location will be preserved; the event will be retired.</li><li><span title=\"MOVE\">Move</span>—The measures of the event will be preserved; the geographic location may change.</li></ul></xdoc>",
        "calibrate_rule.domain.MOVE": "Move",
        "calibrate_rule.domain.RETIRE": "Retire",
        "calibrate_rule.domain.STAY_PUT": "Stay put",
        "calibrate_rule.title": "Calibrate Rule",
        "carto_realign_rule.descr": "<xdoc><p>Specifies the event behavior rule that will be defined for the cartographic realignment activity.</p><ul><li><span title=\"HONOR_ROUTE_MEASURE\">Honor Route Measure</span>—The measure of the event will be preserved or will change proportionally to the route&apos;s measure change. This is the default.</li><li><span title=\"HONOR_REFERENT_LOCATION\">Honor Referent Location</span>—The referent location of the event will be preserved.</li></ul></xdoc>",
        "carto_realign_rule.domain.HONOR_REFERENT_LOCATION": "Honor Referent Location",
        "carto_realign_rule.domain.HONOR_ROUTE_MEASURE": "Honor Route Measure",
        "carto_realign_rule.title": "Carto Realign Rule",
        "description": "Modifies event behavior rules for the registered event  layer or feature class.",
        "extend_rule.descr": "<xdoc><p>Specifies the event behavior rule that will be defined for the extend activity.</p><ul><li><span title=\"STAY_PUT\">Stay put</span>—The geographic location of the event will be preserved; measures may change. This is the default.</li><li><span title=\"RETIRE\">Retire</span>—Both measure and geographic location will be preserved; the event will be retired.</li><li><span title=\"MOVE\">Move</span>—The measures of the event will be preserved; the geographic location may change.</li><li><span title=\"COVER\">Cover</span>—The geometric location and measure of a line event will be modified to include a new or newly modified section.</li></ul></xdoc>",
        "extend_rule.domain.COVER": "Cover",
        "extend_rule.domain.MOVE": "Move",
        "extend_rule.domain.RETIRE": "Retire",
        "extend_rule.domain.STAY_PUT": "Stay put",
        "extend_rule.title": "Extend Rule",
        "in_feature_class.descr": "The event feature class.",
        "in_feature_class.title": "Event Feature Class",
        "out_feature_class.title": "Updated Input Feature Class",
        "realign_rule.descr": "<xdoc><p>Specifies the event behavior rule that will be defined for the realign activity.</p><ul><li><span title=\"STAY_PUT\">Stay put</span>—The geographic location of the event will be preserved; measures may change. This is the default.</li><li><span title=\"RETIRE\">Retire</span>—Both measure and geographic location will be preserved; the event will be retired.</li><li><span title=\"MOVE\">Move</span>—The measures of the event will be preserved; the geographic location may change.</li><li><span title=\"SNAP\">Snap</span>—The geographic location of the event will be preserved by snapping the event to a concurrent route; measures may change.</li><li><span title=\"COVER\">Cover</span>—The geometric location and measure of a line event will be modified to include a new or newly modified section.</li></ul></xdoc>",
        "realign_rule.domain.COVER": "Cover",
        "realign_rule.domain.MOVE": "Move",
        "realign_rule.domain.RETIRE": "Retire",
        "realign_rule.domain.SNAP": "Snap",
        "realign_rule.domain.STAY_PUT": "Stay put",
        "realign_rule.title": "Realign Rule",
        "reassign_rule.descr": "<xdoc><p>Specifies the event behavior rule that will be defined for the reassign activity.</p><ul><li><span title=\"STAY_PUT\">Stay put</span>—The geographic location of the event will be preserved; measures may change. This is the default.</li><li><span title=\"RETIRE\">Retire</span>—Both measure and geographic location will be preserved; the event will be retired.</li><li><span title=\"MOVE\">Move</span>—The measures of the event will be preserved; the geographic location may change.</li><li><span title=\"SNAP\">Snap</span>—The geographic location of the event will be preserved by snapping the event to a concurrent route; measures may change.</li></ul></xdoc>",
        "reassign_rule.domain.MOVE": "Move",
