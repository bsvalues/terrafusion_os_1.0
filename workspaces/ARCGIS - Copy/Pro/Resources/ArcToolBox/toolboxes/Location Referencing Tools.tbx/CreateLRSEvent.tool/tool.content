{
    "type": "FunctionTool",
    "guid": "{0A4A9218-07A4-497A-8506-CED528063FB9}/CreateLRSEvent",
    "displayname": "$rc:title",
    "helpcontent": "23000031",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "78"
    ],
    "params": {
        "parent_network": {
            "displayname": "$rc:parent_network.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:parent_network.descr"
        },
        "event_name": {
            "displayname": "$rc:event_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:event_name.descr"
        },
        "geometry_type": {
            "displayname": "$rc:geometry_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POINT",
                        "code": "$rc:geometry_type.domain.POINT"
                    },
                    {
                        "value": "LINE",
                        "code": "$rc:geometry_type.domain.LINE"
                    }
                ]
            },
            "value": "POINT",
            "description": "$rc:geometry_type.descr"
        },
        "event_id_field": {
            "displayname": "$rc:event_id_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "EventId",
            "description": "$rc:event_id_field.descr"
        },
        "route_id_field": {
            "displayname": "$rc:route_id_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "RouteId",
            "description": "$rc:route_id_field.descr"
        },
        "from_date_field": {
            "displayname": "$rc:from_date_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "FromDate",
            "description": "$rc:from_date_field.descr"
        },
        "to_date_field": {
            "displayname": "$rc:to_date_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "ToDate",
            "description": "$rc:to_date_field.descr"
        },
        "loc_error_field": {
            "displayname": "$rc:loc_error_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "LocError",
            "description": "$rc:loc_error_field.descr"
        },
        "measure_field": {
            "displayname": "$rc:measure_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "Measure",
            "description": "$rc:measure_field.descr"
        },
        "to_measure_field": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:to_measure_field.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:to_measure_field.descr"
        },
        "event_spans_routes": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:event_spans_routes.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "SPANS_ROUTES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_SPANS_ROUTES"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:event_spans_routes.descr"
        },
        "to_route_id_field": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:to_route_id_field.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:to_route_id_field.descr"
        },
        "store_route_name": {
            "type": "optional",
            "displayname": "$rc:store_route_name.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "STORE_ROUTE_NAME"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_STORE_ROUTE_NAME"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:store_route_name.descr"
        },
        "route_name_field": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:route_name_field.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:route_name_field.descr"
        },
        "to_route_name_field": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:to_route_name_field.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:to_route_name_field.descr"
        },
        "out_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            }
        }
    }
}
