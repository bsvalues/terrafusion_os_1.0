{
    "map": {
        "description": "Populates or updates  the measures and route ID on Utility Network (UN) features such as pipes, devices, and junctions or on features in feature classes that are not UN or LRS feature classes.",
        "from_measure_field.descr": "<xdoc><p>The field in the <span class=\"esri_uicontrol\">Input Features</span> layer that contains the from measure value for polyline features.</p></xdoc>",
        "from_measure_field.title": "Measure Field",
        "in_features.descr": "<xdoc><p>The layer that includes route ID and measure fields that will be updated based on feature geometry relative to routes in the <span class=\"esri_uicontrol\">LRS Network</span> parameter.</p></xdoc>",
        "in_features.title": "Input Features",
        "lrs_date.descr": "The date used to define the temporal view of the network for collecting the route and measure values.",
        "lrs_date.title": "LRS Date",
        "lrs_network.descr": "The feature layer that contains the routes, route IDs, and measures.",
        "lrs_network.title": "LRS Network",
        "out_details_file.title": "Output Details File",
        "out_features.title": "Out Features",
        "route_id_field.descr": "<xdoc><p>The field in the <span class=\"esri_uicontrol\">Input Features</span> layer that contains the route ID value.</p></xdoc>",
        "route_id_field.title": "Route ID Field",
        "summary": "<xdoc><p>Populates or updates the measures and route ID on Utility Network (UN) features such as pipes, devices, and junctions or on features in feature classes that are not UN or LRS feature classes.</p><p>This tool finds appropriate routes from the <span class=\"esri_uicontrol\">LRS Network</span> parameter, gets the measures from that route, and populates or updates the measure and route attributes for the features in the nonLRS feature class.</p></xdoc>",
        "title": "Update Measures From LRS",
        "to_measure_field.descr": "<xdoc><p>The field in the <span class=\"esri_uicontrol\">Input Features</span> layer that contains the measure value for point features or the to measure value for polyline features.</p></xdoc>",
        "to_measure_field.title": "To Measure Field"
    }
}
