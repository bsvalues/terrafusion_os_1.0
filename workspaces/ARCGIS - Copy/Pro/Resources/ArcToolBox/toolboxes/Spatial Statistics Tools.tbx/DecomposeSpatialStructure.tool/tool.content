{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\DecomposeSpatialStructure",
    "displayname": "$rc:title",
    "helpcontent": "9040009",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_features": {
            "direction": "out",
            "displayname": "$rc:out_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_features.descr"
        },
        "append_all_fields": {
            "type": "optional",
            "displayname": "$rc:append_all_fields.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ALL"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_FIELDS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:append_all_fields.descr"
        },
        "min_autocorrelation": {
            "type": "optional",
            "displayname": "$rc:min_autocorrelation.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "1"
            },
            "value": "0.25",
            "description": "$rc:min_autocorrelation.descr"
        },
        "max_components": {
            "type": "optional",
            "displayname": "$rc:max_components.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1",
                "max": "10000"
            },
            "value": "15",
            "description": "$rc:max_components.descr"
        },
        "neighborhood_type": {
            "type": "optional",
            "displayname": "$rc:neighborhood_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DISTANCE_BAND",
                        "code": "$rc:neighborhood_type.domain.DISTANCE_BAND"
                    },
                    {
                        "value": "NUMBER_OF_NEIGHBORS",
                        "code": "$rc:neighborhood_type.domain.NUMBER_OF_NEIGHBORS"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_ONLY",
                        "code": "$rc:neighborhood_type.domain.CONTIGUITY_EDGES_ONLY"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_CORNERS",
                        "code": "$rc:neighborhood_type.domain.CONTIGUITY_EDGES_CORNERS"
                    },
                    {
                        "value": "DELAUNAY_TRIANGULATION",
                        "code": "$rc:neighborhood_type.domain.DELAUNAY_TRIANGULATION"
                    },
                    {
                        "value": "GET_SPATIAL_WEIGHTS_FROM_FILE",
                        "code": "$rc:neighborhood_type.domain.GET_SPATIAL_WEIGHTS_FROM_FILE"
                    }
                ]
            },
            "description": "$rc:neighborhood_type.descr"
        },
        "distance_band": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:distance_band.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Meters",
                    "Kilometers",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:distance_band.descr"
        },
        "number_of_neighbors": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:number_of_neighbors.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "2",
                "max": "1000"
            },
            "value": "8",
            "description": "$rc:number_of_neighbors.descr"
        },
        "weights_matrix_file": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:weights_matrix_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "swm",
                    "gwt",
                    "txt"
                ]
            },
            "description": "$rc:weights_matrix_file.descr"
        },
        "local_weighting_scheme": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:local_weighting_scheme.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UNWEIGHTED",
                        "code": "$rc:local_weighting_scheme.domain.UNWEIGHTED"
                    },
                    {
                        "value": "BISQUARE",
                        "code": "$rc:local_weighting_scheme.domain.BISQUARE"
                    },
                    {
                        "value": "GAUSSIAN",
                        "code": "$rc:local_weighting_scheme.domain.GAUSSIAN"
                    }
                ]
            },
            "value": "UNWEIGHTED",
            "description": "$rc:local_weighting_scheme.descr"
        },
        "kernel_bandwidth": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:kernel_bandwidth.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Meters",
                    "Kilometers",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:kernel_bandwidth.descr"
        },
        "out_swm": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_swm.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "swm"
                ]
            },
            "description": "$rc:out_swm.descr"
        },
        "id_field": {
            "type": "optional",
            "displayname": "$rc:id_field.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:id_field.descr"
        }
    },
    "environments": [
        "geographicTransformations",
        "outputCoordinateSystem"
    ]
}
