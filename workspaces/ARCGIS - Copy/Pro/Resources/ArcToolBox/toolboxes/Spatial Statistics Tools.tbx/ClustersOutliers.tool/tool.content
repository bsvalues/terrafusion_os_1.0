{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\ClustersOutliers",
    "displayname": "$rc:title",
    "helpcontent": "9030003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Feature_Class": {
            "display_order": "0",
            "displayname": "$rc:input_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_feature_class.descr"
        },
        "Input_Field": {
            "display_order": "1",
            "displayname": "$rc:input_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "Input_Feature_Class"
            ],
            "description": "$rc:input_field.descr"
        },
        "Output_Feature_Class": {
            "direction": "out",
            "display_order": "2",
            "displayname": "$rc:output_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_feature_class.descr"
        },
        "Conceptualization_of_Spatial_Relationships": {
            "display_order": "3",
            "displayname": "$rc:conceptualization_of_spatial_relationships.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INVERSE_DISTANCE",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.INVERSE_DISTANCE"
                    },
                    {
                        "value": "INVERSE_DISTANCE_SQUARED",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.INVERSE_DISTANCE_SQUARED"
                    },
                    {
                        "value": "FIXED_DISTANCE_BAND",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.FIXED_DISTANCE_BAND"
                    },
                    {
                        "value": "ZONE_OF_INDIFFERENCE",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.ZONE_OF_INDIFFERENCE"
                    },
                    {
                        "value": "K_NEAREST_NEIGHBORS",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.K_NEAREST_NEIGHBORS"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_ONLY",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.CONTIGUITY_EDGES_ONLY"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_CORNERS",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.CONTIGUITY_EDGES_CORNERS"
                    },
                    {
                        "value": "GET_SPATIAL_WEIGHTS_FROM_FILE",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.GET_SPATIAL_WEIGHTS_FROM_FILE"
                    }
                ]
            },
            "value": "INVERSE_DISTANCE",
            "description": "$rc:conceptualization_of_spatial_relationships.descr"
        },
        "Distance_Method": {
            "display_order": "4",
            "displayname": "$rc:distance_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "EUCLIDEAN_DISTANCE",
                        "code": "$rc:distance_method.domain.EUCLIDEAN_DISTANCE"
                    },
                    {
                        "value": "MANHATTAN_DISTANCE",
                        "code": "$rc:distance_method.domain.MANHATTAN_DISTANCE"
                    }
                ]
            },
            "value": "EUCLIDEAN_DISTANCE",
            "description": "$rc:distance_method.descr"
        },
        "Standardization": {
            "display_order": "5",
            "displayname": "$rc:standardization.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NONE",
                        "code": "$rc:standardization.domain.NONE"
                    },
                    {
                        "value": "ROW",
                        "code": "$rc:standardization.domain.ROW"
                    }
                ]
            },
            "value": "ROW",
            "description": "$rc:standardization.descr"
        },
        "Distance_Band_or_Threshold_Distance": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:distance_band_or_threshold_distance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "999999999999999"
            },
            "description": "$rc:distance_band_or_threshold_distance.descr"
        },
        "Weights_Matrix_File": {
            "enabled": "false",
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:weights_matrix_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "swm",
                    "gwt"
                ]
            },
            "description": "$rc:weights_matrix_file.descr"
        },
        "Apply_False_Discovery_Rate__FDR__Correction": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:apply_false_discovery_rate__fdr__correction.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "APPLY_FDR"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_FDR"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:apply_false_discovery_rate__fdr__correction.descr"
        },
        "Index_Field_Name": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:index_field_name.title",
            "datatype": {
                "type": "Field"
            },
            "value": "LMiIndex"
        },
        "ZScore_Field_Name": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:zscore_field_name.title",
            "datatype": {
                "type": "Field"
            },
            "value": "LMiZScore"
        },
        "Probability_Field": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:probability_field.title",
            "datatype": {
                "type": "Field"
            },
            "value": "LMiPValue"
        },
        "Cluster_Outlier_Type": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:cluster_outlier_type.title",
            "datatype": {
                "type": "Field"
            },
            "value": "CO_Type"
        },
        "Source_ID": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:source_id.title",
            "datatype": {
                "type": "Field"
            },
            "value": "SOURCE_ID"
        },
        "Number_of_Permutations": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:number_of_permutations.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLong",
                        "value": "0",
                        "code": "0"
                    },
                    {
                        "type": "GPLong",
                        "value": "99",
                        "code": "99"
                    },
                    {
                        "type": "GPLong",
                        "value": "199",
                        "code": "199"
                    },
                    {
                        "type": "GPLong",
                        "value": "499",
                        "code": "499"
                    },
                    {
                        "type": "GPLong",
                        "value": "999",
                        "code": "999"
                    },
                    {
                        "type": "GPLong",
                        "value": "9999",
                        "code": "9999"
                    }
                ]
            },
            "value": "499",
            "description": "$rc:number_of_permutations.descr"
        },
        "number_of_neighbors": {
            "enabled": "false",
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:number_of_neighbors.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "2",
                "max": "1000"
            },
            "description": "$rc:number_of_neighbors.descr"
        }
    },
    "environments": [
        "MResolution",
        "MTolerance",
        "XYResolution",
        "XYTolerance",
        "ZResolution",
        "ZTolerance",
        "geographicTransformations",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "qualifiedFieldNames",
        "randomGenerator",
        "scratchWorkspace",
        "workspace"
    ]
}
