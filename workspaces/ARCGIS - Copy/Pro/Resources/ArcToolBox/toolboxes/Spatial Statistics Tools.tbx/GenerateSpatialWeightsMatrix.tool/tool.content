{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\GenerateSpatialWeightsMatrix",
    "displayname": "$rc:title",
    "helpcontent": "9060001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Feature_Class": {
            "displayname": "$rc:input_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_feature_class.descr"
        },
        "Unique_ID_Field": {
            "displayname": "$rc:unique_id_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger"
                ]
            },
            "depends": [
                "Input_Feature_Class"
            ],
            "description": "$rc:unique_id_field.descr"
        },
        "Output_Spatial_Weights_Matrix_File": {
            "direction": "out",
            "displayname": "$rc:output_spatial_weights_matrix_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "swm"
                ]
            },
            "description": "$rc:output_spatial_weights_matrix_file.descr"
        },
        "Conceptualization_of_Spatial_Relationships": {
            "displayname": "$rc:conceptualization_of_spatial_relationships.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INVERSE_DISTANCE",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.INVERSE_DISTANCE"
                    },
                    {
                        "value": "FIXED_DISTANCE",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.FIXED_DISTANCE"
                    },
                    {
                        "value": "K_NEAREST_NEIGHBORS",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.K_NEAREST_NEIGHBORS"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_ONLY",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.CONTIGUITY_EDGES_ONLY"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_CORNERS",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.CONTIGUITY_EDGES_CORNERS"
                    },
                    {
                        "value": "DELAUNAY_TRIANGULATION",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.DELAUNAY_TRIANGULATION"
                    },
                    {
                        "value": "SPACE_TIME_WINDOW",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.SPACE_TIME_WINDOW"
                    },
                    {
                        "value": "CONVERT_TABLE",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.CONVERT_TABLE"
                    }
                ]
            },
            "description": "$rc:conceptualization_of_spatial_relationships.descr"
        },
        "Distance_Method": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:distance_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "EUCLIDEAN",
                        "code": "$rc:distance_method.domain.EUCLIDEAN"
                    },
                    {
                        "value": "MANHATTAN",
                        "code": "$rc:distance_method.domain.MANHATTAN"
                    }
                ]
            },
            "value": "EUCLIDEAN",
            "description": "$rc:distance_method.descr"
        },
        "Exponent": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:exponent.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "1",
            "description": "$rc:exponent.descr"
        },
        "Threshold_Distance": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:threshold_distance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "999999999"
            },
            "description": "$rc:threshold_distance.descr"
        },
        "Number_of_Neighbors": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:number_of_neighbors.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:number_of_neighbors.descr"
        },
        "Row_Standardization": {
            "type": "optional",
            "displayname": "$rc:row_standardization.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ROW_STANDARDIZATION"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_STANDARDIZATION"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:row_standardization.descr"
        },
        "Input_Table": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:input_table.title",
            "datatype": {
                "type": "DETable"
            },
            "description": "$rc:input_table.descr"
        },
        "Date_Time_Field": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:date_time_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Date"
                ]
            },
            "depends": [
                "Input_Feature_Class"
            ],
            "description": "$rc:date_time_field.descr"
        },
        "Date_Time_Interval_Type": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:date_time_interval_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SECONDS",
                        "code": "$rc:date_time_interval_type.domain.SECONDS"
                    },
                    {
                        "value": "MINUTES",
                        "code": "$rc:date_time_interval_type.domain.MINUTES"
                    },
                    {
                        "value": "HOURS",
                        "code": "$rc:date_time_interval_type.domain.HOURS"
                    },
                    {
                        "value": "DAYS",
                        "code": "$rc:date_time_interval_type.domain.DAYS"
                    },
                    {
                        "value": "WEEKS",
                        "code": "$rc:date_time_interval_type.domain.WEEKS"
                    },
                    {
                        "value": "MONTHS",
                        "code": "$rc:date_time_interval_type.domain.MONTHS"
                    },
                    {
                        "value": "YEARS",
                        "code": "$rc:date_time_interval_type.domain.YEARS"
                    }
                ]
            },
            "description": "$rc:date_time_interval_type.descr"
        },
        "Date_Time_Interval_Value": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:date_time_interval_value.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:date_time_interval_value.descr"
        },
        "Use_Z_values": {
            "type": "optional",
            "displayname": "$rc:use_z_values.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "USE_Z_VALUES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_USE_Z_VALUES"
                    }
                ]
            },
            "description": "$rc:use_z_values.descr"
        }
    },
    "environments": [
        "geographicTransformations",
        "outputCoordinateSystem",
        "scratchWorkspace",
        "workspace"
    ]
}
