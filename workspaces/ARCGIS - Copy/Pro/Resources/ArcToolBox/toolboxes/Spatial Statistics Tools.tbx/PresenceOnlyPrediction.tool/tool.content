{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\PresenceOnlyPrediction",
    "displayname": "$rc:title",
    "helpcontent": "9060012",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "input_point_features": {
            "display_order": "0",
            "displayname": "$rc:input_point_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_point_features.descr"
        },
        "contains_background": {
            "type": "optional",
            "display_order": "1",
            "displayname": "$rc:contains_background.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "PRESENCE_AND_BACKGROUND_POINTS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "PRESENCE_ONLY_POINTS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:contains_background.descr"
        },
        "presence_indicator_field": {
            "enabled": "false",
