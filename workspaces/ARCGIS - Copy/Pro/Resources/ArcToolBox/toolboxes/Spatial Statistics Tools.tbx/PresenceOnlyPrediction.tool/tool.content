                            "BigInteger"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "type": "GPBoolean",
                                "value": "true",
                                "code": "CATEGORICAL"
                            },
                            {
                                "type": "GPBoolean",
                                "value": "false",
                                "code": "NUMERIC"
                            }
                        ]
                    }
                ]
            },
            "depends": [
