{
    "map": {
        "analysis_field.descr": "The numeric field (number of incidents, crime rates, test scores, and so on) to be evaluated.",
        "analysis_field.title": "Analysis Field",
        "bounding_polygons_defining_where_incidents_are_possible.descr": "<xdoc><p>A polygon feature class defining where the incident <span class=\"esri_uicontrol\">Input Features</span> could possibly occur.</p></xdoc>",
        "bounding_polygons_defining_where_incidents_are_possible.title": "Bounding Polygons Defining Where Incidents Are Possible",
        "cell_size.descr": "<xdoc><p>The size of the grid cells used to aggregate the <span class=\"esri_uicontrol\">Input Features</span>. When aggregating into a hexagon grid, this distance is used as the height to construct the hexagon polygons.</p></xdoc>",
        "cell_size.title": "Cell Size",
        "density_surface.descr": "<xdoc><p>The <span class=\"esri_uicontrol\">Density Surface</span> parameter is disabled; it remains as a tool parameter only to support backwards compatibility. The Kernel Density tool can be used if you would like a density surface visualization of your weighted points.</p></xdoc>",
        "density_surface.title": "Density Surface",
        "description": "Given incident points or weighted features (points or polygons), creates a map of statistically significant hot and cold spots using the Getis-Ord Gi* statistic. It evaluates the characteristics of the input feature class to produce optimal results.",
        "distance_band.descr": "The spatial extent of the analysis neighborhood. This value determines which features are analyzed together in order to assess local clustering.",
        "distance_band.title": "Distance Band",
        "incident_data_aggregation_method.descr": "<xdoc><p>The aggregation method to use to create weighted features for analysis from incident point data.</p><ul><li><span title=\"COUNT_INCIDENTS_WITHIN_FISHNET_POLYGONS\">Count incidents within fishnet grid</span>—A fishnet polygon mesh will overlay the incident point data and the number of incidents within each polygon cell will be counted. If no bounding polygon is provided in the <span class=\"esri_uicontrol\">Bounding Polygons Defining Where Incidents Are Possible</span> parameter, only cells with at least one incident will be used in the analysis; otherwise, all cells within the bounding polygons will be analyzed.</li><li><span title=\"COUNT_INCIDENTS_WITHIN_HEXAGON_POLYGONS\">Count incidents within hexagon grid</span>—A hexagon polygon mesh will overlay the incident point data and the number of incidents within each polygon cell will be counted. If no bounding polygon is provided in the <span class=\"esri_uicontrol\">Bounding Polygons Defining Where Incidents Are Possible</span> parameter, only cells with at least one incident will be used in the analysis; otherwise, all cells within the bounding polygons will be analyzed.</li><li><span title=\"COUNT_INCIDENTS_WITHIN_AGGREGATION_POLYGONS\">Count incidents within aggregation polygons</span>—You provide aggregation polygons to overlay the incident point data in the <span class=\"esri_uicontrol\">Polygons For Aggregating Incidents Into Counts</span> parameter. The incidents within each polygon are counted.</li><li><span title=\"SNAP_NEARBY_INCIDENTS_TO_CREATE_WEIGHTED_POINTS\">Snap nearby incidents to create weighted points</span>—Nearby incidents will be aggregated together to create a single weighted point. The weight for each point is the number of aggregated incidents at that location.</li></ul></xdoc>",
        "incident_data_aggregation_method.domain.COUNT_INCIDENTS_WITHIN_AGGREGATION_POLYGONS": "Count incidents within aggregation polygons",
        "incident_data_aggregation_method.domain.COUNT_INCIDENTS_WITHIN_FISHNET_POLYGONS": "Count incidents within fishnet grid",
        "incident_data_aggregation_method.domain.COUNT_INCIDENTS_WITHIN_HEXAGON_POLYGONS": "Count incidents within hexagon grid",
        "incident_data_aggregation_method.domain.SNAP_NEARBY_INCIDENTS_TO_CREATE_WEIGHTED_POINTS": "Snap nearby incidents to create weighted points",
        "incident_data_aggregation_method.title": "Incident Data Aggregation Method",
        "input_features.descr": "The point or polygon feature class for which hot spot analysis will be performed.",
        "input_features.title": "Input Features",
        "output_features.descr": "The output feature class to receive the z-score, p-value, and Gi_Bin results.",
        "output_features.title": "Output Features",
        "params.category1": "Override Settings",
        "polygons_for_aggregating_incidents_into_counts.descr": "<xdoc><p>The polygons to use to aggregate the incident <span class=\"esri_uicontrol\">Input Features</span> in order to get an incident count for each polygon feature.</p></xdoc>",
        "polygons_for_aggregating_incidents_into_counts.title": "Polygons For Aggregating Incidents Into Counts",
        "title": "Optimized Hot Spot Analysis"
    }
