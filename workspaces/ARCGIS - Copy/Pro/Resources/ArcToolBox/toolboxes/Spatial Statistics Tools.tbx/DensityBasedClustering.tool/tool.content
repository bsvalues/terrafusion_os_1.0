{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\DensityBasedClustering",
    "displayname": "$rc:title",
    "helpcontent": "9030008",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "output_features": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "cluster_method": {
            "display_order": "2",
            "displayname": "$rc:cluster_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DBSCAN",
                        "code": "$rc:cluster_method.domain.DBSCAN"
                    },
                    {
                        "value": "HDBSCAN",
                        "code": "$rc:cluster_method.domain.HDBSCAN"
                    },
                    {
                        "value": "OPTICS",
                        "code": "$rc:cluster_method.domain.OPTICS"
                    }
                ]
            },
            "description": "$rc:cluster_method.descr"
        },
        "min_features_cluster": {
            "display_order": "3",
            "displayname": "$rc:min_features_cluster.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "2",
                "max": "100000000"
            },
            "description": "$rc:min_features_cluster.descr"
        },
        "search_distance": {
            "enabled": "false",
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:search_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Meters",
                    "Kilometers",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:search_distance.descr"
        },
        "cluster_sensitivity": {
            "enabled": "false",
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:cluster_sensitivity.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "100"
            },
            "description": "$rc:cluster_sensitivity.descr"
        },
        "time_field": {
            "enabled": "false",
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:time_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Date"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:time_field.descr"
        },
        "search_time_interval": {
            "enabled": "false",
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:search_time_interval.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:search_time_interval.descr"
        }
    },
    "environments": [
        "outputCoordinateSystem",
        "outputZFlag",
        "parallelProcessingFactor"
    ]
}
