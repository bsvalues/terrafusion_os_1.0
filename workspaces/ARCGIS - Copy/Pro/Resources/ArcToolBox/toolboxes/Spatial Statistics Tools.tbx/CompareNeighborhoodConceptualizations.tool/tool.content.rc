{
    "map": {
        "description": "Selects the spatial weights matrix (SWM) from a set of candidate SWMs that best represents the spatial patterns (such as trends or clusters) of one or more numeric fields.",
        "id_field.descr": "The unique ID field of the output .swm file. The field must be an integer and must have a unique value for each input feature.",
        "id_field.title": "Unique ID Field",
        "in_features.descr": "The input features containing the fields that will be used to select the SWM.",
        "in_features.title": "Input Features",
        "input_fields.descr": "The input fields that will be used to select the SWM.",
        "input_fields.title": "Input Fields",
        "out_swm.descr": "The output .swm file of the neighbors and weights selected by the tool.",
        "out_swm.title": "Output Spatial Weights Matrix",
        "summary": "<xdoc><p>Selects the spatial weights matrix (SWM) from a set of candidate SWMs that best represents the spatial patterns (such as trends or clusters) of one or more numeric fields.</p><p>The output spatial weights matrix file can then be used in tools that allow .swm files for their <span class=\"esri_uicontrol\">Neighborhood Type</span> or <span class=\"esri_uicontrol\">Conceptualization of Spatial Relationships</span> parameter values, such as the Bivariate Spatial Association (Lee&apos;s L), Hot Spot Analysis (Getis-Ord Gi*), and Cluster and Outlier Analysis (Anselin Local Moran&apos;s I) tools.</p><p>The tool selects the SWM by creating spatial components (called Moran eigenvectors) from each candidate SWM and testing how effectively the components represent the spatial patterns of the input fields.</p></xdoc>",
        "title": "Compare Neighborhood Conceptualizations"
    }
}
