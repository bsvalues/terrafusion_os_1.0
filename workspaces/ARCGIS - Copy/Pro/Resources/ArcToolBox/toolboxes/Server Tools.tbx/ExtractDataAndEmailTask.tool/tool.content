{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "22020002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Layers_to_Clip": {
            "displayname": "$rc:layers_to_clip.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPLayer"
                }
            },
            "description": "$rc:layers_to_clip.descr"
        },
        "Area_of_Interest": {
            "displayname": "$rc:area_of_interest.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:area_of_interest.descr"
        },
        "Feature_Format": {
            "displayname": "$rc:feature_format.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "File Geodatabase - GDB - .gdb",
                        "code": "$rc:feature_format.domain.File Geodatabase - GDB - .gdb"
                    },
                    {
                        "value": "Shapefile - SHP - .shp",
                        "code": "$rc:feature_format.domain.Shapefile - SHP - .shp"
                    }
                ]
            },
            "value": "File Geodatabase - GDB - .gdb",
            "description": "$rc:feature_format.descr"
        },
        "Raster_Format": {
            "displayname": "$rc:raster_format.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ESRI GRID - GRID",
                        "code": "$rc:raster_format.domain.ESRI GRID - GRID"
                    },
                    {
                        "value": "File Geodatabase - GDB - .gdb",
                        "code": "$rc:raster_format.domain.File Geodatabase - GDB - .gdb"
                    },
                    {
                        "value": "ERDAS IMAGINE - IMG - .img",
                        "code": "$rc:raster_format.domain.ERDAS IMAGINE - IMG - .img"
                    },
                    {
                        "value": "Tagged Image File Format - TIFF - .tif",
                        "code": "$rc:raster_format.domain.Tagged Image File Format - TIFF - .tif"
                    },
                    {
                        "value": "Graphic Interchange Format - GIF - .gif",
                        "code": "$rc:raster_format.domain.Graphic Interchange Format - GIF - .gif"
                    },
                    {
                        "value": "Joint Photographics Experts Group - JPEG - .jpg",
                        "code": "$rc:raster_format.domain.Joint Photographics Experts Group - JPEG - .jpg"
                    },
                    {
                        "value": "Joint Photographics Experts Group - JPEG 2000 - .jp2",
                        "code": "$rc:raster_format.domain.Joint Photographics Experts Group - JPEG 2000 - .jp2"
                    },
                    {
                        "value": "Bitmap - BMP - .bmp",
                        "code": "$rc:raster_format.domain.Bitmap - BMP - .bmp"
                    },
                    {
                        "value": "Portable Network Graphics - PNG - .png",
                        "code": "$rc:raster_format.domain.Portable Network Graphics - PNG - .png"
                    }
                ]
            },
            "value": "ESRI GRID - GRID",
            "description": "$rc:raster_format.descr"
        },
        "To": {
            "displayname": "$rc:to.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:to.descr"
        },
        "Sent": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:sent.title",
            "datatype": {
                "type": "GPBoolean"
            }
        }
    }
}
