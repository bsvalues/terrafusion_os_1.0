{
    "map": {
        "archive_layer_name.descr": "A unique name for the archive layer. The web layer that is replaced remains in the portal as an archive layer.",
        "archive_layer_name.title": "Archive Layer Name",
        "create_new_item.descr": "<xdoc><p>Specifies whether an item will be created for the archive layer. This parameter is supported on portals in ArcGIS Online and ArcGIS Enterprise 10.8 or later.</p><ul><li>Unchecked—The item ID of the update layer will be used for the archive layer. This is the default for vector tile layers and tile layers.</li><li>Checked—An item ID will be created for the archive layer. This is the default for scene layers.</li></ul></xdoc>",
        "create_new_item.title": "Create New Item For Archive Layer",
        "description": "Replaces the content of a web layer in a portal with the content of another web layer.",
        "replace_item_info.descr": "<xdoc><p>Specifies whether the target layer&apos;s item information (thumbnail image, summary, description, and tags) will be replaced. With either option, the item&apos;s credits (attribution), terms of use, and created-from information will not be replaced.</p><ul><li>Unchecked—The target layer&apos;s item information will not be replaced when the layer is updated. This is the default.</li><li>Checked—The target layer&apos;s item information will be replaced by the update layer&apos;s item information.</li></ul></xdoc>",
        "replace_item_info.title": "Replace Item Information",
        "target_layer.descr": "<xdoc><p>The web layer that will be replaced. Provide a layer or catalog path, or provide the item ID or service URL of one of the following:<ul><li>Vector tile layer published from vector tile package</li><li>Tile layer</li><li>Scene layer published from one of the following sources:<ul><li>Scene layer package</li><li>Referenced scene cache in folder or cloud data stores</li></ul></li></ul></p></xdoc>",
        "target_layer.title": "Target Layer",
        "title": "Replace Web Layer",
        "update_layer.descr": "<xdoc><p>The replacement web layer. Provide a layer or catalog path, or provide the item ID or service URL of one of the following:<ul><li>Vector tile layer published from vector tile package</li><li>Tile layer</li><li>Scene layer published from one of the following sources:<ul><li>Scene layer package</li><li>Referenced scene cache in folder or cloud data stores</li></ul></li></ul></p></xdoc>",
        "update_layer.title": "Update Layer",
        "updated_target_layer.title": "Updated Target Layer"
    }
}
