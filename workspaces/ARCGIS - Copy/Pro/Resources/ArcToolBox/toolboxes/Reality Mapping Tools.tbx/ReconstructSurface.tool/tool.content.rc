{
    "map": {
        "aoi.descr": "<xdoc><p>The area of interest that will be used to select images for processing. The area of interest can be computed automatically or defined using an input polygon.</p><p>If the value contains 3D geometries, the z-component will be ignored. If the value includes overlapping features, the union of these features will be computed.</p></xdoc>",
        "aoi.domain.item3.NONE": "NONE",
        "aoi.title": "Area of Interest",
        "cell_size.descr": "The cell size of the output product.",
        "cell_size.domain.item2.AUTO": "AUTO",
        "cell_size.title": "Cell Size",
        "correction_features.descr": "A polygon that will define the extent of all surfaces that are not water bodies. The value must be a 3D feature.",
        "correction_features.domain.item3.NONE": "NONE",
        "correction_features.title": "Correction Features",
        "derived_recon_folder.title": "Updated Reconstruction Folder",
        "description": "Generates a digital surface model (DSM), true orthos, DSM meshes, 3D meshes, and point clouds from adjusted imagery.",
        "fwd_overlap.descr": "<xdoc><p>The forward (in-strip) overlap percentage that will be used between the images. The default is 60.</p><p>This parameter is active when the <span class=\"esri_uicontrol\">Scenario</span> parameter is set to <span class=\"esri_uicontrol\">Aerial Nadir</span>.</p></xdoc>",
        "fwd_overlap.title": "Forward Overlap",
        "in_mosaic_dataset.descr": "The adjusted input mosaic dataset.",
        "in_mosaic_dataset.title": "Input Mosaic Dataset",
        "params.category1": "Advanced Options",
        "products.descr": "<xdoc><p>Specifies the products that will be generated.</p><ul><li><span title=\"DSM\">DSM</span>—A DSM will be generated. This option will be specified by default when the <span class=\"esri_uicontrol\">Scenario</span> parameter is set to <span class=\"esri_uicontrol\">Aerial Nadir</span> or <span class=\"esri_uicontrol\">Satellite</span>.</li><li><span title=\"TRUE_ORTHO\">True Ortho</span>—The imagery will be orthorectified. This option will be specified by default when the <span class=\"esri_uicontrol\">Scenario</span> parameter is set to <span class=\"esri_uicontrol\">Aerial Nadir</span> and <span class=\"esri_uicontrol\">Satellite</span>.</li><li><span title=\"DSM_MESH\">DSM Mesh</span>—A DSM mesh will be generated. This option will be specified by default when the <span class=\"esri_uicontrol\">Scenario</span> parameter is set to <span class=\"esri_uicontrol\">Aerial Nadir</span> or <span class=\"esri_uicontrol\">Satellite</span>.</li><li><span title=\"POINT_CLOUD\">Point Cloud</span>—An image point cloud will be generated. This option will be specified by default when the <span class=\"esri_uicontrol\">Scenario</span> parameter is set to <span class=\"esri_uicontrol\">Drone</span> or <span class=\"esri_uicontrol\">Aerial Oblique</span>.</li><li><span title=\"MESH\">Mesh</span>—A 3D mesh will be generated. This option will be specified by default when the <span class=\"esri_uicontrol\">Scenario</span> parameter is set to <span class=\"esri_uicontrol\">Drone</span> or <span class=\"esri_uicontrol\">Aerial Oblique</span>.</li></ul></xdoc>",
        "products.domain.DSM": "DSM",
        "products.domain.DSM_MESH": "DSM Mesh",
        "products.domain.MESH": "Mesh",
        "products.domain.POINT_CLOUD": "Point Cloud",
        "products.domain.TRUE_ORTHO": "True Ortho",
        "products.title": "Products",
        "quality.descr": "<xdoc><p>Specifies the quality of the final product.</p><ul><li><span title=\"ULTRA\">Ultra</span>—The highest level of density point cloud will be used. Input images will be used at their original (full) resolution.</li><li><span title=\"HIGH\">High</span>—The high level of density point cloud will be used. Input images will be downsampled two times.</li></ul></xdoc>",
        "quality.domain.HIGH": "High",
        "quality.domain.ULTRA": "Ultra",
        "quality.title": "Quality",
        "recon_folder.descr": "The output dataset folder.",
        "recon_folder.title": "Reconstruction Folder",
        "recon_options.descr": "<xdoc><p>A .json file or JSON string that specifies the values for the tool parameters.</p><p>If this parameter value is provided, the properties of the .json file or JSON string will set the default values for the remaining optional parameters. See the Usages section for a list of options.</p></xdoc>",
        "recon_options.title": "Reconstruction Options",
        "scenario.descr": "<xdoc><p>Specifies the type of imagery that will be used to generate the output products.</p><ul><li><span title=\"DRONE\">Drone</span>—The input imagery will be defined as having been acquired with drones or terrestrial cameras.</li><li><span title=\"AERIAL_NADIR\">Aerial Nadir</span>—The input imagery will be defined as having been acquired with large, photogrammetric camera systems.</li><li><span title=\"AERIAL_OBLIQUE\">Aerial Oblique</span>—The input imagery will be defined as having been acquired with oblique camera systems.</li><li><span title=\"SATELLITE\">Satellite</span>—The input imagery will be defined as having been acquired with a satellite.</li></ul></xdoc>",
        "scenario.domain.AERIAL_NADIR": "Aerial Nadir",
        "scenario.domain.AERIAL_OBLIQUE": "Aerial Oblique",
        "scenario.domain.DRONE": "Drone",
        "scenario.domain.SATELLITE": "Satellite",
        "scenario.title": "Scenario",
        "swd_overlap.descr": "<xdoc><p>The sideward (cross-strip) overlap percentage that will be used between the images. The default is 30.</p><p>This parameter is active when the <span class=\"esri_uicontrol\">Scenario</span> parameter is set to <span class=\"esri_uicontrol\">Aerial Nadir</span>.</p></xdoc>",
        "swd_overlap.title": "Sideward Overlap",
        "title": "Reconstruct Surface",
        "waterbody_features.descr": "A polygon that will define the extent of large water bodies. The value must be a 3D feature.",
        "waterbody_features.domain.item3.NONE": "NONE",
        "waterbody_features.title": "Waterbody Features"
    }
}
