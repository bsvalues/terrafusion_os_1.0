            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "AUTO_DETECT",
                        "code": "$rc:percentileinterpolationtype.domain.AUTO_DETECT"
                    },
                    {
                        "value": "NEAREST",
                        "code": "$rc:percentileinterpolationtype.domain.NEAREST"
                    },
                    {
                        "value": "LINEAR",
                        "code": "$rc:percentileinterpolationtype.domain.LINEAR"
                    }
                ]
            },
