                    {
                        "type": "DEImageServer"
                    },
                    {
                        "type": "GPFeatureLayer"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:inputzonelayer.descr"
        },
        "zoneField": {
            "display_order": "1",
            "displayname": "$rc:zonefield.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:zonefield.descr"
        },
        "inputRasterLayertoSummarize": {
            "display_order": "2",
            "displayname": "$rc:inputrasterlayertosummarize.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEImageServer"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:inputrasterlayertosummarize.descr"
        },
        "outputName": {
            "display_order": "3",
            "displayname": "$rc:outputname.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:outputname.descr"
        },
        "statisticType": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:statistictype.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "MEAN",
                        "code": "$rc:statistictype.domain.MEAN"
                    },
                    {
                        "value": "MAJORITY",
                        "code": "$rc:statistictype.domain.MAJORITY"
                    },
                    {
                        "value": "MAJORITY_COUNT",
                        "code": "$rc:statistictype.domain.MAJORITY_COUNT"
                    },
                    {
                        "value": "MAJORITY_PERCENT",
                        "code": "$rc:statistictype.domain.MAJORITY_PERCENT"
                    },
                    {
                        "value": "MAXIMUM",
                        "code": "$rc:statistictype.domain.MAXIMUM"
                    },
                    {
                        "value": "MEDIAN",
                        "code": "$rc:statistictype.domain.MEDIAN"
                    },
                    {
                        "value": "MINIMUM",
                        "code": "$rc:statistictype.domain.MINIMUM"
                    },
                    {
                        "value": "MINORITY",
                        "code": "$rc:statistictype.domain.MINORITY"
                    },
                    {
                        "value": "MINORITY_COUNT",
                        "code": "$rc:statistictype.domain.MINORITY_COUNT"
                    },
                    {
                        "value": "MINORITY_PERCENT",
                        "code": "$rc:statistictype.domain.MINORITY_PERCENT"
                    },
                    {
                        "value": "PERCENTILE",
                        "code": "$rc:statistictype.domain.PERCENTILE"
                    },
                    {
                        "value": "RANGE",
                        "code": "$rc:statistictype.domain.RANGE"
                    },
                    {
                        "value": "STD",
                        "code": "$rc:statistictype.domain.STD"
                    },
                    {
                        "value": "SUM",
                        "code": "$rc:statistictype.domain.SUM"
                    },
                    {
                        "value": "VARIETY",
                        "code": "$rc:statistictype.domain.VARIETY"
                    }
                ]
            },
            "value": "MEAN",
            "description": "$rc:statistictype.descr"
        },
        "ignoreMissingValues": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:ignoremissingvalues.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DATA"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NODATA"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:ignoremissingvalues.descr"
