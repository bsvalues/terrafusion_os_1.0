            "displayname": "$rc:outputraster.title",
            "datatype": {
                "type": "GPRasterLayer"
            }
        },
        "processAsMultidimensional": {
            "type": "optional",
            "display_order": "11",
            "displayname": "$rc:processasmultidimensional.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ALL_SLICES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "CURRENT_SLICE"
                    }
                ]
            },
