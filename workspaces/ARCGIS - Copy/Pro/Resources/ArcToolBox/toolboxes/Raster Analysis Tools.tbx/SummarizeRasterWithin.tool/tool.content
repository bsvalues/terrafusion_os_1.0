{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\SummarizeRasterWithin",
    "displayname": "$rc:title",
    "helpcontent": "54010001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "inputZoneLayer": {
            "display_order": "0",
            "displayname": "$rc:inputzonelayer.title",
