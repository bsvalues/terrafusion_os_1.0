{
    "map": {
        "cell_registration.descr": "<xdoc><p>Specifies how the cells will be registered with respect to the x,y coordinate.</p><ul><li><span title=\"CENTER\">Center</span>—The x,y coordinate represents the center of the cell. This is the default.</li><li><span title=\"LOWER_LEFT\">Lower Left</span>—The x,y coordinate represents the lower left of the cell.</li><li><span title=\"UPPER_LEFT\">Upper Left</span>—The x,y coordinate represents the upper left of the cell.</li></ul></xdoc>",
        "cell_registration.domain.CENTER": "Center",
        "cell_registration.domain.LOWER_LEFT": "Lower Left",
        "cell_registration.domain.UPPER_LEFT": "Upper Left",
        "cell_registration.title": "Cell Registration",
        "description": "Creates a raster layer from data stored on an OPeNDAP server.",
        "dimension_values.descr": "<xdoc><p>The starting and ending values of the dimensions or dimensions used to constrain which data will be extracted from the remote OPeNDAP server. By default, the minimum and maximum values of the dimension or dimensions will be used.</p><ul><li>Dimension—A netCDF dimension.</li><li>Start Value—The start value to use for the specified dimension.</li><li>End Value—The end value to use.</li></ul></xdoc>",
        "dimension_values.dt.title1": "Dimension",
        "dimension_values.dt.title2": "Start Value",
        "dimension_values.dt.title3": "End Value",
        "dimension_values.title": "Dimension Values",
        "extent.descr": "The output extent of the raster layer. Specify the extent coordinates in the units of the OPeNDAP data source (these could be latitude-longitude, projected coordinates, or some arbitrary grid coordinates). The purpose of this parameter is to allow subsetting to an area of interest or to reduce the size of the data that is transferred.",
        "extent.title": "Extent",
        "in_opendap_url.descr": "The URL that references the remote OPeNDAP dataset. The URL should resolve to the dataset level (for example, file name), not a directory name.",
        "in_opendap_url.title": "Input OPeNDAP URL",
        "out_raster_layer.descr": "The name of the output raster layer.",
        "out_raster_layer.title": "Output Raster Layer",
        "title": "Make OPeNDAP Raster Layer",
        "value_selection_method.descr": "<xdoc><p>Specifies the dimension value selection method that will be used.</p><ul><li><span title=\"BY_VALUE\">By value</span>—The input value will be matched with the actual dimension value.</li><li><span title=\"BY_INDEX\">By index</span>—The input value will be matched with the position or index of a dimension value. The index is 0 based; that is, the position starts at 0.</li></ul></xdoc>",
        "value_selection_method.domain.BY_INDEX": "By index",
        "value_selection_method.domain.BY_VALUE": "By value",
        "value_selection_method.title": "Value Selection Method",
        "variable.descr": "The variable from the OPeNDAP dataset that will be used to create the raster layer.",
        "variable.title": "Variable",
        "x_dimension.descr": "The dimension of the OPeNDAP dataset used to define the x, or longitude, coordinates of the output raster layer.",
        "x_dimension.title": "X Dimension",
        "y_dimension.descr": "The dimension of the OPeNDAP dataset used to define the y, or latitude, coordinates of the output raster layer.",
        "y_dimension.title": "Y Dimension"
    }
