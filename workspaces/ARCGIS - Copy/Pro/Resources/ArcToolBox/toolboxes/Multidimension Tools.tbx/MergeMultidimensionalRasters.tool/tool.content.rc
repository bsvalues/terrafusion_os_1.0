    "map": {
        "description": "Combines multiple multidimensional raster datasets spatially or across variables and dimensions.",
        "in_multidimensional_rasters.descr": "The input multidimensional rasters to be combined.",
        "in_multidimensional_rasters.title": "Input Multidimensional Rasters",
        "out_raster.descr": "The merged multidimensional raster dataset in Cloud Raster Format (a .crf file) or NetCDF format (an .nc file).",
        "out_raster.title": "Output Raster",
        "resolve_overlap_method.descr": "<xdoc><p>Specifies the method that will be used to resolve overlapping pixels in the combined datasets.</p><ul><li><span title=\"FIRST\">First</span>—The pixel value in the overlapping areas will be the value from the first raster in the list of input rasters. This is the default.</li><li><span title=\"LAST\">Last</span>—The pixel value in the overlapping areas will be the value from the last raster in the list of input rasters.</li><li><span title=\"MIN\">Minimum</span>—The pixel value in the overlapping areas will be the minimum value of the overlapping pixels.</li><li><span title=\"MAX\">Maximum</span>—The pixel value in the overlapping areas will be the maximum value of the overlapping pixels.</li><li><span title=\"MEAN\">Mean</span>—The pixel value in the overlapping areas will be the average of the overlapping pixels.</li><li><span title=\"SUM\">Sum</span>—The pixel value in the overlapping areas will be the total sum of the overlapping pixels.</li></ul></xdoc>",
        "resolve_overlap_method.domain.FIRST": "First",
        "resolve_overlap_method.domain.LAST": "Last",
        "resolve_overlap_method.domain.MAX": "Maximum",
        "resolve_overlap_method.domain.MEAN": "Mean",
        "resolve_overlap_method.domain.MIN": "Minimum",
        "resolve_overlap_method.domain.SUM": "Sum",
        "resolve_overlap_method.title": "Resolve Overlap Method",
        "title": "Merge Multidimensional Rasters"
