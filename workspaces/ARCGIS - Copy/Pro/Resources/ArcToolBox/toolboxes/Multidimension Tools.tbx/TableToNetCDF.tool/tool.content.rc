        "fields_to_dimensions.title": "Fields to Dimensions",
        "fields_to_variables.descr": "<xdoc><p>The field or fields that will be used to create variables in the netCDF file.</p><ul><li>Field—A field in the input feature attribute table.</li><li>Variable—The netCDF variable name</li><li>Units—The units of the data represented by the field</li></ul></xdoc>",
        "fields_to_variables.dt.title1": "Field",
