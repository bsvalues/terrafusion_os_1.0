{
    "map": {
        "description": "Converts a table to a netCDF file.",
        "fields_to_dimensions.descr": "<xdoc><p>The field or fields that will be used to create dimensions in the netCDF file.</p><ul><li>Field—A field in the input table.</li><li>Dimension—The netCDF dimension name</li><li>Units—The units of the data represented by the field</li></ul></xdoc>",
        "fields_to_dimensions.dt.title1": "Field",
