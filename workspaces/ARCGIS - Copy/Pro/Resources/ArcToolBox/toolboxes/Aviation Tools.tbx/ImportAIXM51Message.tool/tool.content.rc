{
    "map": {
        "description": "Imports Aeronautical Information Exchange Model (AIXM) version 5.1 data into an aviation geodatabase.",
        "in_message_file.descr": "The input AIXM 5.1 message.",
        "in_message_file.title": "Input AIXM 5.1 Message File",
        "in_tables.descr": "The names of tables used to restrict the feature types that will be imported.",
        "in_tables.title": "Input Tables",
        "summary": "<xdoc><p>Imports Aeronautical Information Exchange Model (AIXM) version 5.1 data into an aviation geodatabase.</p><p>AIXM is a well-established information exchange format in the aviation domain, and importing data in this format is the first step in the creation of an ArcGIS Aviation Charting product.</p><note type=\"note\"/><p group=\"note\">The AIXM format is commonly referred to by its acronym in the aviation industry rather than the full name of Aviation Information Exchange Model. Consequently, the tool name reflects the common usage of the acronym.</p></xdoc>",
        "target_gdb.descr": "The ArcGIS Aviation Charting schema workspace where the AIXM message will be imported.",
        "target_gdb.title": "Target Geodatabase",
        "title": "Import AIXM 5.1 Message",
        "update_existing_features.descr": "<xdoc><p>Specifies whether existing features will be updated or new features will be inserted.<ul><li>Checked—Existing features will be updated.</li><li>Unchecked—Existing features will not be updated; new features will be inserted. This is the default.</li></ul></p></xdoc>",
        "update_existing_features.title": "Update Existing Features",
        "updated_gdb.title": "Updated Geodatabase"
    }
}
