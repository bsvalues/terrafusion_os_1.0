        "comparison_version.descr": "<xdoc><p>The version of the ArcGIS Aviation Charting AIS geodatabase that will be compared to the <span class=\"esri_uicontrol\">Base Version</span> parameter value.</p></xdoc>",
        "comparison_version.title": "Comparison Version",
        "description": "Compares feature classes in two enterprise geodatabase versions and returns the differences in a report. You can filter the reported changes to determine which charts are affected by the differing data sources. You can set  filters based on areas of interest (AOI), definition queries, and Report Chart Changes preferences.",
        "pad_config_file.descr": "The .json files containing the evaluation criteria from the Prepare Aviation Data tool.",
