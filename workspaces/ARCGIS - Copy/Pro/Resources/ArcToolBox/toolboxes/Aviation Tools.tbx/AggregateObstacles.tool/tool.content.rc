{
    "map": {
        "builtup_areas_features.descr": "Polygon features designating built-up areas. These represent areas where a different height threshold is required.",
        "builtup_areas_features.title": "Built-Up Areas",
        "builtup_areas_height_threshold.descr": "The height threshold for an obstacle within a built-up area polygon to be considered for grouping. Obstacles with a height value equal to or greater than this value will be considered.",
        "builtup_areas_height_threshold.title": "Built-Up Areas Height Threshold",
        "description": "Aggregates point obstacle features within a given radius \nso that the highest obstacle in the group represents the entire group.",
        "elevation_field.descr": "The field containing the elevation of the obstacle features.",
        "elevation_field.title": "Elevation Field",
        "elevation_field_units.descr": "<xdoc><p>Specifies the units that will be used for obstacle elevation.</p><ul><li><span title=\"METERS\">Meters</span>—The obstacle elevation will be in meters.</li><li><span title=\"DECIMETERS\">Decimeters</span>—The obstacle elevation will be in decimeters.</li><li><span title=\"CENTIMETERS\">Centimeters</span>—The obstacle elevation will be in centimeters.</li><li><span title=\"MILLIMETERS\">Millimeters</span>—The obstacle elevation will be in millimeters.</li><li><span title=\"YARDS\">Yards</span>—The obstacle elevation will be in yards.</li><li><span title=\"FEET\">Feet</span>—The obstacle elevation will be in feet. This is the default.</li><li><span title=\"INCHES\">Inches</span>—The obstacle elevation will be in inches.</li></ul></xdoc>",
        "elevation_field_units.domain.CENTIMETERS": "Centimeters",
        "elevation_field_units.domain.DECIMETERS": "Decimeters",
        "elevation_field_units.domain.FEET": "Feet",
        "elevation_field_units.domain.INCHES": "Inches",
        "elevation_field_units.domain.METERS": "Meters",
        "elevation_field_units.domain.MILLIMETERS": "Millimeters",
        "elevation_field_units.domain.YARDS": "Yards",
        "elevation_field_units.title": "Elevation Field Units",
        "elevation_interpretation.descr": "<xdoc><p>Specifies how obstacle elevations will be measured.</p><ul><li><span title=\"ON_THE_GROUND\">On the Ground</span>—The height value will be added to the elevation value to determine the elevation of the top of the obstacle. Specify this option when the <span class=\"esri_uicontrol\">Elevation Field</span> parameter value contains values representing the elevation (AMSL) of the base of the obstacle.</li><li><span title=\"ABOVE_THE_GROUND\">Above the Ground</span>—Specify this option when the <span class=\"esri_uicontrol\">Elevation Field</span> parameter value contains values representing the elevation (AMSL) of the top of the obstacle. This is the default.</li></ul></xdoc>",
        "elevation_interpretation.domain.ABOVE_THE_GROUND": "Above the Ground",
        "elevation_interpretation.domain.ON_THE_GROUND": "On the Ground",
        "elevation_interpretation.title": "Elevation Interpretation",
        "height_field.descr": "The field containing the height of the obstacle features.",
        "height_field.title": "Height Field",
        "height_field_units.descr": "<xdoc><p>Specifies the units that will be used for obstacle height.</p><ul><li><span title=\"METERS\">Meters</span>—The obstacle height will be in meters.</li><li><span title=\"DECIMETERS\">Decimeters</span>—The obstacle height will be in decimeters.</li><li><span title=\"CENTIMETERS\">Centimeters</span>—The obstacle height will be in centimeters.</li><li><span title=\"MILLIMETERS\">Millimeters</span>—The obstacle height will be in millimeters.</li><li><span title=\"YARDS\">Yards</span>—The obstacle height will be in yards.</li><li><span title=\"FEET\">Feet</span>—The obstacle height will be in feet. This is the default.</li><li><span title=\"INCHES\">Inches</span>—The obstacle height will be in inches.</li></ul></xdoc>",
        "height_field_units.domain.CENTIMETERS": "Centimeters",
        "height_field_units.domain.DECIMETERS": "Decimeters",
