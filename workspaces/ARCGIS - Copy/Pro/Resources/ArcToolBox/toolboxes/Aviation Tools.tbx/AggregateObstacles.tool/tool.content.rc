        "minimum_polygon_area.title": "Minimum Polygon Area",
        "obstacle_grouping_type.descr": "<xdoc><p>Specifies the geometry type of the obstacle groups that will be generated.</p><ul><li><span title=\"TO_POINT\">To point</span>—Obstacles will be generated as points. This is the default.</li><li><span title=\"TO_POLYGON\">To polygon</span>—Obstacles will be generated as polygons.</li></ul></xdoc>",
