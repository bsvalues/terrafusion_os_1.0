{
    "map": {
        "description": "Analyzes lidar data and obstruction identification surfaces (OIS) to determine if lidar points are penetrating.",
        "in_las_obstacles.descr": "The input LAS dataset that contains 3D data points covering the area around an airport. The points represent a 3D view of natural and human-made objects that may pose a hazard to flight.",
        "in_las_obstacles.title": "Input LAS Obstacles",
        "in_ois_features.descr": "The input multipatch features representing one or more OIS. The feature class must be z-enabled.",
        "in_ois_features.title": "Input OIS Features",
        "out_las_obstacles.descr": "The output LAS dataset referencing the newly created .las files. This LAS dataset is created only when the output folder is specified to generate the LAS output.",
        "out_las_obstacles.title": "Output LAS Obstacles",
        "out_obstacle_feature_class.descr": "The output point features that represent lidar points in OIS features in which the height of the lidar point is greater than the height of the enclosing OIS feature at that point. This feature class is required output only if no output LAS dataset is requested.",
        "out_obstacle_feature_class.title": "Output Obstacle Feature Class",
        "target_folder.descr": "The folder to which .las files will be written. Each output file will have the same .las file version and point record format as the input file. This folder is required output only if no output feature class is requested.",
        "target_folder.title": "Target Folder",
        "title": "Analyze LAS Runway Obstacles",
        "vertical_clearance.descr": "If a LAS point height is above the OIS surface, that point will be captured. The height of an OIS surface above a given LAS point is temporarily lowered by the specified vertical clearance value. This decreases the distance between the height of the LAS point and the corresponding OIS surface, resulting in the likeliness that more points will be captured. Consequently, a larger collection of ground features, represented by the LAS points penetrating through the OIS surface, will be captured.",
        "vertical_clearance.title": "Vertical Clearance",
        "vertical_clearance_unit.descr": "<xdoc><p>The linear unit that will be used for the vertical clearance.</p><ul><li><span title=\"KILOMETERS\">Kilometers</span>—The linear unit will be kilometers.</li><li><span title=\"METERS\">Meters</span>—The linear unit will be meters.</li><li><span title=\"DECIMETERS\">Decimeters</span>—The linear unit will be decimeters.</li><li><span title=\"CENTIMETERS\">Centimeters</span>—The linear unit will be centimeters.</li><li><span title=\"MILLIMETERS\">Millimeters</span>—The linear unit will be millimeters.</li><li><span title=\"NAUTICAL_MILES\">Nautical miles</span>—The linear unit will be nautical miles.</li><li><span title=\"MILES\">Miles</span>—The linear unit will be miles.</li><li><span title=\"YARDS\">Yards</span>—The linear unit will be yards.</li><li><span title=\"FEET\">Feet</span>—The linear unit will be feet.</li><li><span title=\"INCHES\">Inches</span>—The linear unit will be inches.</li><li><span title=\"DECIMAL_DEGREES\">Decimal degrees</span>—The linear unit will be decimal degrees.</li><li><span title=\"POINTS\">Points</span>—The linear unit will be points.</li><li><span title=\"UNKNOWN\">Unknown</span>—The linear unit will be unknown.</li></ul></xdoc>",
        "vertical_clearance_unit.domain.CENTIMETERS": "Centimeters",
        "vertical_clearance_unit.domain.DECIMAL_DEGREES": "Decimal degrees",
        "vertical_clearance_unit.domain.DECIMETERS": "Decimeters",
        "vertical_clearance_unit.domain.FEET": "Feet",
        "vertical_clearance_unit.domain.INCHES": "Inches",
        "vertical_clearance_unit.domain.KILOMETERS": "Kilometers",
        "vertical_clearance_unit.domain.METERS": "Meters",
        "vertical_clearance_unit.domain.MILES": "Miles",
