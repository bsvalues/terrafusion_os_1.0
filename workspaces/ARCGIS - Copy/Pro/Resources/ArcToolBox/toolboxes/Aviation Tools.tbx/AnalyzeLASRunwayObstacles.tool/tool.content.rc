        "vertical_clearance_unit.domain.NAUTICAL_MILES": "Nautical miles",
        "vertical_clearance_unit.domain.POINTS": "Points",
        "vertical_clearance_unit.domain.UNKNOWN": "Unknown",
        "vertical_clearance_unit.domain.YARDS": "Yards",
        "vertical_clearance_unit.title": "Vertical Clearance Unit"
