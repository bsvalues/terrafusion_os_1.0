                        "value": "AIRFORCE",
                        "code": "$rc:in_service_type.domain.AIRFORCE"
                    },
                    {
                        "value": "ARMY",
                        "code": "$rc:in_service_type.domain.ARMY"
                    },
                    {
                        "value": "NAVY",
                        "code": "$rc:in_service_type.domain.NAVY"
                    },
                    {
                        "value": "MARINECORPS",
                        "code": "$rc:in_service_type.domain.MARINECORPS"
