            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:in_runway_features.descr"
        },
        "target_ois_features": {
            "display_order": "1",
            "displayname": "$rc:target_ois_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFeatureClassDomain",
                        "geometrytype": [
                            "Polygon",
                            "MultiPatch"
                        ]
                    }
                ]
            },
            "description": "$rc:target_ois_features.descr"
        },
        "in_wing_type": {
            "display_order": "2",
            "displayname": "$rc:in_wing_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FIXED",
                        "code": "$rc:in_wing_type.domain.FIXED"
                    },
                    {
                        "value": "ROTARY",
                        "code": "$rc:in_wing_type.domain.ROTARY"
                    }
                ]
            },
            "description": "$rc:in_wing_type.descr"
        },
