{
    "type": "ServerTool",
    "server": "OfflinePackaging",
    "uri": "https://packaging.arcgis.com/arcgis/services",
    "user": "UseSSOIdentityIfPortalOwned",
    "toolname": "RefreshMapAreaPackage",
    "displayname": "$rc:title",
    "product": "100",
    "params": {
        "packages": {
            "displayname": "$rc:packages.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "result": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:result.title",
            "datatype": {
                "type": "GPString"
            }
        }
    }
}
