{
    "type": "FunctionTool",
    "guid": "{e9b8be18-a615-46e2-bf38-4708d8fcc0a7}",
    "displayname": "$rc:title",
    "helpcontent": "24000001",
    "description": "$rc:description",
    "product": "200",
    "categories": [
        "{0a2ad811-7215-4a95-92f3-9c29de502e9b}"
    ],
    "attributes": [
        "edit_session",
        "input_data_change"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline",
                    "Polygon"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "densification_method": {
            "type": "optional",
            "control_guid": "{485D3503-E739-42A0-B3FC-B71F393110A7}",
            "displayname": "$rc:densification_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DISTANCE",
                        "code": "$rc:densification_method.domain.DISTANCE"
                    },
                    {
                        "value": "OFFSET",
                        "code": "$rc:densification_method.domain.OFFSET"
                    },
                    {
                        "value": "ANGLE",
                        "code": "$rc:densification_method.domain.ANGLE"
                    }
                ]
            },
            "value": "DISTANCE",
            "description": "$rc:densification_method.descr"
        },
        "distance": {
            "type": "optional",
            "displayname": "$rc:distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_features"
            ],
            "value": "0 Unknown",
            "description": "$rc:distance.descr"
        },
        "max_deviation": {
            "type": "optional",
            "displayname": "$rc:max_deviation.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_features"
            ],
            "value": "0 Unknown",
            "description": "$rc:max_deviation.descr"
        },
        "max_angle": {
            "type": "optional",
            "displayname": "$rc:max_angle.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                },
                "high": {
                    "allow": "false",
                    "val": "90"
                }
            },
            "value": "10",
            "description": "$rc:max_angle.descr"
        },
        "out_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_features"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "clonedependency": "true"
            }
        },
        "max_vertex_per_segment": {
            "type": "optional",
            "displayname": "$rc:max_vertex_per_segment.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:max_vertex_per_segment.descr"
        }
    },
    "environments": [
        "autoCommit",
        "workspace"
    ]
}
