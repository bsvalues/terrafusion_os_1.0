        "min_arc_angle": {
            "type": "optional",
            "displayname": "$rc:min_arc_angle.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                },
                "high": {
                    "allow": "true",
