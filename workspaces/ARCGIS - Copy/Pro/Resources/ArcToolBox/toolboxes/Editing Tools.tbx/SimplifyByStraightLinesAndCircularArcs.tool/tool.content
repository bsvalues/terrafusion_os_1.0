                "low": {
                    "inclusive": "false",
                    "val": "3"
                }
            },
            "value": "4",
            "description": "$rc:min_vertex_count.descr"
        },
        "min_radius": {
            "type": "optional",
            "displayname": "$rc:min_radius.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
