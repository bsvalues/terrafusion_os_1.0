                }
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "max_offset": {
            "displayname": "$rc:max_offset.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:max_offset.descr"
        },
        "fitting_type": {
            "type": "optional",
            "displayname": "$rc:fitting_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FIT_TO_VERTICES",
                        "code": "$rc:fitting_type.domain.FIT_TO_VERTICES"
                    },
                    {
                        "value": "FIT_TO_SEGMENTS",
                        "code": "$rc:fitting_type.domain.FIT_TO_SEGMENTS"
                    }
                ]
            },
            "value": "FIT_TO_VERTICES",
            "description": "$rc:fitting_type.descr"
        },
        "circular_arcs": {
            "type": "optional",
            "displayname": "$rc:circular_arcs.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NOT_CREATE"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:circular_arcs.descr"
        },
        "max_arc_angle_step": {
            "type": "optional",
            "displayname": "$rc:max_arc_angle_step.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "2"
                },
                "high": {
                    "allow": "true",
                    "val": "95"
                }
            },
            "value": "20",
            "description": "$rc:max_arc_angle_step.descr"
        },
        "min_vertex_count": {
