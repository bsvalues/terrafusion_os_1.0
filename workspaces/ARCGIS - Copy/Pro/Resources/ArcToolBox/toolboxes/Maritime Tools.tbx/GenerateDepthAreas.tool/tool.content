{
    "type": "FunctionTool",
    "guid": "{C5CD7E91-50D4-44D2-B98B-151009423D52}/GenerateDepthAreas",
    "displayname": "$rc:title",
    "helpcontent": "63000006",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "50"
    ],
    "params": {
        "in_tin": {
            "display_order": "0",
            "displayname": "$rc:in_tin.title",
            "datatype": {
                "type": "GPTinLayer"
            },
            "description": "$rc:in_tin.descr"
        },
        "in_contours": {
            "display_order": "1",
            "displayname": "$rc:in_contours.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:in_contours.descr"
        },
        "contour_depth_field": {
            "display_order": "2",
            "displayname": "$rc:contour_depth_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Double",
                    "Float",
                    "Long",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_contours"
            ],
            "description": "$rc:contour_depth_field.descr"
        },
        "depth_direction": {
            "display_order": "3",
            "displayname": "$rc:depth_direction.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POSITIVE_UP",
                        "code": "$rc:depth_direction.domain.POSITIVE_UP"
                    },
                    {
                        "value": "POSITIVE_DOWN",
                        "code": "$rc:depth_direction.domain.POSITIVE_DOWN"
                    }
                ]
            },
            "value": "POSITIVE_UP",
            "description": "$rc:depth_direction.descr"
        },
        "target_workspace": {
            "display_order": "5",
            "displayname": "$rc:target_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:target_workspace.descr"
        },
        "min_depth": {
            "display_order": "6",
            "displayname": "$rc:min_depth.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:min_depth.descr"
        },
        "max_depth": {
            "display_order": "7",
            "displayname": "$rc:max_depth.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:max_depth.descr"
        },
        "in_extent_polygon": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:in_extent_polygon.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:in_extent_polygon.descr"
        },
        "updated_depth_areas": {
            "type": "derived",
            "direction": "out",
            "control_guid": "{DA8EA072-AD53-11D5-A685-0008C711C8C1}",
            "displayname": "$rc:updated_depth_areas.title",
            "datatype": {
                "type": "GPFeatureLayer"
            }
        }
    }
}
