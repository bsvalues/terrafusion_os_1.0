{
    "map": {
        "date_attributes.descr": "<xdoc><p>The date and time properties and fields that will be added to the input table.</p><ul><li>Output Time Format—The date or time property that will be added to <span class=\"esri_uicontrol\">Output Field Name</span>.</li><li>Output Field Name—The name of the field that will be added to the input table.</li></ul><p>The <span class=\"esri_uicontrol\">Output Time Format</span> options are as follows:</p><ul><li>Hour—The hour value between 0 and 23.</li><li>Day Full Name—The full name of the day of the week, for example, Wednesday.</li><li>Day Numeric Value—The day of the week value between 1 and 7.</li><li>Month—The month value between 1 and 12.</li><li>Day of the Month—The day of the month value between 1 and 31.</li><li>Year—The year value in yyyy format, for example, 1983.</li></ul></xdoc>",
        "date_attributes.domain.item1.DAY_FULL_NAME": "Day Full Name",
        "date_attributes.domain.item1.DAY_OF_MONTH": "Day of the Month",
        "date_attributes.domain.item1.DAY_OF_WEEK": "Day Numeric Value",
        "date_attributes.domain.item1.HOUR": "Hour",
        "date_attributes.domain.item1.MONTH": "Month",
        "date_attributes.domain.item1.YEAR": "Year",
        "date_attributes.dt.title1": "Output Time Format",
        "date_attributes.dt.title2": "Output Field Name",
        "date_attributes.title": "Date Attributes",
        "date_field.descr": "The date field from which data and time properties will be extracted to populate the new field values.",
        "date_field.title": "Date Field",
        "description": "Adds fields containing date or time properties from an input date field, for example, day full name, day of the month, month, and year.",
        "in_table.descr": "The layer or table that contains the field with the date values that will be extracted.",
        "in_table.title": "Input Table",
        "out_table.title": "Updated Input Table",
        "title": "Add Date Attributes"
    }
