                        "code": "$rc:distance_units.domain.Inches"
                    },
                    {
                        "value": "Centimeters",
                        "code": "$rc:distance_units.domain.Centimeters"
                    },
                    {
                        "value": "Millimeters",
                        "code": "$rc:distance_units.domain.Millimeters"
                    },
