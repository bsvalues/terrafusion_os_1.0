{
    "type": "FunctionTool",
    "displayname": "$rc:title",
    "helpcontent": "13010029",
    "description": "$rc:description",
    "product": "100",
    "tool_Validate2": "NetworkAnalyst.dll/MakeLastMileDeliveryAnalysisLayer_Validate",
    "tool_Execute": "NetworkAnalyst.dll/MakeLastMileDeliveryAnalysisLayer_Execute",
    "params": {
        "network_data_source": {
            "displayname": "$rc:network_data_source.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPNetworkDatasetLayer"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "description": "$rc:network_data_source.descr"
        },
        "layer_name": {
            "type": "optional",
            "displayname": "$rc:layer_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:layer_name.descr"
        },
        "travel_mode": {
            "type": "optional",
            "displayname": "$rc:travel_mode.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:travel_mode.descr"
        },
        "time_units": {
            "type": "optional",
            "displayname": "$rc:time_units.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "Seconds",
                        "code": "$rc:time_units.domain.Seconds"
                    },
                    {
                        "value": "Minutes",
                        "code": "$rc:time_units.domain.Minutes"
                    },
                    {
                        "value": "Hours",
                        "code": "$rc:time_units.domain.Hours"
                    },
                    {
                        "value": "Days",
                        "code": "$rc:time_units.domain.Days"
                    }
                ]
            },
            "value": "Minutes",
            "description": "$rc:time_units.descr"
        },
        "distance_units": {
            "type": "optional",
            "displayname": "$rc:distance_units.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "Miles",
                        "code": "$rc:distance_units.domain.Miles"
                    },
                    {
                        "value": "Kilometers",
                        "code": "$rc:distance_units.domain.Kilometers"
                    },
                    {
                        "value": "Feet",
                        "code": "$rc:distance_units.domain.Feet"
                    },
                    {
                        "value": "Yards",
                        "code": "$rc:distance_units.domain.Yards"
                    },
                    {
                        "value": "Meters",
                        "code": "$rc:distance_units.domain.Meters"
                    },
                    {
                        "value": "Inches",
                        "code": "$rc:distance_units.domain.Inches"
                    },
                    {
                        "value": "Centimeters",
                        "code": "$rc:distance_units.domain.Centimeters"
                    },
                    {
                        "value": "Millimeters",
                        "code": "$rc:distance_units.domain.Millimeters"
                    },
                    {
                        "value": "Decimeters",
                        "code": "$rc:distance_units.domain.Decimeters"
                    },
                    {
                        "value": "NauticalMiles",
                        "code": "$rc:distance_units.domain.NauticalMiles"
                    }
                ]
            },
            "value": "Miles",
            "description": "$rc:distance_units.descr"
        },
        "earliest_route_start_date": {
            "type": "optional",
            "displayname": "$rc:earliest_route_start_date.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:earliest_route_start_date.descr"
        },
        "earliest_route_start_time": {
            "type": "optional",
            "displayname": "$rc:earliest_route_start_time.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:earliest_route_start_time.descr"
        },
        "max_route_total_time": {
            "type": "optional",
            "displayname": "$rc:max_route_total_time.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:max_route_total_time.descr"
        },
        "time_zone_for_time_fields": {
            "type": "optional",
            "displayname": "$rc:time_zone_for_time_fields.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "LOCAL_TIME_AT_LOCATIONS",
                        "code": "$rc:time_zone_for_time_fields.domain.LOCAL_TIME_AT_LOCATIONS"
                    },
                    {
                        "value": "UTC",
                        "code": "$rc:time_zone_for_time_fields.domain.UTC"
                    }
                ]
            },
            "value": "LOCAL_TIME_AT_LOCATIONS",
            "description": "$rc:time_zone_for_time_fields.descr"
        },
        "sequence_gap": {
            "type": "optional",
            "displayname": "$rc:sequence_gap.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPLong"
            },
            "value": "1",
            "description": "$rc:sequence_gap.descr"
        },
        "ignore_invalid_order_locations": {
            "type": "optional",
            "displayname": "$rc:ignore_invalid_order_locations.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "SKIP"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "HALT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:ignore_invalid_order_locations.descr"
        },
        "line_shape": {
            "type": "optional",
            "displayname": "$rc:line_shape.title",
            "category": "$rc:params.category4",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ALONG_NETWORK",
                        "code": "$rc:line_shape.domain.ALONG_NETWORK"
                    },
                    {
                        "value": "STRAIGHT_LINES",
                        "code": "$rc:line_shape.domain.STRAIGHT_LINES"
                    },
                    {
                        "value": "NO_LINES",
                        "code": "$rc:line_shape.domain.NO_LINES"
                    }
                ]
            },
            "value": "STRAIGHT_LINES",
            "description": "$rc:line_shape.descr"
        },
        "generate_directions_on_solve": {
            "type": "optional",
            "displayname": "$rc:generate_directions_on_solve.title",
            "category": "$rc:params.category4",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DIRECTIONS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_DIRECTIONS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:generate_directions_on_solve.descr"
        },
        "out_network_analysis_layer": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_network_analysis_layer.title",
            "datatype": {
                "type": "GPNALayer"
            }
        }
    },
    "environments": [
        "workspace"
    ]
}
