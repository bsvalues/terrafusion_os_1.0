        },
        "layer_name": {
            "type": "optional",
            "displayname": "$rc:layer_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:layer_name.descr"
        },
        "travel_mode": {
            "type": "optional",
            "displayname": "$rc:travel_mode.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:travel_mode.descr"
        },
        "sequence": {
            "type": "optional",
            "displayname": "$rc:sequence.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "USE_CURRENT_ORDER",
                        "code": "$rc:sequence.domain.USE_CURRENT_ORDER"
                    },
                    {
                        "value": "FIND_BEST_ORDER",
