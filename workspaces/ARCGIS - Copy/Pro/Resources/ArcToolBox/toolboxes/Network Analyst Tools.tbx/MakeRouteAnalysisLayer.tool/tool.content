                        "code": "$rc:sequence.domain.PRESERVE_FIRST"
                    },
                    {
                        "value": "PRESERVE_LAST",
                        "code": "$rc:sequence.domain.PRESERVE_LAST"
                    }
                ]
            },
            "value": "USE_CURRENT_ORDER",
            "description": "$rc:sequence.descr"
        },
        "time_of_day": {
            "type": "optional",
            "displayname": "$rc:time_of_day.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_of_day.descr"
        },
        "time_zone": {
            "type": "optional",
