            "category": "$rc:params.category4",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DIRECTIONS"
                    },
                    {
                        "type": "GPBoolean",
