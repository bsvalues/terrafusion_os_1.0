{
    "map": {
        "anonymous_use.descr": "<xdoc><p>Specifies whether the mobile map can be used without an Esri Named User account.<ul><li>Checked—Anyone with access to the package can use the mobile map without signing in with an Esri Named User account.</li><li>Unchecked—Anyone with access to the package must be signed in with an Esri Named User account to use the mobile map. This is the default.</li></ul></p><note type=\"license\"/><p group=\"note\">This optional parameter is only available with the Publisher extension.</p></xdoc>",
        "anonymous_use.title": "Enable Anonymous Use",
        "area_of_interest.descr": "A polygon layer that defines the area of interest. Only those features that intersect this value will be included in the mobile map package.",
        "area_of_interest.title": "Area of Interest",
        "clip_features.descr": "<xdoc><p>Specifies whether the geometry of the output features will be clipped to the specified <span class=\"esri_uicontrol\">Area of Interest</span> or <span class=\"esri_uicontrol\">Extent</span> parameter value, or remain unaltered.<ul><li>Checked—The geometry of the features will be clipped to the specified <span class=\"esri_uicontrol\">Area of Interest</span> or <span class=\"esri_uicontrol\">Extent</span> parameter value.</li><li>Unchecked—Features in the map will be selected and their geometry will remain unaltered. This is the default.</li></ul></p></xdoc>",
        "clip_features.title": "Clip Features",
        "credits.descr": "The credit information that will be added to the properties of the package.",
        "credits.title": "Credits",
        "description": "Packages maps and basemaps along with all referenced data sources into a single .mmpk file.",
        "description.descr": "The description information that will be added to the properties of the package.",
        "description.title": "Description",
        "enable_map_expiration.descr": "<xdoc><p>Specifies whether a time-out will be enabled on the mobile map package.</p><ul><li>Checked—A time-out will be enabled on the mobile map package.</li><li>Unchecked—A time-out will not be enabled on the mobile map package. This is the default.</li></ul><note type=\"license\"/><p group=\"note\">This optional parameter is only available with the Publisher extension.</p></xdoc>",
        "enable_map_expiration.title": "Enable Map Expiration",
        "expiration_date.descr": "<xdoc><p>The date the mobile map package will expire.</p><note type=\"license\"/><p group=\"note\">This optional parameter is only available with the Publisher extension.</p></xdoc>",
        "expiration_date.title": "Expiration Date",
        "expiration_message.descr": "<xdoc><p>A text message that will display when an expired map is accessed.</p><note type=\"license\"/><p group=\"note\">This optional parameter is only available with the Publisher extension.</p></xdoc>",
        "expiration_message.title": "Expiration Message",
        "extent.descr": "<xdoc><p>Specifies the extent that will be used to select or clip features.</p><ul><li>Current Display Extent—The extent will be based on the active map or scene.</li><li>Draw Extent—The extent will be based on a rectangle drawn on the map or scene.</li><li>Extent of a Layer—The extent will be based on an active map layer. Choose an available layer or use the <span class=\"esri_uicontrol\">Extent of data in all layers</span> option. Each map layer has the following options:<p><ul><li>All Features—The extent of all features.</li><li>Selected Features —The extent of the selected features.</li><li>Visible Features—The extent of visible features.</li></ul></p></li><li>Browse—The extent will be based on a dataset.</li><li>Intersection of Inputs—The extent will be the intersecting extent of all inputs.</li><li>Union of Inputs—The extent will be the combined extent of all inputs.</li><li>Clipboard—The extent can be copied to and from the clipboard.<ul><li>Copy Extent—Copies the extent and coordinate system to the clipboard.</li><li>Paste Extent—Pastes the extent and coordinate system from the clipboard. If the clipboard does not include a coordinate system, the extent will use the map’s coordinate system.</li></ul></li><li>Reset Extent—The extent will be reset to the default value.</li></ul><p>When coordinates are manually provided, the coordinates must be numeric values and in the active map&apos;s coordinate system. The map may use different display units than the provided coordinates. Use a negative value sign for south and west coordinates.</p></xdoc>",
        "extent.title": "Extent",
        "in_locator.descr": "<xdoc><p>One or more locators (.loc) that will be included in the mobile map package.</p><note type=\"note\"/>Locators have the following restrictions:<ul><li>The locator cannot have an unknown coordinate system.</li><li>The locator or any participating locator in a composite locator cannot be a geocoding service, including services from ArcGIS Enterprise or ArcGIS Online.</li></ul></xdoc>",
        "in_locator.title": "Input Locator",
        "in_map.descr": "One or more maps or basemaps that will be packaged into a single .mmpk file.",
        "in_map.title": "Input Map",
        "map_expiration_type.descr": "<xdoc><p>Specifies the type of access a user will have to the expired mobile map package.</p><ul><li><span title=\"ALLOW_TO_OPEN\">Allow to open</span>—A user of the package will be warned that the map has expired but will be allowed to open it. This is the default.</li><li><span title=\"DONOT_ALLOW_TO_OPEN\">Do not allow to open</span>—A user of the package will be warned that the map has expired and will not be allowed to open it.</li></ul><note type=\"license\"/><p group=\"note\">This optional parameter is only available with the Publisher extension.</p></xdoc>",
        "map_expiration_type.domain.ALLOW_TO_OPEN": "Allow to open",
        "map_expiration_type.domain.DONOT_ALLOW_TO_OPEN": "Do not allow to open",
        "map_expiration_type.title": "Map Expiration Type",
        "output_file.descr": "The output mobile map package (.mmpk).",
        "output_file.title": "Output File",
        "reference_online_content.descr": "<xdoc><p>Specifies whether service layers will be referenced in the package.<ul><li>Unchecked—Service layers will not be referenced in the mobile package. This is the default.</li><li>Checked—Service layers will be referenced in the mobile package.</li></ul></p></xdoc>",
        "reference_online_content.title": "Reference online content",
        "select_related_rows.descr": "<xdoc><p>Specifies whether the specified extent will be applied to related data sources.</p><ul><li>Unchecked—Related data sources will be consolidated in their entirety. This is the default.</li><li>Checked—Only related data corresponding to records within the specified extent will be consolidated.</li></ul></xdoc>",
        "select_related_rows.title": "Keep only the rows which are related to features within the extent",
        "summary.descr": "The text that will be used as the output package's summary property.",
        "summary.title": "Summary",
        "tags.descr": "The tag information that will be added to the properties of the package. Multiple tags can be added or separated by a comma or semicolon.",
        "tags.title": "Tags",
        "title": "Create Mobile Map Package",
        "title.descr": "The title information that will be added to the properties of the package.",
        "title.title": "Title",
        "use_limitations.descr": "The use limitations that will be added to the properties of the package.",
        "use_limitations.title": "Use Limitations"
    }
}
