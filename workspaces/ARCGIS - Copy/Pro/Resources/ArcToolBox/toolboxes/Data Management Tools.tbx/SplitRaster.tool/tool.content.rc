{
    "map": {
        "cell_size.descr": "The spatial resolution of the output raster. If left blank, the output cell size will match the input raster. When you change the cell size values, the tile size is reset to the image size and the tile count is reset to 1.",
        "cell_size.title": "Cell Size",
        "clip_type.descr": "<xdoc><p>Limits the extent of your raster dataset before you split it.</p><ul><li><span title=\"NONE\">None</span>— Use the full extent of the input raster dataset.</li><li><span title=\"EXTENT\">Extent</span>—Specify bounding box as your clipping boundary.</li><li><span title=\"FEATURE_CLASS\">Feature class</span>—Specify a feature class to clip the extent.</li></ul></xdoc>",
        "clip_type.domain.EXTENT": "Extent",
        "clip_type.domain.FEATURE_CLASS": "Feature class",
        "clip_type.domain.NONE": "None",
        "clip_type.title": "Clip Type",
        "derived_out_folder.title": "Updated Folder",
        "description": "Divides a raster dataset  into smaller pieces, by tiles or features from a polygon.",
        "format.descr": "<xdoc><p>The format for the output raster datasets.</p><ul><li><span title=\"TIFF\">Geotiff (*.tif)</span>—Tagged Image File Format. This is the default.</li><li><span title=\"BMP\">Bitmap (*.bmp)</span>—Microsoft Bitmap.</li><li><span title=\"ENVI\">ENVI (*.dat)</span>—ENVI DAT.</li><li><span title=\"Esri BIL\">Esri BIL (*.bil)</span>—Esri Band Interleaved by Line.</li><li><span title=\"Esri BIP\">Esri BIP (*.bip)</span>—Esri Band Interleaved by Pixel.</li><li><span title=\"Esri BSQ\">Esri BSQ (*.bsq)</span>—Esri Band Sequential.</li><li><span title=\"GIF\">GIF (*.gif)</span>—Graphic Interchange Format.</li><li><span title=\"GRID\">Esri GRID</span>—Esri Grid.</li><li><span title=\"IMAGINE IMAGE\">ERDAS IMAGINE (*.img)</span>—ERDAS IMAGINE.</li><li><span title=\"JP2\">JPEG 2000 (*.jp2)</span>—JPEG 2000.</li><li><span title=\"JPEG\">JPEG (*.jpeg)</span>—Joint Photographic Experts Group.</li><li><span title=\"PNG\">PNG (*.png)</span>—Portable Network Graphics.</li></ul></xdoc>",
        "format.domain.BMP": "Bitmap (*.bmp)",
        "format.domain.ENVI": "ENVI (*.dat)",
        "format.domain.Esri BIL": "Esri BIL (*.bil)",
        "format.domain.Esri BIP": "Esri BIP (*.bip)",
        "format.domain.Esri BSQ": "Esri BSQ (*.bsq)",
        "format.domain.GIF": "GIF (*.gif)",
        "format.domain.GRID": "Esri GRID",
        "format.domain.IMAGINE IMAGE": "ERDAS IMAGINE (*.img)",
        "format.domain.JP2": "JPEG 2000 (*.jp2)",
        "format.domain.JPEG": "JPEG (*.jpeg)",
        "format.domain.PNG": "PNG (*.png)",
        "format.domain.TIFF": "Geotiff (*.tif)",
        "format.title": "Output Format",
        "in_raster.descr": "The raster to split.",
        "in_raster.title": "Input Raster",
        "nodata_value.descr": "<xdoc><p>All the pixels with the specified value will be set to <span class=\"esri_uicontrol\">NoData</span> in the output raster dataset.</p></xdoc>",
        "nodata_value.title": "NoData Value",
        "num_rasters.descr": "<xdoc><p>The number of columns (x) and rows (y) to split the raster dataset into. The <span class=\"esri_uicontrol\">X coordinate</span> is the number of columns and the <span class=\"esri_uicontrol\">Y coordinate</span> is number of rows.</p></xdoc>",
        "num_rasters.title": "Number of Output Rasters",
        "origin.descr": "Change the coordinates for the lower left origin point, where the tiling scheme will begin. If left blank, the lower left origin would be the same as the input raster.",
        "origin.title": "Lower left origin",
        "out_base_name.descr": "The prefix for each of the raster datasets you will create. A number will be appended to each prefix, starting with 0.",
        "out_base_name.title": "Output Base Name",
        "out_folder.descr": "The destination for the new raster datasets.",
        "out_folder.title": "Output Folder",
        "overlap.descr": "<xdoc><p>The tiles do not have to line up perfectly; set the amount of overlap between tiles with this parameter. The default unit of measurement is in pixels. You can change this with the <span class=\"esri_uicontrol\">Units for Output Raster Size and Overlap</span> parameter.</p></xdoc>",
        "overlap.title": "Overlap",
        "params.category1": "Other Options",
        "params.category2": "Clipping Options",
        "resampling_type.descr": "<xdoc><p>Choose an appropriate technique based on the type of data you have.</p><ul><li><span title=\"NEAREST\">Nearest</span>—The fastest resampling method, and it minimizes changes to pixel values. Suitable for discrete data, such as land cover.</li><li><span title=\"BILINEAR\">Bilinear</span>—Calculates the value of each pixel by averaging (weighted for distance) the values of the surrounding 4 pixels. Suitable for continuous data.</li><li><span title=\"CUBIC\">Cubic</span>—Calculates the value of each pixel by fitting a smooth curve based on the surrounding 16 pixels. Produces the smoothest image, but can create values outside of the range found in the source data. Suitable for continuous data.</li></ul></xdoc>",
        "resampling_type.domain.BILINEAR": "Bilinear",
        "resampling_type.domain.CUBIC": "Cubic",
        "resampling_type.domain.NEAREST": "Nearest",
        "resampling_type.title": "Resampling Technique",
        "split_method.descr": "<xdoc><p>Determines how to split the raster dataset.</p><ul><li><span title=\"SIZE_OF_TILE\">Size of tile</span>—Specify the width and height of the tile.</li><li><span title=\"NUMBER_OF_TILES\">Number of tiles</span>— Specify the number of raster tiles to create by breaking the dataset into a number of columns and rows.</li><li><span title=\"POLYGON_FEATURES\">Polygon features</span>— Use the individual polygon geometries in a feature class to split the raster.</li></ul></xdoc>",
        "split_method.domain.NUMBER_OF_TILES": "Number of tiles",
        "split_method.domain.POLYGON_FEATURES": "Polygon features",
        "split_method.domain.SIZE_OF_TILE": "Size of tile",
        "split_method.title": "Split Method",
        "split_polygon_feature_class.descr": "A feature class that will be used to split the raster dataset.",
        "split_polygon_feature_class.title": "Split Polygon Feature Class",
        "summary": "Divides a raster dataset into smaller pieces, by tiles or features from a polygon.",
        "template_extent.descr": "<xdoc><p>An extent or a dataset used to define the clipping boundary. The dataset can be a raster or feature class.</p><ul><li>Current Display Extent—The extent will be based on the active map or scene.</li><li>Draw Extent—The extent will be based on a rectangle drawn on the map or scene.</li><li>Extent of a Layer—The extent will be based on an active map layer. Choose an available layer or use the <span class=\"esri_uicontrol\">Extent of data in all layers</span> option. Each map layer has the following options:<p><ul><li>All Features—The extent of all features.</li><li>Selected Features —The extent of the selected features.</li><li>Visible Features—The extent of visible features.</li></ul></p></li><li>Browse—The extent will be based on a dataset.</li><li>Clipboard—The extent can be copied to and from the clipboard.<ul><li>Copy Extent—Copies the extent and coordinate system to the clipboard.</li><li>Paste Extent—Pastes the extent and coordinate system from the clipboard. If the clipboard does not include a coordinate system, the extent will use the map’s coordinate system.</li></ul></li><li>Reset Extent—The extent will be reset to the default value.</li></ul><p>When coordinates are manually provided, the coordinates must be numeric values and in the active map&apos;s coordinate system. The map may use different display units than the provided coordinates. Use a negative value sign for south and west coordinates.</p></xdoc>",
        "template_extent.title": "Template Extent",
        "tile_size.descr": "<xdoc><p>The x and y dimensions of the output tiles. The default unit of measurement is in pixels. You can change this with the <span class=\"esri_uicontrol\">Units for Output Raster Size and Overlap</span> parameter. The <span class=\"esri_uicontrol\">X coordinate</span> is the X (horizontal) dimension the output tiles and the <span class=\"esri_uicontrol\">Y coordinate</span> is the Y (vertical) dimension of output tiles.</p></xdoc>",
        "tile_size.title": "Size of Output Rasters",
        "title": "Split Raster",
        "units.descr": "<xdoc><p>Set the units of measurement for the <span class=\"esri_uicontrol\">Size of Output Rasters</span> parameter and the <span class=\"esri_uicontrol\">Overlap</span> parameter.</p><ul><li><span title=\"PIXELS\">Pixels</span>—The unit is in pixels. This is the default.</li><li><span title=\"METERS\">Meters</span>—The unit is in meters.</li><li><span title=\"FEET\">Feet</span>—The unit is in feet.</li><li><span title=\"DEGREES\">Degrees</span>—The unit is in decimal degrees.</li><li><span title=\"MILES\">Miles</span>—The unit is in miles.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The unit is in kilometers.</li></ul></xdoc>",
        "units.domain.DEGREES": "Degrees",
        "units.domain.FEET": "Feet",
        "units.domain.KILOMETERS": "Kilometers",
        "units.domain.METERS": "Meters",
        "units.domain.MILES": "Miles",
        "units.domain.PIXELS": "Pixels",
        "units.title": "Units for Output Raster Size and Overlap"
    }
}
