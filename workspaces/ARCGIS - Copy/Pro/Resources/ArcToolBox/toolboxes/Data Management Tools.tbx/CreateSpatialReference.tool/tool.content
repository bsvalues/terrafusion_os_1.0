{
    "type": "FunctionTool",
    "guid": "{f786ba18-fd99-454b-a08d-3fd73404e9ad}",
    "displayname": "$rc:title",
    "helpcontent": "3120003",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "param_nocount:spatial_reference_template"
    ],
    "params": {
        "spatial_reference": {
            "type": "optional",
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:spatial_reference.descr"
        },
        "spatial_reference_template": {
            "type": "optional",
            "displayname": "$rc:spatial_reference_template.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPFeatureLayer"
                    },
                    {
                        "type": "DERasterDataset"
                    }
                ]
            },
            "description": "$rc:spatial_reference_template.descr"
        },
        "xy_domain": {
            "type": "optional",
            "displayname": "$rc:xy_domain.title",
            "datatype": {
                "type": "GPEnvelope"
            },
            "description": "$rc:xy_domain.descr"
        },
        "z_domain": {
            "type": "optional",
            "displayname": "$rc:z_domain.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:z_domain.descr"
        },
        "m_domain": {
            "type": "optional",
            "displayname": "$rc:m_domain.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:m_domain.descr"
        },
        "template": {
            "type": "optional",
            "displayname": "$rc:template.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "description": "$rc:template.descr"
        },
        "expand_ratio": {
            "type": "optional",
            "displayname": "$rc:expand_ratio.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0",
            "description": "$rc:expand_ratio.descr"
        },
        "out_spatial_reference": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            }
        }
    }
}
