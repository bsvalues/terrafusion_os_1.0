                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "description": "$rc:in_dataset.descr"
        },
        "out_mosaic_dataset": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_mosaic_dataset.title",
            "datatype": {
                "type": "DEMosaicDataset"
            },
            "description": "$rc:out_mosaic_dataset.descr"
        },
