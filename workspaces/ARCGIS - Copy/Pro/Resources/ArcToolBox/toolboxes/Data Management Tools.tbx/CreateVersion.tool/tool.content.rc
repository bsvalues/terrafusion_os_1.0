{
    "map": {
        "access_permission.descr": "<xdoc><p>Specifies the permission access level for the version to protect it from being edited or viewed by users other than the owner.</p><ul><li><span title=\"PRIVATE\">Private (owner only)</span>—Only the owner or the geodatabase administrator can view and modify the version or versioned data. This is the default.</li><li><span title=\"PUBLIC\">Public (any user)</span>—Any user can view the version. Any user who has been granted read/write (update, insert, and delete) permissions on datasets can modify datasets in the version.</li><li><span title=\"PROTECTED\">Protected (only the owner can edit)</span>—Any user can view the version, but only the owner or the geodatabase administrator can edit the version or datasets in the version.</li></ul></xdoc>",
        "access_permission.domain.PRIVATE": "Private (owner  only)",
        "access_permission.domain.PROTECTED": "Protected (only the owner can edit)",
        "access_permission.domain.PUBLIC": "Public (any user)",
        "access_permission.title": "Access Permission",
        "description": "Creates a new version in a specified geodatabase or feature service.",
        "in_workspace.descr": "<xdoc><p>The enterprise geodatabase that contains the parent version and will contain the new version.</p><p>For branch versioning, use a feature service URL (for example, https://mysite.mydomain/server/rest/services/ElectricNetwork/FeatureServer).</p></xdoc>",
        "in_workspace.title": "Input Workspace",
        "out_workspace.title": "Updated Input Workspace",
        "parent_version.descr": "The geodatabase, or version of a geodatabase, on which the new version will be based.",
        "parent_version.title": "Parent Version",
        "title": "Create Version",
        "version_description.descr": "The description of the version that will be created. The description cannot exceed 64 characters.",
        "version_description.title": "Version Description",
        "version_name.descr": "The name of the version that will be created.",
        "version_name.title": "Version Name"
    }
}
