{
    "type": "FunctionTool",
    "guid": "{26fa7827-f61c-4b18-b146-b6af3e7be288}",
    "displayname": "$rc:title",
    "helpcontent": "3030010",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_workspace": {
            "displayname": "$rc:in_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:in_workspace.descr"
        },
        "domain_name": {
            "displayname": "$rc:domain_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:domain_name.descr"
        },
        "sort_by": {
            "displayname": "$rc:sort_by.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "CODE",
                        "code": "$rc:sort_by.domain.CODE"
                    },
                    {
                        "value": "DESCRIPTION",
                        "code": "$rc:sort_by.domain.DESCRIPTION"
                    }
                ]
            },
            "value": "CODE",
            "description": "$rc:sort_by.descr"
        },
        "sort_order": {
            "displayname": "$rc:sort_order.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ASCENDING",
                        "code": "$rc:sort_order.domain.ASCENDING"
                    },
                    {
                        "value": "DESCENDING",
                        "code": "$rc:sort_order.domain.DESCENDING"
                    }
                ]
            },
            "value": "ASCENDING",
            "description": "$rc:sort_order.descr"
        },
        "out_workspace": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "depends": [
                "in_workspace"
            ]
        }
    },
    "environments": [
        "workspace"
    ]
}
