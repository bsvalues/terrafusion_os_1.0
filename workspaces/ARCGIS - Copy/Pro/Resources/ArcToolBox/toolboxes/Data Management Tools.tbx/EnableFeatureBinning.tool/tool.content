{
    "type": "FunctionTool",
    "guid": "{71a0a388-47c7-4c75-a738-0fdde3cdfe5d}",
    "displayname": "$rc:title",
    "helpcontent": "3350002",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Multipoint",
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "bin_type": {
            "type": "optional",
            "displayname": "$rc:bin_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FLAT_HEXAGON",
                        "code": "$rc:bin_type.domain.FLAT_HEXAGON"
                    },
                    {
                        "value": "POINTY_HEXAGON",
                        "code": "$rc:bin_type.domain.POINTY_HEXAGON"
                    },
                    {
                        "value": "SQUARE",
                        "code": "$rc:bin_type.domain.SQUARE"
                    },
                    {
                        "value": "GEOHASH",
                        "code": "$rc:bin_type.domain.GEOHASH"
                    }
                ]
            },
            "description": "$rc:bin_type.descr"
        },
        "bin_coord_sys": {
            "type": "optional",
            "displayname": "$rc:bin_coord_sys.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPCoordinateSystem"
                }
            },
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:bin_coord_sys.descr"
        },
        "summary_stats": {
            "type": "optional",
            "displayname": "$rc:summary_stats.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:summary_stats.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:summary_stats.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double",
                            "BigInteger"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "SUM",
                                "code": "$rc:summary_stats.domain.item2.SUM"
                            },
                            {
                                "value": "AVG",
                                "code": "$rc:summary_stats.domain.item2.AVG"
                            },
                            {
                                "value": "MIN",
                                "code": "$rc:summary_stats.domain.item2.MIN"
                            },
                            {
                                "value": "MAX",
                                "code": "$rc:summary_stats.domain.item2.MAX"
                            },
                            {
                                "value": "STDDEV",
                                "code": "$rc:summary_stats.domain.item2.STDDEV"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:summary_stats.descr"
        },
        "generate_static_cache": {
            "type": "optional",
            "displayname": "$rc:generate_static_cache.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "STATIC_CACHE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DYNAMIC"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:generate_static_cache.descr"
        },
        "out_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_features"
            ]
        }
    }
}
