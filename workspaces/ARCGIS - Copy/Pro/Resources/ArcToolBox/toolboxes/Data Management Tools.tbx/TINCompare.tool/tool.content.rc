        "compare_status.title": "Compare Status",
        "compare_type.descr": "<xdoc><p>The comparison type.</p><ul><li><span title=\"ALL\">All</span>—This is the default.</li><li><span title=\"PROPERTIES_ONLY\">Properties only</span>—Refers to both geometry and TIN tag values, if any, that are assigned to nodes and triangles.</li><li><span title=\"SPATIAL_REFERENCE_ONLY\">Spatial Reference only</span>—Coordinate system information.</li></ul></xdoc>",
