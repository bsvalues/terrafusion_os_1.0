{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3330003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "in_features"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "interval": {
            "displayname": "$rc:interval.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:interval.descr"
        },
        "transect_length": {
            "displayname": "$rc:transect_length.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:transect_length.descr"
        },
        "include_ends": {
            "type": "optional",
            "displayname": "$rc:include_ends.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "END_POINTS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_END_POINTS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:include_ends.descr"
        }
    },
    "environments": [
        "workspace"
    ]
}
