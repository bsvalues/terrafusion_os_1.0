{
    "map": {
        "authorization_file.descr": "<xdoc><p>The keycodes file that was created when ArcGIS Server was authorized. If you have not done so, authorize ArcGIS Server to create this file.</p><p>This file is in the &lt;drive&gt;\\Program Files\\ESRI\\License&lt;release#&gt;\\sysgen folder on Windows or the /arcgis/server/framework/runtime/.wine/drive_c/Program Files/ESRI/License&lt;release#&gt;/sysgen directory on Linux. <note type=\"tip\"/><p group=\"note\">The /.wine directory is a hidden directory.</p></p><p>You may need to copy the keycodes file from the ArcGIS Server machine to a location that is accessible to the tool.</p></xdoc>",
        "authorization_file.title": "Authorization File",
        "description": "Creates geodatabase system tables, stored procedures, functions, and types in an existing database, which enable geodatabase functionality in the database.",
        "input_database.descr": "The path and database connection file (.sde) name for the database in which geodatabase functionality will be enabled. The database connection must connect as a user that qualifies as a geodatabase administrator.",
        "input_database.title": "Input Database Connection",
        "out_workspace.title": "Output Workspace",
        "title": "Enable Enterprise Geodatabase"
    }
}
