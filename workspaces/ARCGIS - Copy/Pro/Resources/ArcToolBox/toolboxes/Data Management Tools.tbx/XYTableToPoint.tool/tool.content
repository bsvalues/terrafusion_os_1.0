{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3050007",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_table": {
            "displayname": "$rc:in_table.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:in_table.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "in_table"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "x_field": {
            "displayname": "$rc:x_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "in_table"
            ],
            "description": "$rc:x_field.descr"
        },
        "y_field": {
            "displayname": "$rc:y_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "in_table"
            ],
            "description": "$rc:y_field.descr"
        },
        "z_field": {
            "type": "optional",
            "displayname": "$rc:z_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "in_table"
            ],
            "description": "$rc:z_field.descr"
        },
        "coordinate_system": {
            "type": "optional",
            "displayname": "$rc:coordinate_system.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "description": "$rc:coordinate_system.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
