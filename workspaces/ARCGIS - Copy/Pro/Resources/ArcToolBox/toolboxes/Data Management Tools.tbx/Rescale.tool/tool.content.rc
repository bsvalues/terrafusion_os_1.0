{
    "map": {
        "description": "Resizes a raster by the specified x and y scale factors.",
        "in_raster.descr": "The input raster.",
        "in_raster.title": "Input Raster",
        "out_raster.descr": "<xdoc><p>The output raster dataset.</p><p>When storing the raster dataset in a file format, specify the file extension as follows:</p><ul><li>.bil—Esri BIL</li><li>.bip—Esri BIP</li><li>.bmp—BMP</li><li>.bsq—Esri BSQ</li><li>.dat—ENVI DAT</li><li>.gif—GIF</li><li>.img—ERDAS IMAGINE</li><li>.jpg—JPEG</li><li>.jp2—JPEG 2000</li><li>.png—PNG</li><li>.tif—TIFF</li><li>.mrf—MRF</li><li>.crf—CRF</li><li>No extension for Esri Grid</li></ul><p>When storing a raster dataset in a geodatabase, do not add a file extension to the name of the raster dataset.</p><p>When storing a raster dataset to a JPEG format file, a JPEG 2000 format file, a TIFF format file, or a geodatabase, you can specify <span class=\"esri_uicontrol\">Compression Type</span> and <span class=\"esri_uicontrol\">Compression Quality</span> values in the geoprocessing environments.</p></xdoc>",
        "out_raster.title": "Output Raster Dataset",
        "title": "Rescale",
        "x_scale.descr": "<xdoc><p>The factor by which to scale the cell size in the x direction.</p><p>The factor must be greater than zero.</p></xdoc>",
        "x_scale.title": "X Scale Factor",
        "y_scale.descr": "<xdoc><p>The factor by which to scale the cell size in the y direction.</p><p>The factor must be greater than zero.</p></xdoc>",
        "y_scale.title": "Y Scale Factor"
    }
}
