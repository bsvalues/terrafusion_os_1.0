    "product": "100",
    "params": {
        "in_dataset": {
            "display_order": "0",
            "displayname": "$rc:in_dataset.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPMosaicLayer"
                    },
                    {
                        "type": "GPMap"
                    }
                ]
            },
            "description": "$rc:in_dataset.descr"
        },
        "out_tiling_scheme": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_tiling_scheme.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xml"
                ]
            },
            "description": "$rc:out_tiling_scheme.descr"
        },
        "tiling_scheme_generation_method": {
            "display_order": "2",
