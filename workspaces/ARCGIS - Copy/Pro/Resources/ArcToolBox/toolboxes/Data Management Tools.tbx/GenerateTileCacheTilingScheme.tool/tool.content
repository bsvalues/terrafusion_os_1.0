                    {
                        "type": "GPDouble",
                        "displayname": "$rc:scales.dt.title1"
                    }
                ]
            },
            "description": "$rc:scales.descr"
        },
        "scales_type": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:scales_type.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CELL_SIZE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "SCALE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:scales_type.descr"
        },
        "tile_origin": {
            "type": "optional",
