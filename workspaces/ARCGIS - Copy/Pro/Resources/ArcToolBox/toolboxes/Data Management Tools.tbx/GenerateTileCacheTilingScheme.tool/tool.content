            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "128 x 128",
                        "code": "$rc:tile_size.domain.128 x 128"
                    },
                    {
                        "value": "256 x 256",
                        "code": "$rc:tile_size.domain.256 x 256"
                    },
                    {
                        "value": "512 x 512",
                        "code": "$rc:tile_size.domain.512 x 512"
                    },
