            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PNG",
                        "code": "$rc:tile_format.domain.PNG"
                    },
                    {
                        "value": "PNG8",
                        "code": "$rc:tile_format.domain.PNG8"
                    },
                    {
                        "value": "PNG24",
                        "code": "$rc:tile_format.domain.PNG24"
                    },
                    {
