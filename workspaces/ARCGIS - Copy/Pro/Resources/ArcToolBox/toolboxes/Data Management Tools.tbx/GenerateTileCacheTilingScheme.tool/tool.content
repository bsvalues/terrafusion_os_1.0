            "displayname": "$rc:tiling_scheme_generation_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NEW",
                        "code": "$rc:tiling_scheme_generation_method.domain.NEW"
                    },
                    {
                        "value": "PREDEFINED",
                        "code": "$rc:tiling_scheme_generation_method.domain.PREDEFINED"
                    }
                ]
            },
            "value": "NEW",
            "description": "$rc:tiling_scheme_generation_method.descr"
        },
        "number_of_scales": {
            "display_order": "4",
            "displayname": "$rc:number_of_scales.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:number_of_scales.descr"
        },
        "predefined_tiling_scheme": {
            "enabled": "false",
