                        "code": "$rc:tile_format.domain.PNG32"
                    },
                    {
                        "value": "JPEG",
                        "code": "$rc:tile_format.domain.JPEG"
                    },
                    {
                        "value": "MIXED",
                        "code": "$rc:tile_format.domain.MIXED"
                    },
                    {
