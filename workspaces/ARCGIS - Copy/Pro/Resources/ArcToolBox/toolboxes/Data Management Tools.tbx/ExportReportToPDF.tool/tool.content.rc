{
    "map": {
        "compress_vector_graphics.descr": "<xdoc><p>Specifies whether to compress the vector content streams in the PDF.</p><p><ul><li>Checked—Vector graphics will be compressed. This option should be set unless clear text is desired for troubleshooting. This is the default.</li><li>Unchecked—Vector graphics will not be compressed.</li></ul></p></xdoc>",
        "compress_vector_graphics.title": "Compress Vector Graphics",
        "custom_page_range.descr": "<xdoc><p>The pages to be exported when the <span class=\"esri_uicontrol\">Page Range Type</span> parameter is set to <span class=\"esri_uicontrol\">Custom</span>. You can set individual pages, ranges, or a combination of both separated by commas, such as 1, 3-5, 10.</p></xdoc>",
        "custom_page_range.title": "Custom Page Range",
        "description": "Exports an ArcGIS Pro report to a PDF file.",
        "embed_font.descr": "<xdoc><p>Specifies whether fonts are embedded in the output report. Font embedding allows text and markers built from font glyphs to be displayed correctly when the PDF is viewed on a computer that does not have the necessary fonts installed.</p><ul><li>Checked—Fonts will be embedded in the output report. This is the default.</li><li>Unchecked—Fonts will not be embedded in the output report.</li></ul></xdoc>",
        "embed_font.title": "Embed Fonts",
        "expression.descr": "An SQL expression used to select a subset of records. This expression is applied in addition to any existing expressions.",
        "expression.title": "Expression",
        "final_page_number.descr": "The page number to display on the last page of the exported PDF.",
        "final_page_number.title": "Final Page Number",
        "image_compression.descr": "<xdoc><p>Specifies the compression scheme used to compress image or raster data in the output PDF file.</p><ul><li><span title=\"NONE\">No image compression</span>—Do not compress image or raster data.</li><li><span title=\"RLE\">Run-length encoded (RLE) compression</span>—Uses Run-length encoded compression.</li><li><span title=\"DEFLATE\">Deflate compression</span>—Uses Deflate, a lossless data compression.</li><li><span title=\"LZW\">Lempel-Ziv-Welch (LZW) compression</span>—Uses Lempel-Ziv-Welch, a lossless data compression.</li><li><span title=\"JPEG\">Joint Photographic Experts Group (JPEG) compression</span>—Uses JPEG, a lossy data compression.</li><li><span title=\"ADAPTIVE\">Adaptive compression</span>—Uses Adaptive, which automatically selects the best compression type for each image on the page. JPEG will be used for large images with many unique colors. Deflate will be used for all other images. This is the default.</li></ul></xdoc>",
        "image_compression.domain.ADAPTIVE": "Adaptive compression",
        "image_compression.domain.DEFLATE": "Deflate compression",
        "image_compression.domain.JPEG": "Joint Photographic Experts Group (JPEG) compression",
        "image_compression.domain.LZW": "Lempel-Ziv-Welch (LZW) compression",
        "image_compression.domain.NONE": "No image compression",
        "image_compression.domain.RLE": "Run-length encoded (RLE) compression",
        "image_compression.title": "Image Compression",
        "image_quality.descr": "<xdoc><p>Specifies the output image quality of the PDF. The image quality option controls the quality of rasterized data going into the export.</p><ul><li><span title=\"BEST\">Best</span>—The highest available image quality. This is the default.</li><li><span title=\"BETTER\">Better</span>—High image quality.</li><li><span title=\"NORMAL\">Normal</span>—A compromise between image quality and speed.</li><li><span title=\"FASTER\">Faster</span>—Lower image quality to generate the report faster.</li><li><span title=\"FASTEST\">Fastest</span>—The lowest image quality to create the report the fastest.</li></ul></xdoc>",
        "image_quality.domain.BEST": "Best",
        "image_quality.domain.BETTER": "Better",
        "image_quality.domain.FASTER": "Faster",
        "image_quality.domain.FASTEST": "Fastest",
        "image_quality.domain.NORMAL": "Normal",
        "image_quality.title": "Image Quality",
        "in_report.descr": "The input report or .rptx file.",
        "in_report.title": "Input Report",
        "initial_page_number.descr": "The initial page number of the report to create a page numbering offset to add additional pages to the beginning of the report.",
        "initial_page_number.title": "Initial Page Number",
        "out_pdf_file.descr": "The output PDF file.",
        "out_pdf_file.title": "PDF File",
        "page_range_type.descr": "<xdoc><p>Specifies the page range of the report to export.</p><ul><li><span title=\"ALL\">All pages</span>—Export all pages. This is the default.</li><li><span title=\"LAST\">Last page</span>—Export the last page only.</li><li><span title=\"ODD\">Odd numbered pages</span>—Export the odd numbered pages.</li><li><span title=\"EVEN\">Even numbered pages</span>—Export the even numbered pages.</li><li><span title=\"CUSTOM\">Custom page range</span>—Export a custom page range.</li></ul></xdoc>",
        "page_range_type.domain.ALL": "All pages",
        "page_range_type.domain.CUSTOM": "Custom page range",
        "page_range_type.domain.EVEN": "Even numbered pages",
        "page_range_type.domain.LAST": "Last page",
        "page_range_type.domain.ODD": "Odd numbered pages",
        "page_range_type.title": "Page Range Type",
        "params.category1": "Data Definition",
        "params.category2": "Export Options",
        "params.category3": "Page Range Options",
        "password_protect.descr": "<xdoc><p>Specifies whether password protection is needed to view the output PDF report.</p><p><ul><li>Checked—The output PDF report document will require a password to open.</li><li>Unchecked—The output PDF report document can be opened without providing a password. This is the default.</li></ul></p></xdoc>",
        "password_protect.title": "Password Protect",
        "pdf_password.descr": "A password to restrict opening the PDF.",
        "pdf_password.title": "PDF Password",
        "resolution.descr": "The resolution of the exported PDF in dots per inch (dpi).",
        "resolution.title": "Resolution (DPI)",
        "summary": "<xdoc><p>Exports an ArcGIS Pro report to a PDF file.</p><p>Learn more about reports and how to add, modify and share them.</p></xdoc>",
        "title": "Export Report To PDF"
    }
}
