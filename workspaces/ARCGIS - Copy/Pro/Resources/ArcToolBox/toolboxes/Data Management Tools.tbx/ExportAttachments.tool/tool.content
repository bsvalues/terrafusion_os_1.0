{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3280008",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_dataset": {
            "displayname": "$rc:in_dataset.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:in_dataset.descr"
        },
        "out_location": {
            "displayname": "$rc:out_location.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:out_location.descr"
        },
        "subdirectory_field": {
            "type": "optional",
            "displayname": "$rc:subdirectory_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Text",
                    "Date",
                    "OID",
                    "TimeOnly",
                    "DateOnly",
                    "TimestampOffset",
                    "GUID",
                    "GlobalID"
                ]
            },
            "depends": [
                "in_dataset"
            ],
            "description": "$rc:subdirectory_field.descr"
        },
        "name_format": {
            "type": "optional",
            "displayname": "$rc:name_format.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ORIGINAL",
                        "code": "$rc:name_format.domain.ORIGINAL"
                    },
                    {
                        "value": "REPLACE",
                        "code": "$rc:name_format.domain.REPLACE"
                    },
                    {
                        "value": "PREFIX",
                        "code": "$rc:name_format.domain.PREFIX"
                    },
                    {
                        "value": "SUFFIX",
                        "code": "$rc:name_format.domain.SUFFIX"
                    }
                ]
            },
            "value": "ORIGINAL",
            "description": "$rc:name_format.descr"
        },
        "name_fields": {
            "type": "optional",
            "displayname": "$rc:name_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Text",
                    "Date",
                    "OID",
                    "TimeOnly",
                    "DateOnly",
                    "TimestampOffset",
                    "GUID",
                    "GlobalID"
                ]
            },
            "depends": [
                "in_dataset"
            ],
            "description": "$rc:name_fields.descr"
        },
        "out_dirs": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_dirs.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "DEFolder"
                }
            },
            "schema": {
                "type": "GPContainerSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    }
}
