        },
        "compression_method": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:compression_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NONE",
                        "code": "$rc:compression_method.domain.NONE"
                    },
                    {
