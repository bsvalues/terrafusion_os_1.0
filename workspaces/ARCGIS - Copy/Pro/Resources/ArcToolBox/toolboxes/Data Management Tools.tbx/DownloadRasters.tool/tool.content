            "displayname": "$rc:selection_feature.title",
            "datatype": {
                "type": "GPExtent"
            },
            "description": "$rc:selection_feature.descr"
        },
        "clipping": {
            "type": "optional",
            "displayname": "$rc:clipping.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CLIPPING"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_CLIPPING"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:clipping.descr"
        },
        "convert_rasters": {
            "type": "optional",
            "displayname": "$rc:convert_rasters.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ALWAYS_CONVERT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "CONVERT_AS_REQUIRED"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:convert_rasters.descr"
        },
        "format": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:format.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TIFF",
                        "code": "$rc:format.domain.TIFF"
                    },
                    {
                        "value": "BIL",
                        "code": "$rc:format.domain.BIL"
                    },
                    {
                        "value": "BSQ",
