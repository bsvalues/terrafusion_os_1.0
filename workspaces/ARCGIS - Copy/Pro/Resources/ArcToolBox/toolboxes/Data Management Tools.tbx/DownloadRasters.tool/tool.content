                    },
                    {
                        "value": "BIP",
                        "code": "$rc:format.domain.BIP"
                    },
                    {
                        "value": "BMP",
                        "code": "$rc:format.domain.BMP"
                    },
                    {
                        "value": "ENVI",
                        "code": "$rc:format.domain.ENVI"
                    },
                    {
                        "value": "IMAGINE Image",
                        "code": "$rc:format.domain.IMAGINE Image"
                    },
                    {
                        "value": "JPEG",
                        "code": "$rc:format.domain.JPEG"
                    },
                    {
                        "value": "GIF",
                        "code": "$rc:format.domain.GIF"
                    },
                    {
                        "value": "JP2",
                        "code": "$rc:format.domain.JP2"
                    },
                    {
                        "value": "PNG",
                        "code": "$rc:format.domain.PNG"
                    }
                ]
            },
            "value": "TIFF",
