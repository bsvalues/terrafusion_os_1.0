                    },
                    {
                        "type": "GPString"
                    },
                    {
                        "type": "GPMosaicLayer"
                    },
                    {
                        "type": "GPRasterLayer"
                    }
                ]
            },
            "description": "$rc:in_image_service.descr"
        },
        "out_folder": {
            "displayname": "$rc:out_folder.title",
