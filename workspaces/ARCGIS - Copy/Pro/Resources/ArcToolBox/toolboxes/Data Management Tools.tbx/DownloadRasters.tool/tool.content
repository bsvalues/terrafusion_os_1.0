        "MAINTAIN_FOLDER": {
            "type": "optional",
            "displayname": "$rc:maintain_folder.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "MAINTAIN_FOLDER"
                    },
                    {
                        "type": "GPBoolean",
