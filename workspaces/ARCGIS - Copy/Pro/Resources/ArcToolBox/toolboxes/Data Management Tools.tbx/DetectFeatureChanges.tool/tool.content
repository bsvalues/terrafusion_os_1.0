                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:match_fields.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text",
                    "Date",
                    "Blob",
                    "Raster",
                    "XML",
                    "GUID",
                    "OID"
                ],
                "exclude.field": [
                    "SHAPE_Length",
                    "SHAPE_Area"
                ]
            },
            "depends": [
