    "map": {
        "clear_value.descr": "<xdoc><p>Specifies whether to clear the subtype field.</p><ul><li>Checked—The subtype field will be cleared (set to null).</li><li>Unchecked—The subtype field will not be cleared. This is the default.</li></ul></xdoc>",
        "clear_value.title": "Clear Value",
        "description": "Defines the field in the input table or feature class that stores the subtype codes.",
        "field.descr": "The integer field that will store the subtype codes.",
        "field.title": "Field Name",
        "in_table.descr": "The input table or feature class that contains the field to set as a subtype field.",
        "in_table.title": "Input Table",
        "out_table.title": "Updated Input Table",
        "title": "Set Subtype Field"
    }
