{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "53020002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "inputLayer": {
            "displayname": "$rc:inputlayer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "description": "$rc:inputlayer.descr"
        },
        "mergeLayer": {
            "displayname": "$rc:mergelayer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "description": "$rc:mergelayer.descr"
        },
        "outputName": {
            "displayname": "$rc:outputname.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:outputname.descr"
        },
        "mergingAttributes": {
            "type": "optional",
            "displayname": "$rc:mergingattributes.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:mergingattributes.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:mergingattributes.dt.title2"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:mergingattributes.dt.title3"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double",
                            "Text",
                            "Date",
                            "OID",
                            "Geometry",
                            "Blob",
                            "Raster",
                            "GUID",
                            "GlobalID",
                            "XML"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "REMOVE",
                                "code": "$rc:mergingattributes.domain.item2.REMOVE"
                            },
                            {
                                "value": "RENAME",
                                "code": "$rc:mergingattributes.domain.item2.RENAME"
                            },
                            {
                                "value": "MATCH",
                                "code": "$rc:mergingattributes.domain.item2.MATCH"
                            }
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain"
                    }
                ]
            },
            "depends": [
                "mergeLayer"
            ],
            "description": "$rc:mergingattributes.descr"
        },
        "output": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "extent"
    ]
}
