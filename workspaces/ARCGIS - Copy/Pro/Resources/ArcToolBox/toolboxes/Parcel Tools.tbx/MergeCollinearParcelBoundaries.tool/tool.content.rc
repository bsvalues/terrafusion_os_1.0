{
    "map": {
        "description": "Merges connected collinear parcel lines into a single parcel line. Shared parcel fabric points between connected collinear lines are deleted and vertices are created in their place.",
        "in_parcel_boundaries.descr": "The parcel lines to be merged. Lines can be parcel lines or connection lines.",
        "in_parcel_boundaries.title": "Input Parcel Boundaries",
        "offset_tolerance.descr": "The maximum distance that parcel points between collinear lines can be offset for the line to be considered collinear. The offset is the distance between the collinear parcel points and the straight lines between the endpoints of the connected parcel lines.",
        "offset_tolerance.title": "Offset Tolerance",
        "out_parcel_boundaries.title": "Updated Parcel Boundaries",
        "summary": "<xdoc><p>Merges connected collinear parcel lines into a single parcel line. Shared parcel fabric points between connected collinear lines are deleted and vertices are created in their place.</p><p>Pairs of connected parcel lines are considered collinear if their shared parcel fabric points lie within the specified orthogonal offset tolerance of a line drawn between the line endpoints. Similarly, pairs of connected parcel curves are considered collinear if their shared parcel fabric points lie within the specified orthogonal offset tolerance of a curved line drawn between the line endpoints.</p></xdoc>",
        "title": "Merge Collinear Parcel Boundaries"
    }
}
