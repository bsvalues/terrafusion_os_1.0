{
    "type": "FunctionTool",
    "guid": "{D503DFB4-76F6-4A44-9EC3-C911FB5B11FA}/GenerateParcelFabricLinks",
    "displayname": "$rc:title",
    "helpcontent": "52000005",
    "description": "$rc:description",
    "product": "200",
    "params": {
        "target_parcel_fabric": {
            "display_order": "0",
            "displayname": "$rc:target_parcel_fabric.title",
            "datatype": {
                "type": "GPParcelLayer"
            },
            "description": "$rc:target_parcel_fabric.descr"
        },
        "out_links_feature_class": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_links_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Line"
                ]
            },
            "symbologylayer": "ParcelFabricLinks.lyrx",
            "description": "$rc:out_links_feature_class.descr"
        },
        "out_anchor_points_feature_class": {
            "direction": "out",
            "display_order": "2",
            "displayname": "$rc:out_anchor_points_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ]
            },
            "symbologylayer": "ParcelFabricAnchorPoints.lyrx",
            "description": "$rc:out_anchor_points_feature_class.descr"
        },
        "from_date": {
            "display_order": "5",
            "displayname": "$rc:from_date.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:from_date.descr"
        },
        "to_date": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:to_date.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:to_date.descr"
        },
        "min_link_length": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:min_link_length.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "value": "0.01 Meters",
            "description": "$rc:min_link_length.descr"
        },
        "extent": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:extent.title",
            "datatype": {
                "type": "GPExtent"
            },
            "description": "$rc:extent.descr"
        }
    }
}
