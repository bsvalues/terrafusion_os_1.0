{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\FillMissingValues",
    "displayname": "$rc:title",
    "helpcontent": "50010003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:in_features.descr"
        },
        "out_features": {
            "type": "optional",
            "direction": "out",
            "display_order": "2",
            "displayname": "$rc:out_features.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEFeatureClass"
                    },
                    {
                        "type": "DETable"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "depends": [
                "append_to_input"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_features.descr"
        },
        "fields_to_fill": {
            "display_order": "7",
            "displayname": "$rc:fields_to_fill.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Double",
                    "Long",
                    "Float",
                    "Short",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:fields_to_fill.descr"
        },
        "fill_method": {
            "display_order": "8",
            "displayname": "$rc:fill_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "MINIMUM",
                        "code": "$rc:fill_method.domain.MINIMUM"
                    },
                    {
                        "value": "AVERAGE",
                        "code": "$rc:fill_method.domain.AVERAGE"
                    },
                    {
                        "value": "MEDIAN",
                        "code": "$rc:fill_method.domain.MEDIAN"
                    },
                    {
                        "value": "MAXIMUM",
                        "code": "$rc:fill_method.domain.MAXIMUM"
                    },
                    {
                        "value": "TEMPORAL_TREND",
                        "code": "$rc:fill_method.domain.TEMPORAL_TREND"
                    }
                ]
            },
            "description": "$rc:fill_method.descr"
        },
        "conceptualization_of_spatial_relationships": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:conceptualization_of_spatial_relationships.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FIXED_DISTANCE",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.FIXED_DISTANCE"
                    },
                    {
                        "value": "K_NEAREST_NEIGHBORS",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.K_NEAREST_NEIGHBORS"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_ONLY",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.CONTIGUITY_EDGES_ONLY"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_CORNERS",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.CONTIGUITY_EDGES_CORNERS"
                    },
                    {
                        "value": "GET_SPATIAL_WEIGHTS_FROM_FILE",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.GET_SPATIAL_WEIGHTS_FROM_FILE"
                    }
                ]
            },
            "description": "$rc:conceptualization_of_spatial_relationships.descr"
        },
        "distance_band": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:distance_band.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Meters",
                    "Kilometers",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:distance_band.descr"
        },
        "temporal_neighborhood": {
            "type": "optional",
            "display_order": "11",
            "displayname": "$rc:temporal_neighborhood.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:temporal_neighborhood.descr"
        },
        "time_field": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:time_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Date"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:time_field.descr"
        },
        "number_of_spatial_neighbors": {
            "type": "optional",
            "display_order": "12",
            "displayname": "$rc:number_of_spatial_neighbors.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:number_of_spatial_neighbors.descr"
        },
        "location_id": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:location_id.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short",
                    "Text",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:location_id.descr"
        },
        "related_table": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:related_table.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:related_table.descr"
        },
        "related_location_id": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:related_location_id.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short",
                    "Text",
                    "BigInteger"
                ]
            },
            "description": "$rc:related_location_id.descr"
        },
        "weights_matrix_file": {
            "type": "optional",
            "display_order": "13",
            "displayname": "$rc:weights_matrix_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "swm"
                ]
            },
            "description": "$rc:weights_matrix_file.descr"
        },
        "unique_id": {
            "type": "optional",
            "display_order": "14",
            "displayname": "$rc:unique_id.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:unique_id.descr"
        },
        "null_value": {
            "type": "optional",
            "display_order": "15",
            "displayname": "$rc:null_value.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:null_value.descr"
        },
        "out_table": {
            "type": "optional",
            "direction": "out",
            "display_order": "16",
            "displayname": "$rc:out_table.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_table.descr"
        },
        "append_to_input": {
            "type": "optional",
            "display_order": "1",
            "displayname": "$rc:append_to_input.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "APPEND_TO_INPUT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NEW_FEATURES"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:append_to_input.descr"
        },
        "updated_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_features.title",
            "datatype": {
                "type": "GPTableView"
            },
            "depends": [
                "in_features"
            ],
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "geographicTransformations",
        "outputCoordinateSystem"
    ]
}
