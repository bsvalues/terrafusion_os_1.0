{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\EvaluateForecastsByLocation",
    "displayname": "$rc:title",
    "helpcontent": "50020004",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_cubes": {
            "displayname": "$rc:in_cubes.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "DEFile"
                }
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "nc"
                ]
            },
            "description": "$rc:in_cubes.descr"
        },
        "output_features": {
            "direction": "out",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "in_cubes"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "output_cube": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:output_cube.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "nc"
                ]
            },
            "description": "$rc:output_cube.descr"
        },
        "evaluate_using_validation_results": {
            "type": "optional",
            "displayname": "$rc:evaluate_using_validation_results.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "USE_VALIDATION"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_VALIDATION"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:evaluate_using_validation_results.descr"
        }
    },
    "environments": [
        "outputCoordinateSystem",
        "workspace"
    ]
}
