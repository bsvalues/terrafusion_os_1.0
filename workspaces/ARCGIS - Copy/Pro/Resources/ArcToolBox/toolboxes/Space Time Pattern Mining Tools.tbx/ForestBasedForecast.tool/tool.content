{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\ForestBasedForecast",
    "displayname": "$rc:title",
    "helpcontent": "50020003",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_cube": {
            "display_order": "0",
            "displayname": "$rc:in_cube.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "nc"
                ]
            },
            "description": "$rc:in_cube.descr"
        },
        "analysis_variable": {
            "display_order": "1",
            "displayname": "$rc:analysis_variable.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:analysis_variable.descr"
        },
        "output_features": {
            "direction": "out",
            "display_order": "3",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "in_cube"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "output_cube": {
            "type": "optional",
            "direction": "out",
            "display_order": "4",
            "displayname": "$rc:output_cube.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "nc"
                ]
            },
            "description": "$rc:output_cube.descr"
        },
        "number_of_time_steps_to_forecast": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:number_of_time_steps_to_forecast.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "1",
            "description": "$rc:number_of_time_steps_to_forecast.descr"
        },
        "time_window": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:time_window.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:time_window.descr"
        },
        "number_for_validation": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:number_for_validation.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:number_for_validation.descr"
        },
        "number_of_trees": {
            "type": "optional",
            "display_order": "12",
            "displayname": "$rc:number_of_trees.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1",
                "max": "1000"
            },
            "value": "100",
            "description": "$rc:number_of_trees.descr"
        },
        "minimum_leaf_size": {
            "type": "optional",
            "display_order": "13",
            "displayname": "$rc:minimum_leaf_size.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1",
                "max": "10000000"
            },
            "description": "$rc:minimum_leaf_size.descr"
        },
        "maximum_depth": {
            "type": "optional",
            "display_order": "14",
            "displayname": "$rc:maximum_depth.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1",
                "max": "100000000"
            },
            "description": "$rc:maximum_depth.descr"
        },
        "sample_size": {
            "type": "optional",
            "display_order": "15",
            "displayname": "$rc:sample_size.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1",
                "max": "100"
            },
            "value": "100",
            "description": "$rc:sample_size.descr"
        },
        "forecast_approach": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:forecast_approach.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "VALUE",
                        "code": "$rc:forecast_approach.domain.VALUE"
                    },
                    {
                        "value": "VALUE_DETREND",
                        "code": "$rc:forecast_approach.domain.VALUE_DETREND"
                    },
                    {
                        "value": "RESIDUAL",
                        "code": "$rc:forecast_approach.domain.RESIDUAL"
                    },
                    {
                        "value": "RESIDUAL_DETREND",
                        "code": "$rc:forecast_approach.domain.RESIDUAL_DETREND"
                    }
                ]
            },
            "value": "VALUE_DETREND",
            "description": "$rc:forecast_approach.descr"
        },
        "outlier_option": {
            "type": "optional",
            "display_order": "11",
            "displayname": "$rc:outlier_option.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NONE",
                        "code": "$rc:outlier_option.domain.NONE"
                    },
                    {
                        "value": "IDENTIFY",
                        "code": "$rc:outlier_option.domain.IDENTIFY"
                    }
                ]
            },
            "value": "NONE",
            "description": "$rc:outlier_option.descr"
        },
        "level_of_confidence": {
            "enabled": "false",
            "type": "optional",
            "display_order": "12",
            "displayname": "$rc:level_of_confidence.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "90%",
                        "code": "$rc:level_of_confidence.domain.90%"
                    },
                    {
                        "value": "95%",
                        "code": "$rc:level_of_confidence.domain.95%"
                    },
                    {
                        "value": "99%",
                        "code": "$rc:level_of_confidence.domain.99%"
                    }
                ]
            },
            "value": "90%",
            "description": "$rc:level_of_confidence.descr"
        },
        "maximum_number_of_outliers": {
            "enabled": "false",
            "type": "optional",
            "display_order": "13",
            "displayname": "$rc:maximum_number_of_outliers.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:maximum_number_of_outliers.descr"
        },
        "other_variables": {
            "type": "optional",
            "display_order": "7",
            "control_guid": "{38C34610-C7F7-11D5-A693-0008C711C8C1}",
            "displayname": "$rc:other_variables.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:other_variables.descr"
        },
        "importance_threshold": {
            "enabled": "false",
            "type": "optional",
            "display_order": "18",
            "displayname": "$rc:importance_threshold.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1",
                "max": "100"
            },
            "value": "10",
            "category": "$rc:params.category1",
            "description": "$rc:importance_threshold.descr"
        },
        "output_importance_table": {
            "enabled": "false",
            "type": "optional",
            "direction": "out",
            "display_order": "19",
            "displayname": "$rc:output_importance_table.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "category": "$rc:params.category1",
            "description": "$rc:output_importance_table.descr"
        },
        "model_scale": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:model_scale.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INDIVIDUAL_LOCATION",
                        "code": "$rc:model_scale.domain.INDIVIDUAL_LOCATION"
                    },
                    {
                        "value": "ENTIRE_CUBE",
                        "code": "$rc:model_scale.domain.ENTIRE_CUBE"
                    },
                    {
                        "value": "TIME_SERIES_CLUSTER",
                        "code": "$rc:model_scale.domain.TIME_SERIES_CLUSTER"
                    }
                ]
            },
            "value": "INDIVIDUAL_LOCATION",
            "description": "$rc:model_scale.descr"
        },
        "cluster_variable": {
            "enabled": "false",
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:cluster_variable.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:cluster_variable.descr"
        }
    },
    "environments": [
        "outputCoordinateSystem",
        "parallelProcessingFactor",
        "randomGenerator"
    ]
