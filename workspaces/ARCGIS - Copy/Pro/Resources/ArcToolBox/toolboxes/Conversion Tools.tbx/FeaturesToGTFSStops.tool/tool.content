{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "2140003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_gtfs_stops_file": {
            "direction": "out",
            "displayname": "$rc:out_gtfs_stops_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "txt"
                ]
            },
            "description": "$rc:out_gtfs_stops_file.descr"
        }
    },
    "environments": [
        "workspace"
    ]
}
