{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "2030001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Table": {
            "displayname": "$rc:input_table.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPTableView"
                }
            },
            "description": "$rc:input_table.descr"
        },
        "Output_Folder": {
            "displayname": "$rc:output_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:output_folder.descr"
        },
        "Derived_Folder": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:derived_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "depends": [
                "Output_Folder"
            ],
            "schema": {
                "type": "GPContainerSchema",
                "generateoutputcatalogpath": "true"
            },
            "value": "tmp"
        }
    },
    "environments": [
        "configKeyword",
        "extent",
        "qualifiedFieldNames",
        "scratchWorkspace",
        "workspace"
    ]
}
