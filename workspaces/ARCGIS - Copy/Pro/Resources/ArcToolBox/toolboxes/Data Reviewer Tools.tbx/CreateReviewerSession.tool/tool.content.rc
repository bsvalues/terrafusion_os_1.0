{
    "map": {
        "description": "Creates a new Reviewer session in a specified workspace.",
        "duplicate_checking.descr": "<xdoc><p>Specifies how duplicate validation results will be handled in the session.</p><ul><li><span title=\"NONE\">None</span>—No search will be conducted for duplicate validation results. This will improve performance when writing validation results to the database. This is the default.</li><li><span title=\"SESSION\">Session</span>—The session will be searched for duplicate validation results.</li><li><span title=\"DATABASE\">Database</span>—The entire database will be searched for duplicate validation results.</li></ul></xdoc>",
        "duplicate_checking.domain.DATABASE": "Database",
        "duplicate_checking.domain.NONE": "None",
        "duplicate_checking.domain.SESSION": "Session",
        "duplicate_checking.title": "Check For Duplicates",
        "reviewer_workspace.descr": "The workspace where the new Reviewer session will be created.",
        "reviewer_workspace.title": "Reviewer Workspace",
        "session.title": "Reviewer Session",
        "session_name.descr": "The name of the session that will be created in the Reviewer workspace.",
        "session_name.title": "Session Name",
        "session_template.descr": "An existing Reviewer session whose properties will be copied to the new session.",
        "session_template.title": "Session Template",
        "store_geometry.descr": "<xdoc><p>Specifies whether results will include an associated geometry.</p><ul><li>Checked—Results will include only attribute information. This can improve performance when writing validation results to the geodatabase.</li><li>Unchecked—Results will include both geometry and attribute information. This is the default.</li></ul></xdoc>",
        "store_geometry.title": "Do Not Store Geometry",
        "summary": "<xdoc><p>Creates a new Reviewer session in a specified workspace.</p><note type=\"legacy\"/><p group=\"note\">ArcMap-based Reviewer workflows will soon be deprecated. It is recommended that current users begin converting their workflows from Reviewer batch jobs to ArcGIS Pro attribute rules.</p></xdoc>",
        "title": "Create Reviewer Session",
        "username.descr": "The username of the person creating the Reviewer session. The default is the Windows user who is actively logged in.",
        "username.title": "Session User Name",
        "version.descr": "The enterprise geodatabase version that the session will be associated with. This parameter is only enabled when the Reviewer workspace is stored in an enterprise geodatabase.",
        "version.title": "Session Version"
    }
}
