{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\GenerateObstacleFeatures",
    "displayname": "$rc:title",
    "helpcontent": "73030004",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "description": "$rc:in_features.descr"
        },
        "height_field": {
            "displayname": "$rc:height_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Double",
                    "Text"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:height_field.descr"
        },
        "out_obstacle_features": {
            "direction": "out",
            "displayname": "$rc:out_obstacle_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_obstacle_features.descr"
        },
        "out_obstacle_buffers": {
            "direction": "out",
            "displayname": "$rc:out_obstacle_buffers.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_obstacle_buffers.descr"
        },
        "clip_features": {
            "type": "optional",
            "displayname": "$rc:clip_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:clip_features.descr"
        }
    }
}
