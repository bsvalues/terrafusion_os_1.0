{
    "map": {
        "description": "Finds the shortest path between starting points and ending points across a cost surface.",
        "handle_zeros.descr": "<xdoc><p>Specifies how zero values in the <span class=\"esri_uicontrol\">Input Cost Surface</span> parameter value will be handled.</p><ul><li><span title=\"SMALL_POSITIVE\">Small positive</span>—All zeros will be changed to a small positive value. This will allow the cells to be traversed. This is the default.</li><li><span title=\"NO_DATA\">No data</span>—All zeros will be changed to null values. The cells will not be traversed and will be avoided.</li></ul></xdoc>",
        "handle_zeros.domain.NO_DATA": "No data",
        "handle_zeros.domain.SMALL_POSITIVE": "Small positive",
        "handle_zeros.title": "Zero Cost Handled As",
        "in_cost_surface.descr": "The input raster that will be used to determine the cost to travel from starting point to ending point. No Data values cannot be crossed.",
        "in_cost_surface.title": "Input Cost Surface",
        "in_end_point.descr": "The input ending point feature. Multiple end points will increase the number of output lines, as the resulting path will branch into separate paths.",
        "in_end_point.title": "Input Ending Point",
        "in_start_point.descr": "The input starting point feature. Multiple start points will significantly increase processing time.",
        "in_start_point.title": "Input Starting Point",
        "out_end_point.title": "Output End Point",
        "out_path_feature_class.descr": "The output path feature class.",
        "out_path_feature_class.title": "Output Path Feature Class",
        "out_start_point.title": "Output Start Point",
        "title": "Least Cost Path"
    }
}
