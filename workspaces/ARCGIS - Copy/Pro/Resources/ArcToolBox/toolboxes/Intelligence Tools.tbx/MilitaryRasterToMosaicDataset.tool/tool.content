{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\MilitaryRasterToMosaicDataset",
    "displayname": "$rc:title",
    "helpcontent": "73040004",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_folder": {
            "displayname": "$rc:in_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:in_folder.descr"
        },
        "target_geodatabase": {
            "displayname": "$rc:target_geodatabase.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "description": "$rc:target_geodatabase.descr"
        },
        "output_mosaic_basename": {
            "displayname": "$rc:output_mosaic_basename.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:output_mosaic_basename.descr"
        },
        "import_format": {
            "control_guid": "{38C34610-C7F7-11D5-A693-0008C711C8C1}",
            "displayname": "$rc:import_format.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "CADRG",
                        "code": "$rc:import_format.domain.CADRG"
                    },
                    {
                        "value": "CIB",
                        "code": "$rc:import_format.domain.CIB"
                    },
                    {
                        "value": "DTED",
                        "code": "$rc:import_format.domain.DTED"
                    },
                    {
                        "value": "HRE",
                        "code": "$rc:import_format.domain.HRE"
                    }
                ]
            },
            "description": "$rc:import_format.descr"
        },
        "allow_duplicate_datasets": {
            "displayname": "$rc:allow_duplicate_datasets.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "EXCLUDE_DUPLICATES",
                        "code": "$rc:allow_duplicate_datasets.domain.EXCLUDE_DUPLICATES"
                    },
                    {
                        "value": "ALLOW_DUPLICATES",
                        "code": "$rc:allow_duplicate_datasets.domain.ALLOW_DUPLICATES"
                    },
                    {
                        "value": "OVERWRITE_DUPLICATES",
                        "code": "$rc:allow_duplicate_datasets.domain.OVERWRITE_DUPLICATES"
                    }
                ]
            },
            "value": "EXCLUDE_DUPLICATES",
            "description": "$rc:allow_duplicate_datasets.descr"
        },
        "out_cadrg_mosaic": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_cadrg_mosaic.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "out_cib_mosaic": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_cib_mosaic.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "out_dted_mosaic": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_dted_mosaic.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "out_hre_mosaic": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_hre_mosaic.title",
            "datatype": {
                "type": "GPString"
            }
        }
    },
    "environments": [
        "outputCoordinateSystem",
        "workspace"
    ]
}
