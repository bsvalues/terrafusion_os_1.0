{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\PointsToTrackSegments",
    "displayname": "$rc:title",
    "helpcontent": "73040002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "date_field": {
            "displayname": "$rc:date_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Date"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:date_field.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "value": "out_tracks",
            "description": "$rc:out_feature_class.descr"
        },
        "group_field": {
            "type": "optional",
            "displayname": "$rc:group_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Text",
                    "Long",
                    "Short"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:group_field.descr"
        },
        "include_velocity": {
            "type": "optional",
            "displayname": "$rc:include_velocity.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "INCLUDE_VELOCITY"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "EXCLUDE_VELOCITY"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:include_velocity.descr"
        },
        "out_point_feature_class": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_point_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_point_feature_class.descr"
        },
        "error_on_duplicate_timestamps": {
            "type": "optional",
            "displayname": "$rc:error_on_duplicate_timestamps.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ERROR_DUPLICATE_TIMESTAMPS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "ALLOW_DUPLICATE_TIMESTAMPS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:error_on_duplicate_timestamps.descr"
        },
        "keep_input_fields": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:keep_input_fields.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "KEEP_INPUT_FIELDS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DISCARD_INPUT_FIELDS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:keep_input_fields.descr"
        }
    }
}
