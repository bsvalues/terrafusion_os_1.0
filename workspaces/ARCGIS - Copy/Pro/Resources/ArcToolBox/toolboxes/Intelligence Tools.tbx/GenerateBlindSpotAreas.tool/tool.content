{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\GenerateBlindSpotAreas",
    "displayname": "$rc:title",
    "helpcontent": "73020001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "clip_features": {
            "type": "optional",
            "displayname": "$rc:clip_features.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:clip_features.descr"
        },
        "start_time_field": {
            "type": "optional",
            "displayname": "$rc:start_time_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Date"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:start_time_field.descr"
        },
        "end_time_field": {
            "type": "optional",
            "displayname": "$rc:end_time_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Date"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:end_time_field.descr"
        }
    }
}
