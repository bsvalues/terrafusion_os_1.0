{
    "type": "FunctionTool",
    "guid": "{c3440e8b-fc2a-4e13-bf5f-e2ddc9ea6414}",
    "displayname": "$rc:title",
    "helpcontent": "81010003",
    "description": "$rc:description",
    "product": "200",
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "in_oriented_imagery_dataset": {
            "display_order": "0",
            "displayname": "$rc:in_oriented_imagery_dataset.title",
            "datatype": {
                "type": "GPOrientedImageryLayer"
            },
            "description": "$rc:in_oriented_imagery_dataset.descr"
        },
        "out_dataset_path": {
            "display_order": "1",
            "displayname": "$rc:out_dataset_path.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEFeatureDataset"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPWorkspaceDomain",
                        "workspacetype": [
                            "Local Database",
                            "Remote Database"
                        ]
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "defaultenvironmentname": "workspace",
            "description": "$rc:out_dataset_path.descr"
        },
        "out_dataset_name": {
            "display_order": "2",
            "displayname": "$rc:out_dataset_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_dataset_name.descr"
        },
        "footprint_option": {
            "display_order": "3",
            "displayname": "$rc:footprint_option.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PER_IMAGE",
                        "code": "$rc:footprint_option.domain.PER_IMAGE"
                    },
                    {
                        "value": "MERGE",
                        "code": "$rc:footprint_option.domain.MERGE"
                    },
                    {
                        "value": "BUFFER",
                        "code": "$rc:footprint_option.domain.BUFFER"
                    },
                    {
                        "value": "EXTENT",
                        "code": "$rc:footprint_option.domain.EXTENT"
                    }
                ]
            },
            "description": "$rc:footprint_option.descr"
        },
        "out_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "in_oriented_imagery_dataset"
            ]
        }
    },
    "environments": [
        "extent",
        "geographicTransformations",
        "outputCoordinateSystem"
    ]
}
