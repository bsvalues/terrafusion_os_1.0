{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "81020002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_oriented_imagery_dataset": {
            "displayname": "$rc:in_oriented_imagery_dataset.title",
            "datatype": {
                "type": "GPOrientedImageryLayer"
            },
            "description": "$rc:in_oriented_imagery_dataset.descr"
        },
        "service_name": {
            "displayname": "$rc:service_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:service_name.descr"
        },
        "portal_folder": {
            "type": "optional",
            "displayname": "$rc:portal_folder.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:portal_folder.descr"
        },
        "share_with": {
            "type": "optional",
            "displayname": "$rc:share_with.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PRIVATE",
                        "code": "$rc:share_with.domain.PRIVATE"
                    },
                    {
                        "value": "ORGANIZATION",
                        "code": "$rc:share_with.domain.ORGANIZATION"
                    },
                    {
                        "value": "PUBLIC",
                        "code": "$rc:share_with.domain.PUBLIC"
                    }
                ]
            },
            "value": "PRIVATE",
            "description": "$rc:share_with.descr"
        },
        "add_footprint": {
            "type": "optional",
            "displayname": "$rc:add_footprint.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "FOOTPRINT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_FOOTPRINT"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:add_footprint.descr"
        },
        "attach_images": {
            "type": "optional",
            "displayname": "$rc:attach_images.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ATTACH"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_ATTACH"
                    }
                ]
            },
            "description": "$rc:attach_images.descr"
        },
        "tags": {
            "type": "optional",
            "displayname": "$rc:tags.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:tags.descr"
        },
        "summary": {
            "type": "optional",
            "displayname": "$rc:summary.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:summary.descr"
        },
        "out_service_item": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_service_item.title",
            "datatype": {
                "type": "GPString"
            }
        }
    }
}
