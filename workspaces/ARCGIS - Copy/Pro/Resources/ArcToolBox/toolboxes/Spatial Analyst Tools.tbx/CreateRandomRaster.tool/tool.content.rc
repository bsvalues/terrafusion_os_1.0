{
    "map": {
        "cell_size.descr": "<xdoc><p>The cell size of the output raster that will be created.</p><p>This parameter can be defined by a numeric value or obtained from an existing raster dataset. If the cell size hasn&apos;t been explicitly specified as the parameter value, the environment cell size value will be used if specified; otherwise, additional rules will be used to calculate it from the other inputs. See the usage section for more detail.</p></xdoc>",
        "cell_size.title": "Output cell size",
        "description": "Creates a raster of random floating-point values between 0.0 and 1.0 within the extent and cell size of the analysis window.",
        "extent.descr": "<xdoc><p>The extent for the output raster dataset.</p><p>The extent will be the value in the environment if specifically set. If not specifically set, the default is 0, 0, 250, 250.</p></xdoc>",
        "extent.title": "Output extent",
        "out_raster.descr": "The output raster of randomly distributed values with a range of 0.0 to 1.0",
        "out_raster.title": "Output raster",
        "seed_value.descr": "<xdoc><p>A value to be used to reseed the random number generator.</p><p>This may be an integer or floating-point number. Rasters are not permitted as input.</p><p>The random number generator is automatically seeded with the current value of the system clock (seconds since January 1, 1970). The range of permissible values for the seed value is -2<span style=\"vertical-align:super\">31</span> + 1 to 2<span style=\"vertical-align:super\">31</span> (or -2,147,483,647 to 2,147,483,648).</p></xdoc>",
        "seed_value.title": "Seed value",
        "summary": "<xdoc><p>Creates a raster of random floating-point values between 0.0 and 1.0 within the extent and cell size of the analysis window.</p><p>The Create Random Raster tool in the Data Management toolbox provides enhanced functionality or performance.</p></xdoc>",
        "title": "Create Random Raster"
    }
}
