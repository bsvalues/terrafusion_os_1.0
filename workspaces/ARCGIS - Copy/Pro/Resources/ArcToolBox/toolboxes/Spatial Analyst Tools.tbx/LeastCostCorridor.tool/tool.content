{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "8030021",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "10"
    ],
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_accumulative_cost_distance_raster1": {
            "displayname": "$rc:in_accumulative_cost_distance_raster1.title",
            "datatype": {
                "type": "GPRasterLayer"
            },
            "description": "$rc:in_accumulative_cost_distance_raster1.descr"
        },
        "in_back_direction_raster1": {
            "displayname": "$rc:in_back_direction_raster1.title",
            "datatype": {
                "type": "GPRasterLayer"
            },
            "description": "$rc:in_back_direction_raster1.descr"
        },
        "in_accumulative_cost_distance_raster2": {
            "displayname": "$rc:in_accumulative_cost_distance_raster2.title",
            "datatype": {
                "type": "GPRasterLayer"
            },
            "description": "$rc:in_accumulative_cost_distance_raster2.descr"
        },
        "in_back_direction_raster2": {
            "displayname": "$rc:in_back_direction_raster2.title",
            "datatype": {
                "type": "GPRasterLayer"
            },
            "description": "$rc:in_back_direction_raster2.descr"
        },
        "out_raster": {
            "direction": "out",
            "displayname": "$rc:out_raster.title",
            "datatype": {
                "type": "DERasterDataset"
            },
            "schema": {
                "type": "GPRasterSchema",
                "extenttype.rule": "Environment",
                "cellsize.rule": "Environment",
                "raster.rule": "FirstDependency",
                "rasterformat.rule": "IMG",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_raster.descr"
        },
        "threshold_method": {
            "type": "optional",
            "displayname": "$rc:threshold_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NO_THRESHOLD",
                        "code": "$rc:threshold_method.domain.NO_THRESHOLD"
                    },
                    {
                        "value": "PERCENT_OF_LEAST_COST",
                        "code": "$rc:threshold_method.domain.PERCENT_OF_LEAST_COST"
                    },
                    {
                        "value": "ACCUMULATIVE_COST",
                        "code": "$rc:threshold_method.domain.ACCUMULATIVE_COST"
                    }
                ]
            },
            "value": "NO_THRESHOLD",
            "description": "$rc:threshold_method.descr"
        },
        "threshold": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:threshold.title",
            "datatype": {
                "type": "GPDouble"
            },
            "depends": [
                "threshold_method"
            ],
            "description": "$rc:threshold.descr"
        }
    },
    "environments": [
        "autoCommit",
        "compression",
        "configKeyword",
        "parallelProcessingFactor",
        "pyramid",
        "scratchWorkspace",
        "tileSize",
        "workspace"
    ]
}
