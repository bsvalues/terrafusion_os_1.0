    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "10"
    ],
    "categories": [
        "{7479dc37-304a-4078-a72f-d5c89b85822a}"
    ],
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_raster": {
            "displayname": "$rc:in_raster.title",
            "datatype": {
                "type": "GPSAGeoData"
            },
            "domain": {
                "type": "GPSAGeoDataDomain",
                "checkfield": "true",
                "singleband": "false",
                "datatype": [
                    "DERasterDataset",
                    "DERasterBand",
                    "GPRasterLayer",
                    "DEMosaicDataset",
                    "GPMosaicLayer",
                    "GPRasterCalculatorExpression",
                    "DETable",
                    "DEImageServer",
                    "DEFile"
                ],
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text"
                ],
                "geometrytype": [
                    "Point",
                    "Polygon",
                    "Polyline",
                    "Multipoint"
                ]
            },
            "description": "$rc:in_raster.descr"
        },
        "out_raster": {
            "direction": "out",
            "displayname": "$rc:out_raster.title",
            "datatype": {
                "type": "DERasterDataset"
            },
            "description": "$rc:out_raster.descr"
        },
        "cell_factor": {
            "displayname": "$rc:cell_factor.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "false"
            },
            "description": "$rc:cell_factor.descr"
        },
        "aggregation_type": {
            "type": "optional",
            "displayname": "$rc:aggregation_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SUM",
                        "code": "$rc:aggregation_type.domain.SUM"
                    },
                    {
                        "value": "MAXIMUM",
                        "code": "$rc:aggregation_type.domain.MAXIMUM"
                    },
                    {
                        "value": "MEAN",
                        "code": "$rc:aggregation_type.domain.MEAN"
                    },
                    {
                        "value": "MEDIAN",
                        "code": "$rc:aggregation_type.domain.MEDIAN"
                    },
                    {
                        "value": "MINIMUM",
                        "code": "$rc:aggregation_type.domain.MINIMUM"
                    }
                ]
            },
            "value": "SUM",
            "description": "$rc:aggregation_type.descr"
        },
        "extent_handling": {
            "type": "optional",
            "displayname": "$rc:extent_handling.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "EXPAND"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "TRUNCATE"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:extent_handling.descr"
        },
        "ignore_nodata": {
            "type": "optional",
            "displayname": "$rc:ignore_nodata.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DATA"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NODATA"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:ignore_nodata.descr"
        }
    },
    "environments": [
        "autoCommit",
        "cellSize",
        "cellSizeProjectionMethod",
        "compression",
        "configKeyword",
        "extent",
        "geographicTransformations",
        "mask",
