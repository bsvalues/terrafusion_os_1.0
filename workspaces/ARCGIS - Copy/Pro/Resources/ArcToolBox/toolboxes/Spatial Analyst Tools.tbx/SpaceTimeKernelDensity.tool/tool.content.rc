{
    "map": {
        "cell_size.descr": "<xdoc><p>The cell size of the multidimensional raster output that will be created.</p><p>The value can be defined by a numeric value or obtained from an existing raster dataset. If no cell size is provided, the environment cell size value will be used if specified; otherwise, additional rules will be used to calculate it from the other inputs. See the tool usage for details.</p></xdoc>",
        "cell_size.title": "Cell Size",
        "description": "Expands kernel density calculations from analyzing the relative position and magnitude of the input features to include other dimensions such as time and depth (elevation). The resulting output identifies the magnitude-per-unit area using the multiple kernel functions to fit a smoothly tapered surface to each input point.",
        "elevation_field.descr": "<xdoc><p>The field denoting elevation values for each feature.</p><p>Values in the elevation field can be integer or floating point.</p><p>Use Empty to support 3D kernel density with time.</p><p>For 3D features, a pseudo field, <span class=\"esri_fieldname\">Shape.Z</span>, will be added to the field list.</p></xdoc>",
        "elevation_field.title": "Elevation Field",
        "elevation_field_unit.descr": "<xdoc><p>Specifies the unit of measure that will be used for the input elevation field value. The default is meters.</p><p>Use the appropriate unit to represent the values in the <span class=\"esri_uicontrol\">Elevation Field</span> parameter value.</p><ul><li><span title=\"INCH\">Inch</span>—Inches will be used.</li><li><span title=\"FOOT\">Foot</span>—Feet will be used.</li><li><span title=\"YARD\">Yard</span>—Yards will be used.</li><li><span title=\"MILE_US\">Mile (US)</span>—U.S. miles will be used.</li><li><span title=\"NAUTICAL_MILE\">Nautical Mile</span>—Nautical miles will be used.</li><li><span title=\"MILLIMETER\">Millimeter</span>—Millimeters will be used.</li><li><span title=\"CENTIMETER\">Centimeter</span>—Centimeters will be used.</li><li><span title=\"METER\">Meter</span>—Meters will be used.</li><li><span title=\"KILOMETER\">Kilometers</span>—Kilometers will be used.</li><li><span title=\"DECIMETER\">Decimeter</span>—Decimeters will be used.</li></ul></xdoc>",
        "elevation_field_unit.domain.CENTIMETER": "Centimeter",
        "elevation_field_unit.domain.DECIMETER": "Decimeter",
        "elevation_field_unit.domain.FOOT": "Foot",
        "elevation_field_unit.domain.INCH": "Inch",
        "elevation_field_unit.domain.KILOMETER": "Kilometers",
        "elevation_field_unit.domain.METER": "Meter",
        "elevation_field_unit.domain.MILE_US": "Mile (US)",
        "elevation_field_unit.domain.MILLIMETER": "Millimeter",
        "elevation_field_unit.domain.NAUTICAL_MILE": "Nautical Mile",
        "elevation_field_unit.domain.YARD": "Yard",
        "elevation_field_unit.title": "Elevation Field Unit",
        "elevation_interval.descr": "<xdoc><p>The elevation interval between slices in the multidimensional raster output.</p><p>The value must be greater than zero.</p></xdoc>",
        "elevation_interval.title": "Elevation Interval",
        "elevation_unit.descr": "<xdoc><p>Specifies the unit of elevation interval that will be used for the multidimensional raster output. The default is meter.</p><ul><li><span title=\"INCH\">Inch</span>—Inches will be used.</li><li><span title=\"FOOT\">Foot</span>—Feet will be used.</li><li><span title=\"YARD\">Yard</span>—Yards will be used.</li><li><span title=\"MILE_US\">Mile (US)</span>—U.S. miles will be used.</li><li><span title=\"NAUTICAL_MILE\">Nautical Mile</span>—Nautical miles will be used.</li><li><span title=\"MILLIMETER\">Millimeter</span>—Millimeters will be used.</li><li><span title=\"CENTIMETER\">Centimeter</span>—Centimeters will be used.</li><li><span title=\"METER\">Meter</span>—Meters will be used.</li><li><span title=\"KILOMETER\">Kilometers</span>—Kilometers will be used.</li><li><span title=\"DECIMETER\">Decimeter</span>—Decimeters will be used.</li></ul></xdoc>",
        "elevation_unit.domain.CENTIMETER": "Centimeter",
        "elevation_unit.domain.DECIMETER": "Decimeter",
        "elevation_unit.domain.FOOT": "Foot",
        "elevation_unit.domain.INCH": "Inch",
        "elevation_unit.domain.KILOMETER": "Kilometers",
        "elevation_unit.domain.METER": "Meter",
        "elevation_unit.domain.MILE_US": "Mile (US)",
        "elevation_unit.domain.MILLIMETER": "Millimeter",
        "elevation_unit.domain.NAUTICAL_MILE": "Nautical Mile",
        "elevation_unit.domain.YARD": "Yard",
        "elevation_unit.title": "Elevation Unit",
        "end_time.descr": "The end time that will be used for the multidimensional raster output.",
        "end_time.title": "End Time",
        "in_features.descr": "The input point features for which density will be calculated.",
        "in_features.title": "Input Point Features",
        "kernel_search_radius_xy.descr": "<xdoc><p>The search radius on the x,y plane within which density will be calculated.</p><p>Provide the value and the appropriate units. For example, to include all features within a 1-mile neighborhood when the units are meters, set the search radius to 1609.344 (1 mile = 1609.344 meters).</p><p>By default, the units are based on the linear unit of the output spatial reference.</p></xdoc>",
        "kernel_search_radius_xy.title": "Search Radius (x and y)",
        "kernel_search_radius_z.descr": "<xdoc><p>The vertical search distance in the z-direction within which density will be calculated. This vertical distance will be used to search for features in the upward and downward directions along the z-axis.</p><p>Provide the value and the appropriate units.</p></xdoc>",
        "kernel_search_radius_z.title": "Search Radius (z)",
        "kernel_search_time_window.descr": "<xdoc><p>The search range of time within which density will be calculated.</p><p>Provide the value and the appropriate units.</p></xdoc>",
        "kernel_search_time_window.title": "Search Time Window (t)",
        "max_elevation.descr": "The maximum (highest) elevation that will be used for the multidimensional raster output.",
        "max_elevation.title": "Maximum Elevation",
        "method.descr": "<xdoc><p>Specifies whether the flat earth (planar) or the shortest path on a spheroid (geodesic) method will be used.</p><ul><li><span title=\"PLANAR\">Planar</span>—The planar distance between features will be used. This is the default.</li><li><span title=\"GEODESIC\">Geodesic</span>—The geodesic distance between features will be used.</li></ul></xdoc>",
        "method.domain.GEODESIC": "Geodesic",
        "method.domain.PLANAR": "Planar",
        "method.title": "Method",
        "min_elevation.descr": "The minimum (lowest) elevation that will be used for the multidimensional raster output.",
        "min_elevation.title": "Minimum Elevation",
        "out_raster.descr": "<xdoc><p>The output kernel density multidimensional raster dataset.</p><p>The file name extension determines the format of the output. Use .crf to create a CRF raster. Use .nc to create a netCDF raster. The default output is a CRF raster.</p><p>It is always a floating point raster.</p></xdoc>",
        "out_raster.title": "Output Raster",
        "out_voxel_layer.descr": "<xdoc><p>The output voxel layer based on volumetric data stored in the output netCDF raster.</p><p>This output type can only be created when the <span class=\"esri_uicontrol\">Output Raster</span> parameter is set to create a netCDF raster with the .nc extension.</p></xdoc>",
        "out_voxel_layer.title": "Output Voxel Layer",
        "params.category1": "Output Parameters",
        "params.category2": "Kernel Parameters",
        "params.category3": "Analysis Parameters",
        "population_field.descr": "<xdoc><p>The field denoting population values for each feature. The population is the count or quantity to be spread across the landscape to create a continuous surface.</p><p>Values in the population field can be integer or floating point.</p><p>Use <span class=\"esri_uicontrol\">None</span> if no item or special value will be used and each feature will be counted once.</p></xdoc>",
        "population_field.title": "Population Field",
        "resultant_values.descr": "<xdoc><p>Specifies what the values in the output raster will represent.</p><p>Since the output cell value is related to the specified cell size, the resulting raster cannot be resampled to a different cell size.</p><ul><li><span title=\"DENSITIES\">Densities</span>—The output values will represent the calculated density value per unit area for each cell. This is the default.</li><li><span title=\"EXPECTED_COUNTS\">Expected Counts</span>—The output values will represent the calculated density value per cell area.</li></ul></xdoc>",
        "resultant_values.domain.DENSITIES": "Densities",
        "resultant_values.domain.EXPECTED_COUNTS": "Expected Counts",
        "resultant_values.title": "Resultant Values",
        "start_time.descr": "The start time that will be used for the multidimensional raster output.",
        "start_time.title": "Start Time",
        "time_field.descr": "The field denoting time values for each feature.",
        "time_field.title": "Time Field",
        "time_interval.descr": "<xdoc><p>The time interval between slices in the multidimensional raster output.</p><p>The value must be greater than zero.</p></xdoc>",
        "time_interval.title": "Time Interval",
        "time_interval_unit.descr": "<xdoc><p>Specifies the unit of the time interval that will be used for the multidimensional raster output. The default is day.</p><ul><li><span title=\"SECOND\">Second</span>—The time interval unit will be seconds.</li><li><span title=\"MINUTE\">Minute</span>—The time interval unit will be minutes.</li><li><span title=\"HOUR\">Hour</span>—The time interval unit will be hours.</li><li><span title=\"DAY\">Day</span>—The time interval unit will be days.</li><li><span title=\"WEEK\">Week</span>—The time interval unit will be weeks.</li></ul></xdoc>",
        "time_interval_unit.domain.DAY": "Day",
        "time_interval_unit.domain.HOUR": "Hour",
        "time_interval_unit.domain.MINUTE": "Minute",
        "time_interval_unit.domain.SECOND": "Second",
        "time_interval_unit.domain.WEEK": "Week",
        "time_interval_unit.title": "Time Interval Unit",
        "title": "Space Time Kernel Density"
    }
}
