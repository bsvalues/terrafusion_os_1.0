{
    "map": {
        "description": "Performs subpixel classification and calculates the fractional abundance of different land-cover types for individual pixels.",
        "in_raster.descr": "The input raster dataset.",
        "in_raster.title": "Input Raster",
        "in_spectral_profile_file.descr": "<xdoc><p>The spectral information for the different land-cover classes.</p><p>This can be provided as polygon features, a training sample feature class generated from the <span class=\"esri_uicontrol\">Training Samples Manager</span> pane, a classifier definition file (.ecd) generated from the Train Maximum Likelihood Classifier tool, or a JSON format file (.json) that contains the class spectral profiles.</p></xdoc>",
        "in_spectral_profile_file.title": "Input Training Features or Spectral Profile",
        "out_raster.descr": "The output multiband raster dataset.",
        "out_raster.title": "Output Raster",
        "title": "Linear Spectral Unmixing",
        "value_option.descr": "<xdoc><p>Specifies how the output pixel values will be defined.</p><ul><li><span title=\"SUM_TO_ONE\">Sum to one</span>—Class values for each pixel will be provided in decimal format with the sum of all classes equal to 1. For example, Class1 = 0.16; Class2 = 0.24; Class3 = 0.60.</li><li><span title=\"NON_NEGATIVE\">Non-negative</span>—There will be no negative output values.</li></ul></xdoc>",
        "value_option.domain.NON_NEGATIVE": "Non-negative",
        "value_option.domain.SUM_TO_ONE": "Sum to one",
        "value_option.title": "Output Value Option"
    }
}
