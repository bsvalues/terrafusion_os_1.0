{
    "map": {
        "description": "Expands specified zones of a raster by a specified number of cells.",
        "expand_method.descr": "<xdoc><p>The method used to expand the selected zones.</p><ul><li><span title=\"MORPHOLOGICAL\">Morphological</span>—Uses a mathematical morphology method to expand the zones. This is the default.</li><li><span title=\"DISTANCE\">Distance</span>—Uses a distance-based method to expand the zones.</li></ul><p>The <span class=\"esri_uicontrol\">Distance</span> option supports parallelization, and can be controlled with the <span class=\"esri_uicontrol\">Parallel Processing Factor</span> environment setting.</p></xdoc>",
        "expand_method.domain.DISTANCE": "Distance",
        "expand_method.domain.MORPHOLOGICAL": "Morphological",
        "expand_method.title": "Expand method",
        "in_raster.descr": "<xdoc><p>The input raster for which the identified zones are to be expanded</p><p>It must be of integer type.</p></xdoc>",
        "in_raster.title": "Input raster",
        "number_cells.descr": "<xdoc><p>The number of cells to expand each specified zone by.</p><p>The value must be an integer greater than 1.</p></xdoc>",
        "number_cells.title": "Number of cells",
        "out_raster.descr": "<xdoc><p>The output generalized raster.</p><p>The specified zones of the input raster will be expanded by the specified number of cells.</p><p>The output is always of integer type.</p></xdoc>",
        "out_raster.title": "Output raster",
        "title": "Expand",
        "zone_values.descr": "<xdoc><p>The list of zone values to expand.</p><p>The zone values must be integers. They can be in any order.</p></xdoc>",
        "zone_values.title": "Zone values"
    }
}
