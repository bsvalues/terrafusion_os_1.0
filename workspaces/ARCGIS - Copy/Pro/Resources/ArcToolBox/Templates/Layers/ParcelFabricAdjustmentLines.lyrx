            "valueExpressionInfo" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "if (IsEmpty($feature.Point3Name)  && $feature.Outlier == 0)\n    return 0.4;\nif (IsEmpty($feature.Point3Name)  && $feature.Outlier == 1)\n    return 10;\nvar tt = abs($feature.MeasurementCorrection) * pi/180;\nvar p1 = Geometry($feature).Paths[0][0];\nvar p2 = Geometry($feature).Paths[0][1];\nvar dist = Distance(p1, p2, 'meters');\nvar distOffset=dist*Tan(tt);\nvar pixels = 0.4 + distOffset*60;\nif (pixels>10)\n  pixels=10;\nreturn pixels;\n",
              "returnType" : "Default"
            }
          }
