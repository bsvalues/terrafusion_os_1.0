      "popupInfo" : {
        "type" : "CIMPopupInfo",
        "title" : "{aec_Network} - {Entity} - {aec_Name}",
        "mediaInfos" : [
          {
            "type" : "CIMTextMediaInfo",
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "text" : "<table> <tr> <h3>Property</h3> <th></th> </tr> \n<tr> <td><strong>Network:</strong></td> <td>{aec_Network}</td> </tr> \n<tr> <td><strong>Entity:</strong></td> <td>{Entity}</td> </tr> \n<tr> <td><strong>Name:</strong></td> <td>{aec_Name}</td> </tr> \n<tr> <td><strong>Description:</strong></td> <td>{aec_Desc}</td> </tr> \n<tr> <td><strong>Render Material:</strong></td> <td>{aec_RendMat}</td> </tr>\n<tr> <td><strong>Nominal Diameter:</strong></td> <td>{aec_NomDia}</td> </tr>\n<tr> <td><strong>Ref Alignment:</strong></td> <td>{aec_RefAlign}</td> </tr>\n<tr> <td><strong>Ref Surface:</strong></td> <td>{aec_RefSurf}</td> </tr>\n<tr> <td><strong>Style:</strong></td> <td>{aec_Style}</td> </tr></table>"
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 1,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var returnstring = \"<table><h2>BIM Cloud Connection</h2>\" \nvar p = 0\nfor (var i in $feature) {\n    if (!isEmpty($feature[i]) &&  i == 'SharedView')  {\n        returnstring = returnstring + \"<tr><td><B>\" + i + \": \"+ \"</B>\" + \"</td><td>\" + IIf(i == 'SharedView', \"<p><a href=\" +  $feature[i]  + \">URL</a> </p>\", $feature[i])  + \"</td></tr>\"\np++\n    }\n}\nif (p>0) {\nreturn { \n      type : 'text', \n      text : returnstring + \"</table>\" \n       }\n}\n\n//Expression to show the SharedView file, when exist. And to open file in the BIM site using the URL",
              "returnType" : "Default"
            }
          }
        ],
        "gridLayout" : {
          "type" : "CIMPopupLayout",
          "columnWidths" : [
