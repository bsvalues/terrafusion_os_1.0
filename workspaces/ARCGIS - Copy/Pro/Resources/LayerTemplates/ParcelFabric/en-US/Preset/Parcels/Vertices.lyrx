          "expression" : "var label;\nvar seed = ($feature.IsSeed == 1);\n\nIf (IsEmpty($feature.Name)==true){\n    return label;\n}\nElse if (!seed){\n    label = \"<BOL>\" + $feature.Name + \"</BOL>\"\n    if (IsEmpty($feature.StatedArea)==true){\n        return label; //returns only the parcel name\n    }\n    Else {\n        if (IsEmpty($feature.statedareaunit)==true) {\n            label = label + \"\\n\" + \"<fnt size = '8'>\" + $feature.OriginalStatedArea + \"</fnt>\";\n            return label;\n        }\n        label = label + \"\\n\" + \"<fnt size = '8'>\" + Round($feature.statedarea, 2) + \" \" + DomainName($feature, 'statedareaunit') + \"</fnt>\";\n        return label;\n    }\n}",
