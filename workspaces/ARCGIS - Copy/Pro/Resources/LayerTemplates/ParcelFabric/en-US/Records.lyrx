          "expression" : "// Change the settings portion to configure the label\r\n// This is an Arcade expression\r\n\r\n// SETTINGS\r\nvar ShowRecordType = false; //Set 'true' to show the Record Type (or 'false')\r\nvar RecordTypePrefix = \"Type: \"; //Set the record type prefix\r\nvar ShowRecordedDate = false; //Set to 'true' to show recorded date (or 'false')\r\nvar mmddyyyy = true; //date format: set to 'false' to see ddmmyyyy format\r\nvar RecordedDatePrefix = \"Recorded Date: \"; //Set the recorded data prefix\r\nvar MissingRecordName = \"Missing Record Name\"; //Set the missing record string \r\n\r\n// VARIABLES\r\nvar Label;\r\nvar recordName = $feature.Name;\r\nvar recordType = $feature.RecordType;\r\nvar recordDate = $feature.RecordedDate;\r\nvar dd = day(recordDate);\r\nvar mm = month(recordDate)+1; //months are returned between 0 (January) to 11 (December)\r\nvar yyyy = year(recordDate);\r\n\r\nif (!IsEmpty(recordName)){ \r\n   Label = recordName\r\nif (ShowRecordType) {\r\n    if (!IsEmpty(recordType)){ Label = Label + \"\\n\" + RecordTypePrefix + DomainName($feature, 'RecordType')}\r\n}\r\nif (ShowRecordedDate){\r\n    if (!IsEmpty(recordDate)){ \r\n    if (mmddyyyy) {\r\n        Label = Label + \"\\n\" + RecordedDatePrefix + mm + \"-\" + dd + \"-\" + yyyy}\r\n    else{\r\n        Label = Label + \"\\n\" + RecordedDatePrefix + dd + \"-\" + mm + \"-\" + yyyy}\r\n    }        \r\n}\r\n}\r\nelse { Label = \"\" + MissingRecordName + \"\" }\r\nreturn Label",
