{
  "IDs": {
    "ItemURI-Base": {
      "Path": "$uri.path$/$uri.profile$##@{LayerObject}",
      "Key": "",
      "Tag": "Dataset",
      "Group": "@{Mission}-$/Images/0/IDATIM$",
      "DisplayName": "$uri.stem$:$%i$",
      "ProductName": "$/FileHeader/TREs/CSDIDA/PRODUCT_ID$",
      "SourceTimeStamp": "$uri.modifiedDateTime$",
      "AuxiliaryPaths": [],
      "Properties": {
        "ImageRepresentation": "MONO",
        "ImageCategory": "VIS",
        "SensorName": "Properties.json#SensorName-Property"
      }
    },
    "MosaicDefinition-Base": {
      "ItemURI": {
        "ref": "#ItemURI-Base"
      },
      "Footprint": "$/Feature/IMAGE_SHAPE/Shape$",
      "ProcessingTemplate": "Default",
      "Variables": {
        "DefaultMaximumInput": 2047.0,
        "Pan.Min": 0.0
      },
      "Properties": {}
    },

    "MosaicDefinition-Default-Base": {
      "@Variables": {
        "LayerObject": "Primary"
      },
      "ref": "#MosaicDefinition-Base"
    },
    "MosaicDefinition-Catalog-Base": {
      "@Variables": {
        "LayerObject": "Layer_Image_Catalog_@{LayerObjectType}"
      },
      "ref": "#MosaicDefinition-Base",
      "ProcessingTemplate": "Catalog"
    },

    "Tag-Pan": "Pan",
    "Tag-RGB": "RGB",
    "Tag-MS": "MS",
    "Tag-SWIR": "SWIR",
    "Tag-CAVIS": "CAVIS",
    "Tag-Pansharpened": "Pansharpened",

    "ProductName-BasicPanchromatic": "BasicPanchromatic",
