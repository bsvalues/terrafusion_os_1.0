{
  "settings": {
    "workbench.iconTheme": "terrafusion-icons",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    },
    "editor.formatOnSave": true,
    "terrafusion.focus": "C# WPF Desktop Application & OS Integration",
    "terrafusion.team": "Native Shell Team",
    "workbench.colorTheme": "TerraFusion Dark"
  },
  "folders": [
    {
      "path": "../native-shell",
      "name": "native-shell"
    },
    {
      "path": "../apps/desktop-electron",
      "name": "desktop-electron"
    }
  ],
  "extensions": {
    "recommendations": [
      "ms-vscode.vscode-typescript-next",
      "bradlc.vscode-tailwindcss",
      "ms-dotnettools.csharp",
      "ms-python.python",
      "ms-vscode.powershell",
      "GitHub.copilot",
      "terrafusion.ai-agent-tools"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Native Shell",
        "type": "node",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build Native Shell",
        "type": "shell",
        "command": "echo 'Build task for ${workspaceFolder}'",
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Test Native Shell",
        "type": "shell",
        "command": "echo 'Test task for ${workspaceFolder}'",
        "problemMatcher": [],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      }
    ]
  }
}
