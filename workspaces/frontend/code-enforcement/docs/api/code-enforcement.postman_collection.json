{
  "info": {
    "name": "Code Enforcement API",
    "description": "Regulatory compliance and code enforcement APIs - TerraFusion Government API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "tokenUrl",
        "value": "https://auth.terrafusion.gov/oauth/token",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "https://auth.terrafusion.gov/oauth/authorize",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "code-enforcement:read code-enforcement:write",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.terrafusion.gov/api/v1/code-enforcement",
      "type": "string"
    },
    {
      "key": "workspace",
      "value": "code-enforcement",
      "type": "string"
    },
    {
      "key": "version",
      "value": "1.0.0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List code violations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/violations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "violations"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Report violation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/violations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "violations"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get inspection details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/inspections/{id}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inspections",
            "{id}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create enforcement action",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/enforcement-actions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "enforcement-actions"
          ]
        }
      },
      "response": []
    }
  ]
}