{
  "analytics": {
    "tier": "MEDIUM",
    "level": "standard",
    "enabled": true
  },
  "predictive_analytics": {
    "enabled": true,
    "features": ["project-timeline", "cost-estimate", "resource-allocation"],
    "prediction_window_days": 90,
    "confidence_threshold": 0.75,
    "update_frequency_hours": 6,
    "models": ["regression", "classification"]
  },
  "anomaly_detection": {
    "enabled": true,
    "detectors": ["budget-anomalies", "schedule-anomalies"],
    "sensitivity": "medium",
    "real_time": false,
    "batch_window_hours": 24,
    "alert_on_detection": true,
    "historical_baseline_days": 90
  },
  "data_management": {
    "retention_days": 1825,
    "archival_days": 2190,
    "compression": "gzip",
    "encryption": "AES-256",
    "backup_frequency": "weekly",
    "daily_volume_gb": 150
  },
  "ml_infrastructure": {
    "frameworks": ["scikit-learn"],
    "gpu_enabled": false,
    "distributed_training": false,
    "model_registry": "enabled",
    "experiment_tracking": "enabled",
    "hyperparameter_optimization": true
  },
  "optimization": {
    "auto_scaling": {
      "enabled": true,
      "metrics": ["cpu", "memory", "request_latency"],
      "target_utilization": 70,
      "scale_up_threshold": 80,
      "scale_down_threshold": 30,
      "cooldown_minutes": 5
    },
    "cost_optimization": {
      "enabled": true,
      "target_savings_percent": 20,
      "review_frequency_days": 7
    },
    "performance_optimization": {
      "enabled": true,
      "target_p99_latency_ms": 1000,
      "target_error_rate": 0.001
    }
  },
  "monitoring": {
    "metrics_collection": true,
    "metrics_retention_days": 365,
    "dashboards_enabled": true,
    "alerts_enabled": true,
    "sla_tracking": true
  },
  "compliance": {
    "gdpr_compliant": true,
    "hipaa_compliant": false,
    "fed_ramp_compliant": true,
    "audit_logging": true,
    "data_lineage_tracking": true
  }
}
