{
  "info": {
    "name": "Legal Judicial API",
    "description": "Legal proceedings and judicial operations APIs - TerraFusion Government API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "tokenUrl",
        "value": "https://auth.terrafusion.gov/oauth/token",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "https://auth.terrafusion.gov/oauth/authorize",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "legal-judicial:read legal-judicial:write",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.terrafusion.gov/api/v1/legal",
      "type": "string"
    },
    {
      "key": "workspace",
      "value": "legal-judicial",
      "type": "string"
    },
    {
      "key": "version",
      "value": "1.0.0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Case management",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cases",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cases"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Legal document filing",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documents"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Court hearing schedule",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/hearings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "hearings"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Record court judgments",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-TerraFusion-Workspace",
            "value": "{{workspace}}",
            "type": "text"
          },
          {
            "key": "X-TerraFusion-Version",
            "value": "{{version}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/judgments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "judgments"
          ]
        }
      },
      "response": []
    }
  ]
}