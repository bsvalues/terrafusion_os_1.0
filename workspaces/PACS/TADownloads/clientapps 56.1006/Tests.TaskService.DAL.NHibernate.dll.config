<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net"/>
	</configSections>

	<!-- this next bit is critical for SQLite under .NET 4.0, otherwise
			 you'll get hard-to understand errors trying to initialize the
			 NHibernate configuration stuff -->
	<startup useLegacyV2RuntimeActivationPolicy="true">
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
	</startup>

	<appSettings>
		<!-- a comma delimited list of assembly names containing object mappings -->
		<add key="domain.mapping.assemblies" value="TrueAutomation.TaskService.Domain,TrueAutomation.TaskService.DAL.NHibernate"/>
	</appSettings>

	<log4net>
		<appender name="LogToFile" type="log4net.Appender.FileAppender">
			<file value="TestWorkflowDomain.log"/>
			<appendToFile value="false"/>
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%d [%t] %-5l - %m%n%n"/>
			</layout>
		</appender>
		<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%d [%t] %-5l - %m%n%n"/>
			</layout>
		</appender>
		<root>
			<priority value="DEBUG"/>
			<appender-ref ref="ConsoleAppender"/>
		</root>
	</log4net>

</configuration>
