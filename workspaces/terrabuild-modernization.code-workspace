{
  "folders": [
    { "path": "../terrabuild-modernization", "name": "🏗️ TerraBuild Modernization" },
    { "path": "../terrabuild-modernization/client", "name": "📱 TerraBuild Client" },
    { "path": "../terrabuild-modernization/server", "name": "⚙️ TerraBuild Server" },
    { "path": "../property-workbench", "name": "🏠 Property Workbench" },
    { "path": "../config", "name": "⚙️ Configuration" },
    { "path": "../tests", "name": "🧪 Property Tests" }
  ],
  "settings": {
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#00B981",
      "titleBar.activeForeground": "#FFFFFF"
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/backend": true,
      "**/frontend": true,
      "**/marketplace": true
    },
    "search.exclude": {
      "**/backend": true,
      "**/frontend": true,
      "**/node_modules": true
    },
    "terrafusion.role": "property_assessment",
    "terrafusion.responsibility": "terrabuild_modernization"
  },
  "extensions": {
    "recommendations": [
      // Frontend & Client
      "ms-vscode.vscode-typescript-next",
      "bradlc.vscode-tailwindcss",
      "wix.vscode-import-cost",

      // Testing
      "ms-playwright.playwright",
      "vitest.explorer",

      // .NET & Server
      "ms-dotnettools.csharp",
      "ms-dotnettools.csdevkit",

      // GIS & PostGIS
      "esri.arcgis-for-vscode",
      "pajkeki.vscode-postgis",

      // DevOps
      "ms-azuretools.vscode-docker",
      "ms-kubernetes-tools.vscode-kubernetes-tools",

      // Docs & Diagrams
      "yzhang.markdown-all-in-one",
      "bierner.markdown-mermaid",

      // Productivity & Git
      "eamodio.gitlens",
      "gruntfuggly.todo-tree",

      // AI
      "github.copilot",
      "github.copilot-chat"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🔧 Build: TerraBuild Client",
        "type": "shell",
        "command": "npm run build",
        "options": { "cwd": "${workspaceFolder}/../terrabuild-modernization/client" },
        "group": { "kind": "build", "isDefault": true }
      },
      {
        "label": "🔧 Build: TerraBuild Server",
        "type": "shell",
        "command": "dotnet build",
        "options": { "cwd": "${workspaceFolder}/../terrabuild-modernization/server" },
        "group": "build"
      },
      {
        "label": "🚀 Run: TerraBuild Server",
        "type": "shell",
        "command": "dotnet run --project TerraBuild.Server --urls http://localhost:5010",
        "options": { "cwd": "${workspaceFolder}/../terrabuild-modernization/server" },
        "isBackground": true
      },
      {
        "label": "📦 Migrate: Database",
        "type": "shell",
        "command": "dotnet ef database update",
        "options": { "cwd": "${workspaceFolder}/../terrabuild-modernization/server" }
      },
      {
        "label": "🧪 Test: Property Tests",
        "type": "shell",
        "command": "dotnet test ../tests --nologo",
        "options": { "cwd": "${workspaceFolder}" },
        "group": "test"
      },
      {
        "label": "📚 Storybook: Start",
        "type": "shell",
        "command": "npm run storybook",
        "options": { "cwd": "${workspaceFolder}/../terrabuild-modernization/client" },
        "isBackground": true
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug: TerraBuild Client (Vite)",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "dev"],
        "cwd": "${workspaceFolder}/../terrabuild-modernization/client",
        "console": "integratedTerminal",
        "preLaunchTask": "📚 Storybook: Start"
      },
      {
        "name": "Debug: TerraBuild Server (CoreCLR)",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "🔧 Build: TerraBuild Server",
        "program": "${workspaceFolder}/../terrabuild-modernization/server/bin/Debug/net8.0/TerraBuild.Server.dll",
        "cwd": "${workspaceFolder}/../terrabuild-modernization/server",
        "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "http://localhost:5010" }
      },
      {
        "name": "Attach: .NET Process",
        "type": "coreclr",
        "request": "attach",
        "processId": "${command:pickProcess}"
      }
    ]
  }
}
