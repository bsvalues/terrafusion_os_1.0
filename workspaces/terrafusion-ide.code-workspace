{
  "folders": [
    {
      "path": "../marketplace/TerraFusionIDE/core-editor",
      "name": "💻 IDE Core Editor"
    },
    {
      "path": "../marketplace/TerraFusionIDE/language-services",
      "name": "🔤 Language Services"
    },
    {
      "path": "../marketplace/TerraFusionIDE/ai-assistant",
      "name": "🤖 AI Code Assistant"
    },
    {
      "path": "../marketplace/TerraFusionIDE/project-management",
      "name": "📂 Project Management"
    },
    {
      "path": "../marketplace/TerraFusionIDE/government-templates",
      "name": "🏛️ Government Code Templates"
    },
    {
      "path": "../marketplace/TerraFusionIDE/testing",
      "name": "🧪 IDE Tests"
    },
    {
      "path": "../SDK",
      "name": "📦 Platform SDK (read-only)"
    },
    {
      "path": "../backend",
      "name": "🔧 Shared Backend (read-only)"
    },
    {
      "path": "../docs/terrafusion-ide",
      "name": "📚 IDE Docs"
    },
    {
      "path": "../config",
      "name": "⚙️ Config (shared)"
    },
    {
      "path": "../docs/terrafusion_ide",
      "name": "📚 Terrafusion-Ide Docs"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/out": true,
      "**/.vscode-test": true,
      "../marketplace/*/": true,
      "!../marketplace/TerraFusionIDE": false,
      "../frontend": true,
      "../backend": true,
      "../os-platform": true,
      "../terrafusion-cos": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/out": true,
      "../frontend": true,
      "../backend": true,
      "../os-platform": true
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "eslint.workingDirectories": [
      "./marketplace/TerraFusionIDE/core-editor",
      "./marketplace/TerraFusionIDE/language-services"
    ],
    "terrafusion.sync": {
      "autoSync": true,
      "syncInterval": 20,
      "conflictResolution": "prompt",
      "sharedState": {
        "backend": "read-only",
        "sdk": "read-only",
        "config": "shared-write"
      },
      "ideIntegration": true
    },
    "terrafusion.ide": {
      "enableAIAssistant": true,
      "governmentTemplates": true,
      "languageServices": true,
      "projectManagement": true,
      "codeGeneration": true
    },
    "terrafusion.compliance": {
      "fismaMode": "MODERATE",
      "nist80053": true,
      "section508": true,
      "auditTrail": "comprehensive",
      "developmentCompliance": true
    }
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "streetsidesoftware.code-spell-checker",
      "usernamehw.errorlens",
      "eamodio.gitlens",
      "ms-vscode.extension-test-runner",
      "ms-vscode.vscode-js-profile-table",
      "ms-vscode.vscode-json",
      "ms-azuretools.vscode-docker"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Start IDE Core Editor",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/TerraFusionIDE/core-editor",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "console": "integratedTerminal",
        "env": {
          "TERRAFUSION_SERVICE": "terrafusion-ide",
          "IDE_MODE": "development"
        }
      },
      {
        "name": "Launch Extension Host",
        "type": "extensionHost",
        "request": "launch",
        "args": [
          "--extensionDevelopmentPath=${workspaceFolder}/marketplace/TerraFusionIDE"
        ],
        "outFiles": [
          "${workspaceFolder}/marketplace/TerraFusionIDE/out/**/*.js"
        ]
      },
      {
        "name": "Debug AI Assistant",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/TerraFusionIDE/ai-assistant",
        "program": "ai_assistant.js",
        "console": "integratedTerminal",
        "env": {
          "AI_DEBUG": "true",
          "GOVERNMENT_MODE": "true"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build TerraFusion IDE",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "build:ide"
        ],
        "problemMatcher": [
          "$tsc"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Test TerraFusion IDE",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "test:ide"
        ],
        "problemMatcher": [],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      },
      {
        "label": "Package Extension",
        "type": "shell",
        "command": "vsce",
        "args": [
          "package"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/TerraFusionIDE"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Install Extension Locally",
        "type": "shell",
        "command": "code",
        "args": [
          "--install-extension",
          "terrafusion-ide-0.0.1.vsix"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/TerraFusionIDE"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Generate Government Templates",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "generate:templates"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/TerraFusionIDE/government-templates"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Test AI Assistant",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "test:ai-assistant"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/TerraFusionIDE/ai-assistant"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Sync with Backend Changes",
        "type": "shell",
        "command": "./SDK/tools/sync-backend-changes.sh",
        "args": [
          "--service=terrafusion-ide"
        ],
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Validate Integration",
        "type": "shell",
        "command": "./SDK/tools/validate-integration.sh",
        "args": [
          "--service=terrafusion-ide",
          "--extension-validation"
        ],
        "problemMatcher": [],
        "group": "none"
      }
    ]
  }
}