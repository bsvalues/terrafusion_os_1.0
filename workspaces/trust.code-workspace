{
  "folders": [
    {
      "path": "../os-platform/trust/zero-trust-architecture",
      "name": "🛡️ Zero Trust Architecture"
    },
    {
      "path": "../os-platform/trust/identity-verification",
      "name": "🔐 Identity Verification"
    },
    {
      "path": "../os-platform/trust/access-control",
      "name": "🚪 Access Control"
    },
    {
      "path": "../os-platform/trust/threat-intelligence",
      "name": "🔍 Threat Intelligence"
    },
    {
      "path": "../os-platform/trust/security-orchestration",
      "name": "🎯 Security Orchestration"
    },
    {
      "path": "../os-platform/trust/compliance-monitoring",
      "name": "📋 Compliance Monitoring"
    },
    {
      "path": "../os-platform/trust/audit-logging",
      "name": "📝 Audit Logging"
    },
    {
      "path": "../os-platform/trust/incident-response",
      "name": "🚨 Incident Response"
    },
    {
      "path": "../os-platform/trust/risk-assessment",
      "name": "⚖️ Risk Assessment"
    },
    {
      "path": "../os-platform/trust/encryption-management",
      "name": "🔒 Encryption Management"
    },
    {
      "path": "../SDK",
      "name": "📦 Platform SDK (read-only)"
    },
    {
      "path": "../backend",
      "name": "🔧 Shared Backend (read-only)"
    },
    {
      "path": "../docs/trust",
      "name": "📚 Trust Docs"
    },
    {
      "path": "../config",
      "name": "⚙️ Config (shared)"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/out": true,
      "**/.pytest_cache": true,
      "../marketplace": true,
      "../frontend": true,
      "../backend": true,
      "../terrafusion-cos": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/out": true,
      "../marketplace": true,
      "../frontend": true,
      "../backend": true
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "python.defaultInterpreter": "./os-platform/trust/.venv/bin/python",
    "eslint.workingDirectories": [
      "./os-platform/trust/zero-trust-architecture",
      "./os-platform/trust/security-orchestration"
    ],
    "terrafusion.sync": {
      "autoSync": true,
      "syncInterval": 15,
      "conflictResolution": "trust-priority",
      "sharedState": {
        "backend": "read-only",
        "sdk": "read-only",
        "config": "shared-write"
      },
      "trustIntegration": true
    },
    "terrafusion.trust": {
      "enableZeroTrust": true,
      "identityVerification": true,
      "accessControl": true,
      "threatIntelligence": true,
      "securityOrchestration": true,
      "complianceMonitoring": true,
      "auditLogging": true,
      "incidentResponse": true,
      "riskAssessment": true,
      "encryptionManagement": true
    },
    "terrafusion.zeroTrust": {
      "architecture": "comprehensive",
      "verificationMode": "continuous",
      "leastPrivilege": true,
      "microsegmentation": true,
      "adaptiveAccess": true
    },
    "terrafusion.compliance": {
      "fismaMode": "HIGH",
      "nist80053": true,
      "fedramp": "HIGH",
      "sox": true,
      "hipaa": true,
      "gdpr": true,
      "continuousMonitoring": true,
      "auditTrail": "comprehensive",
      "securityValidation": true
    },
    "terrafusion.encryption": {
      "algorithm": "AES-256-GCM",
      "keyManagement": "hsm",
      "quantumResistant": true,
      "endToEnd": true,
      "atRest": true,
      "inTransit": true
    },
    "terrafusion.security": {
      "orchestrationMode": "automated",
      "responseTime": "<1min",
      "threatDetection": "ml-enhanced",
      "forensicsEnabled": true,
      "behaviorAnalytics": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.debugpy",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "streetsidesoftware.code-spell-checker",
      "ms-azuretools.vscode-docker",
      "ms-kubernetes-tools.vscode-kubernetes-tools",
      "redhat.vscode-yaml",
      "ms-vscode.vscode-json",
      "usernamehw.errorlens",
      "github.vscode-github-actions",
      "ms-vscode.azure-account"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Start Zero Trust Controller",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/os-platform/trust/zero-trust-architecture",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "console": "integratedTerminal",
        "env": {
          "TERRAFUSION_SERVICE": "zero-trust",
          "TRUST_MODE": "active",
          "SECURITY_LEVEL": "maximum"
        }
      },
      {
        "name": "Debug Identity Verification",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/os-platform/trust/identity-verification",
        "program": "identity_verifier.py",
        "console": "integratedTerminal",
        "env": {
          "IDENTITY_DEBUG": "true",
          "VERIFICATION_MODE": "multi-factor"
        }
      },
      {
        "name": "Debug Access Control",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/os-platform/trust/access-control",
        "program": "access_controller.js",
        "console": "integratedTerminal",
        "env": {
          "ACCESS_DEBUG": "true",
          "CONTROL_MODE": "rbac-enhanced"
        }
      },
      {
        "name": "Start Threat Intelligence",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/os-platform/trust/threat-intelligence",
        "program": "threat_analyzer.py",
        "console": "integratedTerminal",
        "env": {
          "THREAT_DEBUG": "true",
          "INTELLIGENCE_MODE": "real-time"
        }
      },
      {
        "name": "Debug Security Orchestrator",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/os-platform/trust/security-orchestration",
        "program": "security_orchestrator.js",
        "console": "integratedTerminal",
        "env": {
          "ORCHESTRATION_DEBUG": "true",
          "AUTOMATION_MODE": "full"
        }
      },
      {
        "name": "Start Compliance Monitor",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/os-platform/trust/compliance-monitoring",
        "program": "compliance_monitor.py",
        "console": "integratedTerminal",
        "env": {
          "COMPLIANCE_DEBUG": "true",
          "MONITORING_MODE": "continuous"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build Trust Platform",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "build:trust"
        ],
        "problemMatcher": [
          "$tsc"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Test Trust Platform",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "test:trust"
        ],
        "problemMatcher": [],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      },
      {
        "label": "Deploy Zero Trust",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "deploy:zerotrust"
        ],
        "options": {
          "cwd": "${workspaceFolder}/os-platform/trust/zero-trust-architecture"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Verify Identity",
        "type": "shell",
        "command": "python",
        "args": [
          "verify_identity.py",
          "--method",
          "${input:verificationMethod}"
        ],
        "options": {
          "cwd": "${workspaceFolder}/os-platform/trust/identity-verification"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Check Access Control",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "check:access"
        ],
        "options": {
          "cwd": "${workspaceFolder}/os-platform/trust/access-control"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Analyze Threats",
        "type": "shell",
        "command": "python",
        "args": [
          "threat_analysis.py",
          "--source",
          "${input:threatSource}"
        ],
        "options": {
          "cwd": "${workspaceFolder}/os-platform/trust/threat-intelligence"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Orchestrate Security",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "orchestrate"
        ],
        "options": {
          "cwd": "${workspaceFolder}/os-platform/trust/security-orchestration"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Monitor Compliance",
        "type": "shell",
        "command": "python",
        "args": [
          "monitor_compliance.py",
          "--framework",
          "${input:complianceFramework}"
        ],
        "options": {
          "cwd": "${workspaceFolder}/os-platform/trust/compliance-monitoring"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Generate Audit Report",
        "type": "shell",
        "command": "python",
        "args": [
          "generate_audit.py",
          "--period",
          "${input:auditPeriod}"
        ],
        "options": {
          "cwd": "${workspaceFolder}/os-platform/trust/audit-logging"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Respond to Incident",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "incident:respond"
        ],
        "options": {
          "cwd": "${workspaceFolder}/os-platform/trust/incident-response"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Assess Risk",
        "type": "shell",
        "command": "python",
        "args": [
          "risk_assessment.py",
          "--scope",
          "${input:riskScope}"
        ],
        "options": {
          "cwd": "${workspaceFolder}/os-platform/trust/risk-assessment"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Manage Encryption",
        "type": "shell",
        "command": "python",
        "args": [
          "encryption_manager.py",
          "--operation",
          "${input:encryptionOperation}"
        ],
        "options": {
          "cwd": "${workspaceFolder}/os-platform/trust/encryption-management"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Trust Compliance Check",
        "type": "shell",
        "command": "./SDK/tools/compliance-check.sh",
        "args": [
          "--service=trust",
          "--security=maximum"
        ],
        "problemMatcher": [],
        "group": "none"
      }
    ]
  },
  "inputs": [
    {
      "id": "verificationMethod",
      "description": "Select verification method:",
      "default": "multi-factor",
      "type": "pickString",
      "options": [
        "multi-factor",
        "biometric",
        "smart-card",
        "certificate",
        "behavioral",
        "risk-based"
      ]
    },
    {
      "id": "threatSource",
      "description": "Select threat source:",
      "default": "network-traffic",
      "type": "pickString",
      "options": [
        "network-traffic",
        "user-behavior",
        "system-logs",
        "external-feeds",
        "honeypots",
        "dark-web"
      ]
    },
    {
      "id": "complianceFramework",
      "description": "Select compliance framework:",
      "default": "fisma",
      "type": "pickString",
      "options": [
        "fisma",
        "nist-800-53",
        "fedramp",
        "sox",
        "hipaa",
        "gdpr"
      ]
    },
    {
      "id": "auditPeriod",
      "description": "Select audit period:",
      "default": "monthly",
      "type": "pickString",
      "options": [
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "annually",
        "custom"
      ]
    },
    {
      "id": "riskScope",
      "description": "Select risk assessment scope:",
      "default": "system-wide",
      "type": "pickString",
      "options": [
        "system-wide",
        "application-specific",
        "network-infrastructure",
        "data-assets",
        "user-access",
        "third-party"
      ]
    },
    {
      "id": "encryptionOperation",
      "description": "Select encryption operation:",
      "default": "key-rotation",
      "type": "pickString",
      "options": [
        "key-rotation",
        "certificate-renewal",
        "algorithm-upgrade",
        "hsm-management",
        "quantum-preparation",
        "compliance-audit"
      ]
    }
  ]
}