        "collection-optimization-model",
        "citizen-engagement-model",
        "compliance-automation-model",
        "financial-pattern-model",
        "quantum-processing-model",
      ],
    },
    {
      "id": "workflowType",
      "description": "Select workflow automation type:",
      "type": "pickString",
      "options": [
        "collection-process",
        "citizen-notification",
        "compliance-check",
        "payment-processing",
        "dispute-resolution",
        "performance-monitoring",
        "predictive-analytics",
        "ai-decision-support",
      ],
    },
  ],
}
