  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🚀 Launch TerraLevy Full Application Stack",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "dev:terra-levy:full-stack"],
        "console": "integratedTerminal",
        "env": {
          "TERRAFUSION_APPLICATION": "terra-levy",
          "LAUNCH_MODE": "full-stack",
          "AI_INTEGRATION": "enabled",
          "QUANTUM_PROCESSING": "true",
        },
      },
      {
        "name": "TerraLevy Backend Services",
        "type": "coreclr",
        "request": "launch",
        "cwd": "${workspaceFolder}/terra-levy/core-services",
        "program": "${workspaceFolder}/terra-levy/core-services/bin/Debug/net8.0/TerraLevy.Core.dll",
        "console": "integratedTerminal",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "TERRAFUSION_APPLICATION": "terra-levy",
          "AI_INTEGRATION": "enabled",
          "QUANTUM_PROCESSING": "true",
          "ANALYTICS_REAL_TIME": "true",
        },
      },
      {
        "name": "TerraLevy Frontend Application",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/frontend/src/applications/terra-levy",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "dev:terra-levy"],
        "console": "integratedTerminal",
        "env": {
          "NODE_ENV": "development",
          "REACT_APP_TERRAFUSION_APPLICATION": "terra-levy",
          "REACT_APP_AI_ASSISTANT": "enabled",
          "REACT_APP_QUANTUM_UI": "true",
          "REACT_APP_IMMERSIVE_MODE": "true",
        },
      },
      {
        "name": "AI Intelligence Engine",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/ai-systems/levy-intelligence",
        "program": "levy_ai_engine.py",
        "args": ["--mode", "development", "--quantum-enhanced"],
        "console": "integratedTerminal",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/ai-systems/levy-intelligence",
          "AI_MODEL": "quantum-levy-specialist",
          "STATISTICAL_ANALYSIS": "phd-level",
          "PATTERN_RECOGNITION": "advanced",
        },
      },
      {
        "name": "Analytics Platform",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/analytics-platform/terra-levy",
        "program": "analytics-engine.ts",
        "runtimeArgs": ["--loader", "tsx/esm"],
        "console": "integratedTerminal",
        "env": {
          "NODE_ENV": "development",
          "ANALYTICS_MODE": "real-time",
          "QUANTUM_ALGORITHMS": "enabled",
          "VISUALIZATION": "immersive-3d",
        },
      },
      {
        "name": "🧠 Quantum Workflow Designer",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/workflow-automation/levy-processes",
        "program": "workflow-designer.ts",
        "runtimeArgs": ["--loader", "tsx/esm"],
        "console": "integratedTerminal",
        "env": {
          "WORKFLOW_MODE": "quantum-enhanced",
          "AI_ASSISTANCE": "enabled",
          "USER_LEVEL": "phd-expert",
        },
      },
      {
        "name": "🔬 Data Science Laboratory",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/analytics-platform/terra-levy",
        "program": "data_science_lab.py",
        "args": ["--jupyter-mode", "--advanced-modeling"],
        "console": "integratedTerminal",
        "env": {
          "JUPYTER_ENABLE": "true",
          "STATISTICAL_MODELING": "harvard-mit-level",
          "QUANTUM_COMPUTING": "enabled",
        },
      },
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🏗️ Build TerraLevy Application",
        "type": "shell",
        "command": "npm",
        "args": ["run", "build:terra-levy"],
        "options": {
          "cwd": "${workspaceFolder}",
        },
        "group": {
          "kind": "build",
          "isDefault": true,
        },
        "problemMatcher": ["$msCompile", "$eslint-stylish"],
        "dependsOn": ["Build Backend Services", "Build Frontend Application", "Build AI Models"],
      },
      {
        "label": "Build Backend Services",
        "type": "shell",
        "command": "dotnet",
        "args": ["build", "--configuration", "Debug"],
        "options": {
          "cwd": "${workspaceFolder}/terra-levy/core-services",
        },
        "problemMatcher": ["$msCompile"],
      },
      {
        "label": "Build Frontend Application",
        "type": "shell",
        "command": "npm",
        "args": ["run", "build"],
        "options": {
          "cwd": "${workspaceFolder}/frontend/src/applications/terra-levy",
        },
        "problemMatcher": ["$eslint-stylish"],
      },
      {
        "label": "Build AI Models",
        "type": "shell",
        "command": "python",
        "args": ["build_models.py", "--quantum-enhanced"],
        "options": {
          "cwd": "${workspaceFolder}/ai-systems/levy-intelligence",
        },
        "problemMatcher": [],
      },
      {
        "label": "🧪 Run Comprehensive Test Suite",
        "type": "shell",
        "command": "npm",
        "args": ["run", "test:terra-levy:all"],
        "options": {
          "cwd": "${workspaceFolder}",
        },
        "group": {
          "kind": "test",
          "isDefault": true,
        },
        "problemMatcher": [],
      },
      {
        "label": "🤖 Train AI Models",
        "type": "shell",
        "command": "python",
        "args": ["train_models.py", "--quantum-acceleration", "--phd-level"],
        "options": {
          "cwd": "${workspaceFolder}/ai-systems/levy-intelligence",
        },
        "problemMatcher": [],
      },
      {
        "label": "📊 Generate Analytics Report",
        "type": "shell",
        "command": "python",
        "args": ["generate_report.py", "--advanced-statistics", "--immersive-viz"],
        "options": {
          "cwd": "${workspaceFolder}/analytics-platform/terra-levy",
        },
        "problemMatcher": [],
      },
      {
        "label": "🔄 Deploy Workflow Automation",
        "type": "shell",
        "command": "npm",
        "args": ["run", "deploy:workflows"],
        "options": {
          "cwd": "${workspaceFolder}/workflow-automation/levy-processes",
        },
        "problemMatcher": [],
      },
      {
        "label": "🛡️ Security Compliance Scan",
        "type": "shell",
        "command": "./SDK/tools/security-scan.sh",
        "args": ["--application=terra-levy", "--fisma-high", "--quantum-security"],
        "problemMatcher": [],
      },
      {
        "label": "⚡ Performance Optimization",
        "type": "shell",
        "command": "npm",
        "args": ["run", "optimize:quantum"],
        "options": {
          "cwd": "${workspaceFolder}/performance/monitoring/terra-levy",
        },
        "problemMatcher": [],
      },
      {
        "label": "🔬 Start Data Science Environment",
        "type": "shell",
        "command": "jupyter",
        "args": ["lab", "--port=8888", "--allow-root"],
        "options": {
          "cwd": "${workspaceFolder}/analytics-platform/terra-levy",
        },
        "isBackground": true,
        "problemMatcher": [],
      },
    ],
  },
