{% macro create_table(collection) %}
	<table id="properties">
		<thead>
		<tr>
		{% for h in collection.header %}
			<th>{{ h }}</th>
		{% endfor %}
		</tr>
		</thead>
		<tbody>
		{% for row in collection.to_list() %}
			<tr>
			{% for r in row %}
				{{ r | tag("td") }}
			{% endfor %}
			</tr>
		{% endfor %}
		</tbody>
	</table>
{% endmacro %}
