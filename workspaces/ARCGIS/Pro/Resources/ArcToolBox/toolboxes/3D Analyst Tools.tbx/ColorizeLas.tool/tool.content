{
    "type": "FunctionTool",
    "guid": "{1fdf6b28-fa97-43d3-8d76-5677bcf5fb6f}",
    "displayname": "$rc:title",
    "helpcontent": "5080001",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "9"
    ],
    "params": {
        "in_las_dataset": {
            "display_order": "0",
            "displayname": "$rc:in_las_dataset.title",
            "datatype": {
                "type": "GPLasDatasetLayer"
            },
            "description": "$rc:in_las_dataset.descr"
        },
        "in_image": {
            "display_order": "1",
            "displayname": "$rc:in_image.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "description": "$rc:in_image.descr"
        },
        "bands": {
            "display_order": "2",
            "displayname": "$rc:bands.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPString",
                        "displayname": "$rc:bands.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:bands.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "RED",
                                "code": "$rc:bands.domain.item1.RED"
                            },
                            {
                                "value": "GREEN",
                                "code": "$rc:bands.domain.item1.GREEN"
                            },
                            {
                                "value": "BLUE",
                                "code": "$rc:bands.domain.item1.BLUE"
                            },
                            {
                                "value": "NIR",
                                "code": "$rc:bands.domain.item1.NIR"
                            }
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain"
                    }
                ]
            },
            "description": "$rc:bands.descr"
        },
        "target_folder": {
            "display_order": "3",
            "displayname": "$rc:target_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:target_folder.descr"
        },
        "name_suffix": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:name_suffix.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "value": "_colorized",
            "description": "$rc:name_suffix.descr"
        },
        "las_version": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:las_version.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "1.2",
                        "code": "$rc:las_version.domain.1.2"
                    },
                    {
                        "value": "1.3",
                        "code": "$rc:las_version.domain.1.3"
                    },
                    {
                        "value": "1.4",
                        "code": "$rc:las_version.domain.1.4"
                    }
                ]
            },
            "value": "1.4",
            "description": "$rc:las_version.descr"
        },
        "point_format": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:point_format.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLong",
                        "value": "7",
                        "code": "7"
                    },
                    {
                        "type": "GPLong",
                        "value": "8",
                        "code": "8"
                    }
                ]
            },
            "value": "7",
            "description": "$rc:point_format.descr"
        },
        "compression": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:compression.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NO_COMPRESSION",
                        "code": "$rc:compression.domain.NO_COMPRESSION"
                    },
                    {
                        "value": "ZLAS",
                        "code": "$rc:compression.domain.ZLAS"
                    }
                ]
            },
            "value": "NO_COMPRESSION",
            "description": "$rc:compression.descr"
        },
        "rearrange_points": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:rearrange_points.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "REARRANGE_POINTS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_REARRANGE_POINTS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:rearrange_points.descr"
        },
        "compute_stats": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:compute_stats.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "COMPUTE_STATS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_COMPUTE_STATS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:compute_stats.descr"
        },
        "out_las_dataset": {
            "type": "optional",
            "direction": "out",
            "display_order": "4",
            "displayname": "$rc:out_las_dataset.title",
            "datatype": {
                "type": "DELasDataset"
            },
            "description": "$rc:out_las_dataset.descr"
        },
        "output_folder": {
            "type": "derived",
            "direction": "out",
            "display_order": "11",
            "displayname": "$rc:output_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "depends": [
                "target_folder"
            ]
        }
    },
    "environments": [
        "extent",
        "geographicTransformations",
        "outputCoordinateSystem",
        "workspace"
    ]
