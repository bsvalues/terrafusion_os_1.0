{
    "type": "FunctionTool",
    "guid": "{3950231b-65ee-481e-a667-da9bc7c2cf0f}",
    "displayname": "$rc:title",
    "helpcontent": "5080002",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "9"
    ],
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_las_dataset": {
            "display_order": "0",
            "displayname": "$rc:in_las_dataset.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPLasDatasetLayer"
                    },
                    {
                        "type": "GPSceneServiceLayer"
                    },
                    {
                        "type": "DEFile"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "GPSceneServiceLayerDomain",
                        "servicelayertype": [
                            "ServiceLayerTypePointCloud"
                        ]
                    },
                    {
                        "type": "GPFileDomain",
                        "filetypes": [
                            "las",
                            "lasd",
                            "zlas",
                            "slpk"
                        ]
                    }
                ]
            },
            "description": "$rc:in_las_dataset.descr"
        },
        "target_folder": {
            "display_order": "1",
            "displayname": "$rc:target_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:target_folder.descr"
        },
        "extent": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:extent.title",
            "datatype": {
                "type": "GPExtent"
            },
            "category": "$rc:params.category1",
            "description": "$rc:extent.descr"
        },
        "boundary": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:boundary.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:boundary.descr"
        },
        "process_entire_files": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:process_entire_files.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "PROCESS_ENTIRE_FILES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "PROCESS_EXTENT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:process_entire_files.descr"
        },
        "name_suffix": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:name_suffix.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:name_suffix.descr"
        },
        "remove_vlr": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:remove_vlr.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "REMOVE_VLR"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "MAINTAIN_VLR"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:remove_vlr.descr"
        },
        "rearrange_points": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:rearrange_points.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "REARRANGE_POINTS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "MAINTAIN_POINTS"
                    }
                ]
            },
            "value": "true",
            "category": "$rc:params.category2",
            "description": "$rc:rearrange_points.descr"
        },
        "compute_stats": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:compute_stats.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "COMPUTE_STATS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_COMPUTE_STATS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:compute_stats.descr"
        },
        "out_las_dataset": {
            "type": "optional",
            "direction": "out",
            "display_order": "2",
            "displayname": "$rc:out_las_dataset.title",
            "datatype": {
                "type": "DELasDataset"
            },
            "description": "$rc:out_las_dataset.descr"
        },
        "out_folder": {
            "type": "derived",
            "direction": "out",
            "display_order": "11",
            "displayname": "$rc:out_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "depends": [
                "target_folder"
            ]
        },
        "compression": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:compression.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SAME_AS_INPUT",
                        "code": "$rc:compression.domain.SAME_AS_INPUT"
                    },
                    {
                        "value": "NO_COMPRESSION",
                        "code": "$rc:compression.domain.NO_COMPRESSION"
                    },
                    {
                        "value": "ZLAS",
                        "code": "$rc:compression.domain.ZLAS"
                    }
                ]
            },
            "value": "SAME_AS_INPUT",
            "category": "$rc:params.category2",
            "description": "$rc:compression.descr"
        }
    },
    "environments": [
        "extent",
        "geographicTransformations",
        "outputCoordinateSystem",
        "workspace"
    ]
}
