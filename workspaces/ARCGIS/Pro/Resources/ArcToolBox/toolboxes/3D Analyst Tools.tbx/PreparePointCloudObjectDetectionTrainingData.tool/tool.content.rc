{
    "map": {
        "block_point_limit.descr": "The maximum number of points that can be stored in each block of the training data. When a block contains points in excess of this value, multiple blocks will be created for the same location to ensure that all of the points are used when training. The default is 500,000.",
        "block_point_limit.title": "Block Point Limit",
        "block_size.descr": "The diameter of each block of training data that will be created from the input point cloud. As a general rule, the block size should be large enough to capture the objects of interest and their surrounding context.",
        "block_size.title": "Block Size",
        "blocks_contain_objects.descr": "<xdoc><p>Specifies whether the training data will only include blocks that contain objects or if blocks that do not contain objects will also be included. The data used for validation will not be affected by this parameter.<ul><li>Checked—Only blocks that contain objects will be exported in the training data.</li><li>Unchecked—Both blocks that contain objects and those that don&apos;t will be exported in the training data. This is the default.</li></ul></p></xdoc>",
        "blocks_contain_objects.title": "Only export training blocks that contain objects",
        "description": "Creates point cloud training data for object detection models using deep learning.",
        "excluded_class_codes.descr": "The class codes that will be excluded from the training data. Any value in the range of 0 to 255 can be specified.",
        "excluded_class_codes.title": "Excluded Class Codes",
        "in_point_cloud.descr": "The point cloud that will be used to create the training data for object detection.",
        "in_point_cloud.title": "Input Point Cloud",
        "in_training_features.descr": "The multipatch features that will identify the objects that will be used for training the model.",
        "in_training_features.title": "Input Training Features",
        "in_validation_features.descr": "The multipatch features that will identify the objects that will be used for validating the model during the training process.",
        "in_validation_features.title": "Input Validation Features",
        "out_training_data.descr": "The location and name of the output training data (a *.pcotd file).",
        "out_training_data.title": "Output Training Data",
        "params.category1": "Point Cloud Options",
        "reference_height.descr": "The raster surface that will be used to provide relative height values for each point in the point cloud data. Points that do not overlap with the raster will be omitted from the analysis.",
        "reference_height.title": "Reference Height Surface",
        "title": "Prepare Point Cloud Object Detection Training Data",
        "training_boundary.descr": "<xdoc><p>The polygon features that will delineate the subset of points from the input point cloud that will be used for training the model. This parameter is required when the <span class=\"esri_uicontrol\">Validation Point Cloud</span> parameter value is not provided.</p></xdoc>",
        "training_boundary.title": "Training Boundary Features",
        "training_code_field.descr": "The field that identifies the unique ID for each type of object in the training multipatch features. When no field is defined, the objects are assigned an ID of 0.",
        "training_code_field.title": "Training Code Field",
        "validation_boundary.descr": "<xdoc><p>The polygon features that will delineate the subset of points to be used for validating the model during the training process. If a validation point cloud is not provided, the points will be sourced from the input point cloud and a polygon will be required for the <span class=\"esri_uicontrol\">Training Boundary Features</span> parameter.</p></xdoc>",
        "validation_boundary.title": "Validation Boundary Features",
        "validation_code_field.descr": "The field that identifies the unique ID for each type of object in the validation multipatch features. When no field is defined, the objects are assigned an ID of 0.",
        "validation_code_field.title": "Validation Code Field",
        "validation_point_cloud.descr": "<xdoc><p>The point cloud that will be used to validate the deep learning model during the training process. This dataset must reference a different set of points than the input point cloud to ensure the quality of the trained model. If a validation point cloud is not provided, the input point cloud can be used to define the training and validation datasets by providing polygon feature classes for the <span class=\"esri_uicontrol\">Training Boundary Features</span> and <span class=\"esri_uicontrol\">Validation Boundary Features</span> parameters.</p></xdoc>",
        "validation_point_cloud.title": "Validation Point Cloud"
    }
}
