    "product": "100",
    "params": {
        "in_tin": {
            "displayname": "$rc:in_tin.title",
            "datatype": {
                "type": "GPTinLayer"
            },
            "description": "$rc:in_tin.descr"
        },
        "in_feature_class": {
            "displayname": "$rc:in_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:in_feature_class.descr"
        },
        "in_height_field": {
            "displayname": "$rc:in_height_field.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:in_height_field.descr"
        },
        "reference_plane": {
            "type": "optional",
            "displayname": "$rc:reference_plane.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ABOVE",
                        "code": "$rc:reference_plane.domain.ABOVE"
                    },
                    {
                        "value": "BELOW",
                        "code": "$rc:reference_plane.domain.BELOW"
                    }
                ]
            },
            "value": "BELOW",
            "description": "$rc:reference_plane.descr"
        },
        "out_volume_field": {
            "type": "optional",
            "displayname": "$rc:out_volume_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "Volume",
            "description": "$rc:out_volume_field.descr"
        },
        "surface_area_field": {
            "type": "optional",
            "displayname": "$rc:surface_area_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "SArea",
            "description": "$rc:surface_area_field.descr"
        },
        "output_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_feature_class"
            ]
        }
    },
    "environments": [
        "extent",
        "scratchWorkspace",
        "workspace"
    ]
