{
    "map": {
        "description": "Multiplies the values of two rasters on a cell-by-cell basis.",
        "in_raster_or_constant1.descr": "<xdoc><p>The input containing the values to be multiplied.</p><p>A number can be used as an input for this parameter, provided a raster is specified for the other parameter. To specify a number for both inputs, the cell size and extent must first be set in the environment.</p></xdoc>",
        "in_raster_or_constant1.title": "Input raster or constant value 1",
        "in_raster_or_constant2.descr": "<xdoc><p>The input containing the values by which the first input will be multiplied.</p><p>A number can be used as an input for this parameter, provided a raster is specified for the other parameter. To specify a number for both inputs, the cell size and extent must first be set in the environment.</p></xdoc>",
        "in_raster_or_constant2.title": "Input raster or constant value 2",
        "out_raster.descr": "<xdoc><p>The output raster.</p><p>The cell values are the product of the first input multiplied by the second.</p></xdoc>",
        "out_raster.title": "Output raster",
        "title": "Times"
    }
}
