            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPLong"
                }
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                },
                "high": {
                    "allow": "true",
                    "val": "255"
                }
            },
            "description": "$rc:excluded_class_codes.descr"
        },
        "batch_size": {
            "type": "optional",
            "display_order": "5",
