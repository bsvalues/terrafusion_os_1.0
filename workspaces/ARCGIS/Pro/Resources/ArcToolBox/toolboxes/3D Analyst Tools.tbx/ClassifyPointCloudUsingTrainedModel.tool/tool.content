        "compute_stats": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:compute_stats.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "COMPUTE_STATS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_COMPUTE_STATS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:compute_stats.descr"
        },
        "boundary": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:boundary.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:boundary.descr"
        },
        "update_pyramid": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:update_pyramid.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "UPDATE_PYRAMID"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_UPDATE_PYRAMID"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:update_pyramid.descr"
        },
        "out_point_cloud": {
            "type": "derived",
            "direction": "out",
            "display_order": "11",
            "displayname": "$rc:out_point_cloud.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "clonedependency": "true"
            }
        },
        "reference_height": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:reference_height.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
