    ],
    "params": {
        "input": {
            "displayname": "$rc:input.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPComposite",
                    "datatypes": [
                        {
                            "type": "DEFile"
                        },
                        {
                            "type": "DEFolder"
                        }
                    ]
                }
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFileDomain",
                        "filetypes": [
                            "rawfilemode"
                        ]
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:input.descr"
        },
        "in_file_type": {
            "displayname": "$rc:in_file_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "XYZ",
                        "code": "$rc:in_file_type.domain.XYZ"
                    },
                    {
                        "value": "XYZI",
                        "code": "$rc:in_file_type.domain.XYZI"
                    },
                    {
                        "value": "GENERATE",
                        "code": "$rc:in_file_type.domain.GENERATE"
                    }
                ]
            },
            "value": "XYZ",
            "description": "$rc:in_file_type.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "out_geometry_type": {
            "displayname": "$rc:out_geometry_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POINT",
                        "code": "$rc:out_geometry_type.domain.POINT"
                    },
                    {
                        "value": "MULTIPOINT",
                        "code": "$rc:out_geometry_type.domain.MULTIPOINT"
                    },
                    {
                        "value": "POLYLINE",
                        "code": "$rc:out_geometry_type.domain.POLYLINE"
                    },
                    {
                        "value": "POLYGON",
                        "code": "$rc:out_geometry_type.domain.POLYGON"
                    }
                ]
            },
            "value": "MULTIPOINT",
            "description": "$rc:out_geometry_type.descr"
        },
        "z_factor": {
            "type": "optional",
            "displayname": "$rc:z_factor.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "1",
            "description": "$rc:z_factor.descr"
        },
        "input_coordinate_system": {
            "type": "optional",
            "displayname": "$rc:input_coordinate_system.title",
            "datatype": {
                "type": "GPCoordinateSystem"
            },
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:input_coordinate_system.descr"
        },
        "average_point_spacing": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:average_point_spacing.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:average_point_spacing.descr"
        },
        "file_suffix": {
            "type": "optional",
            "displayname": "$rc:file_suffix.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:file_suffix.descr"
        },
        "decimal_separator": {
            "type": "optional",
            "displayname": "$rc:decimal_separator.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DECIMAL_POINT",
                        "code": "$rc:decimal_separator.domain.DECIMAL_POINT"
                    },
                    {
                        "value": "DECIMAL_COMMA",
