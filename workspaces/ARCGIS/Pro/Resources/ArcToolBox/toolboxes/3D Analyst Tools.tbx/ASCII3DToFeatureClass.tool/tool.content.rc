{
    "map": {
        "average_point_spacing.descr": "The average planimetric distance between points of the input. This parameter is only used when the output geometry is set to MULTIPOINT, and its function is to provide a means for grouping the points together. This value is used in conjunction with the points per shape limit to construct a virtual tile system used to group the points. The tile system's origin is based on the domain of the target feature class. Specify the spacing in the horizontal units of the target feature class.",
        "average_point_spacing.title": "Average Point Spacing",
        "decimal_separator.descr": "<xdoc><p>The decimal character that will be used in the text file to differentiate the integer of a number from its fractional part.</p><ul><li><span title=\"DECIMAL_POINT\">Point</span>—A point will be used as the decimal character. This is the default.</li><li><span title=\"DECIMAL_COMMA\">Comma</span>—A comma will be used as the decimal character.</li></ul></xdoc>",
        "decimal_separator.domain.DECIMAL_COMMA": "Comma",
        "decimal_separator.domain.DECIMAL_POINT": "Point",
        "decimal_separator.title": "Decimal Separator",
        "description": "Imports 3D features from one or more ASCII files stored in XYZ, XYZI, or GENERATE formats into a new feature class.",
        "file_suffix.descr": "The suffix of the files that will be imported from an input folder. This parameter is required when a folder is specified as input.",
        "file_suffix.title": "File Suffix",
        "in_file_type.descr": "<xdoc><p>The format of the ASCII files that will be converted to a feature class.</p><ul><li><span title=\"XYZ\">XYZ</span>—Text file that contain geometry information stored as XYZ coordinates.</li><li><span title=\"XYZI\">XYZI</span>—Text files that contain XYZ coordinates alongside intensity measurements.</li><li><span title=\"GENERATE\">Generate</span>—Text files structured in the Generate format.</li></ul></xdoc>",
        "in_file_type.domain.GENERATE": "Generate",
        "in_file_type.domain.XYZ": "XYZ",
        "in_file_type.domain.XYZI": "XYZI",
        "in_file_type.title": "File Format",
        "input.descr": "<xdoc><p>The ASCII files or folders containing data in XYZ, XYZI (with lidar intensity), or 3D GENERATE format. All input files must be in the same format. If a folder is specified, the <span class=\"esri_uicontrol\">File Suffix</span> parameter becomes required, and all the files that have the same extension as the specified suffix will be processed.</p><p>In the <span class=\"esri_uicontrol\">Geoprocessing</span> pane, a folder can also be specified as an input by selecting the folder in File Explorer and dragging it onto the parameter&apos;s input box.</p></xdoc>",
        "input.title": "ASCII 3D Data",
        "input_coordinate_system.descr": "The coordinate system of the input data. The default is an Unknown Coordinate System. If specified, the output may or may not be projected into a different coordinate system. This depends the whether the geoprocessing environment has a coordinate system defined for the location of the target feature class.",
        "input_coordinate_system.title": "Coordinate System",
        "out_feature_class.descr": "The feature class that will be produced.",
        "out_feature_class.title": "Output Feature Class",
        "out_geometry_type.descr": "<xdoc><p>The geometry type of the output feature class.</p><ul><li><span title=\"MULTIPOINT\">Multipoint features</span>—Multipoints are recommended the input data contains a large number of points and attributes per feature are not required.</li><li><span title=\"POINT\">Point features</span>—Each XYZ coordinate will produce one point feature.</li><li><span title=\"POLYLINE\">Polyline features</span>—The output will contain polyline features.</li><li><span title=\"POLYGON\">Polygon features</span>—The output will contain polygon features.</li></ul></xdoc>",
        "out_geometry_type.domain.MULTIPOINT": "Multipoint features",
        "out_geometry_type.domain.POINT": "Point features",
        "out_geometry_type.domain.POLYGON": "Polygon features",
        "out_geometry_type.domain.POLYLINE": "Polyline features",
        "out_geometry_type.title": "Output Feature Class Type",
        "title": "ASCII 3D To Feature Class",
        "z_factor.descr": "The factor by which z-values will be multiplied. This is typically used to convert z linear units to match x,y linear units. The default is 1, which leaves elevation values unchanged. This parameter is not available if the spatial reference of the input surface has a z-datum with a specified linear unit.",
        "z_factor.title": "Z Factor"
    }
}
