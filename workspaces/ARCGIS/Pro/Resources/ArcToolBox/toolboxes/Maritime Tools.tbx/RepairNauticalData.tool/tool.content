    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "50"
    ],
    "params": {
        "in_workspace": {
            "display_order": "0",
            "displayname": "$rc:in_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:in_workspace.descr"
        },
        "repair_operations": {
            "display_order": "1",
            "control_guid": "{38C34610-C7F7-11D5-A693-0008C711C8C1}",
            "displayname": "$rc:repair_operations.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FIX_LNAM",
                        "code": "$rc:repair_operations.domain.FIX_LNAM"
                    },
                    {
                        "value": "REMOVE_ORPHAN_RELATIONSHIPS",
                        "code": "$rc:repair_operations.domain.REMOVE_ORPHAN_RELATIONSHIPS"
                    },
                    {
                        "value": "MOVE_EQUIPMENT_FEATURES",
                        "code": "$rc:repair_operations.domain.MOVE_EQUIPMENT_FEATURES"
                    },
                    {
                        "value": "NUDGE_BOUNDARY_FEATURES",
                        "code": "$rc:repair_operations.domain.NUDGE_BOUNDARY_FEATURES"
                    }
                ]
            },
            "description": "$rc:repair_operations.descr"
        },
        "updated_workspace": {
            "type": "derived",
            "direction": "out",
            "display_order": "2",
            "displayname": "$rc:updated_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "depends": [
                "in_workspace"
            ]
        }
    },
    "environments": [
        "workspace"
    ]
}
