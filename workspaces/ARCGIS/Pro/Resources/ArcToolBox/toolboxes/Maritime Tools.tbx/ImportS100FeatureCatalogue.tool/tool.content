{
    "type": "FunctionTool",
    "guid": "{C5CD7E91-50D4-44D2-B98B-151009423D52}/ImportS100FeatureCatalogue",
    "displayname": "$rc:title",
    "helpcontent": "63000001",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "50"
    ],
    "params": {
        "in_feature_catalogue": {
            "display_order": "0",
            "displayname": "$rc:in_feature_catalogue.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xml"
                ]
            },
            "defaultenvironmentname": "S100FeatureCatalogueFile",
            "description": "$rc:in_feature_catalogue.descr"
        },
        "target_workspace": {
            "display_order": "1",
            "displayname": "$rc:target_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:target_workspace.descr"
        },
        "admin_connection": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:admin_connection.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "sde"
                ]
            },
            "depends": [
                "target_workspace"
            ],
            "description": "$rc:admin_connection.descr"
        },
        "output_workspace": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "depends": [
                "target_workspace"
            ]
        },
        "coordinate_system": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:coordinate_system.title",
            "datatype": {
                "type": "GPCoordinateSystem"
            },
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:coordinate_system.descr"
        },
        "subtype_mapping": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:subtype_mapping.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xml"
                ]
            },
            "description": "$rc:subtype_mapping.descr"
        },
        "config_keyword": {
            "type": "optional",
            "displayname": "$rc:config_keyword.title",
            "datatype": {
                "type": "GPString"
            },
            "defaultenvironmentname": "configKeyword",
            "description": "$rc:config_keyword.descr"
        }
    },
    "environments": [
        "S100FeatureCatalogueFile",
        "XYResolution",
        "XYTolerance",
        "ZResolution",
        "ZTolerance",
        "outputCoordinateSystem",
        "workspace"
    ]
}
