{
    "type": "FunctionTool",
    "guid": "{26B17338-CB00-45A9-AB9C-858C2E0122C9}/FillGaps",
    "displayname": "$rc:title",
    "helpcontent": "43110009",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "input_features": {
            "displayname": "$rc:input_features.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_features.descr"
        },
        "max_gap_area": {
            "displayname": "$rc:max_gap_area.title",
            "datatype": {
                "type": "GPArealUnit"
            },
            "description": "$rc:max_gap_area.descr"
        },
        "fill_option": {
            "type": "optional",
            "displayname": "$rc:fill_option.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FILL_BY_LENGTH",
                        "code": "$rc:fill_option.domain.FILL_BY_LENGTH"
                    },
                    {
                        "value": "FILL_BY_ORDER",
                        "code": "$rc:fill_option.domain.FILL_BY_ORDER"
                    }
                ]
            },
            "value": "FILL_BY_LENGTH",
            "description": "$rc:fill_option.descr"
        },
        "fill_unenclosed_gaps": {
            "type": "optional",
            "displayname": "$rc:fill_unenclosed_gaps.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "SKIP_UNENCLOSED_GAPS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "FILL_ALL"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:fill_unenclosed_gaps.descr"
        },
        "max_gap_distance": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:max_gap_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:max_gap_distance.descr"
        },
        "updated_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_features.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "depends": [
                "input_features"
            ]
        }
    },
    "environments": [
        "scratchWorkspace"
    ]
}
