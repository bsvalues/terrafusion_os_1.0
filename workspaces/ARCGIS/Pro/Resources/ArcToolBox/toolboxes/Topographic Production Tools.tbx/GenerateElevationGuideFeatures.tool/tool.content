{
    "type": "FunctionTool",
    "guid": "{26B17338-CB00-45A9-AB9C-858C2E0122C9}/GenerateElevationGuideFeatures",
    "displayname": "$rc:title",
    "helpcontent": "46050002",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "params": {
        "in_feature_dataset": {
            "displayname": "$rc:in_feature_dataset.title",
            "datatype": {
                "type": "DEFeatureDataset"
            },
            "description": "$rc:in_feature_dataset.descr"
        },
        "area_of_interest": {
            "displayname": "$rc:area_of_interest.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPLayerDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:area_of_interest.descr"
        },
        "in_rasters": {
            "displayname": "$rc:in_rasters.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPComposite",
                    "datatypes": [
                        {
                            "type": "GPRasterLayer"
                        },
                        {
                            "type": "GPMosaicLayer"
                        }
                    ]
                }
            },
            "description": "$rc:in_rasters.descr"
        },
        "hydro_exclusion_features": {
            "type": "optional",
            "displayname": "$rc:hydro_exclusion_features.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:hydro_exclusion_features.descr"
        },
        "spot_height_features": {
            "type": "optional",
            "displayname": "$rc:spot_height_features.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ]
            },
            "description": "$rc:spot_height_features.descr"
        },
        "hydro_line_features": {
            "type": "optional",
            "displayname": "$rc:hydro_line_features.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:hydro_line_features.descr"
        },
        "hydro_area_features": {
            "type": "optional",
            "displayname": "$rc:hydro_area_features.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:hydro_area_features.descr"
        },
        "contour_interval": {
            "type": "optional",
            "displayname": "$rc:contour_interval.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLong",
                        "value": "10",
                        "code": "10"
                    },
                    {
                        "type": "GPLong",
                        "value": "20",
                        "code": "20"
                    },
                    {
                        "type": "GPLong",
                        "value": "40",
                        "code": "40"
                    },
                    {
                        "type": "GPLong",
                        "value": "80",
                        "code": "80"
                    }
                ]
            },
            "value": "20",
            "description": "$rc:contour_interval.descr"
        },
        "bands_minarea": {
            "type": "optional",
            "displayname": "$rc:bands_minarea.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0.00016",
            "description": "$rc:bands_minarea.descr"
        },
        "smooth_tolerance": {
            "type": "optional",
            "displayname": "$rc:smooth_tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "value": "0.002 DecimalDegrees",
            "description": "$rc:smooth_tolerance.descr"
        },
        "number_of_bands": {
            "type": "optional",
            "displayname": "$rc:number_of_bands.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLong",
                        "value": "1",
                        "code": "1"
                    },
                    {
                        "type": "GPLong",
                        "value": "2",
                        "code": "2"
                    },
                    {
                        "type": "GPLong",
                        "value": "3",
                        "code": "3"
                    },
                    {
                        "type": "GPLong",
                        "value": "4",
                        "code": "4"
                    }
                ]
            },
            "description": "$rc:number_of_bands.descr"
        },
        "height_field": {
            "type": "optional",
            "displayname": "$rc:height_field.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Double",
                    "Long",
                    "Float",
                    "Short"
                ]
            },
            "depends": [
                "spot_height_features"
            ],
            "description": "$rc:height_field.descr"
        },
        "search_distance": {
            "type": "optional",
            "displayname": "$rc:search_distance.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "value": "0 Meters",
            "description": "$rc:search_distance.descr"
        },
        "hydroline_minlength": {
            "type": "optional",
            "displayname": "$rc:hydroline_minlength.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:hydroline_minlength.descr"
