{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "46040004",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "49"
    ],
    "params": {
        "Root_Folder": {
            "displayname": "$rc:root_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:root_folder.descr"
        },
        "Target_Geodatabase": {
            "displayname": "$rc:target_geodatabase.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "description": "$rc:target_geodatabase.descr"
        },
        "Output_Geodatabase": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_geodatabase.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "schema": {
                "type": "GPContainerSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "workspace"
    ]
}
