{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "43110016",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "params": {
        "input_geodatabase": {
            "displayname": "$rc:input_geodatabase.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "description": "$rc:input_geodatabase.descr"
        },
        "target_geodatabase": {
            "displayname": "$rc:target_geodatabase.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "description": "$rc:target_geodatabase.descr"
        },
        "rule_file": {
            "displayname": "$rc:rule_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xlsx",
                    "xlsm"
                ]
            },
            "description": "$rc:rule_file.descr"
        },
        "data_theme": {
            "displayname": "$rc:data_theme.title",
            "datatype": {
                "type": "GPString"
            },
            "depends": [
                "rule_file"
            ],
            "description": "$rc:data_theme.descr"
        },
        "export_visible_features": {
            "type": "optional",
            "displayname": "$rc:export_visible_features.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "EXPORT_VISIBLE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "EXPORT_ALL"
                    }
                ]
            },
            "description": "$rc:export_visible_features.descr"
        },
        "updated_geodatabase": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_geodatabase.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "depends": [
                "target_geodatabase"
            ],
            "schema": {
                "type": "GPContainerSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    }
}
