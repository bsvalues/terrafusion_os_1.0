{
    "map": {
        "analysis_type.descr": "<xdoc><p>Specifies the analysis type.</p><ul><li><span title=\"AREA_VOLUME\">Area and Volume</span>—Both surface areas and total volumes are calculated at each elevation increment. This is the default.</li><li><span title=\"AREA\">Area</span>—Surface area is calculated at each elevation increment.</li><li><span title=\"VOLUME\">Volume</span>—Total volume is calculated at each elevation increment.</li></ul></xdoc>",
        "analysis_type.domain.AREA": "Area",
        "analysis_type.domain.AREA_VOLUME": "Area and Volume",
        "analysis_type.domain.VOLUME": "Volume",
        "analysis_type.title": "Analysis type",
        "description": "Creates a table and a chart of elevations and corresponding storage capacities for an input surface raster. The tool calculates the surface area and total volume of the underlying region at a series of elevation increments.",
        "in_surface_raster.descr": "The input raster representing a continuous surface.",
        "in_surface_raster.title": "Input surface raster",
        "in_zone_data.descr": "<xdoc><p>The dataset that defines the zones.</p><p>The zones can be defined by an integer raster or a feature layer.</p></xdoc>",
        "in_zone_data.title": "Input raster or feature zone data",
        "increment.descr": "An incremental value that is either the number of increments or the difference in elevation between increments. The value is determined based on the increment type parameter value.",
        "increment.title": "Increment",
        "increment_type.descr": "<xdoc><p>Specifies the increment type to use when computing elevation increments between minimum and maximum elevations.</p><ul><li><span title=\"NUMBER_OF_INCREMENTS\">Number of Increments</span>—The number of increments between minimum and maximum elevations is used. This is the default.</li><li><span title=\"VALUE_OF_INCREMENT\">Value of Increment</span>—The elevation difference between each increment is used.</li></ul></xdoc>",
        "increment_type.domain.NUMBER_OF_INCREMENTS": "Number of Increments",
        "increment_type.domain.VALUE_OF_INCREMENT": "Value of Increment",
        "increment_type.title": "Increment type",
        "max_elevation.descr": "<xdoc><p>The maximum elevation from which storage capacities are assessed.</p><p>By default, the tool uses the maximum surface raster value in each zone as the maximum elevation for that zone. If a value is provided, it is used as the maximum elevation across all zones.</p></xdoc>",
        "max_elevation.title": "Maximum elevation",
        "min_elevation.descr": "<xdoc><p>The minimum elevation from which storage capacities are assessed.</p><p>By default, the tool uses the minimum surface raster value in each zone as the minimum elevation for that zone. If a value is provided, it is used as the minimum elevation across all zones.</p></xdoc>",
        "min_elevation.title": "Minimum elevation",
        "out_chart.descr": "<xdoc><p>The name of the output chart for display.</p><p>The chart is listed in the <span class=\"esri_uicontrol\">Contents</span> pane under <span class=\"esri_uicontrol\">Standalone Tables</span>.</p></xdoc>",
        "out_chart.title": "Output chart name",
        "out_table.descr": "The output table that contains for each zone the surface area and total volumes for each increment in elevation.",
        "out_table.title": "Output table",
        "title": "Storage Capacity",
        "z_unit.descr": "<xdoc><p>Specifies the linear unit that will be used for vertical z-values.</p><ul><li><span title=\"INCH\">Inch</span>—The linear unit will be inches.</li><li><span title=\"FOOT\">Foot</span>—The linear unit will be feet.</li><li><span title=\"YARD\">Yard</span>—The linear unit will be yards.</li><li><span title=\"MILE_US\">Mile US</span>—The linear unit will be miles.</li><li><span title=\"NAUTICAL_MILE\">Nautical mile</span>—The linear unit will be nautical miles.</li><li><span title=\"MILLIMETER\">Millimeter</span>—The linear unit will be millimeters.</li><li><span title=\"CENTIMETER\">Centimeter</span>—The linear unit will be centimeters.</li><li><span title=\"METER\">Meter</span>—The linear unit will be meters.</li><li><span title=\"KILOMETER\">Kilometer</span>—The linear unit will be kilometers.</li><li><span title=\"DECIMETER\">Decimeter</span>—The linear unit will be decimeters.</li></ul></xdoc>",
        "z_unit.domain.CENTIMETER": "Centimeter",
        "z_unit.domain.DECIMETER": "Decimeter",
        "z_unit.domain.FOOT": "Foot",
        "z_unit.domain.INCH": "Inch",
        "z_unit.domain.KILOMETER": "Kilometer",
        "z_unit.domain.METER": "Meter",
        "z_unit.domain.MILE_US": "Mile US",
        "z_unit.domain.MILLIMETER": "Millimeter",
        "z_unit.domain.NAUTICAL_MILE": "Nautical mile",
        "z_unit.domain.YARD": "Yard",
        "z_unit.title": "Z unit",
        "zone_field.descr": "<xdoc><p>The field that contains the values that define each zone.</p><p>It can be an integer or a string field of the zone dataset.</p></xdoc>",
        "zone_field.title": "Zone field"
    }
}
