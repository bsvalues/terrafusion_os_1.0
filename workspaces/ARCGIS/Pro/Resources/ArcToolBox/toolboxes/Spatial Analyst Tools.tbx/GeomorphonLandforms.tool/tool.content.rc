{
    "map": {
        "angle_threshold.descr": "<xdoc><p>The angle threshold (in degrees) below which the target cell will be classified as flat.</p><p>The default value is 1 degree. Specifying a larger value than the default is recommended for low resolution DEMs.</p></xdoc>",
        "angle_threshold.title": "Flat terrain angle threshold",
        "description": "Calculates the geomorphon pattern of each cell of an input surface raster and classifies calculated geomorphons into common landform types.",
        "distance_units.descr": "<xdoc><p>Specifies the distance unit that will be used for the <span class=\"esri_uicontrol\">Search distance</span> and <span class=\"esri_uicontrol\">Skip distance</span> parameters.</p><p>Distance will be measured in the specified unit or number of cells. The default is <span class=\"esri_uicontrol\">Cells</span>.</p><ul><li><span title=\"CELLS\">Cells</span>—The distance unit will be cells.</li><li><span title=\"METERS\">Meters</span>—The distance unit will be meters.</li><li><span title=\"CENTIMETERS\">Centimeters</span>—The distance unit will be centimeters.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The distance unit will be kilometers.</li><li><span title=\"INCHES\">Inches</span>—The distance unit will be inches.</li><li><span title=\"FEET\">Feet</span>—The distance unit will be feet.</li><li><span title=\"YARDS\">Yard</span>—The distance unit will be yards.</li><li><span title=\"MILES\">Miles</span>—The distance unit will be miles.</li></ul></xdoc>",
        "distance_units.domain.CELLS": "Cells",
        "distance_units.domain.CENTIMETERS": "Centimeters",
        "distance_units.domain.FEET": "Feet",
        "distance_units.domain.INCHES": "Inches",
        "distance_units.domain.KILOMETERS": "Kilometers",
        "distance_units.domain.METERS": "Meters",
        "distance_units.domain.MILES": "Miles",
        "distance_units.domain.YARDS": "Yard",
        "distance_units.title": "Distance units",
        "in_surface_raster.descr": "The input surface raster.",
        "in_surface_raster.title": "Input surface raster",
        "out_geomorphons_raster.descr": "<xdoc><p>Each geomorphon pattern will be assigned a unique identifier, which is stored for each cell in the output geomorphons raster.</p><p>The output is of integer type.</p></xdoc>",
        "out_geomorphons_raster.title": "Output geomorphons raster",
        "out_landforms_raster.descr": "<xdoc><p>The output classified landforms raster.</p><p>The output is of integer type.</p><p>Each value corresponds to a specific landform type: Flat—cell value 1, Peak—cell value 2, Ridge—cell value 3, Shoulder—cell value 4, Spur—cell value 5, Slope—cell value 6, Hollow—cell value 7, Footslope—cell value 8, Valley—cell value 9, Pit—cell value 10.</p></xdoc>",
        "out_landforms_raster.title": "Output landforms raster",
        "search_distance.descr": "<xdoc><p>The distance away from the target cell that defines the radius of the area that will be used to identify the geomorphon pattern.</p><p>The default value is 10. Use a search distance value that matches the type and size of the landforms that you want to classify.</p></xdoc>",
        "search_distance.title": "Search distance",
        "skip_distance.descr": "<xdoc><p>The distance away from the target cell where the analysis area starts. Neighboring cells that fall within this distance will be skipped and won&apos;t contribute to identification of the geomorphon pattern.</p><p>The classification of each individual cell is determined by assessing the neighboring cells within the skip distance from the target cell center.</p></xdoc>",
        "skip_distance.title": "Skip distance",
        "title": "Geomorphon Landforms",
        "z_unit.descr": "<xdoc><p>Specifies the linear unit that will be used for vertical z-values.</p><p>It is defined by a vertical coordinate system if it exists. If no vertical coordinate system exists, define the z-unit using the unit list to ensure correct geodesic computation. The default is meter.</p><ul><li><span title=\"INCH\">Inch</span>—The linear unit will be inches.</li><li><span title=\"FOOT\">Foot</span>—The linear unit will be feet.</li><li><span title=\"YARD\">Yard</span>—The linear unit will be yards.</li><li><span title=\"MILE_US\">Mile US</span>—The linear unit will be miles.</li><li><span title=\"NAUTICAL_MILE\">Nautical mile</span>—The linear unit will be nautical miles.</li><li><span title=\"MILLIMETER\">Millimeter</span>—The linear unit will be millimeters.</li><li><span title=\"CENTIMETER\">Centimeter</span>—The linear unit will be centimeters.</li><li><span title=\"METER\">Meter</span>—The linear unit will be meters.</li><li><span title=\"KILOMETER\">Kilometer</span>—The linear unit will be kilometers.</li><li><span title=\"DECIMETER\">Decimeter</span>—The linear unit will be decimeters.</li></ul></xdoc>",
        "z_unit.domain.CENTIMETER": "Centimeter",
        "z_unit.domain.DECIMETER": "Decimeter",
        "z_unit.domain.FOOT": "Foot",
        "z_unit.domain.INCH": "Inch",
        "z_unit.domain.KILOMETER": "Kilometer",
        "z_unit.domain.METER": "Meter",
        "z_unit.domain.MILE_US": "Mile US",
        "z_unit.domain.MILLIMETER": "Millimeter",
        "z_unit.domain.NAUTICAL_MILE": "Nautical mile",
        "z_unit.domain.YARD": "Yard",
        "z_unit.title": "Z unit"
    }
}
