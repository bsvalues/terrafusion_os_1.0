{
    "map": {
        "description": "Converts a raster representing a linear network to features representing the linear network.",
        "in_flow_direction_raster.descr": "<xdoc><p>The input raster that shows the direction of flow out of each cell.</p><p>The flow direction raster can be created using the Flow Direction tool.</p></xdoc>",
        "in_flow_direction_raster.title": "Input flow direction raster",
        "in_stream_raster.descr": "An input raster that represents a linear stream network.",
        "in_stream_raster.title": "Input stream raster",
        "out_polyline_features.descr": "Output feature class that will hold the converted streams.",
        "out_polyline_features.title": "Output polyline features",
        "simplify.descr": "<xdoc><p>Specifies whether weeding is used.</p><ul><li>Checked—The feature is weeded to reduce the number of vertices. The Douglas-Puecker algorithm for line generalization is used with a tolerance of sqrt(0.5) * cell size.</li><li>Unchecked—No weeding is applied.</li></ul><p>By default, weeding is applied.</p></xdoc>",
        "simplify.title": "Simplify polylines",
        "title": "Stream to Feature"
    }
}
