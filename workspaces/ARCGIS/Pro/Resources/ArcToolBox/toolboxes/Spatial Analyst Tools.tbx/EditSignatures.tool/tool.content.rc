{
    "map": {
        "description": "Edits and updates a signature file by merging, renumbering, and deleting class signatures.",
        "in_raster_bands.descr": "<xdoc><p>The input raster bands for which to edit the signatures.</p><p>They can be integer or floating point type.</p></xdoc>",
        "in_raster_bands.title": "Input raster bands",
        "in_signature_file.descr": "<xdoc><p>Input signature file whose class signatures are to be edited.</p><p>A .gsg extension is required.</p></xdoc>",
        "in_signature_file.title": "Input signature file",
        "in_signature_remap_file.descr": "<xdoc><p>Input ASCII remap table containing the class IDs to be merged, renumbered, or deleted.</p><p>The extension can be .rmp, .asc or .txt. The default is .rmp.</p></xdoc>",
        "in_signature_remap_file.title": "Input signature remap file",
        "out_signature_file.descr": "<xdoc><p>The output signature file.</p><p>A .gsg extension must be specified.</p></xdoc>",
        "out_signature_file.title": "Output signature file",
        "sample_interval.descr": "<xdoc><p>The interval to be used for sampling.</p><p>The default is 10.</p></xdoc>",
        "sample_interval.title": "Sample interval",
        "title": "Edit Signatures"
    }
}
