{
    "map": {
        "description": "Determines the flow of the values in the input raster within each cell's immediate neighborhood.",
        "in_surface_raster.descr": "<xdoc><p>The input surface raster for which to calculate the focal flow.</p><p>The eight immediate neighbors of each cell are evaluated to determine the flow.</p><p>The input raster can be integer or floating-point.</p></xdoc>",
        "in_surface_raster.title": "Input surface raster",
        "out_raster.descr": "<xdoc><p>The output focal flow raster.</p><p>The output raster is always of integer type.</p></xdoc>",
        "out_raster.title": "Output raster",
        "threshold_value.descr": "<xdoc><p>Defines a value that constitutes the threshold, which must be equaled or exceeded before flow can occur.</p><p>The threshold value can be either an integer or floating-point value.</p><p>If the difference between the value at a neighboring cell location and the value of the processing cell is less than or equal to the threshold value, the output will be 0 (or no flow).</p></xdoc>",
        "threshold_value.title": "Threshold value",
        "title": "Focal Flow"
    }
}
