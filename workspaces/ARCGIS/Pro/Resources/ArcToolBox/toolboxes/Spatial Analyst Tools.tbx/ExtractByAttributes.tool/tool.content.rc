        "description": "Extracts the cells of a raster based on a logical query.",
        "in_raster.descr": "The input raster from which cells will be extracted.",
        "in_raster.title": "Input raster",
        "out_raster.descr": "The output raster containing the cell values extracted from the input raster.",
        "out_raster.title": "Output raster",
        "title": "Extract by Attributes",
        "where_clause.descr": "<xdoc><p>A logical expression that selects a subset of raster cells.</p><p>The <span class=\"esri_uicontrol\">Where clause</span> follows the general form of an SQL expression. It can be entered directly, for example, VALUE &gt; 100, if you click the <span class=\"esri_uicontrol\">Edit SQL</span> mode button . If in the <span class=\"esri_uicontrol\">Edit Clause Mode</span>, you can begin constructing the expression by clicking on the <span class=\"esri_uicontrol\">Add Clause Mode</span> button.</p></xdoc>",
        "where_clause.title": "Where clause"
    }
}
