        "mCPU"
    ],
    "params": {
        "in_raster": {
            "display_order": "0",
            "displayname": "$rc:in_raster.title",
            "datatype": {
                "type": "GPSAGeoData"
            },
            "domain": {
                "type": "GPSAGeoDataDomain",
                "checkfield": "true",
                "singleband": "true",
                "datatype": [
                    "DERasterDataset",
                    "DERasterBand",
                    "GPRasterLayer",
                    "DEMosaicDataset",
                    "GPMosaicLayer",
                    "GPRasterCalculatorExpression",
                    "DETable",
                    "DEImageServer",
                    "DEFile"
                ],
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text"
                ],
                "geometrytype": [
                    "Point",
                    "Polygon",
                    "Polyline",
                    "Multipoint"
                ]
            },
            "description": "$rc:in_raster.descr"
        },
        "out_raster": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_raster.title",
            "datatype": {
                "type": "DERasterDataset"
            },
            "description": "$rc:out_raster.descr"
        },
        "distance_units": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:distance_units.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "CELLS",
                        "code": "$rc:distance_units.domain.CELLS"
                    },
                    {
                        "value": "METERS",
                        "code": "$rc:distance_units.domain.METERS"
                    },
                    {
                        "value": "CENTIMETERS",
                        "code": "$rc:distance_units.domain.CENTIMETERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:distance_units.domain.KILOMETERS"
                    },
                    {
                        "value": "INCHES",
                        "code": "$rc:distance_units.domain.INCHES"
                    },
                    {
                        "value": "FEET",
                        "code": "$rc:distance_units.domain.FEET"
                    },
                    {
                        "value": "YARDS",
                        "code": "$rc:distance_units.domain.YARDS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:distance_units.domain.MILES"
                    }
                ]
            },
            "depends": [
                "in_raster"
            ],
            "value": "CELLS",
            "description": "$rc:distance_units.descr"
        },
        "neighborhood_distance": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:neighborhood_distance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true"
            },
            "depends": [
                "in_raster",
                "distance_units"
            ],
            "value": "5",
            "description": "$rc:neighborhood_distance.descr"
        },
        "normal_difference_threshold": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:normal_difference_threshold.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "false",
                "low": {
                    "inclusive": "true",
                    "val": "-180"
                },
                "high": {
                    "allow": "true",
                    "val": "180"
                }
            },
            "value": "15",
            "description": "$rc:normal_difference_threshold.descr"
        },
        "number_iterations": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:number_iterations.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "false",
                "low": {
                    "inclusive": "true",
                    "val": "1"
                }
            },
            "value": "3",
            "description": "$rc:number_iterations.descr"
        },
