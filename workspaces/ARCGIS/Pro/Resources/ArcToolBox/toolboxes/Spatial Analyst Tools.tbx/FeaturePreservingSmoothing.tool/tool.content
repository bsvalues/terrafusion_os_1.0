                        "value": "MILLIMETER",
                        "code": "$rc:z_unit.domain.MILLIMETER"
                    },
                    {
                        "value": "CENTIMETER",
                        "code": "$rc:z_unit.domain.CENTIMETER"
                    },
                    {
                        "value": "METER",
                        "code": "$rc:z_unit.domain.METER"
                    },
                    {
                        "value": "KILOMETER",
                        "code": "$rc:z_unit.domain.KILOMETER"
