{
    "map": {
        "cell_size.descr": "<xdoc><p>The cell size of the output raster that will be created.</p><p>This parameter can be defined by a numeric value or obtained from an existing raster dataset. If the cell size hasn&apos;t been explicitly specified as the parameter value, the environment cell size value will be used if specified; otherwise, additional rules will be used to calculate it from the other inputs. See the usage section for more detail.</p></xdoc>",
        "cell_size.title": "Output Cell Size",
        "description": "Calculates the specified geometry measure (area, perimeter, thickness, or the characteristics of an ellipse) for each zone in a dataset.",
        "geometry_type.descr": "<xdoc><p>Specifies the geometry type that will be calculated.</p><ul><li><span title=\"AREA\">Area</span>—The area for each zone will be calculated.</li><li><span title=\"PERIMETER\">Perimeter</span>—The perimeter for each zone will be calculated.</li><li><span title=\"THICKNESS\">Thickness</span>—The deepest (or thickest) point within the zone from its surrounding cells will be calculated.</li><li><span title=\"CENTROID\">Centroid</span>—The centroids of each zone will be calculated.</li></ul></xdoc>",
        "geometry_type.domain.AREA": "Area",
        "geometry_type.domain.CENTROID": "Centroid",
        "geometry_type.domain.PERIMETER": "Perimeter",
        "geometry_type.domain.THICKNESS": "Thickness",
        "geometry_type.title": "Geometry Type",
        "in_zone_data.descr": "<xdoc><p>The dataset that defines the zones.</p><p>The zones can be defined by an integer raster or a feature layer.</p></xdoc>",
        "in_zone_data.title": "Input Raster or Feature Zone Data",
        "out_raster.descr": "The output zonal geometry raster.",
        "out_raster.title": "Output Raster",
        "title": "Zonal Geometry",
        "zone_field.descr": "<xdoc><p>The field that contains the values that define each zone.</p><p>It must be an integer field of the zone dataset.</p></xdoc>",
        "zone_field.title": "Zone Field"
    }
}
