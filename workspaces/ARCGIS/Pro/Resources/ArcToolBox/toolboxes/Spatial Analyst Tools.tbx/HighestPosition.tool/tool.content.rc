{
    "map": {
        "description": "Determines on a cell-by-cell basis the position of the raster with the maximum value in a set of rasters.",
        "in_rasters_or_constants.descr": "<xdoc><p>The list of input rasters for which the position of the input with the highest value will be determined.</p><p>A number can be used as an input; however, the cell size and extent must first be set in the environment.</p></xdoc>",
        "in_rasters_or_constants.title": "Input rasters or constant values",
        "out_raster.descr": "<xdoc><p>The output raster.</p><p>For each cell in the output raster, the value represents the position of the raster with the highest value.</p></xdoc>",
        "out_raster.title": "Output raster",
        "title": "Highest Position"
    }
}
