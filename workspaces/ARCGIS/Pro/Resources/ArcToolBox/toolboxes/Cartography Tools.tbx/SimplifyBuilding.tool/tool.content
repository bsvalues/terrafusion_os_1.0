                        "type": "GPBoolean",
                        "value": "true",
                        "code": "KEEP_COLLAPSED_POINTS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_KEEP"
                    }
                ]
            },
