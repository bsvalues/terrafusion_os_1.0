        },
        "conflict_option": {
            "type": "optional",
            "displayname": "$rc:conflict_option.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CHECK_CONFLICTS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_CHECK"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:conflict_option.descr"
        },
        "in_barriers": {
            "type": "optional",
            "displayname": "$rc:in_barriers.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
