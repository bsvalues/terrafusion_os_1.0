                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexJunction",
                    "ComplexEdge",
                    "RasterCatalogItem"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "simplification_tolerance": {
            "displayname": "$rc:simplification_tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:simplification_tolerance.descr"
        },
        "minimum_area": {
            "type": "optional",
            "displayname": "$rc:minimum_area.title",
            "datatype": {
                "type": "GPArealUnit"
            },
            "depends": [
                "in_features"
            ],
            "value": "0 Unknown",
