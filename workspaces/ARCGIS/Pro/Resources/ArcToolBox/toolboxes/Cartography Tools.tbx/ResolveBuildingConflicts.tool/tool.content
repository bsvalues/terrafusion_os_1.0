            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_buildings"
            ],
            "description": "$rc:minimum_size.descr"
        },
        "hierarchy_field": {
            "type": "optional",
            "display_order": "1",
            "displayname": "$rc:hierarchy_field.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:hierarchy_field.descr"
        },
        "out_layers": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_layers.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPLayer"
                }
            },
