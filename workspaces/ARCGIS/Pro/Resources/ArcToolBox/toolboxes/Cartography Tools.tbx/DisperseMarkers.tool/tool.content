{
    "type": "FunctionTool",
    "guid": "{b407ae05-4d9c-44dd-884c-2089d317ec0c}",
    "displayname": "$rc:title",
    "helpcontent": "10040010",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "edit_session",
        "input_data_change"
    ],
    "params": {
        "in_point_features": {
            "displayname": "$rc:in_point_features.title",
            "datatype": {
                "type": "GPLayer"
            },
            "domain": {
                "type": "GPLayerDomain",
                "geometrytype": [
                    "Point"
                ]
            },
            "description": "$rc:in_point_features.descr"
        },
        "minimum_spacing": {
            "displayname": "$rc:minimum_spacing.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                }
            },
            "description": "$rc:minimum_spacing.descr"
        },
        "dispersal_pattern": {
            "type": "optional",
            "displayname": "$rc:dispersal_pattern.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "EXPANDED",
                        "code": "$rc:dispersal_pattern.domain.EXPANDED"
                    },
                    {
                        "value": "RANDOM",
                        "code": "$rc:dispersal_pattern.domain.RANDOM"
                    },
                    {
                        "value": "SQUARES",
                        "code": "$rc:dispersal_pattern.domain.SQUARES"
                    },
                    {
                        "value": "RINGS",
                        "code": "$rc:dispersal_pattern.domain.RINGS"
                    },
                    {
                        "value": "SQUARE",
                        "code": "$rc:dispersal_pattern.domain.SQUARE"
                    },
                    {
                        "value": "RING",
                        "code": "$rc:dispersal_pattern.domain.RING"
                    },
                    {
                        "value": "CROSS",
                        "code": "$rc:dispersal_pattern.domain.CROSS"
                    },
                    {
                        "value": "X_CROSS",
                        "code": "$rc:dispersal_pattern.domain.X_CROSS"
                    },
                    {
                        "value": "COLUMN",
                        "code": "$rc:dispersal_pattern.domain.COLUMN"
                    },
                    {
                        "value": "ROW",
                        "code": "$rc:dispersal_pattern.domain.ROW"
                    }
                ]
            },
            "value": "EXPANDED",
            "description": "$rc:dispersal_pattern.descr"
        },
        "out_representations": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_representations.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_point_features"
            ]
        }
    },
    "environments": [
        "cartographicCoordinateSystem",
        "referenceScale"
    ]
}
