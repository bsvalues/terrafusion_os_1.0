{
    "type": "FunctionTool",
    "guid": "{60baae5f-a0e0-4c6b-b103-2fe0bc299f03}",
    "displayname": "$rc:title",
    "helpcontent": "10020002",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "edit_session",
        "input_data_change"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline",
                    "Point"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "displacement_features": {
            "displayname": "$rc:displacement_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:displacement_features.descr"
        },
        "adjustment_style": {
            "displayname": "$rc:adjustment_style.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "AUTO",
                        "code": "$rc:adjustment_style.domain.AUTO"
                    },
                    {
                        "value": "SOLID",
                        "code": "$rc:adjustment_style.domain.SOLID"
                    },
                    {
                        "value": "ELASTIC",
                        "code": "$rc:adjustment_style.domain.ELASTIC"
                    }
                ]
            },
            "value": "AUTO",
            "description": "$rc:adjustment_style.descr"
        },
        "out_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_features"
            ]
        }
    }
}
