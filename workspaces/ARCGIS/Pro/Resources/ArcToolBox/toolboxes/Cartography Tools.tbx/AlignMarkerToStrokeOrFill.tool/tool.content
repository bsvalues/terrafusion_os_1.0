{
    "type": "FunctionTool",
    "guid": "{e99b2988-da9f-47b8-b5df-b066e286424f}",
    "displayname": "$rc:title",
    "helpcontent": "10040002",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "edit_session",
        "input_data_change"
    ],
    "params": {
        "in_point_features": {
            "displayname": "$rc:in_point_features.title",
            "datatype": {
                "type": "GPLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ]
            },
            "description": "$rc:in_point_features.descr"
        },
        "in_line_or_polygon_features": {
            "displayname": "$rc:in_line_or_polygon_features.title",
            "datatype": {
                "type": "GPLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline",
                    "Polygon"
                ]
            },
            "description": "$rc:in_line_or_polygon_features.descr"
        },
        "search_distance": {
            "displayname": "$rc:search_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:search_distance.descr"
        },
        "marker_orientation": {
            "type": "optional",
            "displayname": "$rc:marker_orientation.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PERPENDICULAR",
                        "code": "$rc:marker_orientation.domain.PERPENDICULAR"
                    },
                    {
                        "value": "PARALLEL",
                        "code": "$rc:marker_orientation.domain.PARALLEL"
                    }
                ]
            },
            "value": "PERPENDICULAR",
            "description": "$rc:marker_orientation.descr"
        },
        "out_representations": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_representations.title",
            "datatype": {
                "type": "GPLayer"
            },
            "depends": [
                "in_point_features"
            ]
        }
    },
    "environments": [
        "cartographicCoordinateSystem",
        "cartographicPartitions",
        "referenceScale"
    ]
}
