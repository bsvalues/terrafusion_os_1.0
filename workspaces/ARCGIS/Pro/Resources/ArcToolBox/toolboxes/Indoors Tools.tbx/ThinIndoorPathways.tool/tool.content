{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "68010001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_level_features": {
            "display_order": "0",
            "displayname": "$rc:in_level_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_level_features.descr"
        },
        "in_pathway_features": {
            "display_order": "1",
            "displayname": "$rc:in_pathway_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_pathway_features.descr"
        },
        "in_transition_features": {
            "display_order": "2",
            "displayname": "$rc:in_transition_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_transition_features.descr"
        },
        "routable_locations": {
            "display_order": "3",
            "displayname": "$rc:routable_locations.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:routable_locations.descr"
        },
        "target_pathways": {
            "display_order": "4",
            "displayname": "$rc:target_pathways.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:target_pathways.descr"
        },
        "target_transitions": {
            "display_order": "5",
            "displayname": "$rc:target_transitions.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:target_transitions.descr"
        },
        "search_tolerance": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:search_tolerance.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "5",
            "description": "$rc:search_tolerance.descr"
        },
        "neighbor_solve_count": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:neighbor_solve_count.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "50",
            "description": "$rc:neighbor_solve_count.descr"
        },
        "updated_pathways": {
            "type": "derived",
            "direction": "out",
            "display_order": "8",
            "displayname": "$rc:updated_pathways.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "target_pathways"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "updated_transitions": {
            "type": "derived",
            "direction": "out",
            "display_order": "9",
            "displayname": "$rc:updated_transitions.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "target_transitions"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    }
}
