{
    "type": "FunctionTool",
    "guid": "{2F03DDCD-3D0E-422C-863C-24FDF2FCA288}/EnableDataReviewer",
    "displayname": "$rc:title",
    "helpcontent": "47000006",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "47"
    ],
    "params": {
        "workspace": {
            "displayname": "$rc:workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:workspace.descr"
        },
        "spatial_reference": {
            "type": "optional",
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:spatial_reference.descr"
        },
        "register_as_versioned": {
            "type": "optional",
            "displayname": "$rc:register_as_versioned.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NONVERSIONED"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "VERSIONED"
                    }
                ]
            },
            "description": "$rc:register_as_versioned.descr"
        },
        "config_keyword": {
            "type": "optional",
            "displayname": "$rc:config_keyword.title",
            "datatype": {
                "type": "GPString"
            },
            "defaultenvironmentname": "configKeyword",
            "description": "$rc:config_keyword.descr"
        },
        "out_reviewer_workspace": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_reviewer_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "depends": [
                "workspace"
            ]
        }
    },
    "environments": [
        "configKeyword",
        "workspace"
    ]
}
