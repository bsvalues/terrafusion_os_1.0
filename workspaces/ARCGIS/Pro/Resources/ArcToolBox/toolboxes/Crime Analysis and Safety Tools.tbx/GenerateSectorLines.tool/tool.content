{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\GenerateSectorLines",
    "displayname": "$rc:title",
    "helpcontent": "75010004",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_site_features": {
            "displayname": "$rc:in_site_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_site_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "symbologylayer": "cellSectorLines.lyrx",
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        }
    },
    "environments": [
        "MDomain",
        "MResolution",
        "MTolerance",
        "XYDomain",
        "XYResolution",
        "XYTolerance",
        "ZDomain",
        "ZResolution",
        "ZTolerance",
        "autoCommit",
        "configKeyword",
        "extent",
        "geographicTransformations",
        "maintainAttachments",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "qualifiedFieldNames",
        "scratchWorkspace",
        "workspace"
    ]
}
