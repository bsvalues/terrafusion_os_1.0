{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "78020001",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "target_workspace": {
            "displayname": "$rc:target_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "defaultenvironmentname": "workspace",
            "description": "$rc:target_workspace.descr"
        },
        "coordinate_system": {
            "displayname": "$rc:coordinate_system.title",
            "datatype": {
                "type": "GPCoordinateSystem"
            },
            "value": "GEOGCS[\"GCS_WGS_1984\",DATUM[\"D_WGS_1984\",SPHEROID[\"WGS_1984\",6378137.0,298.257223563]],PRIMEM[\"Greenwich\",0.0],UNIT[\"Degree\",0.0174532925199433]]",
            "description": "$rc:coordinate_system.descr"
        },
        "out_dataset_name": {
            "displayname": "$rc:out_dataset_name.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "IPS_Quality",
            "description": "$rc:out_dataset_name.descr"
        },
        "out_ips_quality_dataset": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_ips_quality_dataset.title",
            "datatype": {
                "type": "DEDatasetType"
            }
        },
        "out_reference_positions": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_reference_positions.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "out_computed_positions": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_computed_positions.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "workspace"
    ]
}
