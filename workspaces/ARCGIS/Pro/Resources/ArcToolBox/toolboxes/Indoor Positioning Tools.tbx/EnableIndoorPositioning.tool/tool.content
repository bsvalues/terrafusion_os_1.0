{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "78000002",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "in_workspace": {
            "displayname": "$rc:in_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "defaultenvironmentname": "workspace",
            "description": "$rc:in_workspace.descr"
        },
        "out_ips_recordings": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_ips_recordings.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "out_ips_positioning": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_ips_positioning.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "out_workspace": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "depends": [
                "in_workspace"
            ],
            "schema": {
                "type": "GPContainerSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "out_beacon_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_beacon_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "workspace"
    ]
}
