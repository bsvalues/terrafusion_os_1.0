{
    "type": "FunctionTool",
    "guid": "{33724566-2738-4FE2-903A-A8C439127E50}/StandardGeographyTA",
    "displayname": "$rc:title",
    "helpcontent": "62030002",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "33",
        "35"
    ],
    "params": {
        "geography_level": {
            "displayname": "$rc:geography_level.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:geography_level.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "geography_level"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "featuretype.rule": "AsSpecified",
                "featuretype": "Simple",
                "geometrytype.rule": "AsSpecified",
                "geometrytype": "Polygon",
                "extenttype.rule": "Union",
                "fields.rule": "None",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "input_type": {
            "type": "optional",
            "displayname": "$rc:input_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TABLE",
                        "code": "$rc:input_type.domain.TABLE"
                    },
                    {
                        "value": "LIST",
                        "code": "$rc:input_type.domain.LIST"
                    }
                ]
            },
            "value": "LIST",
            "description": "$rc:input_type.descr"
        },
        "in_ids_table": {
            "type": "optional",
            "displayname": "$rc:in_ids_table.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:in_ids_table.descr"
        },
        "geography_key_field": {
            "type": "optional",
            "displayname": "$rc:geography_key_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Text",
                    "Short",
                    "BigInteger",
                    "Long",
                    "GUID",
                    "GlobalID"
                ]
            },
            "depends": [
                "in_ids_table"
            ],
            "description": "$rc:geography_key_field.descr"
        },
        "ids_list": {
            "type": "optional",
            "control_guid": "{3156E61A-C485-4895-9EE4-833FC79BDD7A}",
            "displayname": "$rc:ids_list.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:ids_list.descr"
        },
        "summarize_duplicates": {
            "type": "optional",
            "displayname": "$rc:summarize_duplicates.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "SUMMARIZE_DUPLICATES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "USE_FIRST"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:summarize_duplicates.descr"
        },
        "group_field": {
            "type": "optional",
            "displayname": "$rc:group_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Text",
                    "Short",
                    "BigInteger",
                    "Long",
                    "GUID",
                    "GlobalID"
                ]
            },
            "depends": [
                "in_ids_table"
            ],
            "description": "$rc:group_field.descr"
        },
        "dissolve_output": {
            "type": "optional",
            "displayname": "$rc:dissolve_output.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DISSOLVE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DONT_DISSOLVE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:dissolve_output.descr"
        }
    },
    "environments": [
        "baDataSource",
        "workspace"
    ]
}
