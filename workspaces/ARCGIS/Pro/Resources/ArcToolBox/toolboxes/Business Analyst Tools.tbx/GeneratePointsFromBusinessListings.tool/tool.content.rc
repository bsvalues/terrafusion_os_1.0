{
    "map": {
        "business_dataset.descr": "The dataset that will be used in the business search.",
        "business_dataset.title": "Business Dataset",
        "description": "Generates a point feature layer from a business point location search.",
        "exact_match.descr": "<xdoc><p>Specifies whether only the text provided for the <span class=\"esri_uicontrol\">Search Terms</span> parameter will be returned from the search.</p><ul><li>Checked—Only exact matches to the text provided for the <span class=\"esri_uicontrol\">Search Terms</span> parameter will be returned.</li><li>Unchecked—Partial matches to the text provided for the <span class=\"esri_uicontrol\">Search Terms</span> parameter as well as exact matches will be returned. This is the default.</li></ul></xdoc>",
        "exact_match.title": "Include Only Exact Matches",
        "filters.descr": "<xdoc><p>The filters that will be applied to the <span class=\"esri_uicontrol\">Search Terms</span> parameter.</p><ul><li>FilterName—Set the filter by the dataset field.</li><li>FilterValue—Set the filter by applying a value to the selected field.</li><li>Include—Set the filter by including or excluding field values.</li></ul></xdoc>",
        "filters.dt.title1": "FilterName",
        "filters.dt.title2": "FilterValue",
        "filters.dt.title3": "Include",
        "filters.title": "Filters",
        "find_related_poi.descr": "<xdoc><p>Specifies whether semantic search will be used to find related items to the search terms.</p><ul><li>Checked—Semantic search will be used.</li><li>Unchecked—Semantic search will not be used. This is the default.</li></ul></xdoc>",
        "find_related_poi.title": "Find related POI",
        "in_search_features.descr": "The area that will be used to search for businesses. Selected features supersede the feature class and will be used as the search area.",
        "in_search_features.title": "Input Search Features",
        "match_name_only.descr": "<xdoc><p>Specifies whether the search will be limited to the business name only.</p><ul><li>Checked—Only exact matches to the business name provided for the <span class=\"esri_uicontrol\">Search Terms</span> parameter will be returned.</li><li>Unchecked—Partial matches to the business name provided for the <span class=\"esri_uicontrol\">Search Terms</span> parameter as well as exact matches will be returned. This is the default.</li></ul></xdoc>",
        "match_name_only.title": "Match Business or Facility Name Only",
        "max_count.descr": "<xdoc><p>The limit for the number of returned features. The default value is 1,000,000 for local data and 5,000 for online data hosted by ArcGIS Online.</p><p>The record limit when using on-premises hosted data is set by your administrator.</p></xdoc>",
        "max_count.title": "Maximum Number of Points to Return",
        "out_feature_class.descr": "The output feature class that will contain the returned businesses.",
        "out_feature_class.title": "Output Feature Class",
        "search_terms.descr": "<xdoc><p>The terms that will be used to search for businesses. You can use terms such as business name or business type keywords. If this parameter is not set, all businesses from the <span class=\"esri_uicontrol\">Input Search Features</span> parameter value will be returned.</p></xdoc>",
        "search_terms.title": "Search Terms",
        "title": "Generate Points From Business Listings"
    }
}
