        "creation_date.descr": "<xdoc><p>Specifies whether editor tracking for the creation date field will be disabled.</p><ul><li>Checked—Editor tracking for the creation date field will be disabled. This is the default.</li><li>Unchecked—Editor tracking for the creation date field will not be disabled.</li></ul></xdoc>",
