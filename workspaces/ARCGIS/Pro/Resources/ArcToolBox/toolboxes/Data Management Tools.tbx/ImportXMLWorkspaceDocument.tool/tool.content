    "product": "100",
    "params": {
        "target_geodatabase": {
            "displayname": "$rc:target_geodatabase.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:target_geodatabase.descr"
        },
        "in_file": {
            "displayname": "$rc:in_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xml",
                    "zip",
                    "z"
                ]
            },
            "description": "$rc:in_file.descr"
        },
        "import_type": {
            "type": "optional",
            "displayname": "$rc:import_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DATA",
                        "code": "$rc:import_type.domain.DATA"
                    },
                    {
                        "value": "SCHEMA_ONLY",
                        "code": "$rc:import_type.domain.SCHEMA_ONLY"
                    }
                ]
            },
            "value": "DATA",
            "description": "$rc:import_type.descr"
        },
        "config_keyword": {
            "type": "optional",
            "displayname": "$rc:config_keyword.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "defaultenvironmentname": "configKeyword",
            "description": "$rc:config_keyword.descr"
        },
        "out_geodatabase": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_geodatabase.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "depends": [
                "input_geodatabase"
            ]
        }
    },
    "environments": [
        "scratchWorkspace",
        "workspace"
    ]
