{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3050031",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Features": {
            "display_order": "0",
            "displayname": "$rc:input_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_features.descr"
        },
        "Output_Feature_Class": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:output_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "Input_Features"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "geometrytype.rule": "AsSpecified",
                "geometrytype": "Point",
                "fields.rule": "AllNoFIDs",
                "fields": [
                    {
                        "name": "ORIG_FID",
                        "type": "esriFieldTypeSmallInteger",
                        "isNullable": "true",
                        "length": "0",
                        "precision": "0",
                        "scale": "0"
                    }
                ],
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_feature_class.descr"
        },
        "Point_Placement": {
            "display_order": "2",
            "displayname": "$rc:point_placement.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PERCENTAGE",
                        "code": "$rc:point_placement.domain.PERCENTAGE"
                    },
                    {
                        "value": "DISTANCE",
                        "code": "$rc:point_placement.domain.DISTANCE"
                    },
                    {
                        "value": "DISTANCE_FIELD",
                        "code": "$rc:point_placement.domain.DISTANCE_FIELD"
                    }
                ]
            },
            "value": "DISTANCE",
            "description": "$rc:point_placement.descr"
        },
        "Distance": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:distance.descr"
        },
        "Percentage": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:percentage.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "100"
            },
            "description": "$rc:percentage.descr"
        },
        "Include_End_Points": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:include_end_points.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "END_POINTS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_END_POINTS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:include_end_points.descr"
        },
        "Add_Chainage_Fields": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:add_chainage_fields.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_CHAINAGE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_CHAINAGE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:add_chainage_fields.descr"
        },
        "Distance_Field": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:distance_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text",
                    "BigInteger"
                ]
            },
            "depends": [
                "Input_Features"
            ],
            "description": "$rc:distance_field.descr"
        },
        "Distance_Method": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:distance_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PLANAR",
                        "code": "$rc:distance_method.domain.PLANAR"
                    },
                    {
                        "value": "GEODESIC",
                        "code": "$rc:distance_method.domain.GEODESIC"
                    }
                ]
            },
            "value": "PLANAR",
            "description": "$rc:distance_method.descr"
        }
    },
    "environments": [
        "configKeyword",
        "outputMFlag",
        "outputZFlag",
        "workspace"
    ]
}
