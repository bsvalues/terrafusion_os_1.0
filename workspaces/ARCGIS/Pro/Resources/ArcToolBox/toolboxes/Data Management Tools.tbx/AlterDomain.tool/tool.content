{
    "type": "FunctionTool",
    "guid": "{183cc6ae-a684-4fa9-a1f5-8b708829f3ca}",
    "displayname": "$rc:title",
    "helpcontent": "3030012",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "in_workspace": {
            "displayname": "$rc:in_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:in_workspace.descr"
        },
        "domain_name": {
            "displayname": "$rc:domain_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:domain_name.descr"
        },
        "new_domain_name": {
            "type": "optional",
            "displayname": "$rc:new_domain_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:new_domain_name.descr"
        },
        "new_domain_description": {
            "type": "optional",
            "displayname": "$rc:new_domain_description.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:new_domain_description.descr"
        },
        "split_policy": {
            "type": "optional",
            "displayname": "$rc:split_policy.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DEFAULT",
                        "code": "$rc:split_policy.domain.DEFAULT"
                    },
                    {
                        "value": "DUPLICATE",
                        "code": "$rc:split_policy.domain.DUPLICATE"
                    },
                    {
                        "value": "GEOMETRY_RATIO",
                        "code": "$rc:split_policy.domain.GEOMETRY_RATIO"
                    }
                ]
            },
            "value": "DEFAULT",
            "description": "$rc:split_policy.descr"
        },
        "merge_policy": {
            "type": "optional",
            "displayname": "$rc:merge_policy.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DEFAULT",
                        "code": "$rc:merge_policy.domain.DEFAULT"
                    },
                    {
                        "value": "SUM_VALUES",
                        "code": "$rc:merge_policy.domain.SUM_VALUES"
                    },
                    {
                        "value": "AREA_WEIGHTED",
                        "code": "$rc:merge_policy.domain.AREA_WEIGHTED"
                    }
                ]
            },
            "value": "DEFAULT",
            "description": "$rc:merge_policy.descr"
        },
        "out_workspace": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "depends": [
                "in_workspace"
            ]
        },
        "new_domain_owner": {
            "type": "optional",
            "displayname": "$rc:new_domain_owner.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:new_domain_owner.descr"
        }
    },
    "environments": [
        "workspace"
    ]
}
