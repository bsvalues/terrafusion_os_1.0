{
    "map": {
        "description": "Creates an output delta file containing updates from an input replica.",
        "in_geodatabase.descr": "The replica geodatabase from which the data change message will be exported. The geodatabase can be local or remote.",
        "in_geodatabase.title": "Export from Replica Geodatabase",
        "in_replica.descr": "The replica containing the updates to be exported.",
        "in_replica.title": "Replica",
        "include_new_changes.descr": "<xdoc><p>Specifies whether all data changes made since the last exported data change message will be included.</p><ul><li>Unchecked—Data changes made since the last exported data change message will not be included.</li><li>Checked—All data changes made since the last exported data change message will be included. This is the default.</li></ul><p>Specifies whether all data changes made since the last exported data change message will be included.</p><ul><li><span title=\"NO_NEW_CHANGES\">NO_NEW_CHANGES</span>—Data changes made since the last exported data change message will not be included.</li><li><span title=\"NEW_CHANGES\">NEW_CHANGES</span>—All data changes made since the last exported data change message will be included. This is the default.</li></ul></xdoc>",
        "include_new_changes.title": "Include new data changes since last export",
        "include_unacknowledged_changes.descr": "<xdoc><p>Specifies whether data changes that were previously exported for which no acknowledgment message was received will be included.</p><ul><li>Unchecked—Data changes that were previously sent will not be included.</li><li>Checked—All data changes that were previously exported for which no acknowledgment message was received will be included. This is the default.</li></ul></xdoc>",
        "include_unacknowledged_changes.title": "Include unacknowledged data changes",
        "out_data_changes_file.descr": "The output delta file.",
        "out_data_changes_file.title": "Output Data Changes File",
        "switch_to_receiver.descr": "<xdoc><p>Specifies whether the replica role will be changed from a sender to a receiver. The receiver may not send replica updates until updates from the relative replica sender arrive.</p><ul><li>Unchecked—The replica role will not be changed. This is the default.</li><li>Checked—The replica role will be changed from a sender to a receiver.</li></ul></xdoc>",
        "switch_to_receiver.title": "Switch to Receiver once the message has been exported",
        "title": "Export Data Change Message"
    }
}
