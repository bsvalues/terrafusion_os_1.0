        "input_item_types.domain.SCENE_LAYER_PACKAGE": "Scene layer packages",
        "input_item_types.domain.TIN": "TIN datasets",
        "input_item_types.title": "Input Item Types",
        "input_items.descr": "The workspace items, layers, and files from which items will be added to the catalog dataset. The workspace can be a folder, file geodatabase, feature dataset, enterprise database, or a service from a server connection.",
        "input_items.title": "Input Items",
        "out_catalog_dataset.title": "Output Catalog Dataset",
