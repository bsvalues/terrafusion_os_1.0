{
    "map": {
        "description": "Adds workspace items and layers—such as geodatabase datasets, raster layers, feature layers, mosaic layers, and other items—to an existing catalog dataset.",
        "footprint_type.descr": "<xdoc><p>Specifies whether the reference item&apos;s footprint will be the full extent or a convex hull representing the smallest convex polygon for all features.</p><ul><li><span title=\"ENVELOPE\">Envelope</span>—The footprint will be a rectangle covering the full extent of the reference item. This is the default.</li><li><span title=\"CONVEX_HULL\">Convex hull</span>—The footprint will be a convex hull enclosing all features from the reference item.</li></ul></xdoc>",
        "footprint_type.domain.CONVEX_HULL": "Convex hull",
        "footprint_type.domain.ENVELOPE": "Envelope",
        "footprint_type.title": "Footprint Type",
        "include_subfolders.descr": "<xdoc><p>Specifies whether the contents of folders or workspaces specified in the <span class=\"esri_uicontrol\">Input Items</span> parameter value will be recursively searched and added to the catalog dataset. This parameter is not applicable to file or enterprise geodatabases.</p><ul><li>Checked—The contents of folders or workspaces will be recursively searched and added to the catalog dataset. This is the default.</li><li>Unchecked—The contents of folders or workspaces will not be recursively searched and added to the catalog dataset.</li></ul></xdoc>",
        "include_subfolders.title": "Include subfolders",
        "input_item_types.descr": "<xdoc><p>Specifies the item types that will be added to the catalog dataset from any input workspaces. All supported item types will be added by default.</p><ul><li><span title=\"BIM_FILE_WORKSPACE\">BIM files</span>—BIM file workspaces will be added.</li><li><span title=\"BIM_FILE_FLOORPLAN\">BIM floor plans</span>—BIM file floor plans will be added.</li><li><span title=\"CAD_DRAWING\">CAD datasets</span>—CAD drawings will be added.</li><li><span title=\"FEATURE_CLASS\">Feature classes</span>—Feature classes will be added.</li><li><span title=\"FEATURE_SERVICE\">Feature services</span>—Feature services will be added.</li><li><span title=\"IMAGE_SERVICE\">Image services</span>—Image services will be added.</li><li><span title=\"LAS_DATASET\">LAS datasets</span>—LAS datasets will be added.</li><li><span title=\"LAS_FILE\">LAS files</span>—LAS files will be added.</li><li><span title=\"LAYER_FILE\">Layer files</span>—Layer files will be added.</li><li><span title=\"MAP_SERVICE\">Map services</span>—Map services will be added.</li><li><span title=\"MOSAIC_DATASET\">Mosaic datasets</span>—Mosaic datasets will be added.</li><li><span title=\"RASTER_DATASET\">Raster layers</span>—Raster datasets will be added.</li><li><span title=\"SCENE_LAYER_PACKAGE\">Scene layer packages</span>—Scene layer packages will be added.</li><li><span title=\"TIN\">TIN datasets</span>—TIN datasets will be added.</li></ul></xdoc>",
        "input_item_types.domain.BIM_FILE_FLOORPLAN": "BIM floor plans",
        "input_item_types.domain.BIM_FILE_WORKSPACE": "BIM files",
        "input_item_types.domain.CAD_DRAWING": "CAD datasets",
        "input_item_types.domain.FEATURE_CLASS": "Feature classes",
        "input_item_types.domain.FEATURE_SERVICE": "Feature services",
        "input_item_types.domain.IMAGE_SERVICE": "Image services",
        "input_item_types.domain.LAS_DATASET": "LAS datasets",
        "input_item_types.domain.LAS_FILE": "LAS files",
        "input_item_types.domain.LAYER_FILE": "Layer files",
        "input_item_types.domain.MAP_SERVICE": "Map services",
        "input_item_types.domain.MOSAIC_DATASET": "Mosaic datasets",
