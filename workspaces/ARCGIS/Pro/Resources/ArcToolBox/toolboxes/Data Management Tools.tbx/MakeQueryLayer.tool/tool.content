{
    "type": "FunctionTool",
    "guid": "{22e1e7a2-ca4a-44c6-8cf1-55ca10960f21}",
    "displayname": "$rc:title",
    "helpcontent": "3110015",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "attributes": [
        "no_data_change"
    ],
    "params": {
        "input_database": {
            "display_order": "1",
            "displayname": "$rc:input_database.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Remote Database"
                ]
            },
            "description": "$rc:input_database.descr"
        },
        "out_layer_name": {
            "display_order": "2",
            "displayname": "$rc:out_layer_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_layer_name.descr"
        },
        "query": {
            "control_guid": "{E5456E51-0C41-4797-9EE4-5269820C6F0E}",
            "displayname": "$rc:query.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:query.descr"
        },
        "oid_fields": {
            "type": "optional",
            "displayname": "$rc:oid_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "description": "$rc:oid_fields.descr"
        },
        "shape_type": {
            "type": "optional",
            "displayname": "$rc:shape_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POINT",
                        "code": "$rc:shape_type.domain.POINT"
                    },
                    {
                        "value": "MULTIPOINT",
                        "code": "$rc:shape_type.domain.MULTIPOINT"
                    },
                    {
                        "value": "POLYGON",
                        "code": "$rc:shape_type.domain.POLYGON"
                    },
                    {
                        "value": "POLYLINE",
                        "code": "$rc:shape_type.domain.POLYLINE"
                    }
                ]
            },
            "description": "$rc:shape_type.descr"
        },
        "srid": {
            "type": "optional",
            "displayname": "$rc:srid.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:srid.descr"
        },
        "spatial_reference": {
            "type": "optional",
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:spatial_reference.descr"
        },
        "out_layer": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_layer.title",
            "datatype": {
                "type": "GPTableView"
            }
        },
        "spatial_properties": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:spatial_properties.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DEFINE_SPATIAL_PROPERTIES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_DEFINE_SPATIAL_PROPERTIES"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:spatial_properties.descr"
        },
        "m_values": {
            "type": "optional",
            "displayname": "$rc:m_values.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "INCLUDE_M_VALUES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_INCLUDE_M_VALUES"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:m_values.descr"
        },
        "z_values": {
            "type": "optional",
            "displayname": "$rc:z_values.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "INCLUDE_Z_VALUES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_INCLUDE_Z_VALUES"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:z_values.descr"
        },
        "extent": {
            "type": "optional",
            "control_guid": "{15F0D1C1-F783-49BC-8D16-619B8E92F668}",
            "displayname": "$rc:extent.title",
            "datatype": {
                "type": "GPExtent"
            },
            "value": "0 0 0 0",
            "description": "$rc:extent.descr"
        }
    },
    "environments": [
        "outputCoordinateSystem",
        "workspace"
    ]
}
