{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3190403",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Raster_Datasets": {
            "displayname": "$rc:input_raster_datasets.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "DERasterDataset"
                }
            },
            "description": "$rc:input_raster_datasets.descr"
        },
        "Number_of_columns_to_skip": {
            "type": "optional",
            "displayname": "$rc:number_of_columns_to_skip.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "1",
            "description": "$rc:number_of_columns_to_skip.descr"
        },
        "Number_of_rows_to_skip": {
            "type": "optional",
            "displayname": "$rc:number_of_rows_to_skip.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "1",
            "description": "$rc:number_of_rows_to_skip.descr"
        },
        "Ignore_values": {
            "type": "optional",
            "displayname": "$rc:ignore_values.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPDouble"
                }
            },
            "description": "$rc:ignore_values.descr"
        },
        "Skip_Existing": {
            "type": "optional",
            "displayname": "$rc:skip_existing.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "OVERWRITE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "SKIP_EXISTING"
                    }
                ]
            },
            "description": "$rc:skip_existing.descr"
        },
        "Batch_Calculate_Statistics_Succeeded": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:batch_calculate_statistics_succeeded.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "value": "true"
        }
    },
    "environments": [
        "rasterStatistics",
        "scratchWorkspace",
        "workspace"
    ]
}
