{
    "type": "FunctionTool",
    "guid": "{92e77a10-fc00-11e3-a3ac-0800200c9a66}",
    "displayname": "$rc:title",
    "helpcontent": "3010024",
    "description": "$rc:description",
    "product": "200",
    "attributes": [
        "no_data_change"
    ],
    "params": {
        "input_database": {
            "displayname": "$rc:input_database.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Remote Database"
                ]
            },
            "description": "$rc:input_database.descr"
        },
        "log_file_type": {
            "displayname": "$rc:log_file_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SESSION_LOG_FILE",
                        "code": "$rc:log_file_type.domain.SESSION_LOG_FILE"
                    },
                    {
                        "value": "SHARED_LOG_FILE",
                        "code": "$rc:log_file_type.domain.SHARED_LOG_FILE"
                    }
                ]
            },
            "value": "SESSION_LOG_FILE",
            "description": "$rc:log_file_type.descr"
        },
        "log_file_pool_size": {
            "type": "optional",
            "displayname": "$rc:log_file_pool_size.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:log_file_pool_size.descr"
        },
        "use_tempdb": {
            "type": "optional",
            "displayname": "$rc:use_tempdb.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "USE_TEMBDB"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NOT_USE_TEMBDB"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:use_tempdb.descr"
        },
        "out_workspace": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "depends": [
                "input_workspace"
            ]
        }
    },
    "environments": [
        "workspace"
    ]
}
