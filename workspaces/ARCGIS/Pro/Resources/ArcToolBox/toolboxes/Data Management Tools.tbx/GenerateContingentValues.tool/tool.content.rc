    "map": {
        "contingent_values_file.descr": "The output .csv file containing contingent value information.",
        "contingent_values_file.title": "Contingent Values File",
        "description": "Generates contingent values from an existing dataset using either the data values in the table or the domain values assigned to the fields. The tool creates two .csv files: one for field groups and one for contingent values.",
        "field_groups.descr": "The field groups for which contingent values will be generated. If no value is provided, all field groups will be used.",
        "field_groups.title": "Field Groups",
        "field_groups_file.descr": "The output .csv file containing field group information.",
        "field_groups_file.title": "Field Groups File",
        "in_table.descr": "The table whose data or schema will be used to generate the contingent values.",
        "in_table.title": "Input Table",
        "mode.descr": "<xdoc><p>Specifies the method that will be used to generate contingent values.</p><ul><li><span title=\"DATA\">Data</span>— The values in the input table will be used to generate valid contingent values. This is the default.</li><li><span title=\"SCHEMA\">Schema</span>— The product of the coded values of all domains assigned to the field group&apos;s fields will be used to generate all possible contingent value combinations.</li></ul></xdoc>",
        "mode.domain.DATA": "Data",
        "mode.domain.SCHEMA": "Schema",
        "mode.title": "Mode",
        "title": "Generate Contingent Values"
    }
