            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:in_dataset.descr"
        },
        "out_dataset": {
            "direction": "out",
            "displayname": "$rc:out_dataset.title",
            "datatype": {
                "type": "DETable"
            },
            "description": "$rc:out_dataset.descr"
        },
        "fields": {
            "displayname": "$rc:fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text",
                    "Date",
                    "Geometry",
                    "GUID"
                ]
            },
            "depends": [
                "in_dataset"
            ],
            "description": "$rc:fields.descr"
        },
        "xy_tolerance": {
            "type": "optional",
            "displayname": "$rc:xy_tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_dataset"
            ],
            "defaultenvironmentname": "XYTolerance",
            "description": "$rc:xy_tolerance.descr"
        },
        "z_tolerance": {
            "type": "optional",
            "displayname": "$rc:z_tolerance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0",
            "description": "$rc:z_tolerance.descr"
        },
        "output_record_option": {
            "type": "optional",
            "displayname": "$rc:output_record_option.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ONLY_DUPLICATES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "ALL"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:output_record_option.descr"
        }
    },
    "environments": [
        "XYTolerance",
        "ZTolerance",
        "extent",
        "scratchWorkspace",
        "workspace"
