{
    "map": {
        "description": "Deletes retired archive records from nonversioned archive-enabled datasets.",
        "in_table.descr": "The nonversioned archive-enabled table with the archive history to be trimmed.",
        "in_table.title": "Input Table",
        "out_table.title": "Output Table",
        "summary": "<xdoc><p>Deletes retired archive records from nonversioned archive-enabled datasets.</p><p>Over time, the archive history of a table can increase exponentially as the edit history is maintained. This can affect storage and backup management decisions and may affect performance if the data becomes too large for the system in place. Some organizations may use nonversioned archiving because it is required for certain functionality and have no need for historical records, or they may want to remove older data that is no longer relevant. This tool allows you to delete all retired rows or the retired rows older than a specified date.</p></xdoc>",
        "title": "Trim Archive History",
        "trim_before_date.descr": "Archive records older than this date and time will be deleted. The date and time must be in UTC. If no date is provided, all archive records will be deleted.",
        "trim_before_date.title": "Trim Before Date",
        "trim_mode.descr": "<xdoc><p>Specifies the trim mode that will be used to trim the archive history.</p><note type=\"note\"/><p group=\"note\">At the current version of ArcGIS Pro, only the delete trim mode is available.</p><ul><li><span title=\"DELETE\">Delete</span>—The archive records will be deleted.</li></ul></xdoc>",
        "trim_mode.domain.DELETE": "Delete",
        "trim_mode.title": "Trim Mode"
    }
}
