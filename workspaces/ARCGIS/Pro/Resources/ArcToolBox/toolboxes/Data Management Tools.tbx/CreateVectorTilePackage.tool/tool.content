            },
            "description": "$rc:in_map.descr"
        },
        "output_file": {
            "direction": "out",
            "control_guid": "{F618CB52-29AE-49C8-BF32-9845F642276B}",
            "displayname": "$rc:output_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "vtpk"
                ]
            },
            "description": "$rc:output_file.descr"
        },
        "service_type": {
            "displayname": "$rc:service_type.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ONLINE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "EXISTING"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:service_type.descr"
        },
        "tiling_scheme": {
            "type": "optional",
            "displayname": "$rc:tiling_scheme.title",
            "datatype": {
                "type": "GPComposite",
