                    },
                    {
                        "type": "DEFile"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "GPFileDomain",
                        "filetypes": [
                            "xml"
                        ]
                    }
                ]
            },
            "description": "$rc:tiling_scheme.descr"
        },
        "tile_structure": {
            "type": "optional",
            "displayname": "$rc:tile_structure.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INDEXED",
                        "code": "$rc:tile_structure.domain.INDEXED"
                    },
                    {
                        "value": "FLAT",
                        "code": "$rc:tile_structure.domain.FLAT"
                    }
                ]
            },
            "value": "INDEXED",
            "description": "$rc:tile_structure.descr"
        },
        "min_cached_scale": {
