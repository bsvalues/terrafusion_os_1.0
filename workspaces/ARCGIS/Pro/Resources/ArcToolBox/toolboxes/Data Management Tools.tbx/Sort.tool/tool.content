    "product": "100",
    "params": {
        "in_dataset": {
            "displayname": "$rc:in_dataset.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:in_dataset.descr"
        },
        "out_dataset": {
            "direction": "out",
            "displayname": "$rc:out_dataset.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEFeatureClass"
                    },
                    {
                        "type": "DETable"
                    }
                ]
            },
            "depends": [
                "in_dataset"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_dataset.descr"
        },
        "sort_field": {
            "displayname": "$rc:sort_field.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:sort_field.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:sort_field.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Geometry",
                            "Short",
                            "Long",
                            "Float",
                            "Double",
                            "Text",
                            "Date"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "ASCENDING",
                                "code": "$rc:sort_field.domain.item2.ASCENDING"
                            },
                            {
                                "value": "DESCENDING",
                                "code": "$rc:sort_field.domain.item2.DESCENDING"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "in_dataset"
            ],
            "description": "$rc:sort_field.descr"
        },
        "spatial_sort_method": {
            "type": "optional",
            "displayname": "$rc:spatial_sort_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UL",
                        "code": "$rc:spatial_sort_method.domain.UL"
                    },
                    {
                        "value": "UR",
                        "code": "$rc:spatial_sort_method.domain.UR"
                    },
                    {
                        "value": "LL",
                        "code": "$rc:spatial_sort_method.domain.LL"
                    },
                    {
                        "value": "LR",
                        "code": "$rc:spatial_sort_method.domain.LR"
                    },
                    {
                        "value": "PEANO",
                        "code": "$rc:spatial_sort_method.domain.PEANO"
                    }
                ]
            },
            "value": "UR",
            "description": "$rc:spatial_sort_method.descr"
        }
    },
    "environments": [
        "MDomain",
        "MResolution",
        "MTolerance",
