{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "69000030",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "spark"
    ],
    "params": {
        "input_layer": {
            "displayname": "$rc:input_layer.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:input_layer.descr"
        },
        "output": {
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEFeatureClass"
                    },
                    {
                        "type": "DETable"
                    }
                ]
            },
            "description": "$rc:output.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
