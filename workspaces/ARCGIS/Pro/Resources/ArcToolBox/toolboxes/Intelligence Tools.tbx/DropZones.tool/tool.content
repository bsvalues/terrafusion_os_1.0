{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\DropZones",
    "displayname": "$rc:title",
    "helpcontent": "73030001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_slope_raster": {
            "displayname": "$rc:in_slope_raster.title",
            "datatype": {
                "type": "GPRasterLayer"
            },
            "description": "$rc:in_slope_raster.descr"
        },
        "in_vegetation_features": {
            "displayname": "$rc:in_vegetation_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "description": "$rc:in_vegetation_features.descr"
        },
        "clip_features": {
            "displayname": "$rc:clip_features.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:clip_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        }
    }
}
