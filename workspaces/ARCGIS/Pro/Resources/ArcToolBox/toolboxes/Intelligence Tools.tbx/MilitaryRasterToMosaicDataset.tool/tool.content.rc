{
    "map": {
        "allow_duplicate_datasets.descr": "<xdoc><p>Specifies whether duplicate rasters will be added.</p><ul><li><span title=\"EXCLUDE_DUPLICATES\">Exclude duplicates</span>—Duplicate rasters will not be added. This is the default.</li><li><span title=\"ALLOW_DUPLICATES\">Allow duplicates</span>—All rasters will be added even if they already exist in the mosaic dataset.</li><li><span title=\"OVERWRITE_DUPLICATES\">Overwrite duplicates</span>—Duplicate rasters will overwrite existing rasters in the mosaic dataset.</li></ul></xdoc>",
        "allow_duplicate_datasets.domain.ALLOW_DUPLICATES": "Allow duplicates",
        "allow_duplicate_datasets.domain.EXCLUDE_DUPLICATES": "Exclude duplicates",
        "allow_duplicate_datasets.domain.OVERWRITE_DUPLICATES": "Overwrite duplicates",
        "allow_duplicate_datasets.title": "Allow Duplicate Datasets",
        "description": "Imports Compressed ARC Digitized Raster Graphic (CADRG), Enhance Compressed Raster Graphic (ECRG), Controlled Image Base (CIB), Digital Terrain Elevation Dataset (DTED), and High Resolution Elevation (HRE) rasters into one or more mosaic datasets. It combines a multistep process into a single tool  that can handle most use cases for working with Raster Product Format (RPF) and RPF-like rasters.",
        "import_format.descr": "<xdoc><p>Specifies the raster formats that will be imported from the <span class=\"esri_uicontrol\">Input Folder</span> parameter value.</p><ul><li><span title=\"CADRG\">CADRG/ECRG</span>—Files of CADRG/ECRG format will be imported.</li><li><span title=\"CIB\">CIB</span>—Files of CIB format will be imported.</li><li><span title=\"DTED\">DTED</span>—Files of DTED format will be imported.</li><li><span title=\"HRE\">HRE</span>—Files of HRE format will be imported.</li></ul></xdoc>",
        "import_format.domain.CADRG": "CADRG/ECRG",
        "import_format.domain.CIB": "CIB",
        "import_format.domain.DTED": "DTED",
        "import_format.domain.HRE": "HRE",
        "import_format.title": "Import Format",
        "in_folder.descr": "The folder containing the CADRG/ECRG, CIB, DTED, and HRE raster formats that will be imported. Folders will be searched recursively.",
        "in_folder.title": "Input Folder",
        "out_cadrg_mosaic.title": "Output CADRG/ECRG Mosaic",
        "out_cib_mosaic.title": "Output CIB Mosaic",
        "out_dted_mosaic.title": "Output DTED Mosaic",
        "out_hre_mosaic.title": "Output HRE Mosaic",
        "output_mosaic_basename.descr": "<xdoc><p>The name of the output mosaic dataset. If multiple <span class=\"esri_uicontrol\">Import Format</span> parameter options are specified, a suffix will be added to the output mosaic dataset name. For example, if the output mosaic dataset name is mymosaic and the <span class=\"esri_uicontrol\">CADRG/ECRG</span>, <span class=\"esri_uicontrol\">CIB</span>, and <span class=\"esri_uicontrol\">DTED</span> options are specified, the resulting mosaics will be named mymosaic_CADRG, mymosaic_CIB, and mymosaic_DTED.</p></xdoc>",
        "output_mosaic_basename.title": "Output Mosaic Basename",
        "summary": "Imports Compressed ARC Digitized Raster Graphic (CADRG), Enhance Compressed Raster Graphic (ECRG), Controlled Image Base (CIB), Digital Terrain Elevation Dataset (DTED), and High Resolution Elevation (HRE) rasters into one or more mosaic datasets. It combines a multistep process into a single tool that can handle most use cases for working with Raster Product Format (RPF) and RPF-like rasters.",
        "target_geodatabase.descr": "The enterprise or file geodatabase where the output mosaics will be created.",
        "target_geodatabase.title": "Target Geodatabase",
        "title": "Military Raster To Mosaic Dataset"
    }
}
