{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\DetectObjectsUsingDeepLearning",
    "displayname": "$rc:title",
    "helpcontent": "54080002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "inputRaster": {
            "displayname": "$rc:inputraster.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEImageServer"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "DEMapServer"
                    },
                    {
                        "type": "GPMapServerLayer"
                    },
                    {
                        "type": "GPInternetTiledLayer"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:inputraster.descr"
        },
        "inputModel": {
            "displayname": "$rc:inputmodel.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "",
                    "dlpk_remote"
                ]
            },
            "description": "$rc:inputmodel.descr"
        },
        "outputName": {
            "displayname": "$rc:outputname.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:outputname.descr"
        },
        "modelArguments": {
            "type": "optional",
            "displayname": "$rc:modelarguments.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPString",
                        "displayname": "$rc:modelarguments.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:modelarguments.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPCodedValueDomain"
                    },
                    {
                        "type": "GPCodedValueDomain"
                    }
                ]
            },
            "description": "$rc:modelarguments.descr"
        },
        "runNMS": {
            "type": "optional",
            "displayname": "$rc:runnms.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "NMS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_NMS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:runnms.descr"
        },
        "confidenceScoreField": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:confidencescorefield.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "Confidence",
            "description": "$rc:confidencescorefield.descr"
        },
        "classValueField": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:classvaluefield.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "Class",
            "description": "$rc:classvaluefield.descr"
        },
        "maxOverlapRatio": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:maxoverlapratio.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0",
            "description": "$rc:maxoverlapratio.descr"
        },
        "outObjects": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:outobjects.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "processingMode": {
            "type": "optional",
            "displayname": "$rc:processingmode.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PROCESS_AS_MOSAICKED_IMAGE",
                        "code": "$rc:processingmode.domain.PROCESS_AS_MOSAICKED_IMAGE"
                    },
                    {
                        "value": "PROCESS_ITEMS_SEPARATELY",
                        "code": "$rc:processingmode.domain.PROCESS_ITEMS_SEPARATELY"
                    }
                ]
            },
            "value": "PROCESS_AS_MOSAICKED_IMAGE",
            "description": "$rc:processingmode.descr"
        }
    },
    "environments": [
        "cellSize",
        "extent",
        "outputCoordinateSystem",
        "parallelProcessingFactor",
        "processorType"
    ]
}
