{
    "map": {
        "datatype.descr": "<xdoc><p>The output accumulation raster can be integer, floating or double type.</p><ul><li><span title=\"FLOAT\">Float</span>—The output raster will be floating point type. This is the default.</li><li><span title=\"INTEGER\">Integer</span>—The output raster will be integer type.</li><li><span title=\"DOUBLE\">Double</span>—The output raster will be double type.</li></ul></xdoc>",
        "datatype.domain.DOUBLE": "Double",
        "datatype.domain.FLOAT": "Float",
        "datatype.domain.INTEGER": "Integer",
        "datatype.title": "Output Data Type",
        "description": "Creates a raster of accumulated flow into each cell.",
        "flowdirectiontype.descr": "<xdoc><p>Specifies the input flow direction raster type.</p><ul><li><span title=\"D8\">D8</span>—The input flow direction raster is of type D8. This is the default.</li><li><span title=\"MFD\">MFD</span>—The input flow direction raster is of type Multi Flow Direction (MFD).</li><li><span title=\"DINF\">DINF</span>—The input flow direction raster is of type D-Infinity (DINF).</li></ul></xdoc>",
        "flowdirectiontype.domain.D8": "D8",
        "flowdirectiontype.domain.DINF": "DINF",
        "flowdirectiontype.domain.MFD": "MFD",
        "flowdirectiontype.title": "Flow Direction Type",
        "inputflowdirectionraster.descr": "<xdoc><p>The input raster that shows the direction of flow out of each cell.</p><p>The flow direction raster can be created using the D8, MFD, or DINF method. Use the <span class=\"esri_uicontrol\">Flow Direction Type</span> parameter to specify the method used when the flow direction raster was created.</p></xdoc>",
        "inputflowdirectionraster.title": "Input Flow Direction Raster",
        "inputweightraster.descr": "An optional integer input raster for applying a weight to each cell.",
        "inputweightraster.title": "Input Weight Raster",
        "outputname.descr": "<xdoc><p>The name of the output flow accumulation raster service.</p><p>The default name is based on the tool name and the input layer name. If the layer name already exists, you will be prompted to provide another name.</p></xdoc>",
        "outputname.title": "Output Name",
        "outputraster.title": "Output Raster",
        "title": "Flow Accumulation"
    }
}
