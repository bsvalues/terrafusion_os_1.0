{
    "map": {
        "description": "Creates a set of concentric circles from a point, given a number of rings and distance between rings or a minimum and maximum distance from center.",
        "distance_units.descr": "<xdoc><p>Specifies the linear unit of measurement for the <span class=\"esri_uicontrol\">Interval Between Rings</span> parameter or the <span class=\"esri_uicontrol\">Minimum Range</span> and <span class=\"esri_uicontrol\">Maximum Range</span> parameters.</p><ul><li><span title=\"METERS\">Meters</span>—The unit will be meters. This is the default.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The unit will be kilometers.</li><li><span title=\"MILES\">Miles</span>—The unit will be miles.</li><li><span title=\"NAUTICAL_MILES\">Nautical miles</span>—The unit will be nautical miles.</li><li><span title=\"FEET\">Feet</span>—The unit will be feet.</li><li><span title=\"US_SURVEY_FEET\">US survey feet</span>—The unit will be U.S. survey feet.</li></ul></xdoc>",
        "distance_units.domain.FEET": "Feet",
        "distance_units.domain.KILOMETERS": "Kilometers",
        "distance_units.domain.METERS": "Meters",
        "distance_units.domain.MILES": "Miles",
        "distance_units.domain.NAUTICAL_MILES": "Nautical miles",
        "distance_units.domain.US_SURVEY_FEET": "US survey feet",
        "distance_units.title": "Distance Units",
        "in_features.descr": "The point feature set that identifies the center of the range ring. The input must have at least one point.",
        "in_features.title": "Input Features (Center Points)",
        "interval_between_rings.descr": "The distance between each ring.",
        "interval_between_rings.title": "Interval Between Rings",
        "maximum_range.descr": "The distance from the center to the farthest ring.",
        "maximum_range.title": "Maximum Range",
        "minimum_range.descr": "The distance from the center to the nearest ring.",
        "minimum_range.title": "Minimum Range",
        "number_of_radials.descr": "The number of radials to generate.",
        "number_of_radials.title": "Number of Radials",
        "number_of_rings.descr": "The number of rings to generate.",
        "number_of_rings.title": "Number of Rings",
        "out_feature_class_radials.descr": "The feature class containing the output radial features.",
        "out_feature_class_radials.title": "Output Feature Class (Radials)",
        "out_feature_class_rings.descr": "The feature class containing the output ring features.",
        "out_feature_class_rings.title": "Output Feature Class (Rings)",
        "params.category1": "Units Options",
        "range_rings_type.descr": "<xdoc><p>Specifies the method to create the range rings.</p><ul><li><span title=\"INTERVAL\">Interval</span>—Range rings will be generated based on the number of rings and distance between rings. This the default.</li><li><span title=\"MIN_MAX\">Minimum and maximum</span>—Range rings will be generated based on a minimum and maximum distance.</li></ul></xdoc>",
        "range_rings_type.domain.INTERVAL": "Interval",
        "range_rings_type.domain.MIN_MAX": "Minimum and maximum",
        "range_rings_type.title": "Range Ring Type",
        "title": "Generate Range Rings"
    }
}
