{
    "map": {
        "description": "Creates range rings with attributes derived from fields in a point feature class.",
        "distance_units.descr": "<xdoc><p>Specifies the linear unit of measure for the value of the <span class=\"esri_uicontrol\">Ring Interval Field </span> parameter or the values of the <span class=\"esri_uicontrol\">Minimum Range Field </span> and <span class=\"esri_uicontrol\">Maximum Range Field </span> parameters.</p><ul><li><span title=\"METERS\">Meters</span>—The unit will be meters. This is the default.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The unit will be kilometers.</li><li><span title=\"MILES\">Miles</span>—The unit will be miles.</li><li><span title=\"NAUTICAL_MILES\">Nautical miles</span>—The unit will be nautical miles.</li><li><span title=\"FEET\">Feet</span>—The unit will be feet.</li><li><span title=\"US_SURVEY_FEET\">US survey feet</span>—The unit will be U.S. survey feet.</li></ul></xdoc>",
        "distance_units.domain.FEET": "Feet",
        "distance_units.domain.KILOMETERS": "Kilometers",
        "distance_units.domain.METERS": "Meters",
        "distance_units.domain.MILES": "Miles",
        "distance_units.domain.NAUTICAL_MILES": "Nautical miles",
        "distance_units.domain.US_SURVEY_FEET": "US survey feet",
        "distance_units.title": "Distance Units",
        "in_features.descr": "The point feature set that identifies the center of the range ring. The input must have at least one point.",
        "in_features.title": "Input Features",
        "max_range_field.descr": "The field that contains the values for the distance from the origin point to the outer ring.",
        "max_range_field.title": "Maximum Range Field",
        "min_range_field.descr": "The field that contains the values for the distance from the origin point to the inner ring.",
        "min_range_field.title": "Minimum Range Field",
        "out_feature_class_radials.descr": "The feature class that will contain the output radial features.",
        "out_feature_class_radials.title": "Output Feature Class (Radials)",
        "output_feature_class.descr": "The feature class that will contain the output ring features.",
        "output_feature_class.title": "Output Range Ring Feature Class",
        "radial_count_field.descr": "The field that contains the number of radials to be created.",
        "radial_count_field.title": "Radial Count Field",
        "range_rings_type.descr": "<xdoc><p>Specifies how range rings will be generated.</p><ul><li><span title=\"INTERVAL\">Interval</span>—Range rings will be generated based on the number of rings and distance between rings. This the default.</li><li><span title=\"MIN_MAX\">Minimum and maximum</span>—Range rings will be generated based on a minimum and maximum distance.</li></ul></xdoc>",
        "range_rings_type.domain.INTERVAL": "Interval",
        "range_rings_type.domain.MIN_MAX": "Minimum and maximum",
        "range_rings_type.title": "Range Ring Type",
        "ring_count_field.descr": "The field that contains the values for the number of rings to generate.",
        "ring_count_field.title": "Ring Count Field",
        "ring_interval_field.descr": "The field that contains the values for the interval between rings.",
        "ring_interval_field.title": "Ring Interval Field",
        "title": "Generate Range Rings From Features"
    }
}
