                    {
                        "value": "USNG",
                        "code": "$rc:in_coordinate_format.domain.USNG"
                    },
                    {
                        "value": "MGRS",
                        "code": "$rc:in_coordinate_format.domain.MGRS"
                    }
                ]
            },
            "value": "DD_2",
            "description": "$rc:in_coordinate_format.descr"
        },
        "bearing_units": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:bearing_units.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DEGREES",
                        "code": "$rc:bearing_units.domain.DEGREES"
                    },
                    {
                        "value": "MILS",
                        "code": "$rc:bearing_units.domain.MILS"
                    },
                    {
