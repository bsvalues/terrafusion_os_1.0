{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\CoordinateTableToLineOfBearing",
    "displayname": "$rc:title",
    "helpcontent": "74020003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_table": {
            "display_order": "0",
            "displayname": "$rc:in_table.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:in_table.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "display_order": "8",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "x_or_lon_field": {
            "display_order": "2",
            "displayname": "$rc:x_or_lon_field.title",
            "datatype": {
                "type": "Field"
            },
            "depends": [
                "in_table"
            ],
            "description": "$rc:x_or_lon_field.descr"
        },
        "bearing_field": {
