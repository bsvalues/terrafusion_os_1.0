{
    "map": {
        "description": "Generates a custom tiling scheme file that defines the scale levels, tile dimensions, and other properties for a web tile layer.",
        "dots_per_inch.descr": "The dots per inch (DPI) of the intended output device. If a DPI is specified that does not match the resolution of the output device, the scale of the map tile will appear incorrect. The default value is 96.",
        "dots_per_inch.title": "Dots(Pixels) Per Inch",
        "in_map.descr": "The current map or an existing .mxd file to be used for the tiling scheme.",
        "in_map.title": "Map Document",
        "num_of_scales.descr": "The number of scale levels that will be included in the tiling scheme.",
        "num_of_scales.title": "Number of Scales",
        "output_folder.descr": "The folder location where the cache schema and iteminfo files will be created in JSON format.",
        "output_folder.title": "Output Folder",
        "output_tiling_scheme.descr": "The path and file name of the tiling scheme file that will be created.",
        "output_tiling_scheme.title": "Output Tiling Scheme",
        "ready_to_serve_format.descr": "<xdoc><p>Specifies the file format of the cache schema that will be used and whether it will be generated using the open tile package specification.<ul><li>Checked—The cache schema will be generated in JSON format using the open tile package specification. An output folder must be specified in the <span class=\"esri_uicontrol\">Output Folder</span> parameter.</li><li>Unchecked—The cache schema will be generated in XML format. This is the default.</li></ul></p></xdoc>",
        "ready_to_serve_format.title": "Ready To Serve Format",
        "scales.descr": "The scale levels that will be included in the tiling scheme. These are not represented as fractions. Instead, use 500 to represent a scale of 1:500, and so on, for example.",
        "scales.dt.title1": "Scale",
        "scales.title": "Scales",
        "summary": "<xdoc><p>Generates a custom tiling scheme file that defines the scale levels, tile dimensions, and other properties for a web tile layer.</p><p>A tiling scheme describes how clients should reference the tiles in a cache and is a mapping between the spatial reference of the source map document and the tiling grid. The tiling grid uses a level of detail (scales), row, and column reference scheme. The scheme also defines the scale levels (levels of detail) at which the cache has tiles, the size of the tiles in pixels, and the screen resolution for which the tiles are intended to be most commonly displayed. A tiling scheme is needed to generate a map cache.</p></xdoc>",
        "tile_origin.descr": "The origin (upper left corner) of the tiling scheme in the coordinates of the spatial reference of the source data frame.",
        "tile_origin.title": "Tiling origin in map units",
        "tile_size.descr": "<xdoc><p>Specifies the width and height of the cache tiles in pixels. For the best balance between performance and manageability, avoid deviating from standard dimensions of 256 by 256 or 512 by 512.</p><ul><li><span title=\"128 x 128\">128 by 128 pixels</span>—The width and height of the cache tiles will be 128 by 128 pixels.</li><li><span title=\"256 x 256\">256 by 256 pixels</span>—The width and height of the cache tiles will be 256 by 256 pixels. This is the default.</li><li><span title=\"512 x 512\">512 by 512 pixels</span>—The width and height of the cache tiles will be 512 by 512 pixels.</li><li><span title=\"1024 x 1024\">1024 by 1024 pixels</span>—The width and height of the cache tiles will be 1024 by 1024 pixels.</li></ul></xdoc>",
        "tile_size.domain.1024 x 1024": "1024 by 1024 pixels",
        "tile_size.domain.128 x 128": "128 by 128 pixels",
        "tile_size.domain.256 x 256": "256 by 256 pixels",
        "tile_size.domain.512 x 512": "512 by 512 pixels",
        "tile_size.title": "Tile Size",
        "title": "Generate Map Server Cache Tiling Scheme"
    }
}
