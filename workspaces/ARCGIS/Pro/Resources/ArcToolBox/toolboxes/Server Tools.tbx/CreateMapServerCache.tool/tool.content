{
    "type": "FunctionTool",
    "guid": "{b28d53d5-612a-4c93-9f11-5d4b7b7cf2f5}",
    "displayname": "$rc:title",
    "helpcontent": "22010011",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "input_service": {
            "display_order": "0",
            "displayname": "$rc:input_service.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEImageServer"
                    },
                    {
                        "type": "DEMapServer"
                    }
                ]
            },
            "description": "$rc:input_service.descr"
        },
        "service_cache_directory": {
            "display_order": "1",
            "displayname": "$rc:service_cache_directory.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:service_cache_directory.descr"
        },
        "tiling_scheme_type": {
            "display_order": "2",
            "control_guid": "{485D3503-E739-42A0-B3FC-B71F393110A7}",
            "displayname": "$rc:tiling_scheme_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NEW",
                        "code": "$rc:tiling_scheme_type.domain.NEW"
                    },
                    {
                        "value": "PREDEFINED",
                        "code": "$rc:tiling_scheme_type.domain.PREDEFINED"
                    }
                ]
            },
            "value": "NEW",
            "description": "$rc:tiling_scheme_type.descr"
        },
        "scales_type": {
            "display_order": "4",
            "displayname": "$rc:scales_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "STANDARD",
                        "code": "$rc:scales_type.domain.STANDARD"
                    },
                    {
                        "value": "CUSTOM",
                        "code": "$rc:scales_type.domain.CUSTOM"
                    }
                ]
            },
            "value": "STANDARD",
            "description": "$rc:scales_type.descr"
        },
        "num_of_scales": {
            "display_order": "5",
            "displayname": "$rc:num_of_scales.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:num_of_scales.descr"
        },
        "dots_per_inch": {
            "display_order": "7",
            "displayname": "$rc:dots_per_inch.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "96",
            "description": "$rc:dots_per_inch.descr"
        },
        "tile_size": {
            "display_order": "8",
            "displayname": "$rc:tile_size.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "128 x 128",
                        "code": "$rc:tile_size.domain.128 x 128"
                    },
                    {
                        "value": "256 x 256",
                        "code": "$rc:tile_size.domain.256 x 256"
                    },
                    {
                        "value": "512 x 512",
                        "code": "$rc:tile_size.domain.512 x 512"
                    },
                    {
                        "value": "1024 x 1024",
                        "code": "$rc:tile_size.domain.1024 x 1024"
                    }
                ]
            },
            "value": "256 x 256",
            "description": "$rc:tile_size.descr"
        },
        "predefined_tiling_scheme": {
            "enabled": "false",
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:predefined_tiling_scheme.title",
            "datatype": {
                "type": "DEFile"
            },
            "description": "$rc:predefined_tiling_scheme.descr"
        },
        "tile_origin": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:tile_origin.title",
            "datatype": {
                "type": "GPPoint"
            },
            "value": "0 0",
            "description": "$rc:tile_origin.descr"
        },
        "scales": {
            "enabled": "false",
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:scales.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPDouble",
                        "displayname": "$rc:scales.dt.title1"
                    }
                ]
            },
            "description": "$rc:scales.descr"
        },
        "cache_tile_format": {
            "type": "optional",
            "display_order": "12",
            "displayname": "$rc:cache_tile_format.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PNG",
                        "code": "$rc:cache_tile_format.domain.PNG"
                    },
                    {
                        "value": "PNG8",
                        "code": "$rc:cache_tile_format.domain.PNG8"
                    },
                    {
                        "value": "PNG24",
                        "code": "$rc:cache_tile_format.domain.PNG24"
                    },
                    {
                        "value": "PNG32",
                        "code": "$rc:cache_tile_format.domain.PNG32"
                    },
                    {
                        "value": "JPEG",
                        "code": "$rc:cache_tile_format.domain.JPEG"
                    },
                    {
                        "value": "MIXED",
                        "code": "$rc:cache_tile_format.domain.MIXED"
                    }
                ]
            },
            "value": "PNG",
            "description": "$rc:cache_tile_format.descr"
        },
        "tile_compression_quality": {
            "enabled": "false",
            "type": "optional",
            "display_order": "13",
            "displayname": "$rc:tile_compression_quality.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "0",
            "description": "$rc:tile_compression_quality.descr"
        },
        "storage_format": {
            "enabled": "false",
            "type": "optional",
            "display_order": "14",
            "displayname": "$rc:storage_format.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "COMPACT",
                        "code": "$rc:storage_format.domain.COMPACT"
                    }
                ]
            },
            "value": "COMPACT",
            "description": "$rc:storage_format.descr"
        },
        "out_service_url": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_service_url.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "ready_to_serve_format": {
            "type": "optional",
            "display_order": "14",
            "displayname": "$rc:ready_to_serve_format.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "READY_TO_SERVE_FORMAT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NON_READY_TO_SERVE_FORMAT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:ready_to_serve_format.descr"
        }
    }
}
