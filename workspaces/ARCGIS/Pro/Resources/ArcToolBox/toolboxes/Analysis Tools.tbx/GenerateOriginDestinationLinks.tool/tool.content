{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "1030008",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "origin_features": {
            "displayname": "$rc:origin_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "description": "$rc:origin_features.descr"
        },
        "destination_features": {
            "displayname": "$rc:destination_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "description": "$rc:destination_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "origin_group_field": {
            "type": "optional",
            "displayname": "$rc:origin_group_field.title",
            "datatype": {
                "type": "Field"
            },
            "depends": [
                "origin_features"
            ],
            "description": "$rc:origin_group_field.descr"
        },
        "destination_group_field": {
            "type": "optional",
            "displayname": "$rc:destination_group_field.title",
            "datatype": {
                "type": "Field"
            },
            "depends": [
                "destination_features"
            ],
            "description": "$rc:destination_group_field.descr"
        },
        "line_type": {
            "type": "optional",
            "displayname": "$rc:line_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PLANAR",
                        "code": "$rc:line_type.domain.PLANAR"
                    },
                    {
                        "value": "GEODESIC",
                        "code": "$rc:line_type.domain.GEODESIC"
                    }
                ]
            },
            "value": "PLANAR",
            "description": "$rc:line_type.descr"
        },
        "num_nearest": {
            "type": "optional",
            "displayname": "$rc:num_nearest.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:num_nearest.descr"
        },
        "search_distance": {
            "type": "optional",
            "displayname": "$rc:search_distance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:search_distance.descr"
        },
        "distance_unit": {
            "type": "optional",
            "displayname": "$rc:distance_unit.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:distance_unit.domain.KILOMETERS"
                    },
                    {
                        "value": "METERS",
                        "code": "$rc:distance_unit.domain.METERS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:distance_unit.domain.MILES"
                    },
                    {
                        "value": "NAUTICALMILES",
                        "code": "$rc:distance_unit.domain.NAUTICALMILES"
                    },
                    {
                        "value": "YARDS",
                        "code": "$rc:distance_unit.domain.YARDS"
                    },
                    {
                        "value": "FEET",
                        "code": "$rc:distance_unit.domain.FEET"
                    }
                ]
            },
            "description": "$rc:distance_unit.descr"
        },
        "aggregate_links": {
            "type": "optional",
            "displayname": "$rc:aggregate_links.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "AGGREGATE_OVERLAPPING"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_AGGREGATE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:aggregate_links.descr"
        },
        "sum_fields": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:sum_fields.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:sum_fields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:sum_fields.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "SUM",
                                "code": "$rc:sum_fields.domain.item2.SUM"
                            },
                            {
                                "value": "MEAN",
                                "code": "$rc:sum_fields.domain.item2.MEAN"
                            },
                            {
                                "value": "MIN",
                                "code": "$rc:sum_fields.domain.item2.MIN"
                            },
                            {
                                "value": "MAX",
                                "code": "$rc:sum_fields.domain.item2.MAX"
                            },
                            {
                                "value": "RANGE",
                                "code": "$rc:sum_fields.domain.item2.RANGE"
                            },
                            {
                                "value": "STD",
                                "code": "$rc:sum_fields.domain.item2.STD"
                            },
                            {
                                "value": "COUNT",
                                "code": "$rc:sum_fields.domain.item2.COUNT"
                            },
                            {
                                "value": "MEDIAN",
                                "code": "$rc:sum_fields.domain.item2.MEDIAN"
                            },
                            {
                                "value": "VARIANCE",
                                "code": "$rc:sum_fields.domain.item2.VARIANCE"
                            },
                            {
                                "value": "UNIQUE",
                                "code": "$rc:sum_fields.domain.item2.UNIQUE"
                            },
                            {
                                "value": "FIRST",
                                "code": "$rc:sum_fields.domain.item2.FIRST"
                            },
                            {
                                "value": "LAST",
                                "code": "$rc:sum_fields.domain.item2.LAST"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "destination_features"
            ],
            "description": "$rc:sum_fields.descr"
        }
    },
    "environments": [
        "extent",
        "scratchWorkspace",
        "workspace"
    ]
}
