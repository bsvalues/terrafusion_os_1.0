{
    "version": "1.0",
    "alias": "stpm",
    "displayname": "$rc:title",
    "description": "$rc:descr",
    "helpcontext": "50000000",
    "toolsets": {
        "$rc:toolset2.name": {
            "tools": [
                "CreateSpaceTimeCube",
                "CreateSpaceTimeCubeDefinedLocations",
                "CreateSpaceTimeCubeMDRasterLayer"
            ]
        },
        "$rc:toolset5.name": {
            "tools": [
                "VisualizeSpaceTimeCube2D",
                "VisualizeSpaceTimeCube3D"
            ]
        },
        "$rc:toolset1.name": {
            "tools": [
                "ChangePointDetection",
                "EmergingHotSpotAnalysis",
                "LocalOutlierAnalysis",
                "TimeSeriesClustering",
                "TimeSeriesCrossCorrelation"
            ]
        },
        "$rc:toolset3.name": {
            "tools": [
                "CurveFitForecast",
                "EvaluateForecastsByLocation",
                "ExponentialSmoothingForecast",
                "ForestBasedForecast"
            ]
        },
        "$rc:toolset4.name": {
            "tools": [
                "DescribeSpaceTimeCube",
                "FillMissingValues",
                "SubsetSpaceTimeCube"
            ]
        }
    }
}
