{
    "type": "FunctionTool",
    "guid": "{33CA4A60-4D2E-4583-8844-3D0A75F6D305}/ImportJobData",
    "displayname": "$rc:title",
    "helpcontent": "35000007",
    "description": "$rc:description",
    "product": "200",
    "extensions": [
        "40"
    ],
    "params": {
        "Input_File": {
            "displayname": "$rc:input_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "jxl",
                    "xml"
                ]
            },
            "description": "$rc:input_file.descr"
        },
        "Input_Merge": {
            "displayname": "$rc:input_merge.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "COMBINE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "REPLACE"
                    }
                ]
            },
            "description": "$rc:input_merge.descr"
        },
        "Input_DatabasePath": {
            "type": "optional",
            "displayname": "$rc:input_databasepath.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "jtc"
                ]
            },
            "description": "$rc:input_databasepath.descr"
        },
        "Input_Repository_Name": {
            "type": "optional",
            "displayname": "$rc:input_repository_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:input_repository_name.descr"
        },
        "Output_Status": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_status.title",
            "datatype": {
                "type": "GPLong"
            }
        }
    }
}
