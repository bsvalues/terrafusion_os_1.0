            "displayname": "$rc:probability_threshold.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:probability_threshold.descr"
        },
        "semivariogram_model_type": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:semivariogram_model_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POWER",
                        "code": "$rc:semivariogram_model_type.domain.POWER"
                    },
                    {
                        "value": "LINEAR",
                        "code": "$rc:semivariogram_model_type.domain.LINEAR"
                    },
                    {
                        "value": "THIN_PLATE_SPLINE",
                        "code": "$rc:semivariogram_model_type.domain.THIN_PLATE_SPLINE"
                    },
                    {
                        "value": "EXPONENTIAL",
                        "code": "$rc:semivariogram_model_type.domain.EXPONENTIAL"
                    },
                    {
                        "value": "EXPONENTIAL_DETRENDED",
                        "code": "$rc:semivariogram_model_type.domain.EXPONENTIAL_DETRENDED"
                    },
                    {
                        "value": "WHITTLE",
                        "code": "$rc:semivariogram_model_type.domain.WHITTLE"
                    },
                    {
                        "value": "WHITTLE_DETRENDED",
                        "code": "$rc:semivariogram_model_type.domain.WHITTLE_DETRENDED"
                    },
                    {
                        "value": "K_BESSEL",
                        "code": "$rc:semivariogram_model_type.domain.K_BESSEL"
                    },
                    {
                        "value": "K_BESSEL_DETRENDED",
                        "code": "$rc:semivariogram_model_type.domain.K_BESSEL_DETRENDED"
                    }
                ]
            },
            "value": "POWER",
