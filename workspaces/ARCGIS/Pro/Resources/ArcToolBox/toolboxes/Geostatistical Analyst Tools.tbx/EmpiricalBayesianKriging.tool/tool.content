{
    "type": "FunctionTool",
    "guid": "{8bc60f59-070b-47ca-8604-58b2c2ba4e77}",
    "displayname": "$rc:title",
    "helpcontent": "11000024",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "6"
    ],
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polygon"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "z_field": {
            "display_order": "1",
            "displayname": "$rc:z_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:z_field.descr"
        },
        "out_ga_layer": {
            "type": "optional",
            "direction": "out",
            "display_order": "2",
            "control_guid": "{DA8EA072-AD53-11D5-A685-0008C711C8C1}",
            "displayname": "$rc:out_ga_layer.title",
            "datatype": {
                "type": "GPGALayer"
            },
            "description": "$rc:out_ga_layer.descr"
        },
        "out_raster": {
            "type": "optional",
            "direction": "out",
            "display_order": "3",
            "displayname": "$rc:out_raster.title",
            "datatype": {
                "type": "DERasterDataset"
            },
            "description": "$rc:out_raster.descr"
        },
        "cell_size": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:cell_size.title",
            "datatype": {
                "type": "analysis_cell_size"
            },
            "domain": {
                "type": "GPSAGeoDataDomain",
                "checkfield": "false",
                "singleband": "false",
                "datatype": [
                    "DERasterDataset",
                    "DERasterBand",
                    "GPRasterLayer",
                    "analysis_cell_size",
                    "DEMosaicDataset",
                    "GPMosaicLayer",
                    "GPRasterCalculatorExpression",
                    "DETable",
                    "DEImageServer",
                    "DEFile"
                ],
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text"
                ],
                "geometrytype": [
                    "Point",
                    "Polygon",
                    "Polyline",
                    "Multipoint"
                ]
            },
            "description": "$rc:cell_size.descr"
        },
        "transformation_type": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:transformation_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NONE",
                        "code": "$rc:transformation_type.domain.NONE"
                    },
                    {
                        "value": "EMPIRICAL",
                        "code": "$rc:transformation_type.domain.EMPIRICAL"
                    },
                    {
                        "value": "LOGEMPIRICAL",
                        "code": "$rc:transformation_type.domain.LOGEMPIRICAL"
                    }
                ]
            },
            "value": "NONE",
            "description": "$rc:transformation_type.descr"
        },
        "max_local_points": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:max_local_points.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "20",
                "max": "1000"
            },
            "value": "100",
            "description": "$rc:max_local_points.descr"
        },
        "overlap_factor": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:overlap_factor.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0.01",
                "max": "5"
            },
            "value": "1",
            "description": "$rc:overlap_factor.descr"
        },
        "number_semivariograms": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:number_semivariograms.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "30",
                "max": "10000"
            },
            "value": "100",
            "description": "$rc:number_semivariograms.descr"
        },
        "search_neighborhood": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:search_neighborhood.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPGASearchNeighborhood"
            },
            "domain": {
                "type": "GPGASearchNeighborhoodDomain",
                "chordaldistance": "true",
                "neighbourtype": [
                    "StandardCircular",
                    "SmoothCircular"
                ]
            },
            "value": "NBRTYPE=StandardCircular RADIUS=nan ANGLE=0 NBR_MAX=15 NBR_MIN=10 SECTOR_TYPE=ONE_SECTOR",
            "description": "$rc:search_neighborhood.descr"
        },
        "output_type": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:output_type.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PREDICTION",
                        "code": "$rc:output_type.domain.PREDICTION"
                    },
                    {
                        "value": "QUANTILE",
                        "code": "$rc:output_type.domain.QUANTILE"
                    },
                    {
                        "value": "PROBABILITY",
                        "code": "$rc:output_type.domain.PROBABILITY"
                    },
                    {
                        "value": "PREDICTION_STANDARD_ERROR",
                        "code": "$rc:output_type.domain.PREDICTION_STANDARD_ERROR"
                    }
                ]
            },
            "value": "PREDICTION",
            "description": "$rc:output_type.descr"
        },
        "quantile_value": {
            "type": "optional",
            "display_order": "11",
            "displayname": "$rc:quantile_value.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1e-10",
                "max": "0.99999999989999999"
            },
            "value": "0.5",
            "description": "$rc:quantile_value.descr"
        },
        "threshold_type": {
            "type": "optional",
            "display_order": "12",
            "displayname": "$rc:threshold_type.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "EXCEED",
                        "code": "$rc:threshold_type.domain.EXCEED"
                    },
                    {
                        "value": "NOT_EXCEED",
                        "code": "$rc:threshold_type.domain.NOT_EXCEED"
                    }
                ]
            },
            "value": "EXCEED",
            "description": "$rc:threshold_type.descr"
        },
        "probability_threshold": {
