{
    "map": {
        "bandwidth.descr": "Used to specify the maximum distance at which data points are used for prediction. With increasing bandwidth, prediction bias increases and prediction variance decreases.",
        "bandwidth.title": "Bandwidth",
        "cell_size.descr": "<xdoc><p>The cell size at which the output raster will be created.</p><p>This value can be explicitly set in the <span class=\"esri_uicontrol\">Environments</span> by the <span class=\"esri_uicontrol\">Cell Size</span> parameter.</p><p>If not set, it is the shorter of the width or the height of the extent of the input point features, in the input spatial reference, divided by 250.</p></xdoc>",
        "cell_size.title": "Output cell size",
        "description": "A moving window predictor that uses the shortest distance between points so that points on either side of the line barriers are connected.",
        "in_barrier_features.descr": "Absolute barrier features using non-Euclidean distances rather than line-of-sight distances.",
        "in_barrier_features.title": "Input absolute barrier features",
        "in_features.descr": "The input point features containing the z-values to be interpolated.",
        "in_features.title": "Input features",
        "kernel_function.descr": "<xdoc><p>The kernel function used in the simulation.</p><ul><li><span title=\"EXPONENTIAL\">Exponential</span>— The function grows or decays proportionally.</li><li><span title=\"GAUSSIAN\">Gaussian</span>— Bell-shaped function that falls off quickly toward plus/minus infinity.</li><li><span title=\"QUARTIC\">Quartic</span>— Fourth-order polynomial function.</li><li><span title=\"EPANECHNIKOV\">Epanechnikov</span>— A discontinuous parabolic function.</li><li><span title=\"POLYNOMIAL5\">Fifth order polynomial</span>— Fifth-order polynomial function.</li><li><span title=\"CONSTANT\">Constant</span>—An indicator function.</li></ul></xdoc>",
        "kernel_function.domain.CONSTANT": "Constant",
        "kernel_function.domain.EPANECHNIKOV": "Epanechnikov",
        "kernel_function.domain.EXPONENTIAL": "Exponential",
        "kernel_function.domain.GAUSSIAN": "Gaussian",
        "kernel_function.domain.POLYNOMIAL5": "Fifth order polynomial",
        "kernel_function.domain.QUARTIC": "Quartic",
        "kernel_function.title": "Kernel function",
        "out_ga_layer.descr": "The geostatistical layer produced. This layer is required output only if no output raster is requested.",
        "out_ga_layer.title": "Output geostatistical layer",
        "out_raster.descr": "The output raster. This raster is required output only if no output geostatistical layer is requested.",
        "out_raster.title": "Output raster",
        "output_type.descr": "<xdoc><p>Surface type to store the interpolation results.</p><ul><li><span title=\"PREDICTION\">Prediction</span>—Prediction surfaces are produced from the interpolated values.</li><li><span title=\"PREDICTION_STANDARD_ERROR\">Standard error of prediction</span>— Standard Error surfaces are produced from the standard errors of the interpolated values.</li></ul></xdoc>",
        "output_type.domain.PREDICTION": "Prediction",
        "output_type.domain.PREDICTION_STANDARD_ERROR": "Standard error of prediction",
        "output_type.title": "Output surface type",
        "power.descr": "Sets the order of the polynomial.",
        "power.title": "Order of polynomial",
        "ridge.descr": "Used for the numerical stabilization of the solution of the system of linear equations. It does not influence predictions in the case of regularly distributed data without barriers. Predictions for areas in which the data is located near the feature barrier or isolated by the barriers can be unstable and tend to require relatively large ridge parameter values.",
        "ridge.title": "Ridge parameter",
        "title": "Kernel Interpolation With Barriers",
        "z_field.descr": "Field that holds a height or magnitude value for each point. This can be a numeric field or the Shape field if the input features contain z-values or m-values.",
        "z_field.title": "Z value field"
    }
}
