{
    "map": {
        "derive_from_line_network.descr": "<xdoc><p>Determines if the current LRS network will be configured as an LRS Derived Network.</p><ul><li><span title=\"AS_IS\">As is</span>—The current LRS Network derived property will not be changed. This is the default.</li><li><span title=\"DERIVE\">Derive</span>—The input LRS Derived Network will be modified to become an LRS Derived Network. The line network name parameter must also be provided to specify which LRS Network to derive from.</li><li><span title=\"DO_NOT_DERIVE\">Do not derive</span>—The input LRS Derived Network will be modified to no longer be an LRS Derived Network.</li></ul></xdoc>",
        "derive_from_line_network.domain.AS_IS": "As is",
        "derive_from_line_network.domain.DERIVE": "Derive",
        "derive_from_line_network.domain.DO_NOT_DERIVE": "Do not derive",
        "derive_from_line_network.title": "Derive From Line Network",
        "description": "Modifies an LRS Network in a Location Referencing linear referencing system (LRS).",
        "from_date_field.descr": "A date field in the input feature class that will be mapped as the LRS Network from date.",
        "from_date_field.title": "From Date Field",
        "in_feature_class.descr": "The input LRS Network feature class to be modified.",
        "in_feature_class.title": "LRS Network Feature Class",
        "include_fields_to_support_lines.descr": "<xdoc><p>Determines if the current LRS network will be configured to support lines.</p><ul><li><span title=\"AS_IS\">As is</span>—The current LRS Network line support property will not be changed. This is the default.</li><li><span title=\"INCLUDE\">Include</span>—The input LRS Network will be modified to add support for lines. The line id field, line name field, and line order field parameters must also be provided, and valid fields to map to these parameters must exist in the LRS network feature class.</li><li><span title=\"DO_NOT_INCLUDE\">Do not include</span>—The input LRS Network will be modified to remove support for lines.</li></ul></xdoc>",
        "include_fields_to_support_lines.domain.AS_IS": "As is",
        "include_fields_to_support_lines.domain.DO_NOT_INCLUDE": "Do not include",
        "include_fields_to_support_lines.domain.INCLUDE": "Include",
        "include_fields_to_support_lines.title": "Include Fields to Support Lines",
        "individual_route_id_fields.descr": "<xdoc><p>The individual fields in the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> that will be used to form the route ID. This parameter is only used if the <span class=\"esri_uicontrol\">Route ID Field Configuration</span> parameter&apos;s <span class=\"esri_uicontrol\">Multi-Field Route ID</span> option is set. The fields must be either string or number integer field types.</p></xdoc>",
        "individual_route_id_fields.title": "Field(s)",
        "line_id_field.descr": "<xdoc><p>The field in the input feature class that will be mapped as the LRS Network line ID. This parameter is only used if the <span class=\"esri_uicontrol\">Include Fields to Support Lines</span> parameter is set to <span class=\"esri_uicontrol\">Include</span>. The field type must match the <span class=\"esri_fieldname\">RouteId</span> field type of the Centerline_Sequence table and must either be a string of exactly 38 characters or a GUID field type.</p></xdoc>",
        "line_id_field.title": "Line ID Field",
        "line_name_field.descr": "<xdoc><p>A string field in the input feature class that will be mapped as the LRS Network line name. This parameter is only used if the <span class=\"esri_uicontrol\">Include Fields to Support Lines</span> parameter is set to <span class=\"esri_uicontrol\">Include</span>.</p></xdoc>",
        "line_name_field.title": "Line Name Field",
        "line_network_name.descr": "<xdoc><p>The name of the LRS Line Network to which the input LRS Derived Network will be registered. The input LRS Line Network must reside in the same geodatabase workspace and LRS as the LRS network feature class. This parameter is only used if the <span class=\"esri_uicontrol\">Derive From Line Network</span> parameter is set to <span class=\"esri_uicontrol\">Derive</span>.</p></xdoc>",
        "line_network_name.title": "Line Network Name",
        "line_order_field.descr": "<xdoc><p>The field in the input feature class that will be mapped as the LRS Network line order. This parameter is only used if the <span class=\"esri_uicontrol\">Include Fields to Support Lines</span> parameter is set to <span class=\"esri_uicontrol\">Include</span>. This must be a long integer field type.</p></xdoc>",
        "line_order_field.title": "Line Order Field",
        "out_feature_class.title": "Output Network Feature Class",
        "route_id_configuration.descr": "<xdoc><p>Determines the route ID configuration for an LRS Network.</p><ul><li><span title=\"AS_IS\">As is</span>—The current LRS Network route ID configuration will not be changed. This is the default.</li><li><span title=\"AUTOGENERATED_ROUTE_ID\">Autogenerated Route ID</span>—The route ID field will be an autogenerated GUID, and the route name can be configured as an LRS field.</li><li><span title=\"SINGLE_FIELD_ROUTE_ID\">Single-Field Route ID</span>—Supported only for nonline networks.</li><li><span title=\"MULTI_FIELD_ROUTE_ID\">Multi-Field Route ID</span>—Supported only for nonline networks. More than one field is needed to form the concatenated route ID.</li></ul></xdoc>",
        "route_id_configuration.domain.AS_IS": "As is",
        "route_id_configuration.domain.AUTOGENERATED_ROUTE_ID": "Autogenerated Route ID",
        "route_id_configuration.domain.MULTI_FIELD_ROUTE_ID": "Multi-Field Route ID",
        "route_id_configuration.domain.SINGLE_FIELD_ROUTE_ID": "Single-Field Route ID",
        "route_id_configuration.title": "Route ID Field Configuration",
        "route_id_field.descr": "<xdoc><p>The field in the input feature class that will be mapped as the LRS Network route ID. The field type must match the <span class=\"esri_fieldname\">RouteId</span> field type of the Centerline_Sequence table and must either be a string or GUID field type.</p></xdoc>",
        "route_id_field.title": "Route ID Field",
        "route_name_field.descr": "A string field in the input feature class that will be mapped as the LRS Network route name.",
        "route_name_field.title": "Route Name Field",
        "title": "Modify LRS Network",
        "to_date_field.descr": "A date field in the input feature class that will be mapped as the LRS Network to date.",
        "to_date_field.title": "To Date Field"
    }
}
