{
    "map": {
        "derive_from_line_network.descr": "<xdoc><p>Specifies whether the network will be configured as an LRS derived network.</p><ul><li>Checked—The output of this tool will be an LRS derived network. The <span class=\"esri_uicontrol\">Line Network Name</span> parameter must also be provided.</li><li>Unchecked—The output of this tool will not be an LRS derived network. This is the default.</li></ul></xdoc>",
        "derive_from_line_network.title": "Derive From Line Network",
        "description": "Creates an LRS Network using an existing polyline feature class.",
        "from_date_field.descr": "<xdoc><p>A date field in the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> value that will be mapped as the LRS Network from date.</p></xdoc>",
        "from_date_field.title": "From Date Field",
        "in_feature_class.descr": "The input feature class that will be registered as the LRS Network. The name of the feature class must be 26 or fewer characters. The feature class must reside in a geodatabase that contains an LRS. The name of this feature class will be used as the name of the LRS Network.",
        "in_feature_class.title": "LRS Network Feature Class",
        "include_fields_to_support_lines.descr": "<xdoc><p>Specifies whether the network will be configured to support lines.</p><ul><li>Checked—The output of this tool will be an LRS line network. The <span class=\"esri_uicontrol\">Line ID Field</span>, <span class=\"esri_uicontrol\">Line Name Field</span>, and <span class=\"esri_uicontrol\">Line Order Field</span> parameters must also be provided.</li><li>Unchecked—The output of this tool will not be an LRS line network. This is the default.</li></ul></xdoc>",
        "include_fields_to_support_lines.title": "Include Fields to Support Lines",
        "individual_route_id_fields.descr": "<xdoc><p>The individual fields in the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> value that will be used to form the route ID. This parameter is only used if the <span class=\"esri_uicontrol\">Route ID Field Configuration</span> parameter value is set to <span class=\"esri_uicontrol\">Multi-Field Route ID</span>. The fields must be either string or integer field types.</p></xdoc>",
        "individual_route_id_fields.title": "Field(s)",
        "line_id_field.descr": "<xdoc><p>The field in the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> value that will be mapped as the LRS Network line ID. This parameter is only used if the <span class=\"esri_uicontrol\">Include Fields to Support Lines</span> parameter is checked. This must be a string or GUID field type and must match the field type and length of the route ID field in the centerline sequence table. It must also be the same field type as the <span class=\"esri_uicontrol\">Route ID Field</span> parameter value.</p></xdoc>",
        "line_id_field.title": "Line ID Field",
        "line_name_field.descr": "<xdoc><p>A string field in the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> value that will be mapped as the LRS Network line name. This parameter is only used if the <span class=\"esri_uicontrol\">Include Fields to Support Lines </span> parameter is checked.</p></xdoc>",
        "line_name_field.title": "Line Name Field",
        "line_network_name.descr": "<xdoc><p>The name of the LRS line network to which the output LRS derived network will be registered. The input LRS line network must reside in the same geodatabase workspace as the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> value. This parameter is only used if the <span class=\"esri_uicontrol\">Derive From Line Network</span> parameter is checked.</p></xdoc>",
        "line_network_name.title": "Line Network Name",
        "line_order_field.descr": "<xdoc><p>An integer field in the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> value that will be mapped as the LRS Network line order. This parameter is only used if the <span class=\"esri_uicontrol\">Include Fields to Support Lines </span> parameter is checked. This must be a long integer field type.</p></xdoc>",
        "line_order_field.title": "Line Order Field",
        "lrs_name.descr": "<xdoc><p>The LRS name to which the new LRS Network will be registered. The LRS must reside in the same geodatabase as the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> value.</p></xdoc>",
        "lrs_name.title": "LRS Name",
        "out_feature_class.title": "Output Network Feature Class",
        "route_id_configuration.descr": "<xdoc><p>Specifies the route ID configuration for the LRS Network.</p><ul><li><span title=\"AUTOGENERATED_ROUTE_ID\">Autogenerated Route ID</span>—The route ID field will be an automatically generated GUID. The route name can be configured as an LRS field. This is the default.</li><li><span title=\"SINGLE_FIELD_ROUTE_ID\">Single-Field Route ID</span>—The route ID field will be a single user-generated field. Only nonline networks are supported.</li><li><span title=\"MULTI_FIELD_ROUTE_ID\">Multi-Field Route ID</span>—The route ID field will be a user-generated field concatenated from more than one field to form the route ID. Only nonline networks are supported.</li></ul></xdoc>",
        "route_id_configuration.domain.AUTOGENERATED_ROUTE_ID": "Autogenerated Route ID",
        "route_id_configuration.domain.MULTI_FIELD_ROUTE_ID": "Multi-Field Route ID",
        "route_id_configuration.domain.SINGLE_FIELD_ROUTE_ID": "Single-Field Route ID",
        "route_id_configuration.title": "Route ID Field Configuration",
        "route_id_field.descr": "<xdoc><p>The field in the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> value that will be mapped as the LRS Network route ID. This must be a string or GUID field type.</p></xdoc>",
        "route_id_field.title": "Route ID Field",
        "route_name_field.descr": "<xdoc><p>A string field in the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> value that will be mapped as the LRS Network route name.</p></xdoc>",
        "route_name_field.title": "Route Name Field",
        "title": "Create LRS Network From Existing Dataset",
        "to_date_field.descr": "<xdoc><p>A date field in the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> value that will be mapped as the LRS Network to date.</p></xdoc>",
        "to_date_field.title": "To Date Field"
    }
}
