{
    "map": {
        "boundary_features.descr": "The boundary layer that will be used to summarize the data.",
        "boundary_features.title": "Boundary Features",
        "description": "Transforms LRS data to create a length product for  selected\nroutes in an LRS Network. For example, use this tool to summarize the mileage of a set of routes or lines by a county boundary.",
        "effective_date.descr": "The date that will be used to define the temporal view of the network.",
        "effective_date.title": "Effective Date",
        "exclude_null_summary_rows.descr": "<xdoc><p>Specifies whether null summary rows will be excluded from the output.</p><ul><li>Checked—Uncalibrated routes or routes with zero length will be excluded from the output. This is the default.</li><li>Unchecked—Uncalibrated routes or routes with zero length will not be excluded from the output; they will be included in the output with a mileage of 0.</li></ul></xdoc>",
        "exclude_null_summary_rows.title": "Exclude null summary rows",
        "in_route_features.descr": "The LRS Network that will be used to calculate the length.",
        "in_route_features.title": "Input Route Features",
        "in_template.descr": "The input LRS Data template that specifies the summary and length fields.",
        "in_template.title": "Template",
        "out_file.descr": "The output .csv file where the calculated length will be written.",
        "out_file.title": "Output File",
        "out_table.descr": "The table that will be created with the calculated length.",
        "out_table.title": "Output Table",
        "output_format.descr": "<xdoc><p>Specifies the format of the output file.</p><ul><li><span title=\"CSV\">CSV</span>—The output file will be a .csv file. This is the default.</li></ul></xdoc>",
        "output_format.domain.CSV": "CSV",
        "output_format.title": "Output Format",
        "summary": "Transforms LRS data to create a length product for selected routes in an LRS Network. For example, use this tool to summarize the mileage of a set of routes or lines by a county boundary.",
        "summary_field.descr": "The field from the boundary layer that provides the names for the summary rows.",
        "summary_field.title": "Summary Field",
        "title": "Generate LRS Data Product",
        "units.descr": "<xdoc><p>Specifies the measurement units that will be used for the length field in the output.</p><ul><li><span title=\"INCHES\">Inches</span>—The units will be inches.</li><li><span title=\"FEET\">Feet</span>—The units will be feet.</li><li><span title=\"YARDS\">Yards</span>—The units will be yards.</li><li><span title=\"MILES\">Miles</span>—The units will be miles.</li><li><span title=\"NAUTICAL_MILES\">Nautical Miles</span>—The units will be nautical miles.</li><li><span title=\"INTMILES\">International Miles</span>—The units will be international miles.</li><li><span title=\"INTFEET\">International Feet</span>—The units will be international feet.</li><li><span title=\"MILLIMETERS\">Millimeters</span>—The units will be millimeters.</li><li><span title=\"CENTIMETERS\">Centimeters</span>—The units will be centimeters.</li><li><span title=\"METERS\">Meters</span>—The units will be meters.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The units will be kilometers.</li><li><span title=\"DECIMETERS\">Decimeters</span>—The units will be decimeters.</li></ul></xdoc>",
        "units.domain.CENTIMETERS": "Centimeters",
