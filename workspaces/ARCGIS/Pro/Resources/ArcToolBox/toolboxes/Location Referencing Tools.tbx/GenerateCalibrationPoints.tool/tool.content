{
    "type": "FunctionTool",
    "guid": "{0A4A9218-07A4-497A-8506-CED528063FB9}/GenerateCalibrationPoints",
    "displayname": "$rc:title",
    "helpcontent": "23000041",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "78"
    ],
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_polyline_features": {
            "displayname": "$rc:in_polyline_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:in_polyline_features.descr"
        },
        "route_id_field": {
            "displayname": "$rc:route_id_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Text",
                    "GUID"
                ]
            },
            "depends": [
                "in_polyline_features"
            ],
            "description": "$rc:route_id_field.descr"
        },
        "from_date_field": {
            "displayname": "$rc:from_date_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Date"
                ]
            },
            "depends": [
                "in_polyline_features"
            ],
            "description": "$rc:from_date_field.descr"
        },
        "to_date_field": {
            "displayname": "$rc:to_date_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Date"
                ]
            },
            "depends": [
                "in_polyline_features"
            ],
            "description": "$rc:to_date_field.descr"
        },
        "in_calibration_point_feature_class": {
            "displayname": "$rc:in_calibration_point_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ]
            },
            "description": "$rc:in_calibration_point_feature_class.descr"
        },
        "lrs_network": {
            "displayname": "$rc:lrs_network.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "depends": [
                "in_calibration_point_feature_class"
            ],
            "description": "$rc:lrs_network.descr"
        },
        "calibration_direction": {
            "type": "optional",
            "displayname": "$rc:calibration_direction.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DIGITIZED_DIRECTION",
                        "code": "$rc:calibration_direction.domain.DIGITIZED_DIRECTION"
                    },
                    {
                        "value": "MEASURE_DIRECTION",
                        "code": "$rc:calibration_direction.domain.MEASURE_DIRECTION"
                    }
                ]
            },
            "value": "DIGITIZED_DIRECTION",
            "description": "$rc:calibration_direction.descr"
        },
        "calibration_method": {
            "type": "optional",
            "displayname": "$rc:calibration_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "GEOMETRY_LENGTH",
                        "code": "$rc:calibration_method.domain.GEOMETRY_LENGTH"
                    },
                    {
                        "value": "M_ON_ROUTE",
                        "code": "$rc:calibration_method.domain.M_ON_ROUTE"
                    },
                    {
                        "value": "ATTRIBUTE_FIELDS",
                        "code": "$rc:calibration_method.domain.ATTRIBUTE_FIELDS"
                    }
                ]
            },
            "value": "GEOMETRY_LENGTH",
            "description": "$rc:calibration_method.descr"
        },
        "out_calibration_point_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_calibration_point_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_calibration_point_feature_class"
            ]
        },
        "out_details_file": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_details_file.title",
            "datatype": {
                "type": "DETextFile"
            }
        },
        "from_measure_field": {
            "type": "optional",
            "displayname": "$rc:from_measure_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Double"
                ]
            },
            "depends": [
                "in_polyline_features"
            ],
            "description": "$rc:from_measure_field.descr"
        },
        "to_measure_field": {
            "type": "optional",
            "displayname": "$rc:to_measure_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Double"
                ]
            },
            "depends": [
                "in_polyline_features"
            ],
            "description": "$rc:to_measure_field.descr"
        }
    },
    "environments": [
        "parallelProcessingFactor",
        "workspace"
    ]
}
