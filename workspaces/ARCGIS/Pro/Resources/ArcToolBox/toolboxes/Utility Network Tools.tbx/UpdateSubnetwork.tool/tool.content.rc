{
    "map": {
        "all_subnetworks_in_tier.descr": "<xdoc><p>Specifies whether all subnetworks in the tier will be updated. To update a subset of subnetworks in the tier, use the <span class=\"esri_uicontrol\">Subnetwork Name</span> parameter.<ul><li>Checked—All subnetworks in the tier will be updated. This option uses asynchronous processing to update the subnetworks using the system UtilityNetworkTools geoprocessing service. The service is reserved for utility network geoprocessing tasks and has a longer default timeout setting. This is the default.</li><li>Unchecked—Only the subnetworks that are specified in the <span class=\"esri_uicontrol\">Subnetwork Name</span> parameter will be updated.</li></ul></p></xdoc>",
        "all_subnetworks_in_tier.title": "All subnetworks in tier",
        "condition_barriers.descr": "<xdoc><note type=\"note\"/><p group=\"note\">This parameter is only available for Python.</p></xdoc>",
