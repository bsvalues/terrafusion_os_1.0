        "condition_barriers.title": "Condition Barriers",
        "continue_on_failure.descr": "<xdoc><p>Specifies whether the update process will stop if a subnetwork fails to update when updating multiple subnetworks.<ul><li>Checked—The update process will not stop if a subnetwork failure occurs; it will continue.</li><li>Unchecked—The update process will stop if a subnetwork failure occurs. This is the default.</li></ul></p></xdoc>",
        "continue_on_failure.title": "Continue on failure",
        "description": "Updates subnetwork information in the Subnetworks table, the SubnetLine feature class, and subnetwork system diagrams for the specified subnetworks.",
