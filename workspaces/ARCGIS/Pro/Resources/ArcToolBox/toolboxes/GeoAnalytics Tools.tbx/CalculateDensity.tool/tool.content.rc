{
    "map": {
        "area_unit_scale_factor.descr": "<xdoc><p>Specifies the areal units that will be used for the output density values. The default unit is based on the units of the output spatial reference.</p><ul><li><span title=\"ACRES\">International Acres</span>—The areal units will be international acres.</li><li><span title=\"HECTARES\">Hectares</span>—The areal units will be hectares.</li><li><span title=\"SQUARE_MILES\">Square Statute Miles</span>—The areal units will be square statute miles.</li><li><span title=\"SQUARE_KILOMETERS\">Square Kilometers</span>—The areal units will be square kilometers.</li><li><span title=\"SQUARE_METERS\">Square Meters</span>—The areal units will be square meters.</li><li><span title=\"SQUARE_FEET\">Square International Feet</span>—The areal units will be square international feet.</li><li><span title=\"SQUARE_YARDS\">Square International Yards</span>—The areal units will be square international yards.</li><li><span title=\"SQUARE_MILES_US\">Square US Survey Miles</span>—The areal units will be square US survey miles.</li><li><span title=\"SQUARE_FEET_US\">Square US Survey Feet</span>—The areal units will be square US survey feet.</li><li><span title=\"SQUARE_YARDS_US\">Square US Survey Yards</span>—The areal units will be square US survey yards.</li><li><span title=\"ACRES_US\">US Survey Acres</span>—The areal units will be US survey acres.</li></ul></xdoc>",
        "area_unit_scale_factor.domain.ACRES": "International Acres",
        "area_unit_scale_factor.domain.ACRES_US": "US Survey Acres",
        "area_unit_scale_factor.domain.HECTARES": "Hectares",
        "area_unit_scale_factor.domain.SQUARE_FEET": "Square International Feet",
        "area_unit_scale_factor.domain.SQUARE_FEET_US": "Square US Survey Feet",
        "area_unit_scale_factor.domain.SQUARE_KILOMETERS": "Square Kilometers",
        "area_unit_scale_factor.domain.SQUARE_METERS": "Square Meters",
        "area_unit_scale_factor.domain.SQUARE_MILES": "Square Statute Miles",
        "area_unit_scale_factor.domain.SQUARE_MILES_US": "Square US Survey Miles",
        "area_unit_scale_factor.domain.SQUARE_YARDS": "Square International Yards",
        "area_unit_scale_factor.domain.SQUARE_YARDS_US": "Square US Survey Yards",
        "area_unit_scale_factor.title": "Area Unit Scale Factor",
        "bin_size.descr": "The size of the bins that will be used to aggregate input features. When generating bins for squares, the number and units specified determine the height and length of the square. For hexagons, the number and units specified determine the distance between parallel sides.",
        "bin_size.title": "Bin Size",
        "bin_type.descr": "<xdoc><p>Specifies the bin shape that will be used in the analysis.</p><ul><li><span title=\"SQUARE\">Square</span>—The bin shape will be square. This is the default.</li><li><span title=\"HEXAGON\">Hexagon</span>—The bin shape will be hexagonal.</li></ul></xdoc>",
        "bin_type.domain.HEXAGON": "Hexagon",
        "bin_type.domain.SQUARE": "Square",
        "bin_type.title": "Bin Type",
        "data_store.descr": "<xdoc><p>Specifies the ArcGIS Data Store where the output will be stored. All results stored in a spatiotemporal big data store will be stored in WGS84. Results stored in a relational data store will maintain their coordinate system.</p><ul><li><span title=\"SPATIOTEMPORAL_DATA_STORE\">Spatiotemporal big data store</span>—Output will be stored in a spatiotemporal big data store. This is the default.</li><li><span title=\"RELATIONAL_DATA_STORE\">Relational data store</span>—Output will be stored in a relational data store.</li></ul></xdoc>",
        "data_store.domain.RELATIONAL_DATA_STORE": "Relational data store",
        "data_store.domain.SPATIOTEMPORAL_DATA_STORE": "Spatiotemporal big data store",
        "data_store.title": "Data Store",
        "description": "Calculates a magnitude-per-unit area from point features that fall within a neighborhood around each cell.",
        "fields.descr": "<xdoc><p>One or more fields denoting population values for each feature. The population field is the count or quantity to be spread across the landscape to create a continuous surface.</p><p>Values in the population field must be numeric. By default, the density of the count of input points will always be calculated.</p></xdoc>",
        "fields.title": "Fields",
        "input_layer.descr": "The points that will be used to calculate the density.",
        "input_layer.title": "Input layer",
        "neighborhood_size.descr": "The search radius that will be applied to density calculations.",
        "neighborhood_size.title": "Neighborhood Size",
        "output.title": "Output Feature Class",
        "output_name.descr": "The name of the output feature service.",
        "output_name.title": "Output Name",
        "params.category1": "Data Store",
        "summary": "<xdoc><p>Calculates a magnitude-per-unit area from point features that fall within a neighborhood around each cell.</p><p><note type=\"legacy\"/><p group=\"note\">The ArcGIS GeoAnalytics Server extension is being deprecated in ArcGIS Enterprise. The final release of GeoAnalytics Server was included with ArcGIS Enterprise 11.3. This geoprocessing tool is available through ArcGIS Enterprise 11.3 and earlier versions.</p></p></xdoc>",
        "time_step_interval.descr": "<xdoc><p>A value that specifies the duration of the time step. This parameter is only available if the input points are time enabled and represent an instant in time.</p><p>Time stepping can only be applied if time is enabled on the input.</p></xdoc>",
        "time_step_interval.title": "Time Step Interval",
        "time_step_reference.descr": "A date that specifies the reference time with which to align the time steps. The default is January 1, 1970, at 12:00 a.m. This parameter is only available if the input points are time enabled and represent an instant in time.",
        "time_step_reference.title": "Time Step Reference",
        "time_step_repeat.descr": "A value that specifies how often the time-step interval occurs. This parameter is only available if the input points are time enabled and represent an instant in time.",
        "time_step_repeat.title": "Time Step Repeat",
        "title": "Calculate Density",
        "weight.descr": "<xdoc><p>Specifies the weighting that will be applied to the density function.</p><ul><li><span title=\"UNIFORM\">Uniform</span>—A magnitude-per-area calculation in which each bin is equally weighted will be used. This is the default.</li><li><span title=\"KERNEL\">Kernel</span>—A magnitude-per-area calculation with a smoothing algorithm applied (kernel) that weights bins closer to the points more heavily will be used.</li></ul></xdoc>",
        "weight.domain.KERNEL": "Kernel",
        "weight.domain.UNIFORM": "Uniform",
        "weight.title": "Weight"
    }
}
