{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "51050004",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "GeoAnalyticsRuleExpression",
        "spark"
    ],
    "params": {
        "input_layer": {
            "displayname": "$rc:input_layer.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "domain": {
                "type": "GPTablesDomain",
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:input_layer.descr"
        },
        "output_name": {
            "displayname": "$rc:output_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:output_name.descr"
        },
        "track_fields": {
            "displayname": "$rc:track_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text",
                    "Date"
                ]
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:track_fields.descr"
        },
        "start_condition": {
            "displayname": "$rc:start_condition.title",
            "datatype": {
                "type": "GPCalculatorExpression"
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:start_condition.descr"
        },
        "end_condition": {
            "type": "optional",
            "displayname": "$rc:end_condition.title",
            "datatype": {
                "type": "GPCalculatorExpression"
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:end_condition.descr"
        },
        "output_mode": {
            "type": "optional",
            "displayname": "$rc:output_mode.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ALL_FEATURES",
                        "code": "$rc:output_mode.domain.ALL_FEATURES"
                    },
                    {
                        "value": "INCIDENTS",
                        "code": "$rc:output_mode.domain.INCIDENTS"
                    }
                ]
            },
            "value": "ALL_FEATURES",
            "description": "$rc:output_mode.descr"
        },
        "data_store": {
            "type": "optional",
            "displayname": "$rc:data_store.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SPATIOTEMPORAL_DATA_STORE",
                        "code": "$rc:data_store.domain.SPATIOTEMPORAL_DATA_STORE"
                    },
                    {
                        "value": "RELATIONAL_DATA_STORE",
                        "code": "$rc:data_store.domain.RELATIONAL_DATA_STORE"
                    }
                ]
            },
            "value": "SPATIOTEMPORAL_DATA_STORE",
            "description": "$rc:data_store.descr"
        },
        "output": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "time_boundary_split": {
            "type": "optional",
            "displayname": "$rc:time_boundary_split.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_boundary_split.descr"
        },
        "time_boundary_reference": {
            "type": "optional",
            "displayname": "$rc:time_boundary_reference.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_boundary_reference.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
