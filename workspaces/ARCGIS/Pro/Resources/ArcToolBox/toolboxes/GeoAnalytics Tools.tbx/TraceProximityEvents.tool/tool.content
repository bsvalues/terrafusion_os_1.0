{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "51040002",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "spark"
    ],
    "params": {
        "in_points": {
            "display_order": "0",
            "displayname": "$rc:in_points.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "featuretype": [
                    "Simple"
                ],
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:in_points.descr"
        },
        "entity_id_field": {
            "display_order": "1",
            "displayname": "$rc:entity_id_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text"
                ]
            },
            "depends": [
                "in_points"
            ],
            "description": "$rc:entity_id_field.descr"
        },
        "output_name": {
            "display_order": "2",
            "displayname": "$rc:output_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:output_name.descr"
        },
        "distance_method": {
            "display_order": "3",
            "displayname": "$rc:distance_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PLANAR",
                        "code": "$rc:distance_method.domain.PLANAR"
                    },
                    {
                        "value": "GEODESIC",
                        "code": "$rc:distance_method.domain.GEODESIC"
                    }
                ]
            },
            "value": "PLANAR",
            "description": "$rc:distance_method.descr"
        },
        "spatial_search_distance": {
            "display_order": "4",
            "displayname": "$rc:spatial_search_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:spatial_search_distance.descr"
        },
        "temporal_search_distance": {
            "display_order": "5",
            "displayname": "$rc:temporal_search_distance.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:temporal_search_distance.descr"
        },
        "entities_of_interest_input_type": {
            "display_order": "6",
            "displayname": "$rc:entities_of_interest_input_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ID_START_TIME",
                        "code": "$rc:entities_of_interest_input_type.domain.ID_START_TIME"
                    },
                    {
                        "value": "SELECTED_FEATURE",
                        "code": "$rc:entities_of_interest_input_type.domain.SELECTED_FEATURE"
                    }
                ]
            },
            "value": "ID_START_TIME",
            "description": "$rc:entities_of_interest_input_type.descr"
        },
        "entities_interest_ids": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:entities_interest_ids.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:entities_interest_ids.dt.title1"
                    },
                    {
                        "type": "GPDate",
                        "displayname": "$rc:entities_interest_ids.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:entities_interest_ids.descr"
        },
        "entities_interest_layer": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:entities_interest_layer.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "domain": {
                "type": "GPTablesDomain",
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:entities_interest_layer.descr"
        },
        "include_tracks_layer": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:include_tracks_layer.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "TRACKS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_TRACKS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:include_tracks_layer.descr"
        },
        "max_trace_depth": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:max_trace_depth.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:max_trace_depth.descr"
        },
        "attribute_match_criteria": {
            "type": "optional",
            "display_order": "11",
            "displayname": "$rc:attribute_match_criteria.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text"
                ]
            },
            "depends": [
                "in_points"
            ],
            "description": "$rc:attribute_match_criteria.descr"
        },
        "data_store": {
            "type": "optional",
            "display_order": "12",
            "displayname": "$rc:data_store.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SPATIOTEMPORAL_DATA_STORE",
                        "code": "$rc:data_store.domain.SPATIOTEMPORAL_DATA_STORE"
                    },
                    {
                        "value": "RELATIONAL_DATA_STORE",
                        "code": "$rc:data_store.domain.RELATIONAL_DATA_STORE"
                    }
                ]
            },
            "value": "SPATIOTEMPORAL_DATA_STORE",
            "description": "$rc:data_store.descr"
        },
        "output": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "tracks_layer": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:tracks_layer.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
