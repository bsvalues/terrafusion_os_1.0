{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "51010005",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "spark"
    ],
    "params": {
        "prediction_type": {
            "displayname": "$rc:prediction_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TRAIN",
                        "code": "$rc:prediction_type.domain.TRAIN"
                    },
                    {
                        "value": "TRAIN_AND_PREDICT",
                        "code": "$rc:prediction_type.domain.TRAIN_AND_PREDICT"
                    }
                ]
            },
            "value": "TRAIN",
            "description": "$rc:prediction_type.descr"
        },
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "domain": {
                "type": "GPTablesDomain",
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "output_trained_name": {
            "displayname": "$rc:output_trained_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:output_trained_name.descr"
        },
        "variable_predict": {
            "displayname": "$rc:variable_predict.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:variable_predict.descr"
        },
        "treat_variable_as_categorical": {
            "type": "optional",
            "displayname": "$rc:treat_variable_as_categorical.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CATEGORICAL"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NUMERIC"
                    }
                ]
            },
            "description": "$rc:treat_variable_as_categorical.descr"
        },
        "explanatory_variables": {
            "type": "optional",
            "displayname": "$rc:explanatory_variables.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:explanatory_variables.dt.title1"
                    },
                    {
                        "type": "GPBoolean",
                        "displayname": "$rc:explanatory_variables.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double",
                            "Text"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "type": "GPBoolean",
                                "value": "true",
                                "code": "CATEGORICAL"
                            },
                            {
                                "type": "GPBoolean",
                                "value": "false",
                                "code": "NUMERIC"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:explanatory_variables.descr"
        },
        "create_variable_importance_table": {
            "type": "optional",
            "displayname": "$rc:create_variable_importance_table.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE_TABLE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_TABLE"
                    }
                ]
            },
            "description": "$rc:create_variable_importance_table.descr"
        },
        "features_to_predict": {
            "type": "optional",
            "displayname": "$rc:features_to_predict.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "domain": {
                "type": "GPTablesDomain",
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:features_to_predict.descr"
        },
        "explanatory_variable_matching": {
            "type": "optional",
            "displayname": "$rc:explanatory_variable_matching.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:explanatory_variable_matching.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:explanatory_variable_matching.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double",
                            "Text"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain"
                    }
                ]
            },
            "depends": [
                "features_to_predict"
            ],
            "description": "$rc:explanatory_variable_matching.descr"
        },
        "number_of_trees": {
            "type": "optional",
            "displayname": "$rc:number_of_trees.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPLong"
            },
            "value": "100",
            "description": "$rc:number_of_trees.descr"
        },
        "minimum_leaf_size": {
            "type": "optional",
            "displayname": "$rc:minimum_leaf_size.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:minimum_leaf_size.descr"
        },
        "maximum_tree_depth": {
            "type": "optional",
            "displayname": "$rc:maximum_tree_depth.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:maximum_tree_depth.descr"
        },
        "sample_size": {
            "type": "optional",
            "displayname": "$rc:sample_size.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1",
                "max": "100"
            },
            "value": "100",
            "description": "$rc:sample_size.descr"
        },
        "random_variables": {
            "type": "optional",
            "displayname": "$rc:random_variables.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:random_variables.descr"
        },
        "percentage_for_validation": {
            "type": "optional",
            "displayname": "$rc:percentage_for_validation.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "50"
            },
            "value": "10",
            "description": "$rc:percentage_for_validation.descr"
        },
        "data_store": {
            "type": "optional",
            "displayname": "$rc:data_store.title",
            "category": "$rc:params.category4",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "RELATIONAL_DATA_STORE",
                        "code": "$rc:data_store.domain.RELATIONAL_DATA_STORE"
                    },
                    {
                        "value": "SPATIOTEMPORAL_DATA_STORE",
                        "code": "$rc:data_store.domain.SPATIOTEMPORAL_DATA_STORE"
                    }
                ]
            },
            "value": "SPATIOTEMPORAL_DATA_STORE",
            "description": "$rc:data_store.descr"
        },
        "output_trained": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_trained.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "variable_of_importance": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:variable_of_importance.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "output_predicted": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_predicted.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
