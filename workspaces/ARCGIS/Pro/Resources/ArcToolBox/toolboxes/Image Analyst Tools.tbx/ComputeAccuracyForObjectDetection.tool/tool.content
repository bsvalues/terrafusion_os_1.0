    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "58",
        "86"
    ],
    "params": {
        "detected_features": {
            "display_order": "0",
            "displayname": "$rc:detected_features.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEFeatureClass"
                    },
                    {
                        "type": "GPFeatureLayer"
                    }
                ]
            },
            "description": "$rc:detected_features.descr"
        },
        "ground_truth_features": {
            "display_order": "1",
            "displayname": "$rc:ground_truth_features.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEFeatureClass"
                    },
                    {
                        "type": "GPFeatureLayer"
                    }
                ]
            },
            "description": "$rc:ground_truth_features.descr"
        },
        "out_accuracy_table": {
            "direction": "out",
            "display_order": "2",
            "displayname": "$rc:out_accuracy_table.title",
            "datatype": {
                "type": "DETable"
            },
            "description": "$rc:out_accuracy_table.descr"
        },
        "out_accuracy_report": {
            "type": "optional",
            "direction": "out",
            "display_order": "3",
            "displayname": "$rc:out_accuracy_report.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFileDomain",
                        "filetypes": [
                            "pdf",
                            "html"
                        ]
                    }
                ]
            },
            "description": "$rc:out_accuracy_report.descr"
        },
        "detected_class_value_field": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:detected_class_value_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Text"
                ]
            },
            "depends": [
                "detected_features"
            ],
            "description": "$rc:detected_class_value_field.descr"
        },
        "ground_truth_class_value_field": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:ground_truth_class_value_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Text"
                ]
            },
            "depends": [
                "ground_truth_features"
            ],
            "description": "$rc:ground_truth_class_value_field.descr"
        },
        "min_iou": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:min_iou.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0.5",
            "description": "$rc:min_iou.descr"
        },
        "mask_features": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:mask_features.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEFeatureClass"
                    },
                    {
                        "type": "GPFeatureLayer"
                    }
                ]
            },
            "description": "$rc:mask_features.descr"
        }
    },
    "environments": [
