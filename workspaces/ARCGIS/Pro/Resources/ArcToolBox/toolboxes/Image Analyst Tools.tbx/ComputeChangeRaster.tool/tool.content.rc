{
    "map": {
        "compute_change_method.descr": "<xdoc><p>Specifies the type of calculation that will be performed between the two rasters.</p><ul><li><span title=\"DIFFERENCE\">Difference</span>—The mathematical difference, or subtraction, between the pixel values in the rasters will be calculated. This is the default.</li><li><span title=\"RELATIVE_DIFFERENCE\">Relative difference</span>—The difference in pixel values, accounting for the quantities of the values being compared, will be calculated.</li><li><span title=\"CATEGORICAL_DIFFERENCE\">Categorical difference</span>—The difference between two categorical or thematic rasters will be calculated. The output will contain class transitions that occurred between the two rasters.</li><li><span title=\"SPECTRAL_EUCLIDEAN_DISTANCE\">Spectral Euclidean distance</span>—The Euclidean distance between the pixel values of two multiband rasters will be calculated.</li><li><span title=\"SPECTRAL_ANGLE_DIFFERENCE\">Spectral angle difference</span>—The spectral angle between the pixel values of two multiband rasters will be calculated. The output is in radians.</li><li><span title=\"BAND_WITH_MOST_CHANGE\">Band with most change</span>—The band that accounts for the most change in each pixel between two multiband rasters will be calculated.</li></ul></xdoc>",
        "compute_change_method.domain.BAND_WITH_MOST_CHANGE": "Band with most change",
        "compute_change_method.domain.CATEGORICAL_DIFFERENCE": "Categorical difference",
        "compute_change_method.domain.DIFFERENCE": "Difference",
        "compute_change_method.domain.RELATIVE_DIFFERENCE": "Relative difference",
        "compute_change_method.domain.SPECTRAL_ANGLE_DIFFERENCE": "Spectral angle difference",
        "compute_change_method.domain.SPECTRAL_EUCLIDEAN_DISTANCE": "Spectral Euclidean distance",
        "compute_change_method.title": "Compute Change Method",
        "define_transition_colors.descr": "<xdoc><p>Specifies the color that will be used to symbolize the output classes. When a pixel changes from one class type to another, the output pixel color represents the initial class type, the final class type, or a blend of the two.</p><p>This parameter is active when the <span class=\"esri_uicontrol\">Compute Change Method</span> parameter is set to <span class=\"esri_uicontrol\">Categorical difference</span>.</p></xdoc>",
        "define_transition_colors.domain.AVERAGE": "Average From and To colors",
        "define_transition_colors.domain.FROM_COLOR": "From color",
        "define_transition_colors.domain.TO_COLOR": "To color",
        "define_transition_colors.title": "Transition Class Colors",
        "description": "Calculates the absolute, relative, categorical, or spectral difference between two raster datasets.",
        "filter_method.descr": "<xdoc><p>Specifies the pixels that will be categorized in the output raster. This parameter is active when the <span class=\"esri_uicontrol\">Compute Change Method</span> parameter is set to <span class=\"esri_uicontrol\">Categorical difference</span>.</p><ul><li><span title=\"CHANGED_PIXELS_ONLY\">Changed pixels only</span>—Only the pixels that changed categories will be categorized in the output. Pixels that did not change categories will be grouped in a class called Other.</li><li><span title=\"UNCHANGED_PIXELS_ONLY\">Unchanged pixels only</span>—Only the pixels that did not change categories will be categorized in the output. Pixels that changed categories will be grouped in a class called Other.</li><li><span title=\"ALL\">All pixels</span>—All pixels will be categorized in the output. This is the default.</li></ul></xdoc>",
        "filter_method.domain.ALL": "All pixels",
        "filter_method.domain.CHANGED_PIXELS_ONLY": "Changed pixels only",
        "filter_method.domain.UNCHANGED_PIXELS_ONLY": "Unchanged pixels only",
        "filter_method.title": "Filter Method",
        "from_classes.descr": "<xdoc><p>The list of class names from the <span class=\"esri_uicontrol\">From Raster</span> parameter that will be included in the computation. If no classes are provided, all classes will be included.</p><p>This parameter is active when the <span class=\"esri_uicontrol\">Compute Change Method</span> parameter is set to <span class=\"esri_uicontrol\">Categorical difference</span>.</p></xdoc>",
        "from_classes.title": "From Classes",
        "from_classname_field.descr": "<xdoc><p>The field that will store class names in the <span class=\"esri_uicontrol\">From Raster</span> parameter value. The tool automatically searches for the <span class=\"esri_fieldname\">ClassName</span> field or <span class=\"esri_fieldname\">Class_Name</span> field to use.</p><p>Use this parameter if the input does not contain these standard field names.</p></xdoc>",
        "from_classname_field.title": "Classname Field for From Raster",
        "from_raster.descr": "The initial or earlier raster to be analyzed.",
        "from_raster.title": "From Raster",
        "out_raster_dataset.descr": "The output change raster dataset.",
        "out_raster_dataset.title": "Output Raster",
        "params.category1": "More Options",
        "title": "Compute Change Raster",
        "to_classes.descr": "<xdoc><p>The list of class names from the <span class=\"esri_uicontrol\">To Raster</span> parameter that will be included in the computation. If no classes are provided, all classes will be included.</p><p>This parameter is active when the <span class=\"esri_uicontrol\">Compute Change Method</span> parameter is set to <span class=\"esri_uicontrol\">Categorical difference</span>.</p></xdoc>",
        "to_classes.title": "To Classes",
        "to_classname_field.descr": "<xdoc><p>The field that will store class names in the <span class=\"esri_uicontrol\">To Raster</span> parameter value. The tool will automatically search for the <span class=\"esri_fieldname\">ClassName</span> field or <span class=\"esri_fieldname\">Class_Name</span> field to use.</p><p>Use this parameter if the input does not contain these standard field names.</p></xdoc>",
        "to_classname_field.title": "Classname Field for To Raster",
        "to_raster.descr": "The final or later raster to be analyzed. This is the raster that will be compared to the initial raster.",
        "to_raster.title": "To Raster"
    }
}
