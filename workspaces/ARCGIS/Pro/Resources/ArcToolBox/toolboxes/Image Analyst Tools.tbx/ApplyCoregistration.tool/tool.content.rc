{
    "map": {
        "description": "Resamples  the secondary single look complex (SLC) data to the reference SLC grid using a digital elevation model (DEM) and orbit state vector metadata.",
        "geoid.descr": "<xdoc><p>Specifies whether the vertical reference system of the input DEM will be transformed to ellipsoidal height. Most elevation datasets are referenced to sea level orthometric height, so a correction is required in these cases to convert to ellipsoidal height.<ul><li>Checked—A geoid correction will be made to convert orthometric height to ellipsoidal height (based on EGM96 geoid). This is the default.</li><li>Unchecked—No geoid correction will be made. Use this option only if the DEM is provided in ellipsoidal height.</li></ul></p></xdoc>",
        "geoid.title": "Apply geoid correction",
        "in_dem_raster.descr": "The DEM raster that will be used to estimate the local illuminated area. ",
        "in_dem_raster.title": "DEM Raster",
        "in_reference_radar_data.descr": "The input reference radar data.",
        "in_reference_radar_data.title": "Input Reference Radar Data",
        "in_secondary_radar_data.descr": "The input secondary radar data.",
        "in_secondary_radar_data.title": "Input Secondary Radar Data",
        "out_secondary_radar_data.descr": "The output secondary radar data coregistered to the reference radar data.",
        "out_secondary_radar_data.title": "Output Secondary Radar Data",
        "polarization_bands.descr": "<xdoc><p>The polarization bands that will be corrected.</p><p>The first band is selected by default.</p></xdoc>",
        "polarization_bands.title": "Polarization Bands",
        "summary": "<xdoc><p>Resamples the secondary single look complex (SLC) data to the reference SLC grid using a digital elevation model (DEM) and orbit state vector metadata.</p><p>For Terrain Observation by Progressive Scan (TOPS) mode radar data, the tool also deramps and demodulates the secondary SLC before resampling. Once resampling is performed, the secondary radar data is reramped and remodulated.</p></xdoc>",
        "title": "Apply Coregistration"
    }
}
