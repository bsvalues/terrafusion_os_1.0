{
    "map": {
        "description": "Creates changeover points along routes.",
        "distance_source_type.descr": "<xdoc><p>Specifies the source of the changeover distance value.</p><ul><li><span title=\"ROUTE\">Route</span>—The changeover distances are stored in the source line layer.</li><li><span title=\"POINT\">Point</span>—The changeover distances are stored in the target point layer.</li></ul></xdoc>",
        "distance_source_type.domain.POINT": "Point",
        "distance_source_type.domain.ROUTE": "Route",
        "distance_source_type.title": "Distance Source Type",
        "in_features.descr": "The input feature class of routes on which changeover points are based. It must contain polyline features.",
        "in_features.title": "Input ATS Route Features",
        "summary": "<xdoc><p>Creates changeover points along routes.</p><p>This tool creates changeover point features, deriving the point&apos;s location from a changeover distance provided on the input features. It also calculates secondary attributes on the target changeover point features that support symbology and labeling on a chart.</p></xdoc>",
        "target_changeover_features.descr": "The point feature class that contains the changeover points. After running the tool, new changeover points are added and existing changeover points are updated.",
        "target_changeover_features.title": "Target Changeover Point Features",
        "title": "Generate Changeover Points",
        "updated_features.title": "Updated Point Features"
    }
