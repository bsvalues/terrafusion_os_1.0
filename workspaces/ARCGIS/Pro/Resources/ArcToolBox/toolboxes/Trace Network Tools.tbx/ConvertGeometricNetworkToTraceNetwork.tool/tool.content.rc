{
    "map": {
        "description": "Converts a geometric network to a trace network.",
        "in_geometric_network.descr": "<xdoc><p>The geometric network that will be converted to a trace network.</p><note type=\"caution\"/><p group=\"note\">Converting a geometric network to a trace network will drop the geometric network and create a trace network in its place. This change cannot be undone. Create a backup of the data before proceeding.</p></xdoc>",
        "in_geometric_network.title": "Input Geometric Network",
        "out_trace_network.title": "Output Trace Network",
        "out_trace_network_name.descr": "The name of the output trace network.",
        "out_trace_network_name.title": "Output Trace Network Name",
        "title": "Convert Geometric Network To Trace Network"
    }
}
