{
    "map": {
        "analysis_input_features.descr": "The input features that were used in the analysis that produced the analysis result features.",
        "analysis_input_features.title": "Analysis Input Features",
        "confidence_bound_field.descr": "The fields containing the lower and upper bounds for the analysis variable. Values will be generated between the lower and upper confidence bounds.",
        "confidence_bound_field.dt.title1": "Analysis Variable",
        "confidence_bound_field.dt.title2": "Lower Bound Field",
        "confidence_bound_field.dt.title3": "Upper Bound Field",
        "confidence_bound_field.title": "Lower and Upper Bounds Field",
        "description": "Measures the stability of an analysis result by comparing the original analysis output to the results from multiple tool runs using simulated data. The simulated data accounts for uncertainty in one or more analysis variables. Three types of attribute uncertainty are supported: margin of error, confidence bounds, and a percentage of the original attribute value.",
        "in_features.descr": "A feature class containing the output analysis result from a spatial statistics tool. Only certain tools are supported. This is the analysis result that will be evaluated for stability.",
        "in_features.title": "Analysis Result Features",
        "moe_conf_level.descr": "The confidence level of the margins of error. For example, if the margins of error were created from 95 percent confidence intervals, provide a value of 95.",
        "moe_conf_level.title": "Margin of Error Confidence Level",
        "moe_field.descr": "The field containing the margin of error (MOE) of the analysis variable. The MOE is used to construct a symmetric distribution from which the simulated values will be generated.",
        "moe_field.dt.title1": "Analysis Variable",
        "moe_field.dt.title2": "Margin of Error Field",
        "moe_field.title": "Margin of Error Field",
        "num_simulations.descr": "The number of simulations that will be performed.",
        "num_simulations.title": "Number of Simulations",
        "out_features.descr": "The output features that will contain a copy of the original analysis results and fields summarizing the stability of the analysis for each feature.",
        "out_features.title": "Output Features",
        "out_group_layer.title": "Output Group Layer",
        "out_simulation_table.descr": "The output table that will contain fields summarizing the stability of the analysis.",
        "out_simulation_table.title": "Output Simulation Table",
        "out_workspace.title": "Workspace for Simulation Results",
        "output_workspace.descr": "An existing workspace where the analysis results from each simulation will be stored. The workspace can be a folder or a geodatabase.",
        "output_workspace.title": "Workspace for Simulation Results",
        "params.category1": "Advanced Options",
        "randomize_pct.descr": "The percentage of the original attribute value that will be subtracted and added to the original value of the analysis variable to create a range of values for the simulations.",
        "randomize_pct.dt.title1": "Analysis Variable",
        "randomize_pct.dt.title2": "Percentage Below",
        "randomize_pct.dt.title3": "Percentage Above",
        "randomize_pct.title": "Percentage Below and Above Values",
        "sim_data_limits.descr": "The lower and upper limits for the simulated values. All simulated values will be within these limits. For example, for counts or percentages, use a lower limit of zero to ensure that there are no negative counts or percentages.",
        "sim_data_limits.dt.title1": "Analysis Variable",
        "sim_data_limits.dt.title2": "Lower Limit",
        "sim_data_limits.dt.title3": "Upper Limit",
        "sim_data_limits.title": "Simulation Data Limits",
        "simulation_method.descr": "<xdoc><p>Specifies the probability distribution that will be used to simulate data.</p><ul><li><span title=\"NORMAL\">Normal</span>—A normal distribution will be used. This is the default.</li><li><span title=\"UNIFORM\">Uniform</span>—A uniform distribution will be used.</li><li><span title=\"TRIANGULAR\">Triangular</span>—A triangular distribution will be used.</li></ul></xdoc>",
        "simulation_method.domain.NORMAL": "Normal",
        "simulation_method.domain.TRIANGULAR": "Triangular",
        "simulation_method.domain.UNIFORM": "Uniform",
        "simulation_method.title": "Simulation Method",
        "title": "Assess Sensitivity to Attribute Uncertainty",
        "uncertainty_measure.descr": "<xdoc><p>Specifies how attribute uncertainty will be measured.</p><ul><li><span title=\"MOE\">Margin of error</span>—The input feature class of the original analysis contains a field, with the symmetrical margin of error for each feature, that will be used.</li><li><span title=\"CONFIDENCE_BOUNDS\">Upper and lower bounds</span>—The input feature class of the original analysis contains a field, with the lower bound and upper bound for each feature, that will be used. The bounds may be asymmetric with respect to a feature&apos;s analysis variable value.</li><li><span title=\"PERCENTAGE\">Percent above and below</span>—The analysis variable will be adjusted by the percentage specified by the <span class=\"esri_uicontrol\">Percentage Below and Above Values</span> parameter.</li></ul></xdoc>",
        "uncertainty_measure.domain.CONFIDENCE_BOUNDS": "Upper and lower bounds",
        "uncertainty_measure.domain.MOE": "Margin of error",
        "uncertainty_measure.domain.PERCENTAGE": "Percent above and below",
        "uncertainty_measure.title": "Uncertainty Type"
    }
