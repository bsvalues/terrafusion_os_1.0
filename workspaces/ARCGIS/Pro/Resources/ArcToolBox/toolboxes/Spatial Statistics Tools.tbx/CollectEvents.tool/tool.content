{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\CollectEvents",
    "displayname": "$rc:title",
    "helpcontent": "9050001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Incident_Features": {
            "displayname": "$rc:input_incident_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_incident_features.descr"
        },
        "Output_Weighted_Point_Feature_Class": {
            "direction": "out",
            "displayname": "$rc:output_weighted_point_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_weighted_point_feature_class.descr"
        },
        "Results_Field": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:results_field.title",
            "datatype": {
                "type": "Field"
            },
            "value": "Count"
        },
        "Z_Max_Value": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:z_max_value.title",
            "datatype": {
                "type": "GPDouble"
            }
        }
    },
    "environments": [
        "MResolution",
        "MTolerance",
        "XYResolution",
        "XYTolerance",
        "ZResolution",
        "ZTolerance",
        "geographicTransformations",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "scratchWorkspace",
        "workspace"
    ]
}
