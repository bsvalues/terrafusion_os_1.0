{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\MultiDistanceSpatialClustering",
    "displayname": "$rc:title",
    "helpcontent": "9010003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Feature_Class": {
            "displayname": "$rc:input_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_feature_class.descr"
        },
        "Output_Table": {
            "direction": "out",
            "displayname": "$rc:output_table.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_table.descr"
        },
        "Number_of_Distance_Bands": {
            "displayname": "$rc:number_of_distance_bands.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1",
                "max": "100"
            },
            "value": "10",
            "description": "$rc:number_of_distance_bands.descr"
        },
        "Compute_Confidence_Envelope": {
            "type": "optional",
            "displayname": "$rc:compute_confidence_envelope.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "0_PERMUTATIONS_-_NO_CONFIDENCE_ENVELOPE",
                        "code": "$rc:compute_confidence_envelope.domain.0_PERMUTATIONS_-_NO_CONFIDENCE_ENVELOPE"
                    },
                    {
                        "value": "9_PERMUTATIONS",
                        "code": "$rc:compute_confidence_envelope.domain.9_PERMUTATIONS"
                    },
                    {
                        "value": "99_PERMUTATIONS",
                        "code": "$rc:compute_confidence_envelope.domain.99_PERMUTATIONS"
                    },
                    {
                        "value": "999_PERMUTATIONS",
                        "code": "$rc:compute_confidence_envelope.domain.999_PERMUTATIONS"
                    }
                ]
            },
            "value": "0_PERMUTATIONS_-_NO_CONFIDENCE_ENVELOPE",
            "description": "$rc:compute_confidence_envelope.descr"
        },
        "Display_Results_Graphically": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:display_results_graphically.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DISPLAY_IT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_DISPLAY"
                    }
                ]
            },
            "description": "$rc:display_results_graphically.descr"
        },
        "Weight_Field": {
            "type": "optional",
            "displayname": "$rc:weight_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "Input_Feature_Class"
            ],
            "description": "$rc:weight_field.descr"
        },
        "Beginning_Distance": {
            "type": "optional",
            "displayname": "$rc:beginning_distance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "9999999"
            },
            "description": "$rc:beginning_distance.descr"
        },
        "Distance_Increment": {
            "type": "optional",
            "displayname": "$rc:distance_increment.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "9999999"
            },
            "description": "$rc:distance_increment.descr"
        },
        "Boundary_Correction_Method": {
            "type": "optional",
            "displayname": "$rc:boundary_correction_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NONE",
                        "code": "$rc:boundary_correction_method.domain.NONE"
                    },
                    {
                        "value": "SIMULATE_OUTER_BOUNDARY_VALUES",
                        "code": "$rc:boundary_correction_method.domain.SIMULATE_OUTER_BOUNDARY_VALUES"
                    },
                    {
                        "value": "REDUCE_ANALYSIS_AREA",
                        "code": "$rc:boundary_correction_method.domain.REDUCE_ANALYSIS_AREA"
                    },
                    {
                        "value": "RIPLEY_EDGE_CORRECTION_FORMULA",
                        "code": "$rc:boundary_correction_method.domain.RIPLEY_EDGE_CORRECTION_FORMULA"
                    }
                ]
            },
            "value": "NONE",
            "description": "$rc:boundary_correction_method.descr"
        },
        "Study_Area_Method": {
            "type": "optional",
            "displayname": "$rc:study_area_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "MINIMUM_ENCLOSING_RECTANGLE",
                        "code": "$rc:study_area_method.domain.MINIMUM_ENCLOSING_RECTANGLE"
                    },
                    {
                        "value": "USER_PROVIDED_STUDY_AREA_FEATURE_CLASS",
                        "code": "$rc:study_area_method.domain.USER_PROVIDED_STUDY_AREA_FEATURE_CLASS"
                    }
                ]
            },
            "value": "MINIMUM_ENCLOSING_RECTANGLE",
            "description": "$rc:study_area_method.descr"
        },
        "Study_Area_Feature_Class": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:study_area_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:study_area_feature_class.descr"
        },
        "Result_Image": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:result_image.title",
            "datatype": {
                "type": "GPGraph"
            }
        }
    },
    "environments": [
        "geographicTransformations",
        "outputCoordinateSystem",
        "randomGenerator",
        "scratchWorkspace",
        "workspace"
    ]
}
