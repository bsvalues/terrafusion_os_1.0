{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\MultivariateClustering",
    "displayname": "$rc:title",
    "helpcontent": "9030009",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "output_features": {
            "direction": "out",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "featuretype.rule": "AsSpecified",
                "featuretype": "Simple",
                "geometrytype.rule": "AsSpecified",
                "geometrytype": "Null",
                "fields.rule": "None",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "analysis_fields": {
            "control_guid": "{C15EC6FA-35EF-4204-90FB-01E7B4DD6862}",
            "displayname": "$rc:analysis_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:analysis_fields.descr"
        },
        "clustering_method": {
            "type": "optional",
            "displayname": "$rc:clustering_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "K_MEANS",
                        "code": "$rc:clustering_method.domain.K_MEANS"
                    },
                    {
                        "value": "K_MEDOIDS",
                        "code": "$rc:clustering_method.domain.K_MEDOIDS"
                    }
                ]
            },
            "value": "K_MEANS",
            "description": "$rc:clustering_method.descr"
        },
        "initialization_method": {
            "type": "optional",
            "displayname": "$rc:initialization_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "OPTIMIZED_SEED_LOCATIONS",
                        "code": "$rc:initialization_method.domain.OPTIMIZED_SEED_LOCATIONS"
                    },
                    {
                        "value": "USER_DEFINED_SEED_LOCATIONS",
                        "code": "$rc:initialization_method.domain.USER_DEFINED_SEED_LOCATIONS"
                    },
                    {
                        "value": "RANDOM_SEED_LOCATIONS",
                        "code": "$rc:initialization_method.domain.RANDOM_SEED_LOCATIONS"
                    }
                ]
            },
            "value": "OPTIMIZED_SEED_LOCATIONS",
            "description": "$rc:initialization_method.descr"
        },
        "initialization_field": {
            "type": "optional",
            "displayname": "$rc:initialization_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:initialization_field.descr"
        },
        "number_of_clusters": {
            "type": "optional",
            "displayname": "$rc:number_of_clusters.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:number_of_clusters.descr"
        },
        "output_table": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:output_table.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_table.descr"
        }
    },
    "environments": [
        "MResolution",
        "MTolerance",
        "XYResolution",
        "XYTolerance",
        "ZResolution",
        "ZTolerance",
        "geographicTransformations",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "qualifiedFieldNames",
        "randomGenerator",
        "scratchWorkspace",
        "workspace"
    ]
}
