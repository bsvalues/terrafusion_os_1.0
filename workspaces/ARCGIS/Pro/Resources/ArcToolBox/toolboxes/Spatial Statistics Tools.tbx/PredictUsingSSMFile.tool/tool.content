{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\PredictUsingSSMFile",
    "displayname": "$rc:title",
    "helpcontent": "9060016",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "input_model": {
            "display_order": "0",
            "displayname": "$rc:input_model.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "ssm"
                ]
            },
            "description": "$rc:input_model.descr"
        },
        "prediction_type": {
            "display_order": "1",
            "displayname": "$rc:prediction_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PREDICT_FEATURES",
                        "code": "$rc:prediction_type.domain.PREDICT_FEATURES"
                    },
                    {
                        "value": "PREDICT_RASTER",
                        "code": "$rc:prediction_type.domain.PREDICT_RASTER"
                    }
                ]
            },
            "description": "$rc:prediction_type.descr"
        },
        "features_to_predict": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:features_to_predict.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:features_to_predict.descr"
        },
        "output_features": {
            "type": "optional",
            "direction": "out",
            "display_order": "3",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "features_to_predict"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "output_raster": {
            "type": "optional",
            "direction": "out",
            "display_order": "4",
            "displayname": "$rc:output_raster.title",
            "datatype": {
                "type": "DERasterDataset"
            },
            "schema": {
                "type": "GPRasterSchema",
                "extenttype.rule": "Environment",
                "cellsize.rule": "Environment",
                "raster.rule": "FirstDependency",
                "rasterformat.rule": "IMG",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_raster.descr"
        },
        "explanatory_variable_matching": {
            "type": "optional",
            "display_order": "5",
            "control_guid": "{1AA9A769-D3F3-4EB0-85CB-CC07C79313C8}",
            "displayname": "$rc:explanatory_variable_matching.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:explanatory_variable_matching.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:explanatory_variable_matching.dt.title2"
                    },
                    {
                        "type": "GPBoolean",
                        "displayname": "$rc:explanatory_variable_matching.dt.title3",
                        "readonly": "true"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Double",
                            "Float",
                            "Short",
                            "Long",
                            "Text",
                            "BigInteger"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain"
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "type": "GPBoolean",
                                "value": "true",
                                "code": "CATEGORICAL"
                            },
                            {
                                "type": "GPBoolean",
                                "value": "false",
                                "code": "NUMERIC"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "features_to_predict"
            ],
            "description": "$rc:explanatory_variable_matching.descr"
        },
        "explanatory_distance_matching": {
            "type": "optional",
            "display_order": "6",
            "control_guid": "{C99D0042-EF42-4B04-8A0B-1A53F6DB67A6}",
            "displayname": "$rc:explanatory_distance_matching.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPFeatureLayer",
                        "displayname": "$rc:explanatory_distance_matching.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:explanatory_distance_matching.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFeatureClassDomain",
                        "geometrytype": [
                            "Polygon",
                            "Point",
                            "Polyline"
                        ],
                        "featuretype": [
                            "Simple"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain"
                    }
                ]
            },
            "description": "$rc:explanatory_distance_matching.descr"
        },
        "explanatory_rasters_matching": {
            "type": "optional",
            "display_order": "7",
            "control_guid": "{1AA9A769-D3F3-4EB0-85CB-CC07C79313C8}",
            "displayname": "$rc:explanatory_rasters_matching.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPRasterLayer",
                        "displayname": "$rc:explanatory_rasters_matching.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:explanatory_rasters_matching.dt.title2"
                    },
                    {
                        "type": "GPBoolean",
                        "displayname": "$rc:explanatory_rasters_matching.dt.title3",
                        "readonly": "true"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "GPCodedValueDomain"
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "type": "GPBoolean",
                                "value": "true",
                                "code": "CATEGORICAL"
                            },
                            {
                                "type": "GPBoolean",
                                "value": "false",
                                "code": "NUMERIC"
                            }
                        ]
                    }
                ]
            },
            "description": "$rc:explanatory_rasters_matching.descr"
        }
    },
    "environments": [
        "cellSize",
        "cellSizeProjectionMethod",
        "extent",
        "mask",
        "outputCoordinateSystem",
        "parallelProcessingFactor",
        "randomGenerator",
        "snapRaster"
    ]
}
