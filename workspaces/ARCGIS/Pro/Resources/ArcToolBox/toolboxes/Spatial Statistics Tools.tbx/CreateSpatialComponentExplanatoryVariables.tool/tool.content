{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\CreateSpatialComponentExplanatoryVariables",
    "displayname": "$rc:title",
    "helpcontent": "9060020",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "input_fields": {
            "displayname": "$rc:input_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:input_fields.descr"
        },
        "out_features": {
            "direction": "out",
            "displayname": "$rc:out_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_features.descr"
        },
        "append_all_fields": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:append_all_fields.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ALL"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_FIELDS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:append_all_fields.descr"
        },
        "in_swm": {
            "type": "optional",
            "displayname": "$rc:in_swm.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "swm",
                    "gwt",
                    "txt"
                ]
            },
            "description": "$rc:in_swm.descr"
        },
        "out_swm": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_swm.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "swm"
                ]
            },
            "description": "$rc:out_swm.descr"
        },
        "id_field": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:id_field.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:id_field.descr"
        }
    },
    "environments": [
        "geographicTransformations",
        "outputCoordinateSystem",
        "parallelProcessingFactor",
        "randomGenerator"
    ]
}
