{
    "type": "FunctionTool",
    "guid": "{ad7ab13f-93f0-4ec6-9fff-90b4f5b4b3a5}",
    "displayname": "$rc:title",
    "helpcontent": "13030002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "out_location": {
            "displayname": "$rc:out_location.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEFeatureDataset"
                    }
                ]
            },
            "description": "$rc:out_location.descr"
        },
        "out_feature_class_name": {
            "displayname": "$rc:out_feature_class_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_feature_class_name.descr"
        },
        "maximum_edges": {
            "type": "optional",
            "displayname": "$rc:maximum_edges.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "5",
            "description": "$rc:maximum_edges.descr"
        },
        "in_network_dataset": {
            "type": "optional",
            "displayname": "$rc:in_network_dataset.title",
            "datatype": {
                "type": "GPNetworkDatasetLayer"
            },
            "description": "$rc:in_network_dataset.descr"
        },
        "in_template_feature_class": {
            "type": "optional",
            "displayname": "$rc:in_template_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "description": "$rc:in_template_feature_class.descr"
        },
        "spatial_reference": {
            "type": "optional",
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "depends": [
                "out_location"
            ],
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:spatial_reference.descr"
        },
        "config_keyword": {
            "type": "optional",
            "displayname": "$rc:config_keyword.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "defaultenvironmentname": "configKeyword",
            "category": "$rc:params.category1",
            "description": "$rc:config_keyword.descr"
        },
        "spatial_grid_1": {
            "type": "optional",
            "displayname": "$rc:spatial_grid_1.title",
            "datatype": {
                "type": "GPDouble"
            },
            "defaultenvironmentname": "spatialGrid1",
            "value": "1000",
            "category": "$rc:params.category1",
            "description": "$rc:spatial_grid_1.descr"
        },
        "spatial_grid_2": {
            "type": "optional",
            "displayname": "$rc:spatial_grid_2.title",
            "datatype": {
                "type": "GPDouble"
            },
            "defaultenvironmentname": "spatialGrid2",
            "value": "0",
            "category": "$rc:params.category1",
            "description": "$rc:spatial_grid_2.descr"
        },
        "spatial_grid_3": {
            "type": "optional",
            "displayname": "$rc:spatial_grid_3.title",
            "datatype": {
                "type": "GPDouble"
            },
            "defaultenvironmentname": "spatialGrid3",
            "value": "0",
            "category": "$rc:params.category1",
            "description": "$rc:spatial_grid_3.descr"
        },
        "has_z": {
            "type": "optional",
            "displayname": "$rc:has_z.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ENABLED"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DISABLED"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:has_z.descr"
        },
        "out_turn_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_turn_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            }
        }
    },
    "environments": [
        "configKeyword",
        "outputCoordinateSystem",
        "workspace"
    ]
}
