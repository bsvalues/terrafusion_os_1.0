{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "13010025",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "param_nocount:in_vrp_layer"
    ],
    "params": {
        "in_vrp_layer": {
            "displayname": "$rc:in_vrp_layer.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPNALayer"
                    }
                ]
            },
            "description": "$rc:in_vrp_layer.descr"
        },
        "target_route": {
            "type": "optional",
            "displayname": "$rc:target_route.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:target_route.descr"
        },
        "break_type": {
            "type": "optional",
            "displayname": "$rc:break_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TIME_WINDOW_BREAK",
                        "code": "$rc:break_type.domain.TIME_WINDOW_BREAK"
                    },
                    {
                        "value": "MAXIMUM_TRAVEL_TIME_BREAK",
                        "code": "$rc:break_type.domain.MAXIMUM_TRAVEL_TIME_BREAK"
                    },
                    {
                        "value": "MAXIMUM_WORK_TIME_BREAK",
                        "code": "$rc:break_type.domain.MAXIMUM_WORK_TIME_BREAK"
                    }
                ]
            },
            "value": "TIME_WINDOW_BREAK",
            "description": "$rc:break_type.descr"
        },
        "time_window_properties": {
            "type": "optional",
            "displayname": "$rc:time_window_properties.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPBoolean",
                        "displayname": "$rc:time_window_properties.dt.title1"
                    },
                    {
                        "type": "GPDouble",
                        "displayname": "$rc:time_window_properties.dt.title2"
                    },
                    {
                        "type": "GPDate",
                        "displayname": "$rc:time_window_properties.dt.title3"
                    },
                    {
                        "type": "GPDate",
                        "displayname": "$rc:time_window_properties.dt.title4"
                    },
                    {
                        "type": "GPDouble",
                        "displayname": "$rc:time_window_properties.dt.title5"
                    }
                ]
            },
            "description": "$rc:time_window_properties.descr"
        },
        "travel_time_properties": {
            "type": "optional",
            "displayname": "$rc:travel_time_properties.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPBoolean",
                        "displayname": "$rc:travel_time_properties.dt.title1"
                    },
                    {
                        "type": "GPDouble",
                        "displayname": "$rc:travel_time_properties.dt.title2"
                    },
                    {
                        "type": "GPDouble",
                        "displayname": "$rc:travel_time_properties.dt.title3"
                    }
                ]
            },
            "description": "$rc:travel_time_properties.descr"
        },
        "work_time_properties": {
            "type": "optional",
            "displayname": "$rc:work_time_properties.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPBoolean",
                        "displayname": "$rc:work_time_properties.dt.title1"
                    },
                    {
                        "type": "GPDouble",
                        "displayname": "$rc:work_time_properties.dt.title2"
                    },
                    {
                        "type": "GPDouble",
                        "displayname": "$rc:work_time_properties.dt.title3"
                    }
                ]
            },
            "description": "$rc:work_time_properties.descr"
        },
        "append_to_existing_breaks": {
            "type": "optional",
            "displayname": "$rc:append_to_existing_breaks.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "APPEND"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "CLEAR"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:append_to_existing_breaks.descr"
        },
        "out_vrp_layer": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_vrp_layer.title",
            "datatype": {
                "type": "GPNALayer"
            }
        }
    }
}
