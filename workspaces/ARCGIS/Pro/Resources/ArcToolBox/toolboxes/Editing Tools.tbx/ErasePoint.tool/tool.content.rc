        "out_feature_class.title": "Updated Input Features",
        "remove_features.descr": "<xdoc><p>The polygon features that will be used to determine which features from the <span class=\"esri_uicontrol\">Input Features</span> value will be deleted.</p></xdoc>",
        "remove_features.title": "Remove Features",
        "title": "Erase Point"
