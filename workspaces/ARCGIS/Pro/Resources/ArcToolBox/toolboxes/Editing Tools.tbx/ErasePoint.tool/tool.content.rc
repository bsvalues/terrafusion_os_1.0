    "map": {
        "description": "Deletes points from the input that are either inside or outside the remove features, depending on the operation type.",
        "in_features.descr": "The input point features.",
        "in_features.title": "Input Features",
        "operation_type.descr": "<xdoc><p>Specifies whether points inside or outside the remove features will be deleted.</p><ul><li><span title=\"INSIDE\">Inside</span>—Input point features inside or on the boundary of the remove features will be deleted.</li><li><span title=\"OUTSIDE\">Outside</span>—Input point features outside the remove features will be deleted.</li></ul></xdoc>",
