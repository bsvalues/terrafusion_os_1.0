{
    "map": {
        "description": "Splits features based on matching relationships to obtain better corresponding line segmentation.",
        "in_features.descr": "The input line features that will be split. They must be prematched with the matched features.",
        "in_features.title": "Input Features",
        "in_features_as.descr": "<xdoc><p>Specifies whether the input features in the match table are source features or target features, so the correct features will be split.</p><ul><li><span title=\"AS_SOURCE\">As source features</span>—The input features are stored as the source features in the match table. This is the default.</li><li><span title=\"AS_TARGET\">As target features</span>—The input features are stored as the target features in the match table.</li></ul></xdoc>",
        "in_features_as.domain.AS_SOURCE": "As source features",
        "in_features_as.domain.AS_TARGET": "As target features",
        "in_features_as.title": "Input Features In Match",
        "in_match_table.descr": "A table that includes matching information between input and matched features.",
        "in_match_table.title": "Input Match Table",
        "matched_features.descr": "The features that were prematched with the input features. Matched features are used as reference when splitting the input features.",
        "matched_features.title": "Matched Features",
        "min_match_group_length.descr": "The minimum length a match group can be. A given match group will only participate in the splitting process if either the total length of the input features or the total length of the matched features are greater than the value provided.",
        "min_match_group_length.title": "Minimum Match Group Length",
        "min_split_length.descr": "The minimum length a split piece can be. If a split will result in one or both of the split pieces being shorter than the value provided, the split will not occur.",
        "min_split_length.title": "Minimum Split Length",
        "out_feature_class.descr": "The output feature class containing split lines and original lines that are not split.",
        "out_feature_class.title": "Output Feature Class",
        "out_point_feature_class.descr": "The output point feature class containing points that represent split locations.",
        "out_point_feature_class.title": "Output Split Points",
        "search_distance.descr": "The distance value that will be used to determine split locations. The value must be greater than 0. If units are not specified, the units of the input will be used.",
        "search_distance.title": "Search Distance",
        "split_dangle.descr": "<xdoc><p>Specifies whether dangling lines will be split.</p><ul><li>Checked—Dangling lines will be split following the tool&apos;s split rules. This is the default.</li><li>Unchecked—Dangling lines will not be split.</li></ul></xdoc>",
        "split_dangle.title": "Split dangle features",
        "split_fields.descr": "A list of numeric fields from the input features. Their field values will be based on the proportions of the split lines.",
        "split_fields.title": "Split Field(s)",
        "summary": "<xdoc><p>Splits features based on matching relationships to obtain better corresponding line segmentation.</p><p>When working with line features in two different datasets—for example, city roads and state roads—having features in a one-to-one (1:1) matching relationship rather than a many-to-many (m:n) matching relationship will aid conflation tasks, such as attribute transfer from one source to another. This tool helps turn m:n matches into more 1:1 matches.</p><p>The input features and the matched features must be prematched by one of the feature matching based conflation tools, such as Detect Feature Changes, with a match table produced. The matching relationships recorded in the match table are between source and target features.</p><p>For each match group, the tool splits the input features based on the node conditions in the matched features. A node can be a dangle end of a line, a pseudo node between two lines, or a junction of multiple lines. For example, a 1:2 matched group means one source feature matched two target features, and the two target features are joined at a pseudo node. The tool will split the input line at a location near the target pseudo node. This is to improve the correspondences between the source and target lines so the next round of feature matching will produce more 1:1 matches for conflation needs.</p></xdoc>",
        "title": "Split Line By Match"
    }
}
