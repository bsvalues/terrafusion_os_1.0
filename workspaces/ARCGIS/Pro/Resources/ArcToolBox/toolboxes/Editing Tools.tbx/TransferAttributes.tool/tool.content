                    "GUID"
                ],
                "exclude.field": [
                    "SHAPE_Length",
                    "SHAPE_Area"
                ]
            },
            "depends": [
                "source_features"
            ],
            "description": "$rc:transfer_fields.descr"
        },
        "search_distance": {
            "displayname": "$rc:search_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "source_features"
            ],
            "description": "$rc:search_distance.descr"
        },
        "match_fields": {
            "type": "optional",
            "control_guid": "{C99D0042-EF42-4B04-8A0B-1A53F6DB67A6}",
            "displayname": "$rc:match_fields.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPString",
                        "displayname": "$rc:match_fields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:match_fields.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text",
                    "Date",
                    "Blob",
                    "Raster",
                    "XML",
                    "GUID",
                    "OID"
                ],
                "exclude.field": [
                    "SHAPE_Length",
                    "SHAPE_Area"
                ]
