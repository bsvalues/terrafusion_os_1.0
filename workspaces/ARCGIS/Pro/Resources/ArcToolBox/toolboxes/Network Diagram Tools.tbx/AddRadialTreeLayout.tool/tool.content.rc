{
    "map": {
        "are_containers_preserved.descr": "<xdoc><p>Specifies how the algorithm will process containers.<ul><li>Checked—The layout algorithm will apply to the top graph of the diagram so containers are preserved.</li><li>Unchecked—The layout algorithm will apply to both content and noncontent features in the diagram. This is the default.</li></ul></p></xdoc>",
        "are_containers_preserved.title": "Preserve container layout",
        "description": "Adds the Radial Tree Layout algorithm to the list of layouts to be automatically chained at the end of the building of diagrams based on a given template. This tool also presets the Radial Tree Layout algorithm parameters for any diagram based on that template.",
        "disjoined_graph_absolute.descr": "The minimum spacing that will separate features belonging to disjoined graphs when the diagram contains such graphs. This parameter is used with absolute units. The default is 10 in the units of the diagram's coordinate system.",
        "disjoined_graph_absolute.title": "Between Disjoined Graphs",
        "disjoined_graph_proportional.descr": "The minimum spacing that will separate features belonging to disjoined graphs when the diagram contains such graphs. This parameter is used with proportional units. The default is 10.",
        "disjoined_graph_proportional.title": "Between Disjoined Graphs",
        "in_utility_network.descr": "The utility network or trace network containing the diagram template that will be modified.",
        "in_utility_network.title": "Input Network",
        "initial_radius_absolute.descr": "The radius of the first concentric circle whose center is the radial tree root junction—that is, the radius of the circle around which the diagram junctions belonging to the first hierarchical level are placed. The default is 5 in the units of the diagram's coordinate system. This parameter can only be used with absolute units.",
        "initial_radius_absolute.title": "Initial Radius",
        "initial_radius_proportional.descr": "The radius of the first concentric circle whose center is the radial tree root junction—that is, the radius of the circle around which the diagram junctions belonging to the first hierarchical level are placed. The default is 5. This parameter can only be used with proportional units.",
        "initial_radius_proportional.title": "Initial Radius",
        "is_active.descr": "<xdoc><p>Specifies whether the layout algorithm will automatically run when generating diagrams based on the specified template.<ul><li>Checked—The added layout algorithm will automatically run during the generation of any diagram that is based on the <span class=\"esri_uicontrol\">Input Diagram Template</span> parameter value. This is the default.<p>The parameter values specified for the layout algorithm are used to run the layout during diagram generation. They are also loaded by default when the algorithm is to be run on any diagram based on the input template.</p></li><li>Unchecked—All the parameter values currently specified for the added layout algorithm will be loaded by default when the algorithm is to be run on any diagram based on the input template.</li></ul></p></xdoc>",
        "is_active.title": "Active",
        "is_unit_absolute.descr": "<xdoc><p>Specifies how parameters representing distances will be interpreted.<ul><li>Checked—The layout algorithm will interpret distance values as linear units.</li><li>Unchecked—The layout algorithm will interpret distance values as relative units to an estimation of the average of the junction sizes in the current diagram extent. This is the default.</li></ul></p></xdoc>",
        "is_unit_absolute.title": "Spacing values interpreted as absolute units in the diagram coordinate system",
        "out_template_name.title": "Output Diagram Template",
        "out_utility_network.title": "Output Network",
        "radius_factor.descr": "The multiplicative factor that will be used to increase or decrease the radius of each concentric circle. It is also the distance that separates each concentric circle related to a hierarchical level. When using a radius factor less than 1, the distance that separates the diagram junctions belonging to the (n) hierarchical level and the (n+1) hierarchical level progressively decreases. With a factor greater than 1, the distance between the hierarchical levels increases progressively. The default is 1.",
        "radius_factor.title": "Radius Factor",
        "summary": "<xdoc><p>Adds the Radial Tree Layout algorithm to the list of layouts to be automatically chained at the end of the building of diagrams based on a given template. This tool also presets the Radial Tree Layout algorithm parameters for any diagram based on that template.</p><p>This layout algorithm arranges the diagram features hierarchically and places them in a radial tree according to the specified radius parameters. It works from a root junction that it uses as the circle center to arrange the subtrees starting from this root in concentric circles, each circle corresponding to one hierarchical level.</p><note type=\"caution\"/><p group=\"note\">This tool is a configuration and administration tool.</p><note type=\"note\"/><p group=\"note\">This tool impacts the consistency of any existing diagrams based on the input diagram template. All of the existing diagrams become inconsistent and open with a consistency warning icon until they are updated.</p></xdoc>",
        "template_name.descr": "The name of the diagram template that will be modified.",
        "template_name.title": "Input Diagram Template",
        "title": "Add Radial Tree Layout"
    }
}
