{
    "map": {
        "collada_version.descr": "<xdoc><p>Specifies the COLLADA version to which the files will be exported.</p><ul><li><span title=\"1.5\">1.5</span>—Files will be exported to COLLADA version 1.5. Version 1.5 supports the inclusion of georeferencing information and enhanced rendering capabilities. This is the default.</li><li><span title=\"1.4\">1.4</span>—Files will be exported to COLLADA version 1.4. Version 1.4 is the widely supported standard used in many design related application platforms. Select this version if the COLLADA file will be used on systems that do not support version 1.5.</li></ul></xdoc>",
        "collada_version.domain.1.4": "1.4",
        "collada_version.domain.1.5": "1.5",
        "collada_version.title": "COLLADA Version",
        "description": "Converts one or more multipatch features into a collection of COLLADA files (.dae) and referenced texture image files in an output folder.",
        "field_name.descr": "The feature attribute that will be used as the output COLLADA file name for each exported feature. If no field is specified, the feature's Object ID will be used.",
        "field_name.title": "Use Field Name",
        "in_features.descr": "The multipatch features to be exported.",
        "in_features.title": "Input Multipatch Features",
        "output_folder.descr": "The destination folder where the output COLLADA files and texture image files will be placed.",
        "output_folder.title": "Output COLLADA Folder",
        "prepend_source.descr": "<xdoc><p>Specifies whether the names of the output COLLADA files will be prepended with the name of the source feature layer.<ul><li>Checked—The file names will be prepended with the name of the source feature layer.</li><li>Unchecked—The file names will not be prepended with the name of the source feature layer. This is the default.</li></ul></p></xdoc>",
        "prepend_source.title": "Prepend Source Name",
        "title": "Multipatch To COLLADA"
    }
}
