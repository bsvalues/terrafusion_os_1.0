{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "2110002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Table": {
            "displayname": "$rc:input_table.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPTableView"
                }
            },
            "description": "$rc:input_table.descr"
        },
        "Output_Excel_File": {
            "direction": "out",
            "displayname": "$rc:output_excel_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xls",
                    "xlsx"
                ]
            },
            "depends": [
                "Input_Table"
            ],
            "description": "$rc:output_excel_file.descr"
        },
        "Use_field_alias_as_column_header": {
            "type": "optional",
            "displayname": "$rc:use_field_alias_as_column_header.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ALIAS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NAME"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:use_field_alias_as_column_header.descr"
        },
        "Use_domain_and_subtype_description": {
            "type": "optional",
            "displayname": "$rc:use_domain_and_subtype_description.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DESCRIPTION"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "CODE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:use_domain_and_subtype_description.descr"
        }
    },
    "environments": [
        "scratchWorkspace",
        "transferDomains",
        "transferGDBAttributeProperties",
        "workspace"
    ]
}
