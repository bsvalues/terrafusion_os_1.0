{
    "map": {
        "build_rat.descr": "<xdoc><p>Specifies whether the output raster will have a raster attribute table.</p><p>This parameter only applies to integer rasters.</p><ul><li>Checked—The output raster will have a raster attribute table. This is the default.</li><li>Unchecked—The output raster will not have a raster attribute table.</li></ul></xdoc>",
        "build_rat.title": "Build raster attribute table",
        "cell_assignment.descr": "<xdoc><p>The method to determine how the cell will be assigned a value when more than one feature falls within a cell.</p><ul><li><span title=\"MAXIMUM_LENGTH\">Maximum length</span>—The feature with the longest length that covers the cell will determine the value to assign to the cell.</li><li><span title=\"MAXIMUM_COMBINED_LENGTH\">Maximum combined length</span>—If there is more than one feature in a cell with the same value, the lengths of these features will be combined. The combined feature with the longest length within the cell will determine the value to assign to the cell.</li></ul></xdoc>",
        "cell_assignment.domain.MAXIMUM_COMBINED_LENGTH": "Maximum combined length",
        "cell_assignment.domain.MAXIMUM_LENGTH": "Maximum length",
        "cell_assignment.title": "Cell assignment type",
        "cellsize.descr": "<xdoc><p>The cell size of the output raster being created.</p><p>This parameter can be defined by a numeric value or obtained from an existing raster dataset. If the cell size hasn’t been explicitly specified as the parameter value, the environment cell size value is used, if specified; otherwise, additional rules are used to calculate it from the other inputs. See Usages for more detail.</p></xdoc>",
        "cellsize.title": "Cellsize",
        "description": "Converts polyline features to a raster dataset.",
        "in_features.descr": "The polyline input feature dataset to be converted to a raster.",
        "in_features.title": "Input Features",
        "out_rasterdataset.descr": "<xdoc><p>The output raster dataset to be created.</p><p>If the output raster will not be saved to a geodatabase, specify .tif for TIFF file format, .CRF for CRF file format, .img for ERDAS IMAGINE file format, or no extension for Esri Grid raster format.</p></xdoc>",
        "out_rasterdataset.title": "Output Raster Dataset",
        "priority_field.descr": "<xdoc><p>This field is used to determine which feature should take preference over another feature that falls over a cell. When it is used, the feature with the largest positive priority is always selected for conversion irrespective of the <span class=\"esri_uicontrol\">Cell assignment type</span> chosen.</p></xdoc>",
        "priority_field.title": "Priority field",
        "title": "Polyline to Raster",
        "value_field.descr": "<xdoc><p>The field used to assign values to the output raster.</p><p>It can be any field of the input feature dataset&apos;s attribute table.</p></xdoc>",
        "value_field.title": "Value field"
    }
}
