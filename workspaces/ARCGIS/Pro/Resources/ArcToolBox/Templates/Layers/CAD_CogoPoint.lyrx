        "preloadTextureCutoffHigh" : 0,
        "preloadTextureCutoffLow" : 0.25,
        "textureCutoffHigh" : 0.25,
        "textureCutoffLow" : 1,
        "useCompressedTextures" : true,
        "verticalExaggeration" : 1,
        "exaggerationMode" : "ScaleZ",
        "verticalUnit" : {
          "uwkid" : 9003
        },
        "lighting" : "OneSideDataNormal",
        "optimizeMarkerTransparency" : true
      },
      "layerType" : "Operational",
      "showLegends" : true,
      "visibility" : true,
      "displayCacheType" : "Permanent",
      "maxDisplayCacheAge" : 5,
      "popupInfo" : {
        "type" : "CIMPopupInfo",
        "title" : "{aec_Name} - {aec_PointNum}",
        "mediaInfos" : [
          {
            "type" : "CIMTextMediaInfo",
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "text" : "<table> <tr> <h3>Property</h3> <th></th> </tr>\n<tr> <td><strong>Name:</strong></td> <td>{aec_Name}</td> </tr>\n<tr> <td><strong>Point Number:</strong></td> <td>{aec_PointNum}</td> </tr>\n<tr> <td><strong>Raw Description:</strong></td> <td>{aec_RawDesc}</td> </tr>\n<tr> <td><strong>Full Description:</strong></td> <td>{aec_FullDesc}</td> </tr>\n<tr> <td><strong>Style:</strong></td> <td>{aec_Style}</td> </tr>\n<tr> <td><strong>Northing:</strong></td> <td>{aec_Northing}</td> </tr>\n<tr> <td><strong>Easting:</strong></td> <td>{aec_Easting}</td> </tr>\n<tr> <td><strong>Elevation:</strong></td> <td>{Elevation}</td> </tr>\n<tr> <td><strong>Survey Point:</strong></td> <td>{aec_SurveyPT}</td> </tr>\n<tr> <td><strong>Primary point group:</strong></td> <td>{aec_PPointG}</td> </tr>\n<tr> <td><strong>Hyperlink:</strong></td> <td>{Hyperlink}</td> </tr>\n<tr> <td><strong>Point Label Style:</strong></td> <td>{aec_PTLlStyle}</td> </tr>\n<tr> <td><strong>Label Rotation:</strong></td> <td>{aec_LabelRot}</td> </tr> \n<tr> <td><strong>Label Visibility:</strong></td> <td>{aec_LabelViz}</td> </tr>\n<tr> <td><strong>Leader Attachment Option:</strong></td> <td>{aec_LeadAttOp}</td> </tr> \n<tr> <td><strong>X-Y Scale:</strong></td> <td>{aec_XY_Scale}</td> </tr> \n<tr> <td><strong>Z Scale:</strong></td> <td>{aec_Z_Scale}</td> </tr>\n<tr> <td><strong>Marker Rotation:</strong></td> <td>{aec_MarkerRot}</td> </tr> \n<tr> <td><strong>Description Format:</strong></td> <td>{aec_DesFormat}</td> </tr>\n<tr> <td><strong>Locked Point:</strong></td> <td>{aec_LockedPT}</td> </tr>\n<tr> <td><strong>Leader Visibility:</strong></td> <td>{aec_LeaderViz}</td> </tr> \n<tr> <td><strong>Leader Tail Visibility:</strong></td> <td>{aec_LeadTViz}</td> </tr> \n<tr> <td><strong>Transparency:</strong></td> <td>{Transparency}</td> </tr></table>"
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 1,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var aDict = Schema($feature);\nvar aArray = aDict['fields'];\nvar output = \"<table><h2>Property Sets</h2>\"\nvar p = 0\nfor (var i in $feature){\n    if (!isEmpty($feature[i]) \n        && $feature[i] != 0 \n        && $feature[i] != '-' \n        && Find('aec_',i,0) == -1\n        && i != 'OBJECTID'\n        && i != 'OID'\n        && i != 'Entity'\n        && i != 'Handle'\n        && i != 'Layer'\n        && i != 'LyrFrzn'\n        && i != 'LyrLock'\n        && i != 'LyrOn'\n        && i != 'LyrVPFrzn'\n        && i != 'LyrHandle'\n        && i != 'Color'\n        && i != 'EntColor'\n        && i != 'LyrColor'\n        && i != 'BlkColor'\n        && i != 'Linetype'\n        && i != 'EntLinetype'\n        && i != 'LyrLnType'\n        && i != 'BlkLinetype'    \n        && i != 'Elevation'\n        && i != 'Thickness'\n        && i != 'LineWt'\n        && i != 'EntLineWt'\n        && i != 'LyrLineWt'\n        && i != 'BlkLineWt'\n        && i != 'RefName'    \n        && i != 'Angle'\n        && i != 'ExtX'\n        && i != 'ExtY'\n        && i != 'LTScale'\n        && i != 'ExtZ'\n        && i != 'DocName'\n        && i != 'DocPath'\n        && i != 'DocType'\n        && i != 'DocVer'\n        && i != 'DocUpdate'\n        && i != 'DocId'\n        && i != 'ScaleX'\n        && i != 'ScaleY'\n        && i != 'ScaleZ'\n        && i != 'Transparency'\n        && i != 'Hyperlink'\n        && i != 'SharedView'\n        && i != 'SharedVer')  {\n           for (var j in aArray) {\n             var dict = aArray[j];\n             if (dict['name'] == i) {\n               output  += \"<tr><td><B>\" + Replace(Split(dict['alias'], ' ',2)[1],'_',' ') + \"  :  \" + \"</B>\" + \"</td><td>\" + $feature[i] +  \"</td></tr>\"\n              p++ \n             }\n    }    \n    }\n}\nif (p>0) {\nreturn { \n      type : 'text', \n      text : output + \"</table>\"\n// this property supports html tags \n}\n}",
              "returnType" : "Default"
            }
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 2,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var returnstring = \"<table><h2>BIM Cloud Connection</h2>\" \nvar p = 0\nfor (var i in $feature) {\n    if (!isEmpty($feature[i]) &&  i == 'SharedView')  {\n        returnstring = returnstring + \"<tr><td><B>\" + i + \": \"+ \"</B>\" + \"</td><td>\" + IIf(i == 'SharedView', \"<p><a href=\" +  $feature[i]  + \">URL</a> </p>\", $feature[i])  + \"</td></tr>\"\np++\n    }\n}\nif (p>0) {\nreturn { \n      type : 'text', \n      text : returnstring + \"</table>\" \n       }\n}\n\n//Expression to show the SharedView file, when exist. And to open file in the BIM site using the URL",
              "returnType" : "Default"
            }
          }
        ],
        "gridLayout" : {
