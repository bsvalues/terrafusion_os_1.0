{
  "@Variables": {
    "CollectorName": "$/DESs/XML_DATA_CONTENT/XML/SICD/CollectionInfo/CollectorName$",
    "CollectType": "$/DESs/XML_DATA_CONTENT/XML/SICD/CollectionInfo/CollectType$",
    "CollectMode": "$/DESs/XML_DATA_CONTENT/XML/SICD/CollectionInfo/RadarMode/ModeType?exp=@,-,\\s,replace$"
  },
  "Products": [
    {
      "Title": "Commercial/Properties.json#TitleFormat",
      "Priority": 100,
      "Name": "Sensor Independent Complex Data",
      "Type": "SAR SICD",
      "Match": [
        {
          "Key": "$/Images/%i/IID1?exp=@,(.{4}).*,\\1,regex$",
          "Operator": "Equals",
          "Value": "SICD"
        },
        {
          "Key": "@{CollectorName}",
          "Operator": "NotEqual",
          "Value": ""
        }
      ],
      "LayerDefinitions": [
        {
          "@Variables" : {
            "SourceTemplate" : "SICD_IQ_Complex"
          },
          "ref": "#LayerDefinition-Base"
        },
        {
          "@Variables" : {
            "SourceTemplate" : "Catalog-SICD-RGB"
          },
          "ref": "#LayerDefinition-Base",
          "Key": "SAR_@{CollectorName}_@{CollectType}_@{CollectMode}_Catalog_Image_$%i+1$",
          "Disposition": "None"
        }
      ],
      "MosaicDefinitions": [
        {
          "@Variables": {
            "LayerObject": "SAR_@{CollectorName}_@{CollectType}_@{CollectMode}_Image_$%i+1$"
          },
          "ref": "#MosaicDefinition-Base"
        },
        {
          "@Variables": {
            "LayerObject": "SAR_@{CollectorName}_@{CollectType}_@{CollectMode}_Catalog_Image_$%i+1$"
          },
          "ref": "#MosaicDefinition-Base",
          "ProcessingTemplate": "Catalog"
        }
      ]
    }
  ],
  "IDs": {
    "LayerDefinition-Base" : {
      "Match": [
        {
          "Key": "$/Images/%i/ICAT$",
          "Operator": "Equals",
          "Value": "SAR"
        },
        {
          "Key": "$/Images/%i/NBANDS$",
          "Operator": "Equals",
          "Value": "2"
        }
      ],
      "@Variables": {
      },
      "Type": "Image",
      "Disposition": "TOC|Catalog",
      "Key": "SAR_@{CollectorName}_@{CollectType}_@{CollectMode}_Image_$%i+1$",
      "Title": "($/Images/%i/ICAT$) $/Images/%i/IID1$ / $/Images/%i/IID2$",
      "DisplayLevel": "$/Images/%i/IDLVL?parse=double$",
      "CIM": {
        "type": "CIMNitfImageSubLayer",
        "name": "($/Images/%i/ICAT$) $/Images/%i/IID1$ / $/Images/%i/IID2$",
        "description": "$uri.path$/$uri.profile$##$uri.object$",
        "visibility": true,
        "dataConnection": {
          "type": "CIMStandardDataConnection",
          "workspaceConnectionString": "DATABASE=$uri.parent_path$",
          "workspaceFactory": "Custom",
          "customWorkspaceFactoryCLSID": "{AE8E160A-E739-4999-8275-93532DEBAA50}",
          "dataset": "$uri.file_name$/$uri.profile$##$uri.object$",
          "datasetType": "esriDTAny"
        },
        "colorizer": {
          "type": "CIMRasterStretchColorizer",
          "resamplingType": "BilinearInterpolation",
          "noDataColor": {
            "type": "CIMRGBColor",
            "values": [
              0,
              0,
              0,
              0
            ]
          },
          "backgroundColor": {
            "type": "CIMRGBColor",
            "values": [
              0,
              0,
              0,
              0
            ]
          },
          "backgroundValue": 0,
          "displayBackgroundValue": true,
          "stretchType": "StandardDeviations",
          "standardDeviationParam": 1,             
          "statsType": "AreaOfView",
          "gammaValue": 1.0,
          "useGammaStretch": true
        },
        "autoComputeStatsHistogram": true
      },
      "Source": {
        "Template": "@{SourceTemplate}",
        "Arguments": {
          "Raster:Raster": "$uri.path$##IM_$%i$"
        }
      },
      "Bands": [
        {           
          "BandName": "$/DESs/XML_DATA_CONTENT/XML/SICD/ImageFormation/TxRcvPolarizationProc?exp=@,(.*?)(:(.*))?,\\1\\3,regex$",
          "Wavelength": "",
          "Frequency": ""
        }
      ],
      "Properties": {
        "ImageID": "Commercial/Properties.json#ImageID-Property",
        "Originator": "Commercial/Properties.json#Originator-Property",
        "OriginatorPhone": "Commercial/Properties.json#OriginatorPhone-Property",
        "AcquisitionDate": "Commercial/Properties.json#AcquisitionDate-Property",
        "ISeg": "$%i$",
        "FileID": "Commercial/Properties.json#FileID-Property",
        "Format": "Commercial/Properties.json#Format-Property",
        "FormatVer": "Commercial/Properties.json#FormatVer-Property",
        "NITF_FILE_VERSION": "$/FileHeader/FHDR$$/FileHeader/FVER$",
        "ClassificationCodewords": "Commercial/Properties.json#ClassificationCodewords-Property",
        "ClassificationControl": "Commercial/Properties.json#ClassificationControl-Property",
        "ClassificationRelease": "Commercial/Properties.json#ClassificationRelease-Property",
        "ClassificationSystem": "Commercial/Properties.json#ClassificationSystem-Property",
        "SecurityClassification": "Commercial/Properties.json#SecurityClassification-Property",
        "Bands": "$/Image/NBANDS?parse=double$",
        "Band-BandName": {
          "Aliases": [],
          "SourcePaths": [
            {
              "Path": "$/Images/%i/Bands/%b/ISUBCAT$",
              "Map": [
                [ "I",  "Inphase" ],
                [ "Q",  "Quadrature" ],
                [ "M",  "Magnitude" ],
                [ "P",  "Phase" ]
              ]
            }
          ]
        },
        "ImageRepresentation": "Commercial/Properties.json#ImageRepresentation-Property",
        "ImageCategory": "Commercial/Properties.json#ImageCategory-Property",
        "TargetID": "Commercial/Properties.json#TargetID-Property",
        "ImageSource": "Commercial/Properties.json#ImageSource-Property",
        "ImageKey": "Commercial/Properties.json#ImageKey-Property",
        "SensorName": "@{CollectorName}",
        "ProductName": "@{CollectType}",
        "Mission": "@{CollectorName}",
        "SensorMode": "$/DESs/XML_DATA_CONTENT/XML/SICD/CollectionInfo/RadarMode/ModeType$"
      },
      "Properties-" : {
        "SAR_Product_MissionId" : "@{CollectorName}",
        "SAR_Product_Mode" : "$/DESs/XML_DATA_CONTENT/XML/SICD/CollectionInfo/RadarMode/ModeType$",
        "SAR_Product_ProductType" : "SICD",
        "SAR_Product_StartTime" : "$/DESs/XML_DATA_CONTENT/XML/SICD/Timeline/CollectStart?parse=FDT$",
        "SAR_Product_StopTime" : "$/DESs/XML_DATA_CONTENT/XML/SICD/Timeline/CollectDuration?parse=FDT$",
        "SAR_Product_Polarisation" : "$/DESs/XML_DATA_CONTENT/XML/SICD/ImageFormation/TxRcvPolarizationProc?exp=@,(.*):(.*),\\1\\2,regex$",
        "SAR_Product_Rows" : "$/DESs/XML_DATA_CONTENT/XML/SICD/ImageData/NumRows$",
        "SAR_Product_Cols" : "$/DESs/XML_DATA_CONTENT/XML/SICD/ImageData/NumCols$",
        "SAR_Product_SlantRange" : "$/DESs/XML_DATA_CONTENT/XML/SICD/SCPCOA/SlantRange$",
        "SAR_Product_GroundRange" : "$/DESs/XML_DATA_CONTENT/XML/SICD/SCPCOA/GroundRange$",
        "SAR_Product_DopplerConeAng" : "$/DESs/XML_DATA_CONTENT/XML/SICD/SCPCOA/DopplerConeAng$",
        "SAR_Product_GrazeAng" : "$/DESs/XML_DATA_CONTENT/XML/SICD/SCPCOA/GrazeAng$",
        "SAR_Product_IncidenceAng" : "$/DESs/XML_DATA_CONTENT/XML/SICD/SCPCOA/IncidenceAng$",
        "SAR_Product_TwistAng" : "$/DESs/XML_DATA_CONTENT/XML/SICD/SCPCOA/TwistAng$",
        "SAR_Product_SlopeAng" : "$/DESs/XML_DATA_CONTENT/XML/SICD/SCPCOA/SlopeAng$",
        "SAR_Product_AzimAng" : "$/DESs/XML_DATA_CONTENT/XML/SICD/SCPCOA/AzimAng$",
        "SAR_Product_LayoverAng" : "$/DESs/XML_DATA_CONTENT/XML/SICD/SCPCOA/LayoverAng$",
        "SAR_Product_CalibrationFactor" : "",
        "SAR_Product_IncidenceAnglePolyOrder" : "",
        "SAR_Product_RangePixelSpacing" : "",
        "SAR_Product_IncidenceAngleCoefficients" : "",
        "SAR_Product_ThermalNoiseCorrectionPerformed" : "",
        "SAR_Product_OrbitStateVectors" : "",
        "SAR_Product_AcquisitionType" : "",
        "SAR_Product_BeamModeMnemonic" : ""
      }
    },
    "MosaicDefinition-Base" : {
      "ItemURI": {
        "Path": "$uri.path$/$uri.profile$##@{LayerObject}",
        "Key": "",
        "Tag": "SAR",
        "Group": "SAR-$/Images/0/IDATIM$",
        "DisplayName": "$uri.stem$:$%i$",
        "ProductName": "@{CollectType}",
        "SourceTimeStamp": "$uri.modifiedDateTime$",
        "AuxiliaryPaths": [],
        "Properties": {
          "ImageRepresentation": "MONO",
          "ImageCategory": "SAR",
          "SensorName": "@{CollectorName}"
        }
      },
      "Footprint": "",
      "ProcessingTemplate": "Default",
      "Variables": {
      },
      "Properties": {}
    }
  }
}