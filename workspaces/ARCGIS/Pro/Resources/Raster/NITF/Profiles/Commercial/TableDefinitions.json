{
  "IDs": {
    "CIM-Table": {
      "type": "CIMStandaloneTable",
      "name": "@{TableName}",
      "description": "@{TableName}",
      "uRI": "CIMPATH=map/standalonetable.json",
      "sourceModifiedTime": {
        "type": "TimeInstant"
      },
      "useSourceMetadata": true,
      "displayField": "FIRST_NAME",
      "editable": true,
      "dataConnection": {
        "type": "CIMStandardDataConnection",
        "workspaceConnectionString": "DATABASE=$uri.parent_path$",
        "workspaceFactory": "NITF",
        "dataset": "$uri.file_name$/$uri.profile$##$uri.object$",
        "datasetType": "esriDTTable"
      },
      "autoGenerateRowTemplates": true,
      "rowTemplates": [
        {
          "type": "CIMRowTemplate",
          "name": "@{TableName}",
          "tags": "Table",
          "defaultToolGUID": "ea2ecd82-d947-4d01-bf74-125dc09aa695"
        }
      ],
      "serviceTableID": -1,
      "showPopups": true
    },
    "Table-Base": {
      "Type": "Table",
      "Key": "@{TableName}",
      "Disposition": "Menu",
      "Title": "Table $%i+1$ - @{TableName}",
      "CIM": "#CIM-Table",
      "Source": "$uri.path$##@{TableName}"
    },
    "Table-Source-File-Base": {
      "@Variables": {
        "TableName": "@{TREName}_FileHeader"
      },
      "ref": "#Table-Base",
      "Title": "(@{TREName}) $/FileHeader/FTITLE$",
      "Match": [
        {
          "Key": "$/FileHeader/TREs/@{TREName}/_exists$",
          "Operator": "NotEqual",
          "Value": ""
        }
      ]
    },
    "Table-Source-Image-Base": {
      "@Variables": {
        "TableName": "@{TREName}_Image_1"
      },
      "ref": "#Table-Base",
      "Title": "(@{TREName}) $/Images/0/IID2$",
      "Match": [
        {
          "Key": "$Images/0/TREs/@{TREName}/_exists$",
          "Operator": "NotEqual",
          "Value": ""
        }
      ]
    },
    "Table-SECTGA-From-FileHeader": {
      "@Variables": {
        "TREName": "SECTGA"
      },
      "ref": "#Table-Source-File-Base",
      "Properties": {
        "TableType": "MultiTRE",
        "TREName": "SECTGA",
        "RowCountField": "NUM_NAMES",
        "Sources": [
          {"name": "SECTGA", "segment": "FileHeader", "index": "-1"}
        ],
        "Fields": [
          {"name": "SEC_ID", "type": "string" },
          {"name": "SEC_BE", "type": "string" }
        ]
      }
    },
    "Table-SECTGA-From-Image": {
      "@Variables": {
        "TREName": "SECTGA"
      },
      "ref": "#Table-Source-Image-Base",
      "Properties": {
        "TableType": "MultiTRE",
        "TREName": "SECTGA",
        "RowCountField": "NUM_NAMES",
        "Sources": [
          {"name": "SECTGA", "segment": "Images", "index": "0"}
        ],
        "Fields": [
          {"name": "SEC_ID", "type": "string" },
          {"name": "SEC_BE", "type": "string" }
        ]
      }
    },
    "Table-CSEPHA": {
      "@Variables": {
        "TREName": "CSEPHA"
      },
      "ref": "#Table-Source-Image-Base",
      "Properties": {
        "TableType": "SingleTRE",
        "TREName": "CSEPHA",
        "RowCountField": "NUM_EPHEM",
        "Sources": [
          {"name": "CSEPHA", "segment": "Images", "index": "0"}
        ],
        "Fields": [
          {"name": "EPHEM_X", "type": "double" },
          {"name": "EPHEM_Y", "type": "double" },
          {"name": "EPHEM_Z", "type": "double" }
        ]
      }
    },
    "Table-HISTOA": {
      "@Variables": {
        "TREName": "HISTOA"
      },
      "ref": "#Table-Source-Image-Base",
      "Properties": {
        "TableType": "SingleTRE",
        "TREName": "HISTOA",
        "RowCountField": "NEVENTS",
        "Sources": [
          {"name": "HISTOA", "segment": "Images", "index": "0"}
        ],
        "Fields": [
          {"name": "PDATE", "type": "string" },
          {"name": "PSITE", "type": "string" },
          {"name": "PAS", "type": "string" },
          {"name": "NIPCOM", "type": "string" },
          {"name": "IBPP", "type": "string" },
          {"name": "IPVTYPE", "type": "string" },
          {"name": "INBWC", "type": "string" },
          {"name": "DISP_FLAG", "type": "string" },
          {"name": "ROT_FLAG", "type": "string" },
          {"name": "ASYM_FLAG", "type": "string" },
          {"name": "PROJ_FLAG", "type": "string" },
          {"name": "SHARP_FLAG", "type": "string" },
          {"name": "MAG_FLAG", "type": "string" },
          {"name": "DRA_FLAG", "type": "string" },
          {"name": "TTC_FLAG", "type": "string" },
          {"name": "DEVLUT_FLAG", "type": "string" },
          {"name": "OBPP", "type": "string" },
          {"name": "OPVTYPE", "type": "string" },
          {"name": "OUTBWC", "type": "string" }
        ]
      }
    }
  }
}