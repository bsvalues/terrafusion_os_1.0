      "featureTable": {
        "type": "CIMFeatureTable",
        "displayField": "Default",
        "editable": false,
        "dataConnection": {
          "type": "CIMStandardDataConnection",
          "workspaceConnectionString": "$Feature/CLOUD_SHAPES/ConnectionString$",
          "workspaceFactory": "Shapefile",
          "dataset": "CLOUD_SHAPES"
        }
      },
      "renderer": "Colorizers.json#CloudShapesFeatureRenderer"
