      "Match": [
        "MatchRules.json#MatchRule-ImageHasICATIsMS",
        "MatchRules.json#MatchRule-ImageHasIREPIsRGBorMULTI",
        "MatchRules.json#MatchRule-ImageIs3Bands",
        "MatchRules.json#MatchRule-ImageHasIREPBAND0IsB",
        "MatchRules.json#MatchRule-ImageHasIREPBAND1IsG",
        "MatchRules.json#MatchRule-ImageHasIREPBAND2IsR"
      ]
