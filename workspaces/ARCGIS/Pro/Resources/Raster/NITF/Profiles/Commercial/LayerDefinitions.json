      "ref": "#NCDRDCatalogImage-Base",
      "Match": [
        "MatchRules.json#MatchRule-ImageHasICATIsCAVIS",
        "MatchRules.json#MatchRule-ImageHasIREPIsMULTI",
        "MatchRules.json#MatchRule-ImageIs6Bands"
      ],
      "Source": "#Source-Catalog-CAVIS-RGBChain"
    },
    "NCDRDPrimaryImage-Cloud": {
      "@Variables": {
        "ImageType": "Clouds"
      },
      "ref": "#NCDRDPrimaryImage-Base",
      "Disposition": "TOC|Catalog",
      "Source": "$uri.path$##IM_$%i$",
      "Match": [
        "MatchRules.json#MatchRule-ImageIs1Band",
        {
          "Key": "$/Images/%i/ICAT$",
          "Operator": "Equals",
          "Value": "CLOUD"
        }
      ]
    },
    "NCDRDFeatureLayer-Base": {
      "Type": "Feature",
      "Key": "Layer_Feature_@{FeatureType}",
      "Disposition": "TOC|Catalog",
      "Title": "$/DESs/%i/UserDefinedSubHeader/SHAPE_USE$",
      "CIM": "#CIM-@{FeatureType}ShapeLayer",
      "Source": "$uri.path$##FC_CSSHP_$/DESs/%i/UserDefinedSubHeader/SHAPE_USE$",
      "Properties": {
        "SensorName": "Properties.json#SensorName-Property",
        "ProductName": "Properties.json#ProductName-Property"
      }
    },
    "NCDRDFeatureLayer-Clouds": {
      "@Variables": {
        "FeatureType": "Clouds"
      },
      "ref": "#NCDRDFeatureLayer-Base",
      "Match": ["MatchRules.json#MatchRule-DESIsCLOUD_SHAPES"]
    },
    "NCDRDFeatureLayer-Image": {
      "@Variables": {
        "FeatureType": "Image"
      },
      "ref": "#NCDRDFeatureLayer-Base",
      "Match": ["MatchRules.json#MatchRule-DESIsIMAGE_SHAPE"]
    },
    "NCDRDFeatureLayer-Generic": {
      "ref": "#NCDRDFeatureLayer-Base",
      "Key": "Layer_Feature_$%i$",
      "CIM": "",
      "Match": []
    },
    "CIM-Panchromatic-Base": {
      "type": "CIMNitfImageSubLayer",
      "name": "#NCDRDTitle",
      "description": "$uri.path$/$uri.profile$##$uri.object$",
      "visibility": true,
      "dataConnection": {
        "type": "CIMStandardDataConnection",
        "workspaceConnectionString": "DATABASE=$uri.parent_path$",
        "workspaceFactory": "Custom",
        "customWorkspaceFactoryCLSID": "{AE8E160A-E739-4999-8275-93532DEBAA50}",
        "dataset": "$uri.file_name$/$uri.profile$##$uri.object$",
        "datasetType": "esriDTAny"
      },
      "colorizer": "Colorizers.json#SingleBandColorizerWithDRA",
      "autoComputeStatsHistogram": true
    },
    "CIM-Multispectral-Base": {
      "type": "CIMNitfImageSubLayer",
      "name": "#NCDRDTitle",
      "description": "$uri.path$##$uri.object$",
      "visibility": true,
      "dataConnection": {
        "type": "CIMStandardDataConnection",
        "workspaceConnectionString": "DATABASE=$uri.parent_path$",
        "workspaceFactory": "Custom",
        "customWorkspaceFactoryCLSID": "{AE8E160A-E739-4999-8275-93532DEBAA50}",
        "dataset": "$uri.file_name$/$uri.profile$##$uri.object$",
        "datasetType": "esriDTAny"
      },
      "colorizer": "Colorizers.json#ThreeBandsColorizerWithDRA",
      "autoComputeStatsHistogram": true
    },

    "CIM-Panchromatic-Basic": "#CIM-Panchromatic-Base",
    "CIM-Multispectral3Bands-Basic": "#CIM-Multispectral-Base",
    "CIM-Multispectral4Bands-Basic": "#CIM-Multispectral-Base",
    "CIM-Multispectral8Bands-Basic": "#CIM-Multispectral-Base",

    "CIM-Panchromatic-Geo": "#CIM-Panchromatic-Base",
