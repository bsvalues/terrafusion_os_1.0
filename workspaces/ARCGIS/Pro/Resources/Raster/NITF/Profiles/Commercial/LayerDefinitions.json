      "@Variables": {
        "ImageType": "CAVIS6",
        "RedBandIndex": 0,
        "GreenBandIndex": 1,
        "BlueBandIndex": 2
      },
      "ref": "#NCDRDPrimaryImage-Base",
      "Source": "$uri.path$##IM_$%i$",
      "Match": [
        "MatchRules.json#MatchRule-ImageHasICATIsCAVIS",
        "MatchRules.json#MatchRule-ImageHasIREPIsMULTI",
        "MatchRules.json#MatchRule-ImageIs6Bands"
      ]
    },
    "NCDRDCatalogImage-CAVIS6": {
      "@Variables": {
        "ImageType": "CAVIS6",
        "RedBandIndex": 0,
        "GreenBandIndex": 1,
