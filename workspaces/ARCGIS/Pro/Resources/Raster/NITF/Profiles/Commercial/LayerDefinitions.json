{
  "IDs": {
    "NCDRDTitle": "($/Images/%i/ICAT$) $/Images/%i/IID1$ / $/Images/%i/IID2$",
    "NCDRDPrimaryImage-Base": {
      "@Variables": {
        "iseg": "$%i$"
      },
      "Type": "Image",
      "Key": "Layer_Image_@{ImageType}_$%i$",
      "Aliases": ["Layer_Image_@{ImageType}"],
      "Disposition": "TOC|Catalog",
      "Title": "#NCDRDTitle",
      "DisplayLevel": "$/Images/%i/IDLVL?parse=double$",
      "CIM": "#CIM-@{ImageType}",
      "Source": "#Source-RasterInfoGeometricStretchChain",
      "Bands": "#/Bands-@{ImageType}",
      "Properties": "Properties.json#Properties"
    },
    "NCDRDCatalogImage-Base": {
      "ref": "#NCDRDPrimaryImage-Base",
      "Key": "Layer_Image_Catalog_@{ImageType}",
      "Disposition": "None"
    },

    "NCDRDPrimaryImage-Generic": {
      "Type": "Image",
      "Key": "Layer_Image_$%i+1$",
      "Disposition": "TOC|Catalog",
      "Title": "#NCDRDTitle",
      "DisplayLevel": "$/Images/%i/IDLVL?parse=double$",
      "CIM": "",
      "Source": "$uri.path$##IM_$%i$",
      "Bands": [],
      "Properties": {
        "ref": "Properties.json#Properties",
        "Band-BandName": "Properties.json#Band-BandName",
        "Band-WavelengthMax": "Properties.json#Band-WavelengthCenter",
        "Band-WavelengthMin": "Properties.json#Band-WavelengthCenter",
        "Band-WavelengthCenter": "Properties.json#Band-WavelengthCenter"
      }
    },
    "NCDRDCatalogImage-Generic": {
      "Type": "Image",
      "Key": "Layer_Image_Catalog_$%i+1$",
      "Disposition": "None",
      "Title": "#NCDRDTitle",
      "DisplayLevel": "$/Images/%i/IDLVL?parse=double$",
      "CIM": "",
      "Source": "$uri.path$##IM_$%i$",
      "Bands": [],
      "Properties": {
        "ref": "Properties.json#Properties",
        "Band-BandName": "Properties.json#Band-BandName",
        "Band-WavelengthMax": "Properties.json#Band-WavelengthCenter",
        "Band-WavelengthMin": "Properties.json#Band-WavelengthCenter",
        "Band-WavelengthCenter": "Properties.json#Band-WavelengthCenter"
      }
    },
    "NCDRDPrimaryImage-Panchromatic-Basic": {
      "@Variables": {
        "ImageType": "Panchromatic-Basic"
      },
      "ref": "#NCDRDPrimaryImage-Base",
      "Match": "MatchRules.json#MatchRules-ImageIsPan"
    },
    "NCDRDCatalogImage-Panchromatic-Basic": {
      "@Variables": {
        "ImageType": "Panchromatic-Basic"
      },
      "ref": "#NCDRDCatalogImage-Base",
      "Match": "MatchRules.json#MatchRules-ImageIsPan",
      "Source": "#Source-Catalog-1BandPanchromatic-RGBChain"
    },

    "NCDRDPrimaryImage-Multispectral3Bands-Basic": {
      "@Variables": {
        "ImageType": "Multispectral3Bands-Psh",
        "RedBandIndex": 0,
        "GreenBandIndex": 1,
        "BlueBandIndex": 2
      },
      "ref": "#NCDRDPrimaryImage-Base",
      "Match": [
        "MatchRules.json#MatchRule-ImageHasICATIsMS",
        "MatchRules.json#MatchRule-ImageHasIREPIsMULTI",
        "MatchRules.json#MatchRule-ImageIs3Bands"
      ]
    },
    "NCDRDCatalogImage-Multispectral3Bands-Basic": {
      "@Variables": {
        "ImageType": "Multispectral3Bands-Psh",
        "RedBandIndex": 0,
        "GreenBandIndex": 1,
