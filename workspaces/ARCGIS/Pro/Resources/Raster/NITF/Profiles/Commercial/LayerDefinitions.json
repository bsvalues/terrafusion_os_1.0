          "workspaceFactory": "Shapefile",
          "dataset": "IMAGE_SHAPE"
        }
      },
      "renderer": "Colorizers.json#ImageShapeFeatureRenderer"
    },

    "Source-RasterInfoGeometricStretchChain": {
      "Template": "RasterInfo-Geometric",
      "Arguments": {
        "Raster:Raster": "$uri.path$##IM_$%i$"
