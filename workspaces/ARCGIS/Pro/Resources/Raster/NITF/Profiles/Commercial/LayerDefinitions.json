      },
      "ref": "#NCDRDCatalogImage-Base",
      "Match": [
        "MatchRules.json#MatchRule-ImageHasICATIsMS",
        "MatchRules.json#MatchRule-ImageHasIREPIsMULTI",
        "MatchRules.json#MatchRule-ImageIs3Bands"
