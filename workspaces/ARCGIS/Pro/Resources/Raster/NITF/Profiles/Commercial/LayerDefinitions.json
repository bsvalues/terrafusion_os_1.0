      "Bands": "#/Bands-Multispectral3Bands-Psh",
      "Match": [
        "MatchRules.json#MatchRule-ImageHasICATIsMS",
        "MatchRules.json#MatchRule-ImageHasIREPIsRGB",
        "MatchRules.json#MatchRule-ImageIs3Bands"
      ]
    },
    "NCDRDCatalogImage-Multispectral3Bands-RGB": {
