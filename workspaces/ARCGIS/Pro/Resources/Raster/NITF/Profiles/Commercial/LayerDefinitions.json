    "CIM-Multispectral3Bands-RGB": "#CIM-Multispectral-Base",
    "CIM-Multispectral3Bands-Psh": "#CIM-Multispectral-Base",
    "CIM-Multispectral4Bands-Psh": "#CIM-Multispectral-Base",

    "CIM-SWIR8": "#CIM-Multispectral-Base",
    "CIM-CAVIS6": "#CIM-Multispectral-Base",

    "CIM-Clouds": {
      "type": "CIMNitfImageSubLayer",
      "name": "#NCDRDTitle",
      "description": "$uri.path$/$uri.profile$##$uri.object$",
      "visibility": false,
      "dataConnection": {
        "type": "CIMStandardDataConnection",
        "workspaceConnectionString": "DATABASE=$uri.parent_path$",
        "workspaceFactory": "Custom",
        "customWorkspaceFactoryCLSID": "{AE8E160A-E739-4999-8275-93532DEBAA50}",
