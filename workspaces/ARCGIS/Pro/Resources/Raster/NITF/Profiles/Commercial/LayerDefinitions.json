        "MatchRules.json#MatchRule-ImageHasIREPBAND2IsR"
      ],
      "Source": "#Source-Catalog-3BandMS-BGRChain"
    },

    "NCDRDPrimaryImage-Multispectral4Bands-Basic": {
      "@Variables": {
        "ImageType": "Multispectral4Bands-Basic",
        "RedBandIndex": "@{4BandRedIndex}",
        "GreenBandIndex": "@{4BandGreenIndex}",
        "BlueBandIndex": "@{4BandBlueIndex}"
