{
  "folders": [
    {
      "path": "../SDK/modules/terra-levy",
      "name": "💰 Terra Levy System"
    },
    {
      "path": "../SDK/modules/terra-levy/api",
      "name": "🚀 Levy API"
    },
    {
      "path": "../SDK/modules/terra-levy/components",
      "name": "🧩 Levy Components"
    },
    {
      "path": "../SDK/modules/terra-levy/tests",
      "name": "🧪 Levy Tests"
    },
    {
      "path": "../SDK",
      "name": "📦 Platform SDK"
    },
    {
      "path": "../config",
      "name": "⚙️ Configuration"
    },
    {
      "path": "../backend",
      "name": "🔧 Shared Backend"
    }
  ],
  "settings": {
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#FF9800",
      "titleBar.activeForeground": "#000000"
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/backend": true,
      "**/frontend": true
    },
    "terrafusion.role": "tax_processing",
    "terrafusion.responsibility": "levy_calculations"
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.vscode-typescript-next",
      "ms-dotnettools.csharp"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Terra Levy",
        "type": "node",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build Terra Levy",
        "type": "shell",
        "command": "echo 'Build task for ${workspaceFolder}'",
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Test Terra Levy",
        "type": "shell",
        "command": "echo 'Test task for ${workspaceFolder}'",
        "problemMatcher": [],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      }
    ]
  }
}
