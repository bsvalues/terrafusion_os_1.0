{
  "folders": [
    {
      "path": "../marketplace/unified-system/service-orchestration",
      "name": "🎼 Service Orchestration"
    },
    {
      "path": "../marketplace/unified-system/service-mesh",
      "name": "🕸️ Service Mesh"
    },
    {
      "path": "../marketplace/unified-system/enterprise-integration",
      "name": "🏢 Enterprise Integration"
    },
    {
      "path": "../marketplace/unified-system/cross-platform",
      "name": "🌐 Cross-Platform Bridge"
    },
    {
      "path": "../marketplace/unified-system/architecture-coordination",
      "name": "🏗️ Architecture Coordination"
    },
    {
      "path": "../marketplace/unified-system/system-health",
      "name": "🔍 System Health Monitor"
    },
    {
      "path": "../marketplace/unified-system/testing",
      "name": "🧪 Unified Tests"
    },
    {
      "path": "../SDK",
      "name": "📦 Platform SDK (read-only)"
    },
    {
      "path": "../backend",
      "name": "🔧 Shared Backend (read-only)"
    },
    {
      "path": "../docs/unified-system",
      "name": "📚 Unified Docs"
    },
    {
      "path": "../config",
      "name": "⚙️ Config (shared)"
    },
    {
      "path": "../docs/unified_system",
      "name": "📚 Unified-System Docs"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/out": true,
      "**/.pytest_cache": true,
      "../marketplace/*/": true,
      "!../marketplace/unified-system": false,
      "../frontend": true,
      "../backend": true,
      "../os-platform": true,
      "../terrafusion-cos": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/out": true,
      "../frontend": true,
      "../backend": true,
      "../os-platform": true
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "python.defaultInterpreter": "./marketplace/unified-system/.venv/bin/python",
    "eslint.workingDirectories": [
      "./marketplace/unified-system/service-orchestration",
      "./marketplace/unified-system/enterprise-integration"
    ],
    "terrafusion.sync": {
      "autoSync": true,
      "syncInterval": 10,
      "conflictResolution": "prompt",
      "sharedState": {
        "backend": "read-only",
        "sdk": "read-only",
        "config": "shared-write"
      },
      "unifiedIntegration": true
    },
    "terrafusion.unified": {
      "enableOrchestration": true,
      "serviceMesh": true,
      "enterpriseIntegration": true,
      "crossPlatform": true,
      "architectureCoordination": true,
      "systemHealth": true,
      "loadBalancing": true
    },
    "terrafusion.orchestration": {
      "containerEngine": "kubernetes",
      "serviceMesh": "istio",
      "apiGateway": "envoy",
      "loadBalancer": "nginx",
      "healthChecks": "comprehensive"
    },
    "terrafusion.compliance": {
      "fismaMode": "HIGH",
      "nist80053": true,
      "enterpriseStandards": true,
      "systemCompliance": true,
      "auditTrail": "comprehensive",
      "architectureGovernance": true
    },
    "terrafusion.monitoring": {
      "distributedTracing": "jaeger",
      "metricsCollection": "prometheus",
      "logAggregation": "elasticsearch",
      "alerting": "alertmanager",
      "dashboards": "grafana"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.debugpy",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "streetsidesoftware.code-spell-checker",
      "ms-azuretools.vscode-docker",
      "ms-kubernetes-tools.vscode-kubernetes-tools",
      "redhat.vscode-yaml",
      "ms-vscode.vscode-json",
      "usernamehw.errorlens"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Start Service Orchestration",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/unified-system/service-orchestration",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "console": "integratedTerminal",
        "env": {
          "TERRAFUSION_SERVICE": "unified-system",
          "ORCHESTRATION_MODE": "development",
          "KUBERNETES_ENABLED": "true"
        }
      },
      {
        "name": "Debug Service Mesh",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/unified-system/service-mesh",
        "program": "mesh_controller.py",
        "console": "integratedTerminal",
        "env": {
          "MESH_DEBUG": "true",
          "ISTIO_ENABLED": "true"
        }
      },
      {
        "name": "Debug Enterprise Integration",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/unified-system/enterprise-integration",
        "program": "integration_hub.js",
        "console": "integratedTerminal",
        "env": {
          "ENTERPRISE_DEBUG": "true",
          "API_GATEWAY": "envoy"
        }
      },
      {
        "name": "Start System Health Monitor",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/unified-system/system-health",
        "program": "health_monitor.py",
        "console": "integratedTerminal",
        "env": {
          "HEALTH_DEBUG": "true",
          "MONITORING_MODE": "real-time"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build Unified System",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "build:unified"
        ],
        "problemMatcher": [
          "$tsc"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Test Unified System",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "test:unified"
        ],
        "problemMatcher": [],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      },
      {
        "label": "Deploy Kubernetes Cluster",
        "type": "shell",
        "command": "kubectl",
        "args": [
          "apply",
          "-f",
          "k8s/"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/unified-system"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Start Service Mesh",
        "type": "shell",
        "command": "istioctl",
        "args": [
          "install",
          "--set",
          "values.pilot.traceSampling=100"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/unified-system/service-mesh"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Test Enterprise Integration",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "test:integration"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/unified-system/enterprise-integration"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Health Check All Services",
        "type": "shell",
        "command": "python",
        "args": [
          "health_check_all.py"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/unified-system/system-health"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Monitor Cross-Platform Bridge",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "monitor:bridge"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/unified-system/cross-platform"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Architecture Validation",
        "type": "shell",
        "command": "python",
        "args": [
          "validate_architecture.py"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/unified-system/architecture-coordination"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "System Performance Test",
        "type": "shell",
        "command": "npm",
        "args": [
          "run",
          "test:performance"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/unified-system/testing"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Enterprise Compliance Check",
        "type": "shell",
        "command": "./SDK/tools/compliance-check.sh",
        "args": [
          "--service=unified-system",
          "--enterprise-standards"
        ],
        "problemMatcher": [],
        "group": "none"
      }
    ]
  }
}