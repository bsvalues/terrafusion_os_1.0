  },
  "description": "Phase 45: Benton County Auto-Remediation Operations Dashboard - SPEC LOCK v1.0.0",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Kill Switch (Benton)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "max(tf_runbook_killswitch_enabled{county_id=\"benton\"})",
          "legendFormat": "Kill Switch",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "OFF (Auto-Exec Enabled)"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": { "color": "red", "index": 1, "text": "ON (All Blocked)" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Auto-Exec Attempts (rate, DryRun vs Real)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum by (dry_run) (rate(tf_runbook_autoexec_attempt_total{county_id=\"benton\"}[5m]))",
          "legendFormat": "{{dry_run}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Executions/sec",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" }
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 3,
      "title": "Auto-Exec Totals (Real vs Simulated)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(tf_runbook_autoexec_real_total{county_id=\"benton\"}[1h]))",
          "legendFormat": "Real",
          "refId": "A"
        },
        {
          "expr": "sum(increase(tf_runbook_autoexec_simulated_total{county_id=\"benton\"}[1h]))",
          "legendFormat": "Simulated",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 4,
      "title": "Blocks by Reason (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (reason) (rate(tf_runbook_autoexec_block_total{county_id=\"benton\"}[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 5,
      "title": "Auto-Exec by Safety Level (Real, rate)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (safety_level) (rate(tf_runbook_autoexec_real_total{county_id=\"benton\"}[5m]))",
          "legendFormat": "{{safety_level}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "pieType": "pie"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "InfoOnly" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "green", "mode": "fixed" }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "LowRisk" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "yellow", "mode": "fixed" }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Auto-Exec by Step Kind (Real, rate)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "sum by (step_kind) (rate(tf_runbook_autoexec_real_total{county_id=\"benton\"}[5m]))",
          "legendFormat": "{{step_kind}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "pieType": "pie"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Diagnostic" },
            "properties": [
              {
                "id": "color",
                "value": { "fixedColor": "green", "mode": "fixed" }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Invariant Violations (Benton, rate)",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 18, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (invariant) (rate(tf_runbook_autoexec_invariant_violation_total{county_id=\"benton\"}[5m]))",
          "legendFormat": "{{invariant}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 8,
      "title": "Non-Eligible Auto-Exec Attempts (should be zero)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(tf_runbook_autoexec_real_total{county_id=\"benton\", safety_level!~\"InfoOnly|LowRisk\"}[5m]))\n+\nsum(rate(tf_runbook_autoexec_real_total{county_id=\"benton\", step_kind!=\"Diagnostic\"}[5m]))",
          "legendFormat": "Non-Eligible",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          },
          "unit": "reqps"
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    }
  ],
