{
  "id": "api-gateway",
  "metadata": {
    "name": "API Gateway",
    "description": "GraphQL API Gateway with Apollo Server and microservices integration",
    "category": "API Development",
    "tags": ["graphql", "apollo", "nodejs", "typescript", "gateway"],
    "dependencies": {
      "node": ">=18.0.0",
      "npm": ">=8.0.0"
    },
    "requirements": ["Node.js 18+", "Docker (optional)"],
    "author": "Terrafusion Team",
    "version": "1.0.0",
    "icon": "share-2"
  },
  "variables": [
    {
      "name": "PROJECT_NAME",
      "description": "Name of your API gateway",
      "default_value": "my-api-gateway",
      "required": true,
      "validation_pattern": "^[a-z][a-z0-9-]*$"
    },
    {
      "name": "PORT",
      "description": "Gateway server port",
      "default_value": "4000",
      "required": false,
      "validation_pattern": "^[0-9]+$"
    },
    {
      "name": "ENABLE_SUBSCRIPTIONS",
      "description": "Enable GraphQL subscriptions (true/false)",
      "default_value": "true",
      "required": false,
      "validation_pattern": "^(true|false)$"
    }
  ],
  "file_mappings": {},
  "post_install_commands": [
    "npm install",
    "echo 'API Gateway created successfully!'",
    "echo 'Run: npm run dev'"
  ]
}
