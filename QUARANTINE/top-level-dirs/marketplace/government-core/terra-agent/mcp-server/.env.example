# TerraAgent MCP Server Environment Configuration

# Server Configuration
NODE_ENV=development
SERVER_NAME=terra-agent-mcp-server
SERVER_VERSION=1.0.0

# Database Configuration
DB_TYPE=sqlite
SQLITE_FILE=./data/terraagent.db

# PostgreSQL Configuration (if using postgresql)
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=terraagent
# DB_USER=terraagent
# DB_PASSWORD=your_password
# DB_SSL=false
# DB_MAX_CONNECTIONS=10

# Cache Configuration
CACHE_PROVIDER=memory
CACHE_DEFAULT_TTL=300
CACHE_MAX_MEMORY_MB=100
CACHE_ENABLED=true

# Redis Configuration (if using redis cache)
# CACHE_PROVIDER=redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_CONNECT_TIMEOUT=5000
# REDIS_COMMAND_TIMEOUT=3000

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=pretty
# LOG_FILE=./logs/terraagent-mcp.log

# Performance Configuration
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_MS=30000

# External Service Configuration
TERRA_AGENT_BACKEND_URL=http://localhost:5000
TERRA_AGENT_BACKEND_TIMEOUT=10000
TERRA_AGENT_BACKEND_RETRIES=3
# TERRA_AGENT_BACKEND_API_KEY=your_api_key

PROPERTY_DATA_URL=http://localhost:5001
PROPERTY_DATA_TIMEOUT=10000
PROPERTY_DATA_RETRIES=3
# PROPERTY_DATA_API_KEY=your_api_key

ASSESSMENT_API_URL=http://localhost:5002
ASSESSMENT_API_TIMEOUT=10000
ASSESSMENT_API_RETRIES=3
# ASSESSMENT_API_API_KEY=your_api_key
