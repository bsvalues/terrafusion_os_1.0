{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerraFusion Service",
  "description": "Backend API, microservice, daemon, or kernel service",
  "type": "object",
  "required": ["id", "name", "owner", "lifecycle", "source_path"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier (e.g., os.kernel.api, marketplace.gateway)",
      "pattern": "^[a-z0-9.-]+$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name"
    },
    "description": {
      "type": "string",
      "description": "What this service does"
    },
    "owner": {
      "type": "string",
      "description": "Team or person responsible (e.g., kernel-team, @username)"
    },
    "lifecycle": {
      "type": "string",
      "enum": ["active", "deprecated", "experimental", "archived"],
      "default": "active"
    },
    "source_path": {
      "type": "string",
      "description": "Relative path to source code"
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Tags for categorization (domain, layer, security, tech)"
    },
    "depends_on": {
      "type": "array",
      "items": {"type": "string"},
      "description": "IDs of other services/engines/datasets this depends on"
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {"type": "string"},
          "environment": {"type": "string"}
        }
      }
    },
    "repository": {
      "type": "string",
      "description": "Git repository URL (if separate)"
    },
    "documentation": {
      "type": "string",
      "description": "Link to docs or README"
    }
  }
}
