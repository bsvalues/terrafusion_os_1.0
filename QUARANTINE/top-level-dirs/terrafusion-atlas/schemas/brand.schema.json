{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerraFusion Brand",
  "description": "Brand identity, logos, and marketing assets",
  "type": "object",
  "required": ["id", "name", "owner", "source_path"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "owner": {"type": "string"},
    "source_path": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "primary_color": {"type": "string"},
    "logo_path": {"type": "string"},
    "guidelines_url": {"type": "string"}
  }
}
