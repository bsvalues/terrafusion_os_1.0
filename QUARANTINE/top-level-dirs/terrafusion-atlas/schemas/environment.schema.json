{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerraFusion Environment",
  "description": "Deployment environment configuration",
  "type": "object",
  "required": ["id", "name", "owner", "env_type"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "owner": {"type": "string"},
    "env_type": {"type": "string", "enum": ["dev", "staging", "production", "partner", "demo"]},
    "tags": {"type": "array", "items": {"type": "string"}},
    "cluster": {"type": "string"},
    "namespace": {"type": "string"}
  }
}
