# Benton County cockpit environment (development-safe defaults)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=benton
DATABASE_URL=Host=postgres;Port=5432;Database=benton;Username=postgres;Password=postgres

REDIS_URL=redis:6379

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5000

# Optional legacy integration placeholders
HARRIS_PACS_CONNECTION=""
TYLER_API_KEY=""
AUMENTUM_API_KEY=""

# Feature flags
FEATURE_AI_SWARM=true
FEATURE_QUANTUM_OPTIMIZATION=true# Benton County (DEV ONLY)
COUNTY_NAME=benton
COUNTY_DISPLAY_NAME="Benton County, Washington"

DB_USER=terrafusion
DB_PASSWORD=DevPasswordChangeInProd
DB_NAME=benton_county
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}
HOST_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}

# Features
TERRASYNC_ENABLED=true
COSTFORGE_AI_ENABLED=true
TERRAFUSION_GPT_ENABLED=true
CONSCIOUSNESS_ENABLED=true
QUANTUM_FACTOR=949
AI_AGENT_COUNT=1008

# Optional: Legacy PACS Twin (do not use prod)
LEGACY_PACS_HOST=TF-BENTON-PACS-CLONE
LEGACY_PACS_PORT=1433
LEGACY_PACS_DATABASE=PACS
LEGACY_PACS_USER=tf_reader
LEGACY_PACS_PASSWORD=changeme
# ══════════════════════════════════════════════════════════════════
# TerraFusion Elite Government OS — Benton County Configuration
# ══════════════════════════════════════════════════════════════════
# Copy to .env and customize for your environment
# NEVER commit .env to source control

# ── County Identity ───────────────────────────────────────────────
COUNTY_NAME=benton
COUNTY_DISPLAY_NAME="Benton County, Washington"
COUNTY_CODE=WA-005
COUNTY_FIPS=53005

# ── Database Configuration (PostgreSQL) ───────────────────────────
DB_USER=terrafusion
DB_PASSWORD=DevPasswordChangeInProd
DB_NAME=benton_county
DB_HOST=postgres
DB_PORT=5432

# Connection strings
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
HOST_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}

# ── Redis Configuration ───────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ── TerraFusion Feature Flags ─────────────────────────────────────
TERRASYNC_ENABLED=true
COSTFORGE_AI_ENABLED=true
TERRAFUSION_GPT_ENABLED=true
CONSCIOUSNESS_ENABLED=true
QUANTUM_ANALYTICS_ENABLED=true
TERRAFUSION_LEVY_ENABLED=true

# ── AI Swarm Configuration ────────────────────────────────────────
QUANTUM_FACTOR=949
AI_AGENT_COUNT=1008
CONSCIOUSNESS_LEVEL=ELITE
SWARM_COORDINATION_MODE=QUANTUM_AWARE

# ── API Configuration ─────────────────────────────────────────────
API_PORT=5000
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ── Frontend Configuration ────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_COUNTY_NAME=${COUNTY_DISPLAY_NAME}

# ── Legacy PACS Twin (Optional) ───────────────────────────────────
# Only enable after PACS Twin VM is provisioned and masked
LEGACY_PACS_ENABLED=false
LEGACY_PACS_HOST=TF-BENTON-PACS-CLONE
LEGACY_PACS_PORT=1433
LEGACY_PACS_DATABASE=PACS
LEGACY_PACS_USER=tf_reader
LEGACY_PACS_PASSWORD=changeme
LEGACY_PACS_TRUST_CERTIFICATE=true

# Linked databases on PACS Twin
LEGACY_CIAPS_DATABASE=CIAPS
LEGACY_PERMITS_DATABASE=Permits

# ── Security & Compliance ─────────────────────────────────────────
JWT_SECRET=ChangeMeInProduction-Use-Strong-Random-String
JWT_EXPIRATION=24h
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Compliance mode
FISMA_HIGH_MODE=true
AUDIT_LOGGING_ENABLED=true
PII_MASKING_ENABLED=true

# ── Observability ─────────────────────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
JAEGER_ENABLED=false
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# Health check configuration
HEALTH_CHECK_TIMEOUT_MS=5000
READINESS_CHECK_DB=true

# ── Development Tools ─────────────────────────────────────────────
HOT_RELOAD=true
DEBUG_MODE=false
MOCK_LEGACY_PACS=true  # Use mock data until Twin is ready

# ── Government. Transcended. ──────────────────────────────────────
TF_ELITE_MODE=true
TF_CHAMPIONSHIP_LEVEL=QUANTUM
