<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>TerraFusion.ico</ApplicationIcon>
    <AssemblyName>TerraFusion</AssemblyName>
    <RootNamespace>TerraFusion.Launcher</RootNamespace>
    <Company>TerraFusion</Company>
    <Product>TerraFusion County OS</Product>
    <Version>0.1.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Government. Transcended. 379,000,000× Faster.</Description>
    <Copyright>Copyright © TerraFusion 2025</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.manifest" />
    <Content Include="TerraFusion.ico" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>