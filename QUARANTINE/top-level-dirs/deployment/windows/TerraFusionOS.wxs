<?xml version='1.0' encoding='windows-1252'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  
  <!-- Product Information -->
  <Product Name='TerraFusion OS - Government Edition' 
           Id='*' 
           UpgradeCode='12345678-1234-1234-1234-123456789012'
           Language='1033' 
           Codepage='1252' 
           Version='1.0.0' 
           Manufacturer='TerraFusion Technologies'>

    <Package Id='*' 
             Keywords='Government OS, AI, Property Assessment' 
             Description="TerraFusion OS - Complete Government Operating System"
             Comments='Professional Government Desktop Application with AI Integration'
             Manufacturer='TerraFusion Technologies' 
             InstallerVersion='100' 
             Languages='1033' 
             Compressed='yes' 
             SummaryCodepage='1252' />

    <!-- Installation Media -->
    <MediaTemplate EmbedCab="yes" />
    
    <!-- Installation Directory Structure -->
    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFilesFolder' Name='PFiles'>
        <Directory Id='CompanyFolder' Name='TerraFusion Technologies'>
          <Directory Id='INSTALLDIR' Name='TerraFusion OS'>
            
            <!-- Main Application Files -->
            <Component Id='MainExecutable' Guid='*'>
              <File Id='TerraFusionOSExe' 
                    Name='TerraFusion Government OS.exe' 
                    Source='../../dist/TerraFusion Government OS.exe' 
                    KeyPath='yes'>
                    
                <!-- Desktop Shortcut -->
                <Shortcut Id="DesktopShortcut" 
                         Directory="DesktopFolder" 
                         Name="TerraFusion Government OS" 
                         WorkingDirectory="INSTALLDIR" 
                         Icon="TerraFusionIcon.exe" 
                         IconIndex="0" 
                         Advertise="yes" />
                         
                <!-- Start Menu Shortcut -->
                <Shortcut Id="StartMenuShortcut" 
                         Directory="ProgramMenuFolder" 
                         Name="TerraFusion Government OS" 
                         WorkingDirectory="INSTALLDIR" 
                         Icon="TerraFusionIcon.exe" 
                         IconIndex="0" 
                         Advertise="yes" />
              </File>
            </Component>
            
            <!-- Backend Services -->
            <Component Id='BackendServices' Guid='*'>
              <File Id='TerraFusionAPI' 
                    Name='TerraFusion.API.exe' 
                    Source='../../dist/backend/TerraFusion.API.exe' 
                    KeyPath='yes' />
            </Component>
            
            <!-- Database Files -->
            <Component Id='DatabaseFiles' Guid='*'>
              <File Id='BentonCountyDB' 
                    Name='benton-county.db' 
                    Source='../../backend/data/benton-county.db' 
                    KeyPath='yes' />
            </Component>
            
            <!-- AI Models -->
            <Component Id='AIModels' Guid='*'>
              <File Id='AIModelsConfig' 
                    Name='ai-models-config.json' 
                    Source='../../backend/ai-models/config.json' 
                    KeyPath='yes' />
            </Component>
            
          </Directory>
        </Directory>
      </Directory>
      
      <!-- Shortcuts Folders -->
      <Directory Id="ProgramMenuFolder" Name="Programs" />
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- Features (what gets installed) -->
    <Feature Id='Complete' Title='TerraFusion OS Complete' Level='1'>
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='BackendServices' />
      <ComponentRef Id='DatabaseFiles' />
      <ComponentRef Id='AIModels' />
    </Feature>

    <!-- Application Icon -->
    <Icon Id="TerraFusionIcon.exe" SourceFile="../../assets/terrafusion-icon.ico" />
    
    <!-- Add/Remove Programs Icon -->
    <Property Id="ARPPRODUCTICON" Value="TerraFusionIcon.exe" />
    
    <!-- Installation Properties -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    
    <!-- Professional UI -->
    <UIRef Id="WixUI_InstallDir" />
    
    <!-- License Agreement -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    
    <!-- Custom Actions for Service Registration -->
    <CustomAction Id='RegisterServices' 
                  ExeCommand='[INSTALLDIR]TerraFusion.API.exe install' 
                  Directory='INSTALLDIR' 
                  Execute='deferred' 
                  Return='check' />
                  
    <InstallExecuteSequence>
      <Custom Action='RegisterServices' Before='StartServices'>NOT Installed</Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>