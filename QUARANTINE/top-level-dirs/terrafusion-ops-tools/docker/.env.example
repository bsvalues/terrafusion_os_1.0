# TerraFusion Docker Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
DB_NAME=terrafusion_production
DB_USER=terrafusion_user
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
DB_PORT=5432

# Redis Configuration
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_MAX_MEMORY=512mb

# Application Configuration
APP_ENV=production
SECRET_KEY=CHANGE_THIS_SECRET_KEY_TO_RANDOM_STRING
CORS_ORIGINS=http://localhost:3003,https://terrafusion.example.com

# Service Ports
BACKEND_PORT=8080
AI_ENGINE_PORT=8001
FRONTEND_PORT=3003
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# AI Engine Configuration
AI_ENGINE_MEMORY=4G
AI_ENGINE_MEMORY_RESERVED=2G
NVIDIA_VISIBLE_DEVICES=all

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8080
REACT_APP_AI_URL=http://localhost:8001

# Monitoring Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD
GRAFANA_PLUGINS=grafana-clock-panel,grafana-piechart-panel

# Backup Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BACKUP_BUCKET=terrafusion-backups

# OpenTelemetry Configuration (optional)
OTEL_ENDPOINT=http://otel-collector:4317