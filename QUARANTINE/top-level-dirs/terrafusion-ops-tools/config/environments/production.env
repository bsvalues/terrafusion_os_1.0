# TerraFusion Production Environment Configuration
# This file contains environment-specific settings for the production environment

# Environment Information
ENVIRONMENT=production
PROJECT_NAME=terrafusion
AWS_REGION=us-west-2
DEPLOYMENT_STAGE=prod

# Database Configuration
DATABASE_HOST=terrafusion-production-postgres.cluster-xyz.us-west-2.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=terrafusion_production
DATABASE_USER=terrafusion_prod_user
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=25
DATABASE_TIMEOUT=60
DATABASE_LOG_QUERIES=false

# Redis Configuration
REDIS_HOST=terrafusion-production-redis.abc123.cache.amazonaws.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_TIMEOUT=5
REDIS_SSL=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=8
API_DEBUG=false
API_LOG_LEVEL=WARN
API_CORS_ORIGINS=https://terrafusion.com,https://admin.terrafusion.com
API_RATE_LIMIT=10000
API_RATE_LIMIT_WINDOW=3600

# AI Engine Configuration
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8001
AI_ENGINE_WORKERS=4
AI_ENGINE_DEBUG=false
AI_ENGINE_MODEL_CACHE_SIZE=2048
AI_ENGINE_PREDICTION_TIMEOUT=60
AI_ENGINE_LOG_LEVEL=WARN

# Frontend Configuration
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3003
FRONTEND_API_URL=https://api.terrafusion.com
FRONTEND_WS_URL=wss://api.terrafusion.com
FRONTEND_DEBUG=false
FRONTEND_HOT_RELOAD=false

# Authentication Configuration
JWT_SECRET_KEY=production-jwt-secret-from-ssm
JWT_EXPIRATION=86400
JWT_ALGORITHM=HS256
SESSION_TIMEOUT=14400
PASSWORD_MIN_LENGTH=12
ENABLE_2FA=true

# Logging Configuration
LOG_LEVEL=WARN
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/terrafusion/app.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30
ENABLE_STRUCTURED_LOGGING=true

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=15
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://jaeger-collector:14268/api/traces

# Storage Configuration
FILE_UPLOAD_MAX_SIZE=500MB
FILE_UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,csv,xlsx,zip,doc,docx
FILE_STORAGE_BACKEND=s3
FILE_STORAGE_PATH=/tmp/terrafusion/uploads
S3_BUCKET_NAME=terrafusion-production-assets
S3_REGION=us-west-2

# Email Configuration
EMAIL_BACKEND=ses
SMTP_HOST=email-smtp.us-west-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=production-smtp-user
SMTP_PASSWORD=production-smtp-password-from-ssm
SMTP_TLS=true
EMAIL_FROM=noreply@terrafusion.com
EMAIL_ADMIN=admin@terrafusion.com

# Cache Configuration
CACHE_BACKEND=redis
CACHE_DEFAULT_TIMEOUT=1800
CACHE_KEY_PREFIX=terrafusion:prod
ENABLE_CACHE_COMPRESSION=true
CACHE_MAX_ENTRIES=100000

# Security Configuration
SECURITY_LEVEL=high
ENABLE_CSRF_PROTECTION=true
ENABLE_XSS_PROTECTION=true
ENABLE_CONTENT_TYPE_SNIFFING=false
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=63072000
ENABLE_RATE_LIMITING=true
FAILED_LOGIN_ATTEMPTS_LIMIT=3
ACCOUNT_LOCKOUT_DURATION=1800

# Development Tools (all disabled in production)
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILER=false
ENABLE_QUERY_LOGGING=false
ENABLE_MOCK_SERVICES=false
MOCK_AI_RESPONSES=false
ENABLE_FIXTURES=false

# Feature Flags
FEATURE_NEW_DASHBOARD=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_EXPORT_FUNCTIONALITY=true
FEATURE_BETA_FEATURES=false
FEATURE_EXPERIMENTAL_UI=false

# Testing Configuration (disabled in production)
ENABLE_TEST_MODE=false
TEST_DATABASE_NAME=
TEST_REDIS_DB=
LOAD_TEST_DATA=false
ENABLE_MOCK_PAYMENTS=false

# Performance Configuration
ENABLE_GZIP_COMPRESSION=true
STATIC_FILE_CACHING=true
API_RESPONSE_CACHING=true
DATABASE_QUERY_CACHING=true
ASYNC_TASK_QUEUE=celery
CELERY_BROKER_URL=redis://terrafusion-production-redis.abc123.cache.amazonaws.com:6379/2

# Production Features
AUTO_RELOAD=false
HOT_MODULE_REPLACEMENT=false
SOURCE_MAPS=false
MINIFY_ASSETS=true
BUNDLE_ANALYZER=false
DEV_SERVER_PROXY=false

# Container Configuration
CONTAINER_MEMORY_LIMIT=2Gi
CONTAINER_CPU_LIMIT=2000m
CONTAINER_MEMORY_REQUEST=1Gi
CONTAINER_CPU_REQUEST=1000m

# Kubernetes Configuration
K8S_NAMESPACE=terrafusion-production
K8S_CONTEXT=production-cluster
K8S_SERVICE_TYPE=ClusterIP
K8S_INGRESS_CLASS=alb
HELM_CHART_VERSION=1.0.0

# External Services Configuration
WEATHER_API_KEY=production-weather-api-key-from-ssm
MAPS_API_KEY=production-maps-api-key-from-ssm
ANALYTICS_API_KEY=production-analytics-api-key-from-ssm
PAYMENT_GATEWAY_URL=https://api.payment.example.com
NOTIFICATION_SERVICE_URL=https://notifications.terrafusion.com

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=90
BACKUP_S3_BUCKET=terrafusion-production-backups
BACKUP_ENCRYPTION=true

# Compliance Configuration
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=2555
AUDIT_LOGGING=true
ENCRYPTION_AT_REST=true
ENCRYPTION_IN_TRANSIT=true

# Resource Limits
MAX_REQUEST_SIZE=1GB
MAX_CONCURRENT_REQUESTS=2000
CONNECTION_POOL_SIZE=100
WORKER_MEMORY_LIMIT=2048MB
WORKER_CPU_LIMIT=4.0

# Production URLs
API_BASE_URL=https://api.terrafusion.com/api/v1
FRONTEND_BASE_URL=https://terrafusion.com
ADMIN_PANEL_URL=https://admin.terrafusion.com
DOCS_URL=https://api.terrafusion.com/docs
SWAGGER_URL=https://api.terrafusion.com/swagger

# Load Balancer Configuration
ALB_SCHEME=internet-facing
ALB_SUBNETS=subnet-prod-1,subnet-prod-2,subnet-prod-3
ALB_SECURITY_GROUPS=sg-production-alb
ALB_CERTIFICATE_ARN=arn:aws:acm:us-west-2:account:certificate/production-cert-id

# Auto Scaling Configuration
AUTO_SCALING_ENABLED=true
MIN_REPLICAS=5
MAX_REPLICAS=20
TARGET_CPU_UTILIZATION=60
TARGET_MEMORY_UTILIZATION=70
SCALE_UP_COOLDOWN=180
SCALE_DOWN_COOLDOWN=300

# High Availability Configuration
MULTI_AZ_ENABLED=true
CROSS_AZ_LOAD_BALANCING=true
AVAILABILITY_ZONES=us-west-2a,us-west-2b,us-west-2c
FAILOVER_ENABLED=true
DISASTER_RECOVERY_ENABLED=true

# Monitoring and Alerting
CLOUDWATCH_LOG_GROUP=/aws/ecs/terrafusion-production
CLOUDWATCH_LOG_STREAM=app
PROMETHEUS_NAMESPACE=terrafusion-production
GRAFANA_DASHBOARD_ID=production-dashboard
ALERT_MANAGER_URL=https://alerts.terrafusion.com

# Database Performance (optimized for production)
DATABASE_MAX_CONNECTIONS=200
DATABASE_STATEMENT_TIMEOUT=120000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT=60000
DATABASE_SHARED_BUFFERS=1GB
DATABASE_EFFECTIVE_CACHE_SIZE=4GB
DATABASE_WORK_MEM=256MB
DATABASE_MAINTENANCE_WORK_MEM=512MB

# Redis Performance (optimized for production)
REDIS_MAX_MEMORY=2gb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_TIMEOUT=60
REDIS_TCP_KEEPALIVE=300
REDIS_SAVE_SCHEDULE=900 1 300 10 60 10000

# CDN Configuration
CDN_ENABLED=true
CDN_DOMAIN=cdn.terrafusion.com
CDN_CACHE_POLICY=production-cache-policy
STATIC_FILES_CDN=true
API_RESPONSES_CDN=true
CDN_CACHE_TTL=86400

# SSL/TLS Configuration (strict production settings)
TLS_VERSION=1.3
SSL_CIPHERS=ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:DHE+CHACHA20:!aNULL:!MD5:!DSS:!3DES
HSTS_MAX_AGE=63072000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Error Handling
ERROR_TRACKING_DSN=https://production-sentry-dsn@sentry.io/project
ERROR_TRACKING_ENVIRONMENT=production
ERROR_SAMPLE_RATE=0.01
ENABLE_ERROR_NOTIFICATIONS=true
ERROR_NOTIFICATION_SLACK=https://hooks.slack.com/production-webhook
ERROR_NOTIFICATION_EMAIL=alerts@terrafusion.com

# Data Pipeline Configuration
ETL_SCHEDULE=0 3 * * *
DATA_WAREHOUSE_URL=production-redshift.cluster.amazonaws.com
DATA_EXPORT_S3_BUCKET=terrafusion-production-exports
ANALYTICS_PROCESSING_ENABLED=true
DATA_ARCHIVAL_ENABLED=true
DATA_ARCHIVAL_SCHEDULE=0 1 1 * *

# Third-party Integrations (production keys)
STRIPE_PUBLISHABLE_KEY=pk_live_production_key
STRIPE_SECRET_KEY=sk_live_production_key_from_ssm
SENDGRID_API_KEY=production-sendgrid-key-from-ssm
TWILLIO_ACCOUNT_SID=production-twilio-sid-from-ssm
GOOGLE_ANALYTICS_ID=GA-PRODUCTION-123456

# Version Information
APP_VERSION=1.0.0
BUILD_NUMBER=${BUILD_NUMBER:-unknown}
GIT_COMMIT=${GIT_COMMIT:-unknown}
BUILD_DATE=${BUILD_DATE:-unknown}

# Health Check Configuration
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_TIMEOUT=5
READINESS_PROBE_PATH=/ready
LIVENESS_PROBE_PATH=/alive
STARTUP_PROBE_PATH=/startup
HEALTH_CHECK_GRACE_PERIOD=90

# Graceful Shutdown
SHUTDOWN_TIMEOUT=60
GRACEFUL_SHUTDOWN_ENABLED=true
DRAIN_CONNECTIONS_TIMEOUT=30
PREEMPTION_GRACE_PERIOD=300

# Regional Configuration
PRIMARY_REGION=us-west-2
BACKUP_REGION=us-east-1
MULTI_REGION_ENABLED=true
CROSS_REGION_REPLICATION=true
GLOBAL_LOAD_BALANCING=true

# Compliance and Audit
SOC2_COMPLIANCE=true
HIPAA_COMPLIANCE=false
PCI_COMPLIANCE=true
AUDIT_LOG_RETENTION=2557
COMPLIANCE_MONITORING=true
DATA_CLASSIFICATION=confidential

# Business Continuity
RTO_TARGET=300
RPO_TARGET=3600
BACKUP_TESTING_SCHEDULE=0 4 * * 1
DISASTER_RECOVERY_TESTING_SCHEDULE=0 2 1 */3 *
BUSINESS_CONTINUITY_PLAN=enabled

# Network Security
WAF_ENABLED=true
DDoS_PROTECTION=true
IP_WHITELIST_ENABLED=false
GEO_BLOCKING_ENABLED=false
BOT_PROTECTION=true
INTRUSION_DETECTION=true

# Data Protection
DATA_ENCRYPTION_ALGORITHM=AES-256-GCM
KEY_ROTATION_SCHEDULE=0 0 1 */3 *
BACKUP_ENCRYPTION=true
LOG_ENCRYPTION=true
SECRETS_ENCRYPTION=true
DATABASE_ENCRYPTION=true

# Performance Monitoring
APM_ENABLED=true
SYNTHETIC_MONITORING=true
REAL_USER_MONITORING=true
PERFORMANCE_BUDGET_ENABLED=true
CORE_WEB_VITALS_MONITORING=true

# Cost Optimization
COST_MONITORING=true
RESOURCE_TAGGING=comprehensive
RESERVED_INSTANCES=enabled
SPOT_INSTANCES=limited
AUTOMATED_SCALING=true
COST_ALERTS=enabled

# Environment-specific Secrets (loaded from AWS Systems Manager)
# These values reference SSM parameters and will be resolved at runtime
DATABASE_URL=ssm:///terrafusion/production/database/url
REDIS_URL=ssm:///terrafusion/production/redis/url
SECRET_KEY=ssm:///terrafusion/production/app/secret_key
JWT_SECRET=ssm:///terrafusion/production/jwt/secret
STRIPE_SECRET=ssm:///terrafusion/production/stripe/secret_key
SENDGRID_API_KEY_SECRET=ssm:///terrafusion/production/sendgrid/api_key
TWILIO_AUTH_TOKEN=ssm:///terrafusion/production/twilio/auth_token

# Emergency Contacts
ONCALL_PHONE=+1-555-ONCALL
ESCALATION_EMAIL=escalation@terrafusion.com
INCIDENT_WEBHOOK=https://hooks.slack.com/incident-webhook
PAGERDUTY_TOKEN=ssm:///terrafusion/production/pagerduty/token