# TerraFusion Development Environment Configuration
# This file contains environment-specific settings for the development environment

# Environment Information
ENVIRONMENT=development
PROJECT_NAME=terrafusion
AWS_REGION=us-west-2
DEPLOYMENT_STAGE=dev

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=terrafusion_development
DATABASE_USER=terrafusion_dev_user
DATABASE_SSL_MODE=prefer
DATABASE_POOL_SIZE=5
DATABASE_TIMEOUT=30
DATABASE_LOG_QUERIES=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=5
REDIS_SSL=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=2
API_DEBUG=true
API_LOG_LEVEL=DEBUG
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3003
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=3600

# AI Engine Configuration
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8001
AI_ENGINE_WORKERS=1
AI_ENGINE_DEBUG=true
AI_ENGINE_MODEL_CACHE_SIZE=512
AI_ENGINE_PREDICTION_TIMEOUT=30
AI_ENGINE_LOG_LEVEL=DEBUG

# Frontend Configuration
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3003
FRONTEND_API_URL=http://localhost:8080
FRONTEND_WS_URL=ws://localhost:8080
FRONTEND_DEBUG=true
FRONTEND_HOT_RELOAD=true

# Authentication Configuration
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_EXPIRATION=86400
JWT_ALGORITHM=HS256
SESSION_TIMEOUT=3600
PASSWORD_MIN_LENGTH=8
ENABLE_2FA=false

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=detailed
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/terrafusion/app.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=7
ENABLE_STRUCTURED_LOGGING=true

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Storage Configuration
FILE_UPLOAD_MAX_SIZE=50MB
FILE_UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,csv,xlsx
FILE_STORAGE_BACKEND=local
FILE_STORAGE_PATH=/tmp/terrafusion/uploads
S3_BUCKET_NAME=terrafusion-dev-assets
S3_REGION=us-west-2

# Email Configuration
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
EMAIL_FROM=noreply@terrafusion-dev.local
EMAIL_ADMIN=admin@terrafusion-dev.local

# Cache Configuration
CACHE_BACKEND=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=terrafusion:dev
ENABLE_CACHE_COMPRESSION=false
CACHE_MAX_ENTRIES=10000

# Security Configuration
SECURITY_LEVEL=low
ENABLE_CSRF_PROTECTION=false
ENABLE_XSS_PROTECTION=true
ENABLE_CONTENT_TYPE_SNIFFING=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
ENABLE_RATE_LIMITING=true
FAILED_LOGIN_ATTEMPTS_LIMIT=10
ACCOUNT_LOCKOUT_DURATION=300

# Development Tools
ENABLE_DEBUG_TOOLBAR=true
ENABLE_PROFILER=true
ENABLE_QUERY_LOGGING=true
ENABLE_MOCK_SERVICES=true
MOCK_AI_RESPONSES=true
ENABLE_FIXTURES=true

# Feature Flags
FEATURE_NEW_DASHBOARD=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_EXPORT_FUNCTIONALITY=true
FEATURE_BETA_FEATURES=true
FEATURE_EXPERIMENTAL_UI=true

# Testing Configuration
ENABLE_TEST_MODE=false
TEST_DATABASE_NAME=terrafusion_test
TEST_REDIS_DB=1
LOAD_TEST_DATA=true
ENABLE_MOCK_PAYMENTS=true

# Performance Configuration
ENABLE_GZIP_COMPRESSION=true
STATIC_FILE_CACHING=false
API_RESPONSE_CACHING=false
DATABASE_QUERY_CACHING=false
ASYNC_TASK_QUEUE=celery
CELERY_BROKER_URL=redis://localhost:6379/2

# Development-specific Features
AUTO_RELOAD=true
HOT_MODULE_REPLACEMENT=true
SOURCE_MAPS=true
MINIFY_ASSETS=false
BUNDLE_ANALYZER=false
DEV_SERVER_PROXY=true

# Docker Configuration
DOCKER_COMPOSE_FILE=docker-compose.dev.yml
DOCKER_NETWORK=terrafusion-dev-network
DOCKER_LOG_DRIVER=json-file
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# Kubernetes Configuration (for local k8s development)
K8S_NAMESPACE=terrafusion-dev
K8S_CONTEXT=docker-desktop
K8S_SERVICE_TYPE=ClusterIP
K8S_INGRESS_CLASS=nginx
HELM_CHART_VERSION=0.1.0

# External Services Configuration
WEATHER_API_KEY=dev-weather-api-key
MAPS_API_KEY=dev-maps-api-key
ANALYTICS_API_KEY=dev-analytics-api-key
PAYMENT_GATEWAY_URL=https://sandbox.payment.example.com
NOTIFICATION_SERVICE_URL=http://localhost:8002

# Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=terrafusion-dev-backups
BACKUP_ENCRYPTION=false

# Compliance Configuration
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=365
AUDIT_LOGGING=false
ENCRYPTION_AT_REST=false
ENCRYPTION_IN_TRANSIT=true

# Resource Limits
MAX_REQUEST_SIZE=100MB
MAX_CONCURRENT_REQUESTS=100
CONNECTION_POOL_SIZE=10
WORKER_MEMORY_LIMIT=512MB
WORKER_CPU_LIMIT=1.0

# Development URLs
API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_BASE_URL=http://localhost:3003
ADMIN_PANEL_URL=http://localhost:8080/admin
DOCS_URL=http://localhost:8080/docs
SWAGGER_URL=http://localhost:8080/swagger

# Debugging and Profiling
ENABLE_SQL_DEBUGGING=true
ENABLE_PERFORMANCE_PROFILING=true
MEMORY_PROFILING=false
CPU_PROFILING=false
ENABLE_REQUEST_LOGGING=true
LOG_SLOW_QUERIES=true
SLOW_QUERY_TIMEOUT=1.0

# Local Development Services
LOCAL_POSTGRES=true
LOCAL_REDIS=true
LOCAL_ELASTICSEARCH=false
LOCAL_RABBITMQ=false
LOCAL_MAILCATCHER=true

# Version Information
APP_VERSION=0.1.0-dev
BUILD_NUMBER=local
GIT_COMMIT=unknown
BUILD_DATE=unknown

# Environment-specific Overrides
# These can be overridden in docker-compose.override.yml or local.env
DATABASE_URL=postgresql://terrafusion_dev_user:dev_password@localhost:5432/terrafusion_development
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-secret-key-change-in-production