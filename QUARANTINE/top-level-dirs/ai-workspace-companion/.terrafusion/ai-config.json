{
  "ai": {
    "openai": {
      "apiKey": "${OPENAI_API_KEY}",
      "model": "gpt-4-turbo-preview",
      "temperature": {
        "low": 0.1,
        "medium": 0.5,
        "high": 0.7,
        "critical": 0.1
      },
      "maxTokens": {
        "code-generation": 2000,
        "code-review": 1500,
        "test-generation": 2500,
        "refactoring": 1800,
        "problem-solving": 2200,
        "architecture": 3000,
        "compliance": 2000
      }
    },
    "local": {
      "endpoint": "${LOCAL_AI_ENDPOINT}",
      "model": "terrafusion-local-model",
      "timeout": 30000
    },
    "quantum": {
      "enabled": true,
      "algorithms": [
        "quantum-inspired-annealing",
        "quantum-walk-optimization",
        "quantum-fourier-transform",
        "quantum-approximation-algorithm"
      ],
      "optimizationFactor": 949,
      "performanceGain": 94.9
    }
  },
  "compliance": {
    "standards": ["FISMA", "NIST-800-53", "Section-508", "FedRAMP", "HIPAA"],
    "auditTrail": {
      "enabled": true,
      "retentionDays": 365,
      "logLevel": "detailed"
    },
    "validation": {
      "realTime": true,
      "criticalOnly": false,
      "autoRemediation": true
    }
  },
  "security": {
    "encryption": {
      "algorithm": "AES-256-GCM",
      "keyRotation": "30d"
    },
    "accessControl": {
      "rbac": true,
      "mfa": true,
      "sessionTimeout": "8h"
    },
    "audit": {
      "realTime": true,
      "alerts": true,
      "complianceReporting": true
    }
  },
  "terrafusion": {
    "ecosystem": {
      "aiSwarm": {
        "totalAgents": 1008,
        "coordinationModel": "hierarchical",
        "performanceMonitoring": true
      },
      "modules": {
        "total": 32,
        "hotSwappable": true,
        "marketplaceIntegration": true
      },
      "marketplace": {
        "enabled": true,
        "deploymentModel": "white-glove",
        "revenueModel": "subscription"
      }
    },
    "quantum": {
      "engine": {
        "enabled": true,
        "algorithms": ["annealing", "walk", "fourier", "approximation"],
        "optimizationTarget": "performance"
      },
      "performance": {
        "targetGain": 949,
        "successRate": 99.7,
        "monitoring": true
      }
    }
  },
  "workspace": {
    "detection": {
      "autoRootResolution": true,
      "markers": ["backend", "frontend", "modules", "terrafusion_os_1.0"],
      "validation": {
        "essentialFiles": ["package.json", "CLAUDE.md", "README.md"],
        "strictMode": true
      }
    },
    "monitoring": {
      "fileChanges": true,
      "gitIntegration": true,
      "healthChecks": {
        "interval": "30s",
        "alerts": true,
        "autoRecovery": true
      }
    }
  },
  "development": {
    "mode": "production",
    "verbose": false,
    "debug": false,
    "profiling": {
      "enabled": true,
      "metrics": ["performance", "memory", "cpu"]
    }
  }
}
