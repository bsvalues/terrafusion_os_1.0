{
  "name": "consciousness-client",
  "version": "1.0.0",
  "description": "TerraFusion AI Consciousness Dashboard - Elite Government Agent Interface",
  "scripts": {
    "dev": "vite --port 3005",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "check": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write src/**/*.{ts,tsx,css,json}",
    "consciousness:dev": "vite --port 3005 --host 0.0.0.0",
    "agent:monitor": "npm run dev -- --mode agent-monitoring",
    "swarm:visualize": "npm run dev -- --mode swarm-visualization",
    "quantum:dashboard": "npm run dev -- --mode quantum-optimization"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.1",
    "@react-three/drei": "^9.80.4",
    "@react-three/fiber": "^8.13.6",
    "@tanstack/react-query": "^4.33.0",
    "axios": "^1.5.0",
    "clsx": "^2.0.0",
    "d3": "^7.9.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.279.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.45.4",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "socket.io-client": "^4.7.2",
    "tailwind-merge": "^1.14.0",
    "three": "^0.155.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/lodash": "^4.14.196",
    "@types/node": "^20.5.9",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/three": "^0.155.1",
    "@types/uuid": "^9.0.3",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vitejs/plugin-react": "^4.0.4",
    "@vitest/ui": "^0.34.4",
    "autoprefixer": "^10.4.15",
    "c8": "^8.0.1",
    "eslint": "^8.48.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.29",
    "prettier": "^3.0.3",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.2.2",
    "vite": "^4.4.9",
    "vitest": "^0.34.4"
  },
  "keywords": [
    "ai-consciousness",
    "government-dashboard",
    "agent-visualization",
    "terrafusion",
    "quantum-ui",
    "swarm-coordination"
  ],
  "author": "TerraFusion Consciousness Interface Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
