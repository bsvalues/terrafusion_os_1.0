# Optional: Override API base URL (defaults to http://localhost:5000)
# VITE_API_BASE_URL=http://localhost:5000

# Optional: Enable Application Insights telemetry (disabled by default in dev/test)
# VITE_ENABLE_TELEMETRY=true
# VITE_APP_INSIGHTS_KEY=your-instrumentation-key-here

# Optional: Quantum optimization factor (defaults to 949)
# VITE_QUANTUM_FACTOR=949
