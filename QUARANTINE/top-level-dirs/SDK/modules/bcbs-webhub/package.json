{
  "name": "bcbs-webhub",
  "version": "1.0.0",
  "description": "TerraFusion Elite Business Correspondence & Building Services WebHub - Comprehensive building services and business correspondence management for government operations. Government. Transcended.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite --port 5016 --host",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview --port 5016",
    "type-check": "tsc --noEmit --skipLibCheck",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "quality": "npm run type-check && npm run lint && npm run format:check"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "@tanstack/react-query": "^5.60.5",
    "@tanstack/react-query-devtools": "^5.60.5",
    "recharts": "^2.13.3",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.453.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-popover": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "framer-motion": "^11.11.11",
    "react-hook-form": "^7.53.2",
    "@hookform/resolvers": "^3.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.4",
    "@vitest/ui": "^2.1.4",
    "jsdom": "^25.0.1"
  },
  "keywords": [
    "terrafusion",
    "government",
    "building-services",
    "business-correspondence",
    "permits",
    "inspections",
    "code-enforcement",
    "react",
    "typescript",
    "vite",
    "government-transcended"
  ],
  "author": "TerraFusion Elite Government OS Engineering Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/terrafusion-os.git",
    "directory": "SDK/modules/bcbs-webhub"
  },
  "homepage": "https://terrafusionmarket.com/modules/bcbs-webhub",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
