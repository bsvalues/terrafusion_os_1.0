{
  "name": "terra-levy-module",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "quality": "npm run type-check && npm run test",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "validate": "npm run quality && npm run audit:security",
    "precommit": "npm run quality"
  },
  "devDependencies": {
    "@microsoft/applicationinsights-web": "^3.3.10",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.6",
    "@types/react-dom": "^18.3.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^25.0.1",
    "msw": "^2.3.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.1"
  }
}
