{
  "folders": [
    { "path": "../marketplace", "name": "🏪 Marketplace Platform" },
    { "path": "../marketplace/government-edition", "name": "🏛️ Government Edition" },
    { "path": "../SDK", "name": "📦 Module SDK" },
    { "path": "../config", "name": "⚙️ Configuration" },
    { "path": "../tests", "name": "🧪 Marketplace Tests" },
    { "path": "../docs", "name": "📚 Marketplace Docs" }
  ],
  "settings": {
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#9575CD",
      "titleBar.activeForeground": "#FFFFFF"
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/backend": true,
      "**/frontend": true,
      "**/terrabuild-modernization": true
    },
    "search.exclude": {
      "**/backend": true,
      "**/frontend": true,
      "**/node_modules": true
    },
    "terrafusion.role": "marketplace_development",
    "terrafusion.responsibility": "module_marketplace"
  },
  "extensions": {
    "recommendations": [
      // TypeScript & Frontend
      "ms-vscode.vscode-typescript-next",
      "bradlc.vscode-tailwindcss",
      "dsznajder.es7-react-js-snippets",
      "wix.vscode-import-cost",

      // Testing & E2E
      "ms-playwright.playwright",
      "orta.vscode-jest",
      "vitest.explorer",

      // API & OpenAPI
      "42crunch.vscode-openapi",
      "swagger-viewer.swagger-viewer",

      // Docs & Markdown
      "yzhang.markdown-all-in-one",
      "bierner.markdown-mermaid",
      "shd101wyy.markdown-preview-enhanced",

      // DevOps & CI
      "github.vscode-github-actions",
      "ms-azuretools.vscode-docker",

      // Module SDK Integration
      "gruntfuggly.todo-tree",
      "eamodio.gitlens",
      "mhutchie.git-graph",

      // Security & Compliance
      "snyk-security.snyk-vulnerability-scanner",

      // Productivity
      "christian-kohler.path-intellisense",
      "yurivictor.multi-cursor-case-preserve",
      "github.copilot",
      "github.copilot-chat"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🔧 Build: Marketplace Frontend",
        "type": "shell",
        "command": "npm run build",
        "options": { "cwd": "${workspaceFolder}/../marketplace" },
        "group": { "kind": "build", "isDefault": true }
      },
      {
        "label": "🧪 Test: Marketplace Tests",
        "type": "shell",
        "command": "npm run test",
        "options": { "cwd": "${workspaceFolder}/../marketplace" },
        "group": "test"
      },
      {
        "label": "📚 Storybook: Start",
        "type": "shell",
        "command": "npm run storybook",
        "options": { "cwd": "${workspaceFolder}/../marketplace" },
        "isBackground": true
      },
      {
        "label": "📦 Publish: Marketplace Module",
        "type": "shell",
        "command": "./scripts/publish-module.sh",
        "options": { "cwd": "${workspaceFolder}/../marketplace" }
      },
      {
        "label": "🔒 Security: Audit Dependencies",
        "type": "shell",
        "command": "npm audit --audit-level=moderate || true",
        "options": { "cwd": "${workspaceFolder}/../marketplace" },
        "group": "test"
      },
      {
        "label": "🧹 Clean: Marketplace Artifacts",
        "type": "shell",
        "command": "rm -rf ../marketplace/dist ../marketplace/.cache",
        "options": { "cwd": "${workspaceFolder}" }
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug: Marketplace Frontend (Chrome)",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder}/../marketplace",
        "preLaunchTask": "🔧 Build: Marketplace Frontend"
      },
      {
        "name": "Debug: Marketplace Tests",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "test"],
        "cwd": "${workspaceFolder}/../marketplace"
      }
    ]
  }
}
