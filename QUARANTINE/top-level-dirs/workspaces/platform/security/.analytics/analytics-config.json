{
  "analytics": {
    "tier": "CRITICAL",
    "level": "enterprise",
    "enabled": true
  },
  "predictive_analytics": {
    "enabled": true,
    "features": [
      "threat-intelligence",
      "vulnerability-likelihood",
      "breach-risk"
    ],
    "prediction_window_days": 30,
    "confidence_threshold": 0.75,
    "update_frequency_hours": 6,
    "models": ["classification", "anomaly", "clustering"]
  },
  "anomaly_detection": {
    "enabled": true,
    "detectors": [
      "security-anomalies",
      "protocol-violations",
      "threat-patterns"
    ],
    "sensitivity": "high",
    "real_time": true,
    "batch_window_hours": 1,
    "alert_on_detection": true,
    "historical_baseline_days": 90
  },
  "data_management": {
    "retention_days": 2555,
    "archival_days": 2920,
    "compression": "gzip",
    "encryption": "AES-256",
    "backup_frequency": "hourly",
    "daily_volume_gb": 2000
  },
  "ml_infrastructure": {
    "frameworks": ["scikit-learn", "tensorflow", "xgboost"],
    "gpu_enabled": true,
    "distributed_training": true,
    "model_registry": "enabled",
    "experiment_tracking": "enabled",
    "hyperparameter_optimization": true
  },
  "optimization": {
    "auto_scaling": {
      "enabled": true,
      "metrics": ["cpu", "memory", "request_latency"],
      "target_utilization": 70,
      "scale_up_threshold": 80,
      "scale_down_threshold": 30,
      "cooldown_minutes": 5
    },
    "cost_optimization": {
      "enabled": true,
      "target_savings_percent": 20,
      "review_frequency_days": 7
    },
    "performance_optimization": {
      "enabled": true,
      "target_p99_latency_ms": 500,
      "target_error_rate": 0.001
    }
  },
  "monitoring": {
    "metrics_collection": true,
    "metrics_retention_days": 365,
    "dashboards_enabled": true,
    "alerts_enabled": true,
    "sla_tracking": true
  },
  "compliance": {
    "gdpr_compliant": true,
    "hipaa_compliant": false,
    "fed_ramp_compliant": true,
    "audit_logging": true,
    "data_lineage_tracking": true
  }
}
