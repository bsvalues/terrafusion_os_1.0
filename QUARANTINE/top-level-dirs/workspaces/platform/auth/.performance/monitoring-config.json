{
  "workspace": "auth",
  "risk_level": "CRITICAL",
  "monitoring": {
    "sla": {
      "uptime_target": 99.99,
      "response_time_p95_ms": 50,
      "response_time_p99_ms": 100,
      "max_error_rate": 0.01,
      "throughput_target": "500 req/sec"
    },
    "collection": {
      "interval_seconds": 30,
      "retention_days": 90,
      "aggregation_periods": ["1m", "5m", "15m", "1h", "1d"]
    },
    "metrics": [
      "request_count",
      "response_time",
      "error_rate",
      "throughput",
      "cpu_usage",
      "memory_usage",
      "database_connections",
      "cache_hit_rate",
      "authentication_latency",
      "api_gateway_latency"
    ]
  },
  "alerts": {
    "priority": "CRITICAL",
    "escalation_minutes": [1, 5, 10],
    "rules": [
      {
        "metric": "response_time_p95",
        "threshold": 60.0,
        "severity": "warning"
      },
      {
        "metric": "response_time_p95",
        "threshold": 75.0,
        "severity": "critical"
      },
      {
        "metric": "error_rate",
        "threshold": 0.015,
        "severity": "warning"
      },
      {
        "metric": "error_rate",
        "threshold": 0.02,
        "severity": "critical"
      },
      {
        "metric": "uptime",
        "threshold": 98.9901,
        "severity": "warning"
      },
      {
        "metric": "uptime",
        "threshold": 94.9905,
        "severity": "critical"
      }
    ]
  },
  "dashboards": {
    "real_time": true,
    "refresh_interval_seconds": 10,
    "views": ["overview", "performance", "sla", "alerts", "optimization"]
  }
}
