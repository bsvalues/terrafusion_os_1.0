{
  "ai_autonomy": {
    "enabled": true,
    "level": "full",
    "models": ["threat-detector", "response-engine", "healing-engine"]
  },
  "autonomous_capabilities": {
    "decision_making": false,
    "workflow_automation": false,
    "code_generation": false,
    "self_healing": true,
    "predictive_actions": true,
    "anomaly_response": true
  },
  "llm_integration": {
    "enabled": false,
    "models": ["gpt-4", "claude-opus", "llama-2"],
    "code_generation": false,
    "document_analysis": true,
    "natural_language_processing": true,
    "context_window": 8000,
    "temperature": 0.7
  },
  "autonomous_decision_engine": {
    "enabled": true,
    "confidence_threshold": 0.99,
    "decision_types": ["optimization", "scaling", "remediation", "routing"],
    "max_decisions_per_hour": 100,
    "human_review_required": true,
    "audit_logging": true
  },
  "autonomous_healing": {
    "enabled": true,
    "heal_strategies": [
      "auto-restart",
      "auto-scale",
      "auto-failover",
      "config-correction",
      "dependency-restart"
    ],
    "max_heal_attempts": 3,
    "heal_cooldown_minutes": 5,
    "manual_override_enabled": true
  },
  "code_generation": {
    "enabled": false,
    "generation_types": [
      "bug-fixes",
      "optimization",
      "refactoring",
      "test-generation",
      "documentation"
    ],
    "review_required": true,
    "auto_commit": false,
    "quality_gate": 0.95
  },
  "ai_assistant": {
    "enabled": true,
    "types": ["coding", "troubleshooting", "optimization"],
    "conversational": true,
    "context_aware": true,
    "learning_enabled": true
  },
  "guardrails": {
    "cost_limit_per_day": 1000,
    "action_limit": "immediate",
    "escalation_required": true,
    "rollback_enabled": true,
    "audit_trail": true
  }
}
