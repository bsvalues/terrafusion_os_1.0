<?xml version="1.0" encoding="utf-8"?>
<S57ISO8211>
  <fielddefs>
	<field label="0001" description="ISO/IEC 8211 Record Identifier" dsc="elementary" dtc ="bit_string" format="(b12)"/>
	<field prsp="CAT" label="0001" description="ISO/IEC 8211 Record Identifier" dsc="elementary" dtc ="implicit_point" format="(I(5))"/>
	<field label="DSID" description="Data set identification field" dsc="vector" dtc ="mixed_data" format="">
	  <subfield label="RCNM" format="b11"/>
	  <subfield label="RCID" format="b14"/>
	  <subfield label="EXPP" format="b11"/>
	  <subfield label="INTU" format="b11"/>
	  <subfield label="DSNM" format="A"/>
	  <subfield label="EDTN" format="A"/>
	  <subfield label="UPDN" format="A"/>
	  <subfield label="UADT" format="A(8)"/>
	  <subfield label="ISDT" format="A(8)"/>
	  <subfield label="STED" format="R(4)"/>
	  <subfield label="PRSP" format="b11"/>
	  <subfield label="PSDN" format="A"/>
	  <subfield label="PRED" format="A"/>
	  <subfield label="PROF" format="b11"/>
	  <subfield label="AGEN" format="b12"/>
	  <subfield label="COMT" format="A"/>
	</field>
	<field label="DSSI" description="Data set structure information field" dsc="vector" dtc ="mixed_data" format="">
	  <subfield label="DSTR" format="b11"/>
	  <subfield label="AALL" format="b11"/>
	  <subfield label="NALL" format="b11"/>
	  <subfield label="NOMR" format="b14"/>
	  <subfield label="NOCR" format="b14"/>
	  <subfield label="NOGR" format="b14"/>
	  <subfield label="NOLR" format="b14"/>
	  <subfield label="NOIN" format="b14"/>
	  <subfield label="NOCN" format="b14"/>
	  <subfield label="NOED" format="b14"/>
	  <subfield label="NOFA" format="b14"/>
	</field>
	<field label="DSPM" description="Data set parameter field" dsc="vector" dtc ="mixed_data" format="">
	  <subfield label="RCNM" format="b11"/>
	  <subfield label="RCID" format="b14"/>
	  <subfield label="HDAT" format="b11"/>
	  <subfield label="VDAT" format="b11"/>
	  <subfield label="SDAT" format="b11"/>
	  <subfield label="CSCL" format="b14"/>
	  <subfield label="DUNI" format="b11"/>
	  <subfield label="HUNI" format="b11"/>
	  <subfield label="PUNI" format="b11"/>
	  <subfield label="COUN" format="b11"/>
	  <subfield label="COMF" format="b14"/>
	  <subfield label="SOMF" format="b14"/>
	  <subfield label="COMT" format="A"/>
	</field>
	<field label="VRID" description="Vector record identifier field" dsc="vector" dtc ="mixed_data" format="">
	  <subfield label="RCNM" format="b11"/>
	  <subfield label="RCID" format="b14"/>
	  <subfield label="RVER" format="b12"/>
	  <subfield label="RUIN" format="b11"/>
	</field>
	<field label="ATTV" description="Vector record attribute field" dsc="array" dtc ="mixed_data" format="" multiplicity="0,*">
	  <dimension extent="*">
		<subfield label="ATTL" format="b12"/>
		<subfield label="ATVL" format="A"/>
	  </dimension>
	</field>
	<field label="VRPC" description="Vector record pointer control field" dsc="vector" dtc ="mixed_data" format="" multiplicity="0,1">
	  <subfield label="VPUI" format="b11"/>
	  <subfield label="VPIX" format="b12"/>
	  <subfield label="NVPT" format="b12"/>
	</field>
	<field label="VRPT" description="Vector record pointer field" dsc="array" dtc ="mixed_data" format="" multiplicity="0,*">
	  <dimension extent="*">
		<subfield label="NAME" format="B(40)"/>
		<subfield label="ORNT" format="b11"/>
		<subfield label="USAG" format="b11"/>
		<subfield label="TOPI" format="b11"/>
		<subfield label="MASK" format="b11"/>
	  </dimension>
	</field>
	<field label="SGCC" description="Coordinate control field" dsc="vector" dtc ="mixed_data" format="" multiplicity="0,1">
	  <subfield label="CCUI" format="b11"/>
	  <subfield label="CCIX" format="b12"/>
	  <subfield label="CCNC" format="b12"/>
	</field>
	<field label="SG2D" description="2-D coordinate field" dsc="array" dtc ="bit_string" format="" multiplicity="0,*">
	  <dimension extent="*">
		<subfield label="YCOO" format="b24"/>
		<subfield label="XCOO" format="b24"/>
	  </dimension>
	</field>
	<field label="SG3D" description="3-D coordinate (sounding array) field" dsc="array" dtc ="bit_string" format="" multiplicity="0,*">
	  <dimension extent="*">
		<subfield label="YCOO" format="b24"/>
		<subfield label="XCOO" format="b24"/>
		<subfield label="VE3D" format="b24"/>
	  </dimension>
	</field>
	<field label="ARCC" description="Arc/Curve definition field" dsc="vector" dtc ="mixed_data" format="" multiplicity="0,*">
	  <subfield label="ATYP" format="b11"/>
	  <subfield label="SURF" format="b11"/>
	  <subfield label="ORDR" format="b11"/>
	  <subfield label="RESO" format="b14"/>
	  <subfield label="FPMF" format="b14"/>
	</field>
	<field label="AR2D" description="Arc coordinates field" dsc="array" dtc ="bit_string" format="" multiplicity="0,3">
	  <dimension extent="*">
		<dimension extent="STPT!CTPT!ENPT">
		  <subfield label="YCOO" format="b24"/>
		  <subfield label="XCOO" format="b24"/>
		</dimension>
	  </dimension>
	</field>
	<field label="EL2D" description="Ellipse coordinates field" dsc="array" dtc ="bit_string" format="" multiplicity="0,5">
	  <dimension extent="*">
		<dimension extent="STPT!CTPT!ENPT!CDPM!CDPR">
		  <subfield label="YCOO" format="b24"/>
		  <subfield label="XCOO" format="b24"/>
		</dimension>
	  </dimension>
	</field>
	<field label="CT2D" description="Curve coordinates field" dsc="array" dtc ="bit_string" format="" multiplicity="0,*">
	  <dimension extent="*">
		<subfield label="YCOO" format="b24"/>
		<subfield label="XCOO" format="b24"/>
	  </dimension>
	</field>
	<field label="FRID" description="Feature record identifier field" dsc="vector" dtc ="mixed_data" format="">
	  <subfield label="RCNM" format="b11"/>
	  <subfield label="RCID" format="b14"/>
	  <subfield label="PRIM" format="b11"/>
	  <subfield label="GRUP" format="b11"/>
	  <subfield label="OBJL" format="b12"/>
	  <subfield label="RVER" format="b12"/>
	  <subfield label="RUIN" format="b11"/>
	</field>
	<field label="FOID" description="Feature object identifier field" dsc="vector" dtc ="mixed_data" format="">
	  <subfield label="AGEN" format="b12"/>
	  <subfield label="FIDN" format="b14"/>
	  <subfield label="FIDS" format="b12"/>
	</field>
	<field label="ATTF" description="Feature record attribute field" dsc="array" dtc ="mixed_data" format="" multiplicity="0,*" esc="-A ">
	  <dimension extent="*">
		<subfield label="ATTL" format="b12"/>
		<subfield label="ATVL" format="A"/>
	  </dimension>
	</field>
	<field label="NATF" description="Feature record national attribute field" dsc="array" dtc ="mixed_data" format="" multiplicity="0,*" esc="%/A">
	  <dimension extent="*">
		<subfield label="ATTL" format="b12"/>
		<subfield label="ATVL" format="A"/>
	  </dimension>
	</field>
	<field label="FFPC" description="Coordinate control field" dsc="vector" dtc ="mixed_data" format="" multiplicity="0,1">
	  <subfield label="FFUI" format="b11"/>
	  <subfield label="FFIX" format="b12"/>
	  <subfield label="NFPT" format="b12"/>
	</field>
	<field label="FFPT" description="Feature record to feature object pointer field" dsc="array" dtc ="mixed_data" format="" multiplicity="0,*">
	  <dimension extent="*">
		<subfield label="LNAM" format="B(64)"/>
		<subfield label="RIND" format="b11"/>
		<subfield label="COMT" format="A"/>
	  </dimension>
	</field>
	<field label="FSPC" description="Feature record to spatial record pointer control field" dsc="vector" dtc ="mixed_data" format="" multiplicity="0,1">
	  <subfield label="FSUI" format="b11"/>
	  <subfield label="FSIX" format="b12"/>
	  <subfield label="NSPT" format="b12"/>
	</field>
	<field label="FSPT" description="Feature record to spatial record pointer field" dsc="array" dtc ="mixed_data" format="" multiplicity="0,*">
	  <dimension extent="*">
		<subfield label="NAME" format="B(40)"/>
		<subfield label="ORNT" format="b11"/>
		<subfield label="USAG" format="b11"/>
		<subfield label="MASK" format="b11"/>
	  </dimension>
	</field>
	<field label="CATD" description="Catalogue Directory Field" dsc="vector" dtc ="mixed_data" format="">
	  <subfield label="RCNM" format="A(2)"/>
	  <subfield label="RCID" format="I(10)"/>
	  <subfield label="FILE" format="A"/>
	  <subfield label="LFIL" format="A"/>
	  <subfield label="VOLM" format="A"/>
	  <subfield label="IMPL" format="A(3)"/>
	  <subfield label="SLAT" format="R"/>
	  <subfield label="WLON" format="R"/>
	  <subfield label="NLAT" format="R"/>
	  <subfield label="ELON" format="R"/>
	  <subfield label="CRCS" format="A"/>
	  <subfield label="COMT" format="A"/>
	</field>
  </fielddefs>

  <records prsp="ALL" expp="EN">
	<record>
	  <field label="0001">
		<field label="DSID">
		  <field label="DSSI"/>
		</field>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="DSPM"/>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="VRID">
		  <field label="ATTV"/>
		  <field label="VRPT"/>
		  <field label="SG2D"/>
		  <field label="SG3D"/>
		</field>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="FRID">
		  <field label="FOID"/>
		  <field label="ATTF"/>
		  <field label="NATF"/>
		  <field label="FFPT"/>
		  <field label="FSPT"/>
		</field>
	  </field>
	</record>
  </records>

  <records prsp="CAT">
	<record>
	  <field label="0001">
		<field label="CATD"/>
	  </field>
	</record>
  </records>

  <records prsp="ALL" expp="ER">
	<record>
	  <field label="0001">
		<field label="DSID">
		  <field label="DSSI"/>
		</field>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="VRID">
		  <field label="ATTV"/>
		  <field label="VRPC"/>
		  <field label="VRPT"/>
		  <field label="SGCC"/>
		  <field label="SG2D"/>
		  <field label="SG3D"/>
		</field>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="FRID">
		  <field label="FOID"/>
		  <field label="ATTF"/>
		  <field label="NATF"/>
		  <field label="FFPC"/>
		  <field label="FFPT"/>
		  <field label="FSPC"/>
		  <field label="FSPT"/>
		</field>
	  </field>
	</record>
  </records>

  <records prsp="ALL" expp="CA">
	<record>
	  <field label="0001">
		<field label="DSID">
		  <field label="DSSI"/>
		</field>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="DSPM"/>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="VRID">
		  <field label="ATTV"/>
		  <field label="VRPC"/>
		  <field label="VRPT"/>
		  <field label="SGCC"/>
		  <field label="SG2D"/>
		  <field label="SG3D"/>
		</field>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="FRID">
		  <field label="FOID"/>
		  <field label="ATTF"/>
		  <field label="NATF"/>
		  <field label="FFPC"/>
		  <field label="FFPT"/>
		  <field label="FSPC"/>
		  <field label="FSPT"/>
		</field>
	  </field>
	</record>
  </records>

  <!-- This configuration will be used only for AML3.0 and RAL. Other AML products do not have 
	   the ARCC field and will use the "ALL" config -->
  <records prsp="AML" expp="EN">
	<record>
	  <field label="0001">
		<field label="DSID">
		  <field label="DSSI"/>
		</field>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="DSPM"/>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="VRID">
		  <field label="ATTV"/>
		  <field label="VRPT"/>
		  <field label="SG2D"/>
		  <field label="SG3D"/>
		  <field label="ARCC">
			<field label="AR2D"/>
		  </field>
		</field>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="FRID">
		  <field label="FOID"/>
		  <field label="ATTF"/>
		  <field label="NATF"/>
		  <field label="FFPT"/>
		  <field label="FSPT"/>
		</field>
	  </field>
	</record>
  </records>

  <records prsp="AML" expp="ER">
	<record>
	  <field label="0001">
		<field label="DSID">
		  <field label="DSSI"/>
		</field>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="VRID">
		  <field label="ATTV"/>
		  <field label="VRPC"/>
		  <field label="VRPT"/>
		  <field label="SGCC"/>
		  <field label="SG2D"/>
		  <field label="SG3D"/>
		  <field label="ARCC">
			<field label="AR2D"/>
		  </field>
		</field>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="FRID">
		  <field label="FOID"/>
		  <field label="ATTF"/>
		  <field label="NATF"/>
		  <field label="FFPC"/>
		  <field label="FFPT"/>
		  <field label="FSPC"/>
		  <field label="FSPT"/>
		</field>
	  </field>
	</record>
  </records>

  <records prsp="AML" expp="CA">
	<record>
	  <field label="0001">
		<field label="DSID">
		  <field label="DSSI"/>
		</field>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="DSPM"/>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="VRID">
		  <field label="ATTV"/>
		  <field label="VRPC"/>
		  <field label="VRPT"/>
		  <field label="SGCC"/>
		  <field label="SG2D"/>
		  <field label="SG3D"/>
		  <field label="ARCC">
			<field label="AR2D"/>
		  </field>
		</field>
	  </field>
	</record>
	<record>
	  <field label="0001">
		<field label="FRID">
		  <field label="FOID"/>
		  <field label="ATTF"/>
		  <field label="NATF"/>
		  <field label="FFPC"/>
		  <field label="FFPT"/>
		  <field label="FSPC"/>
		  <field label="FSPT"/>
		</field>
	  </field>
	</record>
  </records>

  <exchangeset>
	<fileformats prsp="AML">
	  <format extension="txt" description="Text"/>
	  <format extension="tif" description="Picture"/>
	  <format extension="pdf" description="Document"/>
	  <format extension="html" description="Document"/>
	  <format extension="htm" description="Document"/>
	  <format extension="jpeg" description="Picture"/>
	  <format extension="jpg" description="Picture"/>
	  <format extension="avi" description="Video"/>
	  <format extension="mpeg" description="Video"/>
	  <format extension="mpg" description="Video"/>
	</fileformats>
	<fileformats prsp="IENC">
	  <format extension="txt" description="Text"/>
	  <format extension="jpg" description="Picture"/>
	  <format extension="tif" description="Picture"/>
	  <format extension="xml" description="Extensible Markup Language"/>
	</fileformats>
	<fileformats prsp="BIENC">
	  <format extension="txt" description="Text"/>
	  <format extension="jpg" description="Picture"/>
	  <format extension="tif" description="Picture"/>
	  <format extension="xml" description="Extensible Markup Language"/>
	</fileformats>
	<fileformats prsp="ALL">
	  <format extension="txt" description="Text"/>
	  <format extension="jpg" description="Picture"/>
	  <format extension="tif" description="Picture"/>
	</fileformats>
  </exchangeset>

</S57ISO8211>
