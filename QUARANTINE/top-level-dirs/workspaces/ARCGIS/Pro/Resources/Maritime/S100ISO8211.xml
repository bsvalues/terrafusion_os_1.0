<?xml version="1.0" encoding="utf-8"?>
<S100ISO8211>
  <fielddefs>
    <field label="DSID" description="Data Set Identification" dsc="concatenated" dtc ="mixed_data" format="" esc="%/G">
      <structure dsc="vector" dtc ="mixed_data">
        <subfield label="RCNM" format="b11"/>
        <subfield label="RCID" format="b14"/>
        <subfield label="ENSP" format="A"/>
        <subfield label="ENED" format="A"/>
        <subfield label="PRSP" format="A"/>
        <subfield label="PRED" format="A"/>
        <subfield label="PROF" format="A"/>
        <subfield label="DSNM" format="A"/>
        <subfield label="DSTL" format="A"/>
        <subfield label="DSRD" format="A(8)"/>
        <subfield label="DSLG" format="A"/>
        <subfield label="DSAB" format="A"/>
        <subfield label="DSED" format="A"/>
      </structure>
      <structure dsc="array" dtc ="bit_string">
        <dimension extent="*">
          <subfield label="DSTC" format="b11"/>
        </dimension>
      </structure>
    </field>
    <field label="DSSI" description="Data Set Structure Information" dsc="vector" dtc ="mixed_data" format="">
      <subfield label="DCOX" format="b48"/>
      <subfield label="DCOY" format="b48"/>
      <subfield label="DCOZ" format="b48"/>
      <subfield label="CMFX" format="b14"/>
      <subfield label="CMFY" format="b14"/>
      <subfield label="CMFZ" format="b14"/>
      <subfield label="NOIR" format="b14"/>
      <subfield label="NOPN" format="b14"/>
      <subfield label="NOMN" format="b14"/>
      <subfield label="NOCN" format="b14"/>
      <subfield label="NOXN" format="b14"/>
      <subfield label="NOSN" format="b14"/>
      <subfield label="NOFR" format="b14"/>
    </field>
    <field label="ATCS" description="Attribute Codes" dsc="array" dtc ="mixed_data" format="" esc="">
      <dimension extent="*">
        <subfield label="ATCD" format="A"/>
        <subfield label="ANCD" format="b12"/>
      </dimension>
    </field>
    <field label="ITCS" description="Information Type Codes" dsc="array" dtc ="mixed_data" format="" esc="">
      <dimension extent="*">
        <subfield label="ITCD" format="A"/>
        <subfield label="ITNC" format="b12"/>
      </dimension>
    </field>
    <field label="FTCS" description="Feature Type Codes" dsc="array" dtc ="mixed_data" format="" esc="">
      <dimension extent="*">
        <subfield label="FTCD" format="A"/>
        <subfield label="FTNC" format="b12"/>
      </dimension>
    </field>
    <field label="IACS" description="Information Association Codes" dsc="array" dtc ="mixed_data" format="" esc="">
      <dimension extent="*">
        <subfield label="IACD" format="A"/>
        <subfield label="IANC" format="b12"/>
      </dimension>
    </field>
    <field label="FACS" description="Feature Association Codes" dsc="array" dtc ="mixed_data" format="" esc="">
      <dimension extent="*">
        <subfield label="FACD" format="A"/>
        <subfield label="FANC" format="b12"/>
      </dimension>
    </field>
    <field label="ARCS" description="Association Role Codes" dsc="array" dtc ="mixed_data" format="" esc="">
      <dimension extent="*">
        <subfield label="ARCD" format="A"/>
        <subfield label="ARNC" format="b12"/>
      </dimension>
    </field>
    <field label="CSID" description="Coordinate Reference System Record Identifier" dsc="vector" dtc ="implicit_point" format="">
      <subfield label="RCNM" format="b11"/>
      <subfield label="RCID" format="b14"/>
      <subfield label="NCRC" format="b11"/>
    </field>
    <field label="CRSH" description="Coordinate Reference System Header" dsc="vector" dtc ="mixed_data" format="" esc="%/G">
      <subfield label="CRIX" format="b11"/>
      <subfield label="CRST" format="b11"/>
      <subfield label="CSTY" format="b11"/>
      <subfield label="CRNM" format="A"/>
      <subfield label="CRSI" format="A"/>
      <subfield label="CRSS" format="b11"/>
      <subfield label="SCRI" format="A"/>
    </field>
    <field label="CSAX" description="Coordinate System Axes" dsc="array" dtc ="implicit_point" format="">
      <dimension extent="*">
        <subfield label="AXTY" format="b11"/>
        <subfield label="AXUM" format="b11"/>
      </dimension>
    </field>
    <field label="VDAT" description="Vertical Datum" dsc="vector" dtc ="mixed_data" format="" esc="%/G">
      <subfield label="DTNM" format="A"/>
      <subfield label="DTID" format="A"/>
      <subfield label="DTSR" format="b11"/>
      <subfield label="SCRI" format="A"/>
    </field>
    <field label="IRID" description="Information Type Record Identifier" dsc="vector" dtc ="implicit_point" format="">
      <subfield label="RCNM" format="b11"/>
      <subfield label="RCID" format="b14"/>
      <subfield label="NITC" format="b12"/>
      <subfield label="RVER" format="b12"/>
      <subfield label="RUIN" format="b11"/>
    </field>
    <field label="ATTR" description="Attribute" dsc="array" dtc ="mixed_data" format="" esc="%/G">
      <dimension extent="*">
        <subfield label="NATC" format="b12"/>
        <subfield label="ATIX" format="b12"/>
        <subfield label="PAIX" format="b12"/>
        <subfield label="ATIN" format="b11"/>
        <subfield label="ATVL" format="A"/>
      </dimension>
    </field>
    <field label="INAS" description="Information Association" dsc="concatenated" dtc ="mixed_data" format="" esc="%/G">
      <structure dsc="vector" dtc ="implicit_point">
        <subfield label="RRNM" format="b11"/>
        <subfield label="RRID" format="b14"/>
        <subfield label="NIAC" format="b12"/>
        <subfield label="NARC" format="b12"/>
        <subfield label="IUIN" format="b11"/>
      </structure>
      <structure dsc="array" dtc ="mixed_data">
        <dimension extent="*">
        <subfield label="NATC" format="b12"/>
        <subfield label="ATIX" format="b12"/>
        <subfield label="PAIX" format="b12"/>
        <subfield label="ATIN" format="b11"/>
        <subfield label="ATVL" format="A"/>
        </dimension>
      </structure>
    </field>
    <field label="C2IT" description="2-D Integer Coordinate Tuple" dsc="vector" dtc ="implicit_point" format="">
      <subfield label="YCOO" format="b24"/>
      <subfield label="XCOO" format="b24"/>
    </field>
    <field label="C3IT" description="3-D Integer Coordinate Tuple" dsc="vector" dtc ="implicit_point" format="">
      <subfield label="VCID" format="b11"/>
      <subfield label="YCOO" format="b24"/>
      <subfield label="XCOO" format="b24"/>
      <subfield label="ZCOO" format="b24"/>
    </field>
    <field label="C2IL" description="2-D Integer Coordinate List" dsc="array" dtc ="implicit_point" format="">
      <dimension extent="*">
        <subfield label="YCOO" format="b24"/>
        <subfield label="XCOO" format="b24"/>
      </dimension>
    </field>
    <field label="C3IL" description="3-D Integer Coordinate List" dsc="concatenated" dtc ="implicit_point" format="">
      <structure dsc="vector" dtc ="implicit_point">
        <subfield label="VCID" format="b11"/>
      </structure>
      <structure dsc="array" dtc ="implicit_point">
        <dimension extent="*">
          <subfield label="YCOO" format="b24"/>
          <subfield label="XCOO" format="b24"/>
          <subfield label="ZCOO" format="b24"/>
        </dimension>
      </structure>
    </field>
    <field label="PRID" description="Point Record Identifier" dsc="vector" dtc ="implicit_point" format="">
      <subfield label="RCNM" format="b11"/>
      <subfield label="RCID" format="b14"/>
      <subfield label="RVER" format="b12"/>
      <subfield label="RUIN" format="b11"/>
    </field>
    <field label="MRID" description="Multi Point Record Identifier" dsc="vector" dtc ="implicit_point" format="">
      <subfield label="RCNM" format="b11"/>
      <subfield label="RCID" format="b14"/>
      <subfield label="RVER" format="b12"/>
      <subfield label="RUIN" format="b11"/>
    </field>
    <field label="CRID" description="Curve Record Identifier" dsc="vector" dtc ="implicit_point" format="">
      <subfield label="RCNM" format="b11"/>
      <subfield label="RCID" format="b14"/>
      <subfield label="RVER" format="b12"/>
      <subfield label="RUIN" format="b11"/>
    </field>
    <field label="PTAS" description="Point Association" dsc="array" dtc ="implicit_point" format="">
      <dimension extent="*">
        <subfield label="RRNM" format="b11"/>
        <subfield label="RRID" format="b14"/>
        <subfield label="TOPI" format="b11"/>
      </dimension>
    </field>
    <field label="SEGH" description="Segment Header" dsc="vector" dtc ="implicit_point" format="">
      <subfield label="INTP" format="b11"/>
    </field>
    <field label="CCID" description="Composite Curve Record Identifier" dsc="vector" dtc ="implicit_point" format="">
      <subfield label="RCNM" format="b11"/>
      <subfield label="RCID" format="b14"/>
      <subfield label="RVER" format="b12"/>
      <subfield label="RUIN" format="b11"/>
    </field>
    <field label="CUCO" description="Curve Component" dsc="array" dtc ="implicit_point" format="">
      <dimension extent="*">
        <subfield label="RRNM" format="b11"/>
        <subfield label="RRID" format="b14"/>
        <subfield label="ORNT" format="b11"/>
      </dimension>
    </field>
    <field label="SRID" description="Surface Record Identifier" dsc="vector" dtc ="implicit_point" format="">
      <subfield label="RCNM" format="b11"/>
      <subfield label="RCID" format="b14"/>
      <subfield label="RVER" format="b12"/>
      <subfield label="RUIN" format="b11"/>
    </field>
    <field label="RIAS" description="Ring Association" dsc="array" dtc ="implicit_point" format="">
      <dimension extent="*">
        <subfield label="RRNM" format="b11"/>
        <subfield label="RRID" format="b14"/>
        <subfield label="ORNT" format="b11"/>
        <subfield label="USAG" format="b11"/>
        <subfield label="RAUI" format="b11"/>
      </dimension>
    </field>
    <field label="FRID" description="Feature Type Record Identifier" dsc="vector" dtc ="implicit_point" format="">
      <subfield label="RCNM" format="b11"/>
      <subfield label="RCID" format="b14"/>
      <subfield label="NFTC" format="b12"/>
      <subfield label="RVER" format="b12"/>
      <subfield label="RUIN" format="b11"/>
    </field>
    <field label="FOID" description="Feature object identifier field" dsc="vector" dtc ="implicit_point" format="">
      <subfield label="AGEN" format="b12"/>
      <subfield label="FIDN" format="b14"/>
      <subfield label="FIDS" format="b12"/>
    </field>
    <field label="SPAS" description="Spatial Association" dsc="array" dtc ="implicit_point" format="">
      <dimension extent="*">
        <subfield label="RRNM" format="b11"/>
        <subfield label="RRID" format="b14"/>
        <subfield label="ORNT" format="b11"/>
        <subfield label="SMIN" format="b14"/>
        <subfield label="SMAX" format="b14"/>
        <subfield label="SAUI" format="b11"/>
      </dimension>
    </field>
    <field label="FASC" description="Feature Association" dsc="concatenated" dtc ="mixed_data" format="" esc="%/G">
      <structure dsc="vector" dtc ="implicit_point">
        <subfield label="RRNM" format="b11"/>
        <subfield label="RRID" format="b14"/>
        <subfield label="NFAC" format="b12"/>
        <subfield label="NARC" format="b12"/>
        <subfield label="FAUI" format="b11"/>
      </structure>
      <structure dsc="array" dtc ="mixed_data">
        <dimension extent="*">
        <subfield label="NATC" format="b12"/>
        <subfield label="ATIX" format="b12"/>
        <subfield label="PAIX" format="b12"/>
        <subfield label="ATIN" format="b11"/>
        <subfield label="ATVL" format="A"/>
        </dimension>
      </structure>
    </field>
    <field label="THAS" description="Theme Association" dsc="array" dtc ="implicit_point" format="">
      <dimension extent="*">
        <subfield label="RRNM" format="b11"/>
        <subfield label="RRID" format="b14"/>
        <subfield label="TAUI" format="b11"/>
      </dimension>
    </field>
    <field label="MASK" description="Masked Spatial Type" dsc="array" dtc ="implicit_point" format="">
      <dimension extent="*">
        <subfield label="RRNM" format="b11"/>
        <subfield label="RRID" format="b14"/>
        <subfield label="MIND" format="b11"/>
        <subfield label="MUIN" format="b11"/>
      </dimension>
    </field>
  </fielddefs>

  <records prsp="S101" expp="EN">
    <record>
      <field label="DSID">
        <field label="DSSI"/>
        <field label="ATCS"/>
        <field label="ITCS"/>
        <field label="FTCS"/>
        <field label="IACS"/>
        <field label="FACS"/>
        <field label="ARCS"/>
        <field label="ATTR"/>
      </field>
    </record>
    <record>
      <field label="CSID">
        <field label="CRSH">
          <field label="CSAX"/>
          <field label="VDAT"/>
        </field>
      </field>
    </record>
    <record>
      <field label="IRID">
        <field label="ATTR"/>
        <field label="INAS"/>
      </field>
    </record>
    <record>
      <field label="PRID">
        <field label="INAS"/>
        <field label="C2IT"/>
        <field label="C3IT"/>
      </field>
    </record>
    <record>
      <field label="MRID">
        <field label="INAS"/>
        <field label="C2IL"/>
        <field label="C3IL"/>
      </field>
    </record>
    <record>
      <field label="CRID">
        <field label="INAS"/>
        <field label="PTAS"/>
        <field label="SEGH">
          <field label="C2IL"/>
        </field>
      </field>
    </record>
    <record>
      <field label="CCID">
        <field label="INAS"/>
        <field label="CUCO"/>
      </field>
    </record>
    <record>
      <field label="SRID">
        <field label="INAS"/>
        <field label="RIAS"/>
      </field>
    </record>
    <record>
      <field label="FRID">
        <field label="FOID"/>
        <field label="ATTR"/>
        <field label="INAS"/>
        <field label="SPAS"/>
        <field label="FASC"/>
        <field label="THAS"/>
        <field label="MASK"/>
      </field>
    </record>
  </records>
</S100ISO8211>
  