268518"/><ChildStep GUID="{6116815B-C0AD-400A-8798-A6F7623BB24E}" LastModified="41802.9012268518"/><ReturnCode>52204</ReturnCode><Description/><AssignedType>0</AssignedType><AssignedTo/><Operator>=</Operator></Item3><RelatedContainers xsi:type="typens:JTXAuxContainerConfigSet" GUID="{B8640746-1657-4E99-B493-9C24437E3067}" LastModified="0"><Count>0</Count></RelatedContainers><Item5 xsi:type="typens:JTXStepType" GUID="{1d8af2ea-0bcc-4406-9d48-ad34add62927}" LastModified="39570.876875"><ID>6</ID><Name>Edit Data</Name><Description>Smart-launches map with data loaded for active job type</Description><Program>JTXDesktopSteps.LaunchArcMap</Program><Arguments/><Visible>-1</Visible><ExecutionType>2</ExecutionType><StepDescriptionType>3</StepDescriptionType><StepDescriptionHTML/><StepDescriptionLink>https://pro.arcgis.com/en/pro-app/help/editing/overview-of-desktop-editing.htm</StepDescriptionLink><StepTypeIndicator>1</StepTypeIndicator><SupportedPlatform>0</SupportedPlatform><CustomStep ProgID="JTXDesktopSteps.LaunchArcMap"/></Item5><Item6 xsi:type="typens:JTXStepType" GUID="{7cd20224-d438-4086-ac4d-7d674604cc8c}" LastModified="39570.876875"><ID>7</ID><Name>QC Data</Name><Description>Perform Quality Control on the data in map</Description><Program>JTXDesktopSteps.LaunchArcMap</Program><Arguments/><Visible>-1</Visible><ExecutionType>2</ExecutionType><StepDescriptionType>2</StepDescriptionType><StepDescriptionHTML>&lt;font face="Calibri" size=4&gt;Perform Quality Control on the data in ArcMap. Verify the edits made for location and attribute accuracy.&lt;/font&gt;</StepDescriptionHTML><StepDescriptionLink/><StepTypeIndicator>1</StepTypeIndicator><SupportedPlatform>0</SupportedPlatform><CustomStep ProgID="JTXDesktopSteps.LaunchArcMap"/></Item6><Item7 xsi:type="typens:JTXStepType" GUID="{182b6a2f-a748-487a-b76d-02c9827d9cf4}" LastModified="39570.876875"><ID>8</ID><Name>More Edits</Name><Description>Asks the user if more edits are required</Description><Program>Are more edits required?|QA\QC</Program><Arguments>Yes|No</Arguments><Visible>0</Visible><ExecutionType>5</ExecutionType><StepDescriptionType>2</StepDescriptionType><StepDescriptionHTML>&lt;font face="Calibri" size=4&gt;Asks a question whether more edits are requied or not.&lt;/font&gt;</StepDescriptionHTML><StepDescriptionLink/><StepTypeIndicator>4</StepTypeIndicator><SupportedPlatform>2</SupportedPlatform></Item7><Item8 xsi:type="typens:JTXStepType" GUID="{673B79E6-AB13-4DC2-86F5-AD9EF30423EF}" LastModified="39570.876875"><ID>9</ID><Name>Clean Up</Name><Description>Cleans up the job by deleting the jobs version, map and attachments based on the arguments.</Description><Program>JTXSteps.CleanUp</Program><Arguments>/m /v</Arguments><Visible>0</Visible><ExecutionType>2</ExecutionType><StepDescriptionType>2</StepDescriptionType><StepDescriptionHTML>&lt;font face="Calibri" size=4&gt;Cleans up the job by deleting the jobs version, map and attachments based on the arguments.&lt;br&gt; Enable the Administration system settings to allow users to delete versions owned by other users. This will prompt for geodatabase superuser's credentials.&lt;br&gt;&lt;/font&gt;.</StepDescriptionHTML><StepDescriptionLink/><StepTypeIndicator>1</StepTypeIndicator><SupportedPlatform>2</SupportedPlatform></Item8><Item9 xsi:type="typens:JTXStepType" GUID="{d0765536-619f-4538-8cad-08ed1fc53567}" LastModified="39570.876875"><ID>10</ID><Name>Notify</Name><Description>Notify that job is completed</Description><Program>JTXSteps.SendNotification</Program><Arguments>/notifType:JobClosed</Arguments><Visible>0</Visible><ExecutionType>2</ExecutionType><StepDescriptionType>2</StepDescriptionType><StepDescriptionHTML>&lt;font face="Calibri" size=4&gt;Sends an email notification that the job has been closed..&lt;/font&gt;</StepDescriptionHTML><StepDescriptionLink/><StepTypeIndicator>3</StepTypeIndicator><SupportedPlatform>2</SupportedPlatform><CustomStep ProgID="JTXSteps.SendNotification"><NotificationType GUID="{f2df2371-0921-4fd8-8c2f-049baec6afc7}" LastModified="39569.3694444444"/></CustomStep></Item9><Item10 xsi:type="typens:JTXStepType" GUID="{AA9312E8-5E37-4B24-8FC6-B95F3D720F3A}" LastModified="40969.9022569444"><ID>11</ID><Name>Check LOI</Name><Description>Checks whether the job has a location of Interest defined</Description><Program>JTXSteps.CheckAOI</Program><Arguments/><Visible>0</Visible><ExecutionType>2</ExecutionType><StepDescriptionType>2</StepDescriptionType><StepDescriptionHTML>&lt;font face="Calibri" size=4&gt;Checks whether the Location Of Interest (LOI) is defined for the job.&lt;/font&gt;</StepDescriptionHTML><StepDescriptionLink/><StepTypeIndicator>4</StepTypeIndicator><SupportedPlatform>2</SupportedPlatform></Item10><Item11 xsi:type="typens:JTXStepType" GUID="{FE12723F-9443-4558-804C-8C5243CE6AB0}" LastModified="39613.876875"><ID>12</ID><Name>Define LOI</Name><Description>Define the Location of Interest(LOI) for the job. The LOI can be polygon or point features. </Description><Program>JTXDesktopSteps.DefineAOI</Program><Arguments/><Visible>0</Visible><ExecutionType>2</ExecutionType><StepDescriptionType>2</StepDescriptionType><StepDescriptionHTML>&lt;font face="Calibri" size=4&gt;Define the Location of Interest(LOI) for the job. The LOI can be polygon or point features.&lt;br&gt;&lt;h2&gt;Tools to define the location of Interest&lt;/h2&gt;
&lt;ul style="list-style-type:disc"&gt;
  &lt;li&gt;Select feature by location.&lt;/li&gt;
  &lt;li&gt;Select features by attribute.&lt;/li&gt;
  &lt;li&gt;Draw the polygon or point.&lt;/li&gt;
&lt;/ul&gt; </StepDescriptionHTML><StepDescriptionLink/><StepTypeIndicator>1</StepTypeIndicator><SupportedPlatform>0</SupportedPlatform></Item11><Item12 xsi:type="typens:JTXStepType" GUID="{d7269272-1e45-47db-8331-923e55f8210b}" LastModified="39570.876875"><ID>13</ID><Name>Prepare</Name><Description>Prepare Job for Working</Description><Program/><Arguments/><Visible>0</Visible><ExecutionType>3</ExecutionType><StepDescriptionType>2</StepDescriptionType><StepDescriptionHTML>&lt;font face="Calibri" size=4&gt;Placeholder step for preparing the job to start working.&lt;/font&gt;</StepDescriptionHTML><StepDescriptionLink/><StepTypeIndicator>3</StepTypeIndicator><SupportedPlatform>2</SupportedPlatform></Item12><Item13 xsi:type="typens:JTXStepType" GUID="{381a48c8-d3e6-4f0f-90d2-d03e8e12b92f}" LastModified="39570.876875"><ID>14</ID><Name>Inventory Source</Name><Description>The user should inventory source</Description><Program>Does this job contain imagery?|Image Processing</Program><Arguments>Yes|No</Arguments><Visible>0</Visible><ExecutionType>5</ExecutionType><StepDescriptionType>2</StepDescriptionType><StepDescriptionHTML>&lt;font face="Calibri" size=4&gt;Asks a question whether inventory of source is requied.&lt;/font&gt;</StepDescriptionHTML><StepDescriptionLink/><StepTypeIndicator>4</StepTypeIndicator><SupportedPlatform>2</SupportedPlatform></Item13><Item14 xsi:type="typens:JTXStepType" GUID="{78935CBF-44BA-4401-BE78-743B1110CC0C}" LastModified="40296.8803587963"><ID>15</ID><Name>Clip Imagery</Name><Description>Placeholder step for clipping imagery.</Description><Program/><Arguments/><Visible>0</Visible><ExecutionType>3</ExecutionType><StepDescriptionType>2</StepDescriptionType><StepDescriptionHTML>&lt;font face="Calibri" size=4&gt;Placeholder step for clipping imagery.&lt;/font&gt;</StepDescriptionHTML><StepDescriptionLink/><StepTypeIndicator>5</StepTypeIndicator><SupportedPlatform>2</SupportedPlatform></Item14><Item15 xsi:type="typens:JTXStepType" GUID="{d8016473-9