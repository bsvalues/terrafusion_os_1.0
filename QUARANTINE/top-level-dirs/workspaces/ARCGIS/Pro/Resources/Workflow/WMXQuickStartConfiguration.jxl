l/><TokenParse>-1</TokenParse><ReportGroupingEnabled>73</ReportGroupingEnabled><ReportAggregateFunction>0</ReportAggregateFunction><RowAggregateFunction>0</RowAggregateFunction><QueryEditMode>2</QueryEditMode><QualifierPrefix>ps_102.DBO.</QualifierPrefix></Query><Item1 xsi:type="typens:JTXJobQuery" GUID="{919a3c08-240f-4fa4-8811-7ba43832b9e3}" LastModified="40305.0453240741"><ID>2</ID><Name>Unassigned Jobs</Name><Query GUID="{1D58AA3D-1441-48EE-AF31-1D4F14F1A2E7}" LastModified="0"/><Container GUID="{f0a9186f-1b92-4b66-8771-44f8c0ad8d4d}" LastModified="42325.8129513889"/></Item1><Query xsi:type="typens:JTXQuery" GUID="{1D58AA3D-1441-48EE-AF31-1D4F14F1A2E7}" LastModified="0"><Tables>JTX_JOBS,JTX_JOB_TYPES</Tables><FieldNames>JTX_JOBS.JOB_NAME,JTX_JOBS.ASSIGNED_TO,JTX_JOB_TYPES.JOB_TYPE_NAME</FieldNames><FieldDescs>Job Name, Assigned To, Job Type</FieldDescs><UserWhereClause>JTX_JOBS.JOB_TYPE_ID = JTX_JOB_TYPES.JOB_TYPE_ID AND ((JTX_JOBS.ASSIGNED_TO = '') OR (JTX_JOBS.ASSIGNED_TO IS NULL))</UserWhereClause><SysWhereClause/><OrderBy/><GroupByFields/><AggregateField/><AggregateFieldAlias/><ReportGroupingAggregateLabel/><TokenParse>-1</TokenParse><ReportGroupingEnabled>0</ReportGroupingEnabled><ReportAggregateFunction>0</ReportAggregateFunction><RowAggregateFunction>0</RowAggregateFunction><QueryEditMode>2</QueryEditMode><QualifierPrefix>ps_102.DBO.</QualifierPrefix></Query><Item1 xsi:type="typens:JTXJobQueryContainer" GUID="{a8c5cb24-ad8e-42b3-a267-428054e6fd4b}" LastModified="42325.812962963"><ID>402</ID><Name>Group Queries</Name><HasOwner>0</HasOwner><Owner/><Parent GUID="{20887BED-DAE7-40B1-BD52-AF920DC72C1A}" LastModified="40305.0459490741"/><SubContainers GUID="{45BFB66A-E30C-4FE3-BBBF-7C3FADCD07D6}" LastModified="0"/><Queries GUID="{970D832C-3EC6-40A4-AA64-2C4FFBB2FB1F}" LastModified="0"/></Item1><SubContainers xsi:type="typens:JTXJobQueryContainerSet" GUID="{45BFB66A-E30C-4FE3-BBBF-7C3FADCD07D6}" LastModified="0"><Count>0</Count></SubContainers><Queries xsi:type="typens:JTXJobQuerySet" GUID="{970D832C-3EC6-40A4-AA64-2C4FFBB2FB1F}" LastModified="0"><Count>2</Count><Item0 GUID="{9309443e-5d82-4041-9dac-6f8bf7aa64b2}" LastModified="40305.0454976852"/><Item1 GUID="{2e8f3e8a-f492-4ab6-9ef4-fd9d9c19a0c5}" LastModified="40305.0456828704"/></Queries><Item0 xsi:type="typens:JTXJobQuery" GUID="{9309443e-5d82-4041-9dac-6f8bf7aa64b2}" LastModified="40305.0454976852"><ID>3</ID><Name>Jobs assigned to my groups</Name><Query GUID="{67427407-11CA-4D65-9140-F0CA7081B3BB}" LastModified="4.00542154021162E-307"/><Container GUID="{a8c5cb24-ad8e-42b3-a267-428054e6fd4b}" LastModified="42325.812962963"/></Item0><Query xsi:type="typens:JTXQuery" GUID="{67427407-11CA-4D65-9140-F0CA7081B3BB}" LastModified="4.00542154021162E-307"><Tables>JTX_JOBS,JTX_JOB_TYPES</Tables><FieldNames>JTX_JOBS.JOB_NAME,JTX_JOBS.ASSIGNED_TO,JTX_JOB_TYPES.JOB_TYPE_NAME</FieldNames><FieldDescs>Job Name, Assigned To, Job Type</FieldDescs><UserWhereClause>JTX_JOBS.JOB_TYPE_ID = JTX_JOB_TYPES.JOB_TYPE_ID AND JTX_JOBS.ASSIGNED_TO IN ([GROUPNAMESOF([SYS:CUR_LOGIN])])</UserWhereClause><SysWhereClause/><OrderBy/><GroupByFields/><AggregateField/><AggregateFieldAlias/><ReportGroupingAggregateLabel/><TokenParse>-1</TokenParse><ReportGroupingEnabled>73</ReportGroupingEnabled><ReportAggregateFunction>0</ReportAggregateFunction><RowAggregateFunction>0</RowAggregateFunction><QueryEditMode>2</QueryEditMode><QualifierPrefix>ps_102.DBO.</QualifierPrefix></Query><Item1 xsi:type="typens:JTXJobQuery" GUID="{2e8f3e8a-f492-4ab6-9ef4-fd9d9c19a0c5}" LastModified="40305.0456828704"><ID>4</ID><Name>Jobs with steps assigned to my groups</Name><Query GUID="{85465070-D22A-4CA0-A965-7E126B043946}" LastModified="3.56042035016398E-307"/><Container GUID="{a8c5cb24-ad8e-42b3-a267-428054e6fd4b}" LastModified="42325.812962963"/></Item1><Query xsi:type="typens:JTXQuery" GUID="{85465070-D22A-4CA0-A965-7E126B043946}" LastModified="3.56042035016398E-307"><Tables>JTX_JOBS,JTX_JOB_TYPES</Tables><FieldNames>JTX_JOBS.JOB_NAME,JTX_JOBS.ASSIGNED_TO,JTX_JOB_TYPES.JOB_TYPE_NAME</FieldNames><FieldDescs>Job Name, Assigned To, Job Type</FieldDescs><UserWhereClause>JTX_JOB_TYPES.JOB_TYPE_ID = JTX_JOBS.JOB_TYPE_ID AND JTX_JOBS.JOB_ID IN 
(SELECT JOB_ID 
   FROM JTX_JOB_STEP 
   WHERE (JTX_JOB_STEP.ASSIGNED_TO IN ([GROUPNAMESOF([SYS:CUR_LOGIN])]) AND
   JTX_JOB_STEP.STEP_ID IN (SELECT STEP_ID FROM JTX_STEP_STATUS WHERE STATUS = 'S')
   )
)</UserWhereClause><SysWhereClause/><OrderBy/><GroupByFields/><AggregateField/><AggregateFieldAlias/><ReportGroupingAggregateLabel/><TokenParse>-1</TokenParse><ReportGroupingEnabled>66</ReportGroupingEnabled><ReportAggregateFunction>0</ReportAggregateFunction><RowAggregateFunction>0</RowAggregateFunction><QueryEditMode>2</QueryEditMode><QualifierPrefix>ps_102.DBO.</QualifierPrefix></Query><Item2 xsi:type="typens:JTXJobQueryContainer" GUID="{10f45baa-3887-4170-8018-14acb3b121af}" LastModified="42347.9069675926"><ID>403</ID><Name>Personal Queries</Name><HasOwner>0</HasOwner><Owner/><Parent GUID="{20887BED-DAE7-40B1-BD52-AF920DC72C1A}" LastModified="40305.0459490741"/><SubContainers GUID="{DB774600-BD31-404A-89A0-DC6EAAA757B4}" LastModified="0"/><Queries GUID="{221A96F3-4062-411B-9338-BCFF471D2133}" LastModified="0"/></Item2><SubContainers xsi:type="typens:JTXJobQueryContainerSet" GUID="{DB774600-BD31-404A-89A0-DC6EAAA757B4}" LastModified="0"><Count>0</Count></SubContainers><Queries xsi:type="typens:JTXJobQuerySet" GUID="{221A96F3-4062-411B-9338-BCFF471D2133}" LastModified="0"><Count>2</Count><Item0 GUID="{1b72dd79-db16-428b-b998-9eaa58273ce0}" LastModified="40306.9063888889"/><Item1 GUID="{e4685412-ba43-4a7e-b7b0-2c47e20f1991}" LastModified="40306.9063888889"/></Queries><Item0 xsi:type="typens:JTXJobQuery" GUID="{1b72dd79-db16-428b-b998-9eaa58273ce0}" LastModified="40306.9063888889"><ID>5</ID><Name>Jobs assigned to me</Name><Query GUID="{DEEAD0EC-FDE0-4CB8-A4E5-DB2A024C1C72}" LastModified="4.00542154021162E-307"/><Container GUID="{10f45baa-3887-4170-8018-14acb3b121af}" LastModified="42347.9069675926"/></Item0><Query xsi:type="typens:JTXQuery" GUID="{DEEAD0EC-FDE0-4CB8-A4E5-DB2A024C1C72}" LastModified="4.00542154021162E-307"><Tables>JTX_JOBS,JTX_JOB_TYPES</Tables><FieldNames>JTX_JOBS.JOB_NAME,JTX_JOBS.ASSIGNED_TO,JTX_JOB_TYPES.JOB_TYPE_NAME</FieldNames><FieldDescs>Job Name, Assigned to, Job Type</FieldDescs><UserWhereClause>JTX_JOBS.JOB_TYPE_ID = JTX_JOB_TYPES.JOB_TYPE_ID  AND upper(JTX_JOBS.ASSIGNED_TO) = upper('[SYS:CUR_LOGIN]')</UserWhereClause><SysWhereClause/><OrderBy/><GroupByFields/><AggregateField/><AggregateFieldAlias/><ReportGroupingAggregateLabel/><TokenParse>-1</TokenParse><ReportGroupingEnabled>73</ReportGroupingEnabled><ReportAggregateFunction>0</ReportAggregateFunction><RowAggregateFunction>0</RowAggregateFunction><QueryEditMode>2</QueryEditMode><QualifierPrefix>ps_102.DBO.</QualifierPrefix></Query><Item1 xsi:type="typens:JTXJobQuery" GUID="{e4685412-ba43-4a7e-b7b0-2c47e20f1991}" LastModified="40306.9063888889"><ID>6</ID><Name>Jobs with steps assigned to me</Name><Query GUID="{E16BB641-ED51-4AAC-B258-EFC57707C1D4}" LastModified="3.56042035016398E-307"/><Container GUID="{10f45baa-3887-4170-8018-14acb3b121af}" LastModified="42347.9069675926"/></Item1><Query xsi:type="typens:JTXQuery" GUID="{E16BB641-ED51-4AAC-B258-EFC57707C1D4}" LastModified="3.56042035016398E-307"><Tables>JTX_JOBS,JTX_JOB_TYPES</Tables><FieldNames>JTX_JOBS.JOB_NAME,JTX_JOBS.ASSIGNED_TO,JTX_JOB_TYPES.JOB_TYPE_NAME</FieldNames><FieldDescs>Job Name, Assigned To, Job Type</FieldDescs><UserWhereClause>JTX_JOB_TYPES.JOB_TYPE_ID = JTX_JOBS.JOB_TYPE_ID AND JTX_JOBS.JOB_ID IN 
(SELECT JOB_ID 
   FROM JTX_JOB_STEP 
   WHERE (upper(JTX_JOB_STEP.ASSIGNED_TO) = upper('[SYS:CUR_LOGIN]') AND
   JTX_JOB_STEP.STEP_ID IN (SELECT STEP_ID FROM JTX_STEP_STATUS WHERE STATUS = 'S')
   )
)</UserWhereClause><SysWhereClause/><OrderBy/><GroupByFields/><AggregateField/><AggregateFieldAlias/><ReportGroupingAggregateLabel/><TokenParse>-1</TokenParse><ReportGroupingEnabled>66</ReportGroupingEnabled><ReportAggregateFunction>0</ReportAggregateFunction><RowAggregateFunction>0</RowAggregateFunction><QueryEditMode>2</QueryEditMode><QualifierPrefix>ps_102.DBO.</QualifierPrefix></Query><Queries xsi:type="typens:JTXJobQuerySet" GUID="{46345CE7-2160-42F5-8189-DE9175FE3855}" LastModified="0"><Count>0</Count></Queries><UserQueryContainers xsi:type="typens:JTXJobQueryContainerSet" GUID="{EE4DF363-7BC4-4092-8AFA-079EDA8E8A18}" LastModified="0"><Count>1</Count><Item0 GUID="{20887BED-DAE7-40B1-BD52-AF920DC72C1A}" LastModified="40305.0459490741"/></UserQueryContainers><JobFilters xsi:type="typens:JTXJobFilterSet" GUID="{8E0AC495-4A40-4926-A24C-CCF5F4824058}" LastModified="0"><Count>0</Count></JobFilters><Reports xsi:type="typens:JTXReportSet" GUID="{F9667B0F-CFFC-4A34-8ADA-1EF11238EEC8}" LastModified="0"><Count>2</Count><Item0 GUID="{58A4CBD1-ABAB-4977-872E-9B8BB846743E}" LastModified="40295.8215046296"/><Item1 GUID="{EFB3D9A9-C11C-442E-964C-7D4B2112F95C}" LastModified="40295.8228356481"/></Reports><Item0 xsi:type="typens:JTXReport" GUID="{58A4CBD1-ABAB-4977-872E-9B8BB846743E}" LastModified="40295.8215046296"><ID>1</ID><ReportQueryID>1</ReportQueryID><Name>Job Percentage Complete Report</Name><Stylesheet>&lt;?xml version="1.0" encoding="utf-16"?&gt;

&lt;xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"&gt;
  &lt;xsl:output method="html" version="4.0" encoding="utf-16" indent="yes"/&gt;

  &lt;!-- ******************************* --&gt;
  &lt;!-- TEMPLATE:/ --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;xsl:template match="/"&gt;
    &lt;HTML&gt;
      &lt;BODY&gt;
        &lt;DIV style="margin:0in 0.15in 0.75in 0.15in"&gt;
          &lt;xsl:apply-templates select="REPORT"/&gt;
        &lt;/DIV&gt;
        &lt;xsl:apply-templates select="REPORT/GROUPS"/&gt;
      &lt;/BODY&gt;
    &lt;/HTML&gt;
  &lt;/xsl:template&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;



  &lt;!-- ******************************* --&gt;
  &lt;!-- TEMPLATE:REPORT --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;xsl:template match="REPORT"&gt;
    &lt;H1 style="margin-left:0.05in; position:relative; top:-6; text-align:center; font-weight:bold; font-size:18; font-family:Verdana,sans-serif; color:#006400"&gt;
      &lt;xsl:value-of select="@title"/&gt;
    &lt;/H1&gt;
    &lt;H3&gt;
      &lt;xsl:value-of select="@description"/&gt;
    &lt;/H3&gt;
  &lt;/xsl:template&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;



  &lt;!-- ******************************* --&gt;
  &lt;!-- TEMPLATE:COLUMNS --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;xsl:template match="COLUMNS"&gt;
    &lt;tr style="color:#FFFFFF; background-color:#6495ED"&gt;
      &lt;xsl:for-each select="COLUMN"&gt;
        &lt;th align="center"&gt;
          &lt;xsl:value-of select="."/&gt;
        &lt;/th&gt;
      &lt;/xsl:for-each&gt;
    &lt;/tr&gt;
  &lt;/xsl:template&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;



  &lt;!-- ******************************* --&gt;
  &lt;!-- TEMPLATE:ROWS --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;xsl:template match="ROW"&gt;
    &lt;tr&gt;
      &lt;xsl:attribute name="BGCOLOR"&gt;
        &lt;xsl:choose&gt;
          &lt;xsl:when test="position() mod 2 = 1"&gt;#DBDBDB&lt;/xsl:when&gt;
          &lt;xsl:when test="position() mod 2 = 0"&gt;#FFFFFF&lt;/xsl:when&gt;
        &lt;/xsl:choose&gt;
      &lt;/xsl:attribute&gt;

      &lt;!-- First value should go under column 2 if using report grouping --&gt;
      &lt;xsl:if test="string(../@value)"&gt;
        &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"/&gt;
      &lt;/xsl:if&gt;

      &lt;xsl:for-each select="VALUE"&gt;
        &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"&gt;
          &lt;xsl:value-of select="."/&gt;
        &lt;/td&gt;
      &lt;/xsl:for-each&gt;
    &lt;/tr&gt;
  &lt;/xsl:template&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;



  &lt;!-- ******************************* --&gt;
  &lt;!-- TEMPLATE:GROUPS --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;xsl:template match="GROUPS"&gt;
    &lt;xsl:apply-templates select="GROUP"/&gt;
  &lt;/xsl:template&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;



  &lt;!-- ******************************* --&gt;
  &lt;!-- TEMPLATE:GROUPS --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;xsl:template match="GROUP"&gt;
    &lt;DIV style="font-family:Verdana,sans-serif; line-height:135%; color:#191970; margin:0in 0.15in 0.75in 0.15in"&gt;
      &lt;xsl:variable name="aggregate_label"&gt;
        &lt;xsl:value-of select="@aggregate_label"/&gt;
      &lt;/xsl:variable&gt;
      &lt;xsl:variable name="aggregate_value"&gt;
        &lt;xsl:value-of select="@aggregate_value"/&gt;
      &lt;/xsl:variable&gt;

      &lt;table cellpadding="4" style="position:relative; top:-10; valign:top; table-layout:fixed;border-collapse:collapse; border:2px solid #6495ED"&gt;
        &lt;!-- Display the column headers --&gt;
        &lt;xsl:apply-templates select="//REPORT/COLUMNS"/&gt;

        &lt;!-- Place the report group value on its own row --&gt;
        &lt;xsl:if test="string(@value)"&gt;
          &lt;tr style="color:#000000; background-color:#FCBA7A"&gt;
            &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"&gt;
              &lt;xsl:value-of select="@value"/&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
        &lt;/xsl:if&gt;

        &lt;!-- Display rows --&gt;
        &lt;xsl:apply-templates select="ROW"/&gt;

        &lt;!-- Write the group summary row if using report grouping --&gt;
        &lt;xsl:if test="string(@value) and string(@aggregate_label) and string(@aggregate_value)"&gt;
          &lt;tr BGCOLOR='#B8DEFA'&gt;
            &lt;xsl:for-each select="//REPORT/COLUMNS/COLUMN"&gt;
              &lt;xsl:if test="position()=1 and position()=last()"&gt;
                &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"&gt;
                  &lt;b&gt;
                    &lt;xsl:value-of select="$aggregate_label"/&gt;:&lt;xsl:text&gt;&amp;#32;&lt;/xsl:text&gt;&lt;xsl:value-of select="$aggregate_value"/&gt;
                  &lt;/b&gt;
                &lt;/td&gt;
              &lt;/xsl:if&gt;
              &lt;xsl:if test="position()=1 and position()!=last()"&gt;
                &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"&gt;
                  &lt;b&gt;
                    &lt;xsl:value-of select="$aggregate_label"/&gt;:&lt;xsl:text&gt;&amp;#32;&lt;/xsl:text&gt;
                  &lt;/b&gt;
                &lt;/td&gt;
              &lt;/xsl:if&gt;
              &lt;xsl:if test="position()!=1 and position()!=last()"&gt;
                &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"/&gt;
              &lt;/xsl:if&gt;
              &lt;xsl:if test="position()!=1 and position()=last()"&gt;
                &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"&gt;
                  &lt;b&gt;
                    &lt;xsl:value-of select="$aggregate_value"/&gt;
                  &lt;/b&gt;
                &lt;/td&gt;
              &lt;/xsl:if&gt;
            &lt;/xsl:for-each&gt;
          &lt;/tr&gt;
        &lt;/xsl:if&gt;
        
      &lt;/table&gt;
    &lt;/DIV&gt;
  &lt;/xsl:template&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;

&lt;/xsl:stylesheet&gt;</Stylesheet><Title>Job Percentage Complete</Title><Description>This report displays jobs based on the percent complete.</Description><Hierarchy>General Reports</Hierarchy><ReportQuery GUID="{5C3DCDA3-D144-4535-977F-44D2F0BB8FDF}" LastModified="40295.8215046296"/></Item0><ReportQuery xsi:type="typens:JTXReportQuery" GUID="{5C3DCDA3-D144-4535-977F-44D2F0BB8FDF}" LastModified="40295.8215046296"><ID>1</ID><Query GUID="{83395154-4803-47B2-9358-2D3C9A8DD3AC}" LastModified="4.00540116972552E-307"/></ReportQuery><Query xsi:type="typens:JTXQuery" GUID="{83395154-4803-47B2-9358-2D3C9A8DD3AC}" LastModified="4.00540116972552E-307"><Tables>JTX_JOBS,JTX_JOB_TYPES</Tables><FieldNames>JTX_JOBS.PERC_COMPLETE,JTX_JOB_TYPES.JOB_TYPE_NAME</FieldNames><FieldDescs>Percentage Complete,Job Type Name</FieldDescs><UserWhereClause/><SysWhereClause>JTX_JOB_TYPES.JOB_TYPE_ID=JTX_JOBS.JOB_TYPE_ID</SysWhereClause><OrderBy/><GroupByFields>JTX_JOBS.PERC_COMPLETE,JTX_JOB_TYPES.JOB_TYPE_NAME</GroupByFields><AggregateField>JTX_JOBS.JOB_ID</AggregateField><AggregateFieldAlias>Total Jobs</AggregateFieldAlias><ReportGroupingAggregateLabel>Overall Total</ReportGroupingAggregateLabel><TokenParse>-1</TokenParse><ReportGroupingEnabled>50</ReportGroupingEnabled><ReportAggregateFunction>3</ReportAggregateFunction><RowAggregateFunction>4</RowAggregateFunction><QueryEditMode>0</QueryEditMode><QualifierPrefix>ps_102.DBO.</QualifierPrefix></Query><Item1 xsi:type="typens:JTXReport" GUID="{EFB3D9A9-C11C-442E-964C-7D4B2112F95C}" LastModified="40295.8228356481"><ID>2</ID><ReportQueryID>2</ReportQueryID><Name>Resource Availability Report</Name><Stylesheet>&lt;?xml version="1.0" encoding="utf-16"?&gt;

&lt;xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"&gt;
  &lt;xsl:output method="html" version="4.0" encoding="utf-16" indent="yes"/&gt;

  &lt;!-- ******************************* --&gt;
  &lt;!-- TEMPLATE:/ --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;xsl:template match="/"&gt;
    &lt;HTML&gt;
      &lt;BODY&gt;
        &lt;DIV style="margin:0in 0.15in 0.75in 0.15in"&gt;
          &lt;xsl:apply-templates select="REPORT"/&gt;
        &lt;/DIV&gt;
        &lt;xsl:apply-templates select="REPORT/GROUPS"/&gt;
      &lt;/BODY&gt;
    &lt;/HTML&gt;
  &lt;/xsl:template&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;



  &lt;!-- ******************************* --&gt;
  &lt;!-- TEMPLATE:REPORT --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;xsl:template match="REPORT"&gt;
    &lt;H1 style="margin-left:0.05in; position:relative; top:-6; text-align:center; font-weight:bold; font-size:18; font-family:Verdana,sans-serif; color:#006400"&gt;
      &lt;xsl:value-of select="@title"/&gt;
    &lt;/H1&gt;
    &lt;H3&gt;
      &lt;xsl:value-of select="@description"/&gt;
    &lt;/H3&gt;
  &lt;/xsl:template&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;



  &lt;!-- ******************************* --&gt;
  &lt;!-- TEMPLATE:COLUMNS --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;xsl:template match="COLUMNS"&gt;
    &lt;tr style="color:#FFFFFF; background-color:#6495ED"&gt;
      &lt;xsl:for-each select="COLUMN"&gt;
        &lt;th align="center"&gt;
          &lt;xsl:value-of select="."/&gt;
        &lt;/th&gt;
      &lt;/xsl:for-each&gt;
    &lt;/tr&gt;
  &lt;/xsl:template&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;



  &lt;!-- ******************************* --&gt;
  &lt;!-- TEMPLATE:ROWS --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;xsl:template match="ROW"&gt;
    &lt;tr&gt;
      &lt;xsl:attribute name="BGCOLOR"&gt;
        &lt;xsl:choose&gt;
          &lt;xsl:when test="position() mod 2 = 1"&gt;#DBDBDB&lt;/xsl:when&gt;
          &lt;xsl:when test="position() mod 2 = 0"&gt;#FFFFFF&lt;/xsl:when&gt;
        &lt;/xsl:choose&gt;
      &lt;/xsl:attribute&gt;

      &lt;!-- First value should go under column 2 if using report grouping --&gt;
      &lt;xsl:if test="string(../@value)"&gt;
        &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"/&gt;
      &lt;/xsl:if&gt;

      &lt;xsl:for-each select="VALUE"&gt;
        &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"&gt;
          &lt;xsl:value-of select="."/&gt;
        &lt;/td&gt;
      &lt;/xsl:for-each&gt;
    &lt;/tr&gt;
  &lt;/xsl:template&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;



  &lt;!-- ******************************* --&gt;
  &lt;!-- TEMPLATE:GROUPS --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;xsl:template match="GROUPS"&gt;
    &lt;xsl:apply-templates select="GROUP"/&gt;
  &lt;/xsl:template&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;



  &lt;!-- ******************************* --&gt;
  &lt;!-- TEMPLATE:GROUPS --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;xsl:template match="GROUP"&gt;
    &lt;DIV style="font-family:Verdana,sans-serif; line-height:135%; color:#191970; margin:0in 0.15in 0.75in 0.15in"&gt;
      &lt;xsl:variable name="aggregate_label"&gt;
        &lt;xsl:value-of select="@aggregate_label"/&gt;
      &lt;/xsl:variable&gt;
      &lt;xsl:variable name="aggregate_value"&gt;
        &lt;xsl:value-of select="@aggregate_value"/&gt;
      &lt;/xsl:variable&gt;

      &lt;table cellpadding="4" style="position:relative; top:-10; valign:top; table-layout:fixed;border-collapse:collapse; border:2px solid #6495ED"&gt;
        &lt;!-- Display the column headers --&gt;
        &lt;xsl:apply-templates select="//REPORT/COLUMNS"/&gt;

        &lt;!-- Place the report group value on its own row --&gt;
        &lt;xsl:if test="string(@value)"&gt;
          &lt;tr style="color:#000000; background-color:#FCBA7A"&gt;
            &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"&gt;
              &lt;xsl:value-of select="@value"/&gt;
            &lt;/td&gt;
          &lt;/tr&gt;
        &lt;/xsl:if&gt;

        &lt;!-- Display rows --&gt;
        &lt;xsl:apply-templates select="ROW"/&gt;

        &lt;!-- Write the group summary row if using report grouping --&gt;
        &lt;xsl:if test="string(@value) and string(@aggregate_label) and string(@aggregate_value)"&gt;
          &lt;tr BGCOLOR='#B8DEFA'&gt;
            &lt;xsl:for-each select="//REPORT/COLUMNS/COLUMN"&gt;
              &lt;xsl:if test="position()=1 and position()=last()"&gt;
                &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"&gt;
                  &lt;b&gt;
                    &lt;xsl:value-of select="$aggregate_label"/&gt;:&lt;xsl:text&gt;&amp;#32;&lt;/xsl:text&gt;&lt;xsl:value-of select="$aggregate_value"/&gt;
                  &lt;/b&gt;
                &lt;/td&gt;
              &lt;/xsl:if&gt;
              &lt;xsl:if test="position()=1 and position()!=last()"&gt;
                &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"&gt;
                  &lt;b&gt;
                    &lt;xsl:value-of select="$aggregate_label"/&gt;:&lt;xsl:text&gt;&amp;#32;&lt;/xsl:text&gt;
                  &lt;/b&gt;
                &lt;/td&gt;
              &lt;/xsl:if&gt;
              &lt;xsl:if test="position()!=1 and position()!=last()"&gt;
                &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"/&gt;
              &lt;/xsl:if&gt;
              &lt;xsl:if test="position()!=1 and position()=last()"&gt;
                &lt;td style="text-align:center;font-weight:bold; font-size:11pt; border:1px solid gray"&gt;
                  &lt;b&gt;
                    &lt;xsl:value-of select="$aggregate_value"/&gt;
                  &lt;/b&gt;
                &lt;/td&gt;
              &lt;/xsl:if&gt;
            &lt;/xsl:for-each&gt;
          &lt;/tr&gt;
        &lt;/xsl:if&gt;
        
      &lt;/table&gt;
    &lt;/DIV&gt;
  &lt;/xsl:template&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;
  &lt;!-- ******************************* --&gt;

&lt;/xsl:stylesheet&gt;</Stylesheet><Title>Resource Availability Report</Title><Description>This report categorizes the jobs assigned to users in your system</Description><Hierarchy>General Reports</Hierarchy><ReportQuery GUID="{13DEF855-B704-4D46-800C-28393442ECE3}" LastModified="40295.8228356481"/></Item1><ReportQuery xsi:type="typens:JTXReportQuery" GUID="{13DEF855-B704-4D46-800C-28393442ECE3}" LastModified="40295.8228356481"><ID>2</ID><Query GUID="{470BADD4-0102-4D15-B297-41D5B1F4CE2B}" LastModified="2.44766612545884E-307"/></ReportQuery><Query xsi:type="typens:JTXQuery" GUID="{470BADD4-0102-4D15-B297-41D5B1F4CE2B}" LastModified="2.44766612545884E-307"><Tables>JTX_USERS,JTX_JOBS,JTX_JOB_TYPES</Tables><FieldNames>JTX_USERS.FULL_NAME,JTX_JOB_TYPES.JOB_TYPE_NAME</FieldNames><FieldDescs>Assigned To,Job Type Name</FieldDescs><UserWhereClause/><SysWhereClause>JTX_USERS.USERNAME=JTX_JOBS.ASSIGNED_TO AND JTX_JOB_TYPES.JOB_TYPE_ID=JTX_JOBS.JOB_TYPE_ID</SysWhereClause><OrderBy/><GroupByFields>JTX_USERS.FULL_NAME,JTX_JOB_TYPES.JOB_TYPE_NAME</GroupByFields><AggregateField>JTX_JOBS.JOB_ID</AggregateField><AggregateFieldAlias>Total Jobs</AggregateFieldAlias><ReportGroupingAggregateLabel>Summary</ReportGroupingAggregateLabel><TokenParse>-1</TokenParse><ReportGroupingEnabled>45</ReportGroupingEnabled><ReportAggregateFunction>3</ReportAggregateFunction><RowAggregateFunction>4</RowAggregateFunction><QueryEditMode>0</QueryEditMode><QualifierPrefix>ps_102.DBO.</QualifierPrefix></Query><TAMWorkflows xsi:type="typens:JTXTaskAssistantWorkflowRecordSet" GUID="{35EC43A2-CD96-47FE-932A-6CB033D9404D}" LastModified="0"><Count>0</Count></TAMWorkflows><ReplicationNodes xsi:type="typens:JTXReplicationNodeSet" GUID="{49F1D7C5-A8D1-449E-B7F4-DE335BD26D60}" LastModified="0"><Count>0</Count></ReplicationNodes><ObjectPermissions xsi:type="typens:JTXObjectPermissionSet" GUID="{805C72D0-6927-4B1C-B7CC-7048364DFF97}" LastModified="0"><Count>0</Count></ObjectPermissions></jtxexport>