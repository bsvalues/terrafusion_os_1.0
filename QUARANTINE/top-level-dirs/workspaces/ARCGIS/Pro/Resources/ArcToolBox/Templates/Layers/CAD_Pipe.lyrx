      "layerType" : "Operational",
      "showLegends" : true,
      "visibility" : true,
      "displayCacheType" : "Permanent",
      "maxDisplayCacheAge" : 5,
      "popupInfo" : {
        "type" : "CIMPopupInfo",
        "title" : "{aec_Network} - {aec_Name}",
        "expressionInfos" : [
          {
            "type" : "CIMExpressionInfo",
            "title" : "StartStation",
            "expression" : "var StationlbR = Text($feature.aec_StartSta, '00.00' );  //formatting with decimals after the + sign - if there is not \nvar StationlbL = Text(First(Split($feature.aec_StartSta/100, '.',1)), '###00' )  //Getting rid of the two initial character dividing by 100. formatting result with 2 zeros and room for more characters\n\nIIf(IsEmpty($feature.aec_StartSta), '<Null>', Concatenate([StationlbL, StationlbR], '+'))",
            "name" : "StartStation",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "EndStation",
            "expression" : "var StationlbR = Text($feature.aec_EndSta, '00.00' );  //formatting with decimals after the + sign - if there is not \nvar StationlbL = Text(First(Split($feature.aec_EndSta/100, '.',1)), '###00' )  //Getting rid of the two initial character dividing by 100. formatting result with 2 zeros and room for more characters\n\nIIf(IsEmpty($feature.aec_EndSta), '<Null>', Concatenate([StationlbL, StationlbR], '+'))",
            "name" : "EndStation",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "BearingDegree",
            "expression" : "//This function converts the values from Degrees to Degrees, Minutes and Seconds. \n//If the values shown in the PopUp don't match with those in Civil 3D, check the documentation for the Arcade function ConvertDirection, because a parameter might need to be changed.\n\nIF ($feature.aec_Bearing != Null) {\n\nConvertDirection( Round($feature.aec_Bearing,  6) , {directionType:'North', angleType: 'Degrees'}, {directionType: 'quadrant', angleType: 'DMS', outputType: 'Text'})\n\n}",
            "name" : "BearingDegree",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "Custom",
            "expression" : "//This function converts the values from Degrees to Degrees, Minutes and Seconds. \n//If the values shown in the PopUp don't match with those in Civil 3D, check the documentation for the Arcade function ConvertDirection, because a parameter might need to be changed.\n\nIF ($feature.aec_StartDirect != Null) {\n\nConvertDirection( Number($feature.aec_StartDirect), {directionType:'Polar', angleType: 'Degrees'}, {directionType: 'Quadrant', angleType: 'DMS', outputType: 'Text'})\n\n}\n\n\n",
            "name" : "StartDirection",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "Custom",
            "expression" : "//This function converts the values from Degrees to Degrees, Minutes and Seconds. \n//If the values shown in the PopUp don't match with those in Civil 3D, check the documentation for the Arcade function ConvertDirection, because a parameter might need to be changed.\n\nIF ($feature.aec_EndDirect != Null) {\n\nConvertDirection( Number($feature.aec_EndDirect), {directionType:'Polar', angleType: 'Degrees'}, {directionType: 'Quadrant', angleType: 'DMS', outputType: 'Text'})\n\n}",
            "name" : "EndDirection",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "Slope",
            "expression" : "Text($feature.aec_Slop,'#####.00%')",
            "name" : "Slope",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "SlopStrt",
            "expression" : "Text($feature.aec_SlopStrt,'#####.00%')",
            "name" : "SlopStrt",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "SlopEnd",
            "expression" : "Text($feature.aec_SlopEnd,'#####.00%')",
            "name" : "SlopEnd",
            "returnType" : "String"
          }
        ],
        "mediaInfos" : [
          {
            "type" : "CIMTextMediaInfo",
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 2,
            "text" : "<table> <tr> <h3>Property</h3> <th></th> </tr> \n<tr> <td><strong>Network:</strong></td> <td>{aec_Network}</td> </tr> \n<tr> <td><strong>Name:</strong></td> <td>{aec_Name}</td> </tr> \n<tr> <td><strong>Description:</strong></td> <td>{aec_Desc}</td> </tr> \n<tr> <td><strong>Style:</strong></td> <td>{aec_Style}</td> </tr>\n<tr> <td><strong>Status:</strong></td> <td>{aec_Status}</td> </tr>\n<tr> <td><strong>Shape:</strong></td> <td>{aec_Shape}</td> </tr>\n<tr> <td><strong>Inner Diameter:</strong></td> <td>{aec_InnDia}</td> </tr>\n<tr> <td><strong>Inner Width:</strong></td> <td>{aec_InnWid}</td> </tr>\n<tr> <td><strong>Inner Height:</strong></td> <td>{aec_InnHei}</td> </tr>\n<tr> <td><strong>Slope:</strong></td> <td>{expression/Slope}</td> </tr>\n<tr> <td><strong>Bearing Degrees:</strong></td> <td>{expression/BearingDegree}</td> </tr></table>"
          },
          {
            "type" : "CIMTextMediaInfo",
            "row" : 1,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "text" : "<table> <tr> <th>Property</th> <th>Value</th> </tr> \n<tr> <td><strong>Reference Alignment:</strong></td> <td>{aec_RefAlign}</td> </tr>\n<tr> <td><strong>Start Offset:</strong></td> <td>{aec_StartOffst}</td> </tr>\n<tr> <td><strong>Start Station:</strong></td> <td>{expression/StartStation}</td> </tr>\n<tr> <td><strong>End Station:</strong></td> <td>{expression/EndStation}</td> </tr>\n<tr> <td><strong>End Offset:</strong></td> <td>{aec_EndOffst}</td> </tr>\n<tr> <td><strong>Reference Surface:</strong></td> <td>{aec_RefSurf}</td> </tr>\n<tr> <td><strong>Slope (Hold Start):</strong></td> <td>{expression/SlopStrt}</td> </tr>\n<tr> <td><strong>Slope (Hold End):</strong></td> <td>{expression/SlopEnd}</td> </tr>\n<tr> <td><strong>Slope:</strong></td> <td>{expression/Slope}</td> </tr>\n<tr> <td><strong>Start Structure:</strong></td> <td>{aec_StrtStrc}</td> </tr>\n<tr> <td><strong>Start Northing:</strong></td> <td>{aec_StrtNorth}</td> </tr>\n<tr> <td><strong>Start Easting:</strong></td> <td>{aec_StrtEast}</td> </tr>\n<tr> <td><strong>Start Invert Elevation:</strong></td> <td>{aec_StrtInvElev}</td> </tr>\n<tr> <td><strong>Start Centerline Elevation:</strong></td> <td>{aec_StrtCtlnElev}</td> </tr>\n<tr> <td><strong>Start Crown Elevation:</strong></td> <td>{aec_StrtCrwnElev}</td> </tr>\n<tr> <td><strong>End Structure:</strong></td> <td>{aec_EndStrc}</td> </tr>\n<tr> <td><strong>End Northing:</strong></td> <td>{aec_EndNorth}</td> </tr>\n<tr> <td><strong>End Easting:</strong></td> <td>{aec_EndEast}</td> </tr>\n<tr> <td><strong>End Invert Elevation:</strong></td> <td>{aec_EndInvElev}</td> </tr>\n<tr> <td><strong>End Centerline Elevation:</strong></td> <td>{aec_EndCtlnElev}</td> </tr>\n<tr> <td><strong>End Crown Elevation:</strong></td> <td>{aec_EndCrwnElev}</td> </tr>\n</table>"
          },
          {
            "type" : "CIMTextMediaInfo",
            "row" : 1,
            "column" : 1,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "text" : "<table> <tr> <th>Property</th> <th>Value</th> </tr> \n<tr> <td><strong>2D Length - Center to Center:</strong></td> <td>{aec_2DLenCC}</td> </tr>\n<tr> <td><strong>3D Length - Center to Center:</strong></td> <td>{aec_3DLenCC}</td> </tr>\n<tr> <td><strong>2D Length - To Inside Edge:</strong></td> <td>{aec_2DLenIE}</td> </tr>\n<tr> <td><strong>3D Length - To Inside Edge:</strong></td> <td>{aec_3DLenIE}</td> </tr>\n<tr> <td><strong>Bearing Degrees:</strong></td> <td>{expression/BearingDegree}</td> </tr>\n<tr> <td><strong>Start Direction:</strong></td> <td>{expression/StartDirection}</td> </tr>\n<tr> <td><strong>End Direction:</strong></td> <td>{expression/EndDirection}</td> </tr>\n<tr> <td><strong>Radius:</strong></td> <td>{aec_Radius}</td> </tr>\n<tr> <td><strong>Flow Direction:</strong></td> <td>{aec_FlowDirect}</td> </tr>\n<tr> <td><strong>Flow Method:</strong></td> <td>{aec_FlowMeth}</td> </tr>\n<tr> <td><strong>Start Cover:</strong></td> <td>{aec_StrtCover}</td> </tr>\n<tr> <td><strong>End Cover:</strong></td> <td>{aec_EndCover}</td> </tr>\n<tr> <td><strong>Chord Length:</strong></td> <td>{aec_ChrdLen}</td> </tr>\n<tr> <td><strong>Radius Point Northing:</strong></td> <td>{aec_RadPtNorth}</td> </tr>\n<tr> <td><strong>Radius Point Easting:</strong></td> <td>{aec_RadPtEast}</td> </tr>\n<tr> <td><strong>HGL Up:</strong></td> <td>{aec_HGLUp}</td> </tr>\n<tr> <td><strong>HGL Down:</strong></td> <td>{aec_HGLDown}</td> </tr>\n<tr> <td><strong>EGL Up:</strong></td> <td>{aec_EGLUp}</td> </tr>\n<tr> <td><strong>EGL Down:</strong></td> <td>{aec_EGLDown}</td> </tr>\n<tr> <td><strong>Rule Set:</strong></td> <td>{aec_RulSet}</td> </tr>\n<tr> <td><strong>Override:</strong></td> <td>{aec_OverRulSet}</td> </tr>\n<tr> <td><strong>Render Material:</strong></td> <td>{aec_RendMat}</td> </tr>\n</table>"
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 2,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 2,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var aDict = Schema($feature);\nvar aArray = aDict['fields'];\nvar output = \"<table><h2>Property Sets</h2>\"\nvar p = 0\nfor (var i in $feature){\n    if (!isEmpty($feature[i]) \n        && $feature[i] != 0 \n        && $feature[i] != '-' \n        && Find('aec_',i,0) == -1\n        && i != 'OBJECTID'\n        && i != 'BlkColor'\n        && i != 'BlkLinetype'\n        && i != 'BlkLineWt'\n        && i != 'Color'\n        && i != 'DocId'\n        && i != 'DocName'\n        && i != 'DocPath'\n        && i != 'DocType'\n        && i != 'DocUpdate'\n        && i != 'DocVer'\n        && i != 'Elevation'\n        && i != 'EntColor'\n        && i != 'Entity'\n        && i != 'EntLinetype'\n        && i != 'EntLineWt'\n        && i != 'ExtX'\n        && i != 'ExtY'\n        && i != 'ExtZ'\n        && i != 'Handle'\n        && i != 'IsSimulated'\n        && i != 'Layer'\n        && i != 'Linetype'\n        && i != 'LineWt'\n        && i != 'LTScale'\n        && i != 'LyrColor'\n        && i != 'LyrFrzn'\n        && i != 'LyrHandle'\n        && i != 'LyrLineWt'\n        && i != 'LyrLnType'\n        && i != 'LyrLock'\n        && i != 'LyrOn'\n        && i != 'LyrVPFrzn'\n        && i != 'OID'\n        && i != 'RefName'\n        && i != 'SharedView'\n        && i != 'SharedVer')  {\n           for (var j in aArray) {\n             var dict = aArray[j];\n             if (dict['name'] == i) {\n               output  += \"<tr><td><B>\" + Replace(Split(dict['alias'], ' ',2)[1],'_',' ') + \"  :  \" + \"</B>\" + \"</td><td>\" + $feature[i] +  \"</td></tr>\"\n               p++\n             }\n    }    \n    }\n}\nif (p>0) {\nreturn { \n      type : 'text', \n      text : output + \"</table>\"\n// this property supports html tags \n}\n}",
              "returnType" : "Default"
            }
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 3,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 2,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var returnstring = \"<table><h2>BIM Cloud Connection</h2>\" \nvar p = 0\nfor (var i in $feature) {\n    if (!isEmpty($feature[i]) &&  i == 'SharedView')  {\n        returnstring = returnstring + \"<tr><td><B>\" + i + \": \"+ \"</B>\" + \"</td><td>\" + IIf(i == 'SharedView', \"<p><a href=\" +  $feature[i]  + \">URL</a> </p>\", $feature[i])  + \"</td></tr>\"\np++\n    }\n}\nif (p>0) {\nreturn { \n      type : 'text', \n      text : returnstring + \"</table>\" \n       }\n}\n\n//Expression to show the SharedView file, when exist. And to open file in the BIM site using the URL",
              "returnType" : "Default"
            }
          }
        ],
        "gridLayout" : {
