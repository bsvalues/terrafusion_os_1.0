            {
              "type" : "CIMPrimitiveOverride",
              "primitiveName" : "ca4f78a9-bf52-4a6f-97d0-a7bb8c6ef594",
              "propertyName" : "StrokeColor",
              "valueExpressionInfo" : {
                "type" : "CIMExpressionInfo",
                "title" : "Custom",
                "expression" : "if (Find('SS',$feature.aec_Style,0) != -1 ) {\n    return \"#800080\"       //Purple\n}\nif (Find('STRM',$feature.aec_Style,0) != -1 ) {\n    return \"#0000FF\"       //Blue\n}\nif (Find('Sanitary',$feature.aec_Style,0) != -1 ) {\n    return \"#800080\"       //Purple\n}\nif (Find('Storm',$feature.aec_Style,0) != -1 ) {\n    return \"#0000FF\"       //Blue\n}\nif (Find('SANITARY',$feature.aec_Style,0) != -1 ) {\n    return \"#800080\"       //Purple\n}\nif (Find('STORM',$feature.aec_Style,0) != -1 ) {\n    return \"#0000FF\"       //Blue\n}",
                "returnType" : "Default"
              }
            },
            {
