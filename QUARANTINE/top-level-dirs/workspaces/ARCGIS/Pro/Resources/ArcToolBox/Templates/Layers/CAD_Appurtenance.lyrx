  "layers" : [
    "CIMPATH=Map/Appurtenance.json"
  ],
  "layerDefinitions" : [
    {
      "type" : "CIMFeatureLayer",
      "name" : "Appurtenance",
      "uRI" : "CIMPATH=Map/Appurtenance.json",
      "sourceModifiedTime" : {
        "type" : "TimeInstant"
      },
      "useSourceMetadata" : true,
      "description" : "Appurtenance",
      "layerElevation" : {
        "type" : "CIMLayerElevationSurface"
      },
      "layer3DProperties" : {
        "type" : "CIM3DLayerProperties",
        "castShadows" : true,
        "isLayerLit" : true,
        "layerFaceCulling" : "None",
        "maxDistance" : -1,
        "minDistance" : -1,
        "preloadTextureCutoffHigh" : 0,
        "preloadTextureCutoffLow" : 0.25,
        "textureCutoffHigh" : 0.25,
        "textureCutoffLow" : 1,
        "useCompressedTextures" : true,
        "verticalExaggeration" : 1,
        "exaggerationMode" : "ScaleZ",
        "verticalUnit" : {
          "uwkid" : 9003
        },
        "lighting" : "OneSideDataNormal",
        "optimizeMarkerTransparency" : true
      },
      "layerType" : "Operational",
      "showLegends" : true,
      "visibility" : true,
      "displayCacheType" : "Permanent",
      "maxDisplayCacheAge" : 5,
      "popupInfo" : {
        "type" : "CIMPopupInfo",
        "title" : "{aec_Network} - {aec_Name}",
        "expressionInfos" : [
          {
            "type" : "CIMExpressionInfo",
            "title" : "Custom",
            "expression" : "var StationlbR = Text($feature.aec_Station, '00.00' );  //formatting with decimals after the + sign - if there is not \nvar StationlbL = Text(First(Split($feature.aec_Station/100, '.',1)), '###00' )  //Getting rid of the two initial character dividing by 100. formatting result with 2 zeros and room for more characters\n\nIIf(IsEmpty($feature.aec_Station), '<Null>', Concatenate([StationlbL, StationlbR], '+'))",
            "name" : "MyStation",
            "returnType" : "String"
          }
        ],
        "mediaInfos" : [
          {
            "type" : "CIMTextMediaInfo",
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "text" : "<table> <tr> <h3>Property</h3> <th></th> </tr> \n<tr> <td><strong>Network:</strong></td> <td>{aec_Network}</td> </tr> \n<tr> <td><strong>Name:</strong></td> <td>{aec_Name}</td> </tr> \n<tr> <td><strong>Description:</strong></td> <td>{aec_Desc}</td> </tr> \n<tr> <td><strong>Style:</strong></td> <td>{aec_Style}</td> </tr>\n<tr> <td><strong>Render Material:</strong></td> <td>{aec_RendMat}</td> </tr>\n<tr> <td><strong>Nominal Diameter Description:</strong></td> <td>{aec_NomDia}</td> </tr>\n<tr> <td><strong>Reference Alignment:</strong></td> <td>{aec_RefAlign}</td> </tr>\n<tr> <td><strong>Reference Surface:</strong></td> <td>{aec_RefSurf}</td> </tr>\n<tr> <td><strong>Station:</strong></td> <td>{expression/MyStation}</td> </tr>\n<tr> <td><strong>Offset:</strong></td> <td>{aec_Offset}</td> </tr>\n<tr> <td><strong>Insertion Point Northing:</strong></td> <td>{aec_InsPtNorth}</td> </tr>\n<tr> <td><strong>Insertion Point Easting:</strong></td> <td>{aec_InsPtEast}</td> </tr>\n<tr> <td><strong>Insertion Point Elevation:</strong></td> <td>{aec_InsPtElv}</td> </tr></table>"
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 1,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var aDict = Schema($feature);\nvar aArray = aDict['fields'];\nvar output = \"<table><h2>Property Sets</h2>\"\nvar p = 0\nfor (var i in $feature){\n    if (!isEmpty($feature[i]) \n        && $feature[i] != 0 \n        && $feature[i] != '-' \n        && Find('aec_',i,0) == -1\n        && i != 'OBJECTID'\n        && i != 'BlkColor'\n        && i != 'BlkLinetype'\n        && i != 'BlkLineWt'\n        && i != 'Color'\n        && i != 'DocId'\n        && i != 'DocName'\n        && i != 'DocPath'\n        && i != 'DocType'\n        && i != 'DocUpdate'\n        && i != 'DocVer'\n        && i != 'Elevation'\n        && i != 'EntColor'\n        && i != 'Entity'\n        && i != 'EntLinetype'\n        && i != 'EntLineWt'\n        && i != 'ExtX'\n        && i != 'ExtY'\n        && i != 'ExtZ'\n        && i != 'Handle'\n        && i != 'Layer'\n        && i != 'Linetype'\n        && i != 'LineWt'\n        && i != 'LTScale'\n        && i != 'LyrColor'\n        && i != 'LyrFrzn'\n        && i != 'LyrHandle'\n        && i != 'LyrLineWt'\n        && i != 'LyrLnType'\n        && i != 'LyrLock'\n        && i != 'LyrOn'\n        && i != 'LyrVPFrzn'\n        && i != 'OID'\n        && i != 'RefName'\n        && i != 'Thickness'\n        && i != 'Angle'\n        && i != 'ScaleX'\n        && i != 'ScaleY'\n        && i != 'ScaleZ'\n        && i != 'SharedView'\n        && i != 'SharedVer')  {\n           for (var j in aArray) {\n             var dict = aArray[j];\n             if (dict['name'] == i) {\n               output  += \"<tr><td><B>\" + Replace(Split(dict['alias'], ' ',2)[1],'_',' ') + \"  :  \" + \"</B>\" + \"</td><td>\" + $feature[i] +  \"</td></tr>\"\n               p++\n             }\n    }    \n    }\n}\n\nif (p>0) {\nreturn { \n      type : 'text', \n      text : output + \"</table>\"\n// this property supports html tags \n}\n}",
              "returnType" : "Default"
            }
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 2,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var returnstring = \"<table><h2>BIM Cloud Connection</h2>\" \nvar p = 0\nfor (var i in $feature) {\n    if (!isEmpty($feature[i]) &&  i == 'SharedView')  {\n        returnstring = returnstring + \"<tr><td><B>\" + i + \": \"+ \"</B>\" + \"</td><td>\" + IIf(i == 'SharedView', \"<p><a href=\" +  $feature[i]  + \">URL</a> </p>\", $feature[i])  + \"</td></tr>\"\np++\n    }\n}\nif (p>0) {\nreturn { \n      type : 'text', \n      text : returnstring + \"</table>\" \n       }\n}\n\n//Expression to show the SharedView file, when exist. And to open file in the BIM site using the URL",
              "returnType" : "Default"
            }
          }
        ],
        "gridLayout" : {
          "type" : "CIMPopupLayout",
          "columnWidths" : [
            100
          ],
          "borderWidth" : 2,
          "borderColor" : {
            "type" : "CIMRGBColor",
            "values" : [
              0,
              169,
              230,
              100
            ]
          }
        }
      },
