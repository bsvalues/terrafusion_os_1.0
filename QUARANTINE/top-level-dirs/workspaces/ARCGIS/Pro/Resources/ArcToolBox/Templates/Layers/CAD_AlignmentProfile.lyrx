{
  "type" : "CIMLayerDocument",
  "version" : "3.4.0",
  "build" : 53876,
  "layers" : [
    "CIMPATH=Map/AlignmentProfile.json"
  ],
  "layerDefinitions" : [
    {
      "type" : "CIMFeatureLayer",
      "name" : "AlignmentProfile",
      "uRI" : "CIMPATH=Map/AlignmentProfile.json",
      "sourceModifiedTime" : {
        "type" : "TimeInstant"
      },
      "useSourceMetadata" : true,
      "description" : "AlignmentProfile",
      "layerElevation" : {
        "type" : "CIMLayerElevationSurface"
      },
      "layer3DProperties" : {
        "type" : "CIM3DLayerProperties",
        "castShadows" : true,
        "isLayerLit" : true,
        "layerFaceCulling" : "None",
        "maxDistance" : -1,
        "minDistance" : -1,
        "preloadTextureCutoffHigh" : 0,
        "preloadTextureCutoffLow" : 0.25,
        "textureCutoffHigh" : 0.25,
        "textureCutoffLow" : 1,
        "useCompressedTextures" : true,
        "verticalExaggeration" : 1,
        "exaggerationMode" : "ScaleZ",
        "verticalUnit" : {
          "uwkid" : 9003
        },
        "lighting" : "OneSideDataNormal",
        "optimizeMarkerTransparency" : true
      },
      "layerType" : "Operational",
      "showLegends" : true,
      "visibility" : true,
      "displayCacheType" : "Permanent",
      "maxDisplayCacheAge" : 5,
      "popupInfo" : {
        "type" : "CIMPopupInfo",
        "title" : "{RefName}{aec_Name} - {expression/MeasureStation}",
        "expressionInfos" : [
          {
            "type" : "CIMExpressionInfo",
            "title" : "Custom",
            "expression" : "var StationlbR = Text($feature.aec_EndSta, '00.00' );  //formatting with decimals after the + sign - if there is not \nvar StationlbL = Text(First(Split($feature.aec_EndSta/100, '.',1)), '###00' )  //Getting rid of the two initial character dividing by 100. formatting result with 2 ceros and room for more characters\n\nConcatenate([StationlbL, Replace(StationlbR,'-','')], '+')",
            "name" : "MyEndStation",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "Custom",
            "expression" : "var StationlbR = Text($feature.aec_StartSta, '00.00' );  //formatting with decimals after the + sign - if there is not \nvar StationlbL = Text(First(Split($feature.aec_StartSta/100, '.',1)), '###00' )  //Getting rid of the two initial character dividing by 100. formatting result with 2 ceros and room for more characters\n\nConcatenate([StationlbL, Replace(StationlbR,'-','')], '+')",
            "name" : "MyStartStation",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "Custom",
            "expression" : "var StationlbR = Text($feature.aec_RefSta, '00.00' );  //formatting with decimals after the + sign - if there is not \nvar StationlbL = Text(First(Split($feature.aec_RefSta/100, '.',1)), '###00' )  //Getting rid of the two initial character dividing by 100. formatting result with 2 ceros and room for more characters\n\nConcatenate([StationlbL, Replace(StationlbR,'-','')], '+')",
            "name" : "MyReferenceStation",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "PropertySet",
            "expression" : "var returnstring = \"<tr> <br /> </tr>\" \n\nfor (var i in $feature) {\n    if (!isEmpty($feature[i]) \n        && $feature[i] != 0 \n        && $feature[i] != '-' \n        && Find('aec_',i,0) == -1\n        && i != 'OID'\n        && i != 'Entity'\n        && i != 'Handle'\n        && i != 'Layer'\n        && i != 'LyrFrzn'\n        && i != 'LyrLock'\n        && i != 'LyrOn'\n        && i != 'LyrVPFrzn'\n        && i != 'LyrHandle'\n        && i != 'Color'\n        && i != 'EntColor'\n        && i != 'LyrColor'\n        && i != 'BlkColor'\n        && i != 'Linetype'\n        && i != 'EntLinetype'\n        && i != 'LyrLnType'\n        && i != 'BlkLinetype'    \n        && i != 'Elevation'\n        && i != 'Thickness'\n        && i != 'LineWt'\n        && i != 'EntLineWt'\n        && i != 'LyrLineWt'\n        && i != 'BlkLineWt'\n        && i != 'RefName'    \n        && i != 'LTScale'\n        && i != 'ExtX'\n        && i != 'ExtY'\n        && i != 'ExtZ'\n        && i != 'DocName'\n        && i != 'DocPath'\n        && i != 'DocType'\n        && i != 'DocVer'\n        && i != 'DocUpdate'\n        && i != 'DocId'\n        && i != 'SharedView'\n        && i != 'SharedVer')  {\n        returnstring = returnstring + \"<tr><td><B>\" + Replace(i,'_',' ') + \": \" + \"</B>\" + \"</td><td>\" + $feature[i]  + \"</td></tr>\"\n\n    }\n}\n\nreturn returnstring \n\n//Expression to show only Property Set, when they exist and have values. Empty fields are not shown.\n\n",
            "name" : "PropertySet",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "BIMUrl",
            "expression" : "var returnstring = \"<tr>\" \nvar p = 0\nfor (var i in $feature) {\n    if (!isEmpty($feature[i]) &&  i == 'SharedView')  {\n        returnstring = returnstring + \"<td><B>\" + i + \": \"+ \"</B>\" + \"</td><td>\" + IIf(i == 'SharedView', \"<p><a href=\" +  $feature[i]  + \">URL</a> </p>\", $feature[i])  \np++\n    }\n}\nif (p>0) {\nreturn returnstring + \"</td></tr>\" \n}\n\n//Expression to show the SharedView file, when exist. And to open file in the BIM site using the URL",
            "name" : "BIMUrl",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "MeasureStation",
            "expression" : "var StationlbR = Text($feature.Measure, '00.00' );  //formatting with decimals after the + sign - if there is not \nvar StationlbL = Text(First(Split($feature.Measure/100, '.',1)), '###00' )  //Getting rid of the two initial character dividing by 100. formatting result with 2 ceros and room for more characters\n\nConcatenate([StationlbL, Replace(StationlbR,'-','')], '+')",
            "name" : "MeasureStation",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "A_Length",
            "expression" : "Text($feature.aec_EndSta - $feature.aec_StartSta, '############.00' )",
            "name" : "A_Length",
            "returnType" : "String"
          }
        ],
        "mediaInfos" : [
          {
            "type" : "CIMTextMediaInfo",
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "text" : "<table> <tr> <h3>Property</h3> <th></th> </tr> \n<tr> <td><strong>Profile Name:</strong></td> <td>{aec_ProfName}</td> </tr> \n<tr> <td><strong>Alignment Name:</strong></td> <td>{aec_Name}</td> </tr> \n<tr> <td><strong>Description:</strong></td> <td>{aec_Desc}</td> </tr>\n<tr> <td><strong>Alignment Type:</strong></td> <td>{aec_AlignType}</td> </tr>\n<tr> <td><strong>Civil 3D Style:</strong></td> <td>{aec_Style}</td> </tr>\n<tr> <td><strong>Site:</strong></td> <td>{aec_Site}</td> </tr>\n<tr> <td><strong>Reference Point X:</strong></td> <td>{aec_RefPointX}</td> </tr>\n<tr> <td><strong>Reference Point Y:</strong></td> <td>{aec_RefPointY}</td> </tr>\n<tr> <td><strong>Reference Station:</strong></td> <td>{expression/MyReferenceStation}</td> </tr>\n<tr> <td><strong>Start Station:</strong></td> <td>{expression/MyStartStation}</td> </tr>\n<tr> <td><strong>End Station:</strong></td> <td>{expression/MyEndStation}</td> </tr>\n<tr> <td><strong>Length:</strong></td> <td>{expression/A_Length}</td> </tr></table>"
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 1,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var aDict = Schema($feature);\nvar aArray = aDict['fields'];\nvar output = \"<table><h2>Property Sets</h2>\"\nvar p = 0\nfor (var i in $feature){\n    if (!isEmpty($feature[i]) \n        && $feature[i] != 0 \n        && $feature[i] != '-' \n        && Find('aec_',i,0) == -1\n        && i != 'OBJECTID'\n        && i != 'OID'\n        && i != 'Entity'\n        && i != 'Handle'\n        && i != 'Layer'\n        && i != 'LyrFrzn'\n        && i != 'LyrLock'\n        && i != 'LyrOn'\n        && i != 'LyrVPFrzn'\n        && i != 'LyrHandle'\n        && i != 'Color'\n        && i != 'EntColor'\n        && i != 'LyrColor'\n        && i != 'BlkColor'\n        && i != 'Linetype'\n        && i != 'EntLinetype'\n        && i != 'LyrLnType'\n        && i != 'BlkLinetype'    \n        && i != 'Elevation'\n        && i != 'Thickness'\n        && i != 'LineWt'\n        && i != 'EntLineWt'\n        && i != 'LyrLineWt'\n        && i != 'BlkLineWt'\n        && i != 'RefName'    \n        && i != 'LTScale'\n        && i != 'ExtX'\n        && i != 'ExtY'\n        && i != 'ExtZ'\n        && i != 'DocName'\n        && i != 'DocPath'\n        && i != 'DocType'\n        && i != 'DocVer'\n        && i != 'DocUpdate'\n        && i != 'DocId'\n        && i != 'SharedView'\n        && i != 'SharedVer')  {\n           for (var j in aArray) {\n             var dict = aArray[j];\n             if (dict['name'] == i) {\n               output  += \"<tr><td><B>\" + Replace(Split(dict['alias'], ' ',2)[1],'_',' ') + \"  :  \" + \"</B>\" + \"</td><td>\" + $feature[i] +  \"</td></tr>\"\n               p++\n             }\n    }    \n    }\n}\n\nif (p>0) {\nreturn { \n      type : 'text', \n      text : output + \"</table>\"\n// this property supports html tags \n}\n}",
              "returnType" : "Default"
            }
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 2,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var returnstring = \"<table><h2>BIM Cloud Connection</h2>\" \nvar p = 0\nfor (var i in $feature) {\n    if (!isEmpty($feature[i]) &&  i == 'SharedView')  {\n        returnstring = returnstring + \"<tr><td><B>\" + i + \": \"+ \"</B>\" + \"</td><td>\" + IIf(i == 'SharedView', \"<p><a href=\" +  $feature[i]  + \">URL</a> </p>\", $feature[i])  + \"</td></tr>\"\np++\n    }\n}\nif (p>0) {\nreturn { \n      type : 'text', \n      text : returnstring + \"</table>\" \n       }\n}\n\n//Expression to show the SharedView file, when exist. And to open file in the BIM site using the URL",
              "returnType" : "Default"
            }
          }
        ],
        "gridLayout" : {
          "type" : "CIMPopupLayout",
          "columnWidths" : [
            100
          ],
          "borderWidth" : 2,
          "borderColor" : {
            "type" : "CIMRGBColor",
            "values" : [
              0,
              169,
              230,
              100
            ]
          }
        }
      },
