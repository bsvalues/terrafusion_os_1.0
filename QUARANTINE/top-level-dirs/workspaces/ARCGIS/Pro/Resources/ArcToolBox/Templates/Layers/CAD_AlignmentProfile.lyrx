                        "valueExpressionInfo" : {
                          "type" : "CIMExpressionInfo",
                          "title" : "Custom",
                          "expression" : "if ($feature.aec_Style != \"Offsets\" || $feature.aec_AlignType != \"Offset\") {\n//##00+00.00 - This function will provide this format regardless the length of the field\n\nvar StationlbR = Text($measure, '00.00' );  //formatting with decimals after the + sign - if there is not \nvar StationlbL = Text(First(Split($measure/100, '.',1)), '###00' )  //Getting rid of the two initial character dividing by 100. formatting result with 2 ceros and room for more characters\n\nConcatenate([StationlbL, StationlbR], '+')  //using the Find function to extract from the second character from the left of the decimal point.\n\n}",
                          "returnType" : "Default"
                        }
                      }
