                      "propertyName" : "Color",
                      "valueExpressionInfo" : {
                        "type" : "CIMExpressionInfo",
                        "title" : "Custom",
                        "expression" : "if ($feature.aec_Style == 'Basic' ) {\n    return \"#808080\"       //Dark Gray\n}\nif ($feature.aec_Style == 'Existing' ) {\n    return \"#FF0000\"       //Red\n}\nif ($feature.aec_Style == 'Intersection Basic' ) {\n    return \"#808080\"       //Dark Gray\n}\nif ($feature.aec_Style == 'Layout' ) {\n    return \"#FF0000\"       //Red\n}\nif ($feature.aec_Style == 'Offsets' ) {\n    return  \"#C0C0C0\"       //Light Gray\n}\nif ($feature.aec_Style == 'Proposed' ) {\n    return  \"#008000\"       //Green\n}",
                        "returnType" : "Default"
                      }
                    },
                    {
                      "type" : "CIMPrimitiveOverride",
                      "primitiveName" : "e2bb4d49-acf3-4ca4-80e4-c253acb2a7fc",
                      "propertyName" : "TextString",
                      "valueExpressionInfo" : {
                        "type" : "CIMExpressionInfo",
                        "title" : "Custom",
                        "expression" : "if ($feature.aec_Style != \"Offsets\" || $feature.aec_AlignType != \"Offset\") {\n//##00+00.00 - This function will provide this format regardless the length of the field\n\nvar StationlbR = Text($measure, '00.00' );  //formatting with decimals after the + sign - if there is not \nvar StationlbL = Text(First(Split($measure/100, '.',1)), '###00' )  //Getting rid of the two initial character dividing by 100. formatting result with 2 ceros and room for more characters\n\nConcatenate([StationlbL, Replace(StationlbR,'-','')], '+')  //using the Find function to extract from the second character from the left of the decimal point.\n\n}",
                        "returnType" : "Default"
                      }
                    },
                    {
                      "type" : "CIMPrimitiveOverride",
                      "primitiveName" : "16d17e90-43fc-4ff4-97af-e23a6d4d22ea",
                      "propertyName" : "TextString",
                      "valueExpressionInfo" : {
                        "type" : "CIMExpressionInfo",
                        "title" : "Custom",
                        "expression" : "if ($feature.aec_Style != \"Offsets\" || $feature.aec_AlignType != \"Offset\") {\n//##00+00.00 - This function will provide this format regardless the length of the field\n\nvar StationlbR = Text($measure, '00.00' );  //formatting with decimals after the + sign - if there is not \nvar StationlbL = Text(First(Split($measure/100, '.',1)), '###00' )  //Getting rid of the two initial character dividing by 100. formatting result with 2 ceros and room for more characters\n\nConcatenate([StationlbL, Replace(StationlbR,'-','')], '+')  //using the Find function to extract from the second character from the left of the decimal point.\n\n}",
                        "returnType" : "Default"
                      }
                    }
