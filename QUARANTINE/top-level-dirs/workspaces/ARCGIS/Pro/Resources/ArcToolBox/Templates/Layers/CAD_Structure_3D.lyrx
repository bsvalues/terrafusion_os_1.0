          "maxAlpha" : 100
        },
        "defaultLabel" : "<all other values>",
        "defaultSymbol" : {
          "type" : "CIMSymbolReference",
          "primitiveOverrides" : [
            {
              "type" : "CIMPrimitiveOverride",
              "primitiveName" : "84722d19-79d1-4206-a365-ebc667b15c84",
              "propertyName" : "TintColor",
              "valueExpressionInfo" : {
                "type" : "CIMExpressionInfo",
                "title" : "Custom",
                "expression" : "if (Find('SS',$feature.aec_Style,0) != -1 ) {\n    return \"#800080\"       //Purple\n}\nif (Find('STRM',$feature.aec_Style,0) != -1 ) {\n    return \"#0000FF\"       //Blue\n}\nif (Find('Sanitary',$feature.aec_Style,0) != -1 ) {\n    return \"#800080\"       //Purple\n}\nif (Find('Storm',$feature.aec_Style,0) != -1 ) {\n    return \"#0000FF\"       //Blue\n}\nif (Find('SANITARY',$feature.aec_Style,0) != -1 ) {\n    return \"#800080\"       //Purple\n}\nif (Find('STORM',$feature.aec_Style,0) != -1 ) {\n    return \"#0000FF\"       //Blue\n}",
                "returnType" : "Default"
              }
            },
            {
              "type" : "CIMPrimitiveOverride",
              "primitiveName" : "096bdfcc-9b39-4eb8-a463-ebcc6d2fd6a3",
              "propertyName" : "TintColor",
              "valueExpressionInfo" : {
                "type" : "CIMExpressionInfo",
                "title" : "Custom",
                "expression" : "if (Find('SS',$feature.aec_Style,0) != -1 ) {\n    return \"#800080\"       //Purple\n}\nif (Find('STRM',$feature.aec_Style,0) != -1 ) {\n    return \"#0000FF\"       //Blue\n}\nif (Find('Sanitary',$feature.aec_Style,0) != -1 ) {\n    return \"#800080\"       //Purple\n}\nif (Find('Storm',$feature.aec_Style,0) != -1 ) {\n    return \"#0000FF\"       //Blue\n}\nif (Find('SANITARY',$feature.aec_Style,0) != -1 ) {\n    return \"#800080\"       //Purple\n}\nif (Find('STORM',$feature.aec_Style,0) != -1 ) {\n    return \"#0000FF\"       //Blue\n}",
                "returnType" : "Default"
              }
            },
            {
              "type" : "CIMPrimitiveOverride",
              "primitiveName" : "2a8e6c78-5fe1-43a8-9d36-6559bec5e4c8",
              "propertyName" : "TintColor",
              "valueExpressionInfo" : {
                "type" : "CIMExpressionInfo",
                "title" : "Custom",
                "expression" : "if (Find('SS',$feature.aec_Style,0) != -1 ) {\n    return \"#800080\"       //Purple\n}\nif (Find('STRM',$feature.aec_Style,0) != -1 ) {\n    return \"#0000FF\"       //Blue\n}\nif (Find('Sanitary',$feature.aec_Style,0) != -1 ) {\n    return \"#800080\"       //Purple\n}\nif (Find('Storm',$feature.aec_Style,0) != -1 ) {\n    return \"#0000FF\"       //Blue\n}\nif (Find('SANITARY',$feature.aec_Style,0) != -1 ) {\n    return \"#800080\"       //Purple\n}\nif (Find('STORM',$feature.aec_Style,0) != -1 ) {\n    return \"#0000FF\"       //Blue\n}",
                "returnType" : "Default"
              }
            },
            {
              "type" : "CIMPrimitiveOverride",
              "primitiveName" : "0d034d92-1859-41f4-9ff2-48b71dc54cb7",
              "propertyName" : "Rotation",
              "expression" : "[aec_RotAngle]"
            },
            {
              "type" : "CIMPrimitiveOverride",
              "primitiveName" : "0d034d92-1859-41f4-9ff2-48b71dc54cb7",
              "propertyName" : "Size",
              "valueExpressionInfo" : {
                "type" : "CIMExpressionInfo",
                "title" : "Custom",
                "expression" : "if (Find('INLET', $feature.aec_Style) != -1) {\nreturn 2 \n}",
                "returnType" : "Default"
              }
            },
            {
              "type" : "CIMPrimitiveOverride",
              "primitiveName" : "0d034d92-1859-41f4-9ff2-48b71dc54cb7",
              "propertyName" : "Width",
              "valueExpressionInfo" : {
                "type" : "CIMExpressionInfo",
                "title" : "Custom",
                "expression" : "if (Find('INLET', $feature.aec_Style) != -1) {\nreturn 1.5 \n}",
                "returnType" : "Default"
              }
            },
            {
              "type" : "CIMPrimitiveOverride",
              "primitiveName" : "0d034d92-1859-41f4-9ff2-48b71dc54cb7",
              "propertyName" : "Depth",
              "valueExpressionInfo" : {
