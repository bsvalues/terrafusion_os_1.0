      "maxDisplayCacheAge" : 5,
      "popupInfo" : {
        "type" : "CIMPopupInfo",
        "title" : "{RefName}{aec_Name}",
        "mediaInfos" : [
          {
            "type" : "CIMTextMediaInfo",
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "text" : "<table> <tr> <h3>Property</h3> <th></th> </tr>  \n<tr> <td><strong>Name:</strong></td> <td>{aec_Name}</td> </tr> \n<tr> <td><strong>Number:</strong></td> <td>{aec_Number}</td> </tr>\n<tr> <td><strong>Description:</strong></td> <td>{aec_Desc}</td> </tr>\n<tr> <td><strong>Civil 3D Style:</strong></td> <td>{aec_Style}</td> </tr>\n<tr> <td><strong>Area Label Style:</strong></td> <td>{aec_ALabelS}</td> </tr>\n<tr> <td><strong>Area:</strong></td> <td>{aec_Area}</td> </tr>\n<tr> <td><strong>Perimeter:</strong></td> <td>{aec_Perimeter}</td> </tr>\n<tr> <td><strong>Address:</strong></td> <td>{aec_Address}</td> </tr>\n<tr> <td><strong>Tax ID:</strong></td> <td>{aec_TaxID}</td> </tr></table>"
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 1,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var aDict = Schema($feature);\nvar aArray = aDict['fields'];\nvar output = \"<table><h2>Property Sets</h2>\"\nvar p = 0\nfor (var i in $feature){\n    if (!isEmpty($feature[i]) \n        && $feature[i] != 0 \n        && $feature[i] != '-' \n        && Find('aec_',i,0) == -1\n        && i != 'OBJECTID'\n        && i != 'OID'\n        && i != 'Entity'\n        && i != 'Handle'\n        && i != 'Layer'\n        && i != 'LyrFrzn'\n        && i != 'LyrLock'\n        && i != 'LyrOn'\n        && i != 'LyrVPFrzn'\n        && i != 'LyrHandle'\n        && i != 'Color'\n        && i != 'EntColor'\n        && i != 'LyrColor'\n        && i != 'BlkColor'\n        && i != 'Linetype'\n        && i != 'EntLinetype'\n        && i != 'LyrLnType'\n        && i != 'BlkLinetype'    \n        && i != 'Elevation'\n        && i != 'Thickness'\n        && i != 'LineWt'\n        && i != 'EntLineWt'\n        && i != 'LyrLineWt'\n        && i != 'BlkLineWt'\n        && i != 'RefName'    \n        && i != 'LTScale'\n        && i != 'ExtX'\n        && i != 'ExtY'\n        && i != 'ExtZ'\n        && i != 'DocName'\n        && i != 'DocPath'\n        && i != 'DocType'\n        && i != 'DocVer'\n        && i != 'DocUpdate'\n        && i != 'DocId'\n        && i != 'SharedView'\n        && i != 'SharedVer')  {\n           for (var j in aArray) {\n             var dict = aArray[j];\n             if (dict['name'] == i) {\n               output  += \"<tr><td><B>\" + Replace(Split(dict['alias'], ' ',2)[1],'_',' ') + \"  :  \" + \"</B>\" + \"</td><td>\" + $feature[i] +  \"</td></tr>\"\n               p++\n             }\n    }    \n    }\n}\nif (p>0) {\nreturn { \n      type : 'text', \n      text : output + \"</table>\"\n// this property supports html tags \n}\n}",
              "returnType" : "Default"
            }
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 2,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var returnstring = \"<table><h2>BIM Cloud Connection</h2>\" \nvar p = 0\nfor (var i in $feature) {\n    if (!isEmpty($feature[i]) &&  i == 'SharedView')  {\n        returnstring = returnstring + \"<tr><td><B>\" + i + \": \"+ \"</B>\" + \"</td><td>\" + IIf(i == 'SharedView', \"<p><a href=\" +  $feature[i]  + \">URL</a> </p>\", $feature[i])  + \"</td></tr>\"\np++\n    }\n}\nif (p>0) {\nreturn { \n      type : 'text', \n      text : returnstring + \"</table>\" \n       }\n}\n\n//Expression to show the SharedView file, when exist. And to open file in the BIM site using the URL",
              "returnType" : "Default"
            }
          }
        ],
