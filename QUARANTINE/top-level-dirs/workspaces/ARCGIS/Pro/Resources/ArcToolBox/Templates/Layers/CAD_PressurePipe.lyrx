      "displayCacheType" : "Permanent",
      "maxDisplayCacheAge" : 5,
      "popupInfo" : {
        "type" : "CIMPopupInfo",
        "title" : "{aec_Network} - {aec_Name}",
        "expressionInfos" : [
          {
            "type" : "CIMExpressionInfo",
            "title" : "Custom",
            "expression" : "var StationlbR = Text($feature.aec_StartSta, '00.00' );  //formatting with decimals after the + sign - if there is not \nvar StationlbL = Text(First(Split($feature.aec_StartSta/100, '.',1)), '###00' )  //Getting rid of the two initial character dividing by 100. formatting result with 2 zeros and room for more characters\n\nIf ($feature.aec_StartSta > 0 || $feature.aec_StartSta < 0) {\nReturn Concatenate([StationlbL, Replace(StationlbR,'-','')], '+')\n}",
            "name" : "MyStartStation",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "Custom",
            "expression" : "var StationlbR = Text($feature.aec_EndSta, '00.00' );  //formatting with decimals after the + sign - if there is not \nvar StationlbL = Text(First(Split($feature.aec_EndSta/100, '.',1)), '###00' )  //Getting rid of the two initial character dividing by 100. formatting result with 2 zeros and room for more characters\n\nIf ($feature.aec_EndSta > 0 || $feature.aec_EndSta < 0) {\nConcatenate([StationlbL, Replace(StationlbR,'-','')], '+')\n}",
            "name" : "MyEndStation",
            "returnType" : "String"
          },
          {
            "type" : "CIMExpressionInfo",
            "title" : "Slope",
            "expression" : "Text($feature.aec_Slop,'#####.00%')",
            "name" : "Slope",
            "returnType" : "String"
          }
        ],
        "mediaInfos" : [
          {
            "type" : "CIMTextMediaInfo",
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "text" : "<table> <tr> <h3>Property</h3> <th></th> </tr> \n<tr> <td><strong>Network:</strong></td> <td>{aec_Network}</td> </tr>  \n<tr> <td><strong>Name:</strong></td> <td>{aec_Name}</td> </tr>\n<tr> <td><strong>Description:</strong></td> <td>{aec_Desc}</td> </tr>\n<tr> <td><strong>Style:</strong></td> <td>{aec_Style}</td> </tr>\n<tr> <td><strong>Render Material:</strong></td> <td>{aec_RendMat}</td> </tr>\n<tr> <td><strong>Nominal Diameter Description:</strong></td> <td>{aec_NomDia}</td> </tr>\n<tr> <td><strong>Reference Alignment:</strong></td> <td>{aec_RefAlign}</td> </tr>\n<tr> <td><strong>Reference Surface:</strong></td> <td>{aec_RefSurf}</td> </tr>\n<tr> <td><strong>Start Station:</strong></td> <td>{expression/MyStartStation}</td> </tr>\n<tr> <td><strong>Start Offset:</strong></td> <td>{aec_StartOffst}</td> </tr>\n<tr> <td><strong>End Station:</strong></td> <td>{expression/MyEndStation}</td> </tr>\n<tr> <td><strong>End Offset:</strong></td> <td>{aec_EndOffst}</td> </tr>\n<tr> <td><strong>Start Cover:</strong></td> <td>{aec_StrtCover}</td> </tr>\n<tr> <td><strong>End Cover:</strong></td> <td>{aec_EndCover}</td> </tr>\n<tr> <td><strong>Start Easting:</strong></td> <td>{aec_StrtEast}</td> </tr>\n<tr> <td><strong>Start Northing:</strong></td> <td>{aec_StrtNorth}</td> </tr>\n<tr> <td><strong>End Easting:</strong></td> <td>{aec_EndEast}</td> </tr>\n<tr> <td><strong>End Northing:</strong></td> <td>{aec_EndNorth}</td> </tr>\n<tr> <td><strong>Start Centerline Elevation:</strong></td> <td>{aec_StrtCtlnElev}</td> </tr>\n<tr> <td><strong>End Centerline Elevation:</strong></td> <td>{aec_EndCtlnElev}</td> </tr>\n<tr> <td><strong>Start Elevation Invert:</strong></td> <td>{aec_StrtInvElev}</td> </tr>\n<tr> <td><strong>End Elevation Invert:</strong></td> <td>{aec_EndInvElev}</td> </tr>\n<tr> <td><strong>Start Elevation Outside Crown:</strong></td> <td>{aec_StrtCrwnElev}</td> </tr>\n<tr> <td><strong>End Elevation Outside Crown:</strong></td> <td>{aec_EndCrwnElev}</td> </tr>\n<tr> <td><strong>2D Length:</strong></td> <td>{aec_2dLen}</td> </tr>\n<tr> <td><strong>3D Length:</strong></td> <td>{aec_3dLen}</td> </tr>\n<tr> <td><strong>Bearing:</strong></td> <td>{aec_Bearing}</td> </tr>\n<tr> <td><strong>Slope:</strong></td> <td>{expression/Slope}</td> </tr>\n<tr> <td><strong>Horizontal Radius:</strong></td> <td>{aec_HRadius}</td> </tr>\n<tr> <td><strong>Horizontal Chord Length:</strong></td> <td>{aec_HChrdLen}</td> </tr>\n<tr> <td><strong>Horizontal Radius Point Northing:</strong></td> <td>{aec_HRadPtNorth}</td> </tr>\n<tr> <td><strong>Horizontal Radius Point Easting:</strong></td> <td>{aec_HRadPtEast}</td> </tr>\n<tr> <td><strong>Vertical Radius:</strong></td> <td>{aec_VRadius}</td> </tr></table>"
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 1,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var aDict = Schema($feature);\nvar aArray = aDict['fields'];\nvar output = \"<table><h2>Property Sets</h2>\"\nvar p = 0\nfor (var i in $feature){\n    if (!isEmpty($feature[i]) \n        && $feature[i] != 0 \n        && $feature[i] != '-' \n        && Find('aec_',i,0) == -1\n        && i != 'OBJECTID'\n        && i != 'BlkColor'\n        && i != 'BlkLinetype'\n        && i != 'BlkLineWt'\n        && i != 'Color'\n        && i != 'DocId'\n        && i != 'DocName'\n        && i != 'DocPath'\n        && i != 'DocType'\n        && i != 'DocUpdate'\n        && i != 'DocVer'\n        && i != 'Elevation'\n        && i != 'EntColor'\n        && i != 'Entity'\n        && i != 'EntLinetype'\n        && i != 'EntLineWt'\n        && i != 'ExtX'\n        && i != 'ExtY'\n        && i != 'ExtZ'\n        && i != 'Handle'\n        && i != 'IsSimulated'\n        && i != 'Layer'\n        && i != 'Linetype'\n        && i != 'LineWt'\n        && i != 'LTScale'\n        && i != 'LyrColor'\n        && i != 'LyrFrzn'\n        && i != 'LyrHandle'\n        && i != 'LyrLineWt'\n        && i != 'LyrLnType'\n        && i != 'LyrLock'\n        && i != 'LyrOn'\n        && i != 'LyrVPFrzn'\n        && i != 'OID'\n        && i != 'RefName'\n        && i != 'SharedView'\n        && i != 'SharedVer')  {\n           for (var j in aArray) {\n             var dict = aArray[j];\n             if (dict['name'] == i) {\n               output  += \"<tr><td><B>\" + Replace(Split(dict['alias'], ' ',2)[1],'_',' ') + \"  :  \" + \"</B>\" + \"</td><td>\" + $feature[i] +  \"</td></tr>\"\n               p++\n             }\n    }    \n    }\n}\nif (p>0) {\nreturn { \n      type : 'text', \n      text : output + \"</table>\"\n// this property supports html tags \n}\n}",
              "returnType" : "Default"
            }
          },
          {
            "type" : "CIMExpressionMediaInfo",
            "row" : 2,
            "refreshRateUnit" : "esriTimeUnitsSeconds",
            "rowSpan" : 1,
            "columnSpan" : 1,
            "expression" : {
              "type" : "CIMExpressionInfo",
              "title" : "Custom",
              "expression" : "var returnstring = \"<table><h2>BIM Cloud Connection</h2>\" \nvar p = 0\nfor (var i in $feature) {\n    if (!isEmpty($feature[i]) &&  i == 'SharedView')  {\n        returnstring = returnstring + \"<tr><td><B>\" + i + \": \"+ \"</B>\" + \"</td><td>\" + IIf(i == 'SharedView', \"<p><a href=\" +  $feature[i]  + \">URL</a> </p>\", $feature[i])  + \"</td></tr>\"\np++\n    }\n}\nif (p>0) {\nreturn { \n      type : 'text', \n      text : returnstring + \"</table>\" \n       }\n}\n\n//Expression to show the SharedView file, when exist. And to open file in the BIM site using the URL",
              "returnType" : "Default"
            }
          }
