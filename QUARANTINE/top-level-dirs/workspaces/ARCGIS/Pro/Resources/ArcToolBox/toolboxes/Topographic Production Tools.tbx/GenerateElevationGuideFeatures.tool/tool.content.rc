{
    "map": {
        "area_of_interest.descr": "A feature layer with a single selected feature that will define the processing extent for banding operations and a clipping extent for spot heights, and input hydrology areas and lines.",
        "area_of_interest.title": "Area Of Interest",
        "bands_minarea.descr": "<xdoc><p>The minimum area for output polygons. Features smaller than this value will be removed. The default is 0.00016 square decimal degrees.<note type=\"note\"/><p group=\"note\">If you are creating an output dataset with a projected coordinate system, ensure that this value reflects the square units of that coordinate system—for example, square meters for a UTM dataset. Otherwise, the default value may result in an empty output dataset.</p></p></xdoc>",
        "bands_minarea.title": "Minimum Feature Area",
        "contour_interval.descr": "<xdoc><p>Specifies the contour interval that will be used to determine the closest available contour when calculating the elevation band area. Elevation bands are created with their limits aligned to the specified contour interval, except low and high values, which will represent their actual calculated values.</p><ul><li><span title=\"10\">10</span>—A contour interval of 10 will be used.</li><li><span title=\"20\">20</span>—A contour interval of 20 will be used. This is the default.</li><li><span title=\"40\">40</span>—A contour interval of 40 will be used.</li><li><span title=\"80\">80</span>—A contour interval of 80 will be used.</li></ul></xdoc>",
        "contour_interval.title": "Contour Interval",
        "description": "Creates data required for an elevation guide diagram \nsurround element as required by various supported map product specifications.  This tool uses existing \nbanding and thinning parameters to generate output elevation band features, spot height features, and \nhydrology features.",
        "height_field.descr": "The field that identifies the elevation values of the spot height features. These values will be evaluated during the thinning process.",
        "height_field.title": "Height Field",
        "hydro_area_features.descr": "Hydrology area features that will be used to generate the thinned hydrology dataset. Only the output features will be generalized through this thinning process.",
        "hydro_area_features.title": "Hydro Area Features",
        "hydro_exclusion_features.descr": "A feature layer that defines a large water body area that will be excluded from the elevation band area computation.",
        "hydro_exclusion_features.title": "Hydro Exclusion Features",
        "hydro_line_features.descr": "Hydrology line features that will be used to generate the output of a thinned hydrology dataset. Only the output features will be generalized through this thinning process.",
        "hydro_line_features.title": "Hydro Line Features",
        "hydroarea_minlength.descr": "The length that will be used to split and classify hydrographic polygons as short or long. Polygons will be split at any location where the edge-to-edge distance is equal to this value.",
        "hydroarea_minlength.title": "Minimum Hydro Area Length",
        "hydroarea_minwidth.descr": "The width that will be used to split and classify hydrographic polygons as narrow or wide. Polygons will be split at any location where the edge-to-edge distance is equal to this value.",
        "hydroarea_minwidth.title": "Minimum Hydro Area Width",
        "hydroline_minlength.descr": "The minimum length that will be used to eliminate hydrology features. Hydrology features that have a length less than this value will be thinned. This value is used when generalizing input hydro lines and areas.",
        "hydroline_minlength.title": "Minimum Hydro Line Length",
        "hydroline_minspacing.descr": "<xdoc><p>The shortest distance between hydrographic segments that will display at the output scale. If the spacing between two parallel trending features is smaller than this value, one of the features will be hidden. This parameter defines the density of the resulting thinned hydrography. It should correspond to the distance between two parallel trending features that is visually significant to include at the final scale. When the density of features is too high (that is, the features are too closely spaced), at least one feature will be hidden. This can result in important features or features longer than the <span class=\"esri_uicontrol\">Minimum Hydro Line Length</span> value being hidden.</p></xdoc>",
        "hydroline_minspacing.title": "Minimum Hydro Line Spacing",
        "in_feature_dataset.descr": "An existing feature dataset that will contain the EGB feature classes. Data created for the elevation guide box is maintained in these feature classes in this feature dataset.",
        "in_feature_dataset.title": "Input Feature Dataset",
        "in_rasters.descr": "One or more rasters that will be used to create elevation bands and supply elevation values to the created features.",
        "in_rasters.title": "Input Rasters",
        "min_island_area.descr": "The minimum area necessary for an island or hole to be included in the resulting features.",
        "min_island_area.title": "Minimum Island Area",
        "number_of_bands.descr": "<xdoc><p>Specifies the number of elevation bands that will be generated.</p><ul><li><span title=\"1\">1</span>—One elevation band will be generated.</li><li><span title=\"2\">2</span>—Two elevation bands will be generated.</li><li><span title=\"3\">3</span>—Three elevation bands will be generated.</li><li><span title=\"4\">4</span>—Four elevation bands will be generated.</li></ul></xdoc>",
        "number_of_bands.title": "Number Of Elevation Bands",
        "out_feature_dataset.title": "Modified Feature Dataset",
        "params.category1": "Banding Settings (optional)",
        "params.category2": "Spot Settings (optional)",
        "params.category3": "Hydro Settings (optional)",
        "search_distance.descr": "The minimum distance between spot heights. The default is 0 meters.",
        "search_distance.title": "Search Distance",
        "smooth_tolerance.descr": "The tolerance that will be used by the smoothing algorithm. The larger the value, the more generalized the output band features. The default is 0.002 decimal degrees.",
        "smooth_tolerance.title": "Smoothing Tolerance",
        "spot_height_features.descr": "A feature layer or class that contains spot heights.",
        "spot_height_features.title": "Spot Height Features",
        "summary": "Creates data required for an elevation guide diagram surround element as required by various supported map product specifications. This tool uses existing banding and thinning parameters to generate output elevation band features, spot height features, and hydrology features.",
        "title": "Generate Elevation Guide Features"
    }
}
