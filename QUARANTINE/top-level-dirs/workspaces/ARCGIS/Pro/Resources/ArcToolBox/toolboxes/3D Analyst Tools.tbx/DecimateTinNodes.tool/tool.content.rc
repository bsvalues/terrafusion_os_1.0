{
    "map": {
        "copy_breaklines.descr": "<xdoc><p>Indicates whether breaklines from the input TIN are copied over to the output.<ul><li>Unchecked—Breaklines will not be copied. This is the default.</li><li>Checked—Breaklines will be copied.</li></ul></p></xdoc>",
        "copy_breaklines.title": "Copy Breaklines",
        "description": "Creates a triangulated irregular network (TIN) dataset using a subset of nodes from a source TIN.",
        "in_tin.descr": "The TIN dataset that will be processed.",
        "in_tin.title": "Input TIN",
        "max_node_value.descr": "The maximum number of nodes that can be stored in the output TIN, which defaults to the total number of nodes in the source TIN minus 1. If the Z-tolerance method is used, the tool will stop processing if the Z tolerance value causes the resulting TIN to exceed the maximum number of nodes.",
        "max_node_value.title": "Maximum Number of Nodes",
        "method.descr": "<xdoc><p>Specifies the thinning method used for selecting a subset of nodes from the input TIN.</p><ul><li><span title=\"Z_TOLERANCE\">Z Tolerance</span>—Creates a TIN that will maintain the vertical accuracy specified in the <span class=\"esri_uicontrol\">Z Tolerance</span> parameter. This is the default.</li><li><span title=\"COUNT\">Count</span>—Creates a TIN that will not exceed the node limit specified in the <span class=\"esri_uicontrol\">Maximum Number of Nodes</span> parameter.</li></ul></xdoc>",
        "method.domain.COUNT": "Count",
        "method.domain.Z_TOLERANCE": "Z Tolerance",
        "method.title": "Decimation Method",
        "out_tin.descr": "The TIN dataset that will be generated.",
        "out_tin.title": "Output TIN",
        "title": "Decimate TIN Nodes",
        "z_tolerance_value.descr": "The maximum deviation from the source TIN's Z-value that will be allowed in the output TIN, which defaults to the lesser of either one-tenth of the Z-range or the number 10.",
        "z_tolerance_value.title": "Z Tolerance"
    }
}
