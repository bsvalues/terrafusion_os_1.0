{
    "type": "FunctionTool",
    "guid": "{fb248b8c-026d-47cc-bba8-bb7b16c1f6ea}",
    "displayname": "$rc:title",
    "helpcontent": "24010004",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "edit_session",
        "input_data_change"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "featuretype": [
                    "Simple",
                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexEdge",
                    "Annotation",
                    "CoverageAnnotation"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "in_link_features": {
            "displayname": "$rc:in_link_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:in_link_features.descr"
        },
        "in_identity_links": {
            "type": "optional",
            "displayname": "$rc:in_identity_links.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ]
            },
            "description": "$rc:in_identity_links.descr"
        },
        "method": {
            "type": "optional",
            "displayname": "$rc:method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "LINEAR",
                        "code": "$rc:method.domain.LINEAR"
                    },
                    {
                        "value": "NATURAL_NEIGHBOR",
                        "code": "$rc:method.domain.NATURAL_NEIGHBOR"
                    }
                ]
            },
            "value": "LINEAR",
            "description": "$rc:method.descr"
        },
        "out_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_features"
            ]
        }
    },
    "environments": [
        "extent",
        "workspace"
    ]
}
