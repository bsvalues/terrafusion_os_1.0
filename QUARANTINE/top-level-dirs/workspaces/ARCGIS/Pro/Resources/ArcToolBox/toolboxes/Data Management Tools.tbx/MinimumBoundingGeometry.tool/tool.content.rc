{
    "map": {
        "description": "Creates a feature class containing polygons which represent a specified minimum bounding geometry enclosing each input feature or each group of input features.",
        "geometry_type.descr": "<xdoc><p>Specifies what type of minimum bounding geometry the output polygons will represent.</p><ul><li><span title=\"RECTANGLE_BY_AREA\">Rectangle by area</span>—The rectangle of the smallest area enclosing an input feature. This is the default.</li><li><span title=\"RECTANGLE_BY_WIDTH\">Rectangle by width</span>—The rectangle of the smallest width enclosing an input feature.</li><li><span title=\"CONVEX_HULL\">Convex hull</span>—The smallest convex polygon enclosing an input feature.</li><li><span title=\"CIRCLE\">Circle</span>—The smallest circle enclosing an input feature envelope.</li><li><span title=\"ENVELOPE\">Envelope</span>—The envelope of an input feature.</li></ul></xdoc>",
        "geometry_type.domain.CIRCLE": "Circle",
        "geometry_type.domain.CONVEX_HULL": "Convex hull",
        "geometry_type.domain.ENVELOPE": "Envelope",
        "geometry_type.domain.RECTANGLE_BY_AREA": "Rectangle by area",
        "geometry_type.domain.RECTANGLE_BY_WIDTH": "Rectangle by width",
        "geometry_type.title": "Geometry Type",
        "group_field.descr": "<xdoc><p>The field or fields in the input features that will be used to group features, when <span class=\"esri_uicontrol\">List</span> is specified as <span class=\"esri_uicontrol\">Group Option</span>. At least one group field is required for <span class=\"esri_uicontrol\">List</span> option. All features that have the same value in the specified field or fields will be treated as a group.</p></xdoc>",
        "group_field.title": "Group Field(s)",
        "group_option.descr": "<xdoc><p>Specifies how the input features will be grouped; each group will be enclosed with one output polygon.</p><ul><li><span title=\"NONE\">None</span>—Input features will not be grouped. This is the default. This option is not available for point input.</li><li><span title=\"ALL\">All</span>—All input features will be treated as one group.</li><li><span title=\"LIST\">List</span>—Input features will be grouped based on their common values in the specified field or fields in the group field parameter.</li></ul></xdoc>",
        "group_option.domain.ALL": "All",
        "group_option.domain.LIST": "List",
        "group_option.domain.NONE": "None",
        "group_option.title": "Group Option",
        "in_features.descr": "The input features that can be point, multipoint, line, polygon, or multipatch.",
        "in_features.title": "Input Features",
        "mbg_fields_option.descr": "<xdoc><p>Specifies whether to add the geometric attributes in the output feature class or omit them in the output feature class.</p><ul><li>Unchecked—Omits the geometric attributes in the output feature class. This is the default.</li><li>Checked—Adds the geometric attributes in the output feature class.</li></ul></xdoc>",
        "mbg_fields_option.title": "Add geometry characteristics as attributes to output",
        "out_feature_class.descr": "The output polygon feature class.",
        "out_feature_class.title": "Output Feature Class",
        "title": "Minimum Bounding Geometry"
    }
}
