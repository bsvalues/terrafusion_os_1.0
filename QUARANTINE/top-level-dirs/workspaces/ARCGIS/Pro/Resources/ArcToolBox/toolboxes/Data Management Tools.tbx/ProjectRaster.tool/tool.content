    ],
    "params": {
        "in_raster": {
            "display_order": "0",
            "displayname": "$rc:in_raster.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "description": "$rc:in_raster.descr"
        },
        "out_raster": {
            "direction": "out",
            "display_order": "2",
            "displayname": "$rc:out_raster.title",
            "datatype": {
                "type": "DERasterDataset"
            },
            "description": "$rc:out_raster.descr"
        },
        "out_coor_system": {
            "display_order": "3",
            "displayname": "$rc:out_coor_system.title",
            "datatype": {
                "type": "GPCoordinateSystem"
            },
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:out_coor_system.descr"
        },
        "resampling_type": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:resampling_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NEAREST",
                        "code": "$rc:resampling_type.domain.NEAREST"
                    },
                    {
                        "value": "BILINEAR",
                        "code": "$rc:resampling_type.domain.BILINEAR"
                    },
                    {
                        "value": "CUBIC",
                        "code": "$rc:resampling_type.domain.CUBIC"
                    },
                    {
                        "value": "MAJORITY",
                        "code": "$rc:resampling_type.domain.MAJORITY"
                    }
                ]
            },
            "value": "NEAREST",
            "description": "$rc:resampling_type.descr"
        },
        "cell_size": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:cell_size.title",
            "datatype": {
                "type": "GPCellSizeXY"
            },
            "description": "$rc:cell_size.descr"
        },
        "geographic_transform": {
            "type": "optional",
            "display_order": "5",
            "control_guid": "{9E2FD8D4-2872-4AE4-B0A5-FC1F60DD66A9}",
            "displayname": "$rc:geographic_transform.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "depends": [
                "in_raster",
                "out_coor_system"
            ],
            "description": "$rc:geographic_transform.descr"
        },
        "Registration_Point": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:registration_point.title",
            "datatype": {
                "type": "GPPoint"
            },
            "description": "$rc:registration_point.descr"
        },
        "in_coor_system": {
            "enabled": "false",
            "type": "optional",
            "display_order": "1",
            "displayname": "$rc:in_coor_system.title",
            "datatype": {
                "type": "GPCoordinateSystem"
            },
            "description": "$rc:in_coor_system.descr"
        },
        "vertical": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:vertical.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "VERTICAL"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_VERTICAL"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:vertical.descr"
        }
    },
    "environments": [
        "cellSize",
        "cellSizeProjectionMethod",
