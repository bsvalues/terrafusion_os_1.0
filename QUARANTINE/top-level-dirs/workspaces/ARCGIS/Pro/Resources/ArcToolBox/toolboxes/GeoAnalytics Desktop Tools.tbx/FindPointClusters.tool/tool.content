{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "69000015",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "spark"
    ],
    "params": {
        "input_points": {
            "display_order": "0",
            "displayname": "$rc:input_points.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_points.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "clustering_method": {
            "display_order": "2",
            "displayname": "$rc:clustering_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DBSCAN",
                        "code": "$rc:clustering_method.domain.DBSCAN"
                    },
                    {
                        "value": "HDBSCAN",
                        "code": "$rc:clustering_method.domain.HDBSCAN"
                    }
                ]
            },
            "value": "DBSCAN",
            "description": "$rc:clustering_method.descr"
        },
        "minimum_points": {
            "display_order": "3",
            "displayname": "$rc:minimum_points.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:minimum_points.descr"
        },
        "search_distance": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:search_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:search_distance.descr"
        },
        "use_time": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:use_time.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "TIME"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_TIME"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:use_time.descr"
        },
        "search_duration": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:search_duration.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:search_duration.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
