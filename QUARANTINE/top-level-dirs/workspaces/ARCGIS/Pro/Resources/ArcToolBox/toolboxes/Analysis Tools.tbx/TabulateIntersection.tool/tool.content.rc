        "sum_fields.descr": "<xdoc><p>The fields that will be summed from the <span class=\"esri_uicontrol\">Input Class Features</span> parameter.</p></xdoc>",
        "sum_fields.title": "Sum Fields",
        "title": "Tabulate Intersection",
        "xy_tolerance.descr": "<xdoc><p>The distance that determines the range in which features or their vertices are considered equal. By default, this is the x,y tolerance of the <span class=\"esri_uicontrol\">Input Zone Features</span> parameter value.</p><note type=\"caution\"/><p group=\"note\">Changing this parameter&apos;s value may cause failure or unexpected results. It is recommended that you do not modify this parameter. It has been removed from view on the tool dialog box. By default, the input feature class&apos;s spatial reference x,y tolerance property is used.</p></xdoc>",
        "xy_tolerance.title": "XY Tolerance",
        "zone_fields.descr": "The attribute field or fields that will be used to define zones.",
        "zone_fields.title": "Zone Fields"
    }
