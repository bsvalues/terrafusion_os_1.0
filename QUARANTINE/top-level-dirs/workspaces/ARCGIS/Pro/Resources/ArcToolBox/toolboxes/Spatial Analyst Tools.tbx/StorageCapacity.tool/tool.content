{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "8070013",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "10"
    ],
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_surface_raster": {
            "display_order": "0",
            "displayname": "$rc:in_surface_raster.title",
            "datatype": {
                "type": "GPRasterLayer"
            },
            "description": "$rc:in_surface_raster.descr"
        },
        "out_table": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_table.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_table.descr"
        },
        "in_zone_data": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:in_zone_data.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPFeatureLayer"
                    }
                ]
            },
            "description": "$rc:in_zone_data.descr"
        },
        "zone_field": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:zone_field.title",
            "datatype": {
                "type": "Field"
            },
            "depends": [
                "in_zone_data"
            ],
            "description": "$rc:zone_field.descr"
        },
        "analysis_type": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:analysis_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "AREA_VOLUME",
                        "code": "$rc:analysis_type.domain.AREA_VOLUME"
                    },
                    {
                        "value": "AREA",
                        "code": "$rc:analysis_type.domain.AREA"
                    },
                    {
                        "value": "VOLUME",
                        "code": "$rc:analysis_type.domain.VOLUME"
                    }
                ]
            },
            "value": "AREA_VOLUME",
            "description": "$rc:analysis_type.descr"
        },
        "min_elevation": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:min_elevation.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:min_elevation.descr"
        },
        "max_elevation": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:max_elevation.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:max_elevation.descr"
        },
        "increment_type": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:increment_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NUMBER_OF_INCREMENTS",
                        "code": "$rc:increment_type.domain.NUMBER_OF_INCREMENTS"
                    },
                    {
                        "value": "VALUE_OF_INCREMENT",
                        "code": "$rc:increment_type.domain.VALUE_OF_INCREMENT"
                    }
                ]
            },
            "value": "NUMBER_OF_INCREMENTS",
            "description": "$rc:increment_type.descr"
        },
        "increment": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:increment.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:increment.descr"
        },
        "z_unit": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:z_unit.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "METER",
                        "code": "$rc:z_unit.domain.METER"
                    },
                    {
                        "value": "INCH",
                        "code": "$rc:z_unit.domain.INCH"
                    },
                    {
                        "value": "FOOT",
                        "code": "$rc:z_unit.domain.FOOT"
                    },
                    {
                        "value": "YARD",
                        "code": "$rc:z_unit.domain.YARD"
                    },
                    {
                        "value": "MILE_US",
                        "code": "$rc:z_unit.domain.MILE_US"
                    },
                    {
                        "value": "NAUTICAL_MILE",
                        "code": "$rc:z_unit.domain.NAUTICAL_MILE"
                    },
                    {
                        "value": "MILLIMETER",
                        "code": "$rc:z_unit.domain.MILLIMETER"
                    },
                    {
                        "value": "CENTIMETER",
                        "code": "$rc:z_unit.domain.CENTIMETER"
                    },
                    {
                        "value": "KILOMETER",
                        "code": "$rc:z_unit.domain.KILOMETER"
                    },
                    {
                        "value": "DECIMETER",
                        "code": "$rc:z_unit.domain.DECIMETER"
                    }
                ]
            },
            "description": "$rc:z_unit.descr"
        },
        "out_chart": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:out_chart.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_chart.descr"
        }
    },
    "environments": [
        "autoCommit",
        "cellSize",
        "cellSizeProjectionMethod",
        "compression",
        "configKeyword",
        "extent",
        "geographicTransformations",
        "mask",
        "outputCoordinateSystem",
        "parallelProcessingFactor",
        "scratchWorkspace",
        "snapRaster",
        "tileSize",
        "workspace"
    ]
}
