        },
        "upgrade_attribute_rules": {
            "type": "optional",
            "displayname": "$rc:upgrade_attribute_rules.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "UPGRADE_ATTRIBUTE_RULES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_UPGRADE_ATTRIBUTE_RULES"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:upgrade_attribute_rules.descr"
        },
        "upgrade_indoors_database": {
            "type": "optional",
            "displayname": "$rc:upgrade_indoors_database.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UPGRADE_DATABASE",
