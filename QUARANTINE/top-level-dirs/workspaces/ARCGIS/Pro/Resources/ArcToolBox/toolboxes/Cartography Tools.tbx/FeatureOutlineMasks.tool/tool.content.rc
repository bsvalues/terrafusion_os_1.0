{
    "map": {
        "attributes.descr": "<xdoc><p>Specifies the attributes that will be transferred from the input features to the output features.</p><ul><li><span title=\"ONLY_FID\">Only the FID field</span>—Only the FID field from the input features will be transferred to the output features. This is the default.</li><li><span title=\"NO_FID\">All attributes except the FID field</span>—All attributes except the FID field from the input features will be transferred to the output features.</li><li><span title=\"ALL\">All attributes</span>— All attributes from the input features will be transferred to the output features.</li></ul></xdoc>",
        "attributes.domain.ALL": "All attributes",
        "attributes.domain.NO_FID": "All attributes except the FID field",
        "attributes.domain.ONLY_FID": "Only the FID field",
        "attributes.title": "Transfer Attributes",
        "description": "Creates mask polygons at a specified distance and shape around the symbolized features in the input layer.",
        "input_layer.descr": "The symbolized input layer from which the masks will be created.",
        "input_layer.title": "Input Layer",
        "margin.descr": "<xdoc><p>The space in page units surrounding the symbolized input features used to create the mask polygons. Typically, masking polygons are created with a small margin around the symbol to improve visual appearance. Margin values can be specified in either page units or map units.</p><p>The margin cannot be negative.</p></xdoc>",
        "margin.title": "Margin",
        "mask_for_non_placed_anno.descr": "<xdoc><p>Specifies whether masks for unplaced annotation will be created. This parameter is only used when masking geodatabase annotation layers.</p><ul><li><span title=\"ALL_FEATURES\">All annotation features</span>—Masks will be created for all annotation features. This is the default.</li><li><span title=\"ONLY_PLACED\">Only placed annotation features</span>—Masks will only be created for features with a status of placed.</li></ul></xdoc>",
        "mask_for_non_placed_anno.domain.ALL_FEATURES": "All annotation features",
        "mask_for_non_placed_anno.domain.ONLY_PLACED": "Only placed annotation features",
        "mask_for_non_placed_anno.title": "Create masks for unplaced annotation",
        "method.descr": "<xdoc><p>Specifies the type of masking geometry that will be created.</p><ul><li><span title=\"BOX\">Box</span>—A polygon representing the extent of the symbolized feature will be created.</li><li><span title=\"CONVEX_HULL\">Convex hull</span>—The convex hull of the symbolized geometry of the feature will be created. This is the default.</li><li><span title=\"EXACT_SIMPLIFIED\">Exact simplified</span>—A generalized polygon representing the exact shape of the symbolized feature will be created. Polygons created with this method will have a significantly smaller number of vertices compared to polygons created with the <span class=\"esri_uicontrol\">Exact</span> option.</li><li><span title=\"EXACT\">Exact</span>—A polygon representing the exact shape of the symbolized feature will be created.</li></ul></xdoc>",
        "method.domain.BOX": "Box",
        "method.domain.CONVEX_HULL": "Convex hull",
        "method.domain.EXACT": "Exact",
        "method.domain.EXACT_SIMPLIFIED": "Exact simplified",
        "method.title": "Mask Kind",
        "output_fc.descr": "The feature class that will contain the mask features.",
        "output_fc.title": "Output Feature Class",
        "preserve_small_sized_features.descr": "<xdoc><p>Specifies whether small mask features will be included in the output feature class.<ul><li>Unchecked—Small mask features will not be included in the output feature class. This is the default.</li><li>Checked—All mask features will be included in the output feature class.</li></ul></p></xdoc>",
        "preserve_small_sized_features.title": "Preserve small-sized features",
        "reference_scale.descr": "The reference scale that will be used for calculating the masking geometry when masks are specified in page units. This is typically the reference scale of the map.",
        "reference_scale.title": "Reference Scale",
        "spatial_reference.descr": "The spatial reference of the map in which the masking polygons will be created. This is not the spatial reference that will be assigned to the output feature class. It is the spatial reference of the map in which the masking polygons will be used, since the position of symbology may change when features are projected.",
        "spatial_reference.title": "Calculation Coordinate System",
        "title": "Feature Outline Masks"
    }
}
