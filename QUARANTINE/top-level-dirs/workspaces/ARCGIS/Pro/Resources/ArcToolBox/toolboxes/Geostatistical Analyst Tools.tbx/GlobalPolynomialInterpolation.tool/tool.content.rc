{
    "map": {
        "cell_size.descr": "<xdoc><p>The cell size at which the output raster will be created.</p><p>This value can be explicitly set in the <span class=\"esri_uicontrol\">Environments</span> by the <span class=\"esri_uicontrol\">Cell Size</span> parameter.</p><p>If not set, it is the shorter of the width or the height of the extent of the input point features, in the input spatial reference, divided by 250.</p></xdoc>",
        "cell_size.title": "Output cell size",
        "description": "Fits a smooth surface that is defined by a mathematical function (a polynomial) to the input sample points.",
        "in_features.descr": "The input point features containing the z-values to be interpolated.",
        "in_features.title": "Input features",
        "out_ga_layer.descr": "The geostatistical layer produced. This layer is required output only if no output raster is requested.",
        "out_ga_layer.title": "Output geostatistical layer",
        "out_raster.descr": "The output raster. This raster is required output only if no output geostatistical layer is requested.",
        "out_raster.title": "Output raster",
        "power.descr": "The order of the polynomial.",
        "power.title": "Order of polynomial",
        "title": "Global Polynomial Interpolation",
        "weight_field.descr": "Used to emphasize an observation. The larger the weight, the more impact it has on the prediction. For coincident observations, assign the largest weight to the most reliable measurement.",
        "weight_field.title": "Weight field",
        "z_field.descr": "Field that holds a height or magnitude value for each point. This can be a numeric field or the Shape field if the input features contain z-values or m-values.",
