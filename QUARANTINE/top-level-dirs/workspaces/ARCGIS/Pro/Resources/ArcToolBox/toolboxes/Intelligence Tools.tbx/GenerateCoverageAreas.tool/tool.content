    "displayname": "$rc:title",
    "helpcontent": "73020002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "description": "$rc:in_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "buffer_type": {
            "control_guid": "{BEDF969C-20D2-4C41-96DA-32408CA72BF6}",
            "displayname": "$rc:buffer_type.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPLinearUnit"
                    },
                    {
                        "type": "Field"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:buffer_type.descr"
        },
        "range_unit": {
            "type": "optional",
            "displayname": "$rc:range_unit.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "Meters",
                        "code": "$rc:range_unit.domain.Meters"
                    },
                    {
                        "value": "Kilometers",
                        "code": "$rc:range_unit.domain.Kilometers"
                    },
                    {
                        "value": "Feet",
                        "code": "$rc:range_unit.domain.Feet"
                    },
                    {
                        "value": "Miles",
                        "code": "$rc:range_unit.domain.Miles"
                    },
                    {
                        "value": "NauticalMiles",
                        "code": "$rc:range_unit.domain.NauticalMiles"
                    }
                ]
            },
            "description": "$rc:range_unit.descr"
        },
        "start_time_field": {
            "type": "optional",
            "displayname": "$rc:start_time_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Date"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:start_time_field.descr"
        },
        "end_time_field": {
            "type": "optional",
            "displayname": "$rc:end_time_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Date"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:end_time_field.descr"
        }
