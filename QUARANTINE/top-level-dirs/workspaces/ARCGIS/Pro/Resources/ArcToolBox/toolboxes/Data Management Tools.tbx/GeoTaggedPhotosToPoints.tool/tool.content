{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3290001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Folder": {
            "displayname": "$rc:input_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:input_folder.descr"
        },
        "Output_Feature_Class": {
            "direction": "out",
            "displayname": "$rc:output_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_feature_class.descr"
        },
        "Invalid_Photos_Table": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:invalid_photos_table.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:invalid_photos_table.descr"
        },
        "Include_Non-GeoTagged_Photos": {
            "type": "optional",
            "displayname": "$rc:include_non-geotagged_photos.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ALL_PHOTOS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "ONLY_GEOTAGGED"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:include_non-geotagged_photos.descr"
        },
        "Add_Photos_As_Attachments": {
            "type": "optional",
            "displayname": "$rc:add_photos_as_attachments.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_ATTACHMENTS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_ATTACHMENTS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:add_photos_as_attachments.descr"
        }
    },
    "environments": [
        "outputZFlag",
        "scratchWorkspace",
        "workspace"
    ]
}
