{
    "type": "FunctionTool",
    "guid": "{26B17338-CB00-45A9-AB9C-858C2E0122C9}/ExtractDataByFeature",
    "displayname": "$rc:title",
    "helpcontent": "46040309",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "params": {
        "in_datasets": {
            "displayname": "$rc:in_datasets.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPComposite",
                        "datatypes": [
                            {
                                "type": "GPFeatureLayer"
                            },
                            {
                                "type": "GPTableView"
                            },
                            {
                                "type": "DEDatasetType"
                            }
                        ],
                        "displayname": "$rc:in_datasets.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:in_datasets.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "ALL_ROWS",
                                "code": "$rc:in_datasets.domain.item2.ALL_ROWS"
                            },
                            {
                                "value": "SCHEMA_ONLY",
                                "code": "$rc:in_datasets.domain.item2.SCHEMA_ONLY"
                            },
                            {
                                "value": "USE_FILTERS",
                                "code": "$rc:in_datasets.domain.item2.USE_FILTERS"
                            }
                        ]
                    }
                ]
            },
            "description": "$rc:in_datasets.descr"
        },
        "target_gdb": {
            "displayname": "$rc:target_gdb.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEGeoDataServer"
                    }
                ]
            },
            "description": "$rc:target_gdb.descr"
        },
        "reuse_schema": {
            "type": "optional",
            "displayname": "$rc:reuse_schema.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "REUSE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_REUSE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:reuse_schema.descr"
        },
        "filter_feature": {
            "type": "optional",
            "displayname": "$rc:filter_feature.title",
            "datatype": {
                "type": "GPLayer"
            },
            "domain": {
                "type": "GPLayerDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:filter_feature.descr"
        },
        "filter_type": {
            "type": "optional",
            "displayname": "$rc:filter_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INTERSECTS",
                        "code": "$rc:filter_type.domain.INTERSECTS"
                    },
                    {
                        "value": "CONTAINS",
                        "code": "$rc:filter_type.domain.CONTAINS"
                    },
                    {
                        "value": "CLIP",
                        "code": "$rc:filter_type.domain.CLIP"
                    }
                ]
            },
            "description": "$rc:filter_type.descr"
        },
        "checkout_replica": {
            "type": "optional",
            "displayname": "$rc:checkout_replica.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CHECKOUT_REPLICA"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_CHECKOUT_REPLICA"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:checkout_replica.descr"
        },
        "replica_name": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:replica_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:replica_name.descr"
        },
        "updated_target_gdb": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_target_gdb.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEGeoDataServer"
                    }
                ]
            },
            "depends": [
                "target_gdb"
            ]
        },
        "expand_feature_classes_and_tables": {
            "type": "optional",
            "displayname": "$rc:expand_feature_classes_and_tables.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "USE_DEFAULTS",
                        "code": "$rc:expand_feature_classes_and_tables.domain.USE_DEFAULTS"
                    },
                    {
                        "value": "ADD_WITH_SCHEMA_ONLY",
                        "code": "$rc:expand_feature_classes_and_tables.domain.ADD_WITH_SCHEMA_ONLY"
                    },
                    {
                        "value": "ALL_ROWS",
                        "code": "$rc:expand_feature_classes_and_tables.domain.ALL_ROWS"
                    },
                    {
                        "value": "DO_NOT_ADD",
                        "code": "$rc:expand_feature_classes_and_tables.domain.DO_NOT_ADD"
                    }
                ]
            },
            "value": "DO_NOT_ADD",
            "description": "$rc:expand_feature_classes_and_tables.descr"
        },
        "get_related_data": {
            "type": "optional",
            "displayname": "$rc:get_related_data.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "GET_RELATED"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_GET_RELATED"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:get_related_data.descr"
        },
        "excluded_rel_classes": {
            "type": "optional",
            "displayname": "$rc:excluded_rel_classes.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "DERelationshipClass"
                }
            },
            "description": "$rc:excluded_rel_classes.descr"
        },
        "where_clause": {
            "type": "optional",
            "displayname": "$rc:where_clause.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "in_datasets"
            ],
            "description": "$rc:where_clause.descr"
        }
    }
}
