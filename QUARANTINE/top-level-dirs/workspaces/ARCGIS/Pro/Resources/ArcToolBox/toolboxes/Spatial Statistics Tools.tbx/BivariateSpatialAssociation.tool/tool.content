{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\BivariateSpatialAssociation",
    "displayname": "$rc:title",
    "helpcontent": "9060018",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "analysis_field1": {
            "displayname": "$rc:analysis_field1.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:analysis_field1.descr"
        },
        "analysis_field2": {
            "displayname": "$rc:analysis_field2.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:analysis_field2.descr"
        },
        "out_features": {
            "direction": "out",
            "displayname": "$rc:out_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_features.descr"
        },
        "neighborhood_type": {
            "type": "optional",
            "displayname": "$rc:neighborhood_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DISTANCE_BAND",
                        "code": "$rc:neighborhood_type.domain.DISTANCE_BAND"
                    },
                    {
                        "value": "K_NEAREST_NEIGHBORS",
                        "code": "$rc:neighborhood_type.domain.K_NEAREST_NEIGHBORS"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_ONLY",
                        "code": "$rc:neighborhood_type.domain.CONTIGUITY_EDGES_ONLY"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_CORNERS",
                        "code": "$rc:neighborhood_type.domain.CONTIGUITY_EDGES_CORNERS"
                    },
                    {
                        "value": "DELAUNAY_TRIANGULATION",
                        "code": "$rc:neighborhood_type.domain.DELAUNAY_TRIANGULATION"
                    },
                    {
                        "value": "GET_SPATIAL_WEIGHTS_FROM_FILE",
                        "code": "$rc:neighborhood_type.domain.GET_SPATIAL_WEIGHTS_FROM_FILE"
                    }
                ]
            },
            "description": "$rc:neighborhood_type.descr"
        },
        "distance_band": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:distance_band.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Meters",
                    "Kilometers",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:distance_band.descr"
        },
        "num_neighbors": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:num_neighbors.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "2",
                "max": "1000"
            },
            "value": "8",
            "description": "$rc:num_neighbors.descr"
        },
        "weights_matrix_file": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:weights_matrix_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "swm"
                ]
            },
            "description": "$rc:weights_matrix_file.descr"
        },
        "local_weighting_scheme": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:local_weighting_scheme.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UNWEIGHTED",
                        "code": "$rc:local_weighting_scheme.domain.UNWEIGHTED"
                    },
                    {
                        "value": "BISQUARE",
                        "code": "$rc:local_weighting_scheme.domain.BISQUARE"
                    }
                ]
            },
            "value": "UNWEIGHTED",
            "description": "$rc:local_weighting_scheme.descr"
        },
        "kernel_bandwidth": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:kernel_bandwidth.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Meters",
                    "Kilometers",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:kernel_bandwidth.descr"
        },
        "num_permutations": {
            "type": "optional",
            "displayname": "$rc:num_permutations.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLong",
                        "value": "99",
                        "code": "99"
                    },
                    {
                        "type": "GPLong",
                        "value": "199",
                        "code": "199"
                    },
                    {
                        "type": "GPLong",
                        "value": "499",
                        "code": "499"
                    },
                    {
                        "type": "GPLong",
                        "value": "999",
                        "code": "999"
                    },
                    {
                        "type": "GPLong",
                        "value": "4999",
                        "code": "4999"
                    },
                    {
                        "type": "GPLong",
                        "value": "9999",
                        "code": "9999"
                    }
                ]
            },
            "value": "999",
            "description": "$rc:num_permutations.descr"
        },
        "lee_l": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:lee_l.title",
            "datatype": {
                "type": "GPDouble"
            }
        },
        "p_value": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:p_value.title",
            "datatype": {
                "type": "GPDouble"
            }
        },
        "corr": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:corr.title",
            "datatype": {
                "type": "GPDouble"
            }
        }
    },
    "environments": [
        "geographicTransformations",
        "outputCoordinateSystem",
        "parallelProcessingFactor",
        "randomGenerator"
    ]
}
