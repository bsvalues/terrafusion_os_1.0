{
    "map": {
        "airport_control_point_feature_class.descr": "Supplies x-, y-, and z-geometry for displaced threshold features. If displaced thresholds are included, surfaces will be constructed based on their x-, y-, and z-geometry instead of their corresponding runway feature endpoint.",
        "airport_control_point_feature_class.title": "Input Airport Control Point Feature",
        "derived_outfeatureclass.title": "Output OIS Features",
        "description": "Creates a Light Signal Clearance Surface (LSCS) based on the FAA Engineering Brief (EB) 95.",
        "distance_from_threshold.descr": "The distance from the threshold in feet. The default value is 1000.",
        "distance_from_threshold.title": "Distance From Threshold",
        "divergence.descr": "The divergence of the surface in degrees. The default value is 14.",
        "divergence.title": "Divergence",
        "first_papi_light.descr": "The location of the first precision approach path indicator. The default value is 60.",
        "first_papi_light.title": "First PAPI Light",
        "in_features.descr": "The input runway dataset. The feature class must be z-enabled and contain polylines.",
        "in_features.title": "Input Runway Features",
        "last_papi_light.descr": "The location of the last precision approach path indicator. The default value is 120.",
        "last_papi_light.title": "Last PAPI Light",
        "length.descr": "The length of the surface in miles. The default value is 8.",
        "length.title": "Length",
        "runway_direction.descr": "<xdoc><p>Specifies the end of the runway where the approach surface will be created.</p><ul><li><span title=\"HIGH_RUNWAY_END_DESIGNATOR\">High Runway End Designator</span>— The approach surface will be created at the high end of the runway. This is the default.</li><li><span title=\"LOW_RUNWAY_END_DESIGNATOR\">Low Runway End Designator</span>—The approach surface will be created at the low end of the runway.</li></ul></xdoc>",
        "runway_direction.domain.HIGH_RUNWAY_END_DESIGNATOR": "High Runway End Designator",
        "runway_direction.domain.LOW_RUNWAY_END_DESIGNATOR": "Low Runway End Designator",
        "runway_direction.title": "Runway Direction",
        "slope.descr": "The slope of the surface in degrees. The default value is 1.",
        "slope.title": "Slope",
        "start_height.descr": "The start height of the surface. The default value is 35.",
        "start_height.title": "Start Height",
        "summary": "<xdoc><p>Creates a Light Signal Clearance Surface (LSCS) based on the FAA Engineering Brief (EB) 95.</p><p>A LSCS determines which objects are vertical obstructions. An object is considered as vertical obstruction if it penetrates the LSCS. Surfaces are used to support planning and design activities.</p></xdoc>",
        "surface_position.descr": "<xdoc><p>Specifies the position of the precision approach path indicator (PAPI) lights on either side of a runway. The position of the PAPI lights will be used to determine the position of the output surface.</p><ul><li><span title=\"SURFACE_GENERATED_ON_LEFT\">Generate surface on left approach side of the runway</span>—PAPI lights are on the left approach side of the runway. The surface will generate on the left approach side of the runway. This is the default.</li><li><span title=\"SURFACE_GENERATED_ON_RIGHT\">Generate surface on right approach side of the runway</span>—PAPI lights are on the right approach side of the runway. The surface will generate on the right approach side of the runway.</li></ul></xdoc>",
        "surface_position.domain.SURFACE_GENERATED_ON_LEFT": "Generate surface on left approach side of the runway",
        "surface_position.domain.SURFACE_GENERATED_ON_RIGHT": "Generate surface on right approach side of the runway",
        "surface_position.title": "Surface Position",
        "target.descr": "The target feature class that will contain the generated OIS.",
        "target.title": "Target OIS Features",
        "title": "Light Signal Clearance Surface"
    }
}
