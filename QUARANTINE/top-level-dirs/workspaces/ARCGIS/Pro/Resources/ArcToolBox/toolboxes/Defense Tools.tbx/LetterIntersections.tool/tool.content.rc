{
    "map": {
        "add_distance_and_bearing.descr": "<xdoc><p>Specifies whether fields will be added to the output for distance and bearing to a center point.</p><ul><li><span title=\"DONT_ADD_DISTANCE\">Do not add distance and bearing</span>—No distance or bearing fields will be added to the output. This is the default.</li><li><span title=\"ADD_DISTANCE\">Add distance and bearing</span>—<span class=\"esri_fieldname\">DIST_TO_CENTER</span> and <span class=\"esri_fieldname\">ANGLE_TO_CENTER</span> fields will be added to the output.</li></ul></xdoc>",
        "add_distance_and_bearing.title": "Add Distance and Bearing to Center",
        "center_point.descr": "The center point that will be used to sort and letter features.",
        "center_point.title": "Center Point",
        "description": "Identifies intersections in a line feature class and adds sequential letters to output point features.",
        "field_to_letter.descr": "The name of the field that will contain the letter designator for each intersection.",
        "field_to_letter.title": "Field to Letter (New Field Name)",
        "in_area.descr": "The area that will limit the intersections identified; only intersections within this area will be identified and lettered.",
        "in_area.title": "Input Area to Letter",
        "in_features.descr": "The input line features with intersections that will be lettered.",
        "in_features.title": "Input Line Features",
        "lettering_format.descr": "<xdoc><p>Specifies the labeling format that will be used for each feature.</p><ul><li><span title=\"A_B_C\">Excel (A, B, C, ...)</span>—An alpha character (for example, A, B, C) will be used. This is the default.</li><li><span title=\"AA_AB_AC\">Grid (AA, AB, AC, ...)</span>—A constant alpha character with an incrementing second alpha character grid (for example, AA, AB, AC) will be used.</li><li><span title=\"AA_BB_CC\">Alternating Grid (AA, BB, CC, ...)</span>—A double alpha character that is incremented for each feature (for example, AA, BB, CC) will be used.</li></ul></xdoc>",
        "lettering_format.domain.AA_AB_AC": "Grid (AA, AB, AC, ...)",
        "lettering_format.domain.AA_BB_CC": "Alternating Grid (AA, BB, CC, ...)",
        "lettering_format.domain.A_B_C": "Excel (A, B, C, ...)",
        "lettering_format.title": "Lettering Format",
        "min_out_point_distance.descr": "The minimum distance between intersections that are identified for lettering.",
        "min_out_point_distance.title": "Minimum Distance Between Output Points",
        "omit_letters.descr": "The values that will be omitted from the lettering sequence.",
        "omit_letters.title": "Omit Letters",
        "out_feature_class.descr": "The output point feature class.",
        "out_feature_class.title": "Output Intersection Points Feature Class",
        "spatial_sort_method.descr": "<xdoc><p>Specifies how features will be spatially sorted for the purpose of lettering. Features are not reordered in the table.</p><ul><li><span title=\"UR\">Upper right</span>—Features will be sorted starting at the upper right corner. This is the default.</li><li><span title=\"UL\">Upper left</span>—Features will be sorted starting at the upper left corner.</li><li><span title=\"LR\">Lower right</span>—Features will be sorted starting at the lower right corner.</li><li><span title=\"LL\">Lower left</span>—Features will be sorted starting at the lower left corner.</li><li><span title=\"PEANO\">Peano curve</span>—Features will be sorted using a space-filling curve algorithm, also known as a Peano curve.</li><li><span title=\"CENTER\">Center</span>—Features will be sorted starting from a center point (the mean center will be used if no center is provided).</li><li><span title=\"CLOCKWISE\">Clockwise</span>—Features will be sorted starting from a center point and moving clockwise.</li><li><span title=\"COUNTERCLOCKWISE\">Counterclockwise</span>—Features will be sorted starting from a center point and moving counterclockwise.</li><li><span title=\"NONE\">None</span>—No spatial sort will be used. The same order as the feature class will be used.</li></ul></xdoc>",
        "spatial_sort_method.domain.CENTER": "Center",
        "spatial_sort_method.domain.CLOCKWISE": "Clockwise",
        "spatial_sort_method.domain.COUNTERCLOCKWISE": "Counterclockwise",
        "spatial_sort_method.domain.LL": "Lower left",
        "spatial_sort_method.domain.LR": "Lower right",
        "spatial_sort_method.domain.NONE": "None",
        "spatial_sort_method.domain.PEANO": "Peano curve",
        "spatial_sort_method.domain.UL": "Upper left",
        "spatial_sort_method.domain.UR": "Upper right",
        "spatial_sort_method.title": "Spatial Sort Method",
        "starting_letter.descr": "The value that will be used to begin lettering.",
        "starting_letter.title": "Starting Letter",
        "title": "Letter Intersections"
    }
}
