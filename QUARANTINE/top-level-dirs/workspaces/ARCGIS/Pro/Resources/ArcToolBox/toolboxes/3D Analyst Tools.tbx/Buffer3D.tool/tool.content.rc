{
    "map": {
        "buffer_distance_or_field.descr": "<xdoc><p>The radial distance around the input features that will be buffered. Distances can be provided as either a value representing a linear distance or a field from the input features that contains the distance to buffer each feature.</p><p>If no linear units are specified or are entered as Unknown, the linear unit of the input features&apos; spatial reference will be used.</p></xdoc>",
        "buffer_distance_or_field.title": "Distance",
        "buffer_joint_type.descr": "<xdoc><p>Specifies the shape of the buffer between the vertices of the line segments. This parameter is only valid for input line features.</p><ul><li><span title=\"STRAIGHT\">Straight</span>—The shape of connections between vertices will be straight. This is the default.</li><li><span title=\"ROUND\">Round</span>—The shape of connections between vertices will be round.</li></ul></xdoc>",
        "buffer_joint_type.domain.ROUND": "Round",
        "buffer_joint_type.domain.STRAIGHT": "Straight",
        "buffer_joint_type.title": "Joint Type",
        "buffer_quality.descr": "The number of segments that will be used to represent the resulting multipatch features. A higher value produces smoother 3D features but lengthens the processing time. Any number in the range of 6 to 60 can be provided. The default is 20.",
        "buffer_quality.title": "Buffer Quality",
        "description": "Creates a 3D buffer around points or lines to produce spherical or cylindrical multipatch features.",
        "in_features.descr": "The line or point features that will be buffered.",
        "in_features.title": "Input Features",
        "out_feature_class.descr": "The output multipatch containing the 3D buffers.",
        "out_feature_class.title": "Output Feature Class",
        "simplification_tolerance.descr": "Simplifies the input lines by maintaining their shape within the specified offset of its original form. Simplification will not occur if no tolerance value is specified.",
        "simplification_tolerance.title": "Simplification (Maximum Allowable Offset)",
        "title": "Buffer 3D"
    }
}
