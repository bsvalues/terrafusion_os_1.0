{
    "type": "ServerTool",
    "server": "Tools/Hydrology",
    "uri": "https://hydro.arcgis.com/arcgis/rest/services",
    "user": "UseSSOIdentityIfPortalOwned",
    "toolname": "Watershed",
    "displayname": "$rc:title",
    "helpcontent": "65020002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "InputPoints": {
            "displayname": "$rc:inputpoints.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "value_xml": "<GPFeatureRecordSetLayer xsi:type='typens:GPFeatureRecordSetLayer' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xmlns:xs='http://www.w3.org/2001/XMLSchema' xmlns:typens='http://www.esri.com/schemas/ArcGIS/3.4.0'><RecordSet xsi:type='typens:RecordSet'><Fields xsi:type='typens:Fields'><FieldArray xsi:type='typens:ArrayOfField'><Field xsi:type='typens:Field'><Name>OID</Name><Type>esriFieldTypeOID</Type><IsNullable>false</IsNullable><Length>4</Length><Precision>0</Precision><Scale>0</Scale><Required>true</Required><Editable>false</Editable><AliasName>OID</AliasName><ModelName>OID</ModelName></Field><Field xsi:type='typens:Field'><Name>Shape</Name><Type>esriFieldTypeGeometry</Type><IsNullable>true</IsNullable><Length>0</Length><Precision>0</Precision><Scale>0</Scale><Required>true</Required><GeometryDef xsi:type='typens:GeometryDef'><AvgNumPoints>0</AvgNumPoints><GeometryType>esriGeometryPoint</GeometryType><HasM>false</HasM><HasZ>false</HasZ><SpatialReference xsi:type='typens:ProjectedCoordinateSystem'><WKT>PROJCS[&quot;WGS_1984_Web_Mercator_Auxiliary_Sphere&quot;,GEOGCS[&quot;GCS_WGS_1984&quot;,DATUM[&quot;D_WGS_1984&quot;,SPHEROID[&quot;WGS_1984&quot;,6378137.0,298.257223563]],PRIMEM[&quot;Greenwich&quot;,0.0],UNIT[&quot;Degree&quot;,0.0174532925199433]],PROJECTION[&quot;Mercator_Auxiliary_Sphere&quot;],PARAMETER[&quot;False_Easting&quot;,0.0],PARAMETER[&quot;False_Northing&quot;,0.0],PARAMETER[&quot;Central_Meridian&quot;,0.0],PARAMETER[&quot;Standard_Parallel_1&quot;,0.0],PARAMETER[&quot;Auxiliary_Sphere_Type&quot;,0.0],UNIT[&quot;Meter&quot;,1.0],AUTHORITY[&quot;EPSG&quot;,3857]]</WKT><XOrigin>-20037700</XOrigin><YOrigin>-30241100</YOrigin><XYScale>10000</XYScale><ZOrigin>-100000</ZOrigin><ZScale>10000</ZScale><MOrigin>-100000</MOrigin><MScale>10000</MScale><XYTolerance>0.001</XYTolerance><ZTolerance>0.001</ZTolerance><MTolerance>0.001</MTolerance><HighPrecision>true</HighPrecision><WKID>102100</WKID><LatestWKID>3857</LatestWKID></SpatialReference><GridSize0>0</GridSize0></GeometryDef><AliasName>Shape</AliasName><ModelName>Shape</ModelName></Field><Field xsi:type='typens:Field'><Name>Name</Name><Type>esriFieldTypeString</Type><IsNullable>true</IsNullable><Length>60</Length><Precision>0</Precision><Scale>0</Scale><AliasName>Name</AliasName></Field></FieldArray></Fields><Records xsi:type='typens:ArrayOfRecord'></Records></RecordSet><OIDFieldName>OID</OIDFieldName><ShapeFieldName>Shape</ShapeFieldName></GPFeatureRecordSetLayer>",
            "description": "$rc:inputpoints.descr"
        },
        "PointIDField": {
            "type": "optional",
            "displayname": "$rc:pointidfield.title",
            "datatype": {
                "type": "Field"
            },
            "depends": [
                "InputPoints"
            ],
            "description": "$rc:pointidfield.descr"
        },
        "SnapDistance": {
            "type": "optional",
            "displayname": "$rc:snapdistance.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:snapdistance.descr"
        },
        "SnapDistanceUnits": {
            "type": "optional",
            "displayname": "$rc:snapdistanceunits.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "Meters",
                        "code": "$rc:snapdistanceunits.domain.Meters"
                    },
                    {
                        "value": "Kilometers",
                        "code": "$rc:snapdistanceunits.domain.Kilometers"
                    },
                    {
                        "value": "Feet",
                        "code": "$rc:snapdistanceunits.domain.Feet"
                    },
                    {
                        "value": "Yards",
                        "code": "$rc:snapdistanceunits.domain.Yards"
                    },
                    {
                        "value": "Miles",
                        "code": "$rc:snapdistanceunits.domain.Miles"
                    }
                ]
            },
            "value": "Meters",
            "description": "$rc:snapdistanceunits.descr"
        },
        "DataSourceResolution": {
            "type": "optional",
            "displayname": "$rc:datasourceresolution.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": " ",
                        "code": "$rc:datasourceresolution.domain. "
                    },
                    {
                        "value": "FINEST",
                        "code": "$rc:datasourceresolution.domain.FINEST"
                    },
                    {
                        "value": "10m",
                        "code": "$rc:datasourceresolution.domain.10m"
                    },
                    {
                        "value": "30m",
                        "code": "$rc:datasourceresolution.domain.30m"
                    },
                    {
                        "value": "90m",
                        "code": "$rc:datasourceresolution.domain.90m"
                    }
                ]
            },
            "value": " ",
            "description": "$rc:datasourceresolution.descr"
        },
        "Generalize": {
            "type": "optional",
            "displayname": "$rc:generalize.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "value": "false",
            "description": "$rc:generalize.descr"
        },
        "ReturnSnappedPoints": {
            "type": "optional",
            "displayname": "$rc:returnsnappedpoints.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "value": "false",
            "description": "$rc:returnsnappedpoints.descr"
        },
        "WatershedArea": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:watershedarea.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            }
        },
        "SnappedPoints": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:snappedpoints.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            }
        }
    }
}
