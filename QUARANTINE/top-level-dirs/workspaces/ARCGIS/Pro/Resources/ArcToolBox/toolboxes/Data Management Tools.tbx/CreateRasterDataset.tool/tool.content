{
    "type": "FunctionTool",
    "guid": "{6a5a85d7-4119-4ef7-b970-a437fe02d4ee}",
    "displayname": "$rc:title",
    "helpcontent": "3190203",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "params": {
        "out_path": {
            "display_order": "0",
            "control_guid": "{C49F778E-E3D8-4718-BE07-70A90AF336FE}",
            "displayname": "$rc:out_path.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "File System",
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:out_path.descr"
        },
        "out_name": {
            "display_order": "1",
            "displayname": "$rc:out_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_name.descr"
        },
        "cellsize": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:cellsize.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:cellsize.descr"
        },
        "pixel_type": {
            "display_order": "3",
            "displayname": "$rc:pixel_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "1_BIT",
                        "code": "$rc:pixel_type.domain.1_BIT"
                    },
                    {
                        "value": "2_BIT",
                        "code": "$rc:pixel_type.domain.2_BIT"
                    },
                    {
                        "value": "4_BIT",
                        "code": "$rc:pixel_type.domain.4_BIT"
                    },
                    {
                        "value": "8_BIT_UNSIGNED",
                        "code": "$rc:pixel_type.domain.8_BIT_UNSIGNED"
                    },
                    {
                        "value": "8_BIT_SIGNED",
                        "code": "$rc:pixel_type.domain.8_BIT_SIGNED"
                    },
                    {
                        "value": "16_BIT_UNSIGNED",
                        "code": "$rc:pixel_type.domain.16_BIT_UNSIGNED"
                    },
                    {
                        "value": "16_BIT_SIGNED",
                        "code": "$rc:pixel_type.domain.16_BIT_SIGNED"
                    },
                    {
                        "value": "32_BIT_UNSIGNED",
                        "code": "$rc:pixel_type.domain.32_BIT_UNSIGNED"
                    },
                    {
                        "value": "32_BIT_SIGNED",
                        "code": "$rc:pixel_type.domain.32_BIT_SIGNED"
                    },
                    {
                        "value": "32_BIT_FLOAT",
                        "code": "$rc:pixel_type.domain.32_BIT_FLOAT"
                    },
                    {
                        "value": "64_BIT",
                        "code": "$rc:pixel_type.domain.64_BIT"
                    }
                ]
            },
            "value": "8_BIT_UNSIGNED",
            "description": "$rc:pixel_type.descr"
        },
        "raster_spatial_reference": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:raster_spatial_reference.title",
            "datatype": {
                "type": "GPCoordinateSystem"
            },
            "depends": [
                "out_path"
            ],
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:raster_spatial_reference.descr"
        },
        "number_of_bands": {
            "display_order": "5",
            "displayname": "$rc:number_of_bands.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "1",
            "description": "$rc:number_of_bands.descr"
        },
        "config_keyword": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:config_keyword.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "defaultenvironmentname": "configKeyword",
            "description": "$rc:config_keyword.descr"
        },
        "pyramids": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:pyramids.title",
            "datatype": {
                "type": "GPSAGDBEnvPyramid"
            },
            "defaultenvironmentname": "pyramid",
            "value": "PYRAMIDS -1 NEAREST DEFAULT 75 NO_SKIP NO_SIPS",
            "description": "$rc:pyramids.descr"
        },
        "tile_size": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:tile_size.title",
            "datatype": {
                "type": "GPSAGDBEnvTileSize"
            },
            "defaultenvironmentname": "tileSize",
            "value": "128 128",
            "description": "$rc:tile_size.descr"
        },
        "compression": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:compression.title",
            "datatype": {
                "type": "GPSAGDBEnvCompression"
            },
            "defaultenvironmentname": "compression",
            "value": "LZ77",
            "description": "$rc:compression.descr"
        },
        "pyramid_origin": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:pyramid_origin.title",
            "datatype": {
                "type": "GPPoint"
            },
            "description": "$rc:pyramid_origin.descr"
        },
        "out_raster_dataset": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_raster_dataset.title",
            "datatype": {
                "type": "DERasterDataset"
            }
        }
    },
    "environments": [
        "compression",
        "configKeyword",
        "pyramid",
        "tileSize"
    ]
}
