{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\CentralFeature",
    "displayname": "$rc:title",
    "helpcontent": "9040001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Feature_Class": {
            "displayname": "$rc:input_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_feature_class.descr"
        },
        "Output_Feature_Class": {
            "direction": "out",
            "displayname": "$rc:output_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "Input_Feature_Class"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_feature_class.descr"
        },
        "Distance_Method": {
            "displayname": "$rc:distance_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "EUCLIDEAN_DISTANCE",
                        "code": "$rc:distance_method.domain.EUCLIDEAN_DISTANCE"
                    },
                    {
                        "value": "MANHATTAN_DISTANCE",
                        "code": "$rc:distance_method.domain.MANHATTAN_DISTANCE"
                    }
                ]
            },
            "value": "EUCLIDEAN_DISTANCE",
            "description": "$rc:distance_method.descr"
        },
        "Weight_Field": {
            "type": "optional",
            "displayname": "$rc:weight_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "Input_Feature_Class"
            ],
            "description": "$rc:weight_field.descr"
        },
        "Self_Potential_Weight_Field": {
            "type": "optional",
            "displayname": "$rc:self_potential_weight_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "Input_Feature_Class"
            ],
            "description": "$rc:self_potential_weight_field.descr"
        },
        "Case_Field": {
            "type": "optional",
            "displayname": "$rc:case_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Text",
                    "Date",
                    "BigInteger"
                ]
            },
            "depends": [
                "Input_Feature_Class"
            ],
            "description": "$rc:case_field.descr"
        }
    },
    "environments": [
        "MResolution",
        "MTolerance",
        "XYResolution",
        "XYTolerance",
        "ZResolution",
        "ZTolerance",
        "geographicTransformations",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "qualifiedFieldNames",
        "scratchWorkspace",
        "workspace"
    ]
}
