{
    "map": {
        "contour_interval.descr": "<xdoc><p>Specifies the contour interval that will be used to determine the closest available contour when calculating the elevation band area.</p><ul><li><span title=\"10\">10</span>—A contour interval of 10 will be used.</li><li><span title=\"20\">20</span>—A contour interval of 20 will be used. This is the default.</li><li><span title=\"40\">40</span>—A contour interval of 40 will be used.</li><li><span title=\"80\">80</span>—A contour interval of 80 will be used.</li></ul></xdoc>",
        "contour_interval.title": "Contour Interval",
        "description": "Creates an elevation bands feature class from a digital elevation model (DEM).",
        "in_aoi.descr": "The layer that will define the processing extent.",
        "in_aoi.title": "Area of Interest",
        "in_hydro_features.descr": "The bodies of water that will be excluded when calculating the elevation band area.",
        "in_hydro_features.title": "Hydro Exclusion Features",
        "in_raster.descr": "The rasters that will be used to create elevation bands.",
        "in_raster.title": "Input Raster",
        "min_area.descr": "<xdoc><p>The minimum area of the output polygons. Features smaller than this value will be removed. The default is 0.00016 square decimal degrees.<note type=\"note\"/><p group=\"note\">If you&apos;re creating an output dataset with a projected coordinate system, ensure that this value reflects the square units of that coordinate system—for example, square meters for a UTM dataset. Otherwise, the default value may result in an empty output dataset.</p></p></xdoc>",
        "min_area.title": "Minimum Feature Area",
        "number_of_bands.descr": "<xdoc><p>Specifies the number of elevation bands that will be generated.</p><ul><li><span title=\"1\">1</span>—One elevation band will be generated.</li><li><span title=\"2\">2</span>—Two elevation bands will be generated.</li><li><span title=\"3\">3</span>—Three elevation bands will be generated.</li><li><span title=\"4\">4</span>—Four elevation bands will be generated.</li></ul></xdoc>",
        "number_of_bands.title": "Number of Elevation Bands",
        "out_feature_class.descr": "The feature class containing the output elevation band features.",
        "out_feature_class.title": "Output Feature Class",
        "smooth_tolerance.descr": "The tolerance that will be used by the smoothing algorithm. The larger the value, the more generalized the output band features. The default is 0.002 decimal degrees.",
        "smooth_tolerance.title": "Smoothing Tolerance",
        "title": "Generate Elevation Bands"
    }
}
