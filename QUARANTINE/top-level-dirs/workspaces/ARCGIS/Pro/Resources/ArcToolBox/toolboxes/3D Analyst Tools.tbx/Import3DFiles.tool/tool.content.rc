{
    "map": {
        "description": "Imports one or more 3D models into a multipatch feature class.",
        "file_suffix.descr": "<xdoc><p>The file extension of the files to import from an input folder. This parameter is required when at least one folder is specified as an input.</p><ul><li><span title=\"*\">All Supported Files</span>—All supported files. This is the default.</li><li><span title=\"3DS\">3D Studio Max (*.3ds)</span>—3D Studio Max</li><li><span title=\"WRL\">VRML or GeoVRML (*.wrl)</span>—VRML or GeoVRML</li><li><span title=\"FLT\">OpenFlight (*.flt)</span>—OpenFlight</li><li><span title=\"DAE\">Collada (*.dae)</span>—Collada</li><li><span title=\"OBJ\">Wavefront OBJ format (*.obj)</span>—Wavefront OBJ model</li></ul></xdoc>",
        "file_suffix.domain.*": "All Supported Files",
        "file_suffix.domain.3DS": "3D Studio Max (*.3ds)",
        "file_suffix.domain.DAE": "Collada (*.dae)",
        "file_suffix.domain.FLT": "OpenFlight (*.flt)",
        "file_suffix.domain.OBJ": "Wavefront OBJ format (*.obj)",
        "file_suffix.domain.WRL": "VRML or GeoVRML (*.wrl)",
        "file_suffix.title": "File Suffix",
        "in_featureclass.descr": "<xdoc><p>The point features whose coordinates define the real-world position of the input files. Each input file will be matched to its corresponding point based on the file names stored in the <span class=\"esri_uicontrol\">Symbol Field</span>. The <span class=\"esri_uicontrol\">Coordinate System</span> parameter should be defined to match the spatial reference of the points.</p></xdoc>",
        "in_featureclass.title": "Placement Points",
        "in_files.descr": "One or more 3D models or folders containing such files in the supported formats, which are 3D Studio Max (*.3ds), VRML and GeoVRML (*.wrl), OpenFlight (*.flt), COLLADA (*.dae), and Wavefront OBJ models (*.obj).",
        "in_files.title": "Input Files",
        "out_featureclass.descr": "The multipatch that will be created from the input files.",
        "out_featureclass.title": "Output Multipatch Feature Class",
        "root_per_feature.descr": "<xdoc><p>Indicates whether to produce one feature per file or one feature for every root node in the file. This option only applies to VRML models.</p><ul><li>Unchecked—The generated output will contain one file for each feature. This is the default.</li><li>Checked—The generated output will contain one feature for each root node in the file.</li></ul></xdoc>",
        "root_per_feature.title": "One Root Per Feature",
        "spatial_reference.descr": "The coordinate system of the input data. For the majority of formats, this is unknown. Only the GeoVRML format stores its coordinate system, and its default will be obtained from the first file in the list unless a spatial reference is specified here.",
        "spatial_reference.title": "Coordinate System",
        "symbol_field.descr": "The field in the point features containing the name of the 3D file associated with each point.",
        "symbol_field.title": "Symbol Field",
        "title": "Import 3D Files",
        "y_is_up.descr": "<xdoc><p>Identifies the axis that defines the vertical orientation of the input files.</p><ul><li>Unchecked—Indicates that z is up. This is the default.</li><li>Checked—Indicates that y is up.</li></ul></xdoc>",
        "y_is_up.title": "Y Is Up"
    }
}
