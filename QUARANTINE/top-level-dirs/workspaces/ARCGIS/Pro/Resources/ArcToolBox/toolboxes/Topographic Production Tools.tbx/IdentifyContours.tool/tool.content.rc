        "base_contour.descr": "The value that contours will be generated above and below to cover the entire value range of the input raster. The default is 0.",
        "base_contour.title": "Base Contour",
        "contour_code_field.descr": "The field in the input contour feature class that will be updated with the appropriate domain code.",
        "contour_code_field.title": "Contour Code Field",
        "contour_height_field.descr": "The field in the input contour feature class that contains elevation values. This field type must be numeric.",
        "contour_height_field.title": "Contour Height Field",
        "contour_index_interval.descr": "The interval, or distance, between index contour lines. The default is 100.",
        "contour_index_interval.title": "Contour Index Interval",
        "contour_interval.descr": "The interval, or distance, between contour lines. This can be any positive number. The default is 20.",
        "contour_interval.title": "Contour Interval",
        "depression_auxiliary_code.descr": "<xdoc><p>The code value that will be stored in the <span class=\"esri_uicontrol\">Contour Code Field</span> parameter value when a depression auxiliary contour is identified. The default code will be 22 if the <span class=\"esri_fieldname\">HQC</span> field exists in the input contour feature class.</p></xdoc>",
        "depression_auxiliary_code.title": "Depression Auxiliary Code",
        "depression_code.descr": "<xdoc><p>The value that will be used to populate the <span class=\"esri_uicontrol\">Contour Code Field</span> parameter value when depression contours are identified. The default is 5.</p></xdoc>",
        "depression_code.title": "Depression Code",
        "depression_contours_count.descr": "The number of contours in a depression that will be coded as depressions. The value provided must be greater than zero. If no value is provided, all of the contours in the depression will be coded as depressions.",
        "depression_contours_count.title": "Number of Depression Contours to Identify",
        "depression_intermediate_code.descr": "<xdoc><p>The value that will be used to populate the <span class=\"esri_uicontrol\">Contour Code Field</span> parameter value when depression intermediate contours are identified. The default is 6.</p></xdoc>",
        "depression_intermediate_code.title": "Depression Intermediate Code",
        "description": "Identifies types of contours and applies hypsographic codes to input features.",
        "half_auxiliary_code.descr": "<xdoc><p>The code value that will be stored in the <span class=\"esri_uicontrol\">Contour Code Field</span> parameter value when a half auxiliary contour is identified. The default code will be 3 if the <span class=\"esri_fieldname\">HQC</span> field exists in the input contour feature class.</p></xdoc>",
        "half_auxiliary_code.title": "Half Auxiliary Code",
        "in_contour_features.descr": "The input contours that will be updated with the specified contour codes.",
        "in_contour_features.title": "Input Contours",
        "in_rasters.descr": "The rasters that will be used to derive elevations of points inside contours to correctly identify the types of contours.",
        "in_rasters.title": "Input Rasters",
        "index_code.descr": "<xdoc><p>The value that will be used to populate the <span class=\"esri_uicontrol\">Contour Code Field</span> parameter value when index contours are identified. The default is 1.</p></xdoc>",
        "index_code.title": "Index Code",
        "intermediate_code.descr": "<xdoc><p>The value that will be used to populate the <span class=\"esri_uicontrol\">Contour Code Field</span> parameter value when intermediate contours are identified. The default is 2.</p></xdoc>",
        "intermediate_code.title": "Intermediate Code",
        "params.category1": "Supplemental Contour Codes",
        "quarter_auxiliary_code.descr": "<xdoc><p>The code value that will be stored in the <span class=\"esri_uicontrol\">Contour Code Field</span> parameter value when a quarter auxiliary contour is identified. The default code will be 14 if the <span class=\"esri_fieldname\">HQC</span> field exists in the input contour feature class.</p></xdoc>",
        "quarter_auxiliary_code.title": "Quarter Auxiliary Code",
        "supplemental_contours.descr": "<xdoc><p>Specifies the interval at which supplemental contours will be created. Supplemental contours are used when the terrain change is not large enough to be depicted with consistent contour intervals.</p><ul><li><span title=\"NONE\">None</span>—No supplemental contours will be created. This is the default.</li><li><span title=\"HALF_AUXILIARY\">Half Auxiliary</span>—Supplemental contours will be created at one-half the contour interval.</li><li><span title=\"QUARTER_AUXILIARY\">Quarter Auxiliary</span>—Supplemental contours will be created at one-quarter the contour interval.</li></ul></xdoc>",
        "supplemental_contours.domain.HALF_AUXILIARY": "Half Auxiliary",
        "supplemental_contours.domain.NONE": "None",
        "supplemental_contours.domain.QUARTER_AUXILIARY": "Quarter Auxiliary",
        "supplemental_contours.title": "Supplemental Contours",
        "title": "Identify Contours",
        "updated_contour_features.title": "Updated Contours",
        "z_factor.descr": "<xdoc><p>The conversion factor that will be used to convert the contour elevation value unit of measurement to match the raster&apos;s unit of measurement. The default is 1.</p><p>For example, if the elevation values in the input raster are in meters but the contours are in feet, set the z-factor to 3.28084 (1 meter = 3.28084 feet).</p></xdoc>",
        "z_factor.title": "Z Factor"
    }
}
