        "case_field.descr": "Field used to group features for separate central feature computations. The case field can be of integer, date, or string type.",
        "case_field.title": "Case Field",
        "description": "Identifies the most centrally located feature in a point, line, or polygon feature class.",
        "distance_method.descr": "<xdoc><p>Specifies how distances are calculated from each feature to neighboring features.</p><ul><li><span title=\"EUCLIDEAN_DISTANCE\">Euclidean</span>—The straight-line distance between two points (as the crow flies)</li><li><span title=\"MANHATTAN_DISTANCE\">Manhattan</span>—The distance between two points measured along axes at right angles (city block); calculated by summing the (absolute) difference between the x- and y-coordinates</li></ul></xdoc>",
        "distance_method.domain.EUCLIDEAN_DISTANCE": "Euclidean",
        "distance_method.domain.MANHATTAN_DISTANCE": "Manhattan",
        "distance_method.title": "Distance Method",
        "input_feature_class.descr": "The feature class containing a distribution of features from which to identify the most centrally located feature.",
        "input_feature_class.title": "Input Feature Class",
        "output_feature_class.descr": "<xdoc><p>The feature class that will contain the most centrally located feature in the <span class=\"esri_uicontrol\">Input Feature Class</span>.</p></xdoc>",
        "output_feature_class.title": "Output Feature Class",
