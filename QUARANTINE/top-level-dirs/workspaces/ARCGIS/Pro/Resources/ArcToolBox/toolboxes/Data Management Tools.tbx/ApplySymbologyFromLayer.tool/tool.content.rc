{
    "map": {
        "description": "Applies the symbology from a specified layer or layer file to the input. It can be applied to feature, raster, network analysis, TIN, and geostatistical layers.",
        "in_layer.descr": "The layer to which the symbology will be applied.",
        "in_layer.title": "Input Layer",
        "in_symbology_layer.descr": "The layer containing the symbology that will be applied to the input layer. Both .lyrx and .lyr files are supported.",
        "in_symbology_layer.title": "Symbology Layer",
        "out_layer.title": "Updated Input Layer",
        "symbology_fields.descr": "<xdoc><p>The fields from the input layer that match the symbology fields used in the symbology layer. Symbology fields contain three properties:<ul><li>Field type—The field type: symbology value, normalization, or other type.</li><li>Source field—The symbology field used by the symbology layer. Use a blank value or &quot;#&quot; if you do not know the source field and want to use the default.</li><li>Target field—The field from the input layer to use when applying the symbology.</li></ul></p><p>Supported field types are as follows:<ul><li>Value field—Primary field used to symbolize values</li><li>Normalization field—Field used to normalize quantitative values</li><li>Exclusion clause field—Field used for the symbology exclusion clause</li><li>Chart renderer pie size field—Field used to set the size of pie chart symbols</li><li>Rotation X expression field—Field used to set the rotation of symbols on the x-axis</li><li>Rotation Y expression field—Field used to set the rotation of symbols on the y-axis</li><li>Rotation Z expression field—Field used to set the rotation of symbols on the z-axis</li><li>Transparency expression field—Field used to set the transparency of symbols</li><li>Transparency normalization field—Field used to normalize transparency values</li><li>Size expression field—Field used to set the size or width of symbols</li><li>Color expression field—Field used to set the color of symbols</li><li>Primitive override expression field—Field used to set various properties on individual symbol layers</li></ul></p></xdoc>",
        "symbology_fields.domain.item1.CHART_RENDERER_PIE_SIZE_FIELD": "Chart renderer pie size field",
        "symbology_fields.domain.item1.COLOR_EXPRESSION_FIELD": "Color expression field",
        "symbology_fields.domain.item1.EXCLUSION_CLAUSE_FIELD": "Exclusion clause field",
        "symbology_fields.domain.item1.NORMALIZATION_FIELD": "Normalization field",
        "symbology_fields.domain.item1.PRIMITIVE_OVERRIDE_EXPRESSION_FIELD": "Primitive override expression field",
        "symbology_fields.domain.item1.ROTATION_XEXPRESSION_FIELD": "Rotation X expression field",
        "symbology_fields.domain.item1.ROTATION_YEXPRESSION_FIELD": "Rotation Y expression field",
        "symbology_fields.domain.item1.ROTATION_ZEXPRESSION_FIELD": "Rotation Z expression field",
        "symbology_fields.domain.item1.SIZE_EXPRESSION_FIELD": "Size expression field",
        "symbology_fields.domain.item1.TRANSPARENCY_EXPRESSION_FIELD": "Transparency expression field",
        "symbology_fields.domain.item1.TRANSPARENCY_NORMALIZATION_FIELD": "Transparency normalization field",
        "symbology_fields.domain.item1.VALUE_FIELD": "Value field",
        "symbology_fields.dt.title1": "Type",
        "symbology_fields.dt.title2": "Source Field",
        "symbology_fields.dt.title3": "Target Field",
        "symbology_fields.title": "Symbology Fields",
        "title": "Apply Symbology From Layer",
        "update_symbology.descr": "<xdoc><p>Specifies whether symbology ranges will be updated.</p><ul><li><span title=\"DEFAULT\">Default</span>—Symbology ranges will be updated, except when the input layer is empty, when the symbology layer uses class breaks (for example, graduated colors or graduated symbols) and the classification method is manual or defined interval, or when the symbology layer uses unique values and the <span class=\"esri_uicontrol\">Show all other values</span> option is checked.</li><li><span title=\"UPDATE\">Update ranges</span>—Symbology ranges will be updated.</li><li><span title=\"MAINTAIN\">Maintain ranges</span>—Symbology ranges will not be updated; they will be maintained.</li></ul></xdoc>",
        "update_symbology.domain.DEFAULT": "Default",
        "update_symbology.domain.MAINTAIN": "Maintain ranges",
        "update_symbology.domain.UPDATE": "Update ranges",
        "update_symbology.title": "Update Symbology Ranges by Data"
    }
}
