{
    "type": "FunctionTool",
    "guid": "{a85e9888-8ec8-45dc-bcdb-0e210cd52f50}",
    "displayname": "$rc:title",
    "helpcontent": "3260027",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_dataset": {
            "display_order": "0",
            "displayname": "$rc:in_dataset.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "SLPK",
                    "SPK"
                ]
            },
            "description": "$rc:in_dataset.descr"
        },
        "out_folder_path": {
            "display_order": "1",
            "control_guid": "{C49F778E-E3D8-4718-BE07-70A90AF336FE}",
            "displayname": "$rc:out_folder_path.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:out_folder_path.descr"
        },
        "out_name": {
            "display_order": "2",
            "displayname": "$rc:out_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_name.descr"
        },
        "out_log": {
            "type": "optional",
            "direction": "out",
            "display_order": "3",
            "displayname": "$rc:out_log.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "json"
                ]
            },
            "description": "$rc:out_log.descr"
        },
        "texture_optimization": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:texture_optimization.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ALL",
                        "code": "$rc:texture_optimization.domain.ALL"
                    },
                    {
                        "value": "NONE",
                        "code": "$rc:texture_optimization.domain.NONE"
                    },
                    {
                        "value": "DESKTOP",
                        "code": "$rc:texture_optimization.domain.DESKTOP"
                    },
                    {
                        "value": "MOBILE",
                        "code": "$rc:texture_optimization.domain.MOBILE"
                    }
                ]
            },
            "value": "DESKTOP",
            "description": "$rc:texture_optimization.descr"
        },
        "date_format": {
            "type": "optional",
            "displayname": "$rc:date_format.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "MMDDYYYY hh:mm:ss",
                        "code": "$rc:date_format.domain.MMDDYYYY hh:mm:ss"
                    },
                    {
                        "value": "MMDDYYYY",
                        "code": "$rc:date_format.domain.MMDDYYYY"
                    },
                    {
                        "value": "DDMMYYYY hh:mm:ss",
                        "code": "$rc:date_format.domain.DDMMYYYY hh:mm:ss"
                    },
                    {
                        "value": "DDMMYYYY",
                        "code": "$rc:date_format.domain.DDMMYYYY"
                    },
                    {
                        "value": "YYYYMMDD hh:mm:ss",
                        "code": "$rc:date_format.domain.YYYYMMDD hh:mm:ss"
                    },
                    {
                        "value": "YYYYMMDD",
                        "code": "$rc:date_format.domain.YYYYMMDD"
                    },
                    {
                        "value": "YYYYDDMM hh:mm:ss",
                        "code": "$rc:date_format.domain.YYYYDDMM hh:mm:ss"
                    },
                    {
                        "value": "YYYYDDMM",
                        "code": "$rc:date_format.domain.YYYYDDMM"
                    }
                ]
            },
            "description": "$rc:date_format.descr"
        }
    },
    "environments": [
        "timeZone"
    ]
}
