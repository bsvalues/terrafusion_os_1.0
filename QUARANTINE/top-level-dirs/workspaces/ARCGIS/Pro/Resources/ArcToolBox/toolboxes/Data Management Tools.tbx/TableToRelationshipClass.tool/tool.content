        "destination_primary_key": {
            "displayname": "$rc:destination_primary_key.title",
            "datatype": {
                "type": "GPString"
            },
            "depends": [
                "destination_table"
            ],
            "description": "$rc:destination_primary_key.descr"
        },
        "destination_foreign_key": {
            "displayname": "$rc:destination_foreign_key.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:destination_foreign_key.descr"
        }
    },
    "environments": [
        "autoCommit",
