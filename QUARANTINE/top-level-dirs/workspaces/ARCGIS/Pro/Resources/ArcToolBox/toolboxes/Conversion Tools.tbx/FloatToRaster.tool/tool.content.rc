{
    "map": {
        "description": "Converts a file of binary floating-point values representing raster data to a raster dataset.",
        "in_float_file.descr": "<xdoc><p>The input floating-point binary file.</p><p>The file must have a .flt extension. There must be a header file in association with the floating-point binary file, with a .hdr extension.</p></xdoc>",
        "in_float_file.title": "Input floating point raster file",
        "out_raster.descr": "<xdoc><p>The output raster dataset to be created.</p><p>If the output raster will not be saved to a geodatabase, specify .tif for TIFF file format, .CRF for CRF file format, .img for ERDAS IMAGINE file format, or no extension for Esri Grid raster format.</p></xdoc>",
        "out_raster.title": "Output raster",
        "summary": "<xdoc><p>Converts a file of binary floating-point values representing raster data to a raster dataset.</p><note type=\"legacy\"/><p group=\"note\">This is a deprecated tool. The Copy Raster tool can now be used to convert a float file representing raster data to a raster dataset.</p></xdoc>",
        "title": "Float to Raster"
    }
}
