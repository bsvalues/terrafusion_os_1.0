{
    "map": {
        "custom_json_file.descr": "The import configuration, in JSON format, that will be used to create the custom OIS.",
        "custom_json_file.title": "Custom JSON File",
        "description": "Creates curved approach obstacle identification surfaces (OIS) based on the supported specifications in ArcGIS Aviation. These curved approach surfaces are based on an input flight path and the information in the selected specification, for example, ICAO Annex 15, FAA 18B and classification. This tool creates surfaces in existing polygon or multipatch features.",
        "in_flightpath_features.descr": "The polyline features that define curved approaches to the specified runways, terminating at the runway centerline endpoint.",
        "in_flightpath_features.title": "Input Flight Path Features",
        "in_runway_features.descr": "The input runway dataset. The feature class must be z-enabled and contain polylines.",
        "in_runway_features.title": "Input Runway Features",
        "out_ois_features.title": "Output OIS Features",
        "runway_classification.descr": "<xdoc><p>The runway classification of the approach surface.</p><p>The <span class=\"esri_uicontrol\">Specification</span> parameter value will determine the available options for this parameter.</p></xdoc>",
        "runway_classification.title": "Runway Classification",
        "specification.descr": "<xdoc><p>Specifies the approach surface specification.</p><ul><li><span title=\"ETOD\">ICAO Annex 15</span>—The approach surface specification is ICAO Annex 15 (ETOD).</li><li><span title=\"OLS\">ICAO Annex 14</span>—The approach surface specification is ICAO Annex 14 (OLS).</li><li><span title=\"FAR77\">FAA regulations part 77</span>—The approach surface specification is FAA regulations part 77 (FAR77).</li><li><span title=\"18B\">FAA Advisory circular 150/5300_18B</span>—The approach surface specification is FAA Advisory circular 150/5300_18B (18B).</li><li><span title=\"13SURFACES\">FAA Advisory circular 150/5300_13</span>—The approach surface specification is FAA Advisory circular 150/5300_13.</li></ul></xdoc>",
        "specification.domain.13SURFACES": "FAA Advisory circular 150/5300_13",
        "specification.domain.18B": "FAA Advisory circular 150/5300_18B",
        "specification.domain.ETOD": "ICAO Annex 15",
        "specification.domain.FAR77": "FAA regulations part 77",
        "specification.domain.OLS": "ICAO Annex 14",
        "specification.title": "Specification",
        "target_ois_features.descr": "The target feature class that will contain the generated OIS.",
        "target_ois_features.title": "Target OIS Features",
        "threshold_offset.descr": "A positive distance value that will be used to offset the generated approach surface outward from the runway end. The offset will be applied in the units of the input.",
        "threshold_offset.title": "Threshold Offset",
        "title": "Create Curved Approach"
    }
