{
    "type": "FunctionTool",
    "guid": "{ef165d0a-963c-4b5e-989d-d2e1a45f44a7}",
    "displayname": "$rc:title",
    "helpcontent": "22010005",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_map": {
            "display_order": "1",
            "displayname": "$rc:in_map.title",
            "datatype": {
                "type": "GPMap"
            },
            "description": "$rc:in_map.descr"
        },
        "tile_origin": {
            "display_order": "5",
            "displayname": "$rc:tile_origin.title",
            "datatype": {
                "type": "GPPoint"
            },
            "value": "0 0",
            "description": "$rc:tile_origin.descr"
        },
        "output_tiling_scheme": {
            "direction": "out",
            "display_order": "4",
            "displayname": "$rc:output_tiling_scheme.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xml"
                ]
            },
            "description": "$rc:output_tiling_scheme.descr"
        },
        "num_of_scales": {
            "display_order": "6",
            "displayname": "$rc:num_of_scales.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "0",
            "description": "$rc:num_of_scales.descr"
        },
        "scales": {
            "display_order": "7",
            "displayname": "$rc:scales.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPDouble",
                        "displayname": "$rc:scales.dt.title1"
                    }
                ]
            },
            "description": "$rc:scales.descr"
        },
        "dots_per_inch": {
            "display_order": "8",
            "displayname": "$rc:dots_per_inch.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "96",
            "description": "$rc:dots_per_inch.descr"
        },
        "tile_size": {
            "display_order": "9",
            "displayname": "$rc:tile_size.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "128 x 128",
                        "code": "$rc:tile_size.domain.128 x 128"
                    },
                    {
                        "value": "256 x 256",
                        "code": "$rc:tile_size.domain.256 x 256"
                    },
                    {
                        "value": "512 x 512",
                        "code": "$rc:tile_size.domain.512 x 512"
                    },
                    {
                        "value": "1024 x 1024",
                        "code": "$rc:tile_size.domain.1024 x 1024"
                    }
                ]
            },
            "value": "256 x 256",
            "description": "$rc:tile_size.descr"
        },
        "ready_to_serve_format": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:ready_to_serve_format.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "READY_TO_SERVE_FORMAT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NON_READY_TO_SERVE_FORMAT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:ready_to_serve_format.descr"
        },
        "output_folder": {
            "type": "optional",
            "display_order": "3",
            "control_guid": "{C49F778E-E3D8-4718-BE07-70A90AF336FE}",
            "displayname": "$rc:output_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:output_folder.descr"
        }
    },
    "environments": [
        "workspace"
    ]
}
