{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3380002",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "param_nocount:target_catalog_dataset"
    ],
    "params": {
        "target_catalog_dataset": {
            "display_order": "0",
            "displayname": "$rc:target_catalog_dataset.title",
            "datatype": {
                "type": "GPCatalogLayer"
            },
            "description": "$rc:target_catalog_dataset.descr"
        },
        "input_items": {
            "display_order": "1",
            "displayname": "$rc:input_items.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPComposite",
                    "datatypes": [
                        {
                            "type": "DEWorkspace"
                        },
                        {
                            "type": "GPFeatureLayer"
                        },
                        {
                            "type": "DEImageServer"
                        },
                        {
                            "type": "GPRasterLayer"
                        },
                        {
                            "type": "GPMosaicLayer"
                        },
                        {
                            "type": "GPLasDatasetLayer"
                        },
                        {
                            "type": "DELayer"
                        },
                        {
                            "type": "DECadDrawingDataset"
                        },
                        {
                            "type": "DEServerConnection"
                        },
                        {
                            "type": "DEBimFileWorkspace"
                        },
                        {
                            "type": "GPTinLayer"
                        }
                    ]
                }
            },
            "description": "$rc:input_items.descr"
        },
        "input_item_types": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:input_item_types.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "BIM_FILE_WORKSPACE",
                        "code": "$rc:input_item_types.domain.BIM_FILE_WORKSPACE"
                    },
                    {
                        "value": "BIM_FILE_FLOORPLAN",
                        "code": "$rc:input_item_types.domain.BIM_FILE_FLOORPLAN"
                    },
                    {
                        "value": "CAD_DRAWING",
                        "code": "$rc:input_item_types.domain.CAD_DRAWING"
                    },
                    {
                        "value": "FEATURE_SERVICE",
                        "code": "$rc:input_item_types.domain.FEATURE_SERVICE"
                    },
                    {
                        "value": "FEATURE_CLASS",
                        "code": "$rc:input_item_types.domain.FEATURE_CLASS"
                    },
                    {
                        "value": "IMAGE_SERVICE",
                        "code": "$rc:input_item_types.domain.IMAGE_SERVICE"
                    },
                    {
                        "value": "LAS_DATASET",
                        "code": "$rc:input_item_types.domain.LAS_DATASET"
                    },
                    {
                        "value": "LAS_FILE",
                        "code": "$rc:input_item_types.domain.LAS_FILE"
                    },
                    {
                        "value": "LAYER_FILE",
                        "code": "$rc:input_item_types.domain.LAYER_FILE"
                    },
                    {
                        "value": "MOSAIC_DATASET",
                        "code": "$rc:input_item_types.domain.MOSAIC_DATASET"
                    },
                    {
                        "value": "MAP_SERVICE",
                        "code": "$rc:input_item_types.domain.MAP_SERVICE"
                    },
                    {
                        "value": "RASTER_DATASET",
                        "code": "$rc:input_item_types.domain.RASTER_DATASET"
                    },
                    {
                        "value": "SCENE_LAYER_PACKAGE",
                        "code": "$rc:input_item_types.domain.SCENE_LAYER_PACKAGE"
                    },
                    {
                        "value": "TIN",
                        "code": "$rc:input_item_types.domain.TIN"
                    }
                ]
            },
            "description": "$rc:input_item_types.descr"
        },
        "include_subfolders": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:include_subfolders.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "INCLUDE_SUBFOLDERS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NOT_INCLUDE_SUBFOLDERS"
                    }
                ]
            },
            "description": "$rc:include_subfolders.descr"
        },
        "footprint_type": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:footprint_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ENVELOPE",
                        "code": "$rc:footprint_type.domain.ENVELOPE"
                    },
                    {
                        "value": "CONVEX_HULL",
                        "code": "$rc:footprint_type.domain.CONVEX_HULL"
                    }
                ]
            },
            "description": "$rc:footprint_type.descr"
        },
        "out_catalog_dataset": {
            "type": "derived",
            "direction": "out",
            "display_order": "5",
            "displayname": "$rc:out_catalog_dataset.title",
            "datatype": {
                "type": "GPCatalogLayer"
            },
            "depends": [
                "target_catalog_dataset"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "extent",
        "geographicTransformations"
    ]
}
