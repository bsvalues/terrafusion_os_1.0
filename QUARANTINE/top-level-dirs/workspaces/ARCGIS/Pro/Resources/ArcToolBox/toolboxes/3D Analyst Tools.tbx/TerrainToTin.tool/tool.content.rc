{
    "map": {
        "clip_to_extent.descr": "<xdoc><p>Specifies whether the resulting TIN will be clipped against the analysis extent. This only has an effect if the analysis extent is defined and it&apos;s smaller than the extent of the input terrain.</p><ul><li>Checked—Clips the output TIN against the analysis extent. This is the default.</li><li>Unchecked—Does not clip the output TIN against the analysis extent.</li></ul></xdoc>",
        "clip_to_extent.title": "Clip to Extent",
        "description": "Converts a terrain dataset to a triangulated irregular network (TIN) dataset.",
        "in_terrain.descr": "The terrain dataset that will be processed.",
        "in_terrain.title": "Input Terrain",
        "max_nodes.descr": "The maximum number of nodes permitted in the output TIN. The tool will return an error if the analysis extent and pyramid level would produce a TIN that exceeds this size. The default is 5 million.",
        "max_nodes.title": "Maximum Number of Nodes",
        "out_tin.descr": "The TIN dataset that will be generated.",
        "out_tin.title": "Output TIN",
        "pyramid_level_resolution.descr": "The z-tolerance or window-size resolution of the terrain pyramid level that will be used. The default is 0, or full resolution.",
        "pyramid_level_resolution.title": "Pyramid Level Resolution",
        "title": "Terrain To TIN"
    }
}
