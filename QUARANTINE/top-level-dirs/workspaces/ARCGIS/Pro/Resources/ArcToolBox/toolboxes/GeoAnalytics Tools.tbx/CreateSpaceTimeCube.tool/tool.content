{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "51010002",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "spark"
    ],
    "params": {
        "point_layer": {
            "displayname": "$rc:point_layer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "featuretype": [
                    "Simple"
                ],
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:point_layer.descr"
        },
        "output_name": {
            "displayname": "$rc:output_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:output_name.descr"
        },
        "distance_interval": {
            "displayname": "$rc:distance_interval.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:distance_interval.descr"
        },
        "time_step_interval": {
            "displayname": "$rc:time_step_interval.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_step_interval.descr"
        },
        "time_step_interval_alignment": {
            "type": "optional",
            "displayname": "$rc:time_step_interval_alignment.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "END_TIME",
                        "code": "$rc:time_step_interval_alignment.domain.END_TIME"
                    },
                    {
                        "value": "START_TIME",
                        "code": "$rc:time_step_interval_alignment.domain.START_TIME"
                    },
                    {
                        "value": "REFERENCE_TIME",
                        "code": "$rc:time_step_interval_alignment.domain.REFERENCE_TIME"
                    }
                ]
            },
            "description": "$rc:time_step_interval_alignment.descr"
        },
        "reference_time": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:reference_time.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:reference_time.descr"
        },
        "summary_fields": {
            "type": "optional",
            "displayname": "$rc:summary_fields.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:summary_fields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:summary_fields.dt.title2"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:summary_fields.dt.title3"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "SUM",
                                "code": "$rc:summary_fields.domain.item2.SUM"
                            },
                            {
                                "value": "MEAN",
                                "code": "$rc:summary_fields.domain.item2.MEAN"
                            },
                            {
                                "value": "MIN",
                                "code": "$rc:summary_fields.domain.item2.MIN"
                            },
                            {
                                "value": "MAX",
                                "code": "$rc:summary_fields.domain.item2.MAX"
                            },
                            {
                                "value": "STDDEV",
                                "code": "$rc:summary_fields.domain.item2.STDDEV"
                            }
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "ZEROS",
                                "code": "$rc:summary_fields.domain.item3.ZEROS"
                            },
                            {
                                "value": "SPATIAL_NEIGHBORS",
                                "code": "$rc:summary_fields.domain.item3.SPATIAL_NEIGHBORS"
                            },
                            {
                                "value": "SPACE_TIME_NEIGHBORS",
                                "code": "$rc:summary_fields.domain.item3.SPACE_TIME_NEIGHBORS"
                            },
                            {
                                "value": "TEMPORAL_TREND",
                                "code": "$rc:summary_fields.domain.item3.TEMPORAL_TREND"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "Point_Layer"
            ],
            "description": "$rc:summary_fields.descr"
        },
        "output": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "DEFile"
            }
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
