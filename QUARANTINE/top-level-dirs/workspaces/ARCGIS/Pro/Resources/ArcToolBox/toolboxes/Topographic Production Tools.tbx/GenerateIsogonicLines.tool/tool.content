{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "76100002",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "extent_features": {
            "displayname": "$rc:extent_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:extent_features.descr"
        },
        "altitude": {
            "displayname": "$rc:altitude.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "value": "0 Meters",
            "description": "$rc:altitude.descr"
        },
        "date": {
            "displayname": "$rc:date.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:date.descr"
        },
        "interval": {
            "displayname": "$rc:interval.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "1",
            "description": "$rc:interval.descr"
        },
        "base": {
            "displayname": "$rc:base.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0",
            "description": "$rc:base.descr"
        },
        "target_isogonic_features": {
            "displayname": "$rc:target_isogonic_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:target_isogonic_features.descr"
        },
        "magnetic_field": {
            "displayname": "$rc:magnetic_field.title",
            "datatype": {
                "type": "Field"
            },
            "depends": [
                "target_isogonic_features"
            ],
            "description": "$rc:magnetic_field.descr"
        },
        "subtype": {
            "type": "optional",
            "displayname": "$rc:subtype.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:subtype.descr"
        },
        "annual_drift": {
            "type": "optional",
            "displayname": "$rc:annual_drift.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ANNUAL_DRIFT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_ANNUAL_DRIFT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:annual_drift.descr"
        },
        "annual_drift_field": {
            "type": "optional",
            "displayname": "$rc:annual_drift_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Double",
                    "Float",
                    "Text"
                ]
            },
            "depends": [
                "target_isogonic_features"
            ],
            "description": "$rc:annual_drift_field.descr"
        },
        "modified_target_isogonic_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:modified_target_isogonic_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "target_isogonic_features"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    }
}
