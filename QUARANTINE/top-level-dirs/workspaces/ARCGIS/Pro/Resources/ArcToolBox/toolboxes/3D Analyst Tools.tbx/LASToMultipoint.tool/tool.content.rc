{
    "map": {
        "attribute.descr": "<xdoc><p>The LAS point properties whose values will be stored in binary large object (BLOB) fields in the attribute table of the output. If the resulting features will participate in a terrain dataset, the stored attributes can be used to symbolize the terrain. The <span class=\"esri_uicontrol\">Name</span> column indicates the name of the field that will be used to store the specified attributes. The following LAS properties are supported:</p><ul><li><span title=\"INTENSITY\">INTENSITY</span>—Intensity</li><li><span title=\"RETURN_NUMBER\">RETURN_NUMBER</span>—Return number</li><li><span title=\"NUMBER_OF_RETURNS\">NUMBER_OF_RETURNS</span>—Number of returns per pulse</li><li><span title=\"SCAN_DIRECTION_FLAG\">SCAN_DIRECTION_FLAG</span>—Scan direction flag</li><li><span title=\"EDGE_OF_FLIGHTLINE\">EDGE_OF_FLIGHTLINE</span>—Edge of flightline</li><li><span title=\"CLASSIFICATION\">CLASSIFICATION</span>—Classification</li><li><span title=\"SCAN_ANGLE_RANK\">SCAN_ANGLE_RANK</span>—Scan angle rank</li><li><span title=\"FILE_MARKER\">FILE_MARKER</span>—File marker</li><li><span title=\"USER_BIT_FIELD\">USER_BIT_FIELD</span>—User data value</li><li><span title=\"GPS_TIME\">GPS_TIME</span>—GPS time</li><li><span title=\"COLOR_RED\">COLOR_RED</span>—Red band</li><li><span title=\"COLOR_GREEN\">COLOR_GREEN</span>—Green band</li><li><span title=\"COLOR_BLUE\">COLOR_BLUE</span>—Blue band</li></ul></xdoc>",
        "attribute.domain.item1.CLASSIFICATION": "Classification",
        "attribute.domain.item1.COLOR_BLUE": "Blue band",
        "attribute.domain.item1.COLOR_GREEN": "Green band",
        "attribute.domain.item1.COLOR_RED": "Red band",
        "attribute.domain.item1.EDGE_OF_FLIGHTLINE": "Edge of flightline",
        "attribute.domain.item1.FILE_MARKER": "File marker",
        "attribute.domain.item1.GPS_TIME": "GPS time",
        "attribute.domain.item1.INTENSITY": "Intensity",
        "attribute.domain.item1.NUMBER_OF_RETURNS": "Number of returns per pulse",
        "attribute.domain.item1.RETURN_NUMBER": "Return number",
        "attribute.domain.item1.SCAN_ANGLE_RANK": "Scan angle rank",
        "attribute.domain.item1.SCAN_DIRECTION_FLAG": "Scan direction flag",
        "attribute.domain.item1.USER_BIT_FIELD": "User data value",
        "attribute.dt.title1": "Keyword",
        "attribute.dt.title2": "Name",
        "attribute.title": "Input Attribute Names",
        "average_point_spacing.descr": "The average 2D distance between points in the input file or files. This can be an approximation. If areas have been sampled at different densities, specify the smaller spacing. The value needs to be provided in the projection units of the output coordinate system.",
        "average_point_spacing.title": "Average Point Spacing",
        "class_code.descr": "The classification codes that will be used as a query filter for LAS data points. Valid values range from 0 to 255. No filter is applied by default.",
        "class_code.title": "Class Codes",
        "description": "Creates multipoint features using one or more lidar files.",
        "file_suffix.descr": "The suffix of the files that will be imported from an input folder. This parameter is required when a folder is specified as input.",
        "file_suffix.title": "File Suffix",
        "folder_recursion.descr": "<xdoc><p>Scans through subfolders when an input folder is selected containing data in a subfolders directory. The output feature class will be generated with a row for each file encountered in the directory structure.</p><ul><li>Unchecked—Only LAS files found in an input folder will be converted to multipoint features. This is the default.</li><li>Checked—All LAS files residing in the subdirectories of an input folder will be converted to multipoint features.</li></ul></xdoc>",
        "folder_recursion.title": "Include Subfolders",
        "input.descr": "<xdoc><p>The LAS or ZLAS files that will be imported to a multipoint feature class. If a folder is specified, all the LAS files that reside therein will be imported.</p><p>In the <span class=\"esri_uicontrol\">Geoprocessing</span> pane, a folder can also be specified as an input by selecting the folder in File Explorer and dragging it onto the parameter&apos;s input box.</p></xdoc>",
        "input.title": "Input",
        "input_coordinate_system.descr": "The coordinate system of the input LAS file.",
        "input_coordinate_system.title": "Coordinate System",
        "out_feature_class.descr": "The feature class that will be produced.",
        "out_feature_class.title": "Output Feature Class",
        "return.descr": "<xdoc><p>The return values that will be used to filter the LAS points that get imported to multipoint features.</p><ul><li><span title=\"ANY_RETURNS\">All Returns</span>—Any returns</li><li><span title=\"1\">1st Return</span>—1</li><li><span title=\"2\">2nd Return</span>—2</li><li><span title=\"3\">3rd Return</span>—3</li><li><span title=\"4\">4th Return</span>—4</li><li><span title=\"5\">5th Return</span>—5</li><li><span title=\"6\">6th Return</span>—6</li><li><span title=\"7\">7th Return</span>—7</li><li><span title=\"8\">8th Return</span>—8</li><li><span title=\"LAST_RETURNS\">Last Return</span>—Last returns</li></ul></xdoc>",
        "return.domain.1": "1st Return",
        "return.domain.2": "2nd Return",
        "return.domain.3": "3rd Return",
        "return.domain.4": "4th Return",
        "return.domain.5": "5th Return",
        "return.domain.6": "6th Return",
        "return.domain.7": "7th Return",
        "return.domain.8": "8th Return",
        "return.domain.ANY_RETURNS": "All Returns",
        "return.domain.LAST_RETURNS": "Last Return",
        "return.title": "Return Values",
        "title": "LAS To Multipoint",
        "z_factor.descr": "The factor by which z-values will be multiplied. This is typically used to convert z linear units to match x,y linear units. The default is 1, which leaves elevation values unchanged. This parameter is not available if the spatial reference of the input surface has a z-datum with a specified linear unit.",
        "z_factor.title": "Z Factor"
    }
