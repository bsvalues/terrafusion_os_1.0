{
    "map": {
        "dataset_name.descr": "<xdoc><p>The name of the output Indoor Positioning Dataset.</p><p>The output dataset name must be unique in the <span class=\"esri_fieldname\">Dataset Name</span> field of the Target IPS Positioning feature class.</p></xdoc>",
        "dataset_name.title": "Output Dataset Name",
        "description": "Generates an Indoor Positioning Dataset for an existing ArcGIS IPS installation. You can use a survey-based or survey-less method to generate the dataset.",
        "existing_dataset.descr": "<xdoc><p>The name of an existing dataset contained in the Target IPS Positioning Datasets. The parameter value must be the name of an existing Indoor Positioning Dataset contained in the Target IPS Positioning Datasets. The data contained in this dataset will be used in conjunction with the tool inputs to generate an updated version of the existing dataset. This parameter is only used in combination with the <span class=\"esri_uicontrol\">Update Existing Dataset</span> parameter.</p></xdoc>",
        "existing_dataset.title": "Existing Dataset",
        "generation_method.descr": "<xdoc><p>Specifies the method that will be used to generate the Indoor Positioning Dataset.</p><ul><li><span title=\"SURVEY_BASED\">Survey-Based</span>—The dataset will be generated by processing IPS Recordings.</li><li><span title=\"SURVEY_LESS\">Survey-Less</span>—The dataset will be generated by simulating the Bluetooth signal propagation through the indoor environment.</li></ul></xdoc>",
        "generation_method.domain.SURVEY_BASED": "Survey-Based",
        "generation_method.domain.SURVEY_LESS": "Survey-Less",
        "generation_method.title": "Generation Method",
        "in_beacons.descr": "<xdoc><p>The point features representing the position and settings of Bluetooth beacons deployed in the indoor environment.</p><p>This parameter is required when the <span class=\"esri_uicontrol\">Generation Method</span> parameter is set to <span class=\"esri_uicontrol\">Survey-Less</span>.</p></xdoc>",
        "in_beacons.title": "IPS Beacon Features",
        "in_ips_areas.descr": "<xdoc><p>The polygon features representing the area where the Indoor Positioning Dataset will be generated.</p><p>This parameter is required when the <span class=\"esri_uicontrol\">Generation Method</span> parameter is set to <span class=\"esri_uicontrol\">Survey-Less</span>.</p></xdoc>",
        "in_ips_areas.title": "IPS Area Features",
        "in_ips_recordings.descr": "<xdoc><p>The feature class or feature service that contains IPS Setup survey recordings.</p><p>This parameter is required when the <span class=\"esri_uicontrol\">Generation Method</span> parameter is set to <span class=\"esri_uicontrol\">Survey-Based</span>.</p></xdoc>",
        "in_ips_recordings.title": "IPS Recordings Features",
        "in_levels.descr": "The polygon features representing Level footprints within the facilities.",
        "in_levels.title": "Level Features",
        "in_walls.descr": "<xdoc><p>The polygon features representing the physical extent of walls.</p><p>This parameter is required when the <span class=\"esri_uicontrol\">Generation Method</span> parameter is set to <span class=\"esri_uicontrol\">Survey-Less</span>.</p></xdoc>",
        "in_walls.title": "Wall Features",
        "out_ips_datasets.title": "Updated IPS Positioning Datasets",
        "summary": "<xdoc><p>Generates an Indoor Positioning Dataset for an existing ArcGIS IPS installation. You can use a survey-based or survey-less method to generate the dataset.</p><p>This tool updates the IPS Positioning Datasets feature class, IPS Positioning Signals table, and IPS Positioning Points feature class in the ArcGIS IPS Information Model.</p></xdoc>",
        "target_ips_positioning_datasets.descr": "The feature class where the generated Indoor Positioning Dataset will be stored.",
        "target_ips_positioning_datasets.title": "Target IPS Positioning Datasets",
        "title": "Generate Indoor Positioning Dataset",
        "update_existing.descr": "<xdoc><p>Specifies whether an Indoor Positioning Dataset will be created by combining an existing dataset and the tool inputs. This parameter is only valid if the <span class=\"esri_uicontrol\">Generation Method</span> parameter is set to <span class=\"esri_uicontrol\">Survey-Based</span>.<ul><li>Checked—An Indoor Positioning Dataset will be created using the existing dataset and the tool inputs.</li><li>Unchecked—A new Indoor Positioning Dataset will be created. This is the default.</li></ul></p></xdoc>",
        "update_existing.title": "Update Existing Dataset"
    }
}
