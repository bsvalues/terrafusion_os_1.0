{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\GeneralizedLinearRegression",
    "displayname": "$rc:title",
    "helpcontent": "9060008",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "dependent_variable": {
            "display_order": "1",
            "displayname": "$rc:dependent_variable.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:dependent_variable.descr"
        },
        "model_type": {
            "display_order": "2",
            "displayname": "$rc:model_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "CONTINUOUS",
                        "code": "$rc:model_type.domain.CONTINUOUS"
                    },
                    {
                        "value": "BINARY",
                        "code": "$rc:model_type.domain.BINARY"
                    },
                    {
                        "value": "COUNT",
                        "code": "$rc:model_type.domain.COUNT"
                    }
                ]
            },
            "value": "CONTINUOUS",
            "description": "$rc:model_type.descr"
        },
        "output_features": {
            "direction": "out",
            "display_order": "5",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "explanatory_variables": {
            "type": "optional",
            "display_order": "3",
            "control_guid": "{C15EC6FA-35EF-4204-90FB-01E7B4DD6862}",
            "displayname": "$rc:explanatory_variables.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
