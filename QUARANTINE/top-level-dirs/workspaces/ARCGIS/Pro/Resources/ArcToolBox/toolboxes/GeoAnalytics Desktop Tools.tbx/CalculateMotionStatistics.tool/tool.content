{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "69000032",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "spark"
    ],
    "params": {
        "input_layer": {
            "displayname": "$rc:input_layer.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_layer.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "input_layer"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "track_fields": {
            "displayname": "$rc:track_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Float",
                    "Double",
                    "Text"
                ]
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:track_fields.descr"
        },
        "track_history_window": {
            "displayname": "$rc:track_history_window.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:track_history_window.descr"
        },
        "motion_statistics": {
            "type": "optional",
            "control_guid": "{38C34610-C7F7-11D5-A693-0008C711C8C1}",
            "displayname": "$rc:motion_statistics.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DISTANCE",
                        "code": "$rc:motion_statistics.domain.DISTANCE"
                    },
                    {
                        "value": "DURATION",
                        "code": "$rc:motion_statistics.domain.DURATION"
                    },
                    {
                        "value": "SPEED",
                        "code": "$rc:motion_statistics.domain.SPEED"
                    },
                    {
                        "value": "ACCELERATION",
                        "code": "$rc:motion_statistics.domain.ACCELERATION"
                    },
                    {
                        "value": "ELEVATION",
                        "code": "$rc:motion_statistics.domain.ELEVATION"
                    },
                    {
                        "value": "SLOPE",
                        "code": "$rc:motion_statistics.domain.SLOPE"
                    },
                    {
                        "value": "BEARING",
                        "code": "$rc:motion_statistics.domain.BEARING"
                    },
                    {
                        "value": "IDLE",
                        "code": "$rc:motion_statistics.domain.IDLE"
                    }
                ]
            },
            "description": "$rc:motion_statistics.descr"
        },
        "distance_method": {
            "type": "optional",
            "displayname": "$rc:distance_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PLANAR",
                        "code": "$rc:distance_method.domain.PLANAR"
                    },
                    {
                        "value": "GEODESIC",
                        "code": "$rc:distance_method.domain.GEODESIC"
                    }
                ]
            },
            "description": "$rc:distance_method.descr"
        },
        "idle_dist_tolerance": {
            "type": "optional",
            "displayname": "$rc:idle_dist_tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:idle_dist_tolerance.descr"
        },
        "idle_time_tolerance": {
            "type": "optional",
            "displayname": "$rc:idle_time_tolerance.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:idle_time_tolerance.descr"
        },
        "time_boundary_split": {
            "type": "optional",
            "displayname": "$rc:time_boundary_split.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_boundary_split.descr"
        },
        "time_boundary_reference": {
            "type": "optional",
            "displayname": "$rc:time_boundary_reference.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_boundary_reference.descr"
        },
        "distance_unit": {
            "type": "optional",
            "displayname": "$rc:distance_unit.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FEET",
                        "code": "$rc:distance_unit.domain.FEET"
                    },
                    {
                        "value": "YARDS",
                        "code": "$rc:distance_unit.domain.YARDS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:distance_unit.domain.MILES"
                    },
                    {
                        "value": "NAUTICAL_MILES",
                        "code": "$rc:distance_unit.domain.NAUTICAL_MILES"
                    },
                    {
                        "value": "METERS",
                        "code": "$rc:distance_unit.domain.METERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:distance_unit.domain.KILOMETERS"
                    },
                    {
                        "value": "FEET_INT",
                        "code": "$rc:distance_unit.domain.FEET_INT"
                    },
                    {
                        "value": "YARDS_INT",
                        "code": "$rc:distance_unit.domain.YARDS_INT"
                    },
                    {
                        "value": "MILES_INT",
                        "code": "$rc:distance_unit.domain.MILES_INT"
                    },
                    {
                        "value": "NAUTICAL_MILES_INT",
                        "code": "$rc:distance_unit.domain.NAUTICAL_MILES_INT"
                    }
                ]
            },
            "description": "$rc:distance_unit.descr"
        },
        "duration_unit": {
            "type": "optional",
            "displayname": "$rc:duration_unit.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "YEARS",
                        "code": "$rc:duration_unit.domain.YEARS"
                    },
                    {
                        "value": "MONTHS",
                        "code": "$rc:duration_unit.domain.MONTHS"
                    },
                    {
                        "value": "WEEKS",
                        "code": "$rc:duration_unit.domain.WEEKS"
                    },
                    {
                        "value": "DAYS",
                        "code": "$rc:duration_unit.domain.DAYS"
                    },
                    {
                        "value": "HOURS",
                        "code": "$rc:duration_unit.domain.HOURS"
                    },
                    {
                        "value": "MINUTES",
                        "code": "$rc:duration_unit.domain.MINUTES"
                    },
                    {
                        "value": "SECONDS",
                        "code": "$rc:duration_unit.domain.SECONDS"
                    },
                    {
                        "value": "MILLISECONDS",
                        "code": "$rc:duration_unit.domain.MILLISECONDS"
                    }
                ]
            },
            "description": "$rc:duration_unit.descr"
        },
        "speed_unit": {
            "type": "optional",
            "displayname": "$rc:speed_unit.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "METERS_PER_SECOND",
                        "code": "$rc:speed_unit.domain.METERS_PER_SECOND"
                    },
                    {
                        "value": "MILES_PER_HOUR",
                        "code": "$rc:speed_unit.domain.MILES_PER_HOUR"
                    },
                    {
                        "value": "KILOMETERS_PER_HOUR",
                        "code": "$rc:speed_unit.domain.KILOMETERS_PER_HOUR"
                    },
                    {
                        "value": "FEET_PER_SECOND",
                        "code": "$rc:speed_unit.domain.FEET_PER_SECOND"
                    },
                    {
                        "value": "NAUTICAL_MILES_PER_HOUR",
                        "code": "$rc:speed_unit.domain.NAUTICAL_MILES_PER_HOUR"
                    }
                ]
            },
            "description": "$rc:speed_unit.descr"
        },
        "acceleration_unit": {
            "type": "optional",
            "displayname": "$rc:acceleration_unit.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "METERS_PER_SECOND_SQUARED",
                        "code": "$rc:acceleration_unit.domain.METERS_PER_SECOND_SQUARED"
                    },
                    {
                        "value": "FEET_PER_SECOND_SQUARED",
                        "code": "$rc:acceleration_unit.domain.FEET_PER_SECOND_SQUARED"
                    }
                ]
            },
            "description": "$rc:acceleration_unit.descr"
        },
        "elevation_unit": {
            "type": "optional",
            "displayname": "$rc:elevation_unit.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FEET",
                        "code": "$rc:elevation_unit.domain.FEET"
                    },
                    {
                        "value": "YARDS",
                        "code": "$rc:elevation_unit.domain.YARDS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:elevation_unit.domain.MILES"
                    },
                    {
                        "value": "METERS",
                        "code": "$rc:elevation_unit.domain.METERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:elevation_unit.domain.KILOMETERS"
                    },
                    {
                        "value": "FEET_INT",
                        "code": "$rc:elevation_unit.domain.FEET_INT"
                    },
                    {
                        "value": "YARDS_INT",
                        "code": "$rc:elevation_unit.domain.YARDS_INT"
                    },
                    {
                        "value": "MILES_INT",
                        "code": "$rc:elevation_unit.domain.MILES_INT"
                    }
                ]
            },
            "description": "$rc:elevation_unit.descr"
