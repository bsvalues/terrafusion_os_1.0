{
    "map": {
        "algorithm.descr": "<xdoc><p>Specifies the algorithm that will be used to solve the territory solution.</p><ul><li><span title=\"CLASSIC\">Classic</span>— The original algorithm will be used to solve the territory solution. This is the default.</li><li><span title=\"GENETIC\">Genetic</span>— A newer and more modern algorithm based on a genetic growth algorithm will be used to solve the territory solution.</li></ul></xdoc>",
        "algorithm.domain.CLASSIC": "Classic",
        "algorithm.domain.GENETIC": "Genetic",
        "algorithm.title": "Algorithm",
        "candidate_solutions.descr": "<xdoc><p>The number of possible solutions. For larger datasets, increasing this number will increase the search space and the probability of finding a better solution. The default is 10 and must be greater than 1. This parameter is only used when the <span class=\"esri_uicontrol\">Algorithm</span> parameter is set to <span class=\"esri_uicontrol\">Genetic</span>.</p></xdoc>",
        "candidate_solutions.title": "Number of Candidate Solutions",
        "description": "Solves the territory solution based on specified criteria such as attribute constraints or distance constraints.",
        "in_territory_solution.descr": "The territory solution that will be used to solve territories.",
        "in_territory_solution.title": "Input Territory Solution",
        "iterations_limit.descr": "The number of times the territory search process will be repeated. For larger datasets, increasing the number is recommended to find an optimal solution. The default value is 50.",
        "iterations_limit.title": "Iterations Limit",
        "level.descr": "The level that will be used to solve territories.",
        "level.title": "Level",
        "method.descr": "<xdoc><p>Specifies the method that will be used when calculating the number of territories.</p><ul><li><span title=\"USER_DEFINED\">User Defined</span>—The number of territories will be defined by the <span class=\"esri_uicontrol\">Number of Territories</span> parameter value. This is the default.</li><li><span title=\"PREFERRED\">Preferred</span>—The number of territories will be defined by the <span class=\"esri_uicontrol\">Number of Territories</span> parameter value, but only territories that meet the criteria of the constraints will be created.</li><li><span title=\"OPTIMAL\">Optimal</span>—The number of territories will be calculated automatically.</li><li><span title=\"OPTIMAL_MAX_COVERAGE\">Optimal Max Coverage</span>— The number of territories will be calculated automatically using a maximum coverage of the base features.</li></ul></xdoc>",
        "method.domain.OPTIMAL": "Optimal",
        "method.domain.OPTIMAL_MAX_COVERAGE": "Optimal Max Coverage",
        "method.domain.PREFERRED": "Preferred",
        "method.domain.USER_DEFINED": "User Defined",
        "method.title": "Number of Territories Method",
        "number_territories.descr": "The number of territories to be specified.",
        "number_territories.title": "Number of Territories",
        "out_territory_solution.title": "Updated Territory Solution",
        "params.category1": "Advanced Options",
        "quality.descr": "An integer between 1 and 200 that determines the performance of a solve operation. A lower value will provide better performance but quality may be affected. The default value is 100.",
        "quality.title": "Quality (%)",
        "title": "Solve Territories"
    }
}
