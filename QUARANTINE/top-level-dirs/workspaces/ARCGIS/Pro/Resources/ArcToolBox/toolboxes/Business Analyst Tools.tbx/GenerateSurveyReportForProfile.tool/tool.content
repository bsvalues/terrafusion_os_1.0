{
    "type": "FunctionTool",
    "guid": "{33724566-2738-4FE2-903A-A8C439127E50}/GenerateSurveyReportForProfile",
    "displayname": "$rc:title",
    "helpcontent": "62070012",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "33",
        "35"
    ],
    "params": {
        "target_profile": {
            "displayname": "$rc:target_profile.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "sgprofile"
                ]
            },
            "description": "$rc:target_profile.descr"
        },
        "base_profile": {
            "displayname": "$rc:base_profile.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "sgprofile"
                ]
            },
            "description": "$rc:base_profile.descr"
        },
        "survey_category": {
            "displayname": "$rc:survey_category.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:survey_category.descr"
        },
        "report_folder": {
            "displayname": "$rc:report_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "category": "$rc:params.category1",
            "description": "$rc:report_folder.descr"
        },
        "sort_column": {
            "type": "optional",
            "displayname": "$rc:sort_column.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "EXPECTED_NUMBER",
                        "code": "$rc:sort_column.domain.EXPECTED_NUMBER"
                    },
                    {
                        "value": "INDEX",
                        "code": "$rc:sort_column.domain.INDEX"
                    }
                ]
            },
            "value": "EXPECTED_NUMBER",
            "description": "$rc:sort_column.descr"
        },
        "sort_order": {
            "type": "optional",
            "displayname": "$rc:sort_order.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ASCENDING",
                        "code": "$rc:sort_order.domain.ASCENDING"
                    },
                    {
                        "value": "DESCENDING",
                        "code": "$rc:sort_order.domain.DESCENDING"
                    }
                ]
            },
            "value": "DESCENDING",
            "description": "$rc:sort_order.descr"
        },
        "report_title": {
            "type": "optional",
            "displayname": "$rc:report_title.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:report_title.descr"
        },
        "report_format": {
            "type": "optional",
            "displayname": "$rc:report_format.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "description": "$rc:report_format.descr"
        },
        "output_report": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_report.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "DEFile"
                }
            }
        }
    },
    "environments": [
        "baDataSource",
        "workspace"
    ]
}
