        "out_feature_class.descr": "The output polygon feature class.",
        "out_feature_class.title": "Output Feature Class",
        "spatial_sort_method.descr": "<xdoc><p>Output features are created in a sequential order and require a spatial starting point. Setting the direction type to upper right will start the output features in the upper right of each input feature.</p><ul><li><span title=\"UR\">Upper right</span>—Features start in the upper right corner. This is the default.</li><li><span title=\"UL\">Upper left</span>—Features start in the upper left corner.</li><li><span title=\"LR\">Lower right</span>—Features starts in the lower right corner.</li><li><span title=\"LL\">Lower left</span>—Features starts in the lower left corner.</li></ul></xdoc>",
        "spatial_sort_method.domain.LL": "Lower left",
