{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "52010009",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "block_add_to_map"
    ],
    "params": {
        "in_parcel_fabric": {
            "displayname": "$rc:in_parcel_fabric.title",
            "datatype": {
                "type": "GPCadastralFabricLayer"
            },
            "description": "$rc:in_parcel_fabric.descr"
        },
        "target_dataset": {
            "displayname": "$rc:target_dataset.title",
            "datatype": {
                "type": "DEFeatureDataset"
            },
            "description": "$rc:target_dataset.descr"
        },
        "name": {
            "displayname": "$rc:name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:name.descr"
        },
        "out_parcel_fabric": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_parcel_fabric.title",
            "datatype": {
                "type": "DEParcelDataset"
            }
        },
        "delete_identical": {
            "type": "optional",
            "displayname": "$rc:delete_identical.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DELETE_IDENTICAL_LINES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "KEEP_IDENTICAL_LINES"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:delete_identical.descr"
        }
    }
}
