    ],
    "attributes": [
        "block_add_to_map"
    ],
    "params": {
        "input_cad_datasets": {
            "displayname": "$rc:input_cad_datasets.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "DECadDrawingDataset"
                }
            },
            "description": "$rc:input_cad_datasets.descr"
        },
        "out_gdb_path": {
            "displayname": "$rc:out_gdb_path.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:out_gdb_path.descr"
        },
        "out_dataset_name": {
            "displayname": "$rc:out_dataset_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_dataset_name.descr"
        },
        "reference_scale": {
            "displayname": "$rc:reference_scale.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:reference_scale.descr"
        },
        "spatial_reference": {
            "type": "optional",
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "depends": [
                "out_gdb_path"
            ],
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:spatial_reference.descr"
        },
        "out_dataset": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_dataset.title",
            "datatype": {
                "type": "DEFeatureDataset"
            }
        }
    },
    "environments": [
        "MResolution",
        "MTolerance",
        "XYDomain",
        "XYResolution",
        "XYTolerance",
        "ZResolution",
        "ZTolerance",
        "extent",
        "geographicTransformations",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "scratchWorkspace",
        "workspace"
    ]
