{
    "map": {
        "description": "Finds locations where moving objects have stopped, or dwelled, using given time and distance thresholds.",
        "distance_method.descr": "<xdoc><p>Specifies how the distances between dwell features will be calculated.</p><ul><li><span title=\"GEODESIC\">Geodesic</span>— If the spatial reference can be panned, tracks will cross the international date line when appropriate. If the spatial reference cannot be panned, tracks will be limited to the coordinate system extent and may not wrap.</li><li><span title=\"PLANAR\">Planar</span>—Planar distances will be used.</li></ul></xdoc>",
        "distance_method.domain.GEODESIC": "Geodesic",
        "distance_method.domain.PLANAR": "Planar",
        "distance_method.title": "Distance Method",
        "distance_tolerance.descr": "The maximum distance between points to be considered a single dwell location.",
        "distance_tolerance.title": "Distance Tolerance",
        "input_features.descr": "The point tracks in which dwells will be found. The input must be a time-enabled layer with features that represent instants in time.",
        "input_features.title": "Input Features",
        "output.descr": "The output feature class with the resulting dwells.",
        "output.title": "Output Dataset",
        "output_type.descr": "<xdoc><p>Specifies how the dwell features will be output.</p><ul><li><span title=\"DWELL_FEATURES\">Dwell features</span>— All of the input point features that are part of a dwell will be returned.</li><li><span title=\"DWELL_MEAN_CENTERS\">Mean centers</span>— Points representing the mean centers of each dwell group will be returned. This is the default.</li><li><span title=\"DWELL_CONVEX_HULLS\">Convex hulls</span>— Polygons representing the convex hull of each dwell group will be returned.</li><li><span title=\"ALL_FEATURES\">All features</span>— All of the input point features will be returned.</li></ul></xdoc>",
        "output_type.domain.ALL_FEATURES": "All features",
        "output_type.domain.DWELL_CONVEX_HULLS": "Convex hulls",
        "output_type.domain.DWELL_FEATURES": "Dwell features",
        "output_type.domain.DWELL_MEAN_CENTERS": "Mean centers",
        "output_type.title": "Output Type",
        "summary_statistics.descr": "<xdoc><p>The statistics that will be calculated on specified fields.</p><p><ul><li>Count—The number of nonnull values. It can be used on numeric fields or strings. The count of [null, 0, 2] is 2.</li><li>Sum—The sum of numeric values in a field. The sum of [null, null, 3] is 3.</li><li>Mean—The mean of numeric values. The mean of [0, 2, null] is 1.</li><li>Min—The minimum value of a numeric field. The minimum of [0, 2, null] is 0.</li><li>Max—The maximum value of a numeric field. The maximum value of [0, 2, null] is 2.</li><li>Standard Deviation—The standard deviation of a numeric field. The standard deviation of [1] is null. The standard deviation of [null, 1,1,1] is null.</li><li>Variance—The variance of a numeric field in a track. The variance of [1] is null. The variance of [null, 1, 1, 1] is null.</li><li>Range—The range of a numeric field. This is calculated as the minimum value subtracted from the maximum value. The range of [0, null, 1] is 1. The range of [null, 4] is 0.</li><li>Any—A sample string from a field of type string.</li><li>First—The first value of a specified field in a track.</li><li>Last—The last value of a specified field in a track.</li></ul></p></xdoc>",
        "summary_statistics.domain.item2.ANY": "Any",
        "summary_statistics.domain.item2.COUNT": "Count",
        "summary_statistics.domain.item2.FIRST": "First",
        "summary_statistics.domain.item2.LAST": "Last",
        "summary_statistics.domain.item2.MAX": "Maximum",
        "summary_statistics.domain.item2.MEAN": "Mean",
        "summary_statistics.domain.item2.MIN": "Minimum",
        "summary_statistics.domain.item2.RANGE": "Range",
        "summary_statistics.domain.item2.STDDEV": "Standard deviation",
        "summary_statistics.domain.item2.SUM": "Sum",
        "summary_statistics.domain.item2.VAR": "Variance",
        "summary_statistics.dt.title1": "Field",
        "summary_statistics.dt.title2": "Statistic",
        "summary_statistics.title": "Summary Statistics",
        "time_boundary_reference.descr": "The reference time used to split the input data into for analysis. Time boundaries will be created for the entire span of the data, and the reference time does not need to occur at the start. If no reference time is specified, January 1, 1970, is used.",
        "time_boundary_reference.title": "Time Boundary Reference",
        "time_boundary_split.descr": "A time span to split the input data into for analysis. A time boundary allows you to analyze values within a defined time span. For example, if you use a time boundary of 1 day, and set the time boundary reference to January 1, 1980, tracks will be split at the beginning of every day.",
        "time_boundary_split.title": "Time Boundary Split",
        "time_tolerance.descr": "<xdoc><p>The minimum time duration to be considered a single dwell location.</p><p>Both time and distance are considered when finding dwells. The <span class=\"esri_uicontrol\">Distance Tolerance</span> parameter specifies distance.</p></xdoc>",
        "time_tolerance.title": "Time Tolerance",
        "title": "Find Dwell Locations",
        "track_fields.descr": "One or more fields that will be used to identify unique tracks.",
        "track_fields.title": "Track Fields"
    }
}
