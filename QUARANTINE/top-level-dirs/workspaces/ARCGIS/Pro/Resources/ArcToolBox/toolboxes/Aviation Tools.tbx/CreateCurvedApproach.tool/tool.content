            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "json"
                ]
            },
            "description": "$rc:custom_json_file.descr"
        },
        "threshold_offset": {
            "type": "optional",
            "displayname": "$rc:threshold_offset.title",
