{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\BatchImportData",
    "displayname": "$rc:title",
    "helpcontent": "73040001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_data": {
            "displayname": "$rc:in_data.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPComposite",
                    "datatypes": [
                        {
                            "type": "DEFolder"
                        },
                        {
                            "type": "DEFile"
                        }
                    ]
                }
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:in_data.descr"
        },
        "target_gdb": {
            "displayname": "$rc:target_gdb.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:target_gdb.descr"
        },
        "filter": {
            "type": "optional",
            "displayname": "$rc:filter.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:filter.descr"
        },
        "include_sub_folders": {
            "type": "optional",
            "displayname": "$rc:include_sub_folders.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "SUBFOLDERS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_SUBFOLDERS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:include_sub_folders.descr"
        },
        "out_geodatabase": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_geodatabase.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "schema": {
                "type": "GPContainerSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "include_groundoverlay": {
            "type": "optional",
            "displayname": "$rc:include_groundoverlay.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "GROUNDOVERLAY"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_GROUNDOVERLAY"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:include_groundoverlay.descr"
        }
    }
}
