                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Remote Database",
                    "Local Database",
                    "Feature Service"
                ]
            },
            "description": "$rc:in_workspace.descr"
        },
        "evaluation_types": {
            "displayname": "$rc:evaluation_types.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "CALCULATION_RULES",
                        "code": "$rc:evaluation_types.domain.CALCULATION_RULES"
                    },
                    {
                        "value": "VALIDATION_RULES",
                        "code": "$rc:evaluation_types.domain.VALIDATION_RULES"
                    }
                ]
            },
            "description": "$rc:evaluation_types.descr"
        },
        "extent": {
            "type": "optional",
            "displayname": "$rc:extent.title",
            "datatype": {
                "type": "GPExtent"
            },
            "description": "$rc:extent.descr"
        },
        "run_async": {
            "type": "optional",
            "displayname": "$rc:run_async.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ASYNC"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "SYNC"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:run_async.descr"
        },
        "updated_workspace": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            }
        }
    }
