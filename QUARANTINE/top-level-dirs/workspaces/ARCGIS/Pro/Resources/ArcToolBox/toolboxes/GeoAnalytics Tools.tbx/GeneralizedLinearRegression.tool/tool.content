{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "51010006",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "spark"
    ],
    "params": {
        "input_features": {
            "display_order": "0",
            "displayname": "$rc:input_features.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "domain": {
                "type": "GPTablesDomain",
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:input_features.descr"
        },
        "dependent_variable": {
            "display_order": "1",
            "displayname": "$rc:dependent_variable.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text"
                ]
            },
            "depends": [
                "input_features"
            ],
            "description": "$rc:dependent_variable.descr"
        },
        "model_type": {
            "display_order": "2",
            "displayname": "$rc:model_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "BINARY",
                        "code": "$rc:model_type.domain.BINARY"
                    },
                    {
                        "value": "CONTINUOUS",
                        "code": "$rc:model_type.domain.CONTINUOUS"
                    },
                    {
                        "value": "COUNT",
                        "code": "$rc:model_type.domain.COUNT"
                    }
                ]
            },
            "value": "CONTINUOUS",
            "description": "$rc:model_type.descr"
        },
        "explanatory_variables": {
            "display_order": "3",
            "displayname": "$rc:explanatory_variables.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "input_features"
            ],
            "description": "$rc:explanatory_variables.descr"
        },
        "output_features_name": {
            "display_order": "4",
            "displayname": "$rc:output_features_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:output_features_name.descr"
        },
        "generate_coefficient_table": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:generate_coefficient_table.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE_TABLE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_TABLE"
                    }
                ]
            },
            "description": "$rc:generate_coefficient_table.descr"
        },
        "input_features_to_predict": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:input_features_to_predict.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPRecordSet"
            },
            "domain": {
                "type": "GPTablesDomain",
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:input_features_to_predict.descr"
        },
        "explanatory_variables_to_match": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:explanatory_variables_to_match.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:explanatory_variables_to_match.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:explanatory_variables_to_match.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain"
                    }
                ]
            },
            "depends": [
                "input_features_to_predict"
            ],
            "description": "$rc:explanatory_variables_to_match.descr"
        },
        "dependent_variable_mapping": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:dependent_variable_mapping.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPString",
                        "displayname": "$rc:dependent_variable_mapping.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:dependent_variable_mapping.dt.title2"
                    }
                ]
            },
            "description": "$rc:dependent_variable_mapping.descr"
        },
        "data_store": {
            "type": "optional",
            "displayname": "$rc:data_store.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "RELATIONAL_DATA_STORE",
                        "code": "$rc:data_store.domain.RELATIONAL_DATA_STORE"
                    },
                    {
                        "value": "SPATIOTEMPORAL_DATA_STORE",
                        "code": "$rc:data_store.domain.SPATIOTEMPORAL_DATA_STORE"
                    }
                ]
            },
            "value": "SPATIOTEMPORAL_DATA_STORE",
            "description": "$rc:data_store.descr"
        },
        "output": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "output_predicted_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_predicted_features.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "coefficient_table": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:coefficient_table.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
