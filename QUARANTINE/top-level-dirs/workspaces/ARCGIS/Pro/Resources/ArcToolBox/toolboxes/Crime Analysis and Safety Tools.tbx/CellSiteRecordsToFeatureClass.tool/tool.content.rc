{
    "map": {
        "azimuth_field.descr": "<xdoc><p>The field in the input table that contains the direction of the antenna signal (cell sector).</p><p>The azimuth field values must be expressed in positive degrees from 0 to 360, measured clockwise from north.</p></xdoc>",
        "azimuth_field.title": "Azimuth Field",
        "beamwidth_field.descr": "<xdoc><p>The field in the input table containing the full or half beamwidth value (angle) of the antenna signal (cell sector).</p><p>The beamwidth must be expressed in positive degrees from 0 to 360. Use 360 for omnidirectional antennas.</p></xdoc>",
        "beamwidth_field.title": "Beamwidth Field",
        "beamwidth_type.descr": "<xdoc><p>Specifies the type of beamwidth value represented in the input cell type table.</p><ul><li><span title=\"FULL_BEAMWIDTH\">Full Beamwidth</span>—Full beamwidth is represented in the input. This is the default.</li><li><span title=\"HALF_BEAMWIDTH\">Half Beamwidth</span>—Half beamwidth is represented in the input</li></ul></xdoc>",
        "beamwidth_type.domain.FULL_BEAMWIDTH": "Full Beamwidth",
        "beamwidth_type.domain.HALF_BEAMWIDTH": "Half Beamwidth",
        "beamwidth_type.title": "Beamwidth Type",
        "default_azimuth.descr": "<xdoc><p>The starting azimuth value of the antenna signals (cell sectors) that will be used when the azimuth field is not specified.</p><p>For example, three cell sectors exist at the same location and this parameter is set to 0 degrees. The first sector is generated with an azimuth of 0 degrees, the second sector is generated with an azimuth of 120 degrees, and the third sector is generated with an azimuth of 240 degrees.</p><p>This parameter is used when the azimuth field is not specified.</p><p>The azimuth value must be expressed in positive degrees from 0 to 360. The default is 0.</p></xdoc>",
        "default_azimuth.title": "Default Start Azimuth",
        "default_beamwidth.descr": "<xdoc><p>The beamwidth (in degrees) of the antenna signal (cell sector) that will be used when the beamwidth field is not specified.</p><p>The default is 90 degrees.</p></xdoc>",
        "default_beamwidth.title": "Default Beamwidth",
        "default_radius_length.descr": "<xdoc><p>The radius length (signal distance) of the antenna signal (cell sector) that will be used when the radial field is not specified.</p><p>The default is 2.</p></xdoc>",
        "default_radius_length.title": "Default Radius Length",
        "description": "Creates cell site points and sector polygons based on input latitude, longitude, azimuth, beamwidth, and radius information from a cell site table.",
        "id_fields.descr": "<xdoc><p>Specifies the unique ID field type and the fields that will be added to the output feature.</p><p>Use the <span class=\"esri_uicontrol\">Unique ID</span> value when the <span class=\"esri_uicontrol\">Input Cell Site Table</span> parameter has a unique identifier for all cell sector antennas. Use a combination of other <span class=\"esri_uicontrol\">ID Type</span> values when the <span class=\"esri_uicontrol\">Input Cell Site Table</span> parameter does not contain a universal unique identifier for all cell sector antennas.</p><ul><li>ID Type—The field name to be included in the output feature classes.</li><li>Field—The name of the fields that uniquely identify the cell sector antennas. These will be added to the output feature class.</li></ul><p><span class=\"esri_uicontrol\">ID Type</span> options are as follows:</p><ul><li>Unique ID—Uniquely identifies a cell sector antenna</li><li>Site ID—Uniquely identifies a cell site</li><li>Sector ID—Uniquely identifies a cell sector</li><li>Switch ID—Uniquely identifies a wireless network switch</li><li>LAC ID—Uniquely identifies the Location Area Code</li><li>Cascade ID—Uniquely identifies the sector in the wireless network cascade</li><li>Cell ID—Identifies the sector within an Location Area Code</li></ul></xdoc>",
        "id_fields.domain.item1.CASCADE_ID": "Cascade ID",
        "id_fields.domain.item1.CELL_ID": "Cell ID",
        "id_fields.domain.item1.LAC_ID": "LAC ID",
        "id_fields.domain.item1.SECTOR_ID": "Sector ID",
        "id_fields.domain.item1.SITE_ID": "Site ID",
        "id_fields.domain.item1.SWITCH_ID": "Switch ID",
        "id_fields.domain.item1.UNIQUE_ID": "Unique ID",
        "id_fields.dt.title1": "ID Type",
        "id_fields.dt.title2": "Field",
        "id_fields.title": "Cell Sector ID Fields",
        "in_coordinate_system.descr": "<xdoc><p>The coordinate system of the coordinates specified in the <span class=\"esri_uicontrol\">X Field</span> and <span class=\"esri_uicontrol\">Y Field</span> parameters.</p></xdoc>",
        "in_coordinate_system.title": "Input Coordinate System",
        "in_table.descr": "The input table containing cell site information provided by the wireless network provider.",
        "in_table.title": "Input Cell Site Table",
        "out_coordinate_system.descr": "The projected coordinate system of the output sites and sectors.",
        "out_coordinate_system.title": "Output Projected Coordinate System",
        "out_sector_feature_class.descr": "The feature class containing the output cell site sectors.",
        "out_sector_feature_class.title": "Output Cell Site Sectors",
        "out_site_feature_class.descr": "The feature class containing the output cell site points.",
        "out_site_feature_class.title": "Output Cell Site Points",
        "radius_field.descr": "The field in the input table that contains the radial length (signal distance) of the antenna signal (cell sector).",
        "radius_field.title": "Radius Field",
        "radius_unit.descr": "<xdoc><p>Specifies the linear unit that will be used with the radius field.</p><ul><li><span title=\"KILOMETERS\">Kilometers</span>—The unit will be kilometers.</li><li><span title=\"METERS\">Meters</span>—The unit will be meters.</li><li><span title=\"MILESINT\">Statute Miles</span>—The unit will be statute miles.</li><li><span title=\"YARDSINT\">International Yards</span>—The unit will be international yards.</li><li><span title=\"FEETINT\">International Feet</span>—The unit will be international feet.</li><li><span title=\"MILES\">US Survey Miles</span>—The unit will be US Survey miles. This is the default.</li><li><span title=\"YARDS\">US Survey Yards</span>—The unit will be US Survey yards.</li><li><span title=\"FEET\">US Survey Feet</span>—The unit will be US Survey feet.</li></ul></xdoc>",
        "radius_unit.domain.FEET": "US Survey Feet",
        "radius_unit.domain.FEETINT": "International Feet",
        "radius_unit.domain.KILOMETERS": "Kilometers",
        "radius_unit.domain.METERS": "Meters",
        "radius_unit.domain.MILES": "US Survey Miles",
        "radius_unit.domain.MILESINT": "Statute Miles",
        "radius_unit.domain.YARDS": "US Survey Yards",
        "radius_unit.domain.YARDSINT": "International Yards",
        "radius_unit.title": "Radius Unit",
        "title": "Cell Site Records To Feature Class",
        "x_field.descr": "The field in the input table that contains the x-coordinate of the cell site.",
        "x_field.title": "X Field",
        "y_field.descr": "The field in the input table that contains the y-coordinate of the cell site.",
        "y_field.title": "Y Field"
    }
