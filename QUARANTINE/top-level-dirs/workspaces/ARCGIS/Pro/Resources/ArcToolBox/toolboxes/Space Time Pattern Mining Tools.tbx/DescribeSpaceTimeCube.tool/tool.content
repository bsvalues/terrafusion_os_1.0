{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\DescribeSpaceTimeCube",
    "displayname": "$rc:title",
    "helpcontent": "50040001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_cube": {
            "display_order": "0",
            "displayname": "$rc:in_cube.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "nc"
                ]
            },
            "description": "$rc:in_cube.descr"
        },
        "out_characteristics_table": {
            "type": "optional",
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_characteristics_table.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_characteristics_table.descr"
        },
        "out_spatial_extent": {
            "type": "optional",
            "direction": "out",
            "display_order": "2",
            "displayname": "$rc:out_spatial_extent.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_spatial_extent.descr"
        }
    }
}
