{
    "type": "FunctionTool",
    "guid": "{26B17338-CB00-45A9-AB9C-858C2E0122C9}/SetLineDirection",
    "displayname": "$rc:title",
    "helpcontent": "76110001",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "in_line_features": {
            "displayname": "$rc:in_line_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_line_features.descr"
        },
        "digital_elevation_model": {
            "displayname": "$rc:digital_elevation_model.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "description": "$rc:digital_elevation_model.descr"
        },
        "line_direction": {
            "type": "optional",
            "displayname": "$rc:line_direction.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DOWNHILL",
                        "code": "$rc:line_direction.domain.DOWNHILL"
                    },
                    {
                        "value": "DOWNHILL_FLOW",
                        "code": "$rc:line_direction.domain.DOWNHILL_FLOW"
                    },
                    {
                        "value": "DOWNHILL_SPLIT_FLOW",
                        "code": "$rc:line_direction.domain.DOWNHILL_SPLIT_FLOW"
                    }
                ]
            },
            "value": "DOWNHILL_FLOW",
            "description": "$rc:line_direction.descr"
        },
        "reverse_direction": {
            "type": "optional",
            "displayname": "$rc:reverse_direction.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "REVERSE_DIRECTION"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "KEEP_DIRECTION"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:reverse_direction.descr"
        },
        "vertical_tolerance": {
            "type": "optional",
            "displayname": "$rc:vertical_tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "value": "0 Meters",
            "description": "$rc:vertical_tolerance.descr"
        },
        "updated_line_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_line_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_line_features"
            ]
        }
    }
}
