                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "TS",
                    "PS",
                    "MPG",
                    "MPEG",
                    "MP2",
                    "MPEG2",
                    "MP4",
                    "MPG4",
                    "MPEG4",
                    "VOB",
                    "M2TS",
                    "AVI",
                    "MOV"
                ]
            },
            "description": "$rc:in_video.descr"
        },
        "out_folder": {
            "direction": "out",
            "displayname": "$rc:out_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:out_folder.descr"
        },
        "image_type": {
            "type": "optional",
            "displayname": "$rc:image_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "JPEG",
                        "code": "$rc:image_type.domain.JPEG"
                    },
                    {
                        "value": "TIFF",
                        "code": "$rc:image_type.domain.TIFF"
                    },
                    {
                        "value": "NITF",
                        "code": "$rc:image_type.domain.NITF"
                    },
                    {
                        "value": "PNG",
                        "code": "$rc:image_type.domain.PNG"
                    }
                ]
            },
            "value": "TIFF",
            "description": "$rc:image_type.descr"
        },
        "image_overlap": {
            "type": "optional",
            "displayname": "$rc:image_overlap.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "100",
            "description": "$rc:image_overlap.descr"
        },
        "require_fresh_metadata": {
            "type": "optional",
            "displayname": "$rc:require_fresh_metadata.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "REQUIRE_FRESH_METADATA"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_REQUIRE_FRESH_METADATA"
                    }
                ]
