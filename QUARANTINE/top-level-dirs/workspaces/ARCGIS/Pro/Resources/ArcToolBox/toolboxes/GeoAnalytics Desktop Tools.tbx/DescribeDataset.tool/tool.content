{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "69000020",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "spark"
    ],
    "params": {
        "input_layer": {
            "displayname": "$rc:input_layer.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:input_layer.descr"
        },
        "output": {
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output.descr"
        },
        "sample_features": {
            "type": "optional",
            "displayname": "$rc:sample_features.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:sample_features.descr"
        },
        "sample_layer": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:sample_layer.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DETable"
                    },
                    {
                        "type": "DEFeatureClass"
                    }
                ]
            },
            "description": "$rc:sample_layer.descr"
        },
        "extent_layer": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:extent_layer.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:extent_layer.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
