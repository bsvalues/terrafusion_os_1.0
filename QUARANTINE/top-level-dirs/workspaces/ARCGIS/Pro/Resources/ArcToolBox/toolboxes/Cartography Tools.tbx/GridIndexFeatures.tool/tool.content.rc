{
    "map": {
        "description": "Creates a grid of rectangular polygon features that can be used as an index to specify pages in a spatial map series. A grid can be created that includes only polygon features that intersect another feature layer.",
        "in_features.descr": "The input features to be used to define the extent of the polygon grid that will be created.",
        "in_features.title": "Input Features",
        "intersect_feature.descr": "<xdoc><p>Specifies whether the output grid feature class is limited to areas that intersect input feature layers or datasets. The intersection of input features will be used to create index features.</p><ul><li>Checked—Limits the output grid feature class to areas that intersect input feature layers or datasets. When input features are specified, this is the default.</li><li>Unchecked—An output grid feature class is created using specified coordinates, rows, and columns.</li></ul></xdoc>",
        "intersect_feature.title": "Generate Polygon Grid that intersects input feature layers or datasets",
        "label_from_origin.descr": "<xdoc><p>Specifies where page numbers (labels) begin.</p><ul><li>Checked—Page numbers (labels) begin with the polygon feature in the lower left corner of the output grid.</li><li>Unchecked—Page numbers (labels) begin with the polygon feature in the upper left corner of the output grid. This is the default.</li></ul></xdoc>",
        "label_from_origin.title": "Start labeling from the Origin",
        "number_columns.descr": "The number of columns to create in the x direction from the point of origin. The default is 10.",
        "number_columns.title": "Number of Columns",
        "number_rows.descr": "The number of rows to create in the y direction from the point of origin. The default is 10.",
        "number_rows.title": "Number of Rows",
        "origin_coord.descr": "The coordinate value for the lower left origin of the output grid feature class. If input features are specified, the default value is determined by the extent of the union of extents for these features. If there are no input features specified, the default coordinates are 0 and 0.",
        "origin_coord.title": "Polygon Grid Origin Coordinate",
        "out_feature_class.descr": "<xdoc><p>The resulting feature class of polygon index features.</p><p>The coordinate system of the output feature class is determined in the following order:</p><ul><li>If a coordinate system is specified by the Output Coordinate System environment, the output feature class will use this coordinate system.</li><li>If a coordinate system is not specified by the Output Coordinate System environment, the output feature class will use the coordinate system of the active map (ArcGIS Pro is open).</li><li>If a coordinate system is not specified by the Output Coordinate System environment, and there is no active map (ArcGIS Pro is not open), the output feature class will use the coordinate system of the first input feature.</li><li>If a coordinate system is not specified by the Output Coordinate System environment, there is no active map (ArcGIS Pro is not open), and there are no specified input features, the coordinate system of the output feature class will be unknown.</li></ul></xdoc>",
        "out_feature_class.title": "Output Feature Class",
        "polygon_height.descr": "The height of the index polygon specified in either map or page units. If page units are used, the default value is 1 inch. If map units are used, the default value is 1 degree.",
        "polygon_height.title": "Polygon Height",
        "polygon_width.descr": "The width of the index polygon specified in either map or page units. If page units are used, the default value is 1 inch. If map units are used, the default value is 1 degree.",
        "polygon_width.title": "Polygon Width",
        "scale.descr": "The map scale. The scale must be specified if the index polygon height and width are to be calculated in page units. If the tool is used outside an active ArcGIS Pro session, the default scale value is 1.",
        "scale.title": "Map Scale",
        "starting_page_number.descr": "Each grid index feature is assigned a sequential page number starting with a specified starting page number. The default is 1.",
        "starting_page_number.title": "Starting Page Number",
        "title": "Grid Index Features",
        "use_page_unit.descr": "<xdoc><p>Specifies whether index polygon size input is in page units.</p><ul><li>Checked—Index polygon height and width are calculated in page units.</li><li>Unchecked—Index polygon height and width are calculated in map units. This is the default.</li></ul></xdoc>",
        "use_page_unit.title": "Use Page Unit and Scale"
    }
}
