{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "2140004",
    "description": "$rc:description",
    "product": "200",
    "params": {
        "target_feature_dataset": {
            "displayname": "$rc:target_feature_dataset.title",
            "datatype": {
                "type": "DEFeatureDataset"
            },
            "description": "$rc:target_feature_dataset.descr"
        },
        "in_streets_features": {
            "displayname": "$rc:in_streets_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_streets_features.descr"
        },
        "search_distance": {
            "displayname": "$rc:search_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "value": "100 Meters",
            "description": "$rc:search_distance.descr"
        },
        "expression": {
            "type": "optional",
            "displayname": "$rc:expression.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "in_streets_features"
            ],
            "description": "$rc:expression.descr"
        },
        "updated_target_feature_dataset": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_target_feature_dataset.title",
            "datatype": {
                "type": "DEFeatureDataset"
            },
            "schema": {
                "type": "GPContainerSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "updated_in_streets_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_in_streets_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "updated_in_stops": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_in_stops.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "output_stops_on_streets": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_stops_on_streets.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "output_stop_connectors": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_stop_connectors.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    }
}
