    "product": "100",
    "params": {
        "in_base_tin": {
            "displayname": "$rc:in_base_tin.title",
            "datatype": {
                "type": "GPTinLayer"
            },
            "description": "$rc:in_base_tin.descr"
        },
        "in_test_tin": {
            "displayname": "$rc:in_test_tin.title",
            "datatype": {
                "type": "GPTinLayer"
            },
            "description": "$rc:in_test_tin.descr"
        },
        "compare_type": {
            "type": "optional",
            "displayname": "$rc:compare_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ALL",
                        "code": "$rc:compare_type.domain.ALL"
                    },
                    {
                        "value": "PROPERTIES_ONLY",
                        "code": "$rc:compare_type.domain.PROPERTIES_ONLY"
                    },
                    {
                        "value": "SPATIAL_REFERENCE_ONLY",
                        "code": "$rc:compare_type.domain.SPATIAL_REFERENCE_ONLY"
                    }
                ]
            },
            "value": "ALL",
            "description": "$rc:compare_type.descr"
        },
        "continue_compare": {
            "type": "optional",
            "displayname": "$rc:continue_compare.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CONTINUE_COMPARE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_CONTINUE_COMPARE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:continue_compare.descr"
        },
        "out_compare_file": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_compare_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "txt",
                    "csv"
                ]
            },
            "description": "$rc:out_compare_file.descr"
        },
        "compare_status": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:compare_status.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "NO_DIFFERENCES_FOUND"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DIFFERENCES_FOUND"
                    }
                ]
            },
            "value": "true"
        }
