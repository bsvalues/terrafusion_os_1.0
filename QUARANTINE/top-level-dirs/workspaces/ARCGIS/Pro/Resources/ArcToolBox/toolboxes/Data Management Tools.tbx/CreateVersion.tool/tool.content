{
    "type": "FunctionTool",
    "guid": "{dc3af540-a4ef-44b7-b7ea-9d0ff327c44d}",
    "displayname": "$rc:title",
    "helpcontent": "3170002",
    "description": "$rc:description",
    "product": "200",
    "params": {
        "in_workspace": {
            "display_order": "0",
            "displayname": "$rc:in_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Remote Database",
                    "Feature Service"
                ]
            },
            "description": "$rc:in_workspace.descr"
        },
        "parent_version": {
            "display_order": "1",
            "displayname": "$rc:parent_version.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:parent_version.descr"
        },
        "version_name": {
            "display_order": "2",
            "displayname": "$rc:version_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:version_name.descr"
        },
        "access_permission": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:access_permission.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PRIVATE",
                        "code": "$rc:access_permission.domain.PRIVATE"
                    },
                    {
                        "value": "PUBLIC",
                        "code": "$rc:access_permission.domain.PUBLIC"
                    },
                    {
                        "value": "PROTECTED",
                        "code": "$rc:access_permission.domain.PROTECTED"
                    }
                ]
            },
            "value": "PRIVATE",
            "description": "$rc:access_permission.descr"
        },
        "out_workspace": {
            "type": "derived",
            "direction": "out",
            "display_order": "4",
            "displayname": "$rc:out_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "depends": [
                "in_workspace"
            ],
            "addtomap": "false"
        },
        "version_description": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:version_description.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:version_description.descr"
        }
    },
    "environments": [
        "workspace"
    ]
}
