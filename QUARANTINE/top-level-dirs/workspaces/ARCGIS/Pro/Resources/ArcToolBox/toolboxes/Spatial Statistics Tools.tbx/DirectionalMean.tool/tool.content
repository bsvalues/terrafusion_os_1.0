{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\DirectionalMean",
    "displayname": "$rc:title",
    "helpcontent": "9040003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Feature_Class": {
            "displayname": "$rc:input_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_feature_class.descr"
        },
        "Output_Feature_Class": {
            "direction": "out",
            "displayname": "$rc:output_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_feature_class.descr"
        },
        "Orientation_Only": {
            "displayname": "$rc:orientation_only.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ORIENTATION_ONLY"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DIRECTION"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:orientation_only.descr"
        },
        "Case_Field": {
            "type": "optional",
            "displayname": "$rc:case_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Text",
                    "Date",
                    "BigInteger"
                ]
            },
            "depends": [
                "Input_Feature_Class"
            ],
            "description": "$rc:case_field.descr"
        }
    },
    "environments": [
        "MResolution",
        "MTolerance",
        "XYResolution",
        "XYTolerance",
        "ZResolution",
        "ZTolerance",
        "geographicTransformations",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "qualifiedFieldNames",
        "scratchWorkspace",
        "workspace"
    ]
}
