{
    "map": {
        "autolayout_option.descr": "<xdoc><p>Specifies whether automatic layouts that are configured on the template on which the diagrams are based will be reapplied during the update process. By default, when automatic layouts are specified on a template, they are not reapplied during the update process.<ul><li>Checked—The automatic layouts that are configured on the template will be reapplied to diagrams at the end of the update process.</li><li>Unchecked—None of the automatic layouts configured on the template will be reapplied to diagrams during the update process. This is the default.</li></ul></p></xdoc>",
        "autolayout_option.title": "Re-apply automatic layouts on the updated diagrams",
        "description": "Updates one or more network diagrams that are related to a given utility network or trace network.",
        "diagram_names.descr": "The names of the diagrams to be processed.",
        "diagram_names.title": "Diagram Names",
        "in_diagrams.descr": "The input network diagram layer that will be updated, or the utility network or trace network—on which the set of specified input diagram names are based—that will be updated.",
        "in_diagrams.title": "Input Network or Network Diagram Layer",
        "out_diagrams.title": "Output Network or Network Diagram Layer",
        "params.category1": "Advanced Options",
        "summary": "<xdoc><p>Updates one or more network diagrams that are related to a given utility network or trace network.</p><p>Diagrams may need to be updated when they are either inconsistent or consistent. When a diagram is inconsistent, it means the network elements associated with some diagram features have been altered, and the diagram is out of date. A consistent diagram may need to be updated if the diagram template associated with it has been modified.</p><note type=\"caution\"/><p group=\"note\">If you have an open edit session, you must save your edits prior to running this tool. This ensures that the diagram reflects the latest changes made to the network topology in the database. If you fail to save your edits, the edits will not be reflected in the diagram.</p>Learn more about updating network diagrams</xdoc>",
        "template_names.descr": "The names of the templates for which the related diagrams will be processed.",
        "template_names.title": "Template Names",
        "title": "Update Diagram",
        "update_option.descr": "<xdoc><p>Specifies whether only inconsistent diagrams (the default) or all diagrams regardless of their consistency state will be updated.</p><ul><li>Checked—Only inconsistent diagrams will be updated. This is the default.</li><li>Unchecked—Both consistent and inconsistent diagrams will be updated.</li></ul></xdoc>",
        "update_option.title": "Update inconsistent diagrams only"
    }
}
