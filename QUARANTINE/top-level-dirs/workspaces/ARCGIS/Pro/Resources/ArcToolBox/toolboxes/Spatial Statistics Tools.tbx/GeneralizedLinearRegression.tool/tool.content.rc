{
    "map": {
        "dependent_variable.descr": "The numeric field containing the observed values to be modeled.",
        "dependent_variable.title": "Dependent Variable",
        "description": "Performs generalized linear regression (GLR) to generate predictions or to model a dependent variable in terms of its relationship to a set of explanatory variables.  This tool can be used to fit continuous (OLS), binary (logistic), and count (Poisson) models.",
        "distance_features.descr": "<xdoc><p>Automatically creates explanatory variables by calculating a distance from the provided features to the <span class=\"esri_uicontrol\">Input Features</span> values. Distances will be calculated from each of the input <span class=\"esri_uicontrol\">Explanatory Distance Features</span> values to the nearest <span class=\"esri_uicontrol\">Input Features</span> value. If the input <span class=\"esri_uicontrol\">Explanatory Distance Features</span> values are polygons or lines, the distance attributes will be calculated as the distance between the closest segments of the pair of features.</p></xdoc>",
        "distance_features.title": "Explanatory Distance Features",
        "explanatory_distance_matching.descr": "<xdoc><p>Matches the distance features specified for the <span class=\"esri_uicontrol\">Prediction Locations</span> parameter on the left to corresponding distance features for the <span class=\"esri_uicontrol\">Input Features</span> parameter on the right.</p></xdoc>",
        "explanatory_distance_matching.dt.title1": "Prediction Distance Features",
        "explanatory_distance_matching.dt.title2": "Input Distance Features",
        "explanatory_distance_matching.title": "Match Distance Features",
        "explanatory_variables.descr": "A list of fields representing independent explanatory variables in the regression model.",
        "explanatory_variables.title": "Explanatory Variable(s)",
        "explanatory_variables_to_match.descr": "<xdoc><p>Matches the explanatory variables in the <span class=\"esri_uicontrol\">Prediction Locations</span> parameter to corresponding explanatory variables from the <span class=\"esri_uicontrol\">Input Feature Class</span> parameter.</p></xdoc>",
        "explanatory_variables_to_match.dt.title1": "Field from Prediction Locations",
        "explanatory_variables_to_match.dt.title2": "Field from Input Features",
        "explanatory_variables_to_match.title": "Match Explanatory Variables",
        "in_features.descr": "The feature class containing the dependent and independent variables.",
        "in_features.title": "Input Features",
        "model_type.descr": "<xdoc><p>Specifies the type of data that will be modeled.</p><ul><li><span title=\"CONTINUOUS\">Continuous (Gaussian)</span>— The <span class=\"esri_uicontrol\">Dependent Variable</span> value is continuous. The model used is Gaussian, and the tool performs ordinary least squares regression.</li><li><span title=\"BINARY\">Binary (Logistic)</span>— The <span class=\"esri_uicontrol\">Dependent Variable</span> value represents presence or absence. This can be either conventional 1s and 0s, or continuous data that has been recoded based on a threshold value. The model used is Logistic Regression.</li><li><span title=\"COUNT\">Count (Poisson)</span>—The <span class=\"esri_uicontrol\">Dependent Variable</span> value is discrete and represents events—for example, crime counts, disease incidents, or traffic accidents. The model used is Poisson regression.</li></ul></xdoc>",
        "model_type.domain.BINARY": "Binary (Logistic)",
        "model_type.domain.CONTINUOUS": "Continuous (Gaussian)",
        "model_type.domain.COUNT": "Count (Poisson)",
        "model_type.title": "Model Type",
        "output_features.descr": "The new feature class that will contain the dependent variable estimates and residuals.",
        "output_features.title": "Output Features",
        "output_predicted_features.descr": "<xdoc><p>The output feature class that will receive dependent variable estimates for each <span class=\"esri_uicontrol\">Prediction Location</span> value.</p></xdoc>",
        "output_predicted_features.title": "Output Predicted Features",
        "output_trained_model.descr": "An output model file that will save the trained model, which can be used later for prediction.",
