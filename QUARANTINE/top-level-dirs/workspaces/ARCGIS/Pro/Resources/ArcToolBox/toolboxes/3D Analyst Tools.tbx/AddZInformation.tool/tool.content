{
    "type": "FunctionTool",
    "guid": "{9d9c6928-8ecc-410b-9c47-5abb1e25b212}",
    "displayname": "$rc:title",
    "helpcontent": "5170002",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "edit_session",
        "input_data_change"
    ],
    "params": {
        "in_feature_class": {
            "displayname": "$rc:in_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline",
                    "Polygon",
                    "Point",
                    "Multipoint",
                    "MultiPatch"
                ]
            },
            "description": "$rc:in_feature_class.descr"
        },
        "out_property": {
            "control_guid": "{38C34610-C7F7-11D5-A693-0008C711C8C1}",
            "displayname": "$rc:out_property.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "Z",
                        "code": "$rc:out_property.domain.Z"
                    },
                    {
                        "value": "Z_MIN",
                        "code": "$rc:out_property.domain.Z_MIN"
                    },
                    {
                        "value": "Z_MAX",
                        "code": "$rc:out_property.domain.Z_MAX"
                    },
                    {
                        "value": "Z_MEAN",
                        "code": "$rc:out_property.domain.Z_MEAN"
                    },
                    {
                        "value": "POINT_COUNT",
                        "code": "$rc:out_property.domain.POINT_COUNT"
                    },
                    {
                        "value": "LENGTH_3D",
                        "code": "$rc:out_property.domain.LENGTH_3D"
                    },
                    {
                        "value": "SURFACE_AREA",
                        "code": "$rc:out_property.domain.SURFACE_AREA"
                    },
                    {
                        "value": "VOLUME",
                        "code": "$rc:out_property.domain.VOLUME"
                    },
                    {
                        "value": "MIN_SLOPE",
                        "code": "$rc:out_property.domain.MIN_SLOPE"
                    },
                    {
                        "value": "MAX_SLOPE",
                        "code": "$rc:out_property.domain.MAX_SLOPE"
                    },
                    {
                        "value": "AVG_SLOPE",
                        "code": "$rc:out_property.domain.AVG_SLOPE"
                    },
                    {
                        "value": "VERTEX_COUNT",
                        "code": "$rc:out_property.domain.VERTEX_COUNT"
                    }
                ]
            },
            "description": "$rc:out_property.descr"
        },
        "noise_filtering": {
            "type": "optional",
            "displayname": "$rc:noise_filtering.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:noise_filtering.descr"
        },
        "output_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_feature_class"
            ]
        }
    },
    "environments": [
        "autoCommit",
        "extent",
        "workspace"
    ]
}
