{
    "type": "ServerTool",
    "server": "OfflinePackaging",
    "uri": "https://packaging.arcgis.com/arcgis/services",
    "user": "UseSSOIdentityIfPortalOwned",
    "toolname": "CreateMapArea",
    "displayname": "$rc:title",
    "product": "100",
    "params": {
        "mapItemId": {
            "displayname": "$rc:mapitemid.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "bookmark": {
            "type": "optional",
            "displayname": "$rc:bookmark.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "extent": {
            "type": "optional",
            "displayname": "$rc:extent.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "areaType": {
            "type": "optional",
            "displayname": "$rc:areatype.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "BOOKMARK",
                        "code": "$rc:areatype.domain.BOOKMARK"
                    },
                    {
                        "value": "ENVELOPE",
                        "code": "$rc:areatype.domain.ENVELOPE"
                    },
                    {
                        "value": "POLYGON",
                        "code": "$rc:areatype.domain.POLYGON"
                    }
                ]
            },
            "value": "BOOKMARK"
        },
        "area": {
            "type": "optional",
            "displayname": "$rc:area.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "outputName": {
            "type": "optional",
            "displayname": "$rc:outputname.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "mapAreaItemId": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:mapareaitemid.title",
            "datatype": {
                "type": "GPString"
            }
        }
    }
}
