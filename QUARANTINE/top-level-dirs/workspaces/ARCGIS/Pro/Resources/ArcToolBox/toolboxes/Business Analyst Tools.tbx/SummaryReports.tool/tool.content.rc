        "report_per_feature.descr": "<xdoc><p>Specifies whether a single report or multiple reports will be created.</p><ul><li>Checked—A report will be created per feature.</li><li>Unchecked—A single report will be created. This is the default.</li></ul></xdoc>",
        "report_per_feature.title": "Create Report Per Feature",
        "report_templates.descr": "One or more report templates that will be used to create the summary report. You must be signed in to ArcGIS Online or have Business Analyst Data installed.",
