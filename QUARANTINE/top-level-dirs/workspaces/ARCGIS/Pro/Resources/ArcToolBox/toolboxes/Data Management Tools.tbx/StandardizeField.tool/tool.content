{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3060026",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "in_table": {
            "display_order": "0",
            "displayname": "$rc:in_table.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPTableView"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "description": "$rc:in_table.descr"
        },
        "fields": {
            "display_order": "4",
            "displayname": "$rc:fields.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:fields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:fields.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double",
                            "BigInteger"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain"
                    }
                ]
            },
            "depends": [
                "in_table"
            ],
            "description": "$rc:fields.descr"
        },
        "method": {
            "type": "optional",
            "display_order": "1",
            "displayname": "$rc:method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "Z-SCORE",
                        "code": "$rc:method.domain.Z-SCORE"
                    },
                    {
                        "value": "MIN-MAX",
                        "code": "$rc:method.domain.MIN-MAX"
                    },
                    {
                        "value": "MAXABS",
                        "code": "$rc:method.domain.MAXABS"
                    },
                    {
                        "value": "ROBUST",
                        "code": "$rc:method.domain.ROBUST"
                    }
                ]
            },
            "value": "Z-SCORE",
            "description": "$rc:method.descr"
        },
        "min_value": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:min_value.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0",
            "description": "$rc:min_value.descr"
        },
        "max_value": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:max_value.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "1",
            "description": "$rc:max_value.descr"
        },
        "updated_table": {
            "type": "derived",
            "direction": "out",
            "display_order": "5",
            "displayname": "$rc:updated_table.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPTableView"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "depends": [
                "in_table"
            ],
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "extent"
    ]
}
