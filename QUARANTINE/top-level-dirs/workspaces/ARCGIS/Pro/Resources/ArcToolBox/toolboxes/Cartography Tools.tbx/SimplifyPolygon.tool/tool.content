{
    "type": "FunctionTool",
    "guid": "{891a155c-4cc9-4828-b6ad-f3feb093257f}",
    "displayname": "$rc:title",
    "helpcontent": "3080008",
    "description": "$rc:description",
    "product": "200",
    "attributes": [
        "multiref"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple",
                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexEdge",
                    "RasterCatalogItem"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "algorithm": {
            "displayname": "$rc:algorithm.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POINT_REMOVE",
                        "code": "$rc:algorithm.domain.POINT_REMOVE"
                    },
                    {
                        "value": "BEND_SIMPLIFY",
                        "code": "$rc:algorithm.domain.BEND_SIMPLIFY"
                    },
                    {
                        "value": "WEIGHTED_AREA",
                        "code": "$rc:algorithm.domain.WEIGHTED_AREA"
                    },
                    {
                        "value": "EFFECTIVE_AREA",
                        "code": "$rc:algorithm.domain.EFFECTIVE_AREA"
                    }
                ]
            },
            "value": "POINT_REMOVE",
            "description": "$rc:algorithm.descr"
        },
        "tolerance": {
            "displayname": "$rc:tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:tolerance.descr"
        },
        "minimum_area": {
            "type": "optional",
            "displayname": "$rc:minimum_area.title",
            "datatype": {
                "type": "GPArealUnit"
            },
            "depends": [
                "in_features"
            ],
            "value": "0 Unknown",
            "description": "$rc:minimum_area.descr"
        },
        "error_option": {
            "type": "optional",
            "displayname": "$rc:error_option.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NO_CHECK",
                        "code": "$rc:error_option.domain.NO_CHECK"
                    },
                    {
                        "value": "FLAG_ERRORS",
                        "code": "$rc:error_option.domain.FLAG_ERRORS"
                    },
                    {
                        "value": "RESOLVE_ERRORS",
                        "code": "$rc:error_option.domain.RESOLVE_ERRORS"
                    }
                ]
            },
            "value": "NO_CHECK",
            "description": "$rc:error_option.descr"
        },
        "collapsed_point_option": {
            "type": "optional",
            "displayname": "$rc:collapsed_point_option.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "KEEP_COLLAPSED_POINTS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_KEEP"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:collapsed_point_option.descr"
        },
        "out_point_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_point_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "value": "output_feature_class_Pnt"
        },
        "in_barriers": {
            "type": "optional",
            "displayname": "$rc:in_barriers.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "description": "$rc:in_barriers.descr"
        }
    },
    "environments": [
        "MDomain",
        "XYDomain",
        "XYTolerance",
        "cartographicPartitions",
        "extent",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "scratchWorkspace",
        "workspace"
    ]
}
