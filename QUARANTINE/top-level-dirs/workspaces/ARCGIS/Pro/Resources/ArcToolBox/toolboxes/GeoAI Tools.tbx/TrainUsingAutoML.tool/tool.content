{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "79020002",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "GPU",
        "mCPU"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPFeatureLayer"
                    },
                    {
                        "type": "GPTableView"
                    },
                    {
                        "type": "DEFeatureClass"
                    }
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_model": {
            "direction": "out",
            "displayname": "$rc:out_model.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "dlpk",
                    "emd"
                ]
            },
            "description": "$rc:out_model.descr"
        },
        "variable_predict": {
            "displayname": "$rc:variable_predict.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:variable_predict.descr"
        },
        "treat_variable_as_categorical": {
            "type": "optional",
            "displayname": "$rc:treat_variable_as_categorical.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CATEGORICAL"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "CONTINUOUS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:treat_variable_as_categorical.descr"
        },
        "explanatory_variables": {
            "type": "optional",
            "displayname": "$rc:explanatory_variables.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:explanatory_variables.dt.title1"
                    },
                    {
                        "type": "GPBoolean",
                        "displayname": "$rc:explanatory_variables.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain"
                    },
                    {
                        "type": "GPCodedValueDomain"
                    }
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:explanatory_variables.descr"
        },
        "distance_features": {
            "type": "optional",
            "displayname": "$rc:distance_features.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:distance_features.descr"
        },
        "explanatory_rasters": {
            "type": "optional",
            "displayname": "$rc:explanatory_rasters.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPRasterLayer",
                        "displayname": "$rc:explanatory_rasters.dt.title1"
                    },
                    {
                        "type": "GPBoolean",
                        "displayname": "$rc:explanatory_rasters.dt.title2"
                    }
                ]
            },
            "description": "$rc:explanatory_rasters.descr"
        },
        "total_time_limit": {
            "type": "optional",
            "displayname": "$rc:total_time_limit.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "240",
            "description": "$rc:total_time_limit.descr"
        },
        "autoML_mode": {
            "type": "optional",
            "displayname": "$rc:automl_mode.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "BASIC",
                        "code": "$rc:automl_mode.domain.BASIC"
                    },
                    {
                        "value": "INTERMEDIATE",
                        "code": "$rc:automl_mode.domain.INTERMEDIATE"
                    },
                    {
                        "value": "ADVANCED",
                        "code": "$rc:automl_mode.domain.ADVANCED"
                    }
                ]
            },
            "value": "BASIC",
            "description": "$rc:automl_mode.descr"
        },
        "algorithms": {
            "type": "optional",
            "displayname": "$rc:algorithms.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "RANDOM TREES",
                        "code": "$rc:algorithms.domain.RANDOM TREES"
                    },
                    {
                        "value": "XGBOOST",
                        "code": "$rc:algorithms.domain.XGBOOST"
                    },
                    {
                        "value": "LIGHT GBM",
                        "code": "$rc:algorithms.domain.LIGHT GBM"
                    },
                    {
                        "value": "DECISION TREE",
                        "code": "$rc:algorithms.domain.DECISION TREE"
                    },
                    {
                        "value": "EXTRA TREE",
                        "code": "$rc:algorithms.domain.EXTRA TREE"
                    },
                    {
                        "value": "LINEAR",
                        "code": "$rc:algorithms.domain.LINEAR"
                    },
                    {
                        "value": "CATBOOST",
                        "code": "$rc:algorithms.domain.CATBOOST"
                    }
                ]
            },
            "description": "$rc:algorithms.descr"
        },
        "validation_percent": {
            "type": "optional",
            "displayname": "$rc:validation_percent.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "value": "10",
            "description": "$rc:validation_percent.descr"
        },
        "out_report": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_report.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "html"
                ]
            },
            "description": "$rc:out_report.descr"
        },
        "out_importance": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_importance.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_importance.descr"
        },
        "out_features": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_features.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_features.descr"
        },
        "add_image_attachments": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:add_image_attachments.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "value": "false",
            "description": "$rc:add_image_attachments.descr"
        },
        "sensitive_feature": {
            "type": "optional",
            "displayname": "$rc:sensitive_feature.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:sensitive_feature.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:sensitive_feature.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain"
                    },
                    {
                        "type": "GPCodedValueDomain"
                    }
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:sensitive_feature.descr"
        },
        "fairness_metric": {
            "type": "optional",
            "displayname": "$rc:fairness_metric.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DEMOGRAPHIC_PARITY_RATIO",
                        "code": "$rc:fairness_metric.domain.DEMOGRAPHIC_PARITY_RATIO"
                    },
                    {
                        "value": "DEMOGRAPHIC_PARITY_DIFFERENCE",
                        "code": "$rc:fairness_metric.domain.DEMOGRAPHIC_PARITY_DIFFERENCE"
                    },
                    {
                        "value": "EQUALISED_ODDS_RATIO",
                        "code": "$rc:fairness_metric.domain.EQUALISED_ODDS_RATIO"
                    },
                    {
                        "value": "EQUALISED_ODDS_DIFFERENCE",
                        "code": "$rc:fairness_metric.domain.EQUALISED_ODDS_DIFFERENCE"
                    },
                    {
                        "value": "GROUP_LOSS_RATIO",
                        "code": "$rc:fairness_metric.domain.GROUP_LOSS_RATIO"
                    }
                ]
            },
            "value": "DEMOGRAPHIC_PARITY_RATIO",
            "description": "$rc:fairness_metric.descr"
        }
    },
    "environments": [
        "geographicTransformations",
        "outputCoordinateSystem"
    ]
}
