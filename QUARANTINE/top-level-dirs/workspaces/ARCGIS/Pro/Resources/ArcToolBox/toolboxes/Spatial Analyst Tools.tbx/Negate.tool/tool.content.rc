{
    "map": {
        "description": "Changes the sign (multiplies by -1) of the cell values of the input raster on a cell-by-cell basis.",
        "in_raster_or_constant.descr": "<xdoc><p>The input raster to be negated (multiplied by -1).</p><p>To use a number as an input for this parameter, the cell size and extent must first be set in the environment.</p></xdoc>",
        "in_raster_or_constant.title": "Input raster or constant value",
        "out_raster.descr": "<xdoc><p>The output raster.</p><p>The cell values are the input values negated (multiplied by -1).</p></xdoc>",
        "out_raster.title": "Output raster",
        "title": "Negate"
    }
}
