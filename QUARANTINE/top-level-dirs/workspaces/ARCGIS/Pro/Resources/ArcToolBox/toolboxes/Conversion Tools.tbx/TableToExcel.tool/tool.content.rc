{
    "map": {
        "description": "Converts  a table to a Microsoft Excel file (.xls or .xlsx).",
        "input_table.descr": "The table or tables to be converted to an Excel file.",
        "input_table.title": "Input Table",
        "output_excel_file.descr": "The output Excel file. Specify the format of the Excel file using the .xls or .xlsx file extension.",
        "output_excel_file.title": "Output Excel File (.xls or .xlsx)",
        "summary": "Converts a table to a Microsoft Excel file (.xls or .xlsx).",
        "title": "Table To Excel",
        "use_domain_and_subtype_description.descr": "<xdoc><p>Specifies whether values from subtype fields or fields with a coded value domain will be transferred to the output.</p><ul><li>Unchecked—All field values will be used as they are stored in the table. This is the default.</li><li>Checked—For subtype fields, the subtype description will be used. For fields with a coded value domain, the coded value descriptions will be used.</li></ul></xdoc>",
        "use_domain_and_subtype_description.title": "Use domain and subtype description",
        "use_field_alias_as_column_header.descr": "<xdoc><p>Specifies whether input field names or field aliases will be used as the output column names.</p><ul><li>Unchecked—Column headers will be set using the input field names. This is the default.</li><li>Checked—Column headers will be set using the input geodatabase table&apos;s field aliases. If the input is a layer in a map, the value set on the layer&apos;s field alias is ignored.</li></ul></xdoc>",
        "use_field_alias_as_column_header.title": "Use field alias as column header"
    }
}
