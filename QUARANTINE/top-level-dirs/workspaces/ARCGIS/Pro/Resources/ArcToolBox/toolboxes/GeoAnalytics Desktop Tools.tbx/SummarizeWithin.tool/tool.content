{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "69000010",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "spark"
    ],
    "params": {
        "summarized_layer": {
            "displayname": "$rc:summarized_layer.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:summarized_layer.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "polygon_or_bin": {
            "type": "optional",
            "displayname": "$rc:polygon_or_bin.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POLYGON",
                        "code": "$rc:polygon_or_bin.domain.POLYGON"
                    },
                    {
                        "value": "BIN",
                        "code": "$rc:polygon_or_bin.domain.BIN"
                    }
                ]
            },
            "value": "POLYGON",
            "description": "$rc:polygon_or_bin.descr"
        },
        "bin_type": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:bin_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SQUARE",
                        "code": "$rc:bin_type.domain.SQUARE"
                    },
                    {
                        "value": "HEXAGON",
                        "code": "$rc:bin_type.domain.HEXAGON"
                    }
                ]
            },
            "value": "SQUARE",
            "description": "$rc:bin_type.descr"
        },
        "bin_size": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:bin_size.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:bin_size.descr"
        },
        "summary_polygons": {
            "type": "optional",
            "displayname": "$rc:summary_polygons.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:summary_polygons.descr"
        },
        "sum_shape": {
            "type": "optional",
            "displayname": "$rc:sum_shape.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_SUMMARY"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_SUMMARY"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:sum_shape.descr"
        },
        "shape_units": {
            "type": "optional",
            "displayname": "$rc:shape_units.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FEET",
                        "code": "$rc:shape_units.domain.FEET"
                    },
                    {
                        "value": "YARDS",
                        "code": "$rc:shape_units.domain.YARDS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:shape_units.domain.MILES"
                    },
                    {
                        "value": "NAUTICAL_MILES",
                        "code": "$rc:shape_units.domain.NAUTICAL_MILES"
                    },
                    {
                        "value": "METERS",
                        "code": "$rc:shape_units.domain.METERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:shape_units.domain.KILOMETERS"
                    },
                    {
                        "value": "FEET_INT",
                        "code": "$rc:shape_units.domain.FEET_INT"
                    },
                    {
                        "value": "YARDS_INT",
                        "code": "$rc:shape_units.domain.YARDS_INT"
                    },
                    {
                        "value": "MILES_INT",
                        "code": "$rc:shape_units.domain.MILES_INT"
                    },
                    {
                        "value": "NAUTICAL_MILES_INT",
                        "code": "$rc:shape_units.domain.NAUTICAL_MILES_INT"
                    },
                    {
                        "value": "SQUARE_KILOMETERS",
                        "code": "$rc:shape_units.domain.SQUARE_KILOMETERS"
                    },
                    {
                        "value": "SQUARE_METERS",
                        "code": "$rc:shape_units.domain.SQUARE_METERS"
                    },
                    {
                        "value": "HECTARES",
                        "code": "$rc:shape_units.domain.HECTARES"
                    },
                    {
                        "value": "ACRES",
                        "code": "$rc:shape_units.domain.ACRES"
                    },
                    {
                        "value": "SQUARE_MILES",
                        "code": "$rc:shape_units.domain.SQUARE_MILES"
                    },
                    {
                        "value": "SQUARE_YARDS",
                        "code": "$rc:shape_units.domain.SQUARE_YARDS"
                    },
                    {
                        "value": "SQUARE_FEET",
                        "code": "$rc:shape_units.domain.SQUARE_FEET"
                    },
                    {
                        "value": "ACRES_US",
                        "code": "$rc:shape_units.domain.ACRES_US"
                    },
                    {
                        "value": "SQUARE_MILES_US",
                        "code": "$rc:shape_units.domain.SQUARE_MILES_US"
                    },
                    {
                        "value": "SQUARE_YARDS_US",
                        "code": "$rc:shape_units.domain.SQUARE_YARDS_US"
                    },
                    {
                        "value": "SQUARE_FEET_US",
                        "code": "$rc:shape_units.domain.SQUARE_FEET_US"
                    }
                ]
            },
            "description": "$rc:shape_units.descr"
        },
        "standard_summary_fields": {
            "type": "optional",
            "displayname": "$rc:standard_summary_fields.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:standard_summary_fields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:standard_summary_fields.dt.title2"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:standard_summary_fields.dt.title3"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "BigInteger",
                            "Float",
                            "Double",
                            "Text",
                            "Date"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "COUNT",
                                "code": "$rc:standard_summary_fields.domain.item2.COUNT"
                            },
                            {
                                "value": "SUM",
                                "code": "$rc:standard_summary_fields.domain.item2.SUM"
                            },
                            {
                                "value": "MEAN",
                                "code": "$rc:standard_summary_fields.domain.item2.MEAN"
                            },
                            {
                                "value": "MIN",
                                "code": "$rc:standard_summary_fields.domain.item2.MIN"
                            },
                            {
                                "value": "MAX",
                                "code": "$rc:standard_summary_fields.domain.item2.MAX"
                            },
                            {
                                "value": "STDDEV",
                                "code": "$rc:standard_summary_fields.domain.item2.STDDEV"
                            },
                            {
                                "value": "VAR",
                                "code": "$rc:standard_summary_fields.domain.item2.VAR"
                            },
                            {
                                "value": "RANGE",
                                "code": "$rc:standard_summary_fields.domain.item2.RANGE"
                            },
                            {
                                "value": "ANY",
                                "code": "$rc:standard_summary_fields.domain.item2.ANY"
                            }
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "Count",
                                "code": "$rc:standard_summary_fields.domain.item3.Count"
                            },
                            {
                                "value": "Rate",
                                "code": "$rc:standard_summary_fields.domain.item3.Rate"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "summarized_layer"
            ],
            "description": "$rc:standard_summary_fields.descr"
        },
        "weighted_summary_fields": {
            "type": "optional",
            "displayname": "$rc:weighted_summary_fields.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:weighted_summary_fields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:weighted_summary_fields.dt.title2"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:weighted_summary_fields.dt.title3"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "BigInteger",
                            "Float",
                            "Double"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "MEAN",
                                "code": "$rc:weighted_summary_fields.domain.item2.MEAN"
                            },
                            {
                                "value": "STDDEV",
                                "code": "$rc:weighted_summary_fields.domain.item2.STDDEV"
                            },
                            {
                                "value": "VAR",
                                "code": "$rc:weighted_summary_fields.domain.item2.VAR"
                            }
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "Count",
                                "code": "$rc:weighted_summary_fields.domain.item3.Count"
                            },
                            {
                                "value": "Rate",
                                "code": "$rc:weighted_summary_fields.domain.item3.Rate"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "summarized_layer"
            ],
            "description": "$rc:weighted_summary_fields.descr"
        },
        "group_by_field": {
            "type": "optional",
            "displayname": "$rc:group_by_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Text",
                    "Date"
                ]
            },
            "depends": [
                "summarized_layer"
            ],
            "description": "$rc:group_by_field.descr"
        },
        "add_minority_majority": {
            "type": "optional",
            "displayname": "$rc:add_minority_majority.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_MIN_MAJ"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_MIN_MAJ"
                    }
                ]
            },
            "description": "$rc:add_minority_majority.descr"
        },
        "add_percentages": {
            "type": "optional",
            "displayname": "$rc:add_percentages.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_PERCENT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_PERCENT"
                    }
                ]
            },
            "description": "$rc:add_percentages.descr"
        },
        "group_by_summary": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:group_by_summary.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:group_by_summary.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
