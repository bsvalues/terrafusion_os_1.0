            },
            "description": "$rc:ntm_date.descr"
        },
        "out_location": {
            "display_order": "2",
            "displayname": "$rc:out_location.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:out_location.descr"
        },
        "out_vpf_folder": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_vpf_folder.title",
