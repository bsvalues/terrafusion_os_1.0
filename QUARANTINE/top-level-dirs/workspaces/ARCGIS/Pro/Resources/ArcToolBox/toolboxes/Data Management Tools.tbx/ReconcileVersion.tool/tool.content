{
    "type": "FunctionTool",
    "guid": "{3a3e11b0-251b-410b-b545-a4fa88af5cda}",
    "displayname": "$rc:title",
    "helpcontent": "3170004",
    "description": "$rc:description",
    "product": "200",
    "params": {
        "in_workspace": {
            "displayname": "$rc:in_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Remote Database"
                ]
            },
            "description": "$rc:in_workspace.descr"
        },
        "version_name": {
            "displayname": "$rc:version_name.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Remote Database"
                ]
            },
            "description": "$rc:version_name.descr"
        },
        "target_name": {
            "displayname": "$rc:target_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:target_name.descr"
        },
        "conflict_definition": {
            "type": "optional",
            "displayname": "$rc:conflict_definition.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "BY_OBJECT",
                        "code": "$rc:conflict_definition.domain.BY_OBJECT"
                    },
                    {
                        "value": "BY_ATTRIBUTE",
                        "code": "$rc:conflict_definition.domain.BY_ATTRIBUTE"
                    }
                ]
            },
            "value": "BY_OBJECT",
            "description": "$rc:conflict_definition.descr"
        },
        "conflict_resolution": {
            "type": "optional",
            "displayname": "$rc:conflict_resolution.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FAVOR_TARGET_VERSION",
                        "code": "$rc:conflict_resolution.domain.FAVOR_TARGET_VERSION"
                    },
                    {
                        "value": "FAVOR_EDIT_VERSION",
                        "code": "$rc:conflict_resolution.domain.FAVOR_EDIT_VERSION"
                    }
                ]
            },
            "value": "FAVOR_TARGET_VERSION",
            "description": "$rc:conflict_resolution.descr"
        },
        "aquired_locks": {
            "type": "optional",
            "displayname": "$rc:aquired_locks.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "LOCK_ACQUIRED"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_LOCK_ACQUIRED"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:aquired_locks.descr"
        },
        "abort_if_conflicts": {
            "type": "optional",
            "displayname": "$rc:abort_if_conflicts.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ABORT_CONFLICTS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_ABORT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:abort_if_conflicts.descr"
        },
        "post": {
            "type": "optional",
            "displayname": "$rc:post.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "POST"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_POST"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:post.descr"
        },
        "out_workspace": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "depends": [
                "in_workspace"
            ]
        }
    },
    "environments": [
        "configKeyword",
        "scratchWorkspace",
        "workspace"
    ]
}
