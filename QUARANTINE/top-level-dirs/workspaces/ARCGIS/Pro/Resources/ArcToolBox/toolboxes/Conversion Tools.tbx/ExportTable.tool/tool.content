{
    "type": "FunctionTool",
    "guid": "{8a55d708-3fdf-4804-87e7-8e72181994c0}",
    "displayname": "$rc:title",
    "helpcontent": "2040015",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "params": {
        "in_table": {
            "displayname": "$rc:in_table.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPTableView"
                    },
                    {
                        "type": "GPRasterLayer"
                    }
                ]
            },
            "description": "$rc:in_table.descr"
        },
        "out_table": {
            "direction": "out",
            "displayname": "$rc:out_table.title",
            "datatype": {
                "type": "DETable"
            },
            "depends": [
                "in_table"
            ],
            "schema": {
                "type": "GPTableSchema",
                "fields.rule": "Maintain",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_table.descr"
        },
        "where_clause": {
            "type": "optional",
            "displayname": "$rc:where_clause.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "in_table"
            ],
            "category": "$rc:params.category1",
            "description": "$rc:where_clause.descr"
        },
        "use_field_alias_as_name": {
            "type": "optional",
            "displayname": "$rc:use_field_alias_as_name.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "USE_ALIAS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NOT_USE_ALIAS"
                    }
                ]
            },
            "value": "false",
            "category": "$rc:params.category2",
            "description": "$rc:use_field_alias_as_name.descr"
        },
        "field_mapping": {
            "type": "optional",
            "displayname": "$rc:field_mapping.title",
            "datatype": {
                "type": "GPFieldMapping"
            },
            "depends": [
                "in_table"
            ],
            "category": "$rc:params.category2",
            "description": "$rc:field_mapping.descr"
        },
        "sort_field": {
            "type": "optional",
            "displayname": "$rc:sort_field.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:sort_field.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:sort_field.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double",
                            "Text",
                            "Date"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "ASCENDING",
                                "code": "$rc:sort_field.domain.item2.ASCENDING"
                            },
                            {
                                "value": "DESCENDING",
                                "code": "$rc:sort_field.domain.item2.DESCENDING"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "in_table"
            ],
            "description": "$rc:sort_field.descr"
        }
    },
    "environments": [
        "configKeyword",
        "extent",
        "maintainAttachments",
        "preserveGlobalIds",
        "qualifiedFieldNames",
        "scratchWorkspace",
        "transferDomains",
        "workspace"
    ]
}
