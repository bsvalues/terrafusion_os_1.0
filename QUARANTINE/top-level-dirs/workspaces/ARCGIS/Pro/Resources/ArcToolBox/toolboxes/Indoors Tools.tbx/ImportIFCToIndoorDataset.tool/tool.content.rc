{
    "map": {
        "description": "Imports features from an .ifc file to an indoor dataset that conforms to the ArcGIS Indoors Information Model. The output of this tool can be used to create floor-aware maps and scenes, as well as to generate an indoor network for routing.",
        "facility_name.descr": "The common name of the building. If a feature with the same name exists in the target Facilities layer, it will be updated, along with all of the associated Levels, Units, and Details features.",
        "facility_name.title": "Facility Name",
        "ground_elevation_zero.descr": "<xdoc><p>Specifies whether the elevation of the ground floor will be set to 0 or the elevation of the floors features in the georeferenced BIM model.</p><ul><li>Checked—The ground floor elevation will be set to 0 and the z-values of other levels will be defined based on their relationship to the ground floor. This is the default.</li><li>Unchecked—The elevation of level features will match the elevation of the floors in the georeferenced BIM model.</li></ul></xdoc>",
        "ground_elevation_zero.title": "Set Ground Floor Elevation To Zero",
        "ground_floor_name.descr": "The ground floor of the building. The vertical order of the levels is derived from this value. Any levels with an elevation that is less than the specified ground floor will be assigned a negative vertical order.",
        "ground_floor_name.title": "Ground Floor Name",
        "in_bim_file_workspace.descr": "The input IFC workspace.",
        "in_bim_file_workspace.title": "Input BIM File Workspace",
        "in_floorplan_footprint.descr": "The Floorplan Footprint feature layer created using the Extract BIM File Floorplan tool. Features in this layer will be used to create features in the target Facilities layer.",
        "in_floorplan_footprint.title": "Input Floorplan Footprint Layer",
        "in_floorplan_polygon.descr": "The Floorplan Polygon feature layer created using the Extract BIM File Floorplan tool. Features in this layer will be used to create features in the target Levels and Units layers.",
        "in_floorplan_polygon.title": "Input Floorplan Polygon Layer",
        "in_floorplan_polyline.descr": "The Floorplan Polyline feature layer created using the Extract BIM File Floorplan tool. Features in this layer will be used to create features in the target Details layer.",
        "in_floorplan_polyline.title": "Input Floorplan Polyline Layer",
        "load_floorplan_layers.descr": "<xdoc><p>Specifies whether features will be loaded from input floor plan layers created by the Extract BIM File Floorplan tool.</p><ul><li>Checked—Features will be loaded from the input floor plan layers created by the Extract BIM File Floorplan tool. Any selections set on the input layers will be honored.</li><li>Unchecked—Features will be loaded from the .ifc file. All levels will be loaded and no selections will be honored. This is the default.</li></ul></xdoc>",
        "load_floorplan_layers.title": "Load From Floorplan Layers",
        "load_roofs.descr": "<xdoc><p>Specifies whether roof features will be imported as levels features.</p><ul><li>Checked—Roof elements will be imported from the input .ifc file and used along with floors features to create levels features in the Indoors workspace.</li><li>Unchecked—Roof features will not be imported from the .ifc file. This is the default.</li></ul></xdoc>",
        "load_roofs.title": "Load Roofs",
        "params.category1": "3D Features",
        "target_detail3d_features.descr": "The target Details3D feature layer, feature class, or feature service that conforms to the Indoors model. Multipatch detail features will be created in the target Details3D layer from the following categories in the input .ifc file: Doors, Columns, Walls, Ramps, Stairs, Windows, Curtain Walls, and Structural Columns.",
        "target_detail3d_features.title": "Target Detail 3D Features",
        "target_detail_features.descr": "The target Details feature layer, feature class, or feature service that conforms to the Indoors model and resides in the same workspace as the target Facilities, Levels, and Units features.",
        "target_detail_features.title": "Target Detail Features",
        "target_facility3d_features.descr": "The target 3D Facilities feature layer, feature class, or feature service that conforms to the Indoors model. A multipatch facility feature will be created in the target Facilities3D layer from the ExteriorShell category in the input .ifc file.",
        "target_facility3d_features.title": "Target Facility 3D Features",
        "target_facility_features.descr": "The target Facilities feature layer, feature class, or feature service that conforms to the Indoors model and resides in the same workspace as the target Levels, Units, and Details features.",
        "target_facility_features.title": "Target Facility Features",
        "target_level_features.descr": "The target Levels feature layer, feature class, or feature service that conforms to the Indoors model and resides in the same workspace as the target Facilities, Units, and Details features.",
        "target_level_features.title": "Target Level Features",
        "target_unit3d_features.descr": "The target Units3D feature layer, feature class, or feature service that conforms to the Indoors model. Multipatch unit features will be created in the target Units3D layer from the Spaces category of the input .ifc file.",
        "target_unit3d_features.title": "Target Unit 3D Features",
        "target_unit_features.descr": "The target Units feature layer, feature class, or feature service that conforms to the Indoors model and resides in the same workspace as the target Facilities, Levels, and Details features.",
        "target_unit_features.title": "Target Unit Features",
        "title": "Import IFC To Indoor Dataset",
        "unit_properties_mapping.descr": "Controls which attribute fields in the Units layer will be populated with field values from the input IFC Spaces layer. The fields must exist before running the tool. It is recommended that you map fields from the input IFC Spaces layer to fields from the Units layer that have the same field type.",
        "unit_properties_mapping.title": "Unit Properties Mapping",
        "updated_details.title": "Updated Details",
        "updated_details3d.title": "Updated Details 3D",
        "updated_facilities.title": "Updated Facilities",
        "updated_facilities3d.title": "Updated Facilities 3D",
        "updated_levels.title": "Updated Levels",
        "updated_units.title": "Updated Units",
        "updated_units3d.title": "Updated Units 3D"
    }
}
