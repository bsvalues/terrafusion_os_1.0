{
    "map": {
        "description": "Removes a linear referencing system (LRS) entity from an input geodatabase workspace.",
        "in_workspace.descr": "The input geodatabase workspace that contains the LRS entity that will be removed.",
        "in_workspace.title": "LRS Workspace",
        "lrs_entity_name.descr": "The name of the LRS entity that will be removed from the input geodatabase workspace. The underlying feature classes and tables of the LRS entity will not be deleted.",
        "lrs_entity_name.title": "LRS Entity Name",
        "lrs_entity_type.descr": "<xdoc><p>Specifies the type of LRS entity that will be removed from the input geodatabase workspace.</p><ul><li><span title=\"LRS\">LRS</span>—An LRS and its dependent LRS Networks, as well as the LRS events, and LRS intersections registered to those LRS Networks, will be removed.</li><li><span title=\"NETWORK\">Network</span>—An LRS Network and the LRS events and LRS intersections registered to that LRS Network will be removed.</li><li><span title=\"EVENT\">Event</span>—An LRS event will be removed.</li><li><span title=\"INTERSECTION\">Intersection</span>—An LRS intersection will be removed.</li><li><span title=\"UN_FEATURE_CLASS\">Utility Network Feature Class</span>—A utility network feature class will be removed.</li><li><span title=\"ADDRESS_FEATURE_CLASS\">Address Feature Class</span>—Address management feature classes will be removed.</li></ul></xdoc>",
        "lrs_entity_type.domain.ADDRESS_FEATURE_CLASS": "Address Feature Class",
        "lrs_entity_type.domain.EVENT": "Event",
        "lrs_entity_type.domain.INTERSECTION": "Intersection",
        "lrs_entity_type.domain.LRS": "LRS",
        "lrs_entity_type.domain.NETWORK": "Network",
        "lrs_entity_type.domain.UN_FEATURE_CLASS": "Utility Network Feature Class",
        "lrs_entity_type.title": "LRS Entity Type",
        "out_workspace.title": "Updated LRS Workspace",
        "title": "Remove LRS Entity"
    }
