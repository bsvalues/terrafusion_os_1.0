            "displayname": "$rc:contour_color.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "BLACK",
                        "code": "$rc:contour_color.domain.BLACK"
                    },
                    {
                        "value": "BROWN",
                        "code": "$rc:contour_color.domain.BROWN"
                    },
                    {
                        "value": "BLUE",
                        "code": "$rc:contour_color.domain.BLUE"
                    }
                ]
            },
            "value": "BLACK",
            "description": "$rc:contour_color.descr"
        },
        "contour_type_field": {
