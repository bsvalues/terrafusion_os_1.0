                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEFeatureDataset"
                    }
                ]
            },
            "defaultenvironmentname": "workspace",
            "description": "$rc:out_geodatabase.descr"
        },
        "contour_label_field": {
