{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "69000008",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "spark"
    ],
    "params": {
        "input_layer": {
            "displayname": "$rc:input_layer.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:input_layer.descr"
        },
        "search_layer": {
            "displayname": "$rc:search_layer.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:search_layer.descr"
        },
        "output": {
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEFeatureClass"
                    },
                    {
                        "type": "DETable"
                    }
                ]
            },
            "description": "$rc:output.descr"
        },
        "analysis_fields": {
            "displayname": "$rc:analysis_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "description": "$rc:analysis_fields.descr"
        },
        "most_or_least_similar": {
            "type": "optional",
            "displayname": "$rc:most_or_least_similar.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "MOST_SIMILAR",
                        "code": "$rc:most_or_least_similar.domain.MOST_SIMILAR"
                    },
                    {
                        "value": "LEAST_SIMILAR",
                        "code": "$rc:most_or_least_similar.domain.LEAST_SIMILAR"
                    },
                    {
                        "value": "BOTH",
                        "code": "$rc:most_or_least_similar.domain.BOTH"
                    }
                ]
            },
            "value": "MOST_SIMILAR",
            "description": "$rc:most_or_least_similar.descr"
        },
        "match_method": {
            "type": "optional",
            "displayname": "$rc:match_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ATTRIBUTE_VALUES",
                        "code": "$rc:match_method.domain.ATTRIBUTE_VALUES"
                    },
                    {
                        "value": "ATTRIBUTE_PROFILES",
                        "code": "$rc:match_method.domain.ATTRIBUTE_PROFILES"
                    }
                ]
            },
            "value": "ATTRIBUTE_VALUES",
            "description": "$rc:match_method.descr"
        },
        "number_of_results": {
            "type": "optional",
            "displayname": "$rc:number_of_results.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "10000"
            },
            "value": "10",
            "description": "$rc:number_of_results.descr"
        },
        "append_fields": {
            "type": "optional",
            "displayname": "$rc:append_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Float",
                    "Double",
                    "Text",
                    "Date",
                    "Blob",
                    "Raster",
                    "GUID",
                    "GlobalID",
                    "XML"
                ]
            },
            "depends": [
                "search_layer"
            ],
            "description": "$rc:append_fields.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
