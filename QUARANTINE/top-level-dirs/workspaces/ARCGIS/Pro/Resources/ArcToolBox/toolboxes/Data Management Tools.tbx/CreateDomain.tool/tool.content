                        "code": "$rc:field_type.domain.FLOAT"
                    },
                    {
                        "value": "DOUBLE",
                        "code": "$rc:field_type.domain.DOUBLE"
                    },
                    {
                        "value": "TEXT",
                        "code": "$rc:field_type.domain.TEXT"
                    },
                    {
                        "value": "DATE",
                        "code": "$rc:field_type.domain.DATE"
                    },
                    {
                        "value": "DATEONLY",
                        "code": "$rc:field_type.domain.DATEONLY"
                    },
                    {
                        "value": "TIMEONLY",
                        "code": "$rc:field_type.domain.TIMEONLY"
                    }
                ]
            },
            "value": "SHORT",
            "description": "$rc:field_type.descr"
        },
        "domain_type": {
            "type": "optional",
            "displayname": "$rc:domain_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "CODED",
