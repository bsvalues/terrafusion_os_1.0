{
    "map": {
        "container_sources.descr": "<xdoc><p>The container source class (or classes) and object table (or tables) that will be excluded or included depending on the rule process.</p><p>When <span class=\"esri_uicontrol\">Rule Process</span> is set to <span class=\"esri_uicontrol\">Exclude source classes</span>, no particular container source class or object table can be specified. In this case, all containers in the generated diagrams regardless of their source class or object table will be expanded. When <span class=\"esri_uicontrol\">Rule Process</span> is set to <span class=\"esri_uicontrol\">Include source classes</span>, the particular container source class (or classes) and object table (or tables) to be expanded must be specified.</p><p>When the <span class=\"esri_uicontrol\">Exclude source classes</span> option is specified, the containers belonging to the specified source classes or object tables will not be expanded in the generated diagrams; however, container features and container objects that don&apos;t belong to those source classes and tables will be expanded. Conversely, when the <span class=\"esri_uicontrol\">Include source classes</span> option is specified, the containers belonging to the specified source classes and object tables will be expanded in the generated diagrams; however, container features and container objects that don&apos;t belong to those source classes and object tables will not be expanded.</p></xdoc>",
        "container_sources.title": "Container Sources",
        "container_type.descr": "<xdoc><p>Specifies the geometry type of the container source class or object table that will be processed.</p><ul><li><span title=\"JUNCTIONS\">Junctions only</span>—Only junction container source classes or object tables (polygon container source classes, point container source classes, or container junction object tables) will be processed.</li><li><span title=\"EDGES\">Edges only</span>—Only edge container source classes or object tables (linear container source classes or container edge object tables) will be processed.</li><li><span title=\"BOTH\">Both junctions and edges</span>—All container source classes and object tables regardless of their type (both junction and edge types) will be processed. This is the default.</li></ul></xdoc>",
        "container_type.domain.BOTH": "Both junctions and edges",
        "container_type.domain.EDGES": "Edges only",
        "container_type.domain.JUNCTIONS": "Junctions only",
        "container_type.title": "Container Type",
        "containers_visibility.descr": "<xdoc><p>Specifies whether the containers stay visible after they are expanded.<ul><li>Checked—The containers will stay visible after they are expanded. This is the default.</li><li>Unchecked—The containers will be hidden after they are expanded.</li></ul></p></xdoc>",
        "containers_visibility.title": "Keep containers visible",
        "description": "Adds a diagram rule to the rule sequence specified on a diagram template to automatically expand container contents during diagram buildings. This rule expands all of the container contents in the diagrams.",
        "description.descr": "The description of the rule.",
        "description.title": "Description",
        "in_utility_network.descr": "The utility network or trace network containing the diagram template that will be modified.",
        "in_utility_network.title": "Input Network",
        "inverse_source_selection.descr": "<xdoc><p>Specifies how the specified container source classes and object tables will be processed.</p><ul><li><span title=\"EXCLUDE_SOURCE_CLASSES\">Exclude source classes</span>—Containers that are based on the specified source classes and object tables will not be expanded, while other containers will be expanded. This is the default.</li><li><span title=\"INCLUDE_SOURCE_CLASSES\">Include source classes</span>—Containers that are based on the specified source classes and object tables will be expanded.</li></ul></xdoc>",
        "inverse_source_selection.domain.EXCLUDE_SOURCE_CLASSES": "Exclude source classes",
        "inverse_source_selection.domain.INCLUDE_SOURCE_CLASSES": "Include source classes",
        "inverse_source_selection.title": "Rule Process",
        "is_active.descr": "<xdoc><p>Specifies whether the rule will be active when generating and updating diagrams based on the specified template.<ul><li>Checked—The added rule will become active during the generation and update of any diagrams based on the input template. This is the default.</li><li>Unchecked—The added rule will not become active during the generation or update of any diagrams based on the input template.</li></ul></p></xdoc>",
        "is_active.title": "Active",
        "out_template_name.title": "Output Diagram Template",
        "out_utility_network.title": "Output Network",
        "summary": "<xdoc><p>Adds a diagram rule to the rule sequence specified on a diagram template to automatically expand container contents during diagram buildings. This rule expands all of the container contents in the diagrams.</p><note type=\"caution\"/><p group=\"note\">This tool is a configuration and administration tool.</p><note type=\"note\"/><p group=\"note\">This tool impacts the consistency of any existing diagrams based on the input diagram template. All of the existing diagrams become inconsistent and open with a consistency warning icon until they are updated.</p></xdoc>",
        "template_name.descr": "The name of the diagram template that will be modified.",
        "template_name.title": "Input Diagram Template",
        "title": "Add Expand Container Rule"
    }
}
