{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "53010001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "analysisLayer": {
            "displayname": "$rc:analysislayer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:analysislayer.descr"
        },
        "outputName": {
            "displayname": "$rc:outputname.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:outputname.descr"
        },
        "analysisField": {
            "type": "optional",
            "displayname": "$rc:analysisfield.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "analysisLayer"
            ],
            "description": "$rc:analysisfield.descr"
        },
        "divideByField": {
            "type": "optional",
            "displayname": "$rc:dividebyfield.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "analysisLayer"
            ],
            "description": "$rc:dividebyfield.descr"
        },
        "boundingPolygonLayer": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:boundingpolygonlayer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "description": "$rc:boundingpolygonlayer.descr"
        },
        "aggregatePolygonLayer": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:aggregatepolygonlayer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "description": "$rc:aggregatepolygonlayer.descr"
        },
        "outputLayer": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:outputlayer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "extent"
    ]
}
