{
    "type": "FunctionTool",
    "guid": "{8a0cbd7b-84ae-48bd-a099-1c75c5d52339}",
    "displayname": "$rc:title",
    "helpcontent": "3180002",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "params": {
        "out_dataset_path": {
            "displayname": "$rc:out_dataset_path.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "defaultenvironmentname": "workspace",
            "description": "$rc:out_dataset_path.descr"
        },
        "out_name": {
            "displayname": "$rc:out_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_name.descr"
        },
        "spatial_reference": {
            "type": "optional",
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "depends": [
                "out_dataset_path"
            ],
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:spatial_reference.descr"
        },
        "out_dataset": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_dataset.title",
            "datatype": {
                "type": "DEFeatureDataset"
            }
        }
    },
    "environments": [
        "MResolution",
        "MTolerance",
        "XYResolution",
        "XYTolerance",
        "ZResolution",
        "ZTolerance",
        "outputCoordinateSystem",
        "workspace"
    ]
}
