        "summary": "Modifies the workspace of a layer or table view to connect to the specified version.",
        "title": "Change Version",
        "version_name.descr": "The name of the version to which the input feature layer will connect. This parameter is optional if you're using a historical version.",
        "version_name.title": "Version Name",
        "version_type.descr": "<xdoc><p>Specifies the type of version to which the input feature layer will connect.</p><ul><li><span title=\"TRANSACTIONAL\">Traditional version</span>—Connect to a defined state of the database (traditional version).</li><li><span title=\"HISTORICAL\">Historical version</span>—Connect to a version representing a defined moment in time, often specified by a time or historical marker.</li><li><span title=\"BRANCH\">Branch version</span>—Connect to a branch version.</li></ul></xdoc>",
        "version_type.domain.BRANCH": "Branch version",
