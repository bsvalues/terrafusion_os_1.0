    ],
    "attributes": [
        "edit_session",
        "input_data_change"
    ],
    "params": {
        "in_line_features": {
            "displayname": "$rc:in_line_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:in_line_features.descr"
        },
        "distances_type": {
            "type": "optional",
            "displayname": "$rc:distances_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "OVERWRITE",
                        "code": "$rc:distances_type.domain.OVERWRITE"
                    },
                    {
                        "value": "UPDATE_NULL_ONLY",
                        "code": "$rc:distances_type.domain.UPDATE_NULL_ONLY"
                    },
                    {
                        "value": "USE_MINIMUM_DIFFERENCE",
                        "code": "$rc:distances_type.domain.USE_MINIMUM_DIFFERENCE"
                    },
                    {
                        "value": "DO_NOT_UPDATE",
                        "code": "$rc:distances_type.domain.DO_NOT_UPDATE"
                    }
                ]
            },
            "value": "OVERWRITE",
            "description": "$rc:distances_type.descr"
        },
        "distance_tolerance": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:distance_tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "distances_type"
            ],
            "value": "0 Meters",
            "description": "$rc:distance_tolerance.descr"
        },
        "direction_type": {
            "type": "optional",
            "displayname": "$rc:direction_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "OVERWRITE",
                        "code": "$rc:direction_type.domain.OVERWRITE"
                    },
                    {
                        "value": "UPDATE_NULL_ONLY",
                        "code": "$rc:direction_type.domain.UPDATE_NULL_ONLY"
                    },
                    {
                        "value": "USE_MINIMUM_DIFFERENCE",
                        "code": "$rc:direction_type.domain.USE_MINIMUM_DIFFERENCE"
                    },
                    {
                        "value": "DO_NOT_UPDATE",
                        "code": "$rc:direction_type.domain.DO_NOT_UPDATE"
                    }
                ]
            },
            "value": "OVERWRITE",
            "description": "$rc:direction_type.descr"
        },
        "minimum_direction_difference": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:minimum_direction_difference.title",
            "datatype": {
                "type": "GPDouble"
            },
            "depends": [
                "direction_type"
            ],
            "description": "$rc:minimum_direction_difference.descr"
        },
        "minimum_direction_lateral_offset": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:minimum_direction_lateral_offset.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "direction_type"
            ],
            "value": "0 Meters",
            "description": "$rc:minimum_direction_lateral_offset.descr"
        },
        "combined_scale_factor": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:combined_scale_factor.title",
            "datatype": {
                "type": "GPCalculatorExpression"
            },
            "depends": [
                "in_line_features"
            ],
            "value": "1.0",
            "description": "$rc:combined_scale_factor.descr"
        },
        "direction_offset": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:direction_offset.title",
            "datatype": {
                "type": "GPCalculatorExpression"
            },
            "depends": [
                "in_line_features"
            ],
            "value": "0.0",
            "description": "$rc:direction_offset.descr"
        },
        "updated_line_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_line_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_line_features"
            ]
        }
    }
}
