{
    "map": {
        "analysis_variable.descr": "The numeric variable in the netCDF file that will be forecasted to future time steps.",
        "analysis_variable.title": "Analysis Variable",
        "description": "Forecasts the values of each location of a space-time cube using the Holt-Winters exponential smoothing method by decomposing the time series at each location cube into seasonal  and trend components.",
        "in_cube.descr": "The netCDF cube containing the variable to forecast to future time steps. This file must have an .nc file extension and must have been created using the Create Space Time Cube By Aggregating Points, Create Space Time Cube From Defined Locations, or Create Space Time Cube From Multidimensional Raster Layer tool.",
        "in_cube.title": "Input Space Time Cube",
        "level_of_confidence.descr": "<xdoc><p>Specifies the confidence level for the test for time series outliers.</p><ul><li><span title=\"90%\">90%</span>—The confidence level for the test is 90 percent. This is the default.</li><li><span title=\"95%\">95%</span>—The confidence level for the test is 95 percent.</li><li><span title=\"99%\">99%</span>—The confidence level for the test is 99 percent.</li></ul></xdoc>",
        "level_of_confidence.domain.90%": "90%",
        "level_of_confidence.domain.95%": "95%",
        "level_of_confidence.domain.99%": "99%",
        "level_of_confidence.title": "Level of Confidence",
        "maximum_number_of_outliers.descr": "The maximum number of time steps that can be declared outliers for each location. The default value corresponds to 5 percent (rounded down) of the number of time steps of the input space-time cube (a value of at least 1 will always be used). This value cannot exceed 20 percent of the number of time steps.",
        "maximum_number_of_outliers.title": "Maximum Number of Outliers",
        "number_for_validation.descr": "The number of time steps at the end of each time series to exclude for validation. The default value is 10 percent (rounded down) of the number of input time steps, and this value cannot be larger than 25 percent of the number of time steps. Provide the value 0 to not exclude any time steps.",
        "number_for_validation.title": "Number of Time Steps to Exclude for Validation",
        "number_of_time_steps_to_forecast.descr": "A positive integer specifying the number of time steps to forecast. This value cannot be larger than 50 percent of the total time steps in the input space-time cube. The default value is one time step.",
        "number_of_time_steps_to_forecast.title": "Number of Time Steps to Forecast",
        "outlier_option.descr": "<xdoc><p>Specifies whether statistically significant time series outliers will be identified.</p><ul><li><span title=\"NONE\">None</span>—Outliers will not be identified. This is the default.</li><li><span title=\"IDENTIFY\">Identify outliers</span>—Outliers will be identified using the Generalized ESD test.</li></ul></xdoc>",
        "outlier_option.domain.IDENTIFY": "Identify outliers",
        "outlier_option.domain.NONE": "None",
        "outlier_option.title": "Outlier Option",
        "output_cube.descr": "A new space-time cube (.nc file) containing the values of the input space-time cube with the forecasted time steps appended. The Visualize Space Time Cube in 3D tool can be used to see all of the observed and forecasted values simultaneously.",
        "output_cube.title": "Output Space Time Cube",
        "output_features.descr": "The output feature class of all locations in the space-time cube with forecasted values stored as fields. The layer displays the forecast for the final time step and contains pop-up charts showing the time series, forecasts, and 90 percent confidence bounds for each location.",
        "output_features.title": "Output Features",
        "season_length.descr": "The number of time steps corresponding to one season at each location. If there are multiple seasons in the data, it is recommended that you use the longest season to produce the most reliable result. If no value is specified, a season length will be estimated by the tool at each location using a spectral density function.",
        "season_length.title": "Season Length",
        "summary": "Forecasts the values of each location of a space-time cube using the Holt-Winters exponential smoothing method by decomposing the time series at each location cube into seasonal and trend components.",
        "title": "Exponential Smoothing Forecast"
    }
}
