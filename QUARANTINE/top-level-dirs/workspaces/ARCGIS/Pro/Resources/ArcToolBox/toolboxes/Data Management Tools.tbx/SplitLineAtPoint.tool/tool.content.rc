{
    "map": {
        "description": "Splits line features based on intersection or proximity to point features.",
        "in_features.descr": "The input line features that will be split.",
        "in_features.title": "Input Features",
        "out_feature_class.descr": "The output feature class that will contain the split lines.",
        "out_feature_class.title": "Output Feature Class",
        "point_features.descr": "The input point features whose locations will be used to split the input lines.",
        "point_features.title": "Point Features",
        "search_radius.descr": "<xdoc><p>The distance that will be used to split lines by their proximity to point features. Points within the search distance to an input line will be used to split those lines at the nearest location to the point along the line segment.</p><p>If this parameter is not specified, the single nearest point will be used to split the line feature. If a radius is specified, all points within the radius will be used to split the line.</p></xdoc>",
        "search_radius.title": "Search Radius",
        "title": "Split Line at Point"
    }
}
