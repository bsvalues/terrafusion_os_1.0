{
    "map": {
        "criteria_properties.descr": "<xdoc><p>The input features that will be used to set up the criteria properties.<ul><li>Criterion—The field, point, or variable that will be used to calculate the suitability score.</li><li>Title—The name of the criteria.</li><li>Weight—The influence a criteria value has on the overall suitability score. The number must be greater than or equal to 0.</li><li>Influence—An example of a positive influence is as follows: You want a site to score higher if it has a greater number of households holding graduate or professional degrees. An example of an inverse influence is as follows: A lower median home value is more desirable, as it is indicative of greater home affordability. An example of an ideal influence is a search for areas within a range of values.<ul><li>Positive—The higher the criteria value, the higher the suitability score.</li><li>Inverse—The lower the criteria value, the higher the suitability score.</li><li>Ideal—The closer to the ideal value, the higher the suitability score.</li><li>Target—The closer to the target value, the higher the suitability score.</li></ul></li></ul><ul><li>Ideal Value—The closer the criteria value is to the ideal value, the higher the suitability score.</li><li>Minimum Value—A numeric value that sets a hard limit for the criteria lower bound.</li><li>Maximum Value—A numeric value that sets a hard limit for the criteria upper bound.</li><li>Enabled—Check to include the criteria in the final suitability score.</li></ul></p></xdoc>",
        "criteria_properties.domain.item4.IDEAL": "Ideal",
        "criteria_properties.domain.item4.INVERSE": "Inverse",
        "criteria_properties.domain.item4.POSITIVE": "Positive",
        "criteria_properties.domain.item4.TARGET": "Target",
        "criteria_properties.dt.title1": "Criterion",
        "criteria_properties.dt.title2": "Title",
        "criteria_properties.dt.title3": "Weight",
        "criteria_properties.dt.title4": "Influence",
        "criteria_properties.dt.title5": "Ideal Value",
        "criteria_properties.dt.title6": "Minimum Value",
        "criteria_properties.dt.title7": "Maximum Value",
        "criteria_properties.dt.title8": "Enabled",
        "criteria_properties.title": "Criteria Properties",
        "criteria_score_method.descr": "<xdoc><p>Specifies the method that will be used to combine the scaled variables into a single value.</p><ul><li><span title=\"SUM\">Sum</span>— The values will be added. This is the default.</li><li><span title=\"MEAN\">Mean</span>— The arithmetic (additive) mean of the values will be calculated. This is the default.</li><li><span title=\"PRODUCT\">Product</span>— The values will be multiplied. All scaled values must be greater than or equal to zero.</li><li><span title=\"GEOMETRIC_MEAN\">Geometric Mean</span>— The geometric (multiplicative) mean of the values will be calculated. All scaled values must be greater than or equal to zero.</li></ul></xdoc>",
        "criteria_score_method.domain.GEOMETRIC_MEAN": "Geometric Mean",
        "criteria_score_method.domain.MEAN": "Mean",
        "criteria_score_method.domain.PRODUCT": "Product",
        "criteria_score_method.domain.SUM": "Sum",
        "criteria_score_method.title": "Combination Method",
        "criteria_score_preset.descr": "<xdoc><p>Specifies the preprocessing and combination method that will be used when calculating the final score.</p><ul><li><span title=\"SUM_SCALED\">Combine Values</span>—The sum of scaled values with scores representing the distribution of values for each criterion will be used. This is the default.</li><li><span title=\"GEOMEAN_SCALED\">Compound Differences</span>—The geometric mean of the scaled values will be used.</li><li><span title=\"CUSTOM\">Custom</span>—User-defined preprocessing and combination methods will be used.</li></ul></xdoc>",
        "criteria_score_preset.domain.CUSTOM": "Custom",
        "criteria_score_preset.domain.GEOMEAN_SCALED": "Compound Differences",
        "criteria_score_preset.domain.SUM_SCALED": "Combine Values",
        "criteria_score_preset.title": "Preset Method",
        "description": "Defines parameters for criteria.",
        "final_score_method.descr": "<xdoc><p>Specifies the method that will be used to scale the combined score. This parameter will determine the final score.</p><ul><li><span title=\"METHOD_0_1\">Method 0-1</span>—The final score will be calculated with the lowest value of 0 and the highest value of 1.</li><li><span title=\"METHOD_0_100\">Method 0-100</span>—The final score will be calculated with the lowest value of 0 and the highest value of 100.</li><li><span title=\"NONE\">None</span>— The data will not be scaled. This is the default.</li></ul></xdoc>",
        "final_score_method.domain.METHOD_0_1": "Method 0-1",
        "final_score_method.domain.METHOD_0_100": "Method 0-100",
        "final_score_method.domain.NONE": "None",
        "final_score_method.title": "Final Score Scale",
        "in_analysis_layer.descr": "The Suitability Analysis layer that will be used in the analysis.",
        "in_analysis_layer.title": "Input Suitability Analysis Layer",
        "out_analysis_layer.title": "Output Suitability Analysis Layer",
        "preprocessing.descr": "<xdoc><p>Specifies the method that will be used to convert the input variables to a standardized scale.</p><ul><li><span title=\"MINMAX\">Minimum-maximum</span>— Variables will be scaled between 0 and 1 using the minimum and maximum values of each variable. This is the default.</li><li><span title=\"PERCENTILE\">Percentile</span>— Variables will be converted to percentiles between 0 and 1.</li><li><span title=\"ZSCORE\">Z-score</span>— Each variable will be standardized by subtracting the mean value and dividing by the standard deviation.</li><li><span title=\"RAW\">Raw</span>— The values of the variables will be used without change.</li></ul></xdoc>",
        "preprocessing.domain.MINMAX": "Minimum-maximum",
        "preprocessing.domain.PERCENTILE": "Percentile",
        "preprocessing.domain.RAW": "Raw",
        "preprocessing.domain.ZSCORE": "Z-score",
        "preprocessing.title": "Preprocessing Method",
        "title": "Set Criteria Properties"
    }
}
