{
    "type": "FunctionTool",
    "guid": "{fc0b25be-c986-4358-b99c-a90ecb3cb48b}",
    "displayname": "$rc:title",
    "helpcontent": "24010006",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "edit_session",
        "input_data_change"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "featuretype": [
                    "Simple",
                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexEdge",
                    "Annotation",
                    "CoverageAnnotation"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "in_link_features": {
            "displayname": "$rc:in_link_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:in_link_features.descr"
        },
        "method": {
            "type": "optional",
            "displayname": "$rc:method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "AFFINE",
                        "code": "$rc:method.domain.AFFINE"
                    },
                    {
                        "value": "PROJECTIVE",
                        "code": "$rc:method.domain.PROJECTIVE"
                    },
                    {
                        "value": "SIMILARITY",
                        "code": "$rc:method.domain.SIMILARITY"
                    }
                ]
            },
            "value": "AFFINE",
            "description": "$rc:method.descr"
        },
        "out_link_table": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_link_table.title",
            "datatype": {
                "type": "DETable"
            },
            "description": "$rc:out_link_table.descr"
        },
        "out_rmse": {
            "enabled": "false",
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_rmse.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0"
        },
        "out_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_features"
            ]
        }
    },
    "environments": [
        "extent",
        "workspace"
    ]
}
