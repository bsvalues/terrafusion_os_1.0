{
    "version": "1.0",
    "alias": "analysis",
    "displayname": "$rc:title",
    "description": "$rc:descr",
    "helpcontext": "1000000",
    "toolsets": {
        "<root>": {
            "tools": [
                "GenerateGridsAndHexagonsInternal",
                "GeographicallyWeightedRegression"
            ]
        },
        "$rc:toolset3.name": {
            "tools": [
                "Clip",
                "Select",
                "Split",
                "SplitByAttributes",
                "TableSelect"
            ]
        },
        "$rc:toolset1.name": {
            "tools": [
                "ApportionPolygon",
                "CountOverlappingFeatures",
                "Erase",
                "Identity",
                "Intersect",
                "RemoveOverlapMultiple",
                "SpatialJoin",
                "SymDiff",
                "Union",
                "Update"
            ]
        },
        "$rc:toolset5.name": {
            "tools": [
                "PairwiseBuffer",
                "PairwiseClip",
                "PairwiseDissolve",
                "PairwiseErase",
                "PairwiseIntegrate",
                "PairwiseIntersect"
            ]
        },
        "$rc:toolset2.name": {
            "tools": [
                "Buffer",
                "CreateThiessenPolygons",
                "GenerateNearTable",
                "GenerateOriginDestinationLinks",
                "GraphicBuffer",
                "MultipleRingBuffer",
                "Near",
                "PointDistance",
                "PolygonNeighbors"
            ]
        },
        "$rc:toolset4.name": {
            "tools": [
                "Enrich",
                "EnrichLayer",
                "Frequency",
                "Statistics",
                "SummarizeNearby",
                "SummarizeWithin",
                "TabulateIntersection"
            ]
        }
    }
}
