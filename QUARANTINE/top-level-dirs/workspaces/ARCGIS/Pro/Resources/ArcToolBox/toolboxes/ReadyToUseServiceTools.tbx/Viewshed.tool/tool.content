{
    "type": "ServerTool",
    "server": "Tools/Elevation",
    "uri": "https://elevation.arcgis.com/arcgis/rest/services",
    "user": "UseSSOIdentityIfPortalOwned",
    "toolname": "Viewshed",
    "displayname": "$rc:title",
    "helpcontent": "65010003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "InputPoints": {
            "displayname": "$rc:inputpoints.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "value_xml": "<GPFeatureRecordSetLayer xsi:type='typens:GPFeatureRecordSetLayer' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xmlns:xs='http://www.w3.org/2001/XMLSchema' xmlns:typens='http://www.esri.com/schemas/ArcGIS/3.4.0'><RecordSet xsi:type='typens:RecordSet'><Fields xsi:type='typens:Fields'><FieldArray xsi:type='typens:ArrayOfField'><Field xsi:type='typens:Field'><Name>OID</Name><Type>esriFieldTypeOID</Type><IsNullable>false</IsNullable><Length>4</Length><Precision>0</Precision><Scale>0</Scale><Required>true</Required><Editable>false</Editable><ModelName>OID</ModelName></Field><Field xsi:type='typens:Field'><Name>Shape</Name><Type>esriFieldTypeGeometry</Type><IsNullable>true</IsNullable><Length>0</Length><Precision>0</Precision><Scale>0</Scale><Required>true</Required><GeometryDef xsi:type='typens:GeometryDef'><AvgNumPoints>0</AvgNumPoints><GeometryType>esriGeometryPoint</GeometryType><HasM>false</HasM><HasZ>false</HasZ><SpatialReference xsi:type='typens:ProjectedCoordinateSystem'><WKT>PROJCS[&quot;WGS_1984_Web_Mercator_Auxiliary_Sphere&quot;,GEOGCS[&quot;GCS_WGS_1984&quot;,DATUM[&quot;D_WGS_1984&quot;,SPHEROID[&quot;WGS_1984&quot;,6378137.0,298.257223563]],PRIMEM[&quot;Greenwich&quot;,0.0],UNIT[&quot;Degree&quot;,0.0174532925199433]],PROJECTION[&quot;Mercator_Auxiliary_Sphere&quot;],PARAMETER[&quot;False_Easting&quot;,0.0],PARAMETER[&quot;False_Northing&quot;,0.0],PARAMETER[&quot;Central_Meridian&quot;,0.0],PARAMETER[&quot;Standard_Parallel_1&quot;,0.0],PARAMETER[&quot;Auxiliary_Sphere_Type&quot;,0.0],UNIT[&quot;Meter&quot;,1.0],AUTHORITY[&quot;EPSG&quot;,3857]]</WKT><XOrigin>-20037700</XOrigin><YOrigin>-30241100</YOrigin><XYScale>10000</XYScale><ZOrigin>-100000</ZOrigin><ZScale>10000</ZScale><MOrigin>-100000</MOrigin><MScale>10000</MScale><XYTolerance>0.001</XYTolerance><ZTolerance>0.001</ZTolerance><MTolerance>0.001</MTolerance><HighPrecision>true</HighPrecision><WKID>102100</WKID><LatestWKID>3857</LatestWKID></SpatialReference><GridSize0>0</GridSize0></GeometryDef><ModelName>Shape</ModelName></Field><Field xsi:type='typens:Field'><Name>field1</Name><Type>esriFieldTypeSmallInteger</Type><IsNullable>true</IsNullable><Length>2</Length><Precision>0</Precision><Scale>0</Scale><ModelName>field1</ModelName><DefaultValue xsi:type='xs:short'>0</DefaultValue></Field></FieldArray></Fields><Records xsi:type='typens:ArrayOfRecord'></Records></RecordSet><OIDFieldName>OID</OIDFieldName><ShapeFieldName>Shape</ShapeFieldName></GPFeatureRecordSetLayer>",
            "description": "$rc:inputpoints.descr"
        },
        "MaximumDistance": {
            "type": "optional",
            "displayname": "$rc:maximumdistance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:maximumdistance.descr"
        },
        "MaximumDistanceUnits": {
            "type": "optional",
            "displayname": "$rc:maximumdistanceunits.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "Meters",
                        "code": "$rc:maximumdistanceunits.domain.Meters"
                    },
                    {
                        "value": "Kilometers",
                        "code": "$rc:maximumdistanceunits.domain.Kilometers"
                    },
                    {
                        "value": "Feet",
                        "code": "$rc:maximumdistanceunits.domain.Feet"
                    },
                    {
                        "value": "Yards",
                        "code": "$rc:maximumdistanceunits.domain.Yards"
                    },
                    {
                        "value": "Miles",
                        "code": "$rc:maximumdistanceunits.domain.Miles"
                    }
                ]
            },
            "value": "Meters",
            "description": "$rc:maximumdistanceunits.descr"
        },
        "DEMResolution": {
            "type": "optional",
            "displayname": "$rc:demresolution.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FINEST",
                        "code": "$rc:demresolution.domain.FINEST"
                    },
                    {
                        "value": "10m",
                        "code": "$rc:demresolution.domain.10m"
                    },
                    {
                        "value": "24m",
                        "code": "$rc:demresolution.domain.24m"
                    },
                    {
                        "value": "30m",
                        "code": "$rc:demresolution.domain.30m"
                    },
                    {
                        "value": "90m",
                        "code": "$rc:demresolution.domain.90m"
                    }
                ]
            },
            "description": "$rc:demresolution.descr"
        },
        "ObserverHeight": {
            "type": "optional",
            "displayname": "$rc:observerheight.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "1.75",
            "description": "$rc:observerheight.descr"
        },
        "ObserverHeightUnits": {
            "type": "optional",
            "displayname": "$rc:observerheightunits.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "Meters",
                        "code": "$rc:observerheightunits.domain.Meters"
                    },
                    {
                        "value": "Kilometers",
                        "code": "$rc:observerheightunits.domain.Kilometers"
                    },
                    {
                        "value": "Feet",
                        "code": "$rc:observerheightunits.domain.Feet"
                    },
                    {
                        "value": "Yards",
                        "code": "$rc:observerheightunits.domain.Yards"
                    },
                    {
                        "value": "Miles",
                        "code": "$rc:observerheightunits.domain.Miles"
                    }
                ]
            },
            "value": "Meters",
            "description": "$rc:observerheightunits.descr"
        },
        "SurfaceOffset": {
            "type": "optional",
            "displayname": "$rc:surfaceoffset.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0",
            "description": "$rc:surfaceoffset.descr"
        },
        "SurfaceOffsetUnits": {
            "type": "optional",
            "displayname": "$rc:surfaceoffsetunits.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "Meters",
                        "code": "$rc:surfaceoffsetunits.domain.Meters"
                    },
                    {
                        "value": "Kilometers",
                        "code": "$rc:surfaceoffsetunits.domain.Kilometers"
                    },
                    {
                        "value": "Feet",
                        "code": "$rc:surfaceoffsetunits.domain.Feet"
                    },
                    {
                        "value": "Yards",
                        "code": "$rc:surfaceoffsetunits.domain.Yards"
                    },
                    {
                        "value": "Miles",
                        "code": "$rc:surfaceoffsetunits.domain.Miles"
                    }
                ]
            },
            "value": "Meters",
            "description": "$rc:surfaceoffsetunits.descr"
        },
        "GeneralizeViewshedPolygons": {
            "type": "optional",
            "displayname": "$rc:generalizeviewshedpolygons.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "GENERALIZE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_GENERALIZE"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:generalizeviewshedpolygons.descr"
        },
        "OutputViewshed": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:outputviewshed.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            }
        }
    }
}
