    "map": {
        "description": "Populates and updates the DerivedRouteID field and measure values on point and line events with those fields configured and enabled.",
        "event_layers.descr": "<xdoc><p>The event layers that will have the <span class=\"esri_fieldname\">DerivedRouteID</span> field and measure fields updated.</p></xdoc>",
        "event_layers.title": "Event Layers",
        "in_route_features.descr": "<xdoc><p>The LRS Network containing the events with the <span class=\"esri_fieldname\">DerivedRouteID</span> field and measure fields configured.</p></xdoc>",
        "in_route_features.title": "Input Route Features",
        "out_details_file.title": "Output Details File",
        "out_events.title": "Output Events",
        "summary": "<xdoc><p>Populates and updates the <span class=\"esri_fieldname\">DerivedRouteID</span> field and measure values on point and line events with those fields configured and enabled.</p></xdoc>",
        "title": "Derive Event Measures",
        "update_all_events.descr": "<xdoc><p>Specifies whether all event feature classes in the network will be updated.</p><ul><li>Checked—All event feature classes in the network that are selected in the <span class=\"esri_uicontrol\">Input Route Features</span> parameter value will be updated. This is the default.</li><li>Unchecked—All event feature classes in the network that are selected in the <span class=\"esri_uicontrol\">Input Route Features</span> parameter value will not be updated. Individual event layers can be selected using the <span class=\"esri_uicontrol\">Event Layers</span> parameter.</li></ul></xdoc>",
        "update_all_events.title": "Update all event feature classes registered in the selected network"
    }
}
