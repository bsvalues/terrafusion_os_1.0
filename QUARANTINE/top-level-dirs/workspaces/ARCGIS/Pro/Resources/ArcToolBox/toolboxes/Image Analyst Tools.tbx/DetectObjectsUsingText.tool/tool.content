{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "app_ver": "13.4",
    "product": "100",
    "extensions": [
        "58",
        "86"
    ],
    "attributes": [
        "GPU"
    ],
    "params": {
        "input_raster_dataset": {
            "displayname": "$rc:input_raster_dataset.title",
            "datatype": {
                "type": "GPRasterLayer"
            }
        },
        "output_feature_class": {
            "direction": "out",
            "displayname": "$rc:output_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "class_name": {
            "type": "optional",
            "displayname": "$rc:class_name.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "box_threshold": {
            "type": "optional",
            "displayname": "$rc:box_threshold.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0.2"
        },
        "text_threshold": {
            "type": "optional",
            "displayname": "$rc:text_threshold.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0.2"
        }
    }
}
