{
    "type": "FunctionTool",
    "guid": "{0A4A9218-07A4-497A-8506-CED528063FB9}/CreateLRSIntersection",
    "displayname": "$rc:title",
    "helpcontent": "23000049",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "78"
    ],
    "params": {
        "parent_network": {
            "displayname": "$rc:parent_network.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:parent_network.descr"
        },
        "network_description_field": {
            "displayname": "$rc:network_description_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Text"
                ]
            },
            "depends": [
                "parent_network"
            ],
            "description": "$rc:network_description_field.descr"
        },
        "intersection_feature_class_name": {
            "displayname": "$rc:intersection_feature_class_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:intersection_feature_class_name.descr"
        },
        "intersecting_layers": {
            "displayname": "$rc:intersecting_layers.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPFeatureLayer",
                        "displayname": "$rc:intersecting_layers.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:intersecting_layers.dt.title2"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:intersecting_layers.dt.title3"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:intersecting_layers.dt.title4"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFeatureClassDomain",
                        "geometrytype": [
                            "Polyline",
                            "Polygon"
                        ]
                    },
                    {
                        "type": "GPCompositeDomain"
                    },
                    {
                        "type": "GPCompositeDomain"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:intersecting_layers.descr"
        },
        "consider_z": {
            "type": "optional",
            "displayname": "$rc:consider_z.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CONSIDER_Z"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_CONSIDER_Z"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:consider_z.descr"
        },
        "z_tolerance": {
            "type": "optional",
            "displayname": "$rc:z_tolerance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:z_tolerance.descr"
        },
        "out_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            }
        }
    }
}
