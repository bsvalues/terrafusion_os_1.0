{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "79040002",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "GPU",
        "mCPU"
    ],
    "params": {
        "in_cube": {
            "displayname": "$rc:in_cube.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "nc"
                ]
            },
            "description": "$rc:in_cube.descr"
        },
        "in_model_definition": {
            "displayname": "$rc:in_model_definition.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "emd",
                    "dlpk"
                ]
            },
            "description": "$rc:in_model_definition.descr"
        },
        "out_features": {
            "direction": "out",
            "displayname": "$rc:out_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_features.descr"
        },
        "number_of_timesteps_to_forecast": {
            "displayname": "$rc:number_of_timesteps_to_forecast.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "2",
            "description": "$rc:number_of_timesteps_to_forecast.descr"
        },
        "match_explanatory_variables": {
            "type": "optional",
            "displayname": "$rc:match_explanatory_variables.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPString",
                        "displayname": "$rc:match_explanatory_variables.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:match_explanatory_variables.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": " ",
                                "code": "$rc:match_explanatory_variables.domain.item1. "
                            }
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain"
                    }
                ]
            },
            "depends": [
                "in_cube"
            ],
            "description": "$rc:match_explanatory_variables.descr"
        },
        "out_cube": {
            "type": "optional",
            "direction": "out",
            "display_order": "3",
            "displayname": "$rc:out_cube.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "nc"
                ]
            },
            "description": "$rc:out_cube.descr"
        },
        "outlier_option": {
            "type": "optional",
            "displayname": "$rc:outlier_option.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NONE",
                        "code": "$rc:outlier_option.domain.NONE"
                    },
                    {
                        "value": "IDENTIFY",
                        "code": "$rc:outlier_option.domain.IDENTIFY"
                    }
                ]
            },
            "value": "NONE",
            "description": "$rc:outlier_option.descr"
        },
        "level_of_confidence": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:level_of_confidence.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "90%",
                        "code": "$rc:level_of_confidence.domain.90%"
                    },
                    {
                        "value": "95%",
                        "code": "$rc:level_of_confidence.domain.95%"
                    },
                    {
                        "value": "99%",
                        "code": "$rc:level_of_confidence.domain.99%"
                    }
                ]
            },
            "value": "90%",
            "description": "$rc:level_of_confidence.descr"
        },
        "maximum_number_of_outliers": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:maximum_number_of_outliers.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:maximum_number_of_outliers.descr"
        }
    },
    "environments": [
        "geographicTransformations",
        "gpuID",
        "outputCoordinateSystem",
        "processorType"
    ]
}
