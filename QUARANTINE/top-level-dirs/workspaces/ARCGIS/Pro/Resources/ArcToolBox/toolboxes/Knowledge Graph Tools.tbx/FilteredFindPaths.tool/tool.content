{
    "type": "FunctionTool",
    "displayname": "$rc:title",
    "description": "$rc:description",
    "product": "100",
    "tool_Validate2": "Extensions/KnowledgeGraph/KnowledgeGraphService.dll/ffp_Validate",
    "tool_Execute": "Extensions/KnowledgeGraph/KnowledgeGraphService.dll/ffp_Execute",
    "params": {
        "in_knowledge_graph_url": {
            "displayname": "$rc:in_knowledge_graph_url.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "config_type": {
            "type": "optional",
            "displayname": "$rc:config_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FILE",
                        "code": "$rc:config_type.domain.FILE"
                    },
                    {
                        "value": "STRING",
                        "code": "$rc:config_type.domain.STRING"
                    }
                ]
            },
            "value": "FILE"
        },
        "config_string": {
            "type": "optional",
            "displayname": "$rc:config_string.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "in_config_file": {
            "type": "optional",
            "displayname": "$rc:in_config_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "ffpcfg"
                ]
            }
        },
        "result_type": {
            "type": "optional",
            "displayname": "$rc:result_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FILE",
                        "code": "$rc:result_type.domain.FILE"
                    },
                    {
                        "value": "STRING",
                        "code": "$rc:result_type.domain.STRING"
                    }
                ]
            },
            "value": "FILE"
        },
        "out_results_string": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_results_string.title",
            "datatype": {
                "type": "GPString"
            }
        },
        "out_results_file": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_results_file.title",
            "datatype": {
                "type": "DEFile"
            }
        }
    }
}
