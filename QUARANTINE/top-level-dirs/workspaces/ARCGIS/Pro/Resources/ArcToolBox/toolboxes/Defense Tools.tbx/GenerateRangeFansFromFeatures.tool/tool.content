{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\GenerateRangeFansFromFeatures",
    "displayname": "$rc:title",
    "helpcontent": "74010004",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "output_feature_class": {
            "direction": "out",
            "displayname": "$rc:output_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "symbologylayer": "MT_RangeFanOutput.lyrx",
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_feature_class.descr"
        },
        "inner_radius_field": {
            "displayname": "$rc:inner_radius_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short",
                    "Double",
                    "Float"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:inner_radius_field.descr"
        },
        "outer_radius_field": {
            "displayname": "$rc:outer_radius_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short",
                    "Double",
                    "Float"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:outer_radius_field.descr"
        },
        "start_angle_field": {
            "displayname": "$rc:start_angle_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short",
                    "Double",
                    "Float"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:start_angle_field.descr"
        },
        "end_angle_field": {
            "displayname": "$rc:end_angle_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short",
                    "Double",
                    "Float"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:end_angle_field.descr"
        },
        "distance_units": {
            "type": "optional",
            "displayname": "$rc:distance_units.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "METERS",
                        "code": "$rc:distance_units.domain.METERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:distance_units.domain.KILOMETERS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:distance_units.domain.MILES"
                    },
                    {
                        "value": "NAUTICAL_MILES",
                        "code": "$rc:distance_units.domain.NAUTICAL_MILES"
                    },
                    {
                        "value": "FEET",
                        "code": "$rc:distance_units.domain.FEET"
                    },
                    {
                        "value": "US_SURVEY_FEET",
                        "code": "$rc:distance_units.domain.US_SURVEY_FEET"
                    }
                ]
            },
            "value": "METERS",
            "description": "$rc:distance_units.descr"
        },
        "angle_units": {
            "type": "optional",
            "displayname": "$rc:angle_units.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DEGREES",
                        "code": "$rc:angle_units.domain.DEGREES"
                    },
                    {
                        "value": "MILS",
                        "code": "$rc:angle_units.domain.MILS"
                    },
                    {
                        "value": "RADS",
                        "code": "$rc:angle_units.domain.RADS"
                    },
                    {
                        "value": "GRADS",
                        "code": "$rc:angle_units.domain.GRADS"
                    }
                ]
            },
            "value": "DEGREES",
            "description": "$rc:angle_units.descr"
        }
    },
    "environments": [
        "outputCoordinateSystem",
        "scratchWorkspace",
        "workspace"
    ]
}
