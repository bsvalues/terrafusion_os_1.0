{
    "map": {
        "description": "Performs a Boolean Not (complement) operation on the cell values of the input raster.",
        "in_raster_or_constant.descr": "<xdoc><p>The input to use in this Boolean operation.</p><p>To use a number as an input for this parameter, the cell size and extent must first be set in the environment.</p></xdoc>",
        "in_raster_or_constant.title": "Input raster or constant value",
        "out_raster.descr": "<xdoc><p>The output raster.</p><p>The output cell values will be either 0 or 1.</p></xdoc>",
        "out_raster.title": "Output raster",
        "summary": "<xdoc><p>Performs a Boolean Not (complement) operation on the cell values of the input raster.</p><p>If the input values are true (non-zero), the output value is 0. If the input values are false (zero), the output is 1.</p></xdoc>",
        "title": "Boolean Not"
    }
}
