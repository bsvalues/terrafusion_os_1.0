{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\OptimizedOutlierAnalysis",
    "displayname": "$rc:title",
    "helpcontent": "9030007",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Features": {
            "displayname": "$rc:input_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_features.descr"
        },
        "Output_Features": {
            "direction": "out",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "Analysis_Field": {
            "type": "optional",
            "displayname": "$rc:analysis_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "Input_Features"
            ],
            "description": "$rc:analysis_field.descr"
        },
        "Incident_Data_Aggregation_Method": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:incident_data_aggregation_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "COUNT_INCIDENTS_WITHIN_FISHNET_POLYGONS",
                        "code": "$rc:incident_data_aggregation_method.domain.COUNT_INCIDENTS_WITHIN_FISHNET_POLYGONS"
                    },
                    {
                        "value": "COUNT_INCIDENTS_WITHIN_HEXAGON_POLYGONS",
                        "code": "$rc:incident_data_aggregation_method.domain.COUNT_INCIDENTS_WITHIN_HEXAGON_POLYGONS"
                    },
                    {
                        "value": "COUNT_INCIDENTS_WITHIN_AGGREGATION_POLYGONS",
                        "code": "$rc:incident_data_aggregation_method.domain.COUNT_INCIDENTS_WITHIN_AGGREGATION_POLYGONS"
                    },
                    {
                        "value": "SNAP_NEARBY_INCIDENTS_TO_CREATE_WEIGHTED_POINTS",
                        "code": "$rc:incident_data_aggregation_method.domain.SNAP_NEARBY_INCIDENTS_TO_CREATE_WEIGHTED_POINTS"
                    }
                ]
            },
            "value": "COUNT_INCIDENTS_WITHIN_FISHNET_POLYGONS",
            "description": "$rc:incident_data_aggregation_method.descr"
        },
        "Bounding_Polygons_Defining_Where_Incidents_Are_Possible": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:bounding_polygons_defining_where_incidents_are_possible.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:bounding_polygons_defining_where_incidents_are_possible.descr"
        },
        "Polygons_For_Aggregating_Incidents_Into_Counts": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:polygons_for_aggregating_incidents_into_counts.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:polygons_for_aggregating_incidents_into_counts.descr"
        },
        "Performance_Adjustment": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:performance_adjustment.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "QUICK_199",
                        "code": "$rc:performance_adjustment.domain.QUICK_199"
                    },
                    {
                        "value": "BALANCED_499",
                        "code": "$rc:performance_adjustment.domain.BALANCED_499"
                    },
                    {
                        "value": "ROBUST_999",
                        "code": "$rc:performance_adjustment.domain.ROBUST_999"
                    }
                ]
            },
            "value": "BALANCED_499",
            "description": "$rc:performance_adjustment.descr"
        },
        "Cell_Size": {
            "type": "optional",
            "displayname": "$rc:cell_size.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Meters",
                    "Kilometers",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:cell_size.descr"
        },
        "Distance_Band": {
            "type": "optional",
            "displayname": "$rc:distance_band.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Meters",
                    "Kilometers",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:distance_band.descr"
        }
    },
    "environments": [
        "MResolution",
        "MTolerance",
        "XYResolution",
        "XYTolerance",
        "ZResolution",
        "ZTolerance",
        "geographicTransformations",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "qualifiedFieldNames",
        "randomGenerator",
        "scratchWorkspace",
        "workspace"
    ]
}
