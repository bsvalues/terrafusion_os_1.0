{
    "map": {
        "airplane_design_group.descr": "<xdoc><p>Specifies the airplane design group that will be used to generate surfaces.</p><ul><li><span title=\"I\">I</span>—The airplane design group I will be used.</li><li><span title=\"IIA\">IIA</span>—The airplane design group IIA will be used.</li><li><span title=\"IIB\">IIB</span>—The airplane design group IIB will be used.</li><li><span title=\"IIC\">IIC</span>—The airplane design group IIC will be used.</li><li><span title=\"III\">III</span>—The airplane design group III will be used.</li><li><span title=\"IV\">IV</span>—The airplane design group IV will be used.</li><li><span title=\"V\">V</span>—The airplane design group V will be used.</li></ul></xdoc>",
        "airplane_design_group.domain.I": "I",
        "airplane_design_group.domain.IIA": "IIA",
        "airplane_design_group.domain.IIB": "IIB",
        "airplane_design_group.domain.IIC": "IIC",
        "airplane_design_group.domain.III": "III",
        "airplane_design_group.domain.IV": "IV",
        "airplane_design_group.domain.V": "V",
        "airplane_design_group.title": "Airplane Design Group",
        "airport_control_point_feature_class.descr": "Supplies x-, y-, and z-geometry for displaced threshold features. If displaced thresholds are included, surfaces will be constructed based on their x-, y-, and z-geometry instead of their corresponding runway feature endpoint.",
        "airport_control_point_feature_class.title": "Input Airport Control Point Feature",
        "airport_elevation.descr": "<xdoc><p>The highest elevation on any of the runways of the airport. The value must be in the vertical coordinate system linear units of the target feature class. If no value is provided, the highest point from the <span class=\"esri_uicontrol\">Input Runway Features</span> parameter value will be used.</p></xdoc>",
        "airport_elevation.title": "Airport Elevation",
        "custom_json_file.descr": "The import configuration, in JSON format, that will be used to create the custom OIS.",
        "custom_json_file.title": "Custom JSON File",
        "derived_outfeatureclass.title": "Output OIS Features",
        "description": "Creates obstacle-free surfaces (OFS) and obstacle evaluation surfaces (OES) based on ICAO Annex 14 OFS OES specifications.\nThese surfaces define the airspace around aerodromes to be free of obstacles and safeguard airspace so flight operations can be performed safely. This tool creates surfaces as a polygon or multipatch features.",
        "highend_clear_way_length.descr": "The length of the area at the high end of the runway. The unit of measurement is based on the input runway features.",
        "highend_clear_way_length.title": "Length of High Runway End Clearway",
        "in_features.descr": "The input runway dataset. The feature class must be z-enabled and contain polylines.",
        "in_features.title": "Input Runway Features",
        "include_merged_surface.descr": "<xdoc><p>Specifies whether merged surfaces will be generated.</p><ul><li>Checked—All the surfaces will be generated for the merged surfaces, as well as merged conical and horizontal surfaces. This is the default.</li><li>Unchecked—Surfaces will not be generated for the merged surfaces.</li></ul></xdoc>",
        "include_merged_surface.title": "Include Merged Surfaces",
        "lowend_clear_way_length.descr": "The length of the area at the low end of the runway. The unit of measurement is based on the input runway features.",
        "lowend_clear_way_length.title": "Length of Low Runway End Clearway",
        "runway_direction.descr": "<xdoc><p>Specifies the end of the runway where the approach surface will be created.</p><ul><li><span title=\"HIGH_END_TO_LOW_END\">High end to low end</span>—The approach surface will be created at the high end of the runway to the low end. If a displaced threshold point exists at the high end of the runway, that point will be honored when creating the OIS.</li><li><span title=\"LOW_END_TO_HIGH_END\">Low end to high end</span>—The approach surface will be created at the low end of the runway to the high end. If a displaced threshold point exists at the low end of the runway, that point will be honored when creating the OIS.</li><li><span title=\"BOTH_END\">Both ends</span>—The approach surface will be created at both the low end and high end of the runway.</li></ul></xdoc>",
        "runway_direction.domain.BOTH_END": "Both ends",
        "runway_direction.domain.HIGH_END_TO_LOW_END": "High end to low end",
        "runway_direction.domain.LOW_END_TO_HIGH_END": "Low end to high end",
        "runway_direction.title": "Runway Direction",
        "runway_type.descr": "<xdoc><p>Specifies the classification of the runway.</p><ul><li><span title=\"NON_INSTRUMENT_RUNWAY\">Non instrument runway</span>—This runway classification intended for the operation of aircraft using visual approach procedures.</li><li><span title=\"NON_PRECISION_INSTRUMENT_RUNWAY\">Non precision instrument runway</span>—This runway classification is designed for a nonprecision instrument approach procedure.</li><li><span title=\"PRECISION_INSTRUMENT_RUNWAY\">Precision instrument runway</span>—This runway classification is designed for an instrument approach procedure.</li></ul></xdoc>",
        "runway_type.domain.NON_INSTRUMENT_RUNWAY": "Non instrument runway",
        "runway_type.domain.NON_PRECISION_INSTRUMENT_RUNWAY": "Non precision instrument runway",
        "runway_type.domain.PRECISION_INSTRUMENT_RUNWAY": "Precision instrument runway",
        "runway_type.title": "Runway Classification",
        "summary": "Creates obstacle-free surfaces (OFS) and obstacle evaluation surfaces (OES) based on ICAO Annex 14 OFS OES specifications. These surfaces define the airspace around aerodromes to be free of obstacles and safeguard airspace so flight operations can be performed safely. This tool creates surfaces as a polygon or multipatch features.",
        "surfaces_to_generate.descr": "<xdoc><p>Specifies the type of surface that will be generated.</p><ul><li><span title=\"OBSTACLE_FREE_SURFACES\">Obstacle free surfaces</span>—An OFS will be generated. This provides a free volume of airspace in critical surroundings of the runway.</li><li><span title=\"OBSTACLE_EVALUATION_SURFACES\">Obstacle evaluation surfaces</span>—An OES will be generated. This provides the volume of airspace where obstacles could impact the operations and where their impact needs to be evaluated.</li></ul></xdoc>",
        "surfaces_to_generate.domain.OBSTACLE_EVALUATION_SURFACES": "Obstacle evaluation surfaces",
        "surfaces_to_generate.domain.OBSTACLE_FREE_SURFACES": "Obstacle free surfaces",
        "surfaces_to_generate.title": "Surfaces to Generate",
        "target.descr": "The target feature class that will contain the generated OIS.",
        "target.title": "Target OIS Features",
        "title": "ICAO Annex 14 OFS OES"
    }
}
