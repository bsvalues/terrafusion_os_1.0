{
    "type": "FunctionTool",
    "guid": "{ac5950bc-cb1c-403b-bfd8-8b8b738cf9d3}",
    "displayname": "$rc:title",
    "helpcontent": "3050030",
    "description": "$rc:description",
    "product": "200",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline",
                    "Polygon"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "geodetic_type": {
            "displayname": "$rc:geodetic_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "GEODESIC",
                        "code": "$rc:geodetic_type.domain.GEODESIC"
                    },
                    {
                        "value": "LOXODROME",
                        "code": "$rc:geodetic_type.domain.LOXODROME"
                    },
                    {
                        "value": "GREAT_ELLIPTIC",
                        "code": "$rc:geodetic_type.domain.GREAT_ELLIPTIC"
                    },
                    {
                        "value": "NORMAL_SECTION",
                        "code": "$rc:geodetic_type.domain.NORMAL_SECTION"
                    }
                ]
            },
            "value": "GEODESIC",
            "description": "$rc:geodetic_type.descr"
        },
        "distance": {
            "type": "optional",
            "displayname": "$rc:distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_features"
            ],
            "value": "50 Kilometers",
            "description": "$rc:distance.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue"
    ]
}
