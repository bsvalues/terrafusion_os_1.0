{
    "map": {
        "custom_json_file.descr": "The import configuration, in JSON format, that will be used to create the custom OIS.",
        "custom_json_file.title": "Custom JSON File",
        "derived_outfeatureclass.title": "Output OIS Features",
        "description": "Creates obstruction identification surfaces (OIS) based on the FAA Advisory Circular 150/5300-13A specification. These primary and approach surfaces are designed to determine which objects are vertical obstructions and are used to support planning and design activities. The type, function, and dimension of a surface differ by its runway classification. This tool creates surfaces as a polygon or multipatch features.",
        "generate_clearway_surfaces.descr": "<xdoc><p>Specifies whether a clearway surface will be generated for departure runways. Clearway surfaces will only be generated if a value has been specified for the <span class=\"esri_uicontrol\">Generate Departure Surfaces</span> parameter.</p><ul><li>Checked—A clearway surface will be generated.</li><li>Unchecked—A clearway surface will not be generated. This is the default.</li></ul></xdoc>",
        "generate_clearway_surfaces.title": "Generate Clearway Surfaces",
        "generate_departure_surfaces.descr": "<xdoc><p>Specifies whether a departure surface will be generated for departure runways.</p><ul><li><span title=\"GENERATE_DEPARTURE_SURFACE_AT_BOTH_ENDS\">Generate Departure Surface at Both Ends</span>—A departure surface will be generated at both ends of the runway.</li><li><span title=\"GENERATE_DEPARTURE_SURFACE_AT_HIGH_END\">Generate Departure Surface at High End</span>—A departure surface will be generated at the high end of the runway.</li><li><span title=\"GENERATE_DEPARTURE_SURFACE_AT_LOW_END\">Generate Departure Surface at Low End</span>—A departure surface will be generated at the low end of the runway.</li><li><span title=\"DO_NOT_GENERATE_DEPARTURE_SURFACE\">Do Not Generate Departure Surface</span>—A departure surface will not be generated.</li></ul></xdoc>",
        "generate_departure_surfaces.domain.DO_NOT_GENERATE_DEPARTURE_SURFACE": "Do Not Generate Departure Surface",
        "generate_departure_surfaces.domain.GENERATE_DEPARTURE_SURFACE_AT_BOTH_ENDS": "Generate Departure Surface at Both Ends",
        "generate_departure_surfaces.domain.GENERATE_DEPARTURE_SURFACE_AT_HIGH_END": "Generate Departure Surface at High End",
        "generate_departure_surfaces.domain.GENERATE_DEPARTURE_SURFACE_AT_LOW_END": "Generate Departure Surface at Low End",
        "generate_departure_surfaces.title": "Generate Departure Surfaces",
        "high_runway_end_type.descr": "<xdoc><p>Specifies the classification of the high end of the runway.</p><ul><li><span title=\"SMALL_AIRPLANE_APPROACH_SPEEDS_LT_50\">Small airplanes approach speeds less than 50 knots</span>—This runway classification is designed for light aircraft with a maximum takeoff weight of less than 254 pounds and approach speed less than 50 knots. This is a visual runway only that can be used during the day or night.</li><li><span title=\"SMALL_AIRPLANE_APPROACH_SPEEDS_GT_50\">Small airplanes approach speeds 50 knots or more</span>—This runway classification is designed for light aircraft with a maximum takeoff weight of less than 1,320 pounds and approach speed more than 50 knots. This is a visual runway only that can be used during the day or night.</li><li><span title=\"LARGE_AIRPLANE_VISUAL_RUNWAY_DAY_NIGHT\">Large airplanes for visual runways only, day or night</span>— This runway classification is designed for aircraft with a maximum certified takeoff weight of more than 12,500 pounds. The approach end of the runway is expected to serve large airplanes as a visual runway available day or night, or instrument approach with a minimum greater than one statute mile (1.6 kilometers) only during the day.</li><li><span title=\"INSTRUMENT_GT_EQ_3/4_MILE\">Instrument approach visibility greater than or equal to 3/4 mile</span>— This runway classification is designed for an instrument approach procedure where the visibility is greater than (&gt;) three-fourths of a mile and less than one mile. The approach end of the runway is expected to accommodate instrument approaches with visible minimums more than three-fourths but less than 1 statute mile (1.2 &lt; 1.6 kilometers) during day or night.</li><li><span title=\"INSTRUMENT_LT_3/4_MILE_VISIBILITY\">Instrument approach less than 3/4 mile visibility</span>— This runway classification&apos;s course and vertical path guidance are provided with visibility less than (&lt;) three-fourths of a mile. The approach end of the runway is expected to accommodate instrument approaches with visibility minimum less than three-fourths of a statute mile (1.2 kilometers) or precision approach (Instrument landing System [ILS] or Global Navigation Satellite System [GNSS] Landing System [GLS]) day or night.</li><li><span title=\"VERTICAL_GUIDANCE_APPROACH\">Vertical guidance approach</span>— This runway classification uses precision guidance systems to support aircraft approach and landing. The approach of the runway is expected to accommodate approaches with vertical guidance such as a Glide Path Qualification Surface (GPQS).</li></ul></xdoc>",
        "high_runway_end_type.domain.INSTRUMENT_GT_EQ_3¦4_MILE": "Instrument approach visibility greater than or equal to 3/4 mile",
        "high_runway_end_type.domain.INSTRUMENT_LT_3¦4_MILE_VISIBILITY": "Instrument approach less than 3/4 mile visibility",
        "high_runway_end_type.domain.LARGE_AIRPLANE_VISUAL_RUNWAY_DAY_NIGHT": "Large airplanes for visual runways only, day or night",
        "high_runway_end_type.domain.SMALL_AIRPLANE_APPROACH_SPEEDS_GT_50": "Small airplanes approach speeds 50 knots or more",
        "high_runway_end_type.domain.SMALL_AIRPLANE_APPROACH_SPEEDS_LT_50": "Small airplanes approach speeds less than 50 knots",
        "high_runway_end_type.domain.VERTICAL_GUIDANCE_APPROACH": "Vertical guidance approach",
        "high_runway_end_type.title": "High Runway End Classification",
        "in_features.descr": "The input runway dataset. The feature class must be z-enabled and contain polylines.",
        "in_features.title": "Input Runway Features",
        "low_runway_end_type.descr": "<xdoc><p>Specifies the classification of the low end of the runway.</p><ul><li><span title=\"SAME_AS_HIGH_RUNWAY_END_CLASSIFICATION\">The low runway end is the same as the high runway end classification</span>—Same as high runway end classification</li><li><span title=\"SMALL_AIRPLANE_APPROACH_SPEEDS_LT_50\">Small airplanes approach speeds less than 50 knots</span>—This runway classification is designed for light aircraft with a maximum takeoff weight of less than 254 pounds and approach speed less than 50 knots. This is a visual runway only that can be used during the day or night.</li><li><span title=\"SMALL_AIRPLANE_APPROACH_SPEEDS_GT_50\">Small airplanes approach speeds 50 knots or more</span>—This runway classification is designed for light aircraft with a maximum takeoff weight of less than 1,320 pounds and approach speed more than 50 knots. This is a visual runway only that can be used during the day or night.</li><li><span title=\"LARGE_AIRPLANE_VISUAL_RUNWAY_DAY_NIGHT\">Large airplanes for visual runways only, day or night</span>— This runway classification is designed for aircraft with a maximum certified takeoff weight of more than 12,500 pounds. The approach end of the runway is expected to serve large airplanes as a visual runway available day or night, or instrument approach with a minimum greater than one statute mile (1.6 kilometers) only during the day.</li><li><span title=\"INSTRUMENT_GT_EQ_3/4_MILE\">Instrument approach visibility greater than or equal to 3/4 mile</span>—This runway classification is designed for an instrument approach procedure where the visibility is greater than (&gt;) three-fourths of a mile and less than one mile. The approach end of the runway is expected to accommodate instrument approaches with visible minimums more than three-fourths but less than 1 statute mile (1.2 &lt; 1.6 kilometers) during day or night.</li><li><span title=\"INSTRUMENT_LT_3/4_MILE_VISIBILITY\">Instrument approach less than 3/4 mile visibility</span>— This runway classification&apos;s course and vertical path guidance are provided with visibility less than (&lt;) three-fourths of a mile. The approach end of the runway is expected to accommodate instrument approaches with visibility minimum less than three-fourths of a statute mile (1.2 kilometers) or precision approach (Instrument landing System [ILS] or Global Navigation Satellite System [GNSS] Landing System [GLS]) day or night.</li><li><span title=\"VERTICAL_GUIDANCE_APPROACH\">Vertical guidance approach</span>— This runway classification uses precision guidance systems to support aircraft approach and landing. The approach of the runway is expected to accommodate approaches with vertical guidance such as a Glide Path Qualification Surface (GPQS).</li></ul></xdoc>",
        "low_runway_end_type.domain.INSTRUMENT_GT_EQ_3¦4_MILE": "Instrument approach visibility greater than or equal to 3/4 mile",
        "low_runway_end_type.domain.INSTRUMENT_LT_3¦4_MILE_VISIBILITY": "Instrument approach less than 3/4 mile visibility",
        "low_runway_end_type.domain.LARGE_AIRPLANE_VISUAL_RUNWAY_DAY_NIGHT": "Large airplanes for visual runways only, day or night",
        "low_runway_end_type.domain.SAME_AS_HIGH_RUNWAY_END_CLASSIFICATION": "The low runway end is the same as the high runway end classification",
        "low_runway_end_type.domain.SMALL_AIRPLANE_APPROACH_SPEEDS_GT_50": "Small airplanes approach speeds 50 knots or more",
        "low_runway_end_type.domain.SMALL_AIRPLANE_APPROACH_SPEEDS_LT_50": "Small airplanes approach speeds less than 50 knots",
        "low_runway_end_type.domain.VERTICAL_GUIDANCE_APPROACH": "Vertical guidance approach",
        "low_runway_end_type.title": "Low Runway End Classification",
        "summary": "<xdoc><p>Creates obstruction identification surfaces (OIS) based on the FAA Advisory Circular 150/5300-13A specification. These primary and approach surfaces are designed to determine which objects are vertical obstructions and are used to support planning and design activities. The type, function, and dimension of a surface differ by its runway classification. This tool creates surfaces as a polygon or multipatch features.</p><note type=\"legacy\"/><p group=\"note\">This is a deprecated tool. This functionality has been replaced by the FAA 13 tool that creates obstruction identification surfaces (OIS) based on the FAA Advisory Circular AC150/5300-13B specification.</p></xdoc>",
        "target_ois_features.descr": "The target feature class that will contain the generated OIS.",
        "target_ois_features.title": "Target OIS Features",
        "threshold_point_feature_class.descr": "The input threshold point dataset. The feature class must be z-enabled.",
        "threshold_point_feature_class.title": "Input Threshold Point Features",
        "title": "FAA 13A Surfaces"
    }
}
