{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "8020004",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "10"
    ],
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_features_numerator": {
            "display_order": "0",
            "displayname": "$rc:in_features_numerator.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features_numerator.descr"
        },
        "in_features_denominator": {
            "display_order": "1",
            "displayname": "$rc:in_features_denominator.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features_denominator.descr"
        },
        "population_field_numerator": {
            "display_order": "2",
            "displayname": "$rc:population_field_numerator.title",
            "datatype": {
                "type": "Field"
            },
            "depends": [
                "in_features_numerator"
            ],
            "description": "$rc:population_field_numerator.descr"
        },
        "population_field_denominator": {
            "display_order": "3",
            "displayname": "$rc:population_field_denominator.title",
            "datatype": {
                "type": "Field"
            },
            "depends": [
                "in_features_denominator"
            ],
            "description": "$rc:population_field_denominator.descr"
        },
        "out_raster": {
            "direction": "out",
            "display_order": "4",
            "displayname": "$rc:out_raster.title",
            "datatype": {
                "type": "DERasterDataset"
            },
            "schema": {
                "type": "GPRasterSchema",
                "extenttype.rule": "Environment",
                "cellsize.rule": "Environment",
                "raster.rule": "FirstDependency",
                "rasterformat.rule": "IMG",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_raster.descr"
        },
        "cell_size": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:cell_size.title",
            "datatype": {
                "type": "analysis_cell_size"
            },
            "description": "$rc:cell_size.descr"
        },
        "search_radius_numerator": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:search_radius_numerator.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:search_radius_numerator.descr"
        },
        "search_radius_denominator": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:search_radius_denominator.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:search_radius_denominator.descr"
        },
        "out_cell_values": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:out_cell_values.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DENSITIES",
                        "code": "$rc:out_cell_values.domain.DENSITIES"
                    },
                    {
                        "value": "EXPECTED_COUNTS",
                        "code": "$rc:out_cell_values.domain.EXPECTED_COUNTS"
                    }
                ]
            },
            "value": "DENSITIES",
            "description": "$rc:out_cell_values.descr"
        },
        "method": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PLANAR",
                        "code": "$rc:method.domain.PLANAR"
                    },
                    {
                        "value": "GEODESIC",
                        "code": "$rc:method.domain.GEODESIC"
                    }
                ]
            },
            "value": "PLANAR",
            "description": "$rc:method.descr"
        },
        "in_barriers_numerator": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:in_barriers_numerator.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_barriers_numerator.descr"
        },
        "in_barriers_denominator": {
            "type": "optional",
            "display_order": "11",
            "displayname": "$rc:in_barriers_denominator.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_barriers_denominator.descr"
        }
    },
    "environments": [
        "autoCommit",
        "cellSize",
        "cellSizeProjectionMethod",
        "configKeyword",
        "extent",
        "geographicTransformations",
        "mask",
        "outputCoordinateSystem",
        "parallelProcessingFactor",
        "scratchWorkspace",
        "snapRaster",
        "tileSize",
        "workspace"
    ]
}
