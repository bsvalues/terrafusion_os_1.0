{
    "map": {
        "base_contour.descr": "Defines the starting Z value from which the contour interval is either added or subtracted to delineate contours. The default value is 0.0.",
        "base_contour.title": "Base Contour",
        "contour_field.descr": "The field that stores the contour value associated with each line in the output feature class.",
        "contour_field.title": "Contour Field",
        "contour_field_precision.descr": "The precision of the contour field. Zero specifies an integer, and the numbers 1–9 indicate how many decimal places the field will contain. By default, the field will be an integer (0).",
        "contour_field_precision.title": "Contour Field Precision",
        "description": "Creates contour lines derived from a terrain, TIN, or LAS dataset surface.",
        "in_surface.descr": "The TIN, terrain, or LAS dataset surface that will be processed.",
        "in_surface.title": "Input Surface",
        "index_interval.descr": "<xdoc><p>Index contours are commonly used as a cartographic aid for assisting in the visualization of contour lines. The index interval is typically five times larger than the contour interval. Use of this parameter adds an integer field defined by the <span class=\"esri_uicontrol\">Index Interval Field</span> to the attribute table of the output feature class, where a value of 1 denotes the index contours.</p></xdoc>",
        "index_interval.title": "Index Interval",
        "index_interval_field.descr": "<xdoc><p>The name of the field used to identify index contours. This will only be used if the <span class=\"esri_uicontrol\">Index Interval</span> is defined. By default, the field name is <span class=\"esri_fieldname\">Index</span>.</p></xdoc>",
        "index_interval_field.title": "Index Interval Field",
        "interval.descr": "The interval between the contours.",
        "interval.title": "Contour Interval",
        "out_feature_class.descr": "The feature class that will be produced.",
        "out_feature_class.title": "Output Feature Class",
        "pyramid_level_resolution.descr": "The z-tolerance or window-size resolution of the terrain pyramid level that will be used. The default is 0, or full resolution.",
        "pyramid_level_resolution.title": "Pyramid Level Resolution",
        "title": "Surface Contour",
        "z_factor.descr": "The factor by which z-values will be multiplied. This is typically used to convert z linear units to match x,y linear units. The default is 1, which leaves elevation values unchanged. This parameter is not available if the spatial reference of the input surface has a z-datum with a specified linear unit.",
        "z_factor.title": "Z Factor"
    }
}
