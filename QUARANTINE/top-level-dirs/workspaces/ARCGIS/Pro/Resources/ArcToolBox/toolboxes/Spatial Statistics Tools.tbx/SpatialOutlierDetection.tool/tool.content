{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\SpatialOutlierDetection",
    "displayname": "$rc:title",
    "helpcontent": "9030012",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "output_features": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "n_neighbors": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:n_neighbors.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "1",
            "description": "$rc:n_neighbors.descr"
        },
        "percent_outlier": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:percent_outlier.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1.0000000000000001e-05",
                "max": "50"
            },
            "description": "$rc:percent_outlier.descr"
        },
        "output_raster": {
            "type": "optional",
            "direction": "out",
            "display_order": "7",
            "displayname": "$rc:output_raster.title",
            "datatype": {
                "type": "DERasterDataset"
            },
            "schema": {
                "type": "GPRasterSchema",
                "extenttype.rule": "Environment",
                "cellsize.rule": "Environment",
                "raster.rule": "FirstDependency",
                "rasterformat.rule": "IMG",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_raster.descr"
        },
        "outlier_type": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:outlier_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "GLOBAL",
                        "code": "$rc:outlier_type.domain.GLOBAL"
                    },
                    {
                        "value": "LOCAL",
                        "code": "$rc:outlier_type.domain.LOCAL"
                    }
                ]
            },
            "value": "GLOBAL",
            "description": "$rc:outlier_type.descr"
        },
        "sensitivity": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:sensitivity.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "LOW",
                        "code": "$rc:sensitivity.domain.LOW"
                    },
                    {
                        "value": "MEDIUM",
                        "code": "$rc:sensitivity.domain.MEDIUM"
                    },
                    {
                        "value": "HIGH",
                        "code": "$rc:sensitivity.domain.HIGH"
                    }
                ]
            },
            "value": "MEDIUM",
            "description": "$rc:sensitivity.descr"
        },
        "keep_type": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:keep_type.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "KEEP_OUTLIER"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "KEEP_ALL"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:keep_type.descr"
        }
    },
    "environments": [
        "cellSize",
        "extent",
        "mask",
        "outputCoordinateSystem",
        "parallelProcessingFactor",
        "snapRaster"
    ]
}
