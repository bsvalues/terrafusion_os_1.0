{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "46000002",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "params": {
        "job_id": {
            "displayname": "$rc:job_id.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:job_id.descr"
        },
        "source_path": {
            "displayname": "$rc:source_path.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:source_path.descr"
        },
        "target_path": {
            "displayname": "$rc:target_path.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:target_path.descr"
        },
        "archive_source": {
            "type": "optional",
            "displayname": "$rc:archive_source.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ARCHIVE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_ARCHIVE"
                    }
                ]
            },
            "description": "$rc:archive_source.descr"
        },
        "delete_source": {
            "type": "optional",
            "displayname": "$rc:delete_source.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DELETE_SOURCE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_DELETE_SOURCE"
                    }
                ]
            },
            "description": "$rc:delete_source.descr"
        },
        "create_job_folder": {
            "type": "optional",
            "displayname": "$rc:create_job_folder.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE_JOB_FOLDER"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_CREATE_JOB_FOLDER"
                    }
                ]
            },
            "description": "$rc:create_job_folder.descr"
        },
        "database_path": {
            "type": "optional",
            "displayname": "$rc:database_path.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "jtc"
                ]
            },
            "description": "$rc:database_path.descr"
        },
        "updated_job_id": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_job_id.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "-1"
        }
    }
}
