{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\LeastCostPath",
    "displayname": "$rc:title",
    "helpcontent": "73030002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_cost_surface": {
            "displayname": "$rc:in_cost_surface.title",
            "datatype": {
                "type": "GPRasterLayer"
            },
            "description": "$rc:in_cost_surface.descr"
        },
        "in_start_point": {
            "displayname": "$rc:in_start_point.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_start_point.descr"
        },
        "in_end_point": {
            "displayname": "$rc:in_end_point.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_end_point.descr"
        },
        "out_path_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_path_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_path_feature_class.descr"
        },
        "handle_zeros": {
            "type": "optional",
            "displayname": "$rc:handle_zeros.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SMALL_POSITIVE",
                        "code": "$rc:handle_zeros.domain.SMALL_POSITIVE"
                    },
                    {
                        "value": "NO_DATA",
                        "code": "$rc:handle_zeros.domain.NO_DATA"
                    }
                ]
            },
            "value": "SMALL_POSITIVE",
            "description": "$rc:handle_zeros.descr"
        },
        "out_start_point": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_start_point.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "out_end_point": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_end_point.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    }
}
