{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "2210002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_gpx_file": {
            "direction": "out",
            "displayname": "$rc:out_gpx_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "gpx"
                ]
            },
            "description": "$rc:out_gpx_file.descr"
        },
        "name_field": {
            "type": "optional",
            "displayname": "$rc:name_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Double",
                    "GlobalID",
                    "GUID",
                    "Long",
                    "OID",
                    "Float",
                    "Short",
                    "Text"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:name_field.descr"
        },
        "description_field": {
            "type": "optional",
            "displayname": "$rc:description_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Double",
                    "GlobalID",
                    "GUID",
                    "Long",
                    "OID",
                    "Float",
                    "Short",
                    "Text"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:description_field.descr"
        },
        "z_field": {
            "type": "optional",
            "displayname": "$rc:z_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Double"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:z_field.descr"
        },
        "date_field": {
            "type": "optional",
            "displayname": "$rc:date_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Date"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:date_field.descr"
        }
    },
    "environments": [
        "extent",
        "scratchWorkspace",
        "workspace"
    ]
}
