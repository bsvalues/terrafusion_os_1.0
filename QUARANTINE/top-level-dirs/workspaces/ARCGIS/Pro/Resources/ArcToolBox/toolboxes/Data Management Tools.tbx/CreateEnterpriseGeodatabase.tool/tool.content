{
    "type": "FunctionTool",
    "guid": "{f6614324-fd19-4c50-81f6-20069f15341b}",
    "displayname": "$rc:title",
    "helpcontent": "3010010",
    "description": "$rc:description",
    "product": "200",
    "params": {
        "database_platform": {
            "displayname": "$rc:database_platform.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SQL_Server",
                        "code": "$rc:database_platform.domain.SQL_Server"
                    },
                    {
                        "value": "PostgreSQL",
                        "code": "$rc:database_platform.domain.PostgreSQL"
                    },
                    {
                        "value": "Oracle",
                        "code": "$rc:database_platform.domain.Oracle"
                    }
                ]
            },
            "value": "SQL_Server",
            "description": "$rc:database_platform.descr"
        },
        "instance_name": {
            "displayname": "$rc:instance_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:instance_name.descr"
        },
        "database_name": {
            "type": "optional",
            "displayname": "$rc:database_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:database_name.descr"
        },
        "account_authentication": {
            "type": "optional",
            "displayname": "$rc:account_authentication.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "OPERATING_SYSTEM_AUTH"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DATABASE_AUTH"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:account_authentication.descr"
        },
        "database_admin": {
            "type": "optional",
            "displayname": "$rc:database_admin.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "sa",
            "description": "$rc:database_admin.descr"
        },
        "database_admin_password": {
            "type": "optional",
            "displayname": "$rc:database_admin_password.title",
            "datatype": {
                "type": "GPEncryptedString"
            },
            "description": "$rc:database_admin_password.descr"
        },
        "sde_schema": {
            "type": "optional",
            "displayname": "$rc:sde_schema.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "SDE_SCHEMA"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DBO_SCHEMA"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:sde_schema.descr"
        },
        "gdb_admin_name": {
            "type": "optional",
            "displayname": "$rc:gdb_admin_name.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "sde",
            "description": "$rc:gdb_admin_name.descr"
        },
        "gdb_admin_password": {
            "type": "optional",
            "displayname": "$rc:gdb_admin_password.title",
            "datatype": {
                "type": "GPEncryptedString"
            },
            "description": "$rc:gdb_admin_password.descr"
        },
        "tablespace_name": {
            "type": "optional",
            "displayname": "$rc:tablespace_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:tablespace_name.descr"
        },
        "authorization_file": {
            "control_guid": "{F618CB52-29AE-49C8-BF32-9845F642276B}",
            "displayname": "$rc:authorization_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "description": "$rc:authorization_file.descr"
        },
        "out_result": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_result.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "value": "false"
        },
        "spatial_type": {
            "type": "optional",
            "displayname": "$rc:spatial_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ST_GEOMETRY",
                        "code": "$rc:spatial_type.domain.ST_GEOMETRY"
                    },
                    {
                        "value": "POSTGIS",
                        "code": "$rc:spatial_type.domain.POSTGIS"
                    }
                ]
            },
            "description": "$rc:spatial_type.descr"
        }
    }
}
