{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "22040001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Web_Map_as_JSON": {
            "displayname": "$rc:web_map_as_json.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:web_map_as_json.descr"
        },
        "Output_File": {
            "direction": "out",
            "displayname": "$rc:output_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "description": "$rc:output_file.descr"
        },
        "Format": {
            "type": "optional",
            "displayname": "$rc:format.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PDF",
                        "code": "$rc:format.domain.PDF"
                    },
                    {
                        "value": "PNG32",
                        "code": "$rc:format.domain.PNG32"
                    },
                    {
                        "value": "PNG8",
                        "code": "$rc:format.domain.PNG8"
                    },
                    {
                        "value": "JPG",
                        "code": "$rc:format.domain.JPG"
                    },
                    {
                        "value": "GIF",
                        "code": "$rc:format.domain.GIF"
                    },
                    {
                        "value": "EPS",
                        "code": "$rc:format.domain.EPS"
                    },
                    {
                        "value": "SVG",
                        "code": "$rc:format.domain.SVG"
                    },
                    {
                        "value": "SVGZ",
                        "code": "$rc:format.domain.SVGZ"
                    },
                    {
                        "value": "AIX",
                        "code": "$rc:format.domain.AIX"
                    },
                    {
                        "value": "TIFF",
                        "code": "$rc:format.domain.TIFF"
                    }
                ]
            },
            "value": "PDF",
            "description": "$rc:format.descr"
        },
        "Layout_Templates_Folder": {
            "type": "optional",
            "displayname": "$rc:layout_templates_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:layout_templates_folder.descr"
        },
        "Layout_Template": {
            "type": "optional",
            "displayname": "$rc:layout_template.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:layout_template.descr"
        },
        "Layout_Item_ID": {
            "type": "optional",
            "displayname": "$rc:layout_item_id.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:layout_item_id.descr"
        },
        "Report_Template": {
            "type": "optional",
            "displayname": "$rc:report_template.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:report_template.descr"
        },
        "Report_Item_ID": {
            "type": "optional",
            "displayname": "$rc:report_item_id.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:report_item_id.descr"
        }
    }
}
