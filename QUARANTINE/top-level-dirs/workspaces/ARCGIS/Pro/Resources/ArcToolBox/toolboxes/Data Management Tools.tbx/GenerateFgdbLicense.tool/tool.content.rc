{
    "map": {
        "allow_export.descr": "<xdoc><p>Specifies whether the export of vector data will be allowed.</p><ul><li><span title=\"DENY_EXPORT\">Vector data cannot be exported</span>—Vector data cannot be exported with the data license file (.sdlic) installed. This is the default.</li><li><span title=\"ALLOW_EXPORT\">Allow export of vector data</span>— Vector data can be exported with the data license file (.sdlic) installed.</li></ul></xdoc>",
        "allow_export.domain.ALLOW_EXPORT": "Allow export of vector data",
        "allow_export.domain.DENY_EXPORT": "Vector data cannot be exported",
        "allow_export.title": "Allow Export of Vector Data",
        "description": "Generates a license file (.sdlic) for displaying the contents in a licensed file geodatabase created by the Generate Licensed File Geodatabase tool.",
        "exp_date.descr": "The expiration date of the data license file, after which the file geodatabase’s contents can no longer be displayed. The default value is empty (blank), which means the data license file will never expire.",
        "exp_date.title": "Expiration Date",
        "in_lic_def_file.descr": "The license definition file (.licdef) created by the Generate Licensed File Geodatabase tool.",
        "in_lic_def_file.title": "Input License Definition File",
        "out_lic_file.descr": "The license file (.sdlic) for distribution.",
        "out_lic_file.title": "Output Data License File",
        "summary": "<xdoc><p>Generates a license file (.sdlic) for displaying the contents in a licensed file geodatabase created by the Generate Licensed File Geodatabase tool.</p><p><note type=\"note\"/><p group=\"note\">Licensing is not supported for geodatabases created earlier than version 10.1.</p></p></xdoc>",
        "title": "Generate File Geodatabase License"
    }
}
