{
    "map": {
        "abort_if_conflicts.descr": "<xdoc><p>Determines if the reconcile process should be aborted if conflicts are found between the target version and the edit version.</p><ul><li>Checked—Aborts the reconcile if conflicts are found.</li><li>Unchecked—Does not abort the reconcile if conflicts are found. This is the default.</li></ul></xdoc>",
        "abort_if_conflicts.title": "Abort if conflicts",
        "aquired_locks.descr": "<xdoc><p>Determines whether feature locks will be acquired.</p><ul><li>Checked—Acquires locks when there is no intention of posting the edit session. This is the default.</li><li>Unchecked—No locks are acquired and the edit session will be posted to the target version.</li></ul></xdoc>",
        "aquired_locks.title": "Acquire locks during reconcile",
        "conflict_definition.descr": "<xdoc><p>Describes the conditions required for a conflict to occur:</p><ul><li>Checked—Any changes to the same row or feature in the parent and child versions will conflict during reconcile. This is the default.</li><li>Unchecked—Only changes to the same attribute of the same row or feature in the parent and child versions will be flagged as a conflict during reconcile. Changes to different attributes will not be considered a conflict during reconcile.</li></ul></xdoc>",
        "conflict_definition.domain.BY_ATTRIBUTE": "BY_ATTRIBUTE",
        "conflict_definition.domain.BY_OBJECT": "BY_OBJECT",
        "conflict_definition.title": "Conflict Definition",
        "conflict_resolution.descr": "<xdoc><p>Describes the behavior if a conflict is detected:</p><ul><li>Checked—For all conflicts, resolves in favor of the target version. This is the default.</li><li>Unchecked—For all conflicts, resolves in favor of the edit version.</li></ul></xdoc>",
        "conflict_resolution.domain.FAVOR_EDIT_VERSION": "FAVOR_EDIT_VERSION",
        "conflict_resolution.domain.FAVOR_TARGET_VERSION": "FAVOR_TARGET_VERSION",
        "conflict_resolution.title": "Conflict Resolution",
        "description": "Reconciles a version against another version in its lineage.",
        "in_workspace.descr": "The enterprise geodatabase containing the reconcilable version.",
        "in_workspace.title": "Input Workspace",
        "out_workspace.title": "Updated Input Workspace",
        "post.descr": "<xdoc><p>Posts the current edit session to the reconciled target version.</p><ul><li>Checked—Current edits will be posted to the target version after the reconcile.</li><li>Unchecked—Current edits will not be posted to the target version after the reconcile. This is the default.</li></ul></xdoc>",
        "post.title": "Post version after reconcile",
        "summary": "<xdoc><p>Reconciles a version against another version in its lineage.</p><note type=\"legacy\"/><p group=\"note\">This is a deprecated tool. This functionality has been replaced by the Reconcile Versions tool.</p></xdoc>",
        "target_name.descr": "Name of any version in the direct ancestry of the Edit version, such as the parent version or the default version.",
        "target_name.title": "Target Version",
        "title": "Reconcile Version",
        "version_name.descr": "Name of the Edit Version to be reconciled with the Target Version.",
        "version_name.title": "Version Name"
    }
}
