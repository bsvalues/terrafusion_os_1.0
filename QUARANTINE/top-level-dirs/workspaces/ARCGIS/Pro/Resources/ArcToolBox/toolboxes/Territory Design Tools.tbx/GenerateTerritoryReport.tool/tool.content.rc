        "report_folder.title": "Output Report Folder",
        "report_format.descr": "<xdoc><p>Specifies the format of the output report.</p><ul><li><span title=\"PDF\">PDF</span>—The report will be in PDF format. This is the default.</li><li><span title=\"XLSX\">XLSX</span>—The report will be in XLSX format.</li><li><span title=\"HTML\">HTML</span>— The report will be in HTML format.</li><li><span title=\"ZIP\">ZIP</span>— The report will be in ZIP format.</li><li><span title=\"CSV\">CSV</span>—The report will be in CSV format.</li></ul></xdoc>",
