{
    "type": "FunctionTool",
    "guid": "{b89ea58c-9e05-4c11-8da8-5cb037d892a6}",
    "displayname": "$rc:title",
    "helpcontent": "10050005",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "use_page_unit": {
            "type": "optional",
            "displayname": "$rc:use_page_unit.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "USEPAGEUNIT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_USEPAGEUNIT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:use_page_unit.descr"
        },
        "scale": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:scale.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true"
            },
            "description": "$rc:scale.descr"
        },
        "length_along_line": {
            "type": "optional",
            "displayname": "$rc:length_along_line.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "value": "2 DecimalDegrees",
            "description": "$rc:length_along_line.descr"
        },
        "length_perpendicular_to_line": {
            "type": "optional",
            "displayname": "$rc:length_perpendicular_to_line.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "value": "1 DecimalDegrees",
            "description": "$rc:length_perpendicular_to_line.descr"
        },
        "page_orientation": {
            "type": "optional",
            "displayname": "$rc:page_orientation.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "HORIZONTAL",
                        "code": "$rc:page_orientation.domain.HORIZONTAL"
                    },
                    {
                        "value": "VERTICAL",
                        "code": "$rc:page_orientation.domain.VERTICAL"
                    }
                ]
            },
            "value": "HORIZONTAL",
            "description": "$rc:page_orientation.descr"
        },
        "overlap_percentage": {
            "type": "optional",
            "displayname": "$rc:overlap_percentage.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                },
                "high": {
                    "allow": "true",
                    "val": "20"
                }
            },
            "value": "10",
            "description": "$rc:overlap_percentage.descr"
        },
        "starting_page_number": {
            "type": "optional",
            "displayname": "$rc:starting_page_number.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "1"
                }
            },
            "value": "1",
            "description": "$rc:starting_page_number.descr"
        },
        "direction_type": {
            "type": "optional",
            "displayname": "$rc:direction_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "WE_NS",
                        "code": "$rc:direction_type.domain.WE_NS"
                    },
                    {
                        "value": "WE_SN",
                        "code": "$rc:direction_type.domain.WE_SN"
                    },
                    {
                        "value": "EW_NS",
                        "code": "$rc:direction_type.domain.EW_NS"
                    },
                    {
                        "value": "EW_SN",
                        "code": "$rc:direction_type.domain.EW_SN"
                    }
                ]
            },
            "value": "WE_NS",
            "description": "$rc:direction_type.descr"
        }
    }
}
