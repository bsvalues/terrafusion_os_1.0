{
    "type": "ServerTool",
    "server": "Tools/Elevation",
    "uri": "https://elevation.arcgis.com/arcgis/rest/services",
    "user": "UseSSOIdentityIfPortalOwned",
    "toolname": "Profile",
    "displayname": "$rc:title",
    "helpcontent": "65010001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "InputLineFeatures": {
            "displayname": "$rc:inputlinefeatures.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "value_xml": "<GPFeatureRecordSetLayer xsi:type='typens:GPFeatureRecordSetLayer' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xmlns:xs='http://www.w3.org/2001/XMLSchema' xmlns:typens='http://www.esri.com/schemas/ArcGIS/3.4.0'><RecordSet xsi:type='typens:RecordSet'><Fields xsi:type='typens:Fields'><FieldArray xsi:type='typens:ArrayOfField'><Field xsi:type='typens:Field'><Name>OID</Name><Type>esriFieldTypeOID</Type><IsNullable>false</IsNullable><Length>4</Length><Precision>0</Precision><Scale>0</Scale><Required>true</Required><Editable>false</Editable><ModelName>OID</ModelName></Field><Field xsi:type='typens:Field'><Name>Shape</Name><Type>esriFieldTypeGeometry</Type><IsNullable>true</IsNullable><Length>0</Length><Precision>0</Precision><Scale>0</Scale><Required>true</Required><GeometryDef xsi:type='typens:GeometryDef'><AvgNumPoints>0</AvgNumPoints><GeometryType>esriGeometryPolyline</GeometryType><HasM>false</HasM><HasZ>false</HasZ><SpatialReference xsi:type='typens:ProjectedCoordinateSystem'><WKT>PROJCS[&quot;WGS_1984_Web_Mercator_Auxiliary_Sphere&quot;,GEOGCS[&quot;GCS_WGS_1984&quot;,DATUM[&quot;D_WGS_1984&quot;,SPHEROID[&quot;WGS_1984&quot;,6378137.0,298.257223563]],PRIMEM[&quot;Greenwich&quot;,0.0],UNIT[&quot;Degree&quot;,0.0174532925199433]],PROJECTION[&quot;Mercator_Auxiliary_Sphere&quot;],PARAMETER[&quot;False_Easting&quot;,0.0],PARAMETER[&quot;False_Northing&quot;,0.0],PARAMETER[&quot;Central_Meridian&quot;,0.0],PARAMETER[&quot;Standard_Parallel_1&quot;,0.0],PARAMETER[&quot;Auxiliary_Sphere_Type&quot;,0.0],UNIT[&quot;Meter&quot;,1.0],AUTHORITY[&quot;EPSG&quot;,3857]]</WKT><XOrigin>-20037700</XOrigin><YOrigin>-30241100</YOrigin><XYScale>10000</XYScale><ZOrigin>-100000</ZOrigin><ZScale>10000</ZScale><MOrigin>-100000</MOrigin><MScale>10000</MScale><XYTolerance>0.001</XYTolerance><ZTolerance>0.001</ZTolerance><MTolerance>0.001</MTolerance><HighPrecision>true</HighPrecision><WKID>102100</WKID><LatestWKID>3857</LatestWKID></SpatialReference><GridSize0>2400000</GridSize0></GeometryDef><ModelName>Shape</ModelName></Field><Field xsi:type='typens:Field'><Name>Shape_Length</Name><Type>esriFieldTypeDouble</Type><IsNullable>true</IsNullable><Length>0</Length><Precision>0</Precision><Scale>0</Scale><Required>true</Required><Editable>false</Editable></Field></FieldArray></Fields><Records xsi:type='typens:ArrayOfRecord'></Records></RecordSet><OIDFieldName>OID</OIDFieldName><ShapeFieldName>Shape</ShapeFieldName></GPFeatureRecordSetLayer>",
            "description": "$rc:inputlinefeatures.descr"
        },
        "ProfileIDField": {
            "type": "optional",
            "displayname": "$rc:profileidfield.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:profileidfield.descr"
        },
        "DEMResolution": {
            "type": "optional",
            "displayname": "$rc:demresolution.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FINEST",
                        "code": "$rc:demresolution.domain.FINEST"
                    },
                    {
                        "value": "10m",
                        "code": "$rc:demresolution.domain.10m"
                    },
                    {
                        "value": "24m",
                        "code": "$rc:demresolution.domain.24m"
                    },
                    {
                        "value": "30m",
                        "code": "$rc:demresolution.domain.30m"
                    },
                    {
                        "value": "90m",
                        "code": "$rc:demresolution.domain.90m"
                    },
                    {
                        "value": "500m",
                        "code": "$rc:demresolution.domain.500m"
                    },
                    {
                        "value": "1000m",
                        "code": "$rc:demresolution.domain.1000m"
                    }
                ]
            },
            "description": "$rc:demresolution.descr"
        },
        "MaximumSampleDistance": {
            "type": "optional",
            "displayname": "$rc:maximumsampledistance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:maximumsampledistance.descr"
        },
        "MaximumSampleDistanceUnits": {
            "type": "optional",
            "displayname": "$rc:maximumsampledistanceunits.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "Meters",
                        "code": "$rc:maximumsampledistanceunits.domain.Meters"
                    },
                    {
                        "value": "Kilometers",
                        "code": "$rc:maximumsampledistanceunits.domain.Kilometers"
                    },
                    {
                        "value": "Feet",
                        "code": "$rc:maximumsampledistanceunits.domain.Feet"
                    },
                    {
                        "value": "Yards",
                        "code": "$rc:maximumsampledistanceunits.domain.Yards"
                    },
                    {
                        "value": "Miles",
                        "code": "$rc:maximumsampledistanceunits.domain.Miles"
                    }
                ]
            },
            "value": "Meters",
            "description": "$rc:maximumsampledistanceunits.descr"
        },
        "OutputProfile": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:outputprofile.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            }
        }
    }
}
