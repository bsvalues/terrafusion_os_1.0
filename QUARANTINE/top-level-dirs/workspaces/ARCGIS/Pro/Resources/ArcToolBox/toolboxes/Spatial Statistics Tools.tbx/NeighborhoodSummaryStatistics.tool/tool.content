{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\NeighborhoodSummaryStatistics",
    "displayname": "$rc:title",
    "helpcontent": "9040007",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "output_features": {
            "direction": "out",
            "display_order": "2",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "analysis_fields": {
            "type": "optional",
            "display_order": "1",
            "control_guid": "{C15EC6FA-35EF-4204-90FB-01E7B4DD6862}",
            "displayname": "$rc:analysis_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:analysis_fields.descr"
        },
        "local_summary_statistic": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:local_summary_statistic.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ALL",
                        "code": "$rc:local_summary_statistic.domain.ALL"
                    },
                    {
                        "value": "MEAN",
                        "code": "$rc:local_summary_statistic.domain.MEAN"
                    },
                    {
                        "value": "MEDIAN",
                        "code": "$rc:local_summary_statistic.domain.MEDIAN"
                    },
                    {
                        "value": "STD_DEV",
                        "code": "$rc:local_summary_statistic.domain.STD_DEV"
                    },
                    {
                        "value": "IQR",
                        "code": "$rc:local_summary_statistic.domain.IQR"
                    },
                    {
                        "value": "SKEWNESS",
                        "code": "$rc:local_summary_statistic.domain.SKEWNESS"
                    },
                    {
                        "value": "QUANTILE_IMBALANCE",
                        "code": "$rc:local_summary_statistic.domain.QUANTILE_IMBALANCE"
                    }
                ]
            },
            "value": "ALL",
            "description": "$rc:local_summary_statistic.descr"
        },
        "include_focal_feature": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:include_focal_feature.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "INCLUDE_FOCAL"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "EXCLUDE_FOCAL"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:include_focal_feature.descr"
        },
        "ignore_nulls": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:ignore_nulls.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "IGNORE_NULLS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "INCLUDE_NULLS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:ignore_nulls.descr"
        },
        "neighborhood_type": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:neighborhood_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DISTANCE_BAND",
                        "code": "$rc:neighborhood_type.domain.DISTANCE_BAND"
                    },
                    {
                        "value": "NUMBER_OF_NEIGHBORS",
                        "code": "$rc:neighborhood_type.domain.NUMBER_OF_NEIGHBORS"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_ONLY",
                        "code": "$rc:neighborhood_type.domain.CONTIGUITY_EDGES_ONLY"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_CORNERS",
                        "code": "$rc:neighborhood_type.domain.CONTIGUITY_EDGES_CORNERS"
                    },
                    {
                        "value": "DELAUNAY_TRIANGULATION",
                        "code": "$rc:neighborhood_type.domain.DELAUNAY_TRIANGULATION"
                    },
                    {
                        "value": "GET_SPATIAL_WEIGHTS_FROM_FILE",
                        "code": "$rc:neighborhood_type.domain.GET_SPATIAL_WEIGHTS_FROM_FILE"
                    }
                ]
            },
            "description": "$rc:neighborhood_type.descr"
        },
        "distance_band": {
            "enabled": "false",
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:distance_band.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Meters",
                    "Kilometers",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:distance_band.descr"
        },
        "number_of_neighbors": {
            "enabled": "false",
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:number_of_neighbors.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "2",
                "max": "1000"
            },
            "value": "8",
            "description": "$rc:number_of_neighbors.descr"
        },
        "weights_matrix_file": {
            "enabled": "false",
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:weights_matrix_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "swm",
                    "gwt",
                    "txt"
                ]
            },
            "description": "$rc:weights_matrix_file.descr"
        },
        "local_weighting_scheme": {
            "enabled": "false",
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:local_weighting_scheme.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UNWEIGHTED",
                        "code": "$rc:local_weighting_scheme.domain.UNWEIGHTED"
                    },
                    {
                        "value": "BISQUARE",
                        "code": "$rc:local_weighting_scheme.domain.BISQUARE"
                    },
                    {
                        "value": "GAUSSIAN",
                        "code": "$rc:local_weighting_scheme.domain.GAUSSIAN"
                    }
                ]
            },
            "value": "UNWEIGHTED",
            "description": "$rc:local_weighting_scheme.descr"
        },
        "kernel_bandwidth": {
            "enabled": "false",
            "type": "optional",
            "display_order": "11",
            "displayname": "$rc:kernel_bandwidth.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Meters",
                    "Kilometers",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:kernel_bandwidth.descr"
        }
    },
    "environments": [
        "outputCoordinateSystem"
    ]
}
