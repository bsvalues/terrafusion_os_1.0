                        "code": "RECURSIVE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NOT_RECURSIVE"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:recursive.descr"
        },
