{
    "type": "FunctionTool",
    "guid": "{0A4A9218-07A4-497A-8506-CED528063FB9}/CalculateRouteConcurrencies",
    "displayname": "$rc:title",
    "helpcontent": "23000018",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "78"
    ],
    "params": {
        "in_route_features": {
            "displayname": "$rc:in_route_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:in_route_features.descr"
        },
        "out_dataset": {
            "direction": "out",
            "displayname": "$rc:out_dataset.title",
            "datatype": {
                "type": "DETable"
            },
            "description": "$rc:out_dataset.descr"
        },
        "tvd": {
            "type": "optional",
            "displayname": "$rc:tvd.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:tvd.descr"
        },
        "find_dominance": {
            "type": "optional",
            "displayname": "$rc:find_dominance.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "FIND_DOMINANCE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_FIND_DOMINANCE"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:find_dominance.descr"
        },
        "include_geometry": {
            "type": "optional",
            "displayname": "$rc:include_geometry.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "INCLUDE_GEOMETRY"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "EXCLUDE_GEOMETRY"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:include_geometry.descr"
        }
    },
    "environments": [
        "scratchWorkspace",
        "workspace"
    ]
}
