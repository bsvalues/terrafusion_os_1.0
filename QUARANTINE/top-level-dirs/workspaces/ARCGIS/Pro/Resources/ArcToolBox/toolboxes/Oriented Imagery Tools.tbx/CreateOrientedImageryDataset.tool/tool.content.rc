{
    "map": {
        "config_keyword.descr": "The configuration keyword for the data. This parameter applies to enterprise data only. It determines the storage parameters of the database table.",
        "config_keyword.title": "Configuration Keyword",
        "constant_elevation.descr": "<xdoc><p>The constant ground elevation value (in meters) for the entire dataset.</p><p>This parameter is active when the <span class=\"esri_uicontrol\">Elevation Source</span> parameter value is specified as <span class=\"esri_uicontrol\">Constant Elevation</span>.</p></xdoc>",
        "constant_elevation.title": "Constant Elevation",
        "dem.descr": "<xdoc><p>The name of the input digital elevation model. A dynamic image service or a tile image service can be used as the digital elevation model.</p><p>This parameter is active when the <span class=\"esri_uicontrol\">Elevation Source</span> parameter value is specified as <span class=\"esri_uicontrol\">DEM</span>.</p></xdoc>",
        "dem.title": "Digital Elevation Model",
        "description": "Creates an empty oriented imagery dataset in a geodatabase.",
        "elevation_source.descr": "<xdoc><p>Specifies the elevation source for the dataset.</p><ul><li><span title=\"DEM\">DEM</span>—The elevation source will be a digital elevation model that is a dynamic image service or a tile image service.</li><li><span title=\"CONSTANT_ELEVATION\">Constant Elevation</span>—The elevation source will be a constant ground elevation value for the entire dataset.</li></ul></xdoc>",
        "elevation_source.domain.CONSTANT_ELEVATION": "Constant Elevation",
        "elevation_source.domain.DEM": "DEM",
        "elevation_source.title": "Elevation Source",
        "has_z.descr": "<xdoc><p>Specifies whether the output oriented imagery dataset will have elevation values (z-values).</p><ul><li><span title=\"DISABLED\">No</span>—The output oriented imagery dataset will not have z-values. This is the default</li><li><span title=\"ENABLED\">Yes</span>—The output oriented imagery dataset will have z-values.</li></ul></xdoc>",
        "has_z.domain.DISABLED": "No",
        "has_z.domain.ENABLED": "Yes",
        "has_z.title": "Has Z",
        "lod.descr": "<xdoc><p>The scale in a tiling schema. The scale represents the zoom level value. Each successive level improves resolution and map scale by double when compared to the previous level.</p><p>This parameter is enabled when the <span class=\"esri_uicontrol\">Digital Elevation Model</span> parameter value is a tile image service.</p></xdoc>",
        "lod.title": "Level of Detail",
        "out_dataset_alias.descr": "The alternate name for the oriented imagery dataset that will be created.",
        "out_dataset_alias.title": "Oriented Imagery Dataset Alias",
        "out_dataset_name.descr": "The name of the oriented imagery dataset that will be created.",
        "out_dataset_name.title": "Oriented Imagery Dataset Name",
        "out_dataset_path.descr": "The geodatabase in which the output oriented imagery dataset will be created. This workspace must already exist.",
        "out_dataset_path.title": "Oriented Imagery Dataset Location",
        "out_oriented_imagery_dataset.title": "Output Oriented Imagery Dataset",
        "params.category1": "Geodatabase Settings (optional)",
        "raster_function.descr": "<xdoc><p>The raster function processing template that will be applied to the image service.</p><p>This parameter is active when the <span class=\"esri_uicontrol\">Digital Elevation Model</span> parameter value is a dynamic image service.</p></xdoc>",
        "raster_function.title": "Raster Function",
        "spatial_reference.descr": "The spatial reference of the output oriented imagery dataset.",
        "spatial_reference.title": "Coordinate System",
        "template.descr": "The oriented imagery dataset or table that will be used as a template to define the attribute fields of the new oriented imagery dataset.",
        "template.title": "Template Datasets",
        "title": "Create Oriented Imagery Dataset"
