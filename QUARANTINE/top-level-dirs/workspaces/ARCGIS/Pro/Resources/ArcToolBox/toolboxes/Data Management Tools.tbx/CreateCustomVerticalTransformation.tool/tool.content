            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:target_vt_coor_system.descr"
        },
        "interpolation_gcs": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:interpolation_gcs.title",
