{
    "map": {
        "description": "Identifies inconsistencies in the system tables used to manage traditional versions and states in a geodatabase.",
        "input_database.descr": "<xdoc><p>The database connection (.sde file) to the enterprise geodatabase in which traditional versioning system table inconsistencies may exist.</p><p>The connection must be made as the geodatabase administrator.</p></xdoc>",
        "input_database.title": "Input Database Connection",
        "out_log.descr": "<xdoc><p>The name and location of the output log file.</p><p>The log file is an ASCII file containing a list of the system tables in the specified version that contain inconsistent records, as well as the database connection file used.</p></xdoc>",
        "out_log.title": "Diagnostic Version Metadata Log",
        "out_workspace.title": "Updated Input Workspace",
        "title": "Diagnose Version Metadata"
    }
}
