{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\SpatiallyConstrainedMultivariateClustering",
    "displayname": "$rc:title",
    "helpcontent": "9030010",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "output_features": {
            "direction": "out",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "analysis_fields": {
            "control_guid": "{C15EC6FA-35EF-4204-90FB-01E7B4DD6862}",
            "displayname": "$rc:analysis_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:analysis_fields.descr"
        },
        "size_constraints": {
            "type": "optional",
            "displayname": "$rc:size_constraints.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NONE",
                        "code": "$rc:size_constraints.domain.NONE"
                    },
                    {
                        "value": "NUM_FEATURES",
                        "code": "$rc:size_constraints.domain.NUM_FEATURES"
                    },
                    {
                        "value": "ATTRIBUTE_VALUE",
                        "code": "$rc:size_constraints.domain.ATTRIBUTE_VALUE"
                    }
                ]
            },
            "value": "NONE",
            "description": "$rc:size_constraints.descr"
        },
        "constraint_field": {
            "type": "optional",
            "displayname": "$rc:constraint_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:constraint_field.descr"
        },
        "min_constraint": {
            "type": "optional",
            "displayname": "$rc:min_constraint.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:min_constraint.descr"
        },
        "max_constraint": {
            "type": "optional",
            "displayname": "$rc:max_constraint.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:max_constraint.descr"
        },
        "number_of_clusters": {
            "type": "optional",
            "displayname": "$rc:number_of_clusters.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:number_of_clusters.descr"
        },
        "spatial_constraints": {
            "type": "optional",
            "displayname": "$rc:spatial_constraints.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "CONTIGUITY_EDGES_ONLY",
                        "code": "$rc:spatial_constraints.domain.CONTIGUITY_EDGES_ONLY"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_CORNERS",
                        "code": "$rc:spatial_constraints.domain.CONTIGUITY_EDGES_CORNERS"
                    },
                    {
                        "value": "TRIMMED_DELAUNAY_TRIANGULATION",
                        "code": "$rc:spatial_constraints.domain.TRIMMED_DELAUNAY_TRIANGULATION"
                    },
                    {
                        "value": "GET_SPATIAL_WEIGHTS_FROM_FILE",
                        "code": "$rc:spatial_constraints.domain.GET_SPATIAL_WEIGHTS_FROM_FILE"
                    }
                ]
            },
            "description": "$rc:spatial_constraints.descr"
        },
        "weights_matrix_file": {
            "type": "optional",
            "displayname": "$rc:weights_matrix_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "swm",
                    "gwt"
                ]
            },
            "description": "$rc:weights_matrix_file.descr"
        },
        "number_of_permutations": {
            "type": "optional",
            "displayname": "$rc:number_of_permutations.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLong",
                        "value": "0",
                        "code": "0"
                    },
                    {
                        "type": "GPLong",
                        "value": "100",
                        "code": "100"
                    },
                    {
                        "type": "GPLong",
                        "value": "200",
                        "code": "200"
                    },
                    {
                        "type": "GPLong",
                        "value": "500",
                        "code": "500"
                    },
                    {
                        "type": "GPLong",
                        "value": "1000",
                        "code": "1000"
                    }
                ]
            },
            "value": "0",
            "description": "$rc:number_of_permutations.descr"
        },
        "output_table": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:output_table.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_table.descr"
        }
    },
    "environments": [
        "MResolution",
        "MTolerance",
        "XYResolution",
        "XYTolerance",
        "ZResolution",
        "ZTolerance",
        "geographicTransformations",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "parallelProcessingFactor",
        "qualifiedFieldNames",
        "randomGenerator",
        "scratchWorkspace",
        "workspace"
    ]
}
