        "max_sample_radius.descr": "The longest distance (in meters) from any point within the training sample to its center seed point. If set to 0, the output training sample will be points instead of polygons. The minimum value must be greater than or equal to 0.",
        "max_sample_radius.title": "Max Sample Radius",
        "min_sample_area.descr": "The minimum area needed for each training sample, in square meters. The minimum value must be greater than or equal to 0.",
        "min_sample_area.title": "Min Sample Area",
