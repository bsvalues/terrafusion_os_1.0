{
    "map": {
        "calibrate_rule.descr": "<xdoc><p>Specifies the event behavior rule for the calibrate activity.</p><ul><li><span title=\"STAY_PUT\">Stay put</span>— The geographic location of the event will be preserved; measures may change. This is the default.</li><li><span title=\"RETIRE\">Retire</span>—Both measure and geographic location will be preserved; the event will be retired.</li><li><span title=\"MOVE\">Move</span>—The measures of the event will be preserved; the geographic location may change.</li></ul></xdoc>",
        "calibrate_rule.domain.MOVE": "Move",
        "calibrate_rule.domain.RETIRE": "Retire",
        "calibrate_rule.domain.STAY_PUT": "Stay put",
        "calibrate_rule.title": "Calibrate Rule",
        "carto_realign_rule.descr": "<xdoc><p>Specifies the event behavior rule for the cartographic realign activity.</p><ul><li><span title=\"HONOR_ROUTE_MEASURE\">Honor Route Measure</span>—The measure of the event will be preserved or changed proportionally to the route&apos;s measure change. This is the default.</li></ul></xdoc>",
        "carto_realign_rule.domain.HONOR_ROUTE_MEASURE": "Honor Route Measure",
        "carto_realign_rule.title": "Carto Realign Rule",
        "description": "Associates event data stored in an external system with an LRS.",
        "event_id_field.descr": "The event ID field available in the event feature class or table.",
        "event_id_field.title": "Event ID Field",
        "event_name.descr": "The name of the external event or table that will be registered to the LRS.",
        "event_name.title": "LRS Event Name",
        "event_spans_routes.descr": "<xdoc><p>Specifies whether the event records will span routes.</p><ul><li><span title=\"AS_IS\">As is</span>—The property will not change. This is the default.</li><li><span title=\"NO_SPANS_ROUTES\">Do not span routes</span>—The event records will not span routes. This is applicable to line events only.</li><li><span title=\"SPANS_ROUTES\">Spans routes</span>— The event records will span routes. This is applicable to line events only.</li></ul></xdoc>",
        "event_spans_routes.domain.AS_IS": "As is",
        "event_spans_routes.domain.NO_SPANS_ROUTES": "Do not span routes",
        "event_spans_routes.domain.SPANS_ROUTES": "Spans routes",
        "event_spans_routes.title": "Event Spans Routes",
        "extend_rule.descr": "<xdoc><p>Specifies the event behavior rule for the extend activity.</p><ul><li><span title=\"STAY_PUT\">Stay put</span>— The geographic location of the event will be preserved; measures may change. This is the default.</li><li><span title=\"RETIRE\">Retire</span>— Both measure and geographic location will be preserved; the event will be retired.</li><li><span title=\"MOVE\">Move</span>— The measures of the event will be preserved; the geographic location may change.</li><li><span title=\"COVER\">Cover</span>—The geometric location and measure of a line event will be modified to include a new or newly modified section.</li></ul></xdoc>",
        "extend_rule.domain.COVER": "Cover",
        "extend_rule.domain.MOVE": "Move",
        "extend_rule.domain.RETIRE": "Retire",
        "extend_rule.domain.STAY_PUT": "Stay put",
        "extend_rule.title": "Extend Rule",
        "from_date_field.descr": "The from date field in the event feature class or table.",
        "from_date_field.title": "From Date Field",
        "geometry_type.descr": "<xdoc><p>Specifies the geometry type of the external event or table.</p><ul><li><span title=\"POINT\">Point</span>— The geometry type of the event will be point. This is the default.</li><li><span title=\"LINE\">Line</span>— The geometry type of the event will be polyline.</li></ul></xdoc>",
        "geometry_type.domain.LINE": "Line",
        "geometry_type.domain.POINT": "Point",
        "geometry_type.title": "Geometry Type",
        "in_event.descr": "The external event feature class or table that will be registered to an LRS.",
        "in_event.title": "Input Event",
        "measure_field.descr": "The name of the measure field if it is a point event or the name of the from measure field if it is a line event.",
        "measure_field.title": "Measure Field",
        "out_external_event_table.title": "Output External Event Table",
        "params.category1": "Behavior Rules",
        "parent_network.descr": "The LRS Network to which the event will be registered.",
        "parent_network.title": "Parent LRS Network",
        "realign_rule.descr": "<xdoc><p>Specifies the event behavior rule for the realign activity.</p><ul><li><span title=\"STAY_PUT\">Stay put</span>— The geographic location of the event will be preserved; measures may change. This is the default.</li><li><span title=\"RETIRE\">Retire</span>— Both measure and geographic location will be preserved; the event will be retired.</li><li><span title=\"MOVE\">Move</span>— The measures of the event will be preserved; the geographic location may change.</li><li><span title=\"SNAP\">Snap</span>—The geographic location of the event will be preserved by snapping the event to a concurrent route; measures may change.</li><li><span title=\"COVER\">Cover</span>—The geometric location and measure of a line event will be modified to include a new or newly modified section.</li></ul></xdoc>",
        "realign_rule.domain.COVER": "Cover",
        "realign_rule.domain.MOVE": "Move",
        "realign_rule.domain.RETIRE": "Retire",
        "realign_rule.domain.SNAP": "Snap",
        "realign_rule.domain.STAY_PUT": "Stay put",
        "realign_rule.title": "Realign Rule",
        "reassign_rule.descr": "<xdoc><p>Specifies the event behavior rule for the reassign activity.</p><ul><li><span title=\"STAY_PUT\">Stay put</span>— The geographic location of the event will be preserved; measures may change. This is the default.</li><li><span title=\"RETIRE\">Retire</span>— Both measure and geographic location will be preserved; the event will be retired.</li><li><span title=\"MOVE\">Move</span>— The measures of the event will be preserved; the geographic location may change.</li><li><span title=\"SNAP\">Snap</span>— The geographic location of the event will be preserved by snapping the event to a concurrent route; measures may change.</li></ul></xdoc>",
        "reassign_rule.domain.MOVE": "Move",
        "reassign_rule.domain.RETIRE": "Retire",
        "reassign_rule.domain.SNAP": "Snap",
        "reassign_rule.domain.STAY_PUT": "Stay put",
        "reassign_rule.title": "Reassign Rule",
        "retire_rule.descr": "<xdoc><p>Specifies the event behavior rule for the retire activity.</p><ul><li><span title=\"STAY_PUT\">Stay put</span>— The geographic location of the event will be preserved; measures may change. This is the default.</li><li><span title=\"RETIRE\">Retire</span>— Both measure and geographic location will be preserved; the event will be retired.</li><li><span title=\"MOVE\">Move</span>— The measures of the event will be preserved; the geographic location may change.</li><li><span title=\"SNAP\">Snap</span>—The geographic location of the event will be preserved by snapping the event to a concurrent route; measures may change.</li></ul></xdoc>",
        "retire_rule.domain.MOVE": "Move",
        "retire_rule.domain.RETIRE": "Retire",
        "retire_rule.domain.SNAP": "Snap",
        "retire_rule.domain.STAY_PUT": "Stay put",
        "retire_rule.title": "Retire Rule",
        "reverse_rule.descr": "<xdoc><p>Specifies the event behavior rule for the reverse activity.</p><ul><li><span title=\"STAY_PUT\">Stay put</span>— The geographic location of the event will be preserved; measures may change. This is the default.</li><li><span title=\"RETIRE\">Retire</span>— Both measure and geographic location will be preserved; the event will be retired.</li><li><span title=\"MOVE\">Move</span>— The measures of the event will be preserved; the geographic location may change.</li></ul></xdoc>",
        "reverse_rule.domain.MOVE": "Move",
        "reverse_rule.domain.RETIRE": "Retire",
        "reverse_rule.domain.STAY_PUT": "Stay put",
        "reverse_rule.title": "Reverse Rule",
        "route_id_field.descr": "The name of the route ID field if it is a point event or a line event that does not span routes, or the name of the from route ID field if the event spans routes. The field must be available in the external event table or feature class.",
        "route_id_field.title": "Route ID Field",
        "route_name_field.descr": "The route name field if it is a point event or line event that does not span routes, or the name of the from route name field if the event spans routes. The field must be available in the external event table or feature class.",
        "route_name_field.title": "Route Name Field",
        "store_route_name.descr": "<xdoc><p>Specifies whether the route name will be stored with the event records.</p><ul><li><span title=\"AS_IS\">As is</span>—The property will not change. This is the default.</li><li><span title=\"NO_STORE_ROUTE_NAME\">Do not store route name</span>—The route name will not be stored with the event records.</li><li><span title=\"STORE_ROUTE_NAME\">Store route name</span>—The route name will be stored with the event records.</li></ul></xdoc>",
        "store_route_name.domain.AS_IS": "As is",
        "store_route_name.domain.NO_STORE_ROUTE_NAME": "Do not store route name",
        "store_route_name.domain.STORE_ROUTE_NAME": "Store route name",
        "store_route_name.title": "Store Route Name",
        "title": "Configure External Event With LRS",
