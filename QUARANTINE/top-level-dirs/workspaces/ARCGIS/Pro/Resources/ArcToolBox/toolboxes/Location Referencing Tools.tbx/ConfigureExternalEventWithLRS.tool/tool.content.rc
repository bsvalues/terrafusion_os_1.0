        "to_date_field.title": "To Date Field",
        "to_measure_field.descr": "The name of the to measure field. This field is only required for line events.",
        "to_measure_field.title": "To Measure Field",
        "to_route_id_field.descr": "The name of the to route ID field available in the event feature class or table.",
        "to_route_id_field.title": "To Route ID Field",
        "to_route_name_field.descr": "<xdoc><p>The to route name field for line events that span routes. This parameter is required if the <span class=\"esri_uicontrol\">Store Route Name</span> and <span class=\"esri_uicontrol\">Event Spans Routes</span> parameters are set.</p></xdoc>",
        "to_route_name_field.title": "To Route Name Field"
