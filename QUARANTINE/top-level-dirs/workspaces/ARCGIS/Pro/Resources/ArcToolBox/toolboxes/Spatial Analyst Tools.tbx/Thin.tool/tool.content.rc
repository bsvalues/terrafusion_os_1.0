{
    "map": {
        "background_value.descr": "<xdoc><p>Specifies the cell value that will identify the background cells. The linear features are formed from the foreground cells.</p><ul><li><span title=\"ZERO\">Zero</span>—The background is composed of cells of 0 or less, or NoData. All cells whose value is greater than 0 are the foreground.</li><li><span title=\"NODATA\">NoData</span>—The background is composed of NoData cells. All cells with valid values belong to the foreground.</li></ul></xdoc>",
        "background_value.domain.NODATA": "NoData",
        "background_value.domain.ZERO": "Zero",
        "background_value.title": "Background value",
        "corners.descr": "<xdoc><p>Specifies whether round or sharp turns will be made at turns or junctions.</p><p>It is also used during the vector conversion process to spline curves or create sharp intersections and corners.</p><ul><li><span title=\"ROUND\">Round</span>—Attempts to smooth corners and junctions. This is best for vectorizing natural features, such as contours or streams.</li><li><span title=\"SHARP\">Sharp</span>—Attempts to preserve rectangular corners and junctions. This is best for vectorizing man-made features such as streets.</li></ul></xdoc>",
        "corners.domain.ROUND": "Round",
        "corners.domain.SHARP": "Sharp",
        "corners.title": "Shape for corners",
        "description": "Thins rasterized linear features by reducing the number of cells representing the width of the features.",
        "filter.descr": "<xdoc><p>Specifies whether a filter will be applied as the first phase of thinning.</p><ul><li>Unchecked—No filter will be applied. This is the default.</li><li>Checked—The raster will be filtered to smooth the boundaries between foreground and background cells. This option will eliminate minor irregularities from the output raster.</li></ul></xdoc>",
        "filter.title": "Filter input first",
        "in_raster.descr": "<xdoc><p>The input raster to be thinned.</p><p>It must be of integer type.</p></xdoc>",
        "in_raster.title": "Input raster",
        "maximum_thickness.descr": "<xdoc><p>The maximum thickness, in map units, of linear features in the input raster.</p><p>The default thickness is ten times the cell size.</p></xdoc>",
        "maximum_thickness.title": "Maximum thickness of input linear features",
        "out_raster.descr": "<xdoc><p>The output thinned raster.</p><p>The output is always of integer type.</p></xdoc>",
        "out_raster.title": "Output raster",
        "title": "Thin"
    }
}
