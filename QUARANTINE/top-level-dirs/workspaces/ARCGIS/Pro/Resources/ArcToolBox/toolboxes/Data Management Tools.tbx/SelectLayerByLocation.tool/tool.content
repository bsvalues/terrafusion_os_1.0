                        "code": "$rc:overlap_type.domain.BOUNDARY_TOUCHES"
                    },
                    {
                        "value": "SHARE_A_LINE_SEGMENT_WITH",
                        "code": "$rc:overlap_type.domain.SHARE_A_LINE_SEGMENT_WITH"
                    },
                    {
                        "value": "CROSSED_BY_THE_OUTLINE_OF",
                        "code": "$rc:overlap_type.domain.CROSSED_BY_THE_OUTLINE_OF"
