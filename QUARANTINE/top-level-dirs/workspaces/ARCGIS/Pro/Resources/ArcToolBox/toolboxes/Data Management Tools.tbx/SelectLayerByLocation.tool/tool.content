                        "code": "$rc:overlap_type.domain.COMPLETELY_CONTAINS"
                    },
                    {
                        "value": "CONTAINS_CLEMENTINI",
                        "code": "$rc:overlap_type.domain.CONTAINS_CLEMENTINI"
                    },
                    {
                        "value": "WITHIN",
                        "code": "$rc:overlap_type.domain.WITHIN"
