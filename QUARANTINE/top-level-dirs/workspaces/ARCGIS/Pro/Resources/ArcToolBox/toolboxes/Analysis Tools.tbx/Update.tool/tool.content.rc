{
    "map": {
        "cluster_tolerance.descr": "<xdoc><p>The minimum distance separating all feature coordinates (nodes and vertices) as well as the distance a coordinate can move in x or y (or both).</p><note type=\"caution\"/><p group=\"note\">Changing this parameter&apos;s value may cause failure or unexpected results. It is recommended that you do not modify this parameter. It has been removed from view on the tool dialog box. By default, the input feature class&apos;s spatial reference x,y tolerance property is used.</p></xdoc>",
        "cluster_tolerance.title": "XY Tolerance",
        "description": "Computes the geometric intersection of the input features and update features. The attributes and geometry of the input features are updated by the update features in the output feature class.",
        "in_features.descr": "The input feature class or layer. The geometry type must be polygon.",
        "in_features.title": "Input Features",
        "keep_borders.descr": "<xdoc><p>Specifies whether the boundary of the update polygon features will be kept.</p><ul><li>Checked—The outside border of the <span class=\"esri_uicontrol\">Update Features</span> parameter value will be kept in the <span class=\"esri_uicontrol\">Output Feature Class</span> parameter value. This is the default.</li><li>Unchecked—The outside border of the <span class=\"esri_uicontrol\">Update Features</span> parameter value will not be kept after it is inserted into the <span class=\"esri_uicontrol\">Input Features</span> parameter value. Item values of the <span class=\"esri_uicontrol\">Update Features</span> parameter value take precedence over <span class=\"esri_uicontrol\">Input Features</span> parameter value attributes.</li></ul></xdoc>",
        "keep_borders.title": "Borders",
        "out_feature_class.descr": "The feature class that will contain the results.",
        "out_feature_class.title": "Output Feature Class",
        "title": "Update",
        "update_features.descr": "The features that will be used to update the input features. The geometry type must be polygon.",
        "update_features.title": "Update Features"
    }
}
