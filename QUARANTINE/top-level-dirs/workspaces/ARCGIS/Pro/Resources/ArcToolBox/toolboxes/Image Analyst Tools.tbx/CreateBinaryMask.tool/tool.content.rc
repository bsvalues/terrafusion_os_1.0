{
    "map": {
        "background_nodata.descr": "<xdoc><p>Specifies whether the background value will be set to NoData.<ul><li>Checked—The background value will be set to NoData.</li><li>Unchecked—The background value will not be set to NoData. This is the default.</li></ul></p></xdoc>",
        "background_nodata.title": "Set Background as NoData",
        "background_value.descr": "The background value for the output raster. The default value is 0.",
        "background_value.title": "Background Value",
        "description": "Converts an input raster dataset to a binary raster. Pixels are labeled as either mask or background based on user-defined values.",
        "expand_background.descr": "The number of pixels that will be used to expand or shrink the background. Negative values will shrink the background.",
        "expand_background.title": "Expand Background",
        "expand_mask.descr": "The number of pixels that will be used to expand or shrink the mask. Negative values will shrink the mask.",
        "expand_mask.title": "Expand Mask",
        "flood_fill.descr": "<xdoc><p>Specifies how background pixel values will be determined.<ul><li>Checked—Background pixel values will be determined by the flood fill operation, which fills the connected pixels from the image boundary to the mask boundary. Pixels inside the mask will not be converted to background regardless of their value.</li><li>Unchecked—Background pixel values will be determined by the specified background value. This is the default.</li></ul></p></xdoc>",
        "flood_fill.title": "Flood Fill from Image Boundary",
        "in_raster.descr": "The input raster dataset. If the input is multiband, the first band will be used by default.",
        "in_raster.title": "Input Raster",
        "min_region_size.descr": "The number of connected pixels that will be used to define a mask region. Mask regions that are smaller than this size will be classified as background.",
        "min_region_size.title": "Minimum Mask Region Size",
        "out_raster.descr": "The output binary raster dataset. Supported formats are TIFF, CRF, and PNG.",
        "out_raster.title": "Output Mask Raster",
        "title": "Create Binary Mask"
    }
}
