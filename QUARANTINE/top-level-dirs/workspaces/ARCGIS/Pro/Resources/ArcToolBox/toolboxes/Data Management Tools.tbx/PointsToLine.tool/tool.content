{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3050022",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Features": {
            "displayname": "$rc:input_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_features.descr"
        },
        "Output_Feature_Class": {
            "direction": "out",
            "displayname": "$rc:output_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "geometrytype.rule": "AsSpecified",
                "geometrytype": "Polyline",
                "fields.rule": "AllFIDsOnly",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_feature_class.descr"
        },
        "Line_Field": {
            "type": "optional",
            "displayname": "$rc:line_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text",
                    "Date",
                    "XML",
                    "GUID"
                ]
            },
            "depends": [
                "Input_Features"
            ],
            "description": "$rc:line_field.descr"
        },
        "Sort_Field": {
            "type": "optional",
            "displayname": "$rc:sort_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text",
                    "Date",
                    "XML",
                    "OID"
                ]
            },
            "depends": [
                "Input_Features"
            ],
            "description": "$rc:sort_field.descr"
        },
        "Close_Line": {
            "type": "optional",
            "displayname": "$rc:close_line.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CLOSE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_CLOSE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:close_line.descr"
        },
        "Line_Construction_Method": {
            "type": "optional",
            "displayname": "$rc:line_construction_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "CONTINUOUS",
                        "code": "$rc:line_construction_method.domain.CONTINUOUS"
                    },
                    {
                        "value": "TWO_POINT",
                        "code": "$rc:line_construction_method.domain.TWO_POINT"
                    }
                ]
            },
            "value": "CONTINUOUS",
            "description": "$rc:line_construction_method.descr"
        },
        "Attribute_Source": {
            "type": "optional",
            "displayname": "$rc:attribute_source.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NONE",
                        "code": "$rc:attribute_source.domain.NONE"
                    },
                    {
                        "value": "BOTH_ENDS",
                        "code": "$rc:attribute_source.domain.BOTH_ENDS"
                    },
                    {
                        "value": "START",
                        "code": "$rc:attribute_source.domain.START"
                    },
                    {
                        "value": "END",
                        "code": "$rc:attribute_source.domain.END"
                    }
                ]
            },
            "value": "NONE",
            "description": "$rc:attribute_source.descr"
        },
        "Transfer_Fields": {
            "type": "optional",
            "displayname": "$rc:transfer_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text",
                    "Date",
                    "XML",
                    "OID"
                ]
            },
            "depends": [
                "Input_Features"
            ],
            "description": "$rc:transfer_fields.descr"
        }
    },
    "environments": [
        "MDomain",
        "MResolution",
        "MTolerance",
        "XYDomain",
        "XYResolution",
        "XYTolerance",
        "ZDomain",
        "ZResolution",
        "ZTolerance",
        "autoCommit",
        "configKeyword",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "qualifiedFieldNames",
        "scratchWorkspace",
        "workspace"
    ]
}
