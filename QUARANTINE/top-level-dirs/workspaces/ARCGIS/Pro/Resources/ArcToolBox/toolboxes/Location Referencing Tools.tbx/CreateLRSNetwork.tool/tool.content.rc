{
    "map": {
        "derive_from_line_network.descr": "<xdoc><p>Specifies whether the network will be configured as an LRS derived network.</p><ul><li>Checked—The output will be an LRS derived network and a feature class to support the LRS derived network. The <span class=\"esri_uicontrol\">Line Network Name</span> parameter value must also be provided.</li><li>Unchecked—The output will not be an LRS derived network. This is the default.</li></ul></xdoc>",
        "derive_from_line_network.title": "Derive From Line Network",
        "description": "Creates an LRS Network in an ArcGIS Location Referencing linear referencing system (LRS).",
        "from_date_field.descr": "A date field in the output feature class that will be mapped as the LRS Network from date.",
        "from_date_field.title": "From Date Field",
        "in_path.descr": "The input workspace that will contain the new LRS Network. This workspace must be a geodatabase that contains a Location Referencing LRS. In addition to the top level of a geodatabase, a feature dataset is also supported as a valid path.",
        "in_path.title": "Input Location",
        "include_fields_to_support_lines.descr": "<xdoc><p>Specifies whether fields that support lines will be added.</p><ul><li>Checked—The output will be an LRS line network, and the output feature class will include fields that support lines. The <span class=\"esri_uicontrol\">Line ID Field</span>, <span class=\"esri_uicontrol\">Line Name Field</span>, and <span class=\"esri_uicontrol\">Line Order Field</span> parameter values must also be provided.</li><li>Unchecked—The output will not be an LRS line network. This is the default.</li></ul></xdoc>",
        "include_fields_to_support_lines.title": "Include Fields to Support Lines",
        "line_id_field.descr": "<xdoc><p>The field in the output feature class that will be mapped as the LRS Network line ID. This parameter is only used if the <span class=\"esri_uicontrol\">Include Fields to Support Lines</span> parameter is checked. The field type is derived from the <span class=\"esri_fieldname\">RouteId</span> field of the centerline sequence table and will either be a string of exactly 38 characters or a GUID field type.</p></xdoc>",
        "line_id_field.title": "Line ID Field",
        "line_name_field.descr": "<xdoc><p>A string field in the output feature class that will be mapped as the LRS Network line name. This parameter is only used if the <span class=\"esri_uicontrol\">Include Fields to Support Lines</span> parameter is checked.</p></xdoc>",
        "line_name_field.title": "Line Name Field",
        "line_network_name.descr": "<xdoc><p>The name of the LRS line network to which the output LRS derived network will be registered. The input LRS line network must reside in the same geodatabase workspace as the <span class=\"esri_uicontrol\">Line Network Name</span> value. This parameter is only used if the <span class=\"esri_uicontrol\">Derive From Line Network</span> parameter is checked.</p></xdoc>",
        "line_network_name.title": "Line Network Name",
        "line_order_field.descr": "<xdoc><p>The field in the output feature class that will be mapped as the LRS Network line order. This parameter is only used if the <span class=\"esri_uicontrol\">Include Fields to Support Lines</span> parameter is checked. This will be a long integer field type.</p></xdoc>",
        "line_order_field.title": "Line Order Field",
        "lrs_name.descr": "<xdoc><p>The LRS to which the new LRS Network will be registered. The LRS must reside in the same geodatabase as the <span class=\"esri_uicontrol\">Input Location</span> parameter value.</p></xdoc>",
        "lrs_name.title": "LRS Name",
        "measure_unit.descr": "<xdoc><p>Specifies the unit of measure (m-unit) the LRS Network will use.</p><ul><li><span title=\"MILES\">Miles (US Survey)</span>—The unit of measure will be miles. This is the default.</li><li><span title=\"INCHES\">Inches (US Survey)</span>—The unit of measure will be inches.</li><li><span title=\"FEET\">Feet (US Survey)</span>—The unit of measure will be feet.</li><li><span title=\"YARDS\">Yards (US Survey)</span>—The unit of measure will be yards.</li><li><span title=\"NAUTICAL_MILES\">Nautical miles (US Survey)</span>—The unit of measure will be nautical miles.</li><li><span title=\"INTFEET\">Feet (International)</span>—The unit of measure will be international feet.</li><li><span title=\"MILLIMETERS\">Millimeters</span>—The unit of measure will be millimeters.</li><li><span title=\"CENTIMETERS\">Centimeters</span>—The unit of measure will be centimeters</li><li><span title=\"METERS\">Meters</span>—The unit of measure will be meters.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The unit of measure will be kilometers.</li><li><span title=\"DECIMETERS\">Decimeters</span>—The unit of measure will be decimeters.</li></ul></xdoc>",
        "measure_unit.domain.CENTIMETERS": "Centimeters",
        "measure_unit.domain.DECIMETERS": "Decimeters",
        "measure_unit.domain.FEET": "Feet (US Survey)",
        "measure_unit.domain.INCHES": "Inches (US Survey)",
        "measure_unit.domain.INTFEET": "Feet (International)",
        "measure_unit.domain.KILOMETERS": "Kilometers",
        "measure_unit.domain.METERS": "Meters",
        "measure_unit.domain.MILES": "Miles (US Survey)",
        "measure_unit.domain.MILLIMETERS": "Millimeters",
        "measure_unit.domain.NAUTICAL_MILES": "Nautical miles (US Survey)",
        "measure_unit.domain.YARDS": "Yards (US Survey)",
        "measure_unit.title": "Measure Unit",
        "network_name.descr": "The name of the LRS Network that will be created, as well as the name of the feature class that will be created and registered with the LRS Network. The LRS Network name must be 26 or fewer characters and cannot contain special characters other than underscores.",
        "network_name.title": "LRS Network Name",
        "out_feature_class.title": "Output Network Feature Class",
        "route_id_field.descr": "<xdoc><p>The field in the output feature class that will be mapped as the LRS Network route ID. The field type is derived from the <span class=\"esri_fieldname\">RouteId</span> field of the centerline sequence table and must be either string or GUID type.</p></xdoc>",
        "route_id_field.title": "Route ID Field",
        "route_name_field.descr": "A string field in the output feature class that will be mapped as the LRS Network route name.",
        "route_name_field.title": "Route Name Field",
        "title": "Create LRS Network",
        "to_date_field.descr": "A date field in the output feature class that will be mapped as the LRS Network to date.",
        "to_date_field.title": "To Date Field"
    }
}
