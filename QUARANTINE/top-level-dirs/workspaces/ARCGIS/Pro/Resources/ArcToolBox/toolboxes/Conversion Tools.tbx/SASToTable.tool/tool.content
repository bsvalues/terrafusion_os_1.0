{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "2170001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_sas_dataset": {
            "display_order": "0",
            "displayname": "$rc:in_sas_dataset.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:in_sas_dataset.descr"
        },
        "out_table": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_table.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_table.descr"
        },
        "use_cas_connection": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:use_cas_connection.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "USE_CAS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "LOCAL_SAS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:use_cas_connection.descr"
        },
        "hostname": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:hostname.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:hostname.descr"
        },
        "port": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:port.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:port.descr"
        },
        "username": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:username.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:username.descr"
        },
        "password": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:password.title",
            "datatype": {
                "type": "GPStringHidden"
            },
            "description": "$rc:password.descr"
        },
        "custom_cfg_file": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:custom_cfg_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "description": "$rc:custom_cfg_file.descr"
        },
        "authinfo_file": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:authinfo_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "description": "$rc:authinfo_file.descr"
        }
    }
}
