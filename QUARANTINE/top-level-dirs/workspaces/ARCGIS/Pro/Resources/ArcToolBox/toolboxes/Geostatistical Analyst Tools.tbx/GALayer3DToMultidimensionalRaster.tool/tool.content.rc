{
    "map": {
        "additional_outputs.descr": "<xdoc><p>Specifies the output type and quantile or probability value for each additional output type. If multiple output types are provided, the output raster will be a multivariate raster dataset with a different variable for each output type.</p><p>For more information, see What output surface types can the interpolation models generate?</p></xdoc>",
        "additional_outputs.domain.item1.CONDITION_NUMBER": "CONDITION_NUMBER",
        "additional_outputs.domain.item1.PREDICTION": "Prediction",
        "additional_outputs.domain.item1.PREDICTION_STANDARD_ERROR": "Prediction standard error",
        "additional_outputs.domain.item1.PROBABILITY": "Probability",
        "additional_outputs.domain.item1.QUANTILE": "Quantile",
        "additional_outputs.domain.item1.STANDARD_ERROR_INDICATORS": "STANDARD_ERROR_INDICATORS",
        "additional_outputs.dt.title1": "Output surface type",
        "additional_outputs.dt.title2": "Quantile or probability threshold value",
        "additional_outputs.title": "Additional output types",
        "build_transpose.descr": "<xdoc><p>Specifies whether multidimensional transposes will be built on the output multidimensional raster.</p><ul><li>Checked—Multidimensional transposes will be built on the output multidimensional raster.</li><li>Unchecked—Multidimensional transposes will not be built on the output multidimensional raster. This is the default.</li></ul></xdoc>",
        "build_transpose.title": "Build multidimensional transpose",
        "cell_size.descr": "The cell size of the output multidimensional raster.",
        "cell_size.title": "Cell size",
        "description": "Exports a 3D geostatistical layer created using the Empirical Bayesian Kriging 3D tool to a multidimensional Cloud Raster Format (*.crf file) \nraster dataset. Tools in the Multidimensional Analysis toolset of the Image Analyst toolbox are designed to work directly on multidimensional rasters and can identify the 3D nature of the data.",
        "elev_interval.descr": "The increment that the elevation will increase with each iteration.",
        "elev_interval.title": "Elevation interval",
        "elev_units.descr": "<xdoc><p>Specifies the measurement unit of the elevation values.</p><ul><li><span title=\"INCH\">US Survey Inches</span>—Elevations are in U.S. survey inches.</li><li><span title=\"FOOT\">US Survey Feet</span>—Elevations are in U.S. survey feet.</li><li><span title=\"YARD\">US Survey Yards</span>—Elevations are in U.S. survey yards.</li><li><span title=\"MILE_US\">US Survey Miles</span>—Elevations are in U.S. survey miles.</li><li><span title=\"NAUTICAL_MILE\">US Survey Nautical Miles</span>—Elevations are in U.S. survey nautical miles.</li><li><span title=\"MILLIMETER\">Millimeters</span>—Elevations are in millimeters.</li><li><span title=\"CENTIMETER\">Centimeters</span>—Elevations are in centimeters.</li><li><span title=\"DECIMETER\">Decimeters</span>—Elevations are in decimeters.</li><li><span title=\"METER\">Meters</span>—Elevations are in meters.</li><li><span title=\"KILOMETER\">Kilometers</span>—Elevations are in kilometers.</li><li><span title=\"INCH_INT\">International Inches</span>—Elevations are in international inches.</li><li><span title=\"FOOT_INT\">International Feet</span>—Elevations are in international feet.</li><li><span title=\"YARD_INT\">International Yards</span>—Elevations are in international yards.</li><li><span title=\"MILE_INT\">Statute Miles</span>—Elevations are in statute miles.</li><li><span title=\"NAUTICAL_MILE_INT\">International Nautical Miles</span>—Elevations are in international nautical miles.</li></ul></xdoc>",
        "elev_units.domain.CENTIMETER": "Centimeters",
        "elev_units.domain.DECIMETER": "Decimeters",
        "elev_units.domain.FOOT": "US Survey Feet",
        "elev_units.domain.FOOT_INT": "International Feet",
        "elev_units.domain.INCH": "US Survey Inches",
        "elev_units.domain.INCH_INT": "International Inches",
        "elev_units.domain.KILOMETER": "Kilometers",
        "elev_units.domain.METER": "Meters",
        "elev_units.domain.MILE_INT": "Statute Miles",
        "elev_units.domain.MILE_US": "US Survey Miles",
        "elev_units.domain.MILLIMETER": "Millimeters",
        "elev_units.domain.NAUTICAL_MILE": "US Survey Nautical Miles",
        "elev_units.domain.NAUTICAL_MILE_INT": "International Nautical Miles",
        "elev_units.domain.YARD": "US Survey Yards",
        "elev_units.domain.YARD_INT": "International Yards",
        "elev_units.title": "Elevation units",
        "elev_values.descr": "The elevation values to export.",
        "elev_values.title": "Elevation values",
        "explicit_only.descr": "<xdoc><p>Specifies whether elevations will be provided as an explicit list or an iterator will be used. Each elevation will be represented by a dimension in the output multidimensional raster.</p><ul><li>Checked—Elevation values will be provided as a list.</li><li>Unchecked—Elevation values will be provided using an iterator. This is the default.</li></ul></xdoc>",
        "explicit_only.title": "Enter explicit elevation values",
        "in_3d_geostat_layer.descr": "The 3D geostatistical layer representing the model to be exported to a multivariate raster dataset.",
        "in_3d_geostat_layer.title": "Input 3D geostatistical layer",
        "max_elev.descr": "The maximum elevation that will be used to stop the iteration.",
        "max_elev.title": "Maximum elevation",
        "min_elev.descr": "The minimum elevation that will be used to start the iteration.",
        "min_elev.title": "Minimum elevation",
        "out_multidimensional_raster.descr": "The output raster dataset containing the results of exporting the geostatistical model. The output must be saved as a Cloud Raster Format file (*.crf).",
        "out_multidimensional_raster.title": "Output multidimensional raster dataset",
        "output_type.descr": "<xdoc><p>Specifies the primary output type of the output multidimensional raster. The <span class=\"esri_uicontrol\">Additional output types</span> parameter can be used to specify additional variables in the output multidimensional raster.</p><p>For more information, see What output surface types can the interpolation models generate?</p><ul><li><span title=\"PREDICTION\">Prediction</span>—A multidimensional raster of predicted values. This is the default.</li><li><span title=\"PREDICTION_STANDARD_ERROR\">Prediction standard error</span>—A multidimensional raster of standard errors of prediction.</li><li><span title=\"PROBABILITY\">Probability</span>—A multidimensional raster predicting the probability that a threshold is exceeded.</li><li><span title=\"QUANTILE\">Quantile</span>—A multidimensional raster predicting the quantile of the predicted value.</li></ul></xdoc>",
        "output_type.domain.CONDITION_NUMBER": "CONDITION_NUMBER",
        "output_type.domain.PREDICTION": "Prediction",
        "output_type.domain.PREDICTION_STANDARD_ERROR": "Prediction standard error",
        "output_type.domain.PROBABILITY": "Probability",
        "output_type.domain.QUANTILE": "Quantile",
        "output_type.domain.STANDARD_ERROR_INDICATORS": "STANDARD_ERROR_INDICATORS",
        "output_type.title": "Output type",
        "params.category1": "Output Parameters",
        "quantile_probability_value.descr": "<xdoc><p>If <span class=\"esri_uicontrol\">Output type</span> is set to <span class=\"esri_uicontrol\">Quantile</span>, use this parameter to enter the requested quantile. If <span class=\"esri_uicontrol\">Output type</span> is set to <span class=\"esri_uicontrol\">Probability</span>, use this parameter to enter the requested threshold value, and the probability that the threshold is exceeded will be calculated. Subtract this value from one to get the probability that the threshold is not exceeded.</p></xdoc>",
        "quantile_probability_value.title": "Quantile or probability threshold value",
        "summary": "<xdoc><p>Exports a 3D geostatistical layer created using the Empirical Bayesian Kriging 3D tool to a multidimensional Cloud Raster Format (*.crf file) raster dataset. Tools in the Multidimensional Analysis toolset of the Image Analyst toolbox are designed to work directly on multidimensional rasters and can identify the 3D nature of the data.</p><p>3D geostatistical layers store continuous 3D interpolation results and appear as 2D horizontal slices at a given elevation. The current elevation can be changed with the range slider, and the layer will calculate and render the predicted values of the new elevation. Rasters of interpolated predictions can be extracted at any elevation using the GA Layer To Rasters tool. The GA Layer 3D To Multidimensional Raster tool automates the process of extracting rasters at multiple elevations and stores them as a multidimensional raster dataset.</p></xdoc>",
        "title": "GA Layer 3D To Multidimensional Raster"
    }
}
