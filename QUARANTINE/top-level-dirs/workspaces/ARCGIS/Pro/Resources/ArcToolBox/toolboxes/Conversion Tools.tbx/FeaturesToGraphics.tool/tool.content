        },
        "exclude_features": {
            "type": "optional",
            "displayname": "$rc:exclude_features.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "EXCLUDE_FEATURES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "KEEP_FEATURES"
                    }
                ]
            },
            "value": "true",
