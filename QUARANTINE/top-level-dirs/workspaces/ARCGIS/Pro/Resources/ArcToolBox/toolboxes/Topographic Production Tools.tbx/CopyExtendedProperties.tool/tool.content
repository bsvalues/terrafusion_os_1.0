{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "46090005",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "params": {
        "source_job_id": {
            "displayname": "$rc:source_job_id.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:source_job_id.descr"
        },
        "target_job_id": {
            "displayname": "$rc:target_job_id.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:target_job_id.descr"
        },
        "property_table_name": {
            "displayname": "$rc:property_table_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:property_table_name.descr"
        },
        "property_fields": {
            "displayname": "$rc:property_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "description": "$rc:property_fields.descr"
        },
        "database_path": {
            "type": "optional",
            "displayname": "$rc:database_path.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "jtc"
                ]
            },
            "description": "$rc:database_path.descr"
        },
        "updated_job_id": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_job_id.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "-1"
        }
    }
}
