{
    "type": "FunctionTool",
    "guid": "{39a4824a-0211-4b44-86f3-725ef6997c6d}",
    "displayname": "$rc:title",
    "helpcontent": "6010010",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "attributes": [
        "credits"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "in_address_locator": {
            "displayname": "$rc:in_address_locator.title",
            "datatype": {
                "type": "DEAddressLocator"
            },
            "domain": {
                "type": "GPBrowseFiltersDomain",
                "filters": [
                    "esri_browseDialogFilters_locator_can_reverse_geocode"
                ]
            },
            "description": "$rc:in_address_locator.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "domain": {
                "type": "GPBrowseFiltersDomain",
                "filters": [
                    "esri_browseDialogFilters_geodatabaseItems_featureClasses"
                ]
            },
            "description": "$rc:out_feature_class.descr"
        },
        "address_type": {
            "type": "optional",
            "displayname": "$rc:address_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ADDRESS",
                        "code": "$rc:address_type.domain.ADDRESS"
                    },
                    {
                        "value": "INTERSECTION",
                        "code": "$rc:address_type.domain.INTERSECTION"
                    }
                ]
            },
            "value": "ADDRESS",
            "description": "$rc:address_type.descr"
        },
        "search_distance": {
            "type": "optional",
            "displayname": "$rc:search_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "value": "100 Meters",
            "description": "$rc:search_distance.descr"
        },
        "feature_type": {
            "type": "optional",
            "control_guid": "{38C34610-C7F7-11D5-A693-0008C711C8C1}",
            "displayname": "$rc:feature_type.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POINT_ADDRESS",
                        "code": "$rc:feature_type.domain.POINT_ADDRESS"
                    },
                    {
                        "value": "STREET_ADDRESS",
                        "code": "$rc:feature_type.domain.STREET_ADDRESS"
                    },
                    {
                        "value": "STREET_INTERSECTION",
                        "code": "$rc:feature_type.domain.STREET_INTERSECTION"
                    },
                    {
                        "value": "STREET_NAME",
                        "code": "$rc:feature_type.domain.STREET_NAME"
                    },
                    {
                        "value": "LOCALITY",
                        "code": "$rc:feature_type.domain.LOCALITY"
                    },
                    {
                        "value": "POSTAL",
                        "code": "$rc:feature_type.domain.POSTAL"
                    },
                    {
                        "value": "POINT_OF_INTEREST",
                        "code": "$rc:feature_type.domain.POINT_OF_INTEREST"
                    },
                    {
                        "value": "DISTANCE_MARKER",
                        "code": "$rc:feature_type.domain.DISTANCE_MARKER"
                    },
                    {
                        "value": "PARCEL",
                        "code": "$rc:feature_type.domain.PARCEL"
                    },
                    {
                        "value": "SUBADDRESS",
                        "code": "$rc:feature_type.domain.SUBADDRESS"
                    }
                ]
            },
            "description": "$rc:feature_type.descr"
        },
        "location_type": {
            "type": "optional",
            "displayname": "$rc:location_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ROUTING_LOCATION",
                        "code": "$rc:location_type.domain.ROUTING_LOCATION"
                    },
                    {
                        "value": "ADDRESS_LOCATION",
                        "code": "$rc:location_type.domain.ADDRESS_LOCATION"
                    }
                ]
            },
            "value": "ROUTING_LOCATION",
            "description": "$rc:location_type.descr"
        }
    },
    "environments": [
        "outputCoordinateSystem"
    ]
}
