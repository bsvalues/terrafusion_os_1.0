{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\EightyTwentyAnalysis",
    "displayname": "$rc:title",
    "helpcontent": "75000001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "cluster_tolerance": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:cluster_tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Meters",
                    "Kilometers",
                    "MilesInt",
                    "Miles",
                    "Feet",
                    "FeetInt"
                ]
            },
            "description": "$rc:cluster_tolerance.descr"
        },
        "out_fields": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:out_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Text",
                    "Float",
                    "Double",
                    "Short",
                    "Long",
                    "Date"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:out_fields.descr"
        },
        "aggregation_method": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:aggregation_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POINT_CLUSTER",
                        "code": "$rc:aggregation_method.domain.POINT_CLUSTER"
                    },
                    {
                        "value": "CLOSEST_FEATURE",
                        "code": "$rc:aggregation_method.domain.CLOSEST_FEATURE"
                    }
                ]
            },
            "value": "POINT_CLUSTER",
            "description": "$rc:aggregation_method.descr"
        },
        "in_comparison_features": {
            "enabled": "false",
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:in_comparison_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_comparison_features.descr"
        }
    },
    "environments": [
        "MDomain",
        "MResolution",
        "MTolerance",
        "XYDomain",
        "XYResolution",
        "XYTolerance",
        "ZDomain",
        "ZResolution",
        "ZTolerance",
        "autoCommit",
        "configKeyword",
        "extent",
        "geographicTransformations",
        "maintainAttachments",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "qualifiedFieldNames",
        "scratchWorkspace",
        "workspace"
    ]
}
