                    }
                ]
            },
            "value": "FOUR",
            "description": "$rc:number_neighbors.descr"
        },
        "zone_connectivity": {
            "type": "optional",
            "displayname": "$rc:zone_connectivity.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "WITHIN",
                        "code": "$rc:zone_connectivity.domain.WITHIN"
                    },
                    {
                        "value": "CROSS",
                        "code": "$rc:zone_connectivity.domain.CROSS"
                    }
                ]
            },
            "value": "WITHIN",
            "description": "$rc:zone_connectivity.descr"
        },
        "add_link": {
            "type": "optional",
            "displayname": "$rc:add_link.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_LINK"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_LINK"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:add_link.descr"
