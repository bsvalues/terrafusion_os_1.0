                    "Long"
                ],
                "geometrytype": [
                    "Point",
                    "Polygon",
                    "Polyline",
                    "Multipoint"
                ]
            },
            "description": "$rc:in_raster.descr"
        },
        "out_raster": {
            "direction": "out",
            "displayname": "$rc:out_raster.title",
            "datatype": {
                "type": "DERasterDataset"
            },
            "description": "$rc:out_raster.descr"
        },
        "number_neighbors": {
            "type": "optional",
            "displayname": "$rc:number_neighbors.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
