{
    "type": "FunctionTool",
    "guid": "{20de8ed2-89b5-47c1-a412-5761ad1405b2}",
    "displayname": "$rc:title",
    "helpcontent": "5090004",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "9"
    ],
    "attributes": [
        "input_data_change",
        "mCPU"
    ],
    "params": {
        "in_las_dataset": {
            "display_order": "0",
            "displayname": "$rc:in_las_dataset.title",
            "datatype": {
                "type": "GPLasDatasetLayer"
            },
            "description": "$rc:in_las_dataset.descr"
        },
        "method": {
            "type": "optional",
            "display_order": "1",
            "displayname": "$rc:method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "STANDARD",
                        "code": "$rc:method.domain.STANDARD"
                    },
                    {
                        "value": "CONSERVATIVE",
                        "code": "$rc:method.domain.CONSERVATIVE"
                    },
                    {
                        "value": "AGGRESSIVE",
                        "code": "$rc:method.domain.AGGRESSIVE"
                    },
                    {
                        "value": "RECOVER_RIDGES",
                        "code": "$rc:method.domain.RECOVER_RIDGES"
                    }
                ]
            },
            "value": "STANDARD",
            "description": "$rc:method.descr"
        },
        "reuse_ground": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:reuse_ground.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "REUSE_GROUND"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "RECLASSIFY_GROUND"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:reuse_ground.descr"
        },
        "dem_resolution": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:dem_resolution.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:dem_resolution.descr"
        },
        "compute_stats": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:compute_stats.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "COMPUTE_STATS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_COMPUTE_STATS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:compute_stats.descr"
        },
        "extent": {
            "type": "optional",
            "display_order": "13",
            "displayname": "$rc:extent.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPExtent"
            },
            "description": "$rc:extent.descr"
        },
        "boundary": {
            "type": "optional",
            "display_order": "14",
            "displayname": "$rc:boundary.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:boundary.descr"
        },
        "process_entire_files": {
            "type": "optional",
            "display_order": "15",
            "displayname": "$rc:process_entire_files.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "PROCESS_ENTIRE_FILES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "PROCESS_EXTENT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:process_entire_files.descr"
        },
        "out_las_dataset": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_las_dataset.title",
            "datatype": {
                "type": "GPLasDatasetLayer"
            },
            "depends": [
                "in_las_dataset"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "clonedependency": "true"
            }
        },
        "update_pyramid": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:update_pyramid.title",
            "datatype": {
                "type": "GPBoolean"
