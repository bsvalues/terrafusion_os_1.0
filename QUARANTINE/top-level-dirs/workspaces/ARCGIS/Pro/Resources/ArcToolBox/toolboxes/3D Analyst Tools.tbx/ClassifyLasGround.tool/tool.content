                        "value": "LATEST",
                        "code": "$rc:algorithm.domain.LATEST"
                    },
                    {
                        "value": "FIRST",
                        "code": "$rc:algorithm.domain.FIRST"
                    }
                ]
            },
            "value": "LATEST",
            "description": "$rc:algorithm.descr"
        },
        "classify_low_noise": {
