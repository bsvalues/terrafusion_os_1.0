{
    "type": "FunctionTool",
    "guid": "{830a3273-b77a-485a-b076-d89096f1cb96}",
    "displayname": "$rc:title",
    "helpcontent": "3220012",
    "description": "$rc:description",
    "product": "200",
    "params": {
        "in_geodataservice": {
            "displayname": "$rc:in_geodataservice.title",
            "datatype": {
                "type": "DEGeoDataServer"
            },
            "description": "$rc:in_geodataservice.descr"
        },
        "datasets": {
            "control_guid": "{38C34610-C7F7-11D5-A693-0008C711C8C1}",
            "displayname": "$rc:datasets.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "description": "$rc:datasets.descr"
        },
        "in_type": {
            "displayname": "$rc:in_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TWO_WAY_REPLICA",
                        "code": "$rc:in_type.domain.TWO_WAY_REPLICA"
                    },
                    {
                        "value": "ONE_WAY_REPLICA",
                        "code": "$rc:in_type.domain.ONE_WAY_REPLICA"
                    },
                    {
                        "value": "CHECK_OUT",
                        "code": "$rc:in_type.domain.CHECK_OUT"
                    },
                    {
                        "value": "ONE_WAY_CHILD_TO_PARENT_REPLICA",
                        "code": "$rc:in_type.domain.ONE_WAY_CHILD_TO_PARENT_REPLICA"
                    }
                ]
            },
            "value": "TWO_WAY_REPLICA",
            "description": "$rc:in_type.descr"
        },
        "out_geodatabase": {
            "displayname": "$rc:out_geodatabase.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEGeoDataServer"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPBrowseFiltersDomain",
                        "filters": [
                            "esri_browseDialogFilters_geodatabases_file",
                            "esri_browseDialogFilters_geodatabases_egdb_file"
                        ]
                    },
                    {
                        "type": "GPBrowseFiltersDomain",
                        "filters": [
                            "esri_browseDialogFilters_services_geodata"
                        ]
                    }
                ]
            },
            "description": "$rc:out_geodatabase.descr"
        },
        "out_name": {
            "displayname": "$rc:out_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_name.descr"
        },
        "access_type": {
            "type": "optional",
            "displayname": "$rc:access_type.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FULL",
                        "code": "$rc:access_type.domain.FULL"
                    },
                    {
                        "value": "SIMPLE",
                        "code": "$rc:access_type.domain.SIMPLE"
                    }
                ]
            },
            "value": "FULL",
            "description": "$rc:access_type.descr"
        },
        "initial_data_sender": {
            "type": "optional",
            "displayname": "$rc:initial_data_sender.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "CHILD_DATA_SENDER",
                        "code": "$rc:initial_data_sender.domain.CHILD_DATA_SENDER"
                    },
                    {
                        "value": "PARENT_DATA_SENDER",
                        "code": "$rc:initial_data_sender.domain.PARENT_DATA_SENDER"
                    }
                ]
            },
            "value": "CHILD_DATA_SENDER",
            "description": "$rc:initial_data_sender.descr"
        },
        "expand_feature_classes_and_tables": {
            "type": "optional",
            "displayname": "$rc:expand_feature_classes_and_tables.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "USE_DEFAULTS",
                        "code": "$rc:expand_feature_classes_and_tables.domain.USE_DEFAULTS"
                    },
                    {
                        "value": "ADD_WITH_SCHEMA_ONLY",
                        "code": "$rc:expand_feature_classes_and_tables.domain.ADD_WITH_SCHEMA_ONLY"
                    },
                    {
                        "value": "ALL_ROWS",
                        "code": "$rc:expand_feature_classes_and_tables.domain.ALL_ROWS"
                    },
                    {
                        "value": "DO_NOT_ADD",
                        "code": "$rc:expand_feature_classes_and_tables.domain.DO_NOT_ADD"
                    }
                ]
            },
            "value": "USE_DEFAULTS",
            "description": "$rc:expand_feature_classes_and_tables.descr"
        },
        "reuse_schema": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:reuse_schema.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "REUSE",
                        "code": "$rc:reuse_schema.domain.REUSE"
                    },
                    {
                        "value": "DO_NOT_REUSE",
                        "code": "$rc:reuse_schema.domain.DO_NOT_REUSE"
                    }
                ]
            },
            "value": "DO_NOT_REUSE",
            "description": "$rc:reuse_schema.descr"
        },
        "get_related_data": {
            "type": "optional",
            "displayname": "$rc:get_related_data.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "GET_RELATED",
                        "code": "$rc:get_related_data.domain.GET_RELATED"
                    },
                    {
                        "value": "DO_NOT_GET_RELATED",
                        "code": "$rc:get_related_data.domain.DO_NOT_GET_RELATED"
                    }
                ]
            },
            "value": "GET_RELATED",
            "description": "$rc:get_related_data.descr"
        },
        "geometry_features": {
            "type": "optional",
            "displayname": "$rc:geometry_features.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline",
                    "Point",
                    "Multipoint"
                ]
            },
            "description": "$rc:geometry_features.descr"
        },
        "archiving": {
            "displayname": "$rc:archiving.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ARCHIVING"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_USE_ARCHIVING"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:archiving.descr"
