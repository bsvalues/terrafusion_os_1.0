{
    "type": "FunctionTool",
    "guid": "{5efc224b-b7df-4c17-90a7-340954c862d9}",
    "displayname": "$rc:title",
    "helpcontent": "13010006",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{7479dc37-304a-4078-a72f-d5c89b85822a}"
    ],
    "params": {
        "in_network_dataset": {
            "displayname": "$rc:in_network_dataset.title",
            "datatype": {
                "type": "GPNetworkDatasetLayer"
            },
            "description": "$rc:in_network_dataset.descr"
        },
        "out_network_analysis_layer": {
            "displayname": "$rc:out_network_analysis_layer.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_network_analysis_layer.descr"
        },
        "impedance_attribute": {
            "displayname": "$rc:impedance_attribute.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:impedance_attribute.descr"
        },
        "default_cutoff": {
            "type": "optional",
            "displayname": "$rc:default_cutoff.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:default_cutoff.descr"
        },
        "default_number_destinations_to_find": {
            "type": "optional",
            "displayname": "$rc:default_number_destinations_to_find.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:default_number_destinations_to_find.descr"
        },
        "accumulate_attribute_name": {
            "type": "optional",
            "control_guid": "{38C34610-C7F7-11D5-A693-0008C711C8C1}",
            "displayname": "$rc:accumulate_attribute_name.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:accumulate_attribute_name.descr"
        },
        "UTurn_policy": {
            "type": "optional",
            "displayname": "$rc:uturn_policy.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ALLOW_UTURNS",
                        "code": "$rc:uturn_policy.domain.ALLOW_UTURNS"
                    },
                    {
                        "value": "NO_UTURNS",
                        "code": "$rc:uturn_policy.domain.NO_UTURNS"
                    },
                    {
                        "value": "ALLOW_DEAD_ENDS_ONLY",
                        "code": "$rc:uturn_policy.domain.ALLOW_DEAD_ENDS_ONLY"
                    },
                    {
                        "value": "ALLOW_DEAD_ENDS_AND_INTERSECTIONS_ONLY",
                        "code": "$rc:uturn_policy.domain.ALLOW_DEAD_ENDS_AND_INTERSECTIONS_ONLY"
                    }
                ]
            },
            "value": "ALLOW_UTURNS",
            "description": "$rc:uturn_policy.descr"
        },
        "restriction_attribute_name": {
            "type": "optional",
            "control_guid": "{38C34610-C7F7-11D5-A693-0008C711C8C1}",
            "displayname": "$rc:restriction_attribute_name.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:restriction_attribute_name.descr"
        },
        "hierarchy": {
            "type": "optional",
            "displayname": "$rc:hierarchy.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "USE_HIERARCHY"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_HIERARCHY"
                    }
                ]
            },
            "description": "$rc:hierarchy.descr"
        },
        "hierarchy_settings": {
            "type": "optional",
            "displayname": "$rc:hierarchy_settings.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPNAHierarchySettings"
            },
            "depends": [
                "in_network_dataset"
            ],
            "description": "$rc:hierarchy_settings.descr"
        },
        "output_path_shape": {
            "type": "optional",
            "displayname": "$rc:output_path_shape.title",
            "category": "$rc:params.category4",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NO_LINES",
                        "code": "$rc:output_path_shape.domain.NO_LINES"
                    },
                    {
                        "value": "STRAIGHT_LINES",
                        "code": "$rc:output_path_shape.domain.STRAIGHT_LINES"
                    }
                ]
            },
            "value": "STRAIGHT_LINES",
            "description": "$rc:output_path_shape.descr"
        },
        "time_of_day": {
            "type": "optional",
            "displayname": "$rc:time_of_day.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_of_day.descr"
        },
        "output_layer": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_layer.title",
            "datatype": {
                "type": "GPNALayer"
            }
        }
    },
    "environments": [
        "workspace"
    ]
}
