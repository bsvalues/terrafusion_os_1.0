{
    "map": {
        "access_type.descr": "<xdoc><p>Specifies the type of replica access.</p><ul><li><span title=\"FULL\">Full</span>—Complex types such as topologies, are supported and the data must be versioned. This is the default.</li><li><span title=\"SIMPLE\">Simple</span>—The data on the child is not versioned and must be simple. This allows the replica to be interoperable. Nonsimple features in the parent (for example, features in topologies) will be converted to simple features (for example, point, line, and polygon feature classes).</li></ul></xdoc>",
        "access_type.domain.FULL": "Full",
        "access_type.domain.SIMPLE": "Simple",
        "access_type.title": "Replica Access Type",
        "all_records_for_tables.descr": "<xdoc><p>Specifies whether all records or only the schema will be copied to the child geodatabase for tables that do not have filters applied (such as selections or definition queries).</p><p>Tables with applied filters will be honored.</p><p><ul><li>Checked—For tables with no applied filters, all records will be copied to the child geodatabase for tables. This option will override the <span class=\"esri_uicontrol\">Expand Feature Classes and Tables</span> parameter value.</li><li>Unchecked—For tables with no applied filters, only the schema will be copied to the child geodatabase for tables. Tables with applied filters will be honored. This is the default.</li></ul></p></xdoc>",
        "all_records_for_tables.title": "All records for tables",
        "archiving.descr": "<xdoc><p>Specifies whether the archive class will be used to track changes instead of the versioning delta tables. This is only available for one-way replicas.</p><ul><li>Checked—Archiving will be used to track changes.</li><li>Not checked—Archiving will not be used to track changes. This is the default.</li></ul></xdoc>",
        "archiving.title": "Use archiving to track changes for 1 way replication",
        "description": "Creates a replica in a geodatabase from a specified list of feature classes, layers, datasets, and tables in an enterprise geodatabase.",
        "expand_feature_classes_and_tables.descr": "<xdoc><p>Specifies whether expanded feature classes and tables—such as those in networks, topologies, or relationship classes—will be added.</p><ul><li><span title=\"USE_DEFAULTS\">Use defaults</span>—The expanded feature classes and tables related to the feature classes and tables in the replica will be added. The default for feature classes is to replicate all features intersecting the spatial filter. If no spatial filter has been provided, all features will be included. The default for tables is to replicate the schema only. This is the default.</li><li><span title=\"ADD_WITH_SCHEMA_ONLY\">Add with schema only</span>—Only the schema for the expanded feature classes and tables will be added.</li><li><span title=\"ALL_ROWS\">All rows</span>—All rows for expanded feature classes and tables will be added.</li><li><span title=\"DO_NOT_ADD\">Do not add</span>—No expanded feature classes or tables will be added.</li></ul></xdoc>",
        "expand_feature_classes_and_tables.domain.ADD_WITH_SCHEMA_ONLY": "Add with schema only",
        "expand_feature_classes_and_tables.domain.ALL_ROWS": "All rows",
        "expand_feature_classes_and_tables.domain.DO_NOT_ADD": "Do not add",
        "expand_feature_classes_and_tables.domain.USE_DEFAULTS": "Use defaults",
        "expand_feature_classes_and_tables.title": "Expand Feature Classes and Tables",
        "geometry_features.descr": "The features that will be used to define the area to replicate.",
        "geometry_features.title": "Replica Geometry Features",
        "get_related_data.descr": "<xdoc><p>Specifies whether rows related to rows existing in the replica will be replicated. For example, a feature (f1) is inside the replication filter and a related feature (f2) from another class is outside the filter. Feature f2 will be included in the replica if you choose to get related data.</p><ul><li><span title=\"DO_NOT_GET_RELATED\">Do not get related</span>—Related data will not be replicated.</li><li><span title=\"GET_RELATED\">Get related</span>—Related data will be replicated. This is the default.</li></ul></xdoc>",
        "get_related_data.domain.DO_NOT_GET_RELATED": "Do not get related",
        "get_related_data.domain.GET_RELATED": "Get related",
        "get_related_data.title": "Replicate Related Data",
        "in_data.descr": "The data to be replicated. This list consists of layers and tables referencing versioned, editable data from an enterprise geodatabase.",
        "in_data.title": "Replica Datasets",
        "in_type.descr": "<xdoc><p>Specifies the type of replica that will be created.</p><ul><li><span title=\"TWO_WAY_REPLICA\">Two way replica</span>— Changes will be sent between child and parent replicas in both directions.</li><li><span title=\"ONE_WAY_REPLICA\">One way replica</span>—Changes will be sent from the parent replica to the child replica only.</li><li><span title=\"CHECK_OUT\">Check out replica</span>—Data will be replicated, edited, and checked back in one time.</li><li><span title=\"ONE_WAY_CHILD_TO_PARENT_REPLICA\">One way child to parent replica</span>—Changes will be sent from the child replica to the parent replica only.</li></ul></xdoc>",
        "in_type.domain.CHECK_OUT": "Check out replica",
        "in_type.domain.ONE_WAY_CHILD_TO_PARENT_REPLICA": "One way child to parent replica",
        "in_type.domain.ONE_WAY_REPLICA": "One way replica",
        "in_type.domain.TWO_WAY_REPLICA": "Two way replica",
        "in_type.title": "Replica Type",
        "initial_data_sender.descr": "<xdoc><p>Specifies which replica will send changes when in disconnected mode. If you are working in a connected mode, this parameter is inconsequential. This ensures that the relative replica will not send updates until the changes are first received from the initial data sender.</p><ul><li><span title=\"CHILD_DATA_SENDER\">Child data sender</span>—The child replica will be the initial data sender. This is the default.</li><li><span title=\"PARENT_DATA_SENDER\">Parent data sender</span>—The parent replica will be the initial data sender.</li></ul></xdoc>",
        "initial_data_sender.domain.CHILD_DATA_SENDER": "Child data sender",
        "initial_data_sender.domain.PARENT_DATA_SENDER": "Parent data sender",
        "initial_data_sender.title": "Initial Data Sender",
        "out_child_geodatabase.title": "Output Child Workspace",
        "out_filegdb_folder_path.descr": "<xdoc><p>The location of the file geodatabase that will be created to host the child replica. This parameter is required if the <span class=\"esri_uicontrol\">Output Type</span> parameter is set to <span class=\"esri_uicontrol\">New file geodatabase</span> and is only valid for one-way and checkout replicas.</p></xdoc>",
        "out_filegdb_folder_path.title": "File geodatabase location",
        "out_filegdb_name.descr": "<xdoc><p>The name of the file geodatabase that will be created to host the child replica. This parameter is required if the <span class=\"esri_uicontrol\">Output Type</span> parameter is set to <span class=\"esri_uicontrol\">New file geodatabase</span> and is only valid for one-way and checkout replicas.</p></xdoc>",
        "out_filegdb_name.title": "File geodatabase name",
        "out_geodatabase.descr": "<xdoc><p>The geodatabase that will host the child replica. Geodata services are used to represent remote geodatabases. The geodatabase can be an enterprise or file geodatabase. For two-way and one-way-child-to-parent replicas, the child geodatabase must be an enterprise geodatabase. For one-way and checkout replicas, the geodatabase can be a file or enterprise geodatabase.</p><p>This parameter is required if the <span class=\"esri_uicontrol\">Output Type</span> parameter is set to <span class=\"esri_uicontrol\">Geodatabase</span>.</p></xdoc>",
        "out_geodatabase.title": "Geodatabase to replicate data to",
        "out_name.descr": "The name that identifies the replica.",
        "out_name.title": "Replica Name",
        "out_type.descr": "<xdoc><p>Specifies the output type of the data that will be replicated.</p><ul><li><span title=\"GEODATABASE\">Geodatabase</span>—The data will be replicated to an existing geodatabase. This is the default.</li><li><span title=\"XML_FILE\">Xml file</span>—The data will be replicated to an XML workspace document.</li><li><span title=\"NEW_FILE_GEODATABASE\">New file geodatabase</span>—The data will be replicated to a new file geodatabase that will be created when the tool is run. Provide the location and name of the new file geodatabase in the <span class=\"esri_uicontrol\">File geodatabase location</span> parameter. This option is only valid for one-way and checkout replicas.</li></ul></xdoc>",
        "out_type.domain.GEODATABASE": "Geodatabase",
        "out_type.domain.NEW_FILE_GEODATABASE": "New file geodatabase",
        "out_type.domain.XML_FILE": "Xml file",
        "out_type.title": "Output Type",
        "out_xml.descr": "<xdoc><p>The name and location of the .xml file that will be created.</p><p>This parameter is required if the <span class=\"esri_uicontrol\">Output Type</span> parameter is set to <span class=\"esri_uicontrol\">Xml file</span>.</p></xdoc>",
        "out_xml.title": "XML file to replicate data to",
        "output_replica_name.title": "Output Replica Name",
        "params.category1": "Advanced Setting",
        "register_existing_data.descr": "<xdoc><p>Specifies whether existing data in the child geodatabase will be used to register the replica datasets. The datasets in the child geodatabase must have the same names as the datasets in the parent database and be owned by the user that is connected to the child geodatabase.<ul><li>Checked—Existing data in the child geodatabase will be used to register the replica.</li><li>Unchecked—Data in the parent geodatabase will be copied to the child geodatabase. This is the default.</li></ul></p></xdoc>",
        "register_existing_data.title": "Register existing data only",
        "reuse_schema.descr": "<xdoc><p>Specifies whether a geodatabase that contains the schema of the data to be replicated will be reused. This reduces the amount of time required to replicate the data. This parameter is only available for checkout replicas.</p><ul><li><span title=\"DO_NOT_REUSE\">Do not reuse</span>—Schema will not be reused. This is the default.</li><li><span title=\"REUSE\">Reuse</span>—Schema will be used.</li></ul></xdoc>",
        "reuse_schema.domain.DO_NOT_REUSE": "Do not reuse",
        "reuse_schema.domain.REUSE": "Reuse",
        "reuse_schema.title": "Re-use Schema",
        "title": "Create Replica"
    }
}
