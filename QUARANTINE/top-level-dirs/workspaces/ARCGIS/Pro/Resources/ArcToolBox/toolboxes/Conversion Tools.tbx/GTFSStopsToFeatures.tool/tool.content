{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "2140001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_gtfs_stops_file": {
            "displayname": "$rc:in_gtfs_stops_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "txt"
                ]
            },
            "description": "$rc:in_gtfs_stops_file.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        }
    },
    "environments": [
        "workspace"
    ]
}
