{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "62020002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "online_report_template_id": {
            "displayname": "$rc:online_report_template_id.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:online_report_template_id.descr"
        },
        "output_folder": {
            "type": "optional",
            "displayname": "$rc:output_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:output_folder.descr"
        },
        "dataset_id": {
            "type": "optional",
            "displayname": "$rc:dataset_id.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:dataset_id.descr"
        },
        "config": {
            "type": "optional",
            "displayname": "$rc:config.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:config.descr"
        },
        "updated_folder": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_folder.title",
            "datatype": {
                "type": "GPString"
            }
        }
    },
    "environments": [
        "baDataSource",
        "workspace"
    ]
}
