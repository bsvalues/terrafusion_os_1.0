        "to_route_id_field.descr": "<xdoc><p>Name of the to route ID field. Required only if the geometry type is a line and the <span class=\"esri_uicontrol\">Event Spans Routes</span> check box is checked.</p></xdoc>",
        "to_route_id_field.title": "To Route ID Field",
        "to_route_name_field.descr": "<xdoc><p>The to route name field for line events that span routes. Required if <span class=\"esri_uicontrol\">Store Route Name</span> is checked.</p></xdoc>",
