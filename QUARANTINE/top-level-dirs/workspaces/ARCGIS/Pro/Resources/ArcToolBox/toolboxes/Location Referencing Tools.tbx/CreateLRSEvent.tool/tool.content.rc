        "event_id_field.title": "Event ID Field",
        "event_name.descr": "The event to be registered.",
        "event_name.title": "Event Name",
        "event_spans_routes.descr": "<xdoc><p>Specifies whether the event records spans routes.</p><ul><li>Checked—The event records span routes.</li><li>Unchecked—The event records do not span routes. This is the default.</li></ul></xdoc>",
        "event_spans_routes.title": "Event Spans Routes",
        "from_date_field.descr": "The from date field available in the event feature class.",
        "from_date_field.title": "From Date Field",
        "geometry_type.descr": "<xdoc><p>The geometry type of the output event.</p><ul><li><span title=\"POINT\">Point</span>—The geometry type of the event is Point. This is the default.</li><li><span title=\"LINE\">Line</span>—The geometry type of the event is Polyline.</li></ul></xdoc>",
        "geometry_type.domain.LINE": "Line",
        "geometry_type.domain.POINT": "Point",
