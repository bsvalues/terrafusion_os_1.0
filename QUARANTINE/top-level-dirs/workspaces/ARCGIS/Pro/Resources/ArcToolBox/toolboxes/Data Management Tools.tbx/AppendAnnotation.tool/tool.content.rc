{
    "map": {
        "create_annotation_when_feature_added.descr": "<xdoc><p>Specifies whether feature-linked annotation will be created when a feature is added.</p><ul><li>Checked—Feature-linked annotation will be created using the label engine when a linked feature is added. This is the default.</li><li>Unchecked—Feature-linked annotation will not be created when a feature is added.</li></ul></xdoc>",
        "create_annotation_when_feature_added.title": "Create annotation when new features are added (Feature-linked only)",
        "create_single_class.descr": "<xdoc><p>Specifies how annotation features will be added to the output feature class.</p><ul><li>Checked—All annotation features will be aggregated into one annotation class in the output feature class.</li><li>Unchecked—Separate annotation classes will be created for each input annotation class in the output feature class unless the classes are named the same and have the same properties. In this case, they will be merged. This is the default.</li></ul></xdoc>",
        "create_single_class.title": "Create a single annotation class",
        "description": "Creates a geodatabase annotation feature class or appends to an existing annotation feature class by combining annotation from multiple input geodatabase annotation feature classes into a single feature class with annotation classes.",
        "input_features.descr": "The input annotation features that will form an annotation class in the output feature class.",
        "input_features.title": "Input features",
        "output_featureclass.descr": "A new or existing annotation feature class that will contain an annotation class for each input annotation feature class.",
        "output_featureclass.title": "Output feature class",
        "reference_scale.descr": "The reference scale set in the output feature class. Input features created at a different reference scale will be transformed to match this output reference scale.",
        "reference_scale.title": "Reference scale",
        "require_symbol_from_table.descr": "<xdoc><p>Specifies how symbols can be selected for newly created annotation features.</p><ul><li>Checked—Only the list of symbols in the symbol collection of the output feature class can be used when creating annotation features.</li><li>Unchecked—Any symbology can be used when creating annotation features. This is the default.</li></ul></xdoc>",
        "require_symbol_from_table.title": "Require symbols to be selected from the symbol table",
        "title": "Append Annotation Feature Classes",
        "update_annotation_when_feature_modified.descr": "<xdoc><p>Specifies whether feature-linked annotation will be updated when a linked feature changes.</p><ul><li>Checked—Feature-linked annotation will be updated using the label engine when a linked feature changes. This is the default.</li><li>Unchecked—Feature-linked annotation will not be updated when a linked feature changes.</li></ul></xdoc>",
        "update_annotation_when_feature_modified.title": "Update annotation when the shape of the linked feature is modified (Feature-linked only)"
    }
}
