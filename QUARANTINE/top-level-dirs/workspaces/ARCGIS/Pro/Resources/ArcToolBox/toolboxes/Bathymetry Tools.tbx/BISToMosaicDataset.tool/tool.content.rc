{
    "map": {
        "coordinate_system.descr": "<xdoc><p>The coordinate system that will be used for all items in the mosaic dataset.</p><p>If no coordinate system is provided, WGS84 Web Mercator (auxiliary sphere) will be used by default.</p></xdoc>",
        "coordinate_system.title": "Coordinate System",
        "create_overviews.descr": "<xdoc><p>Specifies whether overviews for a mosaic dataset will be defined and generated.</p><ul><li>Checked—Overviews will be defined and generated.</li><li>Unchecked—Overviews will not be defined or generated. This is the default.</li></ul></xdoc>",
        "create_overviews.title": "Create Overviews",
        "description": "Creates a mosaic dataset from a Bathymetric Information System (BIS).",
        "force_overview_tiles.descr": "<xdoc><p>Specifies whether overviews will be created at all levels or only above existing pyramid levels.</p><ul><li>Checked—Overviews will be created at all levels.</li><li>Unchecked—Overviews will only be created above the raster pyramid levels. This is the default.</li></ul></xdoc>",
        "force_overview_tiles.title": "Force Overview Tiles",
        "in_bis_workspace.descr": "The enterprise or file geodatabase where the BIS workspace is located.",
        "in_bis_workspace.title": "Input BIS Workspace",
        "in_query_file.descr": "<xdoc><p>The model or rule file that defines the datasets and sorting order that will be applied to the rasters included in the output mosaic dataset.</p><ul><li>Model file (*.model)—Defines the data to be exported from the BIS. Only the specified rasters will be exported to the mosaic dataset.</li><li>Rule file (*.rule)—Defines the sorting order rules for the output data. All rasters in the BIS will be exported to the mosaic dataset.</li></ul><p>If no query file is provided, all rasters in the BIS will be exported.</p></xdoc>",
        "in_query_file.title": "Query File",
        "out_mosaic.descr": "The output mosaic dataset.",
        "out_mosaic.title": "Output Mosaic Dataset",
        "params.category1": "Overviews",
        "title": "BIS To Mosaic Dataset"
    }
}
