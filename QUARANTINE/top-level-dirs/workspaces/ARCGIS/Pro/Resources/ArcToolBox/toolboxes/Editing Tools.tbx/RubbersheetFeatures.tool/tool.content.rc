{
    "map": {
        "description": "Modifies input features by spatially adjusting them through rubbersheeting, using the specified rubbersheet links, so they are better aligned with the intended target features.",
        "in_features.descr": "The input features that will be adjusted. They can be points, lines, polygons, or annotations.",
        "in_features.title": "Input Features",
        "in_identity_links.descr": "The input point features representing identity links for rubbersheeting.",
        "in_identity_links.title": "Input Point Features As Identity Links",
        "in_link_features.descr": "The input line features representing regular links for rubbersheeting.",
        "in_link_features.title": "Input Link Features",
        "method.descr": "<xdoc><p>Specifies the rubbersheeting method that will be used to adjust features.</p><ul><li><span title=\"LINEAR\">Linear</span>—This method is slightly faster and produces good results when you have many links spread uniformly over the data you are adjusting. This is the default.</li><li><span title=\"NATURAL_NEIGHBOR\">Natural neighbor</span>—This method should be used when you have few links spaced widely apart.</li></ul></xdoc>",
        "method.domain.LINEAR": "Linear",
        "method.domain.NATURAL_NEIGHBOR": "Natural neighbor",
        "method.title": "Method",
        "out_feature_class.title": "Modified Input Features",
        "title": "Rubbersheet Features"
    }
