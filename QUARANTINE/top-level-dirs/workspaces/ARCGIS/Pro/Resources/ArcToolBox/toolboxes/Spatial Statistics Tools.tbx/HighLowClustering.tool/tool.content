{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\HighLowClustering",
    "displayname": "$rc:title",
    "helpcontent": "9010001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Feature_Class": {
            "displayname": "$rc:input_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_feature_class.descr"
        },
        "Input_Field": {
            "displayname": "$rc:input_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "Input_Feature_Class"
            ],
            "description": "$rc:input_field.descr"
        },
        "Generate_Report": {
            "type": "optional",
            "displayname": "$rc:generate_report.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "GENERATE_REPORT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_REPORT"
                    }
                ]
            },
            "description": "$rc:generate_report.descr"
        },
        "Conceptualization_of_Spatial_Relationships": {
            "displayname": "$rc:conceptualization_of_spatial_relationships.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INVERSE_DISTANCE",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.INVERSE_DISTANCE"
                    },
                    {
                        "value": "INVERSE_DISTANCE_SQUARED",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.INVERSE_DISTANCE_SQUARED"
                    },
                    {
                        "value": "FIXED_DISTANCE_BAND",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.FIXED_DISTANCE_BAND"
                    },
                    {
                        "value": "ZONE_OF_INDIFFERENCE",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.ZONE_OF_INDIFFERENCE"
                    },
                    {
                        "value": "K_NEAREST_NEIGHBORS",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.K_NEAREST_NEIGHBORS"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_ONLY",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.CONTIGUITY_EDGES_ONLY"
                    },
                    {
                        "value": "CONTIGUITY_EDGES_CORNERS",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.CONTIGUITY_EDGES_CORNERS"
                    },
                    {
                        "value": "GET_SPATIAL_WEIGHTS_FROM_FILE",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.GET_SPATIAL_WEIGHTS_FROM_FILE"
                    }
                ]
            },
            "value": "INVERSE_DISTANCE",
            "description": "$rc:conceptualization_of_spatial_relationships.descr"
        },
        "Distance_Method": {
            "displayname": "$rc:distance_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "EUCLIDEAN_DISTANCE",
                        "code": "$rc:distance_method.domain.EUCLIDEAN_DISTANCE"
                    },
                    {
                        "value": "MANHATTAN_DISTANCE",
                        "code": "$rc:distance_method.domain.MANHATTAN_DISTANCE"
                    }
                ]
            },
            "value": "EUCLIDEAN_DISTANCE",
            "description": "$rc:distance_method.descr"
        },
        "Standardization": {
            "displayname": "$rc:standardization.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NONE",
                        "code": "$rc:standardization.domain.NONE"
                    },
                    {
                        "value": "ROW",
                        "code": "$rc:standardization.domain.ROW"
                    }
                ]
            },
            "value": "ROW",
            "description": "$rc:standardization.descr"
        },
        "Distance_Band_or_Threshold_Distance": {
            "type": "optional",
            "displayname": "$rc:distance_band_or_threshold_distance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "999999999999999"
            },
            "description": "$rc:distance_band_or_threshold_distance.descr"
        },
        "Weights_Matrix_File": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:weights_matrix_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "swm",
                    "gwt",
                    "txt"
                ]
            },
            "description": "$rc:weights_matrix_file.descr"
        },
        "Observed_General_G": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:observed_general_g.title",
            "datatype": {
                "type": "GPDouble"
            }
        },
        "ZScore": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:zscore.title",
            "datatype": {
                "type": "GPDouble"
            }
        },
        "PValue": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:pvalue.title",
            "datatype": {
                "type": "GPDouble"
            }
        },
        "Report_File": {
            "enabled": "false",
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:report_file.title",
            "datatype": {
                "type": "DEFile"
            }
        },
        "number_of_neighbors": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:number_of_neighbors.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "2",
                "max": "1000"
            },
            "description": "$rc:number_of_neighbors.descr"
        }
    },
    "environments": [
        "geographicTransformations",
        "outputCoordinateSystem",
        "scratchWorkspace",
        "workspace"
    ]
}
