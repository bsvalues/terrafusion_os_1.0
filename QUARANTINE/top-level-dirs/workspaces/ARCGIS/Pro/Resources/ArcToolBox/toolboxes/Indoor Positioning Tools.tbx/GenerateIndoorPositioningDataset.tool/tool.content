{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "78000008",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "input_data_change",
        "param_nocount:target_ips_datasets"
    ],
    "params": {
        "target_ips_positioning_datasets": {
            "displayname": "$rc:target_ips_positioning_datasets.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:target_ips_positioning_datasets.descr"
        },
        "dataset_name": {
            "displayname": "$rc:dataset_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:dataset_name.descr"
        },
        "generation_method": {
            "displayname": "$rc:generation_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SURVEY_BASED",
                        "code": "$rc:generation_method.domain.SURVEY_BASED"
                    },
                    {
                        "value": "SURVEY_LESS",
                        "code": "$rc:generation_method.domain.SURVEY_LESS"
                    }
                ]
            },
            "value": "SURVEY_BASED",
            "description": "$rc:generation_method.descr"
        },
        "in_levels": {
            "displayname": "$rc:in_levels.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_levels.descr"
        },
        "in_ips_recordings": {
            "type": "optional",
            "displayname": "$rc:in_ips_recordings.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_ips_recordings.descr"
        },
        "in_beacons": {
            "type": "optional",
            "displayname": "$rc:in_beacons.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_beacons.descr"
        },
        "in_ips_areas": {
            "type": "optional",
            "displayname": "$rc:in_ips_areas.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_ips_areas.descr"
        },
        "in_walls": {
            "type": "optional",
            "displayname": "$rc:in_walls.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_walls.descr"
        },
        "out_ips_datasets": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_ips_datasets.title",
            "datatype": {
                "type": "GPTableView"
            },
            "depends": [
                "target_ips_positioning_datasets"
            ],
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "update_existing": {
            "type": "optional",
            "display_order": "1",
            "displayname": "$rc:update_existing.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "UPDATE_EXISTING"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_UPDATE_EXISTING"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:update_existing.descr"
        },
        "existing_dataset": {
            "type": "optional",
            "display_order": "1",
            "displayname": "$rc:existing_dataset.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:existing_dataset.descr"
        }
    },
    "environments": [
        "workspace"
    ]
}
