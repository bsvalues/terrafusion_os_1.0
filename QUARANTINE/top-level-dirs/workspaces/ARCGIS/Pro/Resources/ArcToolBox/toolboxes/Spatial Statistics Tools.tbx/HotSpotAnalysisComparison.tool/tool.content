{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\HotSpotAnalysisComparison",
    "displayname": "$rc:title",
    "helpcontent": "9060015",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_hot_spot_1": {
            "displayname": "$rc:in_hot_spot_1.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Point",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_hot_spot_1.descr"
        },
        "in_hot_spot_2": {
            "displayname": "$rc:in_hot_spot_2.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Point",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_hot_spot_2.descr"
        },
        "out_features": {
            "direction": "out",
            "displayname": "$rc:out_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_features.descr"
        },
        "num_neighbors": {
            "type": "optional",
            "displayname": "$rc:num_neighbors.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "10000000000"
            },
            "value": "8",
            "description": "$rc:num_neighbors.descr"
        },
        "num_perms": {
            "type": "optional",
            "displayname": "$rc:num_perms.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLong",
                        "value": "99",
                        "code": "99"
                    },
                    {
                        "type": "GPLong",
                        "value": "199",
                        "code": "199"
                    },
                    {
                        "type": "GPLong",
                        "value": "499",
                        "code": "499"
                    },
                    {
                        "type": "GPLong",
                        "value": "999",
                        "code": "999"
                    },
                    {
                        "type": "GPLong",
                        "value": "9999",
                        "code": "9999"
                    }
                ]
            },
            "value": "499",
            "description": "$rc:num_perms.descr"
        },
        "weighting_method": {
            "type": "optional",
            "displayname": "$rc:weighting_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FUZZY",
                        "code": "$rc:weighting_method.domain.FUZZY"
                    },
                    {
                        "value": "EXACT_MATCH",
                        "code": "$rc:weighting_method.domain.EXACT_MATCH"
                    },
                    {
                        "value": "ABOVE_90",
                        "code": "$rc:weighting_method.domain.ABOVE_90"
                    },
                    {
                        "value": "ABOVE_95",
                        "code": "$rc:weighting_method.domain.ABOVE_95"
                    },
                    {
                        "value": "ABOVE_99",
                        "code": "$rc:weighting_method.domain.ABOVE_99"
                    },
                    {
                        "value": "CUSTOM",
                        "code": "$rc:weighting_method.domain.CUSTOM"
                    },
                    {
                        "value": "TABLE",
                        "code": "$rc:weighting_method.domain.TABLE"
                    },
                    {
                        "value": "REVERSE",
                        "code": "$rc:weighting_method.domain.REVERSE"
                    }
                ]
            },
            "value": "FUZZY",
            "description": "$rc:weighting_method.descr"
        },
        "similarity_weights": {
            "enabled": "false",
            "type": "optional",
            "control_guid": "{11AE45C5-5372-4422-920E-869CE4ED054B}",
            "displayname": "$rc:similarity_weights.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPString",
                        "displayname": "$rc:similarity_weights.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:similarity_weights.dt.title2"
                    },
                    {
                        "type": "GPDouble",
                        "displayname": "$rc:similarity_weights.dt.title3"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "-3",
                                "code": "$rc:similarity_weights.domain.item1.-3"
                            },
                            {
                                "value": "-2",
                                "code": "$rc:similarity_weights.domain.item1.-2"
                            },
                            {
                                "value": "-1",
                                "code": "$rc:similarity_weights.domain.item1.-1"
                            },
                            {
                                "value": "0",
                                "code": "$rc:similarity_weights.domain.item1.0"
                            },
                            {
                                "value": "1",
                                "code": "$rc:similarity_weights.domain.item1.1"
                            },
                            {
                                "value": "2",
                                "code": "$rc:similarity_weights.domain.item1.2"
                            },
                            {
                                "value": "3",
                                "code": "$rc:similarity_weights.domain.item1.3"
                            }
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "-3",
                                "code": "$rc:similarity_weights.domain.item2.-3"
                            },
                            {
                                "value": "-2",
                                "code": "$rc:similarity_weights.domain.item2.-2"
                            },
                            {
                                "value": "-1",
                                "code": "$rc:similarity_weights.domain.item2.-1"
                            },
                            {
                                "value": "0",
                                "code": "$rc:similarity_weights.domain.item2.0"
                            },
                            {
                                "value": "1",
                                "code": "$rc:similarity_weights.domain.item2.1"
                            },
                            {
                                "value": "2",
                                "code": "$rc:similarity_weights.domain.item2.2"
                            },
                            {
                                "value": "3",
                                "code": "$rc:similarity_weights.domain.item2.3"
                            }
                        ]
                    },
                    {
                        "type": "GPRangeDomain",
                        "min": "0",
                        "max": "1"
                    }
                ]
            },
            "description": "$rc:similarity_weights.descr"
        },
        "in_weights_table": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:in_weights_table.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:in_weights_table.descr"
        },
        "exclude_nonsig_features": {
            "type": "optional",
            "displayname": "$rc:exclude_nonsig_features.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "EXCLUDE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_EXCLUDE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:exclude_nonsig_features.descr"
        },
        "SIM_VALUE": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:sim_value.title",
            "datatype": {
                "type": "GPDouble"
            }
        },
        "EXP_SIM_VALUE": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:exp_sim_value.title",
            "datatype": {
                "type": "GPDouble"
            }
        },
        "KAPPA": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:kappa.title",
            "datatype": {
                "type": "GPDouble"
            }
        },
        "output_layer_group": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_layer_group.title",
            "datatype": {
                "type": "GPGroupLayer"
            }
        }
    },
    "environments": [
        "XYTolerance",
        "geographicTransformations",
        "outputCoordinateSystem",
        "randomGenerator"
    ]
}
