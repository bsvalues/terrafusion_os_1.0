{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\FindHighestLowestPoint",
    "displayname": "$rc:title",
    "helpcontent": "74040001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_surface": {
            "display_order": "0",
            "displayname": "$rc:in_surface.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "DEMosaicDataset"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:in_surface.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "symbologylayer": "MT_Highest_Point_Output.lyrx",
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "high_low_operation_type": {
            "display_order": "2",
            "displayname": "$rc:high_low_operation_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "HIGHEST",
                        "code": "$rc:high_low_operation_type.domain.HIGHEST"
                    },
                    {
                        "value": "LOWEST",
                        "code": "$rc:high_low_operation_type.domain.LOWEST"
                    }
                ]
            },
            "value": "HIGHEST",
            "description": "$rc:high_low_operation_type.descr"
        },
        "in_feature": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:in_feature.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_feature.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "scratchWorkspace",
        "workspace"
    ]
}
