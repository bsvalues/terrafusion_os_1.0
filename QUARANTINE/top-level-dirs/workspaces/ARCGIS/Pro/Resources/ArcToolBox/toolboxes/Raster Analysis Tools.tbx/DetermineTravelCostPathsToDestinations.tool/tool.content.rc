{
    "map": {
        "description": "Calculates specific paths between known sources and known destinations.",
        "destinationfield.descr": "<xdoc><p>A field on the destination layer that holds the values that define each destination.</p><p>Input feature service must contain at least one valid field.</p></xdoc>",
        "destinationfield.title": "Destination Field",
        "inputcostbacklinkraster.descr": "<xdoc><p>The name of a cost back link raster used to determine the path to return to a source via the least-cost path.</p><p>For each cell in the back link raster, a value identifies the neighbor that is the next cell on the least accumulative cost path from the cell to a single source cell or set of source cells.</p></xdoc>",
        "inputcostbacklinkraster.title": "Input Cost Backlink Raster",
        "inputcostdistanceraster.descr": "<xdoc><p>The name of a cost distance image service to be used to determine the least-cost path from the destination locations to a source.</p><p>The cost distance raster is usually created with the Calculate Travel Cost tool. The cost distance raster stores, for each cell, the minimum accumulative cost distance over a cost surface from each cell to a set of source cells.</p></xdoc>",
        "inputcostdistanceraster.title": "Input Cost Distance Raster",
        "inputdestinationrasterorfeatures.descr": "<xdoc><p>An image service or feature service that identifies the cells from which the least-cost path is determined to the least costly source.</p><p>If the input is an image service, the input consists of cells that have valid values (zero is a valid value), and the remaining cells must be assigned NoData.</p></xdoc>",
        "inputdestinationrasterorfeatures.title": "Input Destination Raster or Features",
        "outputname.descr": "<xdoc><p>The name of the output travel cost paths raster service.</p><p>The default name is based on the tool name and the input layer name. If the layer name already exists, you will be prompted to provide another name.</p></xdoc>",
        "outputname.title": "Output Name",
        "outputraster.title": "Output Raster",
        "pathtype.descr": "<xdoc><p>Defines the manner in which the values and zones on the input destination data will be interpreted in the cost path calculations.</p><ul><li><span title=\"EACH_CELL\">To each cell</span>—For each cell with valid values on the input destination data, a least-cost path is determined and saved on the output raster. With this option, each cell of the input destination data is treated separately, and a least-cost path is determined for each from cell. This is the default.</li><li><span title=\"EACH_ZONE\">To each zone</span>—For each zone on the input destination data, a least-cost path is determined and saved on the output raster. With this option, the least-cost path for each zone begins at the cell with the lowest cost distance weighting in the zone.</li><li><span title=\"BEST_SINGLE\">Best single</span>—For all cells on the input destination data, the least-cost path is derived from the cell with the minimum of the least-cost paths to source cells.</li></ul></xdoc>",
        "pathtype.domain.BEST_SINGLE": "Best single",
        "pathtype.domain.EACH_CELL": "To each cell",
        "pathtype.domain.EACH_ZONE": "To each zone",
        "pathtype.title": "Path Type",
        "summary": "<xdoc><p>Calculates specific paths between known sources and known destinations.</p><note type=\"legacy\"/><p group=\"note\">This tool is deprecated and will be removed in a future release.</p><p group=\"note\">The Optimal Path As Raster tool provides enhanced functionality or performance.</p></xdoc>",
        "title": "Determine Travel Cost Paths To Destinations"
    }
}
