    "map": {
        "append_data.descr": "<xdoc><p>Specifies whether the records being loaded will be appended or replaced.</p><ul><li>Checked—The records being loaded to the specified level will be appended.</li><li>Unchecked—The records being loaded to the specified level will be replaced. This is the default.</li></ul></xdoc>",
        "append_data.title": "Append Data",
        "description": "Adds records (features) or updates existing records for the specified level.",
        "field_map.descr": "<xdoc><p>The values that will be used for the territory properties.</p><p><ul><li>Parent Territory ID—The ID of the parent territory.</li><li>Locked State—The territory can&apos;t be modified.</li><li>Center Locked—Center points can&apos;t be modified and will remain in their fixed locations.</li></ul></p></xdoc>",
