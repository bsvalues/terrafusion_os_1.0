{
    "map": {
        "calculation_interval.descr": "<xdoc><p>Specifies the temporal interval that will be used to calculate the mean.</p><ul><li><span title=\"ALL\">All</span>—The mean is calculated across all slices for each pixel.</li><li><span title=\"YEARLY\">Yearly</span>—The yearly mean is calculated for each pixel.</li><li><span title=\"RECURRING_MONTHLY\">Recurring monthly</span>—The monthly mean is calculated for each pixel.</li><li><span title=\"RECURRING_WEEKLY\">Recurring weekly</span>—The weekly mean is calculated for each pixel.</li><li><span title=\"RECURRING_DAILY\">Recurring daily</span>—The daily mean is calculated for each pixel.</li><li><span title=\"HOURLY\">Hourly</span>—The hourly mean is calculated for each pixel.</li><li><span title=\"EXTERNAL_RASTER\">External raster</span>—An existing raster dataset that contains the mean or median value for each pixel is referenced.</li></ul></xdoc>",
        "calculation_interval.domain.ALL": "All",
        "calculation_interval.domain.EXTERNAL_RASTER": "External raster",
        "calculation_interval.domain.HOURLY": "Hourly",
        "calculation_interval.domain.RECURRING_DAILY": "Recurring daily",
        "calculation_interval.domain.RECURRING_MONTHLY": "Recurring monthly",
        "calculation_interval.domain.RECURRING_WEEKLY": "Recurring weekly",
        "calculation_interval.domain.YEARLY": "Yearly",
        "calculation_interval.title": "Mean Calculation Interval",
        "description": "Computes the anomaly for each slice in an existing multidimensional raster to generate a new multidimensional raster.",
        "ignore_nodata.descr": "<xdoc><p>Specifies whether NoData values will be ignored in the analysis.</p><ul><li>Checked—The analysis will include all valid pixels along a given dimension and ignore NoData pixels. This is the default.</li><li>Unchecked—The analysis will result in NoData if there are NoData values for the pixels along the given dimension.</li></ul></xdoc>",
        "ignore_nodata.title": "Ignore NoData",
        "in_multidimensional_raster.descr": "The input multidimensional raster dataset.",
        "in_multidimensional_raster.title": "Input Multidimensional Raster",
        "method.descr": "<xdoc><p>Specifies the method that will be used to calculate the anomaly.</p><ul><li><span title=\"DIFFERENCE_FROM_MEAN\">Difference From Mean</span>—The difference between a pixel&apos;s value and the mean of that pixel&apos;s values across slices defined by the interval will be calculated. This is the default.</li><li><span title=\"PERCENT_DIFFERENCE_FROM_MEAN\">Percent Difference From Mean</span>—The percent difference between a pixel&apos;s value and the mean of that pixel&apos;s values across slices defined by the interval will be calculated.</li><li><span title=\"PERCENT_OF_MEAN\">Percent Of Mean</span>—The percent of the mean will be calculated.</li><li><span title=\"Z_SCORE\">Z-score</span>—The z-score for each pixel will be calculated. A z-score of 0 indicates the pixel&apos;s value is identical to the mean. A z-score of 1 indicates the pixel&apos;s value is 1 standard deviation from the mean. If a z-score is 2, the pixel&apos;s value is 2 standard deviations from the mean, and so on.</li><li><span title=\"DIFFERENCE_FROM_MEDIAN\">Difference From Median</span>—The difference between a pixel&apos;s value and the mathematical median of that pixel&apos;s values across slices defined by the interval will be calculated.</li><li><span title=\"PERCENT_DIFFERENCE_FROM_MEDIAN\">Percent Difference From Median</span>—The percent difference between a pixel&apos;s value and the mathematical median of that pixel&apos;s values across slices defined by the interval will be calculated.</li><li><span title=\"PERCENT_OF_MEDIAN\">Percent Of Median</span>—The percent of the mathematical median will be calculated.</li></ul></xdoc>",
        "method.domain.DIFFERENCE_FROM_MEAN": "Difference From Mean",
        "method.domain.DIFFERENCE_FROM_MEDIAN": "Difference From Median",
        "method.domain.PERCENT_DIFFERENCE_FROM_MEAN": "Percent Difference From Mean",
        "method.domain.PERCENT_DIFFERENCE_FROM_MEDIAN": "Percent Difference From Median",
        "method.domain.PERCENT_OF_MEAN": "Percent Of Mean",
        "method.domain.PERCENT_OF_MEDIAN": "Percent Of Median",
        "method.domain.Z_SCORE": "Z-score",
        "method.title": "Anomaly Calculation Method",
        "out_multidimensional_raster.descr": "The output Cloud Raster Format (CRF) multidimensional raster dataset.",
        "out_multidimensional_raster.title": "Output Multidimensional Raster",
        "reference_mean_raster.descr": "The reference raster dataset that contains a previously calculated mean for each pixel. The anomalies will be calculated in comparison to this mean.",
        "reference_mean_raster.title": "Input External Raster",
        "summary": "<xdoc><p>Computes the anomaly for each slice in an existing multidimensional raster to generate a new multidimensional raster.</p><p>An anomaly is the deviation of an observation from its standard or mean value.</p></xdoc>",
        "title": "Generate Multidimensional Anomaly",
        "variables.descr": "The variable or variables for which anomalies will be calculated. If no variable is specified, all variables with a time dimension will be analyzed.",
        "variables.title": "Variables [Dimension Info] (Description)"
    }
}
