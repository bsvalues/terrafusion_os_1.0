{
    "map": {
        "cell_height.descr": "<xdoc><p>The height of the cells. Measurement units are specified by the <span class=\"esri_uicontrol\">Cell Units</span> parameter.</p></xdoc>",
        "cell_height.title": "Cell Height",
        "cell_units.descr": "<xdoc><p>Specifies the measurement units for cell width and height.</p><ul><li><span title=\"METERS\">Meters</span>—The unit will be meters. This is the default.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The unit will be kilometers.</li><li><span title=\"MILES\">Miles</span>—The unit will be miles.</li><li><span title=\"NAUTICAL_MILES\">Nautical miles</span>—The unit will be nautical miles.</li><li><span title=\"FEET\">Feet</span>—The unit will be feet.</li><li><span title=\"US_SURVEY_FEET\">US survey feet</span>—The unit will be U.S. survey feet.</li></ul></xdoc>",
        "cell_units.domain.FEET": "Feet",
        "cell_units.domain.KILOMETERS": "Kilometers",
        "cell_units.domain.METERS": "Meters",
        "cell_units.domain.MILES": "Miles",
        "cell_units.domain.NAUTICAL_MILES": "Nautical miles",
        "cell_units.domain.US_SURVEY_FEET": "US survey feet",
        "cell_units.title": "Cell Units",
        "cell_width.descr": "<xdoc><p>The width of the cells. Measurement units are specified by the <span class=\"esri_uicontrol\">Cell Units</span> parameter.</p></xdoc>",
        "cell_width.title": "Cell Width",
        "description": "Generates a Gridded Reference Graphic (GRG) as a polygon feature class over a specified area with a custom size.",
        "grid_angle.descr": "The angle used to rotate the grid.",
        "grid_angle.title": "Grid Rotation Angle",
        "grid_angle_units.descr": "<xdoc><p>The angular units for grid rotation.</p><ul><li><span title=\"DEGREES\">Degrees</span>—The angle will be degrees. This is the default.</li><li><span title=\"MILS\">Mils</span>—The angle will be mils.</li><li><span title=\"RADS\">Radians</span>—The angle will be radians.</li><li><span title=\"GRADS\">Gradians</span>—The angle will be gradians.</li></ul></xdoc>",
        "grid_angle_units.domain.DEGREES": "Degrees",
        "grid_angle_units.domain.GRADS": "Gradians",
        "grid_angle_units.domain.MILS": "Mils",
        "grid_angle_units.domain.RADS": "Radians",
        "grid_angle_units.title": "Grid Rotation Angular Units",
        "horizontal_cells.descr": "The number of horizontal grid cells.",
        "horizontal_cells.title": "Number of Rows",
        "in_feature.descr": "The center point for the GRG starting point.",
        "in_feature.title": "Input Feature",
        "label_format.descr": "<xdoc><p>Specifies the labeling type for each grid cell.</p><ul><li><span title=\"ALPHA_NUMERIC\">Alpha-numeric</span>—The label will use an alpha character, a separator, and a number. This is the default.</li><li><span title=\"ALPHA_ALPHA\">Alpha-alpha</span>—The label will use an alpha character, a separator, and an additional alpha character.</li><li><span title=\"NUMERIC\">Numeric</span>—The label will be numeric.</li></ul></xdoc>",
        "label_format.domain.ALPHA_ALPHA": "Alpha-alpha",
        "label_format.domain.ALPHA_NUMERIC": "Alpha-numeric",
        "label_format.domain.NUMERIC": "Numeric",
        "label_format.title": "Label Format",
        "label_separator.descr": "<xdoc><p>Specifies the separator to be used between x- and y-values when the <span class=\"esri_uicontrol\">Label Format</span> parameter is set to <span class=\"esri_uicontrol\">Alpha-alpha</span>, for example, A-A, A-AA, AA-A.</p><ul><li><span title=\"-\">Hyphen</span>—The label separator will be a hyphen. This is the default.</li><li><span title=\",\">Comma</span>—The label separator will be a comma.</li><li><span title=\".\">Period</span>—The label separator will be a period.</li><li><span title=\"/\">Forward slash</span>—The label separator will be a forward slash.</li></ul></xdoc>",
        "label_separator.domain.,": "Comma",
        "label_separator.domain.-": "Hyphen",
        "label_separator.domain..": "Period",
        "label_separator.domain.¦": "Forward slash",
        "label_separator.title": "Label Separator",
        "label_start_position.descr": "<xdoc><p>Specifies the grid cell where labelling will start.</p><ul><li><span title=\"UPPER_LEFT\">Upper left</span>—The label position will be the upper left. This is the default.</li><li><span title=\"LOWER_LEFT\">Lower left</span>—The label position will be the lower left.</li><li><span title=\"UPPER_RIGHT\">Upper right</span>—The label position will be the upper right.</li><li><span title=\"LOWER_RIGHT\">Lower right</span>—The label position will be the lower right.</li></ul></xdoc>",
        "label_start_position.domain.LOWER_LEFT": "Lower left",
        "label_start_position.domain.LOWER_RIGHT": "Lower right",
        "label_start_position.domain.UPPER_LEFT": "Upper left",
        "label_start_position.domain.UPPER_RIGHT": "Upper right",
        "label_start_position.title": "Label Start Position",
        "out_feature_class.descr": "The output polygon feature class containing the GRG to be created.",
        "out_feature_class.title": "Output Feature Class",
        "params.category1": "Cell Options",
        "params.category2": "Label Options",
        "title": "Generate Grid From Point",
        "vertical_cells.descr": "The number of vertical grid cells.",
        "vertical_cells.title": "Number of Columns"
    }
}
