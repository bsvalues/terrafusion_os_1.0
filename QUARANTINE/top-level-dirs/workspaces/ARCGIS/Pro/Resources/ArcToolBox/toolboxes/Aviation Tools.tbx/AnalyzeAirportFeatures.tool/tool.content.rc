{
    "map": {
        "airport_ref_point_features.descr": "<xdoc><p>The input airport control point features that contain the runway threshold points. The runway threshold points will be identified by searching for the <span class=\"esri_fieldname\">POINTTYPE</span> attribute equal to <span class=\"esri_fieldname\">DISPLACED_THRESHOLD</span>, and the <span class=\"esri_fieldname\">RUNWAYENDD</span> attribute equal to the runway end designator.</p></xdoc>",
        "airport_ref_point_features.title": "Airport Control Point Features",
        "description": "Analyzes specified point features around an airfield to find and record information such as distance from a given runway centerline or the end of the nearest runway and its designation.",
        "in_features.descr": "The input point features that will be analyzed and recorded in terms of their physical relationships to features in the other inputs.",
        "in_features.title": "Input Analysis Features",
        "in_features_height.descr": "<xdoc><p>Specifies the name of a field in the input airport features dataset. The specified field must contain numeric values. The values in this field will be used to identify the height of each input airport feature. If the <span class=\"esri_uicontrol\">SHAPE_Z</span> value is specified as the location of the height, the <span class=\"esri_uicontrol\">Input Analysis Features Height Unit</span> parameter will be ignored.</p><ul><li><span title=\"SHAPE_Z\">SHAPE_Z</span>—Height values will be derived from the z-values of the input point features. This is the default.</li></ul></xdoc>",
        "in_features_height.title": "Input Analysis Features Height",
        "in_features_height_unit.descr": "<xdoc><p>Specifies the linear unit of measure that will be used when the <span class=\"esri_uicontrol\">Input Analysis Features Height</span> parameter value is specified.</p><ul><li><span title=\"KILOMETERS\">Kilometers</span>—The unit will be kilometers.</li><li><span title=\"METERS\">Meters</span>—The unit will be meters.</li><li><span title=\"DECIMETERS\">Decimeters</span>—The unit will be decimeters.</li><li><span title=\"CENTIMETERS\">Centimeters</span>—The unit will be centimeters.</li><li><span title=\"MILLIMETERS\">Millimeters</span>—The unit will be millimeters.</li><li><span title=\"NAUTICAL_MILES\">Nautical Miles</span>—The unit will be nautical miles.</li><li><span title=\"MILES\">Miles</span>—The unit will be miles.</li><li><span title=\"YARDS\">Yards</span>—The unit will be yards.</li><li><span title=\"FEET\">Feet</span>—The unit will be feet.</li><li><span title=\"INCHES\">Inches</span>—The unit will be inches.</li><li><span title=\"DECIMAL_DEGREES\">Decimal Degrees</span>—The unit will be decimal degrees.</li><li><span title=\"POINTS\">Points</span>—The unit will be points.</li><li><span title=\"UNKNOWN\">Unknown</span>—The unit will be unknown.</li></ul></xdoc>",
        "in_features_height_unit.domain.CENTIMETERS": "Centimeters",
        "in_features_height_unit.domain.DECIMAL_DEGREES": "Decimal Degrees",
        "in_features_height_unit.domain.DECIMETERS": "Decimeters",
        "in_features_height_unit.domain.FEET": "Feet",
        "in_features_height_unit.domain.INCHES": "Inches",
        "in_features_height_unit.domain.KILOMETERS": "Kilometers",
        "in_features_height_unit.domain.METERS": "Meters",
        "in_features_height_unit.domain.MILES": "Miles",
        "in_features_height_unit.domain.MILLIMETERS": "Millimeters",
        "in_features_height_unit.domain.NAUTICAL_MILES": "Nautical Miles",
        "in_features_height_unit.domain.POINTS": "Points",
        "in_features_height_unit.domain.UNKNOWN": "Unknown",
        "in_features_height_unit.domain.YARDS": "Yards",
        "in_features_height_unit.title": "Input Analysis Features Height Unit",
        "in_out_horizontal_unit.descr": "<xdoc><p>Specifies the output unit of measurement for the five output distances produced.</p><ul><li><span title=\"SAME_AS_INPUT\">Same as input</span>—The horizontal units from the input coordinate system will be used. If the input data is not projected, this will be meters. This is the default.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The unit will be kilometers.</li><li><span title=\"METERS\">Meters</span>—The unit will be meters.</li><li><span title=\"DECIMETERS\">Decimeters</span>—The unit will be decimeters.</li><li><span title=\"CENTIMETERS\">Centimeters</span>—The unit will be centimeters.</li><li><span title=\"MILLIMETERS\">Millimeters</span>—The unit will be millimeters.</li><li><span title=\"NAUTICAL_MILES\">Nautical Miles</span>—The unit will be nautical miles.</li><li><span title=\"MILES\">Miles</span>—The unit will be miles.</li><li><span title=\"YARDS\">Yards</span>—The unit will be yards.</li><li><span title=\"FEET\">Feet</span>—The unit will be feet.</li><li><span title=\"INCHES\">Inches</span>—The unit will be inches.</li></ul></xdoc>",
        "in_out_horizontal_unit.domain.CENTIMETERS": "Centimeters",
        "in_out_horizontal_unit.domain.DECIMETERS": "Decimeters",
        "in_out_horizontal_unit.domain.FEET": "Feet",
        "in_out_horizontal_unit.domain.INCHES": "Inches",
        "in_out_horizontal_unit.domain.KILOMETERS": "Kilometers",
        "in_out_horizontal_unit.domain.METERS": "Meters",
        "in_out_horizontal_unit.domain.MILES": "Miles",
        "in_out_horizontal_unit.domain.MILLIMETERS": "Millimeters",
        "in_out_horizontal_unit.domain.NAUTICAL_MILES": "Nautical Miles",
        "in_out_horizontal_unit.domain.SAME_AS_INPUT": "Same as input",
        "in_out_horizontal_unit.domain.YARDS": "Yards",
        "in_out_horizontal_unit.title": "Output Horizontal Unit of Measure",
        "in_runway_features.descr": "The input runway polyline features, specifically their centerlines, that will be used in the analysis.",
        "in_runway_features.title": "Input Runway Features",
        "out_table.descr": "The output table, with a row for each input airport feature, containing the analyzed results.",
        "out_table.title": "Output Table",
        "ref_point_height.descr": "<xdoc><p>Specifies the name of a field in the input airport reference point features dataset. The specified field must contain numeric values. The values in this field will be used to identify the height of each input airport reference point feature. If <span class=\"esri_uicontrol\">SHAPE_Z</span> is specified as the location of the height, the <span class=\"esri_uicontrol\">Airport Reference Point Elevation Unit</span> parameter will be ignored.</p><ul><li><span title=\"SHAPE_Z\">SHAPE_Z</span>—The z-value of each point will be used. This is the default.</li></ul></xdoc>",
        "ref_point_height.title": "Airport Control Point Elevation",
        "ref_point_height_unit.descr": "<xdoc><p>Specifies the linear unit of measure that will be used when an airport reference point height is specified.</p><ul><li><span title=\"KILOMETERS\">Kilometers</span>—The unit will be kilometers.</li><li><span title=\"METERS\">Meters</span>—The unit will be meters.</li><li><span title=\"DECIMETERS\">Decimeters</span>—The unit will be decimeters.</li><li><span title=\"CENTIMETERS\">Centimeters</span>—The unit will be centimeters.</li><li><span title=\"MILLIMETERS\">Millimeters</span>—The unit will be millimeters.</li><li><span title=\"NAUTICAL_MILES\">Nautical Miles</span>—The unit will be nautical miles.</li><li><span title=\"MILES\">Miles</span>—The unit will be miles.</li><li><span title=\"YARDS\">Yards</span>—The unit will be yards.</li><li><span title=\"FEET\">Feet</span>—The unit will be feet.</li><li><span title=\"INCHES\">Inches</span>—The unit will be inches.</li><li><span title=\"DECIMAL_DEGREES\">Decimal Degrees</span>—The unit will be decimal degrees.</li><li><span title=\"POINTS\">Points</span>—The unit will be points.</li><li><span title=\"UNKNOWN\">Unknown</span>—The unit will be unknown.</li></ul></xdoc>",
        "ref_point_height_unit.domain.CENTIMETERS": "Centimeters",
