{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "69000031",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "spark"
    ],
    "params": {
        "input_layer": {
            "displayname": "$rc:input_layer.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_layer.descr"
        },
        "out_central_feature": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_central_feature.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "input_layer"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_central_feature.descr"
        },
        "out_mean_center": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_mean_center.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "input_layer"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_mean_center.descr"
        },
        "out_median_center": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_median_center.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "input_layer"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_median_center.descr"
        },
        "out_ellipse": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_ellipse.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "input_layer"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_ellipse.descr"
        },
        "ellipse_size": {
            "type": "optional",
            "displayname": "$rc:ellipse_size.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "1_STANDARD_DEVIATION",
                        "code": "$rc:ellipse_size.domain.1_STANDARD_DEVIATION"
                    },
                    {
                        "value": "2_STANDARD_DEVIATIONS",
                        "code": "$rc:ellipse_size.domain.2_STANDARD_DEVIATIONS"
                    },
                    {
                        "value": "3_STANDARD_DEVIATIONS",
                        "code": "$rc:ellipse_size.domain.3_STANDARD_DEVIATIONS"
                    }
                ]
            },
            "value": "1_STANDARD_DEVIATION",
            "description": "$rc:ellipse_size.descr"
        },
        "weight_field": {
            "type": "optional",
            "displayname": "$rc:weight_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Double"
                ]
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:weight_field.descr"
        },
        "group_by_field": {
            "type": "optional",
            "displayname": "$rc:group_by_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Text",
                    "Date",
                    "Double"
                ]
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:group_by_field.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
