        },
        "power": {
            "type": "optional",
            "displayname": "$rc:power.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1",
                "max": "100"
            },
            "value": "2",
            "description": "$rc:power.descr"
        },
        "elev_inflation_factor": {
