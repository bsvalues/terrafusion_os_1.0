                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:value_field.descr"
        },
        "out_netcdf_file": {
            "direction": "out",
            "display_order": "2",
            "displayname": "$rc:out_netcdf_file.title",
