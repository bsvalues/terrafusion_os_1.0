            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true"
            },
            "description": "$rc:x_spacing.descr"
        },
        "y_spacing": {
            "type": "optional",
            "display_order": "8",
