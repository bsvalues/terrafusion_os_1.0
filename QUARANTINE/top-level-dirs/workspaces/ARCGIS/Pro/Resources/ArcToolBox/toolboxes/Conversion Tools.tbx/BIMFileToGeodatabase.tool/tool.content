{
    "type": "FunctionTool",
    "guid": "{9acbfcef-9d77-44ad-a309-fdd5ee19d1e8}",
    "displayname": "$rc:title",
    "helpcontent": "2040013",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "attributes": [
        "block_add_to_map"
    ],
    "params": {
        "in_bim_file_workspace": {
            "displayname": "$rc:in_bim_file_workspace.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "DEBimFileWorkspace"
                }
            },
            "description": "$rc:in_bim_file_workspace.descr"
        },
        "out_gdb_path": {
            "displayname": "$rc:out_gdb_path.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "defaultenvironmentname": "workspace",
            "description": "$rc:out_gdb_path.descr"
        },
        "out_dataset_name": {
            "displayname": "$rc:out_dataset_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_dataset_name.descr"
        },
        "spatial_reference": {
            "type": "optional",
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "depends": [
                "out_gdb_path"
            ],
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:spatial_reference.descr"
        },
        "identifier": {
            "type": "optional",
            "displayname": "$rc:identifier.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:identifier.descr"
        },
        "out_feature_dataset": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_feature_dataset.title",
            "datatype": {
                "type": "DEFeatureDataset"
            }
        },
        "out_featureclass_dataset": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_featureclass_dataset.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "DEFeatureClass"
                }
            }
        },
        "include_floorplan": {
            "type": "optional",
            "displayname": "$rc:include_floorplan.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "INCLUDE_FLOORPLAN"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "EXCLUDE_FLOORPLAN"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:include_floorplan.descr"
        }
    },
    "environments": [
        "XYDomain",
        "XYResolution",
        "XYTolerance",
        "ZResolution",
        "ZTolerance",
        "extent",
        "geographicTransformations",
        "outputCoordinateSystem"
    ]
}
