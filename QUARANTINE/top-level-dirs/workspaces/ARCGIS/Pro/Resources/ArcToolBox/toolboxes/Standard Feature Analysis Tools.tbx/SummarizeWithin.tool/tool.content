{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "53030003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "sumWithinLayer": {
            "displayname": "$rc:sumwithinlayer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:sumwithinlayer.descr"
        },
        "summaryLayer": {
            "displayname": "$rc:summarylayer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint",
                    "Polyline",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:summarylayer.descr"
        },
        "outputName": {
            "displayname": "$rc:outputname.title",
            "datatype": {
                "type": "GPString"
            },
            "depends": [
                "sumWithinLayer"
            ],
            "description": "$rc:outputname.descr"
        },
        "sumShape": {
            "type": "optional",
            "displayname": "$rc:sumshape.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_SHAPE_SUM"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_SHAPE_SUM"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:sumshape.descr"
        },
        "shapeUnits": {
            "type": "optional",
            "displayname": "$rc:shapeunits.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ACRES",
                        "code": "$rc:shapeunits.domain.ACRES"
                    },
                    {
                        "value": "HECTARES",
                        "code": "$rc:shapeunits.domain.HECTARES"
                    },
                    {
                        "value": "SQUAREMETERS",
                        "code": "$rc:shapeunits.domain.SQUAREMETERS"
                    },
                    {
                        "value": "SQUAREKILOMETERS",
                        "code": "$rc:shapeunits.domain.SQUAREKILOMETERS"
                    },
                    {
                        "value": "SQUAREFEET",
                        "code": "$rc:shapeunits.domain.SQUAREFEET"
                    },
                    {
                        "value": "SQUAREYARDS",
                        "code": "$rc:shapeunits.domain.SQUAREYARDS"
                    },
                    {
                        "value": "SQUAREMILES",
                        "code": "$rc:shapeunits.domain.SQUAREMILES"
                    },
                    {
                        "value": "METERS",
                        "code": "$rc:shapeunits.domain.METERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:shapeunits.domain.KILOMETERS"
                    },
                    {
                        "value": "FEET",
                        "code": "$rc:shapeunits.domain.FEET"
                    },
                    {
                        "value": "YARDS",
                        "code": "$rc:shapeunits.domain.YARDS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:shapeunits.domain.MILES"
                    }
                ]
            },
            "description": "$rc:shapeunits.descr"
        },
        "summaryFields": {
            "type": "optional",
            "displayname": "$rc:summaryfields.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:summaryfields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:summaryfields.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "SUM",
                                "code": "$rc:summaryfields.domain.item2.SUM"
                            },
                            {
                                "value": "MEAN",
                                "code": "$rc:summaryfields.domain.item2.MEAN"
                            },
                            {
                                "value": "MIN",
                                "code": "$rc:summaryfields.domain.item2.MIN"
                            },
                            {
                                "value": "MAX",
                                "code": "$rc:summaryfields.domain.item2.MAX"
                            },
                            {
                                "value": "STDDEV",
                                "code": "$rc:summaryfields.domain.item2.STDDEV"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "summaryLayer"
            ],
            "description": "$rc:summaryfields.descr"
        },
        "groupByField": {
            "type": "optional",
            "displayname": "$rc:groupbyfield.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text"
                ]
            },
            "depends": [
                "summaryLayer"
            ],
            "description": "$rc:groupbyfield.descr"
        },
        "minorityMajority": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:minoritymajority.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_MIN_MAJ"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_MIN_MAJ"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:minoritymajority.descr"
        },
        "percentShape": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:percentshape.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_PERCENT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_PERCENT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:percentshape.descr"
        },
        "outputLayer": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:outputlayer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "depends": [
                "sumWithinLayer"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            }
        },
        "groupBySummaryLayer": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:groupbysummarylayer.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "depends": [
                "sumWithinLayer"
            ],
            "schema": {
                "type": "GPTableSchema",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "extent"
    ]
}
