                "type": "GPExtent"
            },
            "defaultenvironmentname": "extent",
            "description": "$rc:update_extent.descr"
        },
        "wait_for_job_completion": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:wait_for_job_completion.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
