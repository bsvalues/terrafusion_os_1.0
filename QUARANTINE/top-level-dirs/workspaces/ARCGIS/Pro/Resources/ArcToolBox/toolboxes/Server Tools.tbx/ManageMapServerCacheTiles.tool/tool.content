            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPDouble"
                }
            },
            "description": "$rc:scales.descr"
        },
        "update_mode": {
            "display_order": "2",
            "displayname": "$rc:update_mode.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "RECREATE_EMPTY_TILES",
                        "code": "$rc:update_mode.domain.RECREATE_EMPTY_TILES"
                    },
                    {
                        "value": "RECREATE_ALL_TILES",
                        "code": "$rc:update_mode.domain.RECREATE_ALL_TILES"
                    },
                    {
                        "value": "DELETE_TILES",
                        "code": "$rc:update_mode.domain.DELETE_TILES"
                    }
                ]
            },
            "value": "RECREATE_ALL_TILES",
            "description": "$rc:update_mode.descr"
        },
