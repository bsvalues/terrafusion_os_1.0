ion><Scale>0</Scale><Required>true</Required><Editable>false</Editable></Field><Field xsi:type='typens:Field'><Name>updateGeom_Area</Name><Type>esriFieldTypeDouble</Type><IsNullable>true</IsNullable><Length>0</Length><Precision>0</Precision><Scale>0</Scale><Required>true</Required><Editable>false</Editable></Field></FieldArray></Fields><Records xsi:type='typens:ArrayOfRecord'></Records></RecordSet><OIDFieldName>OID</OIDFieldName><ShapeFieldName>updateGeom</ShapeFieldName></GPFeatureRecordSetLayer>",
            "description": "$rc:area_of_interest.descr"
