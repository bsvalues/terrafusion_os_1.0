            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:hydroarea_minwidth.descr"
        },
        "min_island_area": {
            "type": "optional",
            "displayname": "$rc:min_island_area.title",
            "datatype": {
                "type": "GPArealUnit"
            },
            "value": "0 SquareMeters",
            "description": "$rc:min_island_area.descr"
        }
