{
    "type": "FunctionTool",
    "guid": "{66c83df1-b435-4b9b-a0ec-adfa26a8e53b}",
    "displayname": "$rc:title",
    "helpcontent": "10040005",
    "description": "$rc:description",
    "product": "200",
    "attributes": [
        "edit_session",
        "input_data_change"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "angle_field": {
            "displayname": "$rc:angle_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Float",
                    "Double",
                    "Short",
                    "Long"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:angle_field.descr"
        },
        "out_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_features"
            ]
        },
        "rotation_method": {
            "type": "optional",
            "displayname": "$rc:rotation_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "GEOGRAPHIC",
                        "code": "$rc:rotation_method.domain.GEOGRAPHIC"
                    },
                    {
                        "value": "ARITHMETIC",
                        "code": "$rc:rotation_method.domain.ARITHMETIC"
                    },
                    {
                        "value": "GRAPHIC",
                        "code": "$rc:rotation_method.domain.GRAPHIC"
                    }
                ]
            },
            "value": "GRAPHIC",
            "description": "$rc:rotation_method.descr"
        }
    },
    "environments": [
        "cartographicCoordinateSystem"
    ]
}
