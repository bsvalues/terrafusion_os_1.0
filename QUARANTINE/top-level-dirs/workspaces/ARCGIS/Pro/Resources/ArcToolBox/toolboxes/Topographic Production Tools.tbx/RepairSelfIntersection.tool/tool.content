    ],
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "repair_type": {
            "displayname": "$rc:repair_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DELETE",
                        "code": "$rc:repair_type.domain.DELETE"
                    },
                    {
                        "value": "SPLIT",
                        "code": "$rc:repair_type.domain.SPLIT"
                    }
                ]
            },
            "value": "DELETE",
            "description": "$rc:repair_type.descr"
        },
        "max_length": {
            "type": "optional",
            "displayname": "$rc:max_length.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "description": "$rc:max_length.descr"
        },
        "repair_at_end_point": {
            "type": "optional",
            "displayname": "$rc:repair_at_end_point.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "REPAIR_ENDS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "IGNORE_ENDS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:repair_at_end_point.descr"
        },
        "modified_in_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:modified_in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            }
        }
    }
