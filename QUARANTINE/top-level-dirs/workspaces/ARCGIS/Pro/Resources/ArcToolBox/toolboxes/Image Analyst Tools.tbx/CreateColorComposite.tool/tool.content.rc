{
    "map": {
        "blue_expression.descr": "<xdoc><p>The calculation that will be assigned to the third band.</p><p>A band name, band ID, or an algebraic expression using the bands.</p><p>The supported operators are unary: plus (+), minus (-), times (*), and divide (/).</p></xdoc>",
        "blue_expression.title": "Blue Expression",
        "description": "Creates a three-band raster dataset from a multiband raster dataset.",
        "green_expression.descr": "<xdoc><p>The calculation that will be assigned to the second band.</p><p>A band name, band ID, or an algebraic expression using the bands.</p><p>The supported operators are unary: plus (+), minus (-), times (*), and divide (/).</p></xdoc>",
        "green_expression.title": "Green Expression",
        "in_raster.descr": "The input multiband raster data.",
        "in_raster.title": "Input Raster",
        "method.descr": "<xdoc><p>Specifies the method that will be used to extract bands.</p><ul><li><span title=\"BAND_NAMES\">Band names</span>—The band name representing the wavelength interval on the electromagnetic spectrum (such as Red, Near Infrared, or Thermal Infrared) or the polarization (such as VH, VV, HH, or HV) will be used. This is the default.</li><li><span title=\"BAND_IDS\">Band IDs</span>— The band number (such as B1, B2, or B3) will be used.</li></ul></xdoc>",
        "method.domain.BAND_IDS": "Band IDs",
        "method.domain.BAND_NAMES": "Band names",
        "method.title": "Method",
        "out_raster.descr": "The output three-band composite raster.",
        "out_raster.title": "Output Raster",
        "red_expression.descr": "<xdoc><p>The calculation that will be assigned to the first band.</p><p>A band name, band ID, or an algebraic expression using the bands.</p><p>The supported operators are unary: plus (+), minus (-), times (*), and divide (/).</p></xdoc>",
        "red_expression.title": "Red Expression",
        "title": "Create Color Composite"
