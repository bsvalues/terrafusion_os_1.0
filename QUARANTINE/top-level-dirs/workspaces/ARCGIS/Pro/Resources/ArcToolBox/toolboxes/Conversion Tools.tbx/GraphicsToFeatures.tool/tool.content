{
    "type": "FunctionTool",
    "guid": "{ad6d12da-0332-479e-9857-2b6987ae8b87}",
    "displayname": "$rc:title",
    "helpcontent": "2180002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_layer": {
            "displayname": "$rc:in_layer.title",
            "datatype": {
                "type": "GPGraphicsLayer"
            },
            "description": "$rc:in_layer.descr"
        },
        "graphics_type": {
            "displayname": "$rc:graphics_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POINT",
                        "code": "$rc:graphics_type.domain.POINT"
                    },
                    {
                        "value": "POLYLINE",
                        "code": "$rc:graphics_type.domain.POLYLINE"
                    },
                    {
                        "value": "POLYGON",
                        "code": "$rc:graphics_type.domain.POLYGON"
                    },
                    {
                        "value": "MULTIPOINT",
                        "code": "$rc:graphics_type.domain.MULTIPOINT"
                    },
                    {
                        "value": "ANNOTATION",
                        "code": "$rc:graphics_type.domain.ANNOTATION"
                    }
                ]
            },
            "description": "$rc:graphics_type.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "delete_graphics": {
            "type": "optional",
            "displayname": "$rc:delete_graphics.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DELETE_GRAPHICS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "KEEP_GRAPHICS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:delete_graphics.descr"
        },
        "reference_scale": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:reference_scale.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:reference_scale.descr"
        },
        "updated_layer": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_layer.title",
            "datatype": {
                "type": "GPLayer"
            },
            "depends": [
                "in_layer"
            ]
        }
    },
    "environments": [
        "geographicTransformations",
        "outputCoordinateSystem"
    ]
