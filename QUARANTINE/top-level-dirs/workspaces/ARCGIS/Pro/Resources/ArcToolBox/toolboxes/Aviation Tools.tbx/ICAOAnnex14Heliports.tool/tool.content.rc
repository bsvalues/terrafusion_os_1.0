{
    "map": {
        "approach_bearing.descr": "The absolute bearing that an approaching aircraft will travel along the surface. A value of 0 will align the surface to true north. The default value is 0.",
        "approach_bearing.title": "Approach Bearing",
        "clearway_length.descr": "<xdoc><p>The length of the clearway. The unit of measurement for the clearway depends on the <span class=\"esri_uicontrol\">Input Safety Area Features</span> parameter value.</p></xdoc>",
        "clearway_length.title": "Clearway Length",
        "custom_json_file.descr": "The import configuration, in JSON format, that will be used to create the custom OIS.",
        "custom_json_file.title": "Custom JSON File",
        "derived_outfeatureclass.title": "Output OIS Features",
        "description": "Generates obstruction identification surfaces (OIS) for heliports based on ICAO Annex 14 Volume II specifications.",
        "heliport_elevation.descr": "<xdoc><p>The elevation of the highest point of the heliport. The value must be in the vertical coordinate system linear units of the target feature class. If no value is provided, the highest point of the <span class=\"esri_uicontrol\">Input Safety Area Features</span> parameter value will be used. The default is 0.</p></xdoc>",
        "heliport_elevation.title": "Heliport Elevation",
        "in_flightpath_features.descr": "The polyline flight path features that the curved surface will follow.",
        "in_flightpath_features.title": "Input Flight Path Features",
        "input_safety_area_features.descr": "The input safety area around which the OIS will be generated.",
        "input_safety_area_features.title": "Input Safety Area Features",
        "operation_type.descr": "<xdoc><p>Specifies the time when normal flight operations occur.</p><ul><li><span title=\"DAY_OPERATION\">Day operation</span>—Normal flight operations occur during the day. This is the default.</li><li><span title=\"NIGHT_OPERATION\">Night operation</span>—Normal flight operations occur during the night.</li></ul></xdoc>",
        "operation_type.domain.DAY_OPERATION": "Day operation",
        "operation_type.domain.NIGHT_OPERATION": "Night operation",
        "operation_type.title": "Operation Type",
        "rotor_diameter.descr": "The rotor diameter, in meters, of aircraft using the heliport. The default is 16.5.",
        "rotor_diameter.title": "Rotor Diameter",
        "summary": "<xdoc><p>Generates obstruction identification surfaces (OIS) for heliports based on ICAO Annex 14 Volume II specifications.</p><p>ICAO Annex 14 Volume II defines recommended international standards and procedures for aerodromes containing heliports. This tool can be used to identify obstacles that may impact an aircraft&apos;s ability to take off from or land on a helipad. By creating multipatch or polygon features, you can visually identify obstructions in ArcGIS Pro. The OIS created by this tool should extend from a safety area around the Final Approach and Takeoff (FATO) surface. Pursuant to ICAO standards, a safety area is a defined buffer around a FATO surface that extends at least three meters out or 1/4 the diameter of the aircraft&apos;s rotor wings, whichever is greater. There must be no obstacle present inside the safety area.</p></xdoc>",
        "surface_classification.descr": "<xdoc><p>Specifies the slope design category that will be used for the OIS.</p><ul><li><span title=\"CATEGORY_A\">Category A</span>—Rotor aircraft operated with performance class 1 will be used.</li><li><span title=\"CATEGORY_B\">Category B</span>—Rotor aircraft operated with performance class 3 will be used.</li><li><span title=\"CATEGORY_C\">Category C</span>—Rotor aircraft operated with performance class 2 will be used.</li></ul></xdoc>",
        "surface_classification.domain.CATEGORY_A": "Category A",
        "surface_classification.domain.CATEGORY_B": "Category B",
        "surface_classification.domain.CATEGORY_C": "Category C",
        "surface_classification.title": "Surface Classification",
        "surface_shape.descr": "<xdoc><p>Specifies the shape of the take off or approach surface.</p><ul><li><span title=\"STRAIGHT_SURFACE\">Straight Surface</span>—The take off climb or approach surface is straight. This is the default.</li><li><span title=\"CURVED_SURFACE\">Curved Surface</span>—The take off climb or approach surface is curved.</li></ul></xdoc>",
        "surface_shape.domain.CURVED_SURFACE": "Curved Surface",
        "surface_shape.domain.STRAIGHT_SURFACE": "Straight Surface",
        "surface_shape.title": "Surface Shape",
        "target_ois_features.descr": "The target feature class that will contain the generated OIS.",
        "target_ois_features.title": "Target OIS Features",
        "title": "ICAO Annex 14 Heliports"
    }
}
