{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\CalculateDistance",
    "displayname": "$rc:title",
    "helpcontent": "54050001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "inputSourceRasterOrFeatures": {
            "display_order": "0",
            "displayname": "$rc:inputsourcerasterorfeatures.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
