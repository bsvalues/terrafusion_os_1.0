                    "Feet",
                    "Yards",
                    "Miles",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:outputcellsize.descr"
        },
        "outputDirectionName": {
            "type": "optional",
