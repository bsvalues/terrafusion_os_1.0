{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "46090004",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "params": {
        "job_id": {
            "displayname": "$rc:job_id.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:job_id.descr"
        },
        "properties_table_name": {
            "displayname": "$rc:properties_table_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:properties_table_name.descr"
        },
        "property_field": {
            "displayname": "$rc:property_field.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:property_field.descr"
        },
        "value": {
            "displayname": "$rc:value.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:value.descr"
        },
        "increment_value": {
            "type": "optional",
            "displayname": "$rc:increment_value.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "INCREMENT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "REPLACE"
                    }
                ]
            },
            "description": "$rc:increment_value.descr"
        },
        "database_path": {
            "type": "optional",
            "displayname": "$rc:database_path.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "jtc"
                ]
            },
            "description": "$rc:database_path.descr"
        },
        "updated_job_id": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_job_id.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "-1"
        }
    }
}
