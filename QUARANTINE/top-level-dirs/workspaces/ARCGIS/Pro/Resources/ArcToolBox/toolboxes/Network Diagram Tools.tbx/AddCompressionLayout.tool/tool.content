{
    "type": "FunctionTool",
    "guid": "{76f6fb2f-9c3f-4466-94a8-ea3a2ed5f5b3}",
    "displayname": "$rc:title",
    "helpcontent": "71010015",
    "description": "$rc:description",
    "product": "200",
    "params": {
        "in_utility_network": {
            "displayname": "$rc:in_utility_network.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEUtilityNetwork"
                    },
                    {
                        "type": "DETraceNetwork"
                    }
                ]
            },
            "description": "$rc:in_utility_network.descr"
        },
        "template_name": {
            "displayname": "$rc:template_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:template_name.descr"
        },
        "is_active": {
            "displayname": "$rc:is_active.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ACTIVE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "INACTIVE"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:is_active.descr"
        },
        "are_containers_preserved": {
            "type": "optional",
            "displayname": "$rc:are_containers_preserved.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "PRESERVE_CONTAINERS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "IGNORE_CONTAINERS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:are_containers_preserved.descr"
        },
        "grouping_distance_absolute": {
            "type": "optional",
            "displayname": "$rc:grouping_distance_absolute.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_utility_network"
            ],
            "value": "20 Unknown",
            "description": "$rc:grouping_distance_absolute.descr"
        },
        "vertices_removal_rule": {
            "type": "optional",
            "displayname": "$rc:vertices_removal_rule.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ALL",
                        "code": "$rc:vertices_removal_rule.domain.ALL"
                    },
                    {
                        "value": "OUTER",
                        "code": "$rc:vertices_removal_rule.domain.OUTER"
                    },
                    {
                        "value": "OUTER_EXCEPT_FIRST",
                        "code": "$rc:vertices_removal_rule.domain.OUTER_EXCEPT_FIRST"
                    }
                ]
            },
            "value": "OUTER",
            "description": "$rc:vertices_removal_rule.descr"
        },
        "out_utility_network": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_utility_network.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEUtilityNetwork"
                    },
                    {
                        "type": "DETraceNetwork"
                    }
                ]
            },
            "addtomap": "false"
        },
        "out_template_name": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_template_name.title",
            "datatype": {
                "type": "GPString"
            }
        }
    }
}
