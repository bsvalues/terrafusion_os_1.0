        "minimum_marker_distance": {
            "type": "optional",
            "displayname": "$rc:minimum_marker_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                }
            },
            "value": "0 Points",
