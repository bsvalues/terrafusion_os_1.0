                    },
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double",
                            "BigInteger"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "Kilometers",
                                "code": "$rc:in_barriers.domain.item4.Kilometers"
                            },
                            {
                                "value": "Meters",
                                "code": "$rc:in_barriers.domain.item4.Meters"
                            },
                            {
                                "value": "Decimeters",
                                "code": "$rc:in_barriers.domain.item4.Decimeters"
                            },
                            {
                                "value": "Centimeters",
                                "code": "$rc:in_barriers.domain.item4.Centimeters"
                            },
                            {
                                "value": "Millimeters",
                                "code": "$rc:in_barriers.domain.item4.Millimeters"
                            },
                            {
                                "value": "Nautical Miles",
                                "code": "$rc:in_barriers.domain.item4.Nautical Miles"
                            },
                            {
                                "value": "Statute Miles",
                                "code": "$rc:in_barriers.domain.item4.Statute Miles"
                            },
                            {
                                "value": "Yards",
                                "code": "$rc:in_barriers.domain.item4.Yards"
                            },
                            {
                                "value": "Feet",
                                "code": "$rc:in_barriers.domain.item4.Feet"
                            },
                            {
                                "value": "Inches",
                                "code": "$rc:in_barriers.domain.item4.Inches"
                            },
                            {
                                "value": "Degrees",
                                "code": "$rc:in_barriers.domain.item4.Degrees"
                            },
                            {
                                "value": "Points",
                                "code": "$rc:in_barriers.domain.item4.Points"
                            }
                        ]
                    }
                ]
            },
            "description": "$rc:in_barriers.descr"
        },
        "keep_at_least_one_marker": {
            "type": "optional",
            "displayname": "$rc:keep_at_least_one_marker.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "KEEP_AT_LEAST_ONE_MARKER"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_KEEP_AT_LEAST_ONE_MARKER"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:keep_at_least_one_marker.descr"
        },
        "displacement_method": {
            "type": "optional",
            "displayname": "$rc:displacement_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DO_NOT_DISPLACE",
                        "code": "$rc:displacement_method.domain.DO_NOT_DISPLACE"
                    },
                    {
                        "value": "DISPLACE_TOWARD_GRID",
                        "code": "$rc:displacement_method.domain.DISPLACE_TOWARD_GRID"
                    },
                    {
                        "value": "DISPLACE_APART",
                        "code": "$rc:displacement_method.domain.DISPLACE_APART"
                    }
                ]
            },
            "value": "DO_NOT_DISPLACE",
            "description": "$rc:displacement_method.descr"
