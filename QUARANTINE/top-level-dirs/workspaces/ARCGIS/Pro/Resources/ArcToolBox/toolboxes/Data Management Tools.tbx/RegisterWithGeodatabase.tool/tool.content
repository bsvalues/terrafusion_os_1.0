{
    "type": "FunctionTool",
    "guid": "{390115da-0ef8-44b4-9707-297519c4e64e}",
    "displayname": "$rc:title",
    "helpcontent": "3010006",
    "description": "$rc:description",
    "product": "200",
    "attributes": [
        "block_add_to_map",
        "input_data_change",
        "param_nocount:in_dataset"
    ],
    "params": {
        "in_dataset": {
            "displayname": "$rc:in_dataset.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPTableView"
                    },
                    {
                        "type": "GPRasterLayer"
                    }
                ]
            },
            "description": "$rc:in_dataset.descr"
        },
        "reg_dataset": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:reg_dataset.title",
            "datatype": {
                "type": "DETable"
            }
        },
        "in_object_id_field": {
            "type": "optional",
            "displayname": "$rc:in_object_id_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "OID",
                    "Short",
                    "Long",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_dataset"
            ],
            "description": "$rc:in_object_id_field.descr"
        },
        "in_shape_field": {
            "type": "optional",
            "displayname": "$rc:in_shape_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Geometry"
                ]
            },
            "depends": [
                "in_dataset"
            ],
            "description": "$rc:in_shape_field.descr"
        },
        "in_geometry_type": {
            "type": "optional",
            "displayname": "$rc:in_geometry_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POINT",
                        "code": "$rc:in_geometry_type.domain.POINT"
                    },
                    {
                        "value": "MULTIPOINT",
                        "code": "$rc:in_geometry_type.domain.MULTIPOINT"
                    },
                    {
                        "value": "POLYGON",
                        "code": "$rc:in_geometry_type.domain.POLYGON"
                    },
                    {
                        "value": "POLYLINE",
                        "code": "$rc:in_geometry_type.domain.POLYLINE"
                    },
                    {
                        "value": "MULTIPATCH",
                        "code": "$rc:in_geometry_type.domain.MULTIPATCH"
                    }
                ]
            },
            "depends": [
                "in_shape_field"
            ],
            "description": "$rc:in_geometry_type.descr"
        },
        "in_spatial_reference": {
            "type": "optional",
            "displayname": "$rc:in_spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "depends": [
                "in_shape_field"
            ],
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:in_spatial_reference.descr"
        },
        "in_extent": {
            "type": "optional",
            "displayname": "$rc:in_extent.title",
            "datatype": {
                "type": "GPEnvelope"
            },
            "depends": [
                "in_shape_field"
            ],
            "category": "$rc:params.category1",
            "description": "$rc:in_extent.descr"
        }
    },
    "environments": [
        "workspace"
    ]
}
