{
    "type": "FunctionTool",
    "guid": "{26B17338-CB00-45A9-AB9C-858C2E0122C9}/CreateCrossReferenceGeodatabase",
    "displayname": "$rc:title",
    "helpcontent": "76030001",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "params": {
        "source_workspace": {
            "displayname": "$rc:source_workspace.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEShapeFile"
                    },
                    {
                        "type": "DEWorkspace"
                    }
                ]
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database",
                    "File System"
                ]
            },
            "description": "$rc:source_workspace.descr"
        },
        "target_database": {
            "displayname": "$rc:target_database.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:target_database.descr"
        },
        "out_database": {
            "direction": "out",
            "displayname": "$rc:out_database.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database"
                ]
            },
            "description": "$rc:out_database.descr"
        },
        "mapping_file": {
            "type": "optional",
            "displayname": "$rc:mapping_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xls",
                    "xlsx"
                ]
            },
            "description": "$rc:mapping_file.descr"
        }
    }
}
