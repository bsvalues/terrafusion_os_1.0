{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "46100004",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "46",
        "49"
    ],
    "params": {
        "job_id": {
            "displayname": "$rc:job_id.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:job_id.descr"
        },
        "parent_id": {
            "displayname": "$rc:parent_id.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:parent_id.descr"
        },
        "status": {
            "displayname": "$rc:status.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "WORKING",
                        "code": "$rc:status.domain.WORKING"
                    },
                    {
                        "value": "RESTART",
                        "code": "$rc:status.domain.RESTART"
                    },
                    {
                        "value": "COMPLETE",
                        "code": "$rc:status.domain.COMPLETE"
                    }
                ]
            },
            "description": "$rc:status.descr"
        },
        "database_path": {
            "type": "optional",
            "displayname": "$rc:database_path.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "jtc"
                ]
            },
            "description": "$rc:database_path.descr"
        },
        "updated_job_id": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_job_id.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "-1"
        }
    }
}
