{
    "map": {
        "delete_associated_calibration_points.descr": "<xdoc><p>Specifies whether calibration points associated with the deleted routes will be deleted.</p><ul><li>Checked—Calibration points associated with the routes will be deleted.</li><li>Unchecked—Calibration points associated with the routes will not be deleted. This is the default.</li></ul></xdoc>",
        "delete_associated_calibration_points.title": "Delete associated calibration points",
        "delete_associated_centerlines.descr": "<xdoc><p>Specifies whether centerlines that are exclusively associated with the deleted routes will be deleted.</p><ul><li>Checked—Centerlines exclusively associated with the selected routes will be deleted. If centerlines are shared between networks, those common centerlines will not be deleted.</li><li>Unchecked—Centerlines will not be deleted. This is the default.</li></ul></xdoc>",
        "delete_associated_centerlines.title": "Delete associated centerlines",
        "delete_associated_events.descr": "<xdoc><p>Specifies whether events associated with the deleted routes will be deleted.</p><ul><li>Checked—Events associated with the routes will be deleted.</li><li>Unchecked—Events associated with the routes will not be deleted. This is the default.</li></ul></xdoc>",
        "delete_associated_events.title": "Delete associated events",
        "description": "Deletes routes and associated data elements from the LRS Network.",
        "in_route_features.descr": "The route feature class registered with the network.",
        "in_route_features.title": "Input Route Features",
        "out_derived_route_features.title": "Output Derived Route Features",
        "out_details_file.title": "Output Results File",
        "title": "Delete Routes",
        "updated_route_features.title": "Updated Route Features"
    }
}
