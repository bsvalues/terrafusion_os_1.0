        "imagepath_type.title": "Image Path Feature Class Type",
        "in_video.descr": "The FMV-compliant input video file containing essential metadata for each frame of the video data. The supported video file types are PS, TS, MPG, MPEG, MP2, MPG2, MPEG2, MP4, MPG4, MPEG4, H264, H265, VOB, and M2TS.",
        "in_video.title": "Input Video",
        "min_distance.descr": "The distance between the features in sequential video frames. If left blank, every metadata feature will be extracted and added to the feature class.",
        "min_distance.title": "Minimum Distance Between Features",
        "min_time.descr": "The time interval between the features in sequential video frames. If left blank, every metadata feature will be extracted and added to the feature class.",
