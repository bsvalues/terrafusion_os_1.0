{
    "map": {
        "csv_file.descr": "<xdoc><p>An output .csv or .json file containing metadata about the video frames for specific times.</p><p>The metadata file is in the same format used by the Video Multiplexer tool.</p></xdoc>",
        "csv_file.title": "Output Metadata File",
        "description": "Extracts the platform, frame center, frame outline, and attributes metadata from an FMV-compliant video. The output geometry and attributes are saved as feature classes.",
