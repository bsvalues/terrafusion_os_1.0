    ],
    "attributes": [
        "edit_session",
        "input_data_change"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPFeatureLayer",
                        "displayname": "$rc:in_features.dt.title1"
                    },
                    {
                        "type": "GPLong",
                        "displayname": "$rc:in_features.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFeatureClassDomain",
                        "geometrytype": [
                            "Polygon",
                            "Polyline",
                            "Point",
                            "Multipoint"
                        ],
                        "featuretype": [
                            "Simple"
                        ]
                    },
                    {
                        "type": "GPRangeDomain",
                        "min": "0",
                        "max": "50"
                    }
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "cluster_tolerance": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:cluster_tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:cluster_tolerance.descr"
        },
        "out_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_features.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "depends": [
                "in_features"
            ]
        }
    },
    "environments": [
        "XYTolerance",
        "extent",
        "workspace"
    ]
