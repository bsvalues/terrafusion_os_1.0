{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "53030001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "pointLayer": {
            "displayname": "$rc:pointlayer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:pointlayer.descr"
        },
        "polygonLayer": {
            "displayname": "$rc:polygonlayer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:polygonlayer.descr"
        },
        "outputName": {
            "displayname": "$rc:outputname.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:outputname.descr"
        },
        "keepBoundariesWithNoPoints": {
            "displayname": "$rc:keepboundarieswithnopoints.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "KEEP_EMPTY"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "REMOVE_EMPTY"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:keepboundarieswithnopoints.descr"
        },
        "summaryFields": {
            "type": "optional",
            "displayname": "$rc:summaryfields.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:summaryfields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:summaryfields.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "SUM",
                                "code": "$rc:summaryfields.domain.item2.SUM"
                            },
                            {
                                "value": "MIN",
                                "code": "$rc:summaryfields.domain.item2.MIN"
                            },
                            {
                                "value": "MAX",
                                "code": "$rc:summaryfields.domain.item2.MAX"
                            },
                            {
                                "value": "MEAN",
                                "code": "$rc:summaryfields.domain.item2.MEAN"
                            },
                            {
                                "value": "STDDEV",
                                "code": "$rc:summaryfields.domain.item2.STDDEV"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "pointLayer"
            ],
            "description": "$rc:summaryfields.descr"
        },
        "groupByField": {
            "type": "optional",
            "displayname": "$rc:groupbyfield.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Text"
                ]
            },
            "depends": [
                "pointLayer"
            ],
            "description": "$rc:groupbyfield.descr"
        },
        "minorityMajority": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:minoritymajority.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_MIN_MAJ"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_MIN_MAJ"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:minoritymajority.descr"
        },
        "percentPoints": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:percentpoints.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_PERCENT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_PERCENT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:percentpoints.descr"
        },
        "aggregatedLayer": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:aggregatedlayer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "groupSummary": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:groupsummary.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
