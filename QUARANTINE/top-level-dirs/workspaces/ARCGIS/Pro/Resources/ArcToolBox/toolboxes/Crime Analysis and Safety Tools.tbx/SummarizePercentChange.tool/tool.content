{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\SummarizePercentChange",
    "displayname": "$rc:title",
    "helpcontent": "75000008",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline",
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "in_current_features": {
            "displayname": "$rc:in_current_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_current_features.descr"
        },
        "in_previous_features": {
            "displayname": "$rc:in_previous_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_previous_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "search_radius": {
            "type": "optional",
            "displayname": "$rc:search_radius.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Meters",
                    "Inches",
                    "InchesInt",
                    "Points",
                    "Feet",
                    "FeetInt",
                    "Yards",
                    "YardsInt",
                    "Millimeters",
                    "Centimeters"
                ]
            },
            "description": "$rc:search_radius.descr"
        }
    },
    "environments": [
        "MDomain",
        "MResolution",
        "MTolerance",
        "XYDomain",
        "XYResolution",
        "XYTolerance",
        "ZDomain",
        "ZResolution",
        "ZTolerance",
        "autoCommit",
        "configKeyword",
        "extent",
        "geographicTransformations",
        "maintainAttachments",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "qualifiedFieldNames",
