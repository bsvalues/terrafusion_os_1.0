{
    "type": "FunctionTool",
    "guid": "{33724566-2738-4FE2-903A-A8C439127E50}/GenerateTargetGroupLayer",
    "displayname": "$rc:title",
    "helpcontent": "62070005",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "33",
        "35"
    ],
    "params": {
        "geography_level": {
            "displayname": "$rc:geography_level.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:geography_level.descr"
        },
        "segmentation_base": {
            "displayname": "$rc:segmentation_base.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:segmentation_base.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "segmentation_base"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "featuretype.rule": "AsSpecified",
                "featuretype": "Simple",
                "geometrytype.rule": "AsSpecified",
                "geometrytype": "Polygon",
                "extenttype.rule": "Union",
                "fields.rule": "None",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "target_group": {
            "displayname": "$rc:target_group.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "sgtargetgroup"
                ]
            },
            "description": "$rc:target_group.descr"
        },
        "boundary_layer": {
            "type": "optional",
            "displayname": "$rc:boundary_layer.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:boundary_layer.descr"
        }
    },
    "environments": [
        "baDataSource",
        "extent",
        "workspace"
    ]
}
