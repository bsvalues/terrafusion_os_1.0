{
    "type": "FunctionTool",
    "guid": "{c7b772e1-be2e-402a-9645-dffa2bdfb9aa}",
    "displayname": "$rc:title",
    "helpcontent": "71010001",
    "description": "$rc:description",
    "product": "200",
    "params": {
        "in_utility_network": {
            "displayname": "$rc:in_utility_network.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEUtilityNetwork"
                    },
                    {
                        "type": "DETraceNetwork"
                    }
                ]
            },
            "description": "$rc:in_utility_network.descr"
        },
        "template_name": {
            "displayname": "$rc:template_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:template_name.descr"
        },
        "is_active": {
            "displayname": "$rc:is_active.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ACTIVE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "INACTIVE"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:is_active.descr"
        },
        "are_containers_preserved": {
            "type": "optional",
            "displayname": "$rc:are_containers_preserved.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "PRESERVE_CONTAINERS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "IGNORE_CONTAINERS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:are_containers_preserved.descr"
        },
        "iterations_number": {
            "type": "optional",
            "displayname": "$rc:iterations_number.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "1",
            "description": "$rc:iterations_number.descr"
        },
        "number_of_directions": {
            "type": "optional",
            "displayname": "$rc:number_of_directions.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TWELVE_DIRECTIONS",
                        "code": "$rc:number_of_directions.domain.TWELVE_DIRECTIONS"
                    },
                    {
                        "value": "EIGHT_DIRECTIONS",
                        "code": "$rc:number_of_directions.domain.EIGHT_DIRECTIONS"
                    },
                    {
                        "value": "FOUR_DIRECTIONS",
                        "code": "$rc:number_of_directions.domain.FOUR_DIRECTIONS"
                    }
                ]
            },
            "value": "EIGHT_DIRECTIONS",
            "description": "$rc:number_of_directions.descr"
        },
        "out_utility_network": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_utility_network.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEUtilityNetwork"
                    },
                    {
                        "type": "DETraceNetwork"
                    }
                ]
            },
            "addtomap": "false"
        },
        "out_template_name": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_template_name.title",
            "datatype": {
                "type": "GPString"
            }
        }
    }
}
