{
    "map": {
        "analysis_extent.descr": "The extent that defines the area of the output feature class.",
        "analysis_extent.title": "Analysis Extent",
        "description": "Creates a feature class from profiles in netCDF files. In the Climate and Forecast (CF) metadata convention, a profile is a type of discrete sampling geometry (DSG).",
        "in_cf_metadata.descr": "The XML format file with an .ncml extension that will supply missing or altered CF information for the input netCDF files.",
        "in_cf_metadata.title": "Input Climate and Forecast Metadata",
        "in_files_or_folders.descr": "<xdoc><p>The input netCDF files that will be used to create a feature class. Individual netCDF files, as well as folders that contain multiple netCDF files, can be used.</p><p>The input netCDF files must have the same DSG feature type and schema.</p></xdoc>",
        "in_files_or_folders.title": "Input NetCDF Files or Folders",
        "include_subdirectories.descr": "<xdoc><p>Specifies whether the files residing in the subdirectories of an input folder will be used.</p><ul><li>Checked—All netCDF files in all subdirectories will be used.</li><li>Unchecked—Only files in the input folder will be used. This is the default.</li></ul></xdoc>",
        "include_subdirectories.title": "Include Subdirectories",
        "instance_variables.descr": "The netCDF variables that differentiate individual features and represent the locations where observations are made. These variables will be added as fields to the output feature class.",
        "instance_variables.title": "Instance Variables",
        "observation_variables.descr": "The netCDF variables that contain all the observation values at each location and each vertical level. These will be added as fields to the output table",
        "observation_variables.title": "Observation Variables",
        "out_join_layer.descr": "<xdoc><p>The output layer that will be created by joining the output table to the output feature class. This is an optional output and is only available when the <span class=\"esri_uicontrol\">Instance and Observation</span> option is specified for the <span class=\"esri_uicontrol\">Output Schema</span> parameter.</p></xdoc>",
        "out_join_layer.title": "Output Join Layer",
        "out_point_or_polyline.title": "Output Point or Polyline",
        "out_point_or_polyline_name.descr": "<xdoc><p>The name of the feature class that will contain the locations from the netCDF variables. These variables will be added as fields from the <span class=\"esri_uicontrol\">Instance Variables</span> parameter.</p></xdoc>",
        "out_point_or_polyline_name.title": "Output Point or Polyline Name",
        "out_schema.descr": "<xdoc><p>Specifies the output feature class type that will be created.</p><ul><li><span title=\"INSTANCE_AND_OBSERVATION\">Instance and Observation</span>—A feature class containing 2D points that contain the location of each instance and a related table containing all the observation variables will be created. This is the default..</li><li><span title=\"ROUTE_AND_EVENT\">Route and Event</span>—A vertical polyline feature class with 3D vertexes and a linear event table for the observation variables will be created.</li><li><span title=\"POINT_3D\">Point 3D</span>—A 3D feature class with all instances at all vertical levels will be created.</li></ul></xdoc>",
        "out_schema.domain.INSTANCE_AND_OBSERVATION": "Instance and Observation",
        "out_schema.domain.POINT_3D": "Point 3D",
        "out_schema.domain.ROUTE_AND_EVENT": "Route and Event",
        "out_schema.title": "Output Schema",
        "out_table.title": "Output Join or Event Table",
        "out_table_name.descr": "The name of the output table that will contain all the records from the observation variables.",
        "out_table_name.title": "Output Join or Event Table Name",
        "target_workspace.descr": "The enterprise or file geodatabase in which the output feature class and table will be created. This must be an existing workspace.",
        "target_workspace.title": "Target Workspace",
        "title": "NetCDF Profiles To Feature Class (Discrete Sampling Geometry)"
    }
}
