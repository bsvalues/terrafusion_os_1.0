{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\FindCotravelers",
    "displayname": "$rc:title",
    "helpcontent": "73060003",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "spark"
    ],
    "params": {
        "input_features": {
            "displayname": "$rc:input_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_features.descr"
        },
        "out_featureclass": {
            "direction": "out",
            "displayname": "$rc:out_featureclass.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_featureclass.descr"
        },
        "id_field": {
            "displayname": "$rc:id_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Text"
                ]
            },
            "depends": [
                "input_features"
            ],
            "description": "$rc:id_field.descr"
        },
        "search_distance": {
            "type": "optional",
            "displayname": "$rc:search_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "value": "100 Feet",
            "description": "$rc:search_distance.descr"
        },
        "time_difference": {
            "type": "optional",
            "displayname": "$rc:time_difference.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days"
                ]
            },
            "value": "10 Seconds",
            "description": "$rc:time_difference.descr"
        },
        "input_type": {
            "type": "optional",
            "displayname": "$rc:input_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ONE_FEATURECLASS",
                        "code": "$rc:input_type.domain.ONE_FEATURECLASS"
                    },
                    {
                        "value": "TWO_FEATURECLASSES",
                        "code": "$rc:input_type.domain.TWO_FEATURECLASSES"
                    }
                ]
            },
            "value": "ONE_FEATURECLASS",
            "description": "$rc:input_type.descr"
        },
        "secondary_features": {
            "type": "optional",
            "displayname": "$rc:secondary_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:secondary_features.descr"
        },
        "secondary_id_field": {
            "type": "optional",
            "displayname": "$rc:secondary_id_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Text"
                ]
            },
            "depends": [
                "secondary_features"
            ],
            "description": "$rc:secondary_id_field.descr"
        },
        "create_summary_table": {
            "type": "optional",
            "displayname": "$rc:create_summary_table.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE_SUMMARY_TABLE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_SUMMARY_TABLE"
                    }
                ]
            },
            "description": "$rc:create_summary_table.descr"
        },
        "out_summary_table": {
            "type": "optional",
            "direction": "out",
            "displayname": "$rc:out_summary_table.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_summary_table.descr"
        },
        "include_min_cotraveling_duration": {
            "type": "optional",
            "displayname": "$rc:include_min_cotraveling_duration.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "MIN_COTRAVELING_DURATION"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_MIN_COTRAVELING_DURATION"
                    }
                ]
            },
            "description": "$rc:include_min_cotraveling_duration.descr"
        },
        "min_cotraveling_duration": {
            "type": "optional",
            "displayname": "$rc:min_cotraveling_duration.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Seconds",
                    "Minutes",
                    "Hours"
                ]
            },
            "description": "$rc:min_cotraveling_duration.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "parallelProcessingFactor",
        "workspace"
    ]
}
