{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3240010",
    "description": "$rc:description",
    "product": "200",
    "attributes": [
        "block_add_to_map",
        "param_nocount:in_table"
    ],
    "params": {
        "in_table": {
            "display_order": "1",
            "displayname": "$rc:in_table.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_table.descr"
        },
        "out_folder": {
            "display_order": "2",
            "displayname": "$rc:out_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:out_folder.descr"
        },
        "field": {
            "display_order": "4",
            "displayname": "$rc:field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Float",
                    "Double",
                    "Short",
                    "Long",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_table"
            ],
            "description": "$rc:field.descr"
        },
        "line_classes": {
            "display_order": "5",
            "displayname": "$rc:line_classes.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPFeatureLayer",
                        "displayname": "$rc:line_classes.dt.title1"
                    },
                    {
                        "type": "Field",
                        "displayname": "$rc:line_classes.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFeatureClassDomain",
                        "geometrytype": [
                            "Polyline"
                        ],
                        "featuretype": [
                            "Simple"
                        ]
                    },
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "OID",
                            "Float",
                            "Double",
                            "Short",
                            "Long",
                            "BigInteger"
                        ]
                    }
                ]
            },
            "description": "$rc:line_classes.descr"
        },
        "where_clause": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:where_clause.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "in_table"
            ],
            "description": "$rc:where_clause.descr"
        },
        "rotation_options": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:rotation_options.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPSQLExpression",
                        "displayname": "$rc:rotation_options.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:rotation_options.dt.title2"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:rotation_options.dt.title3"
                    },
                    {
                        "type": "GPDouble",
                        "displayname": "$rc:rotation_options.dt.title4"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPCodedValueDomain"
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "ARITHMETIC",
                                "code": "$rc:rotation_options.domain.item2.ARITHMETIC"
                            },
                            {
                                "value": "GEOGRAPHIC",
                                "code": "$rc:rotation_options.domain.item2.GEOGRAPHIC"
                            }
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "MIN",
                                "code": "$rc:rotation_options.domain.item3.MIN"
                            },
                            {
                                "value": "MAX",
                                "code": "$rc:rotation_options.domain.item3.MAX"
                            }
                        ]
                    },
                    {
                        "type": "GPRangeDomain",
                        "min": "-360",
                        "max": "360"
                    }
                ]
            },
            "depends": [
                "in_table"
            ],
            "description": "$rc:rotation_options.descr"
        },
        "out_rule_csv": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_rule_csv.title",
            "datatype": {
                "type": "DEFile"
            }
        }
    }
}
