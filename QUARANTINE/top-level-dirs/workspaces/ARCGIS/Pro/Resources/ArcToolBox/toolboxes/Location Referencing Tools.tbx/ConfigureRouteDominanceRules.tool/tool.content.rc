{
    "map": {
        "configure_type.descr": "<xdoc><p>Specifies the type of configuration that will be applied to the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> parameter value.</p><ul><li><span title=\"ADD\">Add</span>—A new rule will be added to the configuration.</li><li><span title=\"UPDATE\">Update</span>—An existing rule will be updated.</li><li><span title=\"DELETE\">Delete</span>—An existing rule will be deleted.</li></ul></xdoc>",
        "configure_type.domain.ADD": "Add",
        "configure_type.domain.DELETE": "Delete",
        "configure_type.domain.UPDATE": "Update",
        "configure_type.title": "Configure Type",
        "description": "Configures a set of rules to determine the dominant route in a network where there are concurrent routes.",
        "fields.descr": "The attribute field aliases in the source table. If multiple fields are used, they will be concatenated.",
        "fields.title": "Fields",
        "in_feature_class.descr": "The input feature class. Only a registered LRS Network feature class can be used.",
        "in_feature_class.title": "LRS Network Feature Class",
        "order_method.descr": "Specifies whether route dominance ordering will be determined by lesser or greater values.",
        "order_method.title": "Order Method",
        "order_type.descr": "Specifies the ordering type that will be used when evaluating numeric or alphanumeric strings.",
        "order_type.title": "Order Type",
        "out_feature_class.title": "Output Network Feature Class",
        "prioritized_exceptions.descr": "A comma-separated list of user-provided exceptions.",
        "prioritized_exceptions.title": "Prioritized Exceptions",
        "rule_name.descr": "The name of the rule that will be added, updated, or deleted. The rule name can be up to 30 characters.",
        "rule_name.title": "Rule Name",
        "source_table_name.descr": "<xdoc><p>The source event table or feature class registered to the <span class=\"esri_uicontrol\">LRS Network Feature Class</span> parameter value. Alternatively, the network feature class can be used. Only nonspanning line events are supported.</p></xdoc>",
        "source_table_name.title": "Source Table Name",
        "title": "Configure Route Dominance Rules",
        "updated_rule_name.descr": "<xdoc><p>The updated name of the rule. This parameter is only used when <span class=\"esri_uicontrol\">Update</span> is specified as the <span class=\"esri_uicontrol\">Configure Type</span> parameter value.</p></xdoc>",
        "updated_rule_name.title": "Updated Rule Name"
    }
}
