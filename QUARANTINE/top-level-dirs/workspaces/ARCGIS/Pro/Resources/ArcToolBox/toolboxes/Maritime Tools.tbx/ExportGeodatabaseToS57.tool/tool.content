{
    "type": "FunctionTool",
    "guid": "{C5CD7E91-50D4-44D2-B98B-151009423D52}/ExportGeodatabaseToS57",
    "displayname": "$rc:title",
    "helpcontent": "63020102",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "50"
    ],
    "params": {
        "in_source_gdb": {
            "display_order": "0",
            "displayname": "$rc:in_source_gdb.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:in_source_gdb.descr"
        },
        "product": {
            "display_order": "1",
            "displayname": "$rc:product.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:product.descr"
        },
        "export_type": {
            "display_order": "2",
            "displayname": "$rc:export_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NEW_DATASET",
                        "code": "$rc:export_type.domain.NEW_DATASET"
                    },
                    {
                        "value": "NEW_EDITION",
                        "code": "$rc:export_type.domain.NEW_EDITION"
                    },
                    {
                        "value": "UPDATE",
                        "code": "$rc:export_type.domain.UPDATE"
                    },
                    {
                        "value": "REISSUE",
                        "code": "$rc:export_type.domain.REISSUE"
                    },
                    {
                        "value": "CANCEL",
                        "code": "$rc:export_type.domain.CANCEL"
                    }
                ]
            },
            "description": "$rc:export_type.descr"
        },
        "out_location": {
            "display_order": "3",
            "displayname": "$rc:out_location.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:out_location.descr"
        },
        "in_product_config": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:in_product_config.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xml"
                ]
            },
            "description": "$rc:in_product_config.descr"
        },
        "clip_data_option": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:clip_data_option.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CLIP"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_CLIP"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:clip_data_option.descr"
        },
        "sample_export": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:sample_export.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "SAMPLE_EXPORT"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "OFFICIAL_EXPORT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:sample_export.descr"
        },
        "out_file": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_file.title",
            "datatype": {
                "type": "DEFile"
            }
        },
        "in_scamin_file": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:in_scamin_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xml"
                ]
            },
            "description": "$rc:in_scamin_file.descr"
        },
        "in_feature_catalogue": {
            "enabled": "false",
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:in_feature_catalogue.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xml"
                ]
            },
            "defaultenvironmentname": "S100FeatureCatalogueFile",
            "description": "$rc:in_feature_catalogue.descr"
        }
    },
    "environments": [
        "S100FeatureCatalogueFile",
        "workspace"
    ]
}
