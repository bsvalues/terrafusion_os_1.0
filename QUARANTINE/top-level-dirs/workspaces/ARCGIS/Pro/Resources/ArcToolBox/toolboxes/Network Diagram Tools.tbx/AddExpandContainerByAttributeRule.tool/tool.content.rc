{
    "map": {
        "container_source.descr": "The container source class or object table that references the containers to be expanded.",
        "container_source.title": "Container Source",
        "containers_visibility.descr": "<xdoc><p>Specifies whether the containers stay visible after they are expanded.<ul><li>Checked—The containers will stay visible after they are expanded. This is the default.</li><li>Unchecked—The containers will be hidden after they are expanded.</li></ul></p></xdoc>",
        "containers_visibility.title": "Keep containers visible",
        "description": "Adds a diagram rule to the rule sequence specified on a diagram template to automatically expand container contents during diagram buildings. The containers to expand are filtered by attributes from a given container source class or object table.",
        "description.descr": "The description of the rule.",
        "description.title": "Description",
        "in_utility_network.descr": "The utility network or trace network containing the diagram template that will be modified.",
        "in_utility_network.title": "Input Network",
        "is_active.descr": "<xdoc><p>Specifies whether the rule will be active when generating and updating diagrams based on the specified template.<ul><li>Checked—The added rule will become active during the generation and update of any diagrams based on the input template. This is the default.</li><li>Unchecked—The added rule will not become active during the generation or update of any diagrams based on the input template.</li></ul></p></xdoc>",
        "is_active.title": "Active",
        "out_template_name.title": "Output Diagram Template",
        "out_utility_network.title": "Output Network",
        "summary": "<xdoc><p>Adds a diagram rule to the rule sequence specified on a diagram template to automatically expand container contents during diagram buildings. The containers to expand are filtered by attributes from a given container source class or object table.</p><note type=\"caution\"/><p group=\"note\">This tool is a configuration and administration tool.</p><note type=\"note\"/><p group=\"note\">This tool impacts the consistency of any existing diagrams based on the input diagram template. All of the existing diagrams become inconsistent and open with a consistency warning icon until they are updated.</p></xdoc>",
        "template_name.descr": "The name of the diagram template that will be modified.",
        "template_name.title": "Input Diagram Template",
        "title": "Add Expand Container By Attribute Rule",
        "where_clause.descr": "An SQL expression that will be used to select the subset of containers in the container source class or object table that will be expanded in the generated diagrams. For more information about SQL syntax, see SQL reference for query expressions used in ArcGIS.",
        "where_clause.title": "Expression"
    }
