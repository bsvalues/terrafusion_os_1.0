{
    "type": "FunctionTool",
    "guid": "{79a0623c-36fb-4eeb-9151-0b7d912b569e}",
    "displayname": "$rc:title",
    "helpcontent": "52000008",
    "description": "$rc:description",
    "product": "200",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "attributes": [
        "block_add_to_map"
    ],
    "params": {
        "in_parcel_polygon_feature": {
            "displayname": "$rc:in_parcel_polygon_feature.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_parcel_polygon_feature.descr"
        },
        "target_feature_dataset": {
            "displayname": "$rc:target_feature_dataset.title",
            "datatype": {
                "type": "DEFeatureDataset"
            },
            "description": "$rc:target_feature_dataset.descr"
        },
        "start_sequence_corner": {
            "type": "optional",
            "displayname": "$rc:start_sequence_corner.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NE",
                        "code": "$rc:start_sequence_corner.domain.NE"
                    },
                    {
                        "value": "SE",
                        "code": "$rc:start_sequence_corner.domain.SE"
                    },
                    {
                        "value": "SW",
                        "code": "$rc:start_sequence_corner.domain.SW"
                    },
                    {
                        "value": "NW",
                        "code": "$rc:start_sequence_corner.domain.NW"
                    }
                ]
            },
            "value": "NE",
            "description": "$rc:start_sequence_corner.descr"
        },
        "points_sequence_format": {
            "type": "optional",
            "displayname": "$rc:points_sequence_format.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:points_sequence_format.descr"
        },
        "lines_sequence_format": {
            "type": "optional",
            "displayname": "$rc:lines_sequence_format.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:lines_sequence_format.descr"
        },
        "sequence_curves_separately": {
            "type": "optional",
            "displayname": "$rc:sequence_curves_separately.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "SEQUENCE_SEPARATELY"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "SEQUENCE_TOGETHER"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:sequence_curves_separately.descr"
        },
        "out_parcel_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_parcel_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "target_feature_dataset"
            ]
        },
        "out_lines_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_lines_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "target_feature_dataset"
            ]
        },
        "out_points_feature_class": {
            "type": "derived",
            "direction": "out",
