{
    "map": {
        "description": "Generates preliminary pathways that are cut according to obstructions, such as walls or columns, on selected levels in one or more facilities.",
        "detail_exp.descr": "<xdoc><p>An SQL expression used to select the <span class=\"esri_uicontrol\">Input Detail Features</span> parameter values across which the tool will not generate pathways.</p></xdoc>",
        "detail_exp.title": "Detail Expression",
        "in_detail_features.descr": "<xdoc><p>The input polyline features representing architectural details that can serve as barriers to travel within a facility. In the Indoors model, this is the Details layer.</p><p>If the input polyline layer contains feature representing both barriers (such as walls and windows) and nonbarriers (such as stairs and doorways), use the <span class=\"esri_uicontrol\">Detail Expression</span> parameter to identify which features represent barriers.</p></xdoc>",
        "in_detail_features.title": "Input Detail Features",
        "in_level_features.descr": "The input polygon features representing levels in facilities. In the Indoors model, this is the Levels layer. The tool honors selections and definition queries applied to the layer.",
        "in_level_features.title": "Input Level Features",
        "lattice_density.descr": "<xdoc><p>The longest distance allowed between nodes in the generated lattice of pathways. The tool uses the unit of measure from the coordinate system of the Indoors dataset. The default value is 0.6.</p><p>The value must be between 0.25 and 2.9.</p></xdoc>",
        "lattice_density.title": "Lattice Density",
        "lattice_rotation.descr": "<xdoc><p>The number of degrees by which the input floors&apos; primary travel direction is rotated clockwise from due west. If left blank, the tool will calculate a value based on the minimum bounding rectangle of each floor.</p><p>The value must be between 0.0 and 180.0.</p></xdoc>",
        "lattice_rotation.title": "Lattice Rotation",
        "restricted_unit_exp.descr": "<xdoc><p>An SQL expression that will be used to select the <span class=\"esri_uicontrol\">Restricted Unit Features</span> parameter values where the tool will not generate pathways.</p></xdoc>",
        "restricted_unit_exp.title": "Restricted Unit Expression",
        "restricted_unit_features.descr": "The input polygon features representing restricted and unrestricted spaces within a facility. In the Indoors model, this is the Units layer.",
        "restricted_unit_features.title": "Restricted Unit Features",
        "summary": "<xdoc><p>Generates preliminary pathways that are cut according to obstructions, such as walls or columns, on selected levels in one or more facilities.</p><p>Once stair or elevator floor transitions are added, use the Thin Indoor Pathways tool to create the final indoor network dataset.</p></xdoc>",
        "target_pathways.descr": "The feature class or feature layer to which generated pathway polylines will be written. In the Indoors model, this is the PrelimPathways layer.",
        "target_pathways.title": "Target PrelimPathways",
        "title": "Generate Indoor Pathways",
        "updated_pathways.title": "Updated Pathways"
    }
}
