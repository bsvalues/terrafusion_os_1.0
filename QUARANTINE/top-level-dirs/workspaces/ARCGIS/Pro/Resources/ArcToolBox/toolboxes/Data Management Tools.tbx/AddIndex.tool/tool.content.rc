        "out_table.title": "Updated Input Table",
        "summary": "<xdoc><p>Adds an attribute index to an existing table, feature class, shapefile, or attributed relationship class.</p><p>Attribute indexes are used by ArcGIS to quickly locate records that match an attribute query.</p></xdoc>",
        "title": "Add Attribute Index",
        "unique.descr": "<xdoc><p>Specifies whether the values in the index are unique.<ul><li>Unchecked—No values in the index are unique. This is the default.</li><li>Checked—All values in the index are unique.</li></ul></p></xdoc>",
