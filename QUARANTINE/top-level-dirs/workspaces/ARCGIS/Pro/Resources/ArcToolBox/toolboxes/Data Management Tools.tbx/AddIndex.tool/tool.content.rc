        "ascending.descr": "<xdoc><p>Specifies whether values will be indexed in ascending order.<ul><li>Unchecked—Values will not be indexed in ascending order. This is the default.</li><li>Checked—Values will be indexed in ascending order.</li></ul></p></xdoc>",
