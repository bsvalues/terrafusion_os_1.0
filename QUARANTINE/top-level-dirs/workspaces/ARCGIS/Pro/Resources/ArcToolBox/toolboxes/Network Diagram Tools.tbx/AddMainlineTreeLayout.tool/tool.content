{
    "type": "FunctionTool",
    "guid": "{01fa3c06-ffa7-4e78-8ba2-4d4fc8b8713d}",
    "displayname": "$rc:title",
    "helpcontent": "71010006",
    "description": "$rc:description",
    "product": "200",
    "params": {
        "in_utility_network": {
            "displayname": "$rc:in_utility_network.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEUtilityNetwork"
                    },
                    {
                        "type": "DETraceNetwork"
                    }
                ]
            },
            "description": "$rc:in_utility_network.descr"
        },
        "template_name": {
            "displayname": "$rc:template_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:template_name.descr"
        },
        "is_active": {
            "displayname": "$rc:is_active.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ACTIVE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "INACTIVE"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:is_active.descr"
        },
        "are_containers_preserved": {
            "type": "optional",
            "displayname": "$rc:are_containers_preserved.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "PRESERVE_CONTAINERS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "IGNORE_CONTAINERS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:are_containers_preserved.descr"
        },
        "tree_direction": {
            "type": "optional",
            "displayname": "$rc:tree_direction.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FROM_LEFT_TO_RIGHT",
                        "code": "$rc:tree_direction.domain.FROM_LEFT_TO_RIGHT"
                    },
                    {
                        "value": "FROM_RIGHT_TO_LEFT",
                        "code": "$rc:tree_direction.domain.FROM_RIGHT_TO_LEFT"
                    },
                    {
                        "value": "FROM_BOTTOM_TO_TOP",
                        "code": "$rc:tree_direction.domain.FROM_BOTTOM_TO_TOP"
                    },
                    {
                        "value": "FROM_TOP_TO_BOTTOM",
                        "code": "$rc:tree_direction.domain.FROM_TOP_TO_BOTTOM"
                    }
                ]
            },
            "value": "FROM_LEFT_TO_RIGHT",
            "description": "$rc:tree_direction.descr"
        },
        "branches_placement": {
            "type": "optional",
            "displayname": "$rc:branches_placement.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "BOTH_SIDES",
                        "code": "$rc:branches_placement.domain.BOTH_SIDES"
