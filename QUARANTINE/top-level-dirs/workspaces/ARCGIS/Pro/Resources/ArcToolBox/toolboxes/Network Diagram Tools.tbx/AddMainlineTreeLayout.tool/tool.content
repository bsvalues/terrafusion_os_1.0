        },
        "are_edges_orthogonal": {
            "type": "optional",
            "displayname": "$rc:are_edges_orthogonal.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
