            "description": "$rc:background_value.descr"
        },
        "filter": {
            "type": "optional",
            "displayname": "$rc:filter.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_FILTER"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "FILTER"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:filter.descr"
        },
        "corners": {
            "type": "optional",
            "displayname": "$rc:corners.title",
