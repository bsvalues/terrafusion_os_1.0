        "location_y_field.descr": "The field in the input table that contains the y-coordinate of the estimated phone location as provided by the wireless network provider.",
        "location_y_field.title": "Estimated Phone Location Y Field",
        "out_call_points.descr": "The point feature class containing the estimated call locations as provided by the wireless network provider.",
        "out_call_points.title": "Output Estimated Call Points",
        "out_sector_feature_class.descr": "<xdoc><p>The polygon feature class containing phone record sectors.</p><p>One sector polygon will be generated per phone record linked to cell site sectors.</p></xdoc>",
        "out_sector_feature_class.title": "Output Phone Record Sectors",
        "out_site_feature_class.descr": "<xdoc><p>The point feature class containing phone record site points.</p><p>One point will be generated per phone record linked to cell site points.</p></xdoc>",
        "out_site_feature_class.title": "Output Phone Record Site Points",
        "out_timing_advance_bands.descr": "The polygon feature class that will contain the timing advance bands as provided by the wireless network provider.",
        "out_timing_advance_bands.title": "Output Timing Advance Bands",
        "params.category1": "Call Duration Information",
        "params.category2": "Estimated Phone Location Output Options",
        "params.category3": "Timing Advance Band Output Options",
        "start_time_field.descr": "The field in the input table that contains the start date and time field of the phone call or data event.",
        "start_time_field.title": "Start Date and Time Field",
        "start_timing_distance_field.descr": "The field in the input table that contains the timing advance distance at the start of the call.",
        "start_timing_distance_field.title": "Start Timing Advance Distance Field",
        "subscriber_field.descr": "The field in the input table that contains the phone number or identifier of the subscriber.",
        "subscriber_field.title": "Subscriber ID Field",
        "timing_advance_unit.descr": "<xdoc><p>Specifies the linear unit of measurement that will be used for the <span class=\"esri_uicontrol\">Start Timing Advance Distance Field</span> and <span class=\"esri_uicontrol\">End Timing Advance Distance Field</span> parameter values.</p><ul><li><span title=\"KILOMETERS\">Kilometers</span>—The unit will be kilometers.</li><li><span title=\"METERS\">Meters</span>—The unit will be meters.</li><li><span title=\"MILESINT\">Statute Miles</span>—The unit will be statute miles.</li><li><span title=\"YARDSINT\">International Yards</span>—The unit will be international yards.</li><li><span title=\"FEETINT\">International Feet</span>—The unit will be international feet.</li><li><span title=\"MILES\">US Survey Miles</span>—The unit will be US Survey miles. This is the default.</li><li><span title=\"YARDS\">US Survey Yards</span>—The unit will be US Survey yards.</li><li><span title=\"FEET\">US Survey Feet</span>—The unit will be US Survey feet.</li></ul></xdoc>",
        "timing_advance_unit.domain.FEET": "US Survey Feet",
        "timing_advance_unit.domain.FEETINT": "International Feet",
        "timing_advance_unit.domain.KILOMETERS": "Kilometers",
        "timing_advance_unit.domain.METERS": "Meters",
        "timing_advance_unit.domain.MILES": "US Survey Miles",
        "timing_advance_unit.domain.MILESINT": "Statute Miles",
        "timing_advance_unit.domain.YARDS": "US Survey Yards",
        "timing_advance_unit.domain.YARDSINT": "International Yards",
        "timing_advance_unit.title": "Timing Advance Distance Unit",
        "timing_band_width.descr": "<xdoc><p>The full width of the timing advance band.</p><p>The default is 78.07 meters.</p></xdoc>",
        "timing_band_width.title": "Timing Advance Band Total Width",
        "title": "Cell Phone Records To Feature Class"
