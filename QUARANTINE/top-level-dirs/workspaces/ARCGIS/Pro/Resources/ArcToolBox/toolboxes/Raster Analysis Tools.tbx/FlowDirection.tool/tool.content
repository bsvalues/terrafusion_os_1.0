{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\FlowDirection",
    "displayname": "$rc:title",
    "helpcontent": "54020003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "inputSurfaceRaster": {
            "displayname": "$rc:inputsurfaceraster.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEImageServer"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:inputsurfaceraster.descr"
        },
        "outputFlowDirectionName": {
            "displayname": "$rc:outputflowdirectionname.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:outputflowdirectionname.descr"
        },
        "forceFlow": {
            "type": "optional",
            "displayname": "$rc:forceflow.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "FORCE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NORMAL"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:forceflow.descr"
        },
        "flowDirectionType": {
            "type": "optional",
            "displayname": "$rc:flowdirectiontype.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "D8",
                        "code": "$rc:flowdirectiontype.domain.D8"
                    },
                    {
                        "value": "MFD",
                        "code": "$rc:flowdirectiontype.domain.MFD"
                    },
                    {
                        "value": "DINF",
                        "code": "$rc:flowdirectiontype.domain.DINF"
                    }
                ]
            },
            "value": "D8",
            "description": "$rc:flowdirectiontype.descr"
        },
        "outputDropName": {
            "type": "optional",
            "displayname": "$rc:outputdropname.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:outputdropname.descr"
        },
        "outputFlowDirectionRaster": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:outputflowdirectionraster.title",
            "datatype": {
                "type": "GPRasterLayer"
            }
        },
        "outputDropRaster": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:outputdropraster.title",
            "datatype": {
                "type": "GPRasterLayer"
            }
        }
    },
    "environments": [
        "cellSize",
        "extent",
        "mask",
        "outputCoordinateSystem",
        "pyramid",
        "snapRaster"
    ]
}
