{
    "type": "FunctionTool",
    "guid": "{0A4A9218-07A4-497A-8506-CED528063FB9}/CreateLRSNetwork",
    "displayname": "$rc:title",
    "helpcontent": "23000025",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "78"
    ],
    "params": {
        "in_path": {
            "displayname": "$rc:in_path.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEFeatureDataset"
                    }
                ]
            },
            "description": "$rc:in_path.descr"
        },
        "lrs_name": {
            "displayname": "$rc:lrs_name.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:lrs_name.descr"
        },
        "network_name": {
            "displayname": "$rc:network_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:network_name.descr"
        },
        "route_id_field": {
            "displayname": "$rc:route_id_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "RouteId",
            "description": "$rc:route_id_field.descr"
        },
        "route_name_field": {
            "displayname": "$rc:route_name_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "RouteName",
            "description": "$rc:route_name_field.descr"
        },
        "from_date_field": {
            "displayname": "$rc:from_date_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "FromDate",
            "description": "$rc:from_date_field.descr"
        },
        "to_date_field": {
            "displayname": "$rc:to_date_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "ToDate",
            "description": "$rc:to_date_field.descr"
        },
        "derive_from_line_network": {
            "type": "optional",
            "displayname": "$rc:derive_from_line_network.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DERIVE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_DERIVE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:derive_from_line_network.descr"
        },
        "line_network_name": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:line_network_name.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:line_network_name.descr"
        },
        "include_fields_to_support_lines": {
            "type": "optional",
            "displayname": "$rc:include_fields_to_support_lines.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "INCLUDE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DO_NOT_INCLUDE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:include_fields_to_support_lines.descr"
        },
        "line_id_field": {
            "type": "optional",
            "displayname": "$rc:line_id_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "LineId",
            "description": "$rc:line_id_field.descr"
        },
        "line_name_field": {
            "type": "optional",
            "displayname": "$rc:line_name_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "LineName",
            "description": "$rc:line_name_field.descr"
        },
        "line_order_field": {
            "type": "optional",
            "displayname": "$rc:line_order_field.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "LineOrder",
            "description": "$rc:line_order_field.descr"
        },
        "measure_unit": {
            "type": "optional",
            "displayname": "$rc:measure_unit.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INCHES",
                        "code": "$rc:measure_unit.domain.INCHES"
                    },
                    {
                        "value": "FEET",
                        "code": "$rc:measure_unit.domain.FEET"
                    },
                    {
                        "value": "YARDS",
