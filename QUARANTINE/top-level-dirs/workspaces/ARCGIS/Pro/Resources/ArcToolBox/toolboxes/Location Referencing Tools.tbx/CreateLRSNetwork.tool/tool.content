                        "code": "$rc:measure_unit.domain.MILES"
                    },
                    {
                        "value": "NAUTICAL_MILES",
                        "code": "$rc:measure_unit.domain.NAUTICAL_MILES"
                    },
                    {
                        "value": "INTFEET",
                        "code": "$rc:measure_unit.domain.INTFEET"
                    },
                    {
                        "value": "MILLIMETERS",
                        "code": "$rc:measure_unit.domain.MILLIMETERS"
                    },
                    {
                        "value": "CENTIMETERS",
                        "code": "$rc:measure_unit.domain.CENTIMETERS"
                    },
                    {
                        "value": "METERS",
                        "code": "$rc:measure_unit.domain.METERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:measure_unit.domain.KILOMETERS"
                    },
                    {
                        "value": "DECIMETERS",
                        "code": "$rc:measure_unit.domain.DECIMETERS"
                    }
                ]
            },
            "value": "MILES",
            "description": "$rc:measure_unit.descr"
        },
        "out_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            }
        }
