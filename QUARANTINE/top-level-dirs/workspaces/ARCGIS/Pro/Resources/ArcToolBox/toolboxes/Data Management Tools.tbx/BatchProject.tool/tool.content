{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3120004",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Feature_Class_or_Dataset": {
            "displayname": "$rc:input_feature_class_or_dataset.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPComposite",
                    "datatypes": [
                        {
                            "type": "GPFeatureLayer"
                        },
                        {
                            "type": "DEFeatureDataset"
                        }
                    ]
                }
            },
            "description": "$rc:input_feature_class_or_dataset.descr"
        },
        "Output_Workspace": {
            "displayname": "$rc:output_workspace.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEFeatureDataset"
                    }
                ]
            },
            "description": "$rc:output_workspace.descr"
        },
        "Output_Coordinate_System": {
            "type": "optional",
            "displayname": "$rc:output_coordinate_system.title",
            "datatype": {
                "type": "GPCoordinateSystem"
            },
            "description": "$rc:output_coordinate_system.descr"
        },
        "Template_dataset": {
            "type": "optional",
            "displayname": "$rc:template_dataset.title",
            "datatype": {
                "type": "DEGeoDatasetType"
            },
            "description": "$rc:template_dataset.descr"
        },
        "Transformation": {
            "type": "optional",
            "displayname": "$rc:transformation.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:transformation.descr"
        },
        "Derived_Output": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:derived_output.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEFeatureDataset"
                    }
                ]
            },
            "depends": [
                "Output_Workspace"
            ],
            "schema": {
                "type": "GPContainerSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "XYResolution",
        "XYTolerance",
        "scratchWorkspace",
        "workspace"
    ]
}
