{
    "map": {
        "delete_graphics.descr": "<xdoc><p>Specifies whether the converted graphic elements from the <span class=\"esri_uicontrol\">Input Graphics</span> parameter will be deleted after conversion.<ul><li>Checked—The graphic elements will be deleted. This is the default.</li><li>Unchecked—The graphic elements will not be deleted; they will be preserved.</li></ul></p></xdoc>",
        "delete_graphics.title": "Delete graphics after conversion",
        "description": "Converts a graphics layer into a feature layer with geometries based on the input graphics layer's elements.",
        "graphics_type.descr": "<xdoc><p>Specifies the type of graphic element that will be converted.</p><ul><li><span title=\"POINT\">Point</span>—Point graphic elements will be converted.</li><li><span title=\"POLYLINE\">Polyline</span>—Polyline graphic elements will be converted.</li><li><span title=\"POLYGON\">Polygon</span>—Polygon graphic elements will be converted.</li><li><span title=\"MULTIPOINT\">Multipoint</span>—Multipoint graphic elements will be converted.</li><li><span title=\"ANNOTATION\">Annotation</span>—Annotation and text graphic elements will be converted.</li></ul></xdoc>",
        "graphics_type.domain.ANNOTATION": "Annotation",
        "graphics_type.domain.MULTIPOINT": "Multipoint",
        "graphics_type.domain.POINT": "Point",
        "graphics_type.domain.POLYGON": "Polygon",
        "graphics_type.domain.POLYLINE": "Polyline",
        "graphics_type.title": "Graphics Type",
        "in_layer.descr": "The graphics layer containing the source graphic elements that will be converted to features.",
        "in_layer.title": "Input Graphics",
        "out_feature_class.descr": "The output feature layer that will contain the converted graphic elements.",
        "out_feature_class.title": "Output Feature Class",
        "reference_scale.descr": "<xdoc><p>The reference scale that will be used to convert text elements to annotation features. This parameter is required when the <span class=\"esri_uicontrol\">Graphics Type</span> parameter is set to <span class=\"esri_uicontrol\">Annotation</span>.</p></xdoc>",
        "reference_scale.title": "Reference Scale",
        "title": "Graphics To Features",
        "updated_layer.title": "Updated layer"
    }
}
