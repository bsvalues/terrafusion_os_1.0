{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\JoinAttributesFromPolygon",
    "displayname": "$rc:title",
    "helpcontent": "75000005",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "target_features": {
            "displayname": "$rc:target_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:target_features.descr"
        },
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "fields": {
            "type": "optional",
            "displayname": "$rc:fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Text",
                    "Float",
                    "Double",
                    "Short",
                    "Long",
                    "Date",
                    "BigInteger",
                    "TimestampOffset",
                    "DateOnly",
                    "TimeOnly"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:fields.descr"
        },
        "out_features": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "target_features"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "overwrite_option": {
            "type": "optional",
            "displayname": "$rc:overwrite_option.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "OVERWRITE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_OVERWRITE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:overwrite_option.descr"
        }
    },
    "environments": [
        "workspace"
    ]
}
