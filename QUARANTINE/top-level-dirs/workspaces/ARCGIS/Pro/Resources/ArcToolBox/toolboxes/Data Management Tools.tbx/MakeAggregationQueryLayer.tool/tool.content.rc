        "related_join_field.descr": "A field in the summary table that contains the values on which the join will be based. Aggregation or summary statistics are also calculated separately for each unique attribute value from this field.",
        "related_join_field.title": "Related Join Field",
        "related_table.descr": "<xdoc><p>The input table containing the fields that will be used to calculate statistics. Statistics are joined to the <span class=\"esri_uicontrol\">Output Layer</span> value.</p></xdoc>",
        "related_table.title": "Related Table",
        "shape_type.descr": "<xdoc><p>Specifies the shape type of the query layer. Only those records from the result set of the query that match the specified shape type will be used in the output query layer. By default, the shape type of the first record in the result set will be used. This parameter is ignored if the result set of the query does not return a geometry field.</p><ul><li><span title=\"POINT\">Point</span>—The output query layer will use point geometry.</li><li><span title=\"MULTIPOINT\">Multipoint</span>—The output query layer will use multipoint geometry.</li><li><span title=\"POLYGON\">Polygon</span>—The output query layer will use polygon geometry.</li><li><span title=\"POLYLINE\">Polyline</span>—The output query layer will use polyline geometry.</li></ul></xdoc>",
        "shape_type.domain.MULTIPOINT": "Multipoint",
        "shape_type.domain.POINT": "Point",
        "shape_type.domain.POLYGON": "Polygon",
        "shape_type.domain.POLYLINE": "Polyline",
        "shape_type.title": "Shape Type",
        "spatial_reference.descr": "The coordinate system that will be used by the output query layer. By default, the spatial reference of the first record in the result set will be used. This parameter is ignored if the result set of the query does not return a geometry field.",
        "spatial_reference.title": "Coordinate System",
        "srid.descr": "The spatial reference identifier (SRID) value for queries that return geometry. Only those records from the result set of the query that match the specified SRID value will be used in the output query layer. By default, the SRID value of the first record in the result set will be used. This parameter is ignored if the result set of the query does not return a geometry field.",
        "srid.title": "Spatial Reference ID (SRID)",
        "statistics.descr": "<xdoc><p>Specifies the numeric field or fields containing the attribute values that will be used to calculate the specified statistic. Multiple statistic and field combinations can be specified. Null values are excluded from all statistical calculations.</p><p>The output layer will include a <span class=\"esri_fieldname\">ROW_COUNT</span> field showing total count (or frequency) of each unique value from the <span class=\"esri_uicontrol\">Related Join Field</span> value. The difference between the <span class=\"esri_fieldname\">ROW_COUNT</span> field and the <span class=\"esri_uicontrol\">Count</span> statistic type is that <span class=\"esri_fieldname\">ROW_COUNT</span> includes null values while <span class=\"esri_uicontrol\">Count</span> excludes null values.</p><p>Available statistics types are as follows:</p><ul><li>Count—The number of values included in the statistical calculations will be found. Each value will be counted except null values.</li><li>Sum—The values for the specified field will be added together.</li><li>Average—The average for the specified field will be calculated.</li><li>Minimum—The smallest value for all records of the specified field will be found.</li><li>Maximum—The largest value for all records of the specified field will be found.</li><li>Standard deviation—The standard deviation of values in the specified field will be calculated.</li></ul></xdoc>",
        "statistics.domain.item1.AVG": "Average",
        "statistics.domain.item1.COUNT": "Count",
        "statistics.domain.item1.MAX": "Maximum",
        "statistics.domain.item1.MIN": "Minimum",
        "statistics.domain.item1.STDDEV": "Standard deviation",
        "statistics.domain.item1.SUM": "Sum",
        "statistics.dt.title1": "Aggregate Type",
        "statistics.dt.title2": "Field Name(s)",
        "statistics.title": "Summary Field(s)",
        "summary": "Creates a query layer that summarizes, aggregates, and filters DBMS tables dynamically based on time, range, and attribute queries from a related table, and joins the result to a feature layer.",
        "target_feature_class.descr": "The feature class or spatial table from an enterprise database.",
        "target_feature_class.title": "Target Feature Class",
        "target_join_field.descr": "The field in the target feature class on which the join will be based.",
        "target_join_field.title": "Target Join Field",
        "title": "Make Aggregation Query Layer",
        "z_values.descr": "<xdoc><p>Specifies whether the output layer will include elevation values (z-values).</p><ul><li>Checked—The layer will include z-values.</li><li>Unchecked—The layer will not include z-values. This is the default.</li></ul></xdoc>",
        "z_values.title": "Coordinates include Z values"
    }
}
