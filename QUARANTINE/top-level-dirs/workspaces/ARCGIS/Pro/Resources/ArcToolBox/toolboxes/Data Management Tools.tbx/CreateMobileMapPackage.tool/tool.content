{
    "type": "FunctionTool",
    "guid": "{9b7e4956-d8de-4caa-9a8c-2a9ba3cddfb9}",
    "displayname": "$rc:title",
    "helpcontent": "3260012",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "attributes": [
        "no_data_change"
    ],
    "params": {
        "in_map": {
            "display_order": "1",
            "displayname": "$rc:in_map.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPMap"
                }
            },
            "domain": {
                "type": "GPMapDomain",
                "maptype": [
                    "0",
                    "2"
                ]
            },
            "description": "$rc:in_map.descr"
        },
        "output_file": {
            "direction": "out",
            "display_order": "2",
            "control_guid": "{F618CB52-29AE-49C8-BF32-9845F642276B}",
            "displayname": "$rc:output_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "mmpk"
                ]
            },
            "description": "$rc:output_file.descr"
        },
        "in_locator": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:in_locator.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "DEAddressLocator"
                }
            },
            "domain": {
                "type": "GPLocatorsDomain"
            },
            "description": "$rc:in_locator.descr"
        },
        "area_of_interest": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:area_of_interest.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:area_of_interest.descr"
        },
        "extent": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:extent.title",
            "datatype": {
                "type": "GPExtent"
            },
            "defaultenvironmentname": "extent",
            "description": "$rc:extent.descr"
        },
        "clip_features": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:clip_features.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CLIP"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "SELECT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:clip_features.descr"
        },
        "title": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:title.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:title.descr"
        },
        "summary": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:summary.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:summary.descr"
        },
        "description": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:description.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:description.descr"
        },
        "tags": {
            "type": "optional",
            "display_order": "11",
            "displayname": "$rc:tags.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:tags.descr"
        },
        "credits": {
            "type": "optional",
            "display_order": "12",
            "displayname": "$rc:credits.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:credits.descr"
        },
        "use_limitations": {
            "type": "optional",
            "display_order": "13",
            "displayname": "$rc:use_limitations.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:use_limitations.descr"
        },
        "anonymous_use": {
            "type": "optional",
            "display_order": "14",
            "displayname": "$rc:anonymous_use.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ANONYMOUS_USE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "STANDARD"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:anonymous_use.descr"
        },
        "enable_map_expiration": {
            "type": "optional",
            "display_order": "15",
            "displayname": "$rc:enable_map_expiration.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ENABLE_MAP_EXPIRATION"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DISABLE_MAP_EXPIRATION"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:enable_map_expiration.descr"
        },
        "map_expiration_type": {
            "type": "optional",
            "display_order": "16",
            "control_guid": "{485D3503-E739-42A0-B3FC-B71F393110A7}",
            "displayname": "$rc:map_expiration_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ALLOW_TO_OPEN",
                        "code": "$rc:map_expiration_type.domain.ALLOW_TO_OPEN"
                    },
                    {
                        "value": "DONOT_ALLOW_TO_OPEN",
                        "code": "$rc:map_expiration_type.domain.DONOT_ALLOW_TO_OPEN"
                    }
                ]
            },
            "value": "ALLOW_TO_OPEN",
            "description": "$rc:map_expiration_type.descr"
        },
        "expiration_date": {
            "type": "optional",
            "display_order": "17",
            "displayname": "$rc:expiration_date.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:expiration_date.descr"
        },
        "expiration_message": {
            "type": "optional",
            "display_order": "18",
            "displayname": "$rc:expiration_message.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "This map is expired.  Contact the map publisher for an updated map.",
            "description": "$rc:expiration_message.descr"
        },
        "select_related_rows": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:select_related_rows.title",
            "datatype": {
                "type": "GPBoolean"
