                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "KEEP_ONLY_RELATED_ROWS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "KEEP_ALL_RELATED_ROWS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:select_related_rows.descr"
        },
        "reference_online_content": {
            "type": "optional",
            "display_order": "20",
            "displayname": "$rc:reference_online_content.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "INCLUDE_SERVICE_LAYERS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "EXCLUDE_SERVICE_LAYERS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:reference_online_content.descr"
