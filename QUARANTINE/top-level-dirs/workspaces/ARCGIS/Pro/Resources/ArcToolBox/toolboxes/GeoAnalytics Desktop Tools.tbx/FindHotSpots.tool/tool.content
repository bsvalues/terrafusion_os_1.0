{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "69000009",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "spark"
    ],
    "params": {
        "point_layer": {
            "displayname": "$rc:point_layer.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:point_layer.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "bin_size": {
            "type": "optional",
            "displayname": "$rc:bin_size.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:bin_size.descr"
        },
        "neighborhood_size": {
            "type": "optional",
            "displayname": "$rc:neighborhood_size.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:neighborhood_size.descr"
        },
        "time_step_interval": {
            "type": "optional",
            "displayname": "$rc:time_step_interval.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_step_interval.descr"
        },
        "time_step_alignment": {
            "type": "optional",
            "displayname": "$rc:time_step_alignment.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "START_TIME",
                        "code": "$rc:time_step_alignment.domain.START_TIME"
                    },
                    {
                        "value": "END_TIME",
                        "code": "$rc:time_step_alignment.domain.END_TIME"
                    },
                    {
                        "value": "REFERENCE_TIME",
                        "code": "$rc:time_step_alignment.domain.REFERENCE_TIME"
                    }
                ]
            },
            "value": "START_TIME",
            "description": "$rc:time_step_alignment.descr"
        },
        "time_step_reference": {
            "type": "optional",
            "displayname": "$rc:time_step_reference.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_step_reference.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
