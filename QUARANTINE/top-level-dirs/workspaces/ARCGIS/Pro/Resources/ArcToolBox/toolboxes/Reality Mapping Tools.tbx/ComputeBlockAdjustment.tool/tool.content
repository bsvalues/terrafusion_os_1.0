                    {
                        "value": "POLYORDER1",
                        "code": "$rc:transformation_type.domain.POLYORDER1"
                    },
                    {
                        "value": "POLYORDER0",
                        "code": "$rc:transformation_type.domain.POLYORDER0"
                    },
                    {
                        "value": "RPC",
                        "code": "$rc:transformation_type.domain.RPC"
                    },
                    {
                        "value": "Frame",
                        "code": "$rc:transformation_type.domain.Frame"
                    }
                ]
            },
            "value": "POLYORDER1",
            "description": "$rc:transformation_type.descr"
        },
        "out_solution_table": {
            "direction": "out",
            "display_order": "3",
            "displayname": "$rc:out_solution_table.title",
            "datatype": {
                "type": "DETable"
            },
            "description": "$rc:out_solution_table.descr"
        },
        "out_solution_point_table": {
            "type": "optional",
