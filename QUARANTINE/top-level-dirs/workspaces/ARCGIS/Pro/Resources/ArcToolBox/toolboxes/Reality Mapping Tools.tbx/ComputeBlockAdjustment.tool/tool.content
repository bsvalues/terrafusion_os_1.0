                "type": "GPFeatureLayer"
            },
            "description": "$rc:in_control_points.descr"
        },
        "transformation_type": {
            "display_order": "2",
            "displayname": "$rc:transformation_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
