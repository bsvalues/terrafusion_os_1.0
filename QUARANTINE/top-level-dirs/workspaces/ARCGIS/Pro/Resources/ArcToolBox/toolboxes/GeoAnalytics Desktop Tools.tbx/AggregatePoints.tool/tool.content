{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "69000001",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "spark"
    ],
    "params": {
        "point_layer": {
            "display_order": "0",
            "displayname": "$rc:point_layer.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:point_layer.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "polygon_or_bin": {
            "display_order": "2",
            "displayname": "$rc:polygon_or_bin.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POLYGON",
                        "code": "$rc:polygon_or_bin.domain.POLYGON"
                    },
                    {
                        "value": "BIN",
                        "code": "$rc:polygon_or_bin.domain.BIN"
                    }
                ]
            },
            "value": "POLYGON",
            "description": "$rc:polygon_or_bin.descr"
        },
        "polygon_layer": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:polygon_layer.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:polygon_layer.descr"
        },
        "bin_type": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:bin_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SQUARE",
                        "code": "$rc:bin_type.domain.SQUARE"
                    },
                    {
                        "value": "HEXAGON",
                        "code": "$rc:bin_type.domain.HEXAGON"
                    },
                    {
                        "value": "H3",
                        "code": "$rc:bin_type.domain.H3"
                    }
                ]
            },
            "description": "$rc:bin_type.descr"
        },
        "bin_size": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:bin_size.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:bin_size.descr"
        },
        "time_step_interval": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:time_step_interval.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_step_interval.descr"
        },
        "time_step_repeat": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:time_step_repeat.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_step_repeat.descr"
        },
        "time_step_reference": {
            "type": "optional",
            "displayname": "$rc:time_step_reference.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_step_reference.descr"
        },
        "summary_fields": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:summary_fields.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:summary_fields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:summary_fields.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "BigInteger",
                            "Float",
                            "Double",
                            "Text",
                            "Date"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "COUNT",
                                "code": "$rc:summary_fields.domain.item2.COUNT"
                            },
                            {
                                "value": "SUM",
                                "code": "$rc:summary_fields.domain.item2.SUM"
                            },
                            {
                                "value": "MEAN",
                                "code": "$rc:summary_fields.domain.item2.MEAN"
                            },
                            {
                                "value": "MIN",
                                "code": "$rc:summary_fields.domain.item2.MIN"
                            },
                            {
                                "value": "MAX",
                                "code": "$rc:summary_fields.domain.item2.MAX"
                            },
                            {
                                "value": "STDDEV",
                                "code": "$rc:summary_fields.domain.item2.STDDEV"
                            },
                            {
                                "value": "VAR",
                                "code": "$rc:summary_fields.domain.item2.VAR"
                            },
                            {
                                "value": "RANGE",
                                "code": "$rc:summary_fields.domain.item2.RANGE"
                            },
                            {
                                "value": "ANY",
                                "code": "$rc:summary_fields.domain.item2.ANY"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "point_layer"
            ],
            "description": "$rc:summary_fields.descr"
        },
        "bin_resolution": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:bin_resolution.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLong",
                        "value": "0",
                        "code": "0"
                    },
                    {
                        "type": "GPLong",
                        "value": "1",
                        "code": "1"
                    },
                    {
                        "type": "GPLong",
                        "value": "2",
                        "code": "2"
                    },
                    {
                        "type": "GPLong",
                        "value": "3",
                        "code": "3"
                    },
                    {
                        "type": "GPLong",
                        "value": "4",
                        "code": "4"
                    },
                    {
                        "type": "GPLong",
                        "value": "5",
                        "code": "5"
                    },
                    {
                        "type": "GPLong",
                        "value": "6",
                        "code": "6"
                    },
                    {
                        "type": "GPLong",
                        "value": "7",
                        "code": "7"
                    },
                    {
                        "type": "GPLong",
                        "value": "8",
                        "code": "8"
                    },
                    {
                        "type": "GPLong",
                        "value": "9",
                        "code": "9"
                    },
                    {
                        "type": "GPLong",
                        "value": "10",
                        "code": "10"
                    },
                    {
                        "type": "GPLong",
                        "value": "11",
                        "code": "11"
                    },
                    {
                        "type": "GPLong",
                        "value": "12",
                        "code": "12"
                    },
                    {
                        "type": "GPLong",
                        "value": "13",
                        "code": "13"
                    },
                    {
                        "type": "GPLong",
                        "value": "14",
                        "code": "14"
                    },
                    {
                        "type": "GPLong",
                        "value": "15",
                        "code": "15"
                    }
                ]
            },
            "description": "$rc:bin_resolution.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
