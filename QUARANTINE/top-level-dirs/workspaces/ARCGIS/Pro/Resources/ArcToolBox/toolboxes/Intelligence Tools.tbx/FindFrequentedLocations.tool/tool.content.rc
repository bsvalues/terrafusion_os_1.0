{
    "map": {
        "description": "Identifies areas where a movement track has dwelled for multiple time periods and aggregates those locations based on a track identifier.",
        "expression.descr": "An SQL expression used to select a subset of records.",
        "expression.title": "Expression",
        "in_features.descr": "The input movement track points that will be analyzed for possible frequented locations. The layer must be time enabled.",
        "in_features.title": "Input Features",
        "minimum_dwells.descr": "The minimum number of overlapping individual dwells that will need to occur to be defined as a frequented location. By default, all locations that meet the criteria for a dwell will be returned.",
        "minimum_dwells.title": "Minimum Dwells Per Location",
        "minimum_loiter_time.descr": "<xdoc><p>The minimum amount of time a movement track point can loiter in an area before it is considered to be dwelling.</p><p>This value helps identify possible frequented locations where multiple unique movement tracks are dwelling in the same time and space. The default is 10 minutes.</p></xdoc>",
        "minimum_loiter_time.title": "Minimum Loiter Time",
        "normalize_daily_distribution.descr": "<xdoc><p>Specifies whether the daily distribution of dwell locations will be normalized. Normalized values represent a percentage of total time that a dwell location occurred on the particular day, while the real values represent the total number of dwells that occurred on the given day.<ul><li>Checked—The daily distribution of dwell locations values will be normalized.</li><li>Unchecked—The daily distribution of dwell locations values will not be normalized. This is the default.</li></ul></p></xdoc>",
        "normalize_daily_distribution.title": "Normalize Daily Distribution",
        "out_featureclass.descr": "The output polygon feature class containing the possible frequented locations.",
        "out_featureclass.title": "Output Feature Class",
        "search_distance.descr": "The maximum distance a movement track point can loiter before it is no longer considered part of a frequented location. The default is 100 meters.",
        "search_distance.title": "Search Distance",
        "summary_fields.descr": "<xdoc><p>Specifies the statistics that will be calculated.</p><p>Statistics can be calculated for the following variables:</p><ul><li>Start Time—The time in hours that the individual dwell location was first detected. The time is rounded to the nearest hour.</li><li>End Time—The time in hours that the individual dwell location was last detected. The time is rounded to the nearest hour.</li><li>Dwell Duration—The time in seconds that the individual dwell location was active.</li></ul><p>The following statistics are supported:</p><p><ul><li>Mean—The mean of numeric values.</li><li>Min—The minimum value of a numeric field.</li><li>Max—The maximum value of a numeric field.</li><li>Standard Deviation—The standard deviation of a numeric field.</li></ul></p></xdoc>",
        "summary_fields.domain.item1.DWELL_DURATION": "Dwell Duration",
        "summary_fields.domain.item1.END_TIME": "End Time",
        "summary_fields.domain.item1.START_TIME": "Start Time",
        "summary_fields.domain.item2.MAX": "Maximum",
        "summary_fields.domain.item2.MEAN": "Mean",
        "summary_fields.domain.item2.MIN": "Minimum",
        "summary_fields.domain.item2.STD": "Standard Deviation",
        "summary_fields.dt.title1": "Value",
        "summary_fields.dt.title2": "Statistic Type",
        "summary_fields.title": "Summary Fields",
        "time_boundary.descr": "<xdoc><p>The time span that will be used to split the <span class=\"esri_uicontrol\">Input Features</span> parameter value. For example, if you use a time boundary of 1 day, tracks will be split at the beginning of every day.</p></xdoc>",
        "time_boundary.title": "Time Boundary",
        "title": "Find Frequented Locations",
        "track_id_field.descr": "The field containing the unique identifiers that will organize the source data into movement tracks.",
        "track_id_field.title": "Track ID Field"
    }
}
