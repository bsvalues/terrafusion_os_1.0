{
    "map": {
        "acceleration_unit.descr": "<xdoc><p>Specifies the unit of measure that will be used for acceleration values in the output feature class.</p><ul><li><span title=\"METERS_PER_SECOND_SQUARED\">Meters Per Second Squared</span>—The unit of measure will be meters per second squared. This is the default.</li><li><span title=\"FEET_PER_SECOND_SQUARED\">Feet Per Second Squared</span>—The unit of measure will be feet per second squared.</li></ul></xdoc>",
        "acceleration_unit.domain.FEET_PER_SECOND_SQUARED": "Feet Per Second Squared",
        "acceleration_unit.domain.METERS_PER_SECOND_SQUARED": "Meters Per Second Squared",
        "acceleration_unit.title": "Acceleration Unit",
        "data_store.descr": "<xdoc><p>Specifies the ArcGIS Data Store where the output will be stored. All results stored in a spatiotemporal big data store will be stored in WGS84. Results stored in a relational data store will maintain their coordinate system.</p><ul><li><span title=\"SPATIOTEMPORAL_DATA_STORE\">Spatiotemporal big data store</span>—Output will be stored in a spatiotemporal big data store. This is the default.</li><li><span title=\"RELATIONAL_DATA_STORE\">Relational data store</span>—Output will be stored in a relational data store.</li></ul></xdoc>",
        "data_store.domain.RELATIONAL_DATA_STORE": "Relational data store",
        "data_store.domain.SPATIOTEMPORAL_DATA_STORE": "Spatiotemporal big data store",
        "data_store.title": "Data Store",
        "description": "Calculates motion statistics for points in a time-enabled feature class.",
        "distance_method.descr": "<xdoc><p>Specifies the distance measurement method that will be used when calculating motion statistics.</p><ul><li><span title=\"GEODESIC\">Geodesic</span>—Geodesic distance will be used.</li><li><span title=\"PLANAR\">Planar</span>—Planar distance will be used. This is the default.</li></ul></xdoc>",
        "distance_method.domain.GEODESIC": "Geodesic",
        "distance_method.domain.PLANAR": "Planar",
        "distance_method.title": "Distance Method",
        "distance_unit.descr": "<xdoc><p>Specifies the unit of measure that will be used for distance values in the output feature class.</p><ul><li><span title=\"METERS\">Meters</span>—The unit of measure will be meters. This is the default.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The unit of measure will be kilometers.</li><li><span title=\"MILES\">US Survey Miles</span>—The unit of measure will be US survey miles.</li><li><span title=\"NAUTICAL_MILES\">US Survey Nautical Miles</span>—The unit of measure will be US survey nautical miles.</li><li><span title=\"YARDS\">US Survey Yards</span>—The unit of measure will be US survey yards.</li><li><span title=\"FEET\">US Survey Feet</span>—The unit of measure will be US survey feet.</li><li><span title=\"MILES_INT\">Statute Miles</span>—The unit of measure will be statute miles.</li><li><span title=\"NAUTICAL_MILES_INT\">International Nautical Miles</span>—The unit of measure will be international nautical miles.</li><li><span title=\"YARDS_INT\">International Yards</span>—The unit of measure will be international yards.</li><li><span title=\"FEET_INT\">International Feet</span>—The unit of measure will be international feet.</li></ul></xdoc>",
        "distance_unit.domain.FEET": "US Survey Feet",
        "distance_unit.domain.FEET_INT": "International Feet",
        "distance_unit.domain.KILOMETERS": "Kilometers",
        "distance_unit.domain.METERS": "Meters",
        "distance_unit.domain.MILES": "US Survey Miles",
        "distance_unit.domain.MILES_INT": "Statute Miles",
        "distance_unit.domain.NAUTICAL_MILES": "US Survey Nautical Miles",
        "distance_unit.domain.NAUTICAL_MILES_INT": "International Nautical Miles",
        "distance_unit.domain.YARDS": "US Survey Yards",
        "distance_unit.domain.YARDS_INT": "International Yards",
        "distance_unit.title": "Distance Unit",
        "duration_unit.descr": "<xdoc><p>Specifies the unit of measure that will be used for duration values in the output feature class.</p><ul><li><span title=\"YEARS\">Years</span>—The unit of measure will be years.</li><li><span title=\"MONTHS\">Months</span>—The unit of measure will be months.</li><li><span title=\"WEEKS\">Weeks</span>—The unit of measure will be weeks.</li><li><span title=\"DAYS\">Days</span>—The unit of measure will be days.</li><li><span title=\"HOURS\">Hours</span>—The unit of measure will be hours.</li><li><span title=\"MINUTES\">Minutes</span>—The unit of measure will be minutes.</li><li><span title=\"SECONDS\">Seconds</span>—The unit of measure will be seconds. This is the default.</li><li><span title=\"MILLISECONDS\">Milliseconds</span>—The unit of measure will be milliseconds.</li></ul></xdoc>",
        "duration_unit.domain.DAYS": "Days",
        "duration_unit.domain.HOURS": "Hours",
        "duration_unit.domain.MILLISECONDS": "Milliseconds",
        "duration_unit.domain.MINUTES": "Minutes",
        "duration_unit.domain.MONTHS": "Months",
        "duration_unit.domain.SECONDS": "Seconds",
        "duration_unit.domain.WEEKS": "Weeks",
        "duration_unit.domain.YEARS": "Years",
        "duration_unit.title": "Duration Unit",
        "elevation_unit.descr": "<xdoc><p>Specifies the unit of measure that will be used for elevation values in the output feature class.</p><ul><li><span title=\"METERS\">Meters</span>—The unit of measure will be meters. This is the default.</li><li><span title=\"KILOMETERS\">Kilometers</span>—The unit of measure will be US survey kilometers.</li><li><span title=\"MILES\">US Survey Miles</span>—The unit of measure will be US survey miles.</li><li><span title=\"YARDS\">US Survey Yards</span>—The unit of measure will be US survey yards.</li><li><span title=\"FEET\">US Survey Feet</span>—The unit of measure will be US survey feet.</li><li><span title=\"MILES_INT\">Statute Miles</span>—The unit of measure will be statute miles.</li><li><span title=\"YARDS_INT\">International Yards</span>—The unit of measure will be international yards.</li><li><span title=\"FEET_INT\">International Feet</span>—The unit of measure will be international feet.</li></ul></xdoc>",
        "elevation_unit.domain.FEET": "US Survey Feet",
        "elevation_unit.domain.FEET_INT": "International Feet",
        "elevation_unit.domain.KILOMETERS": "Kilometers",
        "elevation_unit.domain.METERS": "Meters",
        "elevation_unit.domain.MILES": "US Survey Miles",
        "elevation_unit.domain.MILES_INT": "Statute Miles",
        "elevation_unit.domain.YARDS": "US Survey Yards",
        "elevation_unit.domain.YARDS_INT": "International Yards",
        "elevation_unit.title": "Elevation Unit",
        "idle_dist_tolerance.descr": "<xdoc><p>The maximum distance that two sequential points in a track can be apart and still be considered idle. This parameter is used with the <span class=\"esri_uicontrol\">Idle Time Tolerance</span> parameter to determine whether an entity is idling. The <span class=\"esri_uicontrol\">Idle Distance Tolerance</span> parameter is required if the <span class=\"esri_uicontrol\">Idle</span> statistic group is specified for the <span class=\"esri_uicontrol\">Motion Statistics</span> parameter or if statistics in all the groups will be calculated.</p></xdoc>",
        "idle_dist_tolerance.title": "Idle Distance Tolerance",
        "idle_time_tolerance.descr": "<xdoc><p>The minimum duration that two sequential points in a track must be near each other to be considered idle. This parameter is used with the <span class=\"esri_uicontrol\">Idle Distance Tolerance</span> parameter to determine whether an entity is idling. The <span class=\"esri_uicontrol\">Idle Time Tolerance</span> parameter is required if the <span class=\"esri_uicontrol\">Idle</span> statistic group is specified for the <span class=\"esri_uicontrol\">Motion Statistics</span> parameter or if statistics in all the groups will be calculated.</p></xdoc>",
        "idle_time_tolerance.title": "Idle Time Tolerance",
        "input_layer.descr": "The time-enabled point features on which motion statistics will be calculated.",
        "input_layer.title": "Input Layer",
        "motion_statistics.descr": "<xdoc><p>Specifies the group containing the statistics that will be calculated and written to the result. If no value is specified, all statistics from all groups will be calculated.</p><ul><li><span title=\"DISTANCE\">Distance</span>—The distance between the current and previous observation and the maximum, minimum, average, and total distance in the track history window will be calculated.</li><li><span title=\"DURATION\">Duration</span>—The duration between the current and previous observation and the maximum, minimum, average, and total duration in the track history window will be calculated.</li><li><span title=\"SPEED\">Speed</span>—The speed of travel between the current and previous observation and the maximum, minimum, and average speed in the track history window will be calculated.</li><li><span title=\"ACCELERATION\">Acceleration</span>—The acceleration between the current speed and the previous speed and the maximum, minimum, and average acceleration in the track history window will be calculated.</li><li><span title=\"ELEVATION\">Elevation</span>—The current elevation, the elevation change between the current and previous observation, and the maximum, minimum, average, and total elevation change in the track history window will be calculated.</li><li><span title=\"SLOPE\">Slope</span>—The slope between the current and previous observation and the maximum, minimum, and average slope in the track history window will be calculated.</li><li><span title=\"IDLE\">Idle</span>—A determination as to whether an entity is currently idling will be made and the percentage of idle time and total idle time in the track history window will be calculated.</li><li><span title=\"BEARING\">Bearing</span>—The angle of travel between the previous observation and the current observation will be calculated.</li></ul></xdoc>",
        "motion_statistics.domain.ACCELERATION": "Acceleration",
        "motion_statistics.domain.BEARING": "Bearing",
        "motion_statistics.domain.DISTANCE": "Distance",
        "motion_statistics.domain.DURATION": "Duration",
        "motion_statistics.domain.ELEVATION": "Elevation",
        "motion_statistics.domain.IDLE": "Idle",
        "motion_statistics.domain.SLOPE": "Slope",
        "motion_statistics.domain.SPEED": "Speed",
        "motion_statistics.title": "Motion Statistics",
        "output.title": "Output Feature Layer",
        "output_name.descr": "The name of the result layer.",
        "output_name.title": "Output Name",
        "params.category1": "Advanced Options",
        "params.category2": "Data Store",
        "speed_unit.descr": "<xdoc><p>Specifies the unit of measure that will be used for speed values in the output feature class.</p><ul><li><span title=\"METERS_PER_SECOND\">Meters Per Second</span>—The unit of measure will be meters per second. This is the default.</li><li><span title=\"MILES_PER_HOUR\">Miles Per Hour</span>—The unit of measure will be miles per hour.</li><li><span title=\"KILOMETERS_PER_HOUR\">Kilometers Per Hour</span>—The unit of measure will be kilometers per hour.</li><li><span title=\"FEET_PER_SECOND\">Feet Per Second</span>—The unit of measure will be feet per second.</li><li><span title=\"NAUTICAL_MILES_PER_HOUR\">Nautical Miles Per Hour</span>—The unit of measure will be nautical miles per hour.</li></ul></xdoc>",
        "speed_unit.domain.FEET_PER_SECOND": "Feet Per Second",
        "speed_unit.domain.KILOMETERS_PER_HOUR": "Kilometers Per Hour",
        "speed_unit.domain.METERS_PER_SECOND": "Meters Per Second",
        "speed_unit.domain.MILES_PER_HOUR": "Miles Per Hour",
        "speed_unit.domain.NAUTICAL_MILES_PER_HOUR": "Nautical Miles Per Hour",
        "speed_unit.title": "Speed Unit",
        "summary": "<xdoc><p>Calculates motion statistics for points in a time-enabled feature class.</p><p><note type=\"legacy\"/><p group=\"note\">The ArcGIS GeoAnalytics Server extension is being deprecated in ArcGIS Enterprise. The final release of GeoAnalytics Server was included with ArcGIS Enterprise 11.3. This geoprocessing tool is available through ArcGIS Enterprise 11.3 and earlier versions.</p></p></xdoc>",
        "time_boundary_reference.descr": "The reference time used to split the input data into for analysis. Time boundaries will be created for the entire span of the data, and the reference time does not need to occur at the start. If no reference time is specified, January 1, 1970, is used. This parameter is only available with ArcGIS Enterprise 10.7 and later.",
        "time_boundary_reference.title": "Time Boundary Reference",
        "time_boundary_split.descr": "A time span to split the input data into for analysis. A time boundary allows you to analyze values within a defined time span. For example, if you use a time boundary of 1 day, starting on January 1, 1980, tracks will be split at the beginning of every day. This parameter is only available with ArcGIS Enterprise 10.7 and later.",
        "time_boundary_split.title": "Time Boundary Split",
        "title": "Calculate Motion Statistics",
        "track_fields.descr": "One or more fields that will be used to identify distinct entities.",
        "track_fields.title": "Track Fields",
        "track_history_window.descr": "The number of observations (including the current observation) that will be used for summary statistics. The default value is 3, which means that the summary statistics will be calculated at each point in a track using the current observation and the previous two observations. This parameter does not affect instantaneous statistics or idle classification.",
        "track_history_window.title": "Track History Window"
    }
}
