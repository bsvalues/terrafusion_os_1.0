{
    "map": {
        "description": "Identifies inconsistencies in the delta (A and D) tables of datasets that are registered for traditional versioning.",
        "input_database.descr": "The database connection (.sde file) to the enterprise geodatabase in which delta table inconsistencies may exist. The connection must be made as the geodatabase administrator.",
        "input_database.title": "Input Database Connection",
        "input_tables.descr": "A single table or a text file containing a list of versioned tables with the associated delta tables to be checked for inconsistencies. Use fully-qualified table names in the text file, and place one table name per line. If no file is specified, all tables in the geodatabase are processed.",
        "input_tables.title": "Input Tables",
        "out_log.descr": "The path and name of the output log file. The log file is an ASCII file containing a list of the tables in the specified version that contain inconsistent records, as well as information about the connection file, geodatabase version, and tables for which the tool was run.",
        "out_log.title": "Diagnose Version Tables Log",
        "out_workspace.title": "Input Workspace",
        "target_version.descr": "<xdoc><p>The geodatabase version with the delta tables that will be checked for inconsistencies. The drop-down list is populated with the existing versions in the geodatabase specified for the <span class=\"esri_uicontrol\">Input Database Connection</span> parameter. If no version is selected, all versions will be processed.</p></xdoc>",
        "target_version.title": "Target Version",
        "title": "Diagnose Version Tables"
    }
}
