{
    "map": {
        "description": "Deletes all or the selected subset of features from the input.",
        "in_features.descr": "The feature class, shapefile, or layer containing features to be deleted.",
        "in_features.title": "Input Features",
        "out_feature_class.title": "Output Feature Class",
        "summary": "<xdoc><p>Deletes all or the selected subset of features from the input.</p><p>The deletion of all features or a subset of features depends on the following:<ul><li>If the input is a feature class, all features will be deleted.</li><li>If the input is a layer with no selection, all features will be deleted.</li><li>If the input is a layer with a selection, only the selected features will be deleted.</li></ul></p></xdoc>",
        "title": "Delete Features"
    }
}
