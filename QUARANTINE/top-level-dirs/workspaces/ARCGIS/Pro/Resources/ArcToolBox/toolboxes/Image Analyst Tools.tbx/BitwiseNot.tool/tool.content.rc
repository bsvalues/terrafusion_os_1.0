{
    "map": {
        "description": "Performs a Bitwise Not (complement) operation on the binary value of an input raster.",
        "in_raster_or_constant.descr": "<xdoc><p>The input raster on which to perform the Bitwise Not (complement) operation.</p><p>A number can be used as an input for this parameter, provided a raster is specified for the other parameter. To specify a number for both inputs, the cell size and extent must first be set in the environment.</p></xdoc>",
        "in_raster_or_constant.title": "Input raster or constant value",
        "out_raster.descr": "<xdoc><p>The output raster.</p><p>The cell values are the result of a Bitwise Not operation on the input.</p></xdoc>",
        "out_raster.title": "Output raster",
        "title": "Bitwise Not"
    }
}
