{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\VisualizeSpaceTimeCube2D",
    "displayname": "$rc:title",
    "helpcontent": "50010001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_cube": {
            "display_order": "0",
            "displayname": "$rc:in_cube.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "nc"
                ]
            },
            "description": "$rc:in_cube.descr"
        },
        "cube_variable": {
            "display_order": "1",
            "displayname": "$rc:cube_variable.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:cube_variable.descr"
        },
        "display_theme": {
            "display_order": "2",
            "displayname": "$rc:display_theme.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "LOCATIONS_WITH_DATA",
                        "code": "$rc:display_theme.domain.LOCATIONS_WITH_DATA"
                    },
                    {
                        "value": "TRENDS",
                        "code": "$rc:display_theme.domain.TRENDS"
                    },
                    {
                        "value": "HOT_AND_COLD_SPOT_TRENDS",
                        "code": "$rc:display_theme.domain.HOT_AND_COLD_SPOT_TRENDS"
                    },
                    {
                        "value": "EMERGING_HOT_SPOT_ANALYSIS_RESULTS",
                        "code": "$rc:display_theme.domain.EMERGING_HOT_SPOT_ANALYSIS_RESULTS"
                    },
                    {
                        "value": "LOCAL_OUTLIER_ANALYSIS_RESULTS",
                        "code": "$rc:display_theme.domain.LOCAL_OUTLIER_ANALYSIS_RESULTS"
                    },
                    {
                        "value": "PERCENTAGE_OF_LOCAL_OUTLIERS",
                        "code": "$rc:display_theme.domain.PERCENTAGE_OF_LOCAL_OUTLIERS"
                    },
                    {
                        "value": "LOCAL_OUTLIER_IN_MOST_RECENT_TIME_PERIOD",
                        "code": "$rc:display_theme.domain.LOCAL_OUTLIER_IN_MOST_RECENT_TIME_PERIOD"
                    },
                    {
                        "value": "TIME_SERIES_CLUSTERING_RESULTS",
                        "code": "$rc:display_theme.domain.TIME_SERIES_CLUSTERING_RESULTS"
                    },
                    {
                        "value": "LOCATIONS_WITHOUT_SPATIAL_NEIGHBORS",
                        "code": "$rc:display_theme.domain.LOCATIONS_WITHOUT_SPATIAL_NEIGHBORS"
                    },
                    {
                        "value": "NUMBER_OF_ESTIMATED_BINS",
                        "code": "$rc:display_theme.domain.NUMBER_OF_ESTIMATED_BINS"
                    },
                    {
                        "value": "LOCATIONS_EXCLUDED_FROM_ANALYSIS",
                        "code": "$rc:display_theme.domain.LOCATIONS_EXCLUDED_FROM_ANALYSIS"
                    },
                    {
                        "value": "FORECAST_RESULTS",
                        "code": "$rc:display_theme.domain.FORECAST_RESULTS"
                    },
                    {
                        "value": "TIME_SERIES_OUTLIER_RESULTS",
                        "code": "$rc:display_theme.domain.TIME_SERIES_OUTLIER_RESULTS"
                    },
                    {
                        "value": "TIME_SERIES_CHANGE_POINTS",
                        "code": "$rc:display_theme.domain.TIME_SERIES_CHANGE_POINTS"
                    },
                    {
                        "value": "TIME_SERIES_CROSS_CORRELATION_RESULTS",
                        "code": "$rc:display_theme.domain.TIME_SERIES_CROSS_CORRELATION_RESULTS"
                    }
                ]
            },
            "description": "$rc:display_theme.descr"
        },
        "output_features": {
            "direction": "out",
            "display_order": "4",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "in_cube"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "featuretype.rule": "AsSpecified",
                "featuretype": "Simple",
                "geometrytype.rule": "AsSpecified",
                "geometrytype": "Polygon",
                "fields.rule": "None",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "enable_time_series_popups": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:enable_time_series_popups.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE_POPUP"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_POPUP"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:enable_time_series_popups.descr"
        }
    },
    "environments": [
        "geographicTransformations",
        "outputCoordinateSystem",
        "scratchWorkspace",
        "workspace"
    ]
}
