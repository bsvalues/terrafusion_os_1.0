                        "displayname": "$rc:match_fields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:match_fields.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text",
                    "Date",
                    "Blob",
                    "Raster",
                    "XML",
                    "GUID",
                    "OID"
                ],
                "exclude.field": [
                    "SHAPE_Length",
                    "SHAPE_Area"
                ]
            },
            "depends": [
                "in_features",
                "target_features"
            ],
            "description": "$rc:match_fields.descr"
