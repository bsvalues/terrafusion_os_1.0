                    "Polyline",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple",
                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexJunction",
                    "ComplexEdge",
                    "RasterCatalogItem"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "target_features": {
            "displayname": "$rc:target_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple",
                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexJunction",
                    "ComplexEdge",
                    "RasterCatalogItem"
                ]
            },
            "description": "$rc:target_features.descr"
        },
        "search_distance": {
            "displayname": "$rc:search_distance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "target_features"
            ],
            "description": "$rc:search_distance.descr"
        },
        "match_fields": {
