{
    "map": {
        "config_keyword.descr": "<xdoc><p>Specifies the default storage parameters (configurations) for geodatabases in a relational database management system (RDBMS). This setting is applicable only when using enterprise geodatabase tables.</p><p>Configuration keywords are set by the database administrator.</p></xdoc>",
        "config_keyword.title": "Config Keyword",
        "description": "Exports the rows of a table   to a different table.",
        "field_mapping.descr": "<xdoc><p>The fields that will be transferred to the output dataset with their respective properties and source fields. The output includes all fields from the input dataset by default.</p><p>Use the field map to add, delete, rename, and reorder fields, as well as change other field properties.</p><p>The field map can also be used to combine values from two or more input fields into a single output field.</p></xdoc>",
        "field_mapping.title": "Field Map",
        "in_rows.descr": "The input table that will be exported to a new table.",
        "in_rows.title": "Input Rows",
        "out_name.descr": "<xdoc><p>The name of the output table.</p><p>If the output location is a folder, include an extension such as .csv, .txt, or .dbf to export the table to that format. If the output location is a geodatabase, do not specify an extension.</p></xdoc>",
        "out_name.title": "Output Name",
        "out_path.descr": "The destination where the output table will be written.",
        "out_path.title": "Output Location",
        "out_table.title": "Output Table",
        "params.category1": "Fields",
        "params.category2": "Geodatabase Settings (optional)",
        "summary": "<xdoc><p>Exports the rows of a table to a different table.</p><note type=\"legacy\"/><p group=\"note\">This is a deprecated tool. This functionality has been replaced by the Export Table tool.</p></xdoc>",
        "title": "Table To Table",
        "where_clause.descr": "An SQL expression that will be used to select a subset of records.",
        "where_clause.title": "Expression"
    }
}
