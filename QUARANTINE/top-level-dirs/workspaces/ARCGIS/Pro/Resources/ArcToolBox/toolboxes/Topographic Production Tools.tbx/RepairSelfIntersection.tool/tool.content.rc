{
    "map": {
        "description": "Repairs self-intersecting line or polygon features. The portion between the feature and the intersection points are either deleted or split into a new feature.",
        "in_features.descr": "The polyline or polygon feature class with the self-intersections that will be repaired.",
        "in_features.title": "Input Features",
        "max_length.descr": "The maximum length of the segment between the points of self-intersection. Only segments shorter than the specified maximum length will be removed.",
        "max_length.title": "Maximum Removal Length",
        "modified_in_features.title": "Updated Input Features",
        "repair_at_end_point.descr": "<xdoc><p>Specifies whether self-intersections with an end point that snaps to itself will be removed.</p><ul><li>Checked—Self-intersections with an end point that snaps to itself will be removed.</li><li>Unchecked—Self-intersections with an end point that snaps to itself (such as a cul-de-sac) will not be removed. This is the default.</li></ul></xdoc>",
        "repair_at_end_point.title": "Remove Self Intersections at End Point",
        "repair_type.descr": "<xdoc><p>Specifies whether self-intersections will be deleted or split.</p><ul><li><span title=\"DELETE\">Delete</span>—Self-intersections will be deleted. This is the default.</li><li><span title=\"SPLIT\">Split</span>—Self-intersections will be split at the intersection point and retained.</li></ul></xdoc>",
        "repair_type.domain.DELETE": "Delete",
        "repair_type.domain.SPLIT": "Split",
        "repair_type.title": "Repair Type",
        "title": "Repair Self Intersection"
    }
}
