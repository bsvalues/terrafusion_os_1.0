{
    "type": "FunctionTool",
    "guid": "{33CA4A60-4D2E-4583-8844-3D0A75F6D305}/CreateWorkflowDatabase",
    "displayname": "$rc:title",
    "helpcontent": "35000011",
    "description": "$rc:description",
    "product": "200",
    "extensions": [
        "40"
    ],
    "params": {
        "Input_Database_Connection": {
            "displayname": "$rc:input_database_connection.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Remote Database"
                ]
            },
            "description": "$rc:input_database_connection.descr"
        },
        "AOI_Spatial_Reference": {
            "displayname": "$rc:aoi_spatial_reference.title",
            "datatype": {
                "type": "GPCoordinateSystem"
            },
            "description": "$rc:aoi_spatial_reference.descr"
        },
        "Import_Configuration": {
            "displayname": "$rc:import_configuration.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "Minimum Configuration",
                        "code": "$rc:import_configuration.domain.Minimum Configuration"
                    },
                    {
                        "value": "Quick Configuration",
                        "code": "$rc:import_configuration.domain.Quick Configuration"
                    },
                    {
                        "value": "Custom Configuration",
                        "code": "$rc:import_configuration.domain.Custom Configuration"
                    }
                ]
            },
            "description": "$rc:import_configuration.descr"
        },
        "Input_Custom_Configuration": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:input_custom_configuration.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "jxl"
                ]
            },
            "depends": [
                "Import_Configuration"
            ],
            "description": "$rc:input_custom_configuration.descr"
        },
        "User_Store": {
            "type": "optional",
            "displayname": "$rc:user_store.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TRADITIONAL",
                        "code": "$rc:user_store.domain.TRADITIONAL"
                    },
                    {
                        "value": "PORTAL",
                        "code": "$rc:user_store.domain.PORTAL"
                    }
                ]
            },
            "description": "$rc:user_store.descr"
        },
        "Output_DatabasePath": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_databasepath.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "jtc"
                ]
            }
        }
    },
    "environments": [
        "configKeyword"
    ]
}
