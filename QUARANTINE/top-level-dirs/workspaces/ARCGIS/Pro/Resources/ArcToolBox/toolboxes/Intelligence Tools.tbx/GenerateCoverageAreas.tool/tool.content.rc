{
    "map": {
        "buffer_type.descr": "<xdoc><p>The distance around the input features that will be buffered. Distances can be provided as either a linear distance or a field from the <span class=\"esri_uicontrol\">Input Features</span> parameter value that defines the individual ranges and units to buffer each feature.</p></xdoc>",
        "buffer_type.title": "Buffer Type",
        "description": "Creates a proximity buffer for input Intelligence, Surveillance, and Reconnaissance (ISR) or patrol assets for use in the Generate Blind Spot Areas tool.",
        "end_time_field.descr": "The field containing the end date and time the asset is no longer available.",
        "end_time_field.title": "End Time Field",
        "in_features.descr": "The input asset features.",
        "in_features.title": "Input Features",
        "out_feature_class.descr": "The output blind spot buffer features.",
        "out_feature_class.title": "Output Blind Spot Buffer",
        "range_unit.descr": "<xdoc><p>Specifies the linear unit that will be used when the chosen <span class=\"esri_uicontrol\">Buffer Type</span> parameter value does not contain the unit of distance.</p><ul><li><span title=\"Meters\">Meters</span>—The distance unit will be meters.</li><li><span title=\"Kilometers\">Kilometers</span>—The distance unit will be kilometers.</li><li><span title=\"Feet\">Feet</span>—The distance unit will be feet.</li><li><span title=\"Miles\">Miles</span>—The distance unit will be miles.</li><li><span title=\"NauticalMiles\">Nautical Miles</span>—The distance unit will be nautical miles.</li></ul></xdoc>",
        "range_unit.domain.Feet": "Feet",
        "range_unit.domain.Kilometers": "Kilometers",
        "range_unit.domain.Meters": "Meters",
        "range_unit.domain.Miles": "Miles",
        "range_unit.domain.NauticalMiles": "Nautical Miles",
        "range_unit.title": "Range Unit",
        "start_time_field.descr": "The field containing the start date and time the asset is available.",
        "start_time_field.title": "Start Time Field",
        "summary": "<xdoc><p>Creates a proximity buffer for input Intelligence, Surveillance, and Reconnaissance (ISR) or patrol assets for use in the Generate Blind Spot Areas tool.</p><p>The output should be considered the areas that are being observed by the assets for the given input locations for the specified time periods. For example, the output can represent the areas visible to a guard as they move from post to post for given time periods at each post.</p></xdoc>",
        "title": "Generate Coverage Areas"
    }
}
