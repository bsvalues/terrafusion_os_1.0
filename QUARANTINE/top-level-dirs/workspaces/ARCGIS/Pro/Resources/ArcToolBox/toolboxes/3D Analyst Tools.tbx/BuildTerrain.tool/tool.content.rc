        "derived_out_terrain.title": "Updated Input Terrain",
        "description": "Performs tasks required for analyzing and displaying a terrain dataset.",
        "in_terrain.descr": "The terrain dataset that will be processed.",
        "in_terrain.title": "Input Terrain",
        "title": "Build Terrain",
        "update_extent.descr": "<xdoc><p>Recalculates the data extent of a window-size-based terrain dataset when the data area has been reduced through editing. It is not needed if the data extent has increased or if the terrain dataset is z-tolerance based. It will scan through all the terrain data to determine the new extent.</p><ul><li><span title=\"NO_UPDATE_EXTENT\">Maintain Extent</span>— The extent of the terrain dataset will not be recalculated. This is the default.</li><li><span title=\"UPDATE_EXTENT\">Update Extent</span>— The extent of the terrain dataset will be recalculated.</li></ul></xdoc>",
        "update_extent.domain.NO_UPDATE_EXTENT": "Maintain Extent",
        "update_extent.domain.UPDATE_EXTENT": "Update Extent",
        "update_extent.title": "Update Extent"
    }
