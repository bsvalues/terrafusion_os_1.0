{
    "map": {
        "base_features.descr": "The line features that will be compared to the update features for change detection.",
        "base_features.title": "Base Features",
        "change_tolerance.descr": "<xdoc><p>The distance used to determine if there is a spatial change. All matched update features and base features are compared to this tolerance. If any portions of the update or the base features fall outside the zone around the matched feature, it is considered a spatial change. The value must be greater than the XY Tolerance of the input data so this process can be performed and the output will include the <span class=\"esri_fieldname\">LEN_PCT</span> and <span class=\"esri_fieldname\">LEN_ABS</span> fields. The default is 0, meaning this process is not performed. Any value between 0 and the data&apos;s XY Tolerance (inclusively) will make the process irrelevant and will be replaced by 0. You can choose a unit; the default is the feature unit.</p></xdoc>",
        "change_tolerance.title": "Change Tolerance",
        "compare_fields.descr": "The fields that will determine if there is an attribute change between the matched update and base features.",
        "compare_fields.dt.title1": "Source Fields",
        "compare_fields.dt.title2": "Target Fields",
        "compare_fields.title": "Compare Fields",
        "compare_line_direction.descr": "<xdoc><p>Specifies whether line directions will be compared for matched features.</p><ul><li>Unchecked—Line directions will not be compared for matched features. This is the default.</li><li>Checked—Line directions will be compared for matched features.</li></ul></xdoc>",
        "compare_line_direction.title": "Compare line direction",
        "description": "Finds where the update line features spatially match the base line features and detects spatial changes, attribute changes, or both, as well as no change. It then creates an output feature class containing matched update features with information about their changes, unmatched update features, and unmatched base features.",
        "match_fields.descr": "The match fields from the update and base features. If specified, each pair of fields are compared for match candidates to help determine the right match.",
        "match_fields.dt.title1": "Source Fields",
        "match_fields.dt.title2": "Target Fields",
        "match_fields.title": "Match Fields",
        "out_feature_class.descr": "The output line feature class containing the change information. The output contains all participating update features (matched and unmatched) and any unmatched base features.",
        "out_feature_class.title": "Output Feature Class",
        "out_match_table.descr": "The output table containing complete feature matching information.",
        "out_match_table.title": "Output Match Table",
        "search_distance.descr": "The distance that will be used to search for match candidates. A distance must be specified and it must be greater than zero. You can choose a preferred unit. The default is the feature unit.",
        "search_distance.title": "Search Distance",
        "title": "Detect Feature Changes",
        "update_features.descr": "The line features that will be compared to the base features.",
        "update_features.title": "Update Features"
    }
