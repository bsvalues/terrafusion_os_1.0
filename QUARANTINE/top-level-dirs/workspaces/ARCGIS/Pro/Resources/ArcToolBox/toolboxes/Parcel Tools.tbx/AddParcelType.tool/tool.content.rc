{
    "map": {
        "administrative_polygon.descr": "<xdoc><p>Specifies whether the parcel type will be used to store parcels with administrative boundaries or regular boundaries. Administrative boundaries are used for very large parcels such as country parcels or state parcels. The parcel type polygon feature class will not participate in the parcel fabric topology.</p><ul><li>Checked—The parcel type will be used to store administrative boundaries. The parcel type polygon feature class will not participate in the parcel fabric topology.</li><li>Unchecked—The parcel type will not be used to store administrative boundaries. The parcel type polygon feature class will participate in the parcel fabric topology. This is the default.</li></ul></xdoc>",
        "administrative_polygon.title": "Use for administrative boundaries",
        "description": "Adds a parcel type to a parcel fabric. A parcel type is defined by a separate polygon and line feature class. Parcel type feature classes are controlled by the parcel fabric dataset.",
        "in_parcel_fabric.descr": "The parcel fabric to which the parcel type will be added. The parcel fabric can be from a file, enterprise, or mobile geodatabase.",
        "in_parcel_fabric.title": "Input Parcel Fabric",
        "name.descr": "The name of the parcel type. The name will be assigned to the output polygon and line feature classes.",
        "name.title": "Name",
        "out_line_fc.title": "Output Line Feature Class",
        "out_polygon_fc.title": "Output Polygon Feature Class",
        "summary": "<xdoc><p>Adds a parcel type to a parcel fabric. A parcel type is defined by a separate polygon and line feature class. Parcel type feature classes are controlled by the parcel fabric dataset.</p><p>Parcels are stored in the parcel fabric as parcel types. Examples of parcel types are ownership parcels, administrative parcels, and subdivision parcels.</p></xdoc>",
        "title": "Add Parcel Type",
        "updated_parcel_fabric.title": "Updated Parcel Fabric"
    }
}
