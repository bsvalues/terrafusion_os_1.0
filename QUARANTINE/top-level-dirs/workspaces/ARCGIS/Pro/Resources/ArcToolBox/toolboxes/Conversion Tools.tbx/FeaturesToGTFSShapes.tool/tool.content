{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "2140007",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_shape_lines": {
            "displayname": "$rc:in_shape_lines.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_shape_lines.descr"
        },
        "in_shape_stops": {
            "displayname": "$rc:in_shape_stops.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_shape_stops.descr"
        },
        "in_gtfs_trips": {
            "displayname": "$rc:in_gtfs_trips.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "txt"
                ]
            },
            "description": "$rc:in_gtfs_trips.descr"
        },
        "in_gtfs_stop_times": {
            "displayname": "$rc:in_gtfs_stop_times.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "txt"
                ]
            },
            "description": "$rc:in_gtfs_stop_times.descr"
        },
        "out_gtfs_shapes": {
            "direction": "out",
            "displayname": "$rc:out_gtfs_shapes.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "txt"
                ]
            },
            "description": "$rc:out_gtfs_shapes.descr"
        },
        "out_gtfs_stop_times": {
            "direction": "out",
            "displayname": "$rc:out_gtfs_stop_times.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "txt"
                ]
            },
            "description": "$rc:out_gtfs_stop_times.descr"
        },
        "distance_units": {
            "type": "optional",
            "displayname": "$rc:distance_units.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "MILES",
                        "code": "$rc:distance_units.domain.MILES"
                    },
                    {
                        "value": "METERS",
                        "code": "$rc:distance_units.domain.METERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:distance_units.domain.KILOMETERS"
                    }
                ]
            },
            "value": "MILES",
            "description": "$rc:distance_units.descr"
        }
    },
    "environments": [
        "randomGenerator"
    ]
}
