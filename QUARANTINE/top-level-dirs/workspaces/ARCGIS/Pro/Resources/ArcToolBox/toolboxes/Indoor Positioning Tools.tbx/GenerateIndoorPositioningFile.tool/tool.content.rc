{
    "map": {
        "description": "Generates a positioning file from ArcGIS IPS Setup survey recordings.",
        "in_ips_comment.descr": "<xdoc><p>The text that will be used to populate the <span class=\"esri_fieldname\">Comment</span> field of the positioning file entry in the <span class=\"esri_uicontrol\">Target IPS Positioning Table</span> value.</p></xdoc>",
        "in_ips_comment.title": "Comment",
        "in_ips_recordings.descr": "The feature class or feature service that contains IPS Setup survey recordings.",
        "in_ips_recordings.title": "IPS Recordings Features",
        "in_ips_transitions.descr": "<xdoc><p>The line feature class that contains the <span class=\"esri_fieldname\">TRANSITION_TYPE</span>, <span class=\"esri_fieldname\">VERTICAL_ORDER_FROM</span>, and <span class=\"esri_fieldname\">VERTICAL_ORDER_TO</span> fields that define facility entrances and exits. These are used by ArcGIS IPS to improve indoor and outdoor localization and switching. The <span class=\"esri_fieldname\">TRANSITION_TYPE</span> field for entrances and exits must contain a value of 7 to be used by this tool.</p></xdoc>",
        "in_ips_transitions.title": "IPS Transitions Features",
        "out_ips_positioning.title": "Updated IPS Positioning Table",
        "summary": "<xdoc><p>Generates a positioning file from ArcGIS IPS Setup survey recordings.</p><note type=\"note\"/><p group=\"note\">The Generate Indoor Positioning Dataset tool provides enhanced functionality and performance.</p></xdoc>",
        "target_ips_positioning.descr": "The table or feature service where the generated IPS positioning file will be stored.",
        "target_ips_positioning.title": "Target IPS Positioning Table",
        "title": "Generate Indoor Positioning File"
    }
}
