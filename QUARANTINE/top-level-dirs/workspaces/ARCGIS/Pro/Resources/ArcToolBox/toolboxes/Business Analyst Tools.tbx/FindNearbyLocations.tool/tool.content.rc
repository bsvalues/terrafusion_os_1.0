{
    "map": {
        "create_report.descr": "<xdoc><p>Specifies whether an output report will be created.</p><ul><li>Checked—A report will be created.</li><li>Unchecked—A report will not be created. This is the default.</li></ul></xdoc>",
        "create_report.title": "Create Report",
        "description": "Identifies locations closest to the input features based on a selected distance type. The number of points in the output is defined by limiting the count or percentage of location points to return or by limiting the distance from the input points.",
        "distance_limit.descr": "The analysis extent measured in distance or time.",
        "distance_limit.title": "Distance Limit",
        "distance_type.descr": "<xdoc><p>The calculated distance based on the method of travel. <span class=\"esri_uicontrol\">Straight Line</span> is the default value.</p></xdoc>",
        "distance_type.title": "Distance Type",
        "id_field.descr": "A field containing unique identifiers for each input feature.",
        "id_field.title": "ID Field",
        "in_features.descr": "<xdoc><p>The point layer to be measured to or from the <span class=\"esri_uicontrol\">Location Points</span> parameter value.</p></xdoc>",
        "in_features.title": "Input Features",
        "in_location_points.descr": "<xdoc><p>The layer that will be used to generate the output with distance and direction attributes to or from the <span class=\"esri_uicontrol\">Input Features</span> parameter value.</p></xdoc>",
        "in_location_points.title": "Location Points",
        "location_name.descr": "<xdoc><p>A field from the input <span class=\"esri_uicontrol\">Location Points</span> parameter. This field contains the name or ID for each input point used in the Find Nearby Locations report.</p></xdoc>",
        "location_name.title": "Location Name",
        "number_limit.descr": "<xdoc><p>The numeric limit of the <span class=\"esri_uicontrol\">Location Points</span> value.</p></xdoc>",
        "number_limit.title": "Number of Locations Limit",
        "out_feature_class.descr": "The output location point features.",
        "out_feature_class.title": "Output Feature Class",
        "output_report.title": "Output Report",
        "params.category1": "Report Options",
        "params.category2": "Network Parameters",
        "percent_limit.descr": "<xdoc><p>The closest points, as a percentage of the points of the <span class=\"esri_uicontrol\">Location Points</span> value.</p></xdoc>",
        "percent_limit.title": "Percentage of Locations Limit",
        "report_fields.descr": "The additional fields that will be added to the report.",
        "report_fields.title": "Report Fields",
        "report_folder.descr": "The directory that will contain the output report.",
        "report_folder.title": "Output Report Folder",
        "report_format.descr": "The output report formats. The default value is InfographicHTML. Additional available formats are PDF, XLSX, S.XLSX, HTML, S.XML, ZIP, CVS, PAGX, and InfographicPDF.",
        "report_format.title": "Report Output Formats",
        "report_title.descr": "The title of the output report.",
        "report_title.title": "Report Title",
        "search_tolerance.descr": "The maximum distance that input points can be from the network. Points located beyond the search tolerance will be excluded from processing.",
        "search_tolerance.title": "Search Tolerance",
        "time_of_day.descr": "The time at which travel will begin.",
        "time_of_day.title": "Time of Day",
        "time_zone.descr": "<xdoc><p>Specifies the time zone that will be used for the <span class=\"esri_uicontrol\">Time of Day</span> parameter.</p><ul><li><span title=\"UTC\">UTC</span>—Coordinated universal time (UTC) will be used. Choose this option if you want the best location for a specific time, such as now, but aren&apos;t certain of the time zone in which the <span class=\"esri_uicontrol\">Location Points</span> value will be located.</li><li><span title=\"TIME_ZONE_AT_LOCATION\">Local time at locations</span>—The time zone in which the <span class=\"esri_uicontrol\">Location Points</span> value is located will be used. If the travel direction is input features to location points, this is the time zone of the input features. If the travel direction is location points to input features, this is the time zone of the location points. This is the default.</li></ul></xdoc>",
        "time_zone.domain.TIME_ZONE_AT_LOCATION": "Local time at locations",
        "time_zone.domain.UTC": "UTC",
        "time_zone.title": "Time Zone",
        "title": "Find Nearby Locations",
        "travel_direction.descr": "<xdoc><p>Specifies whether travel times or distances will be measured from location points to input features or from input features to location points.</p><ul><li><span title=\"TOWARD_STORES\">Toward Input Features</span>—The direction of travel will be from location points to input features. This is the default.</li><li><span title=\"AWAY_FROM_STORES\">Away from Input Features</span>—The direction of travel will be from input features to location points.</li></ul></xdoc>",
        "travel_direction.domain.AWAY_FROM_STORES": "Away from Input Features",
        "travel_direction.domain.TOWARD_STORES": "Toward Input Features",
        "travel_direction.title": "Travel Direction",
        "units.descr": "The measurement units, in distance or time, that will be used when calculating nearby locations.",
        "units.title": "Distance Units"
    }
}
