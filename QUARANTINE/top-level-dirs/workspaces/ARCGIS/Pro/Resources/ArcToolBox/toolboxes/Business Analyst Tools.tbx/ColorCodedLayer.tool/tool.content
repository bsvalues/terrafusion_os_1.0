{
    "type": "FunctionTool",
    "guid": "{33724566-2738-4FE2-903A-A8C439127E50}/ColorCodedLayer",
    "displayname": "$rc:title",
    "helpcontent": "62040001",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "33",
        "35"
    ],
    "params": {
        "classification_variable": {
            "control_guid": "{B2149D1C-943E-4613-A1D7-7DEA971DBC7B}",
            "displayname": "$rc:classification_variable.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "depends": [
                "out_layer_name",
                "out_dataset_name"
            ],
            "description": "$rc:classification_variable.descr"
        },
        "out_layer_name": {
            "displayname": "$rc:out_layer_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_layer_name.descr"
        },
        "classification_method": {
            "displayname": "$rc:classification_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NATURAL_BREAKS",
                        "code": "$rc:classification_method.domain.NATURAL_BREAKS"
                    },
                    {
                        "value": "QUANTILE",
                        "code": "$rc:classification_method.domain.QUANTILE"
                    },
                    {
                        "value": "EQUAL_INTERVAL",
                        "code": "$rc:classification_method.domain.EQUAL_INTERVAL"
                    },
                    {
                        "value": "GEOMETRIC_INTERVAL",
                        "code": "$rc:classification_method.domain.GEOMETRIC_INTERVAL"
                    },
                    {
                        "value": "AUTO",
                        "code": "$rc:classification_method.domain.AUTO"
                    }
                ]
            },
            "value": "NATURAL_BREAKS",
            "description": "$rc:classification_method.descr"
        },
        "number_of_classes": {
            "displayname": "$rc:number_of_classes.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "5",
            "description": "$rc:number_of_classes.descr"
        },
        "out_layer": {
            "type": "derived",
            "direction": "out",
            "control_guid": "{DA8EA072-AD53-11D5-A685-0008C711C8C1}",
            "displayname": "$rc:out_layer.title",
            "datatype": {
                "type": "GPGroupLayer"
            }
        },
        "area_of_interest": {
            "type": "optional",
            "displayname": "$rc:area_of_interest.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:area_of_interest.descr"
        },
        "out_dataset_path": {
            "type": "optional",
            "displayname": "$rc:out_dataset_path.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "defaultenvironmentname": "workspace",
            "description": "$rc:out_dataset_path.descr"
        },
        "out_dataset_name": {
            "type": "optional",
            "displayname": "$rc:out_dataset_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_dataset_name.descr"
        },
        "out_dataset ": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_dataset .title",
            "datatype": {
                "type": "DEFeatureDataset"
            }
        },
        "boundary_mode": {
            "type": "optional",
            "display_order": "0",
            "displayname": "$rc:boundary_mode.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "STANDARD_GEOGRAPHIES",
                        "code": "$rc:boundary_mode.domain.STANDARD_GEOGRAPHIES"
                    },
                    {
                        "value": "H3_HEXAGONS",
                        "code": "$rc:boundary_mode.domain.H3_HEXAGONS"
                    }
                ]
            },
            "value": "STANDARD_GEOGRAPHIES",
            "description": "$rc:boundary_mode.descr"
        }
    },
    "environments": [
        "baDataSource",
        "workspace"
    ]
}
