{
    "type": "FunctionTool",
    "guid": "{4b9475fb-859c-40ba-9d9d-39988c0375c8}",
    "displayname": "$rc:title",
    "helpcontent": "1020007",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "params": {
        "target_features": {
            "displayname": "$rc:target_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline",
                    "Point",
                    "Multipoint"
                ]
            },
            "description": "$rc:target_features.descr"
        },
        "join_features": {
            "displayname": "$rc:join_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline",
                    "Point",
                    "Multipoint"
                ]
            },
            "description": "$rc:join_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "join_operation": {
            "type": "optional",
            "displayname": "$rc:join_operation.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "JOIN_ONE_TO_ONE",
                        "code": "$rc:join_operation.domain.JOIN_ONE_TO_ONE"
                    },
                    {
                        "value": "JOIN_ONE_TO_MANY",
                        "code": "$rc:join_operation.domain.JOIN_ONE_TO_MANY"
                    }
                ]
            },
            "value": "JOIN_ONE_TO_ONE",
            "description": "$rc:join_operation.descr"
        },
        "join_type": {
            "type": "optional",
            "displayname": "$rc:join_type.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "KEEP_ALL"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "KEEP_COMMON"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:join_type.descr"
        },
        "field_mapping": {
            "type": "optional",
            "displayname": "$rc:field_mapping.title",
            "datatype": {
                "type": "GPFieldMapping"
            },
            "depends": [
                "target_features",
                "join_features"
            ],
            "category": "$rc:params.category1",
            "description": "$rc:field_mapping.descr"
        },
        "match_option": {
            "type": "optional",
            "displayname": "$rc:match_option.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INTERSECT",
                        "code": "$rc:match_option.domain.INTERSECT"
                    },
                    {
                        "value": "INTERSECT_3D",
                        "code": "$rc:match_option.domain.INTERSECT_3D"
                    },
                    {
                        "value": "LARGEST_OVERLAP",
                        "code": "$rc:match_option.domain.LARGEST_OVERLAP"
                    },
                    {
                        "value": "WITHIN_A_DISTANCE_GEODESIC",
                        "code": "$rc:match_option.domain.WITHIN_A_DISTANCE_GEODESIC"
                    },
                    {
                        "value": "WITHIN_A_DISTANCE",
                        "code": "$rc:match_option.domain.WITHIN_A_DISTANCE"
                    },
                    {
                        "value": "WITHIN_A_DISTANCE_3D",
                        "code": "$rc:match_option.domain.WITHIN_A_DISTANCE_3D"
                    },
                    {
                        "value": "CONTAINS",
                        "code": "$rc:match_option.domain.CONTAINS"
                    },
                    {
                        "value": "COMPLETELY_CONTAINS",
                        "code": "$rc:match_option.domain.COMPLETELY_CONTAINS"
                    },
                    {
                        "value": "CONTAINS_CLEMENTINI",
                        "code": "$rc:match_option.domain.CONTAINS_CLEMENTINI"
                    },
                    {
                        "value": "WITHIN",
                        "code": "$rc:match_option.domain.WITHIN"
                    },
                    {
                        "value": "COMPLETELY_WITHIN",
                        "code": "$rc:match_option.domain.COMPLETELY_WITHIN"
                    },
                    {
                        "value": "WITHIN_CLEMENTINI",
                        "code": "$rc:match_option.domain.WITHIN_CLEMENTINI"
                    },
                    {
                        "value": "ARE_IDENTICAL_TO",
                        "code": "$rc:match_option.domain.ARE_IDENTICAL_TO"
                    },
                    {
                        "value": "BOUNDARY_TOUCHES",
                        "code": "$rc:match_option.domain.BOUNDARY_TOUCHES"
                    },
                    {
                        "value": "SHARE_A_LINE_SEGMENT_WITH",
                        "code": "$rc:match_option.domain.SHARE_A_LINE_SEGMENT_WITH"
                    },
                    {
                        "value": "CROSSED_BY_THE_OUTLINE_OF",
                        "code": "$rc:match_option.domain.CROSSED_BY_THE_OUTLINE_OF"
                    },
                    {
                        "value": "HAVE_THEIR_CENTER_IN",
                        "code": "$rc:match_option.domain.HAVE_THEIR_CENTER_IN"
                    },
                    {
                        "value": "CLOSEST_GEODESIC",
                        "code": "$rc:match_option.domain.CLOSEST_GEODESIC"
                    },
                    {
                        "value": "CLOSEST",
                        "code": "$rc:match_option.domain.CLOSEST"
                    }
                ]
            },
            "value": "INTERSECT",
            "description": "$rc:match_option.descr"
        },
        "search_radius": {
            "type": "optional",
            "displayname": "$rc:search_radius.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "target_features"
            ],
            "description": "$rc:search_radius.descr"
        },
        "distance_field_name": {
            "type": "optional",
            "displayname": "$rc:distance_field_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:distance_field_name.descr"
        },
        "match_fields": {
            "type": "optional",
            "control_guid": "{C99D0042-EF42-4B04-8A0B-1A53F6DB67A6}",
            "displayname": "$rc:match_fields.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPString",
                        "displayname": "$rc:match_fields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:match_fields.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text",
                    "Date",
                    "Blob",
                    "Raster",
                    "XML",
                    "GUID",
                    "GlobalID",
                    "OID"
                ],
                "exclude.field": [
                    "SHAPE_Length",
                    "SHAPE_Area"
                ]
            },
            "depends": [
                "target_features",
                "join_features"
            ],
            "description": "$rc:match_fields.descr"
        }
    },
    "environments": [
        "MDomain",
        "MResolution",
        "MTolerance",
        "XYDomain",
        "XYResolution",
        "XYTolerance",
        "ZDomain",
        "ZResolution",
        "ZTolerance",
        "configKeyword",
        "extent",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue"
    ]
