{
    "map": {
        "description": "Removes preliminary network pathways that are not needed for routing between selected locations on each level, reducing the network dataset size and improving its route-solving performance.",
        "in_level_features.descr": "The input polygon features representing a level or levels in one or more facilities. In the ArcGIS Indoors Information Model, this is the Levels layer. Only the levels represented by these features will be processed.",
        "in_level_features.title": "Input Level Features",
        "in_pathway_features.descr": "The input polyline features representing the preliminary pathways to be thinned. In the Indoors model, this is the PrelimPathways layer.",
        "in_pathway_features.title": "Input Pathway Features",
        "in_transition_features.descr": "The input polyline features representing the preliminary transitions to be thinned. In the Indoors model, this is the PrelimTransitions layer.",
        "in_transition_features.title": "Input Transition Features",
        "neighbor_solve_count.descr": "<xdoc><p>The number of closest neighboring locations that will be solved when calculating routes between a specified location and other routable locations in the facility. The default value is 50.<note type=\"note\"/><p group=\"note\">The value must be 1 or greater.</p></p></xdoc>",
        "neighbor_solve_count.title": "Neighbor Solve Count",
        "routable_locations.descr": "The input point or polygon features representing the locations used to calculate routes. This can be any point or polygon features that conform to the Indoors model or are configured as floor aware.",
        "routable_locations.title": "Routable Locations",
        "search_tolerance.descr": "<xdoc><p>The distance, in meters, the tool will search for <span class=\"esri_uicontrol\">Routable Locations</span> features near the input pathways. The <span class=\"esri_uicontrol\">Routable Locations</span> features that are farther away than this value will not be used for thinning. The default value is 5. <note type=\"note\"/><p group=\"note\">The value must be 0 or greater.</p></p></xdoc>",
        "search_tolerance.title": "Search Tolerance",
        "target_pathways.descr": "The existing feature class or feature layer to which the thinned pathways will be added. In the Indoors model, this is the Pathways layer.",
        "target_pathways.title": "Target Pathways",
        "target_transitions.descr": "The existing feature class or feature to which thinned transitions will be added. In the Indoors model, this is the Transitions layer.",
        "target_transitions.title": "Target Transitions",
        "title": "Thin Indoor Pathways",
        "updated_pathways.title": "Updated Pathways",
        "updated_transitions.title": "Updated Transitions"
    }
