    ],
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "in_las_dataset": {
            "display_order": "0",
            "displayname": "$rc:in_las_dataset.title",
            "datatype": {
                "type": "GPLasDatasetLayer"
            },
            "description": "$rc:in_las_dataset.descr"
        },
        "in_raster": {
            "display_order": "1",
            "displayname": "$rc:in_raster.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "description": "$rc:in_raster.descr"
        },
        "compute_stats": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:compute_stats.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "COMPUTE_STATS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_COMPUTE_STATS"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:compute_stats.descr"
        },
        "extent": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:extent.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPExtent"
            },
            "description": "$rc:extent.descr"
        },
        "boundary": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:boundary.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:boundary.descr"
        },
        "process_entire_files": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:process_entire_files.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "PROCESS_ENTIRE_FILES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "PROCESS_EXTENT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:process_entire_files.descr"
        },
        "derived_las_dataset": {
            "type": "derived",
            "direction": "out",
            "display_order": "7",
            "displayname": "$rc:derived_las_dataset.title",
            "datatype": {
                "type": "GPLasDatasetLayer"
            },
            "depends": [
                "in_las_dataset"
            ]
        },
        "update_pyramid": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:update_pyramid.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "UPDATE_PYRAMID"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_UPDATE_PYRAMID"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:update_pyramid.descr"
        }
    },
    "environments": [
