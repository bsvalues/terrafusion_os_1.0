{
    "map": {
        "data_store.descr": "<xdoc><p>Specifies the ArcGIS Data Store where the output will be stored. All results stored in a spatiotemporal big data store will be stored in WGS84. Results stored in a relational data store will maintain their coordinate system.</p><ul><li><span title=\"SPATIOTEMPORAL_DATA_STORE\">Spatiotemporal big data store</span>—Output will be stored in a spatiotemporal big data store. This is the default.</li><li><span title=\"RELATIONAL_DATA_STORE\">Relational data store</span>—Output will be stored in a relational data store.</li></ul></xdoc>",
        "data_store.domain.RELATIONAL_DATA_STORE": "Relational data store",
        "data_store.domain.SPATIOTEMPORAL_DATA_STORE": "Spatiotemporal big data store",
        "data_store.title": "Data Store",
        "description": "Finds central features and directional distributions and calculates mean and median locations from the input.",
        "ellipse_size.descr": "<xdoc><p>Specifies the size of output ellipses in standard deviations.</p><ul><li><span title=\"1_STANDARD_DEVIATION\">One standard deviation</span>—Output ellipses will cover one standard deviation of the input features. This is the default.</li><li><span title=\"2_STANDARD_DEVIATIONS\">Two standard deviations</span>—Output ellipses will cover two standard deviations of the input features.</li><li><span title=\"3_STANDARD_DEVIATIONS\">Three standard deviations</span>—Output ellipses will cover three standard deviations of the input features.</li></ul></xdoc>",
        "ellipse_size.domain.1_STANDARD_DEVIATION": "One standard deviation",
        "ellipse_size.domain.2_STANDARD_DEVIATIONS": "Two standard deviations",
        "ellipse_size.domain.3_STANDARD_DEVIATIONS": "Three standard deviations",
        "ellipse_size.title": "Ellipse Size",
        "generate_types.descr": "<xdoc><p>Specifies the summary types to be generated. You can use one or more summary types. A unique layer will be created for each summary type selected.</p><ul><li><span title=\"CENTRAL_FEATURE\">Central Feature</span>—A layer will be created that contains a copy of the most central feature from the input layer.</li><li><span title=\"MEAN_CENTER\">Mean Center</span>—A point layer will be created that represents the mean center of the input layer.</li><li><span title=\"MEDIAN_CENTER\">Median Center</span>—A point layer will be created that represents the median center of the input layer.</li><li><span title=\"ELLIPSE\">Ellipse</span>—A polygon layer will be created that represents the directional ellipse of the input layer.</li></ul></xdoc>",
        "generate_types.domain.CENTRAL_FEATURE": "Central Feature",
        "generate_types.domain.ELLIPSE": "Ellipse",
        "generate_types.domain.MEAN_CENTER": "Mean Center",
        "generate_types.domain.MEDIAN_CENTER": "Median Center",
        "generate_types.title": "Generate Types",
        "group_by_field.descr": "<xdoc><p>The field used to group similar features. This applies to all summary types. For example, if you choose a field named <span class=\"esri_fieldname\">PlantType</span> that contains values of tree, bush, and grass, all of the features with the value tree will be analyzed for their own center or dispersion. This example will result in three features, one for each group of tree, bush, and grass.</p></xdoc>",
        "group_by_field.title": "Group By Field",
        "input_layer.descr": "The point, line, or polygon layer to be summarized.",
        "input_layer.title": "Input Layer",
        "out_central_feature_layer.title": "Central Feature Layer",
        "out_ellipse_layer.title": "Ellipse Layer",
        "out_mean_center_layer.title": "Mean Center Layer",
        "out_median_center_layer.title": "Median Center Layer",
        "output_name.descr": "The name of the output feature service.",
        "output_name.title": "Output Name",
        "params.category1": "Data Store",
        "summary": "<xdoc><p>Finds central features and directional distributions and calculates mean and median locations from the input.</p><p><note type=\"legacy\"/><p group=\"note\">The ArcGIS GeoAnalytics Server extension is being deprecated in ArcGIS Enterprise. The final release of GeoAnalytics Server was included with ArcGIS Enterprise 11.3. This geoprocessing tool is available through ArcGIS Enterprise 11.3 and earlier versions.</p></p></xdoc>",
        "title": "Summarize Center And Dispersion",
        "weight_field.descr": "A numeric field used to weight locations according to their relative importance. This applies to all summary types.",
        "weight_field.title": "Weight Field"
    }
}
