                        "code": "$rc:join_attributes.domain.ALL"
                    }
                ]
            },
            "value": "ALL",
            "description": "$rc:join_attributes.descr"
        },
        "cluster_tolerance": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:cluster_tolerance.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:cluster_tolerance.descr"
        },
        "relationship": {
            "type": "optional",
            "displayname": "$rc:relationship.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "KEEP_RELATIONSHIPS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_RELATIONSHIPS"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:relationship.descr"
