        "identity_features": {
            "displayname": "$rc:identity_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Polyline",
                    "Point",
                    "Multipoint"
                ],
                "featuretype": [
                    "Simple",
                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexEdge",
                    "RasterCatalogItem"
                ]
            },
            "description": "$rc:identity_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "join_attributes": {
            "type": "optional",
            "displayname": "$rc:join_attributes.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NO_FID",
                        "code": "$rc:join_attributes.domain.NO_FID"
                    },
                    {
                        "value": "ONLY_FID",
                        "code": "$rc:join_attributes.domain.ONLY_FID"
                    },
                    {
