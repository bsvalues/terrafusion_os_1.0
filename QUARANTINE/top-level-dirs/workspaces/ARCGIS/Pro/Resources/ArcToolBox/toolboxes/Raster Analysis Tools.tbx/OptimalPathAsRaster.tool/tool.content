{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\OptimalPathAsRaster",
    "displayname": "$rc:title",
    "helpcontent": "54050010",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "inputDestinationRasterOrFeatures": {
            "display_order": "0",
            "displayname": "$rc:inputdestinationrasterorfeatures.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEImageServer"
                    },
                    {
                        "type": "GPFeatureLayer"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:inputdestinationrasterorfeatures.descr"
        },
        "inputDistanceAccumulationRaster": {
            "display_order": "2",
            "displayname": "$rc:inputdistanceaccumulationraster.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEImageServer"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:inputdistanceaccumulationraster.descr"
        },
        "inputBackDirectionRaster": {
            "display_order": "3",
            "displayname": "$rc:inputbackdirectionraster.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEImageServer"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:inputbackdirectionraster.descr"
        },
        "outputRasterName": {
            "display_order": "4",
            "displayname": "$rc:outputrastername.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:outputrastername.descr"
        },
        "destinationField": {
            "type": "optional",
            "display_order": "1",
            "displayname": "$rc:destinationfield.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:destinationfield.descr"
        },
        "pathType": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:pathtype.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "BEST_SINGLE",
                        "code": "$rc:pathtype.domain.BEST_SINGLE"
                    },
                    {
                        "value": "EACH_CELL",
                        "code": "$rc:pathtype.domain.EACH_CELL"
                    },
                    {
                        "value": "EACH_ZONE",
                        "code": "$rc:pathtype.domain.EACH_ZONE"
                    }
                ]
            },
            "value": "EACH_ZONE",
            "description": "$rc:pathtype.descr"
        },
        "outputRaster": {
            "type": "derived",
            "direction": "out",
            "display_order": "6",
            "displayname": "$rc:outputraster.title",
            "datatype": {
                "type": "GPRasterLayer"
            }
        }
    },
    "environments": [
        "pyramid"
    ]
}
