{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\LocalBivariateRelationships",
    "displayname": "$rc:title",
    "helpcontent": "9060009",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "dependent_variable": {
            "display_order": "1",
            "displayname": "$rc:dependent_variable.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:dependent_variable.descr"
        },
        "explanatory_variable": {
            "display_order": "2",
            "displayname": "$rc:explanatory_variable.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "BigInteger"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:explanatory_variable.descr"
        },
        "output_features": {
            "direction": "out",
            "display_order": "5",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "number_of_neighbors": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:number_of_neighbors.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "30",
                "max": "1000"
            },
            "value": "30",
            "description": "$rc:number_of_neighbors.descr"
        },
        "number_of_permutations": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:number_of_permutations.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLong",
                        "value": "99",
                        "code": "99"
                    },
                    {
                        "type": "GPLong",
                        "value": "199",
                        "code": "199"
                    },
                    {
                        "type": "GPLong",
                        "value": "499",
                        "code": "499"
                    },
                    {
                        "type": "GPLong",
                        "value": "999",
                        "code": "999"
                    }
                ]
            },
            "value": "199",
            "description": "$rc:number_of_permutations.descr"
        },
        "enable_local_scatterplot_popups": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:enable_local_scatterplot_popups.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE_POPUP"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_POPUP"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:enable_local_scatterplot_popups.descr"
        },
        "level_of_confidence": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:level_of_confidence.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "90%",
                        "code": "$rc:level_of_confidence.domain.90%"
                    },
                    {
                        "value": "95%",
                        "code": "$rc:level_of_confidence.domain.95%"
                    },
                    {
                        "value": "99%",
                        "code": "$rc:level_of_confidence.domain.99%"
                    }
                ]
            },
            "value": "90%",
            "description": "$rc:level_of_confidence.descr"
        },
        "apply_false_discovery_rate_fdr_correction": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:apply_false_discovery_rate_fdr_correction.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "APPLY_FDR"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_FDR"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:apply_false_discovery_rate_fdr_correction.descr"
        },
        "scaling_factor": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:scaling_factor.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0.01",
                "max": "1"
            },
            "value": "0.5",
            "description": "$rc:scaling_factor.descr"
        }
    },
    "environments": [
        "outputCoordinateSystem",
        "parallelProcessingFactor",
        "randomGenerator"
    ]
}
