{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "69000003",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "spark"
    ],
    "params": {
        "input_layer": {
            "displayname": "$rc:input_layer.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_layer.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "bin_type": {
            "displayname": "$rc:bin_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SQUARE",
                        "code": "$rc:bin_type.domain.SQUARE"
                    },
                    {
                        "value": "HEXAGON",
                        "code": "$rc:bin_type.domain.HEXAGON"
                    }
                ]
            },
            "value": "SQUARE",
            "description": "$rc:bin_type.descr"
        },
        "bin_size": {
            "displayname": "$rc:bin_size.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:bin_size.descr"
        },
        "weight": {
            "displayname": "$rc:weight.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "KERNEL",
                        "code": "$rc:weight.domain.KERNEL"
                    },
                    {
                        "value": "UNIFORM",
                        "code": "$rc:weight.domain.UNIFORM"
                    }
                ]
            },
            "value": "UNIFORM",
            "description": "$rc:weight.descr"
        },
        "neighborhood_size": {
            "displayname": "$rc:neighborhood_size.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:neighborhood_size.descr"
        },
        "fields": {
            "type": "optional",
            "displayname": "$rc:fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:fields.descr"
        },
        "area_unit_scale_factor": {
            "type": "optional",
            "displayname": "$rc:area_unit_scale_factor.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SQUARE_KILOMETERS",
                        "code": "$rc:area_unit_scale_factor.domain.SQUARE_KILOMETERS"
                    },
                    {
                        "value": "SQUARE_METERS",
                        "code": "$rc:area_unit_scale_factor.domain.SQUARE_METERS"
                    },
                    {
                        "value": "HECTARES",
                        "code": "$rc:area_unit_scale_factor.domain.HECTARES"
                    },
                    {
                        "value": "ACRES",
                        "code": "$rc:area_unit_scale_factor.domain.ACRES"
                    },
                    {
                        "value": "SQUARE_MILES",
                        "code": "$rc:area_unit_scale_factor.domain.SQUARE_MILES"
                    },
                    {
                        "value": "SQUARE_YARDS",
                        "code": "$rc:area_unit_scale_factor.domain.SQUARE_YARDS"
                    },
                    {
                        "value": "SQUARE_FEET",
                        "code": "$rc:area_unit_scale_factor.domain.SQUARE_FEET"
                    },
                    {
                        "value": "ACRES_US",
                        "code": "$rc:area_unit_scale_factor.domain.ACRES_US"
                    },
                    {
                        "value": "SQUARE_MILES_US",
                        "code": "$rc:area_unit_scale_factor.domain.SQUARE_MILES_US"
                    },
                    {
                        "value": "SQUARE_YARDS_US",
                        "code": "$rc:area_unit_scale_factor.domain.SQUARE_YARDS_US"
                    },
                    {
                        "value": "SQUARE_FEET_US",
                        "code": "$rc:area_unit_scale_factor.domain.SQUARE_FEET_US"
                    }
                ]
            },
            "value": "SQUARE_KILOMETERS",
            "description": "$rc:area_unit_scale_factor.descr"
        },
        "time_step_interval": {
            "type": "optional",
            "displayname": "$rc:time_step_interval.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_step_interval.descr"
        },
        "time_step_repeat": {
            "type": "optional",
            "displayname": "$rc:time_step_repeat.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_step_repeat.descr"
        },
        "time_step_reference": {
            "type": "optional",
            "displayname": "$rc:time_step_reference.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_step_reference.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
