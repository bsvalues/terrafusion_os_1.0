{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "66120005",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "58",
        "86"
    ],
    "attributes": [
        "GPU",
        "mCPU"
    ],
    "params": {
        "in_folder": {
            "display_order": "0",
