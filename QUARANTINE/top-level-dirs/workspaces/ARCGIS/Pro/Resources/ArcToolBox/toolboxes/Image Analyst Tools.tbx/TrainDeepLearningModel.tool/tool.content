                    "type": "DEFolder"
                }
            },
            "description": "$rc:in_folder.descr"
        },
        "out_folder": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:out_folder.title",
            "datatype": {
                "type": "DEFolder"
