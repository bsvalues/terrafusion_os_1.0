{
    "map": {
        "bdc_dataset.descr": "The MFC dataset that will be updated. The options for editing will differ depending on the source data (shapefile, delimited file, ORC, or parquet file).",
        "bdc_dataset.title": "Multifile Feature Connection Dataset",
        "description": "Updates the properties of a multifile feature connection (MFC) dataset. This tool modifies field, geometry, time, and file settings for a specified MFC dataset.",
        "encoding.descr": "The type of encoding used by the source dataset. UTF-8 is used by default.",
        "encoding.title": "Encoding",
        "end_time_format.descr": "The fields used to define the end time and the time formatting.",
        "end_time_format.domain.item1.BigInteger": "Big Integer",
        "end_time_format.domain.item1.Date": "Date",
        "end_time_format.domain.item1.Double": "Double",
        "end_time_format.domain.item1.Float": "Float",
        "end_time_format.domain.item1.Long": "Long",
        "end_time_format.domain.item1.Short": "Short",
        "end_time_format.domain.item1.Text": "Text",
        "end_time_format.dt.title1": "Name",
        "end_time_format.dt.title2": "Format",
        "end_time_format.title": "End Time",
        "expression.descr": "An expression used to limit the features that will be used in the analysis.",
        "expression.title": "Expression",
        "field_delimiter.descr": "The field delimiter used in the source dataset.",
        "field_delimiter.title": "Field Delimiter",
        "field_properties.descr": "<xdoc><p>Specifies the field names and properties that will be modified.</p><ul><li><span title=\"SHORT\">Short</span>—The field will be type short.</li><li><span title=\"LONG\">Long</span>—The field will be type long</li><li><span title=\"DOUBLE\">Double</span>—The field will be type double.</li><li><span title=\"FLOAT\">Float</span>—The field will be type float.</li><li><span title=\"STRING\">String</span>—The field will be type string.</li><li><span title=\"DATE\">Date</span>—The field will be type date.</li><li><span title=\"BLOB\">BLOB</span>—The field will be type BLOB.</li><li><span title=\"BIG_INTEGER\">Big Integer</span>—The field will be type big integer.</li></ul><p>Specifies whether fields will be visible or hidden.<ul><li>Checked—The fields will be visible and available for use in geoprocessing tools. This is the default.</li><li>Unchecked—The fields will be hidden and cannot be used as input to geoprocessing tools.</li></ul></p></xdoc>",
        "field_properties.domain.item2.BIG_INTEGER": "Big Integer",
        "field_properties.domain.item2.DATE": "Date",
        "field_properties.domain.item2.DOUBLE": "Double",
        "field_properties.domain.item2.FLOAT": "Float",
        "field_properties.domain.item2.LONG": "Long",
        "field_properties.domain.item2.SHORT": "Short",
        "field_properties.domain.item2.STRING": "String",
        "field_properties.dt.title1": "Name",
        "field_properties.dt.title2": "Type",
        "field_properties.dt.title3": "Show",
        "field_properties.title": "Field Properties",
        "file_extension.descr": "The file extension of the source dataset. The parameter value cannot be modified.",
        "file_extension.title": "File Extension",
        "geometry_field.descr": "A single field used to represent the geometry. This field is used when the geometry format is WKT, WKB, GeoJSON, EsriJSON, or EsriShape.",
        "geometry_field.title": "Geometry Field",
        "geometry_format_type.descr": "<xdoc><p>Specifies how the geometry will be formatted. The geometry cannot be modified for shapefile-sourced data.</p><ul><li><span title=\"XYZ\">XYZ</span>—Two or more fields will represent x, y, and optionally z.</li><li><span title=\"WKT\">WKT</span>—The geometry will be represented by a single field in a well-known text field.</li><li><span title=\"WKB\">WKB</span>—The geometry will be represented by a single field in a well-known binary field.</li><li><span title=\"GEOJSON\">GeoJSON</span>—The geometry will be represented by a single field in GeoJSON format.</li><li><span title=\"ESRIJSON\">EsriJSON</span>—The geometry will be represented by a single field in EsriJSON format.</li><li><span title=\"ESRISHAPE\">EsriShape</span>—The geometry will be represented by a single field in EsriShape format.</li></ul></xdoc>",
        "geometry_format_type.domain.ESRIJSON": "EsriJSON",
        "geometry_format_type.domain.ESRISHAPE": "EsriShape",
        "geometry_format_type.domain.GEOJSON": "GeoJSON",
        "geometry_format_type.domain.WKB": "WKB",
        "geometry_format_type.domain.WKT": "WKT",
        "geometry_format_type.domain.XYZ": "XYZ",
        "geometry_format_type.title": "Geometry Format Type",
        "geometry_type.descr": "<xdoc><p>Specifies the type of geometry that will be used to spatially represent the dataset. The geometry cannot be modified for shapefile-sourced datasets.</p><ul><li><span title=\"POINT\">Point</span>—The geometry type will be point.</li><li><span title=\"LINE\">Polyline</span>—The geometry type will be polyline.</li><li><span title=\"POLYGON\">Polygon</span>—The geometry type will be polygon.</li><li><span title=\"NONE\">None</span>—No geometry type is specified.</li></ul></xdoc>",
        "geometry_type.domain.LINE": "Polyline",
        "geometry_type.domain.NONE": "None",
        "geometry_type.domain.POINT": "Point",
        "geometry_type.domain.POLYGON": "Polygon",
        "geometry_type.title": "Geometry Type",
        "has_header_row.descr": "<xdoc><p>Specifies whether the source dataset includes a header row.<ul><li>Checked—The source dataset includes a header row.</li><li>Unchecked—The source dataset does not include a header row.</li></ul></p></xdoc>",
        "has_header_row.title": "Has Header Row",
        "params.category1": "Definition Query",
        "params.category2": "Fields",
        "params.category3": "Geometry",
        "params.category4": "Time",
        "params.category5": "File",
        "quote_character.descr": "The quote character used in the source dataset.",
        "quote_character.title": "Quote Character",
        "record_terminator.descr": "The record terminator used in the source dataset.",
        "record_terminator.title": "Record Terminator",
        "spatial_reference.descr": "The WKID value or WKT string that will be used for the spatial reference of the dataset. The default is WKID 4326 (WGS84). The spatial reference cannot be modified for shapefile-sourced data.",
        "spatial_reference.title": "Spatial Reference",
