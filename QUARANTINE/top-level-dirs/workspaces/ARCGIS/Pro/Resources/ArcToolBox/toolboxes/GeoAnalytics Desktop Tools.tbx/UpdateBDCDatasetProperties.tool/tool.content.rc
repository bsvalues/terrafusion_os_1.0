        "start_time_format.domain.item1.BigInteger": "Big Integer",
        "start_time_format.domain.item1.Date": "Date",
        "start_time_format.domain.item1.Double": "Double",
        "start_time_format.domain.item1.Float": "Float",
        "start_time_format.domain.item1.Long": "Long",
        "start_time_format.domain.item1.Short": "Short",
        "start_time_format.domain.item1.Text": "Text",
        "start_time_format.dt.title1": "Name",
        "start_time_format.dt.title2": "Format",
        "start_time_format.title": "Start Time",
        "time_type.descr": "<xdoc><p>Specifies the time type that will be used to temporally represent the dataset.</p><ul><li><span title=\"INTERVAL\">Interval</span>—The time type will represent a duration of time with a start and end time.</li><li><span title=\"INSTANT\">Instant</span>—The time type will represent an instant in time.</li><li><span title=\"NONE\">None</span>—Time is not enabled.</li></ul></xdoc>",
        "time_type.domain.INSTANT": "Instant",
        "time_type.domain.INTERVAL": "Interval",
        "time_type.domain.NONE": "None",
        "time_type.title": "Time Type",
        "time_zone.descr": "The time zone of the dataset.",
        "time_zone.title": "Time Zone",
        "title": "Update Multifile Feature Connection Dataset Properties",
        "updated_bdc.title": "Updated MFC",
        "x_field.descr": "The field used to represent the x-location. If more than one field represents the x-location, modify the .mfc file manually.",
        "x_field.title": "X Field",
        "y_field.descr": "The field used to represent the y-location. If more than one field represents the y-location, modify the .mfc file manually.",
        "y_field.title": "Y Field",
        "z_field.descr": "The field used to represent the z-location. If more than one field represents the z-location, modify the .mfc file manually.",
