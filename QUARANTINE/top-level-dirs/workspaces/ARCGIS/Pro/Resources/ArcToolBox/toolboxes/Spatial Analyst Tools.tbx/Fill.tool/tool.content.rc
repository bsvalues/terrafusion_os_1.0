{
    "map": {
        "description": "Fills sinks in a surface raster to remove small imperfections in the data.",
        "in_surface_raster.descr": "The input raster representing a continuous surface.",
        "in_surface_raster.title": "Input surface raster",
        "out_surface_raster.descr": "<xdoc><p>The output surface raster after the sinks have been filled.</p><p>If the surface raster is integer, the output filled raster will be integer type. If the input is floating point, the output raster will be floating point.</p></xdoc>",
        "out_surface_raster.title": "Output surface raster",
        "title": "Fill",
        "z_limit.descr": "<xdoc><p>Maximum elevation difference between a sink and its pour point to be filled.</p><p>If the difference in z-values between a sink and its pour point is greater than the z_limit, that sink will not be filled.</p><p>The value for z-limit must be greater than zero.</p><p>Unless a value is specified for this parameter, all sinks will be filled, regardless of depth.</p></xdoc>",
        "z_limit.title": "Z limit"
    }
}
