{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "51020003",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "spark"
    ],
    "params": {
        "input_layer": {
            "displayname": "$rc:input_layer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "featuretype": [
                    "Simple"
                ],
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:input_layer.descr"
        },
        "overlay_layer": {
            "displayname": "$rc:overlay_layer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "featuretype": [
                    "Simple"
                ],
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:overlay_layer.descr"
        },
        "output_name": {
            "displayname": "$rc:output_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:output_name.descr"
        },
        "overlay_type": {
            "displayname": "$rc:overlay_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INTERSECT",
                        "code": "$rc:overlay_type.domain.INTERSECT"
                    },
                    {
                        "value": "ERASE",
                        "code": "$rc:overlay_type.domain.ERASE"
                    },
                    {
                        "value": "IDENTITY",
                        "code": "$rc:overlay_type.domain.IDENTITY"
                    },
                    {
                        "value": "UNION",
                        "code": "$rc:overlay_type.domain.UNION"
                    },
                    {
                        "value": "SYMMETRICAL_DIFFERENCE",
                        "code": "$rc:overlay_type.domain.SYMMETRICAL_DIFFERENCE"
                    }
                ]
            },
            "value": "INTERSECT",
            "description": "$rc:overlay_type.descr"
        },
        "include_overlaps": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:include_overlaps.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "OVERLAPPING"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NOT_OVERLAPPING"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:include_overlaps.descr"
        },
        "data_store": {
            "type": "optional",
            "displayname": "$rc:data_store.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SPATIOTEMPORAL_DATA_STORE",
                        "code": "$rc:data_store.domain.SPATIOTEMPORAL_DATA_STORE"
                    },
                    {
                        "value": "RELATIONAL_DATA_STORE",
                        "code": "$rc:data_store.domain.RELATIONAL_DATA_STORE"
                    }
                ]
            },
            "value": "SPATIOTEMPORAL_DATA_STORE",
            "description": "$rc:data_store.descr"
        },
        "output": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
