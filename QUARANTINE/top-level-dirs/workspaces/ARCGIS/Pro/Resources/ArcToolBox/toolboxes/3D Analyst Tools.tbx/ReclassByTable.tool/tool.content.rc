{
    "map": {
        "description": "Reclassifies (or changes) the values of the input cells of a raster using a remap table.",
        "from_value_field.descr": "<xdoc><p>Field holding the beginning value for each value range to be reclassified.</p><p>This is a numeric field of the input remap table.</p></xdoc>",
        "from_value_field.title": "From value field",
        "in_raster.descr": "The input raster to be reclassified.",
        "in_raster.title": "Input raster",
        "in_remap_table.descr": "Table holding fields defining value ranges to be reclassified and the values they will become.",
        "in_remap_table.title": "Input remap table",
        "missing_values.descr": "<xdoc><p>Denotes whether missing values in the reclass table retain their value or get mapped to NoData.</p><ul><li>Unchecked—Signifies that if any cell location on the input raster contains a value not present or reclassed in a remap table, the value should remain intact and be written for that location to the output raster. This is the default.</li><li>Checked—Signifies that if any cell location on the input raster contains a value not present or reclassed in a remap table, the value will be reclassed to NoData for that location on the output raster.</li></ul></xdoc>",
        "missing_values.title": "Change missing values to NoData",
        "out_raster.descr": "<xdoc><p>The output reclassified raster.</p><p>The output will always be of integer type.</p></xdoc>",
        "out_raster.title": "Output raster",
        "output_value_field.descr": "<xdoc><p>Field holding the integer values to which each range should be changed.</p><p>This is an integer field of the input remap table.</p></xdoc>",
        "output_value_field.title": "Output value field",
        "title": "Reclass by Table",
        "to_value_field.descr": "<xdoc><p>Field holding the ending value for each value range to be reclassified.</p><p>This is a numeric field of the input remap table.</p></xdoc>",
        "to_value_field.title": "To value field"
    }
}
