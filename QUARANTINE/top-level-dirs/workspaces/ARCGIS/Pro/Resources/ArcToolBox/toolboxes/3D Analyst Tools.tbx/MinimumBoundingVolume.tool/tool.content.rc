{
    "map": {
        "description": "Creates multipatch features that represent the volume of space occupied by a set of 3D features.",
        "geometry_type.descr": "<xdoc><p>Specifies the method that will be used to determine the geometry of the minimum bounding volume.</p><ul><li><span title=\"CONVEX_HULL\">Convex hull</span>—The smallest convex region surrounding the input data.</li><li><span title=\"SPHERE\">Sphere</span>—The smallest sphere enclosing the input data.</li><li><span title=\"ENVELOPE\">Envelope</span>—The XYZ extent of the input data.</li><li><span title=\"CONCAVE_HULL\">Concave hull</span>—The concave hull that encloses the input data.</li></ul></xdoc>",
        "geometry_type.domain.CONCAVE_HULL": "Concave hull",
        "geometry_type.domain.CONVEX_HULL": "Convex hull",
        "geometry_type.domain.ENVELOPE": "Envelope",
        "geometry_type.domain.SPHERE": "Sphere",
        "geometry_type.title": "Output Feature Class Type",
        "group.descr": "<xdoc><p>Specifies how the input features will be grouped; each group will be enclosed with one output multipatch.</p><ul><li><span title=\"NONE\">None</span>—Input features will not be grouped. This is the default. This option is not available for point input.</li><li><span title=\"ALL\">All</span>—All input features will be treated as one group.</li><li><span title=\"LIST\">List</span>—Input features will be grouped based on their common values in the specified field or fields in the group field parameter.</li></ul></xdoc>",
        "group.domain.ALL": "All",
        "group.domain.LIST": "List",
        "group.domain.NONE": "None",
        "group.title": "Group Options",
        "group_field.descr": "<xdoc><p>The field or fields in the input features that will be used to group features when <span class=\"esri_uicontrol\">List</span> is specified as <span class=\"esri_uicontrol\">Group Option</span>. At least one group field is required for the <span class=\"esri_uicontrol\">List</span> option. All features that have the same value in the specified field or fields will be treated as a group.</p></xdoc>",
        "group_field.title": "Group Field(s)",
        "in_features.descr": "The LAS dataset or 3D features whose minimum bounding volume will be evaluated.",
        "in_features.title": "Input Features",
        "mbv_fields.descr": "<xdoc><p>Specifies whether each feature will be attributed with the volume and surface area of the minimum bounding volume.</p><ul><li>Unchecked—No geometric attributes will be added to the output feature. This is the default.</li><li>Checked—Geometric attributes will be added to the output feature.</li></ul></xdoc>",
        "mbv_fields.title": "Add geometry characteristics as attributes to output",
        "out_feature_class.descr": "The feature class that will be produced.",
        "out_feature_class.title": "Output Feature Class",
        "title": "Minimum Bounding Volume",
        "z_value.descr": "The source of z-values for the input data.",
        "z_value.title": "Z Value"
    }
}
