{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "51010007",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "spark"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "featuretype": [
                    "Simple"
                ],
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "dependent_variable": {
            "displayname": "$rc:dependent_variable.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:dependent_variable.descr"
        },
        "model_type": {
            "enabled": "false",
            "displayname": "$rc:model_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "CONTINUOUS",
                        "code": "$rc:model_type.domain.CONTINUOUS"
                    }
                ]
            },
            "value": "CONTINUOUS",
            "description": "$rc:model_type.descr"
        },
        "explanatory_variables": {
            "displayname": "$rc:explanatory_variables.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:explanatory_variables.descr"
        },
        "output_features": {
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:output_features.descr"
        },
        "neighborhood_type": {
            "displayname": "$rc:neighborhood_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NUMBER_OF_NEIGHBORS",
                        "code": "$rc:neighborhood_type.domain.NUMBER_OF_NEIGHBORS"
                    },
                    {
                        "value": "DISTANCE_BAND",
                        "code": "$rc:neighborhood_type.domain.DISTANCE_BAND"
                    }
                ]
            },
            "description": "$rc:neighborhood_type.descr"
        },
        "neighborhood_selection_method": {
            "enabled": "false",
            "displayname": "$rc:neighborhood_selection_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "USER_DEFINED",
                        "code": "$rc:neighborhood_selection_method.domain.USER_DEFINED"
                    }
                ]
            },
            "value": "USER_DEFINED",
            "description": "$rc:neighborhood_selection_method.descr"
        },
        "number_of_neighbors": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:number_of_neighbors.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1",
                "max": "5000"
            },
            "description": "$rc:number_of_neighbors.descr"
        },
        "distance_band": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:distance_band.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:distance_band.descr"
        },
        "local_weighting_scheme": {
            "type": "optional",
            "displayname": "$rc:local_weighting_scheme.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "BISQUARE",
                        "code": "$rc:local_weighting_scheme.domain.BISQUARE"
                    },
                    {
                        "value": "GAUSSIAN",
                        "code": "$rc:local_weighting_scheme.domain.GAUSSIAN"
                    }
                ]
            },
            "value": "BISQUARE",
            "description": "$rc:local_weighting_scheme.descr"
        },
        "data_store": {
            "type": "optional",
            "displayname": "$rc:data_store.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "RELATIONAL_DATA_STORE",
                        "code": "$rc:data_store.domain.RELATIONAL_DATA_STORE"
                    },
                    {
                        "value": "SPATIOTEMPORAL_DATA_STORE",
                        "code": "$rc:data_store.domain.SPATIOTEMPORAL_DATA_STORE"
                    }
                ]
            },
            "value": "SPATIOTEMPORAL_DATA_STORE",
            "description": "$rc:data_store.descr"
        },
        "output": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "GPRecordSet"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
