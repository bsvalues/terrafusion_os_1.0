    "product": "100",
    "params": {
        "target_gdb": {
            "displayname": "$rc:target_gdb.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
