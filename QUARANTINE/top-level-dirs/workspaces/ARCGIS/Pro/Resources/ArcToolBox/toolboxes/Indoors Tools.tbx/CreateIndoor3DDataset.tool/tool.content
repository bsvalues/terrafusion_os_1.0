                    "Remote Database"
                ]
            },
            "defaultenvironmentname": "workspace",
            "description": "$rc:target_gdb.descr"
        },
        "indoor_dataset_name": {
            "displayname": "$rc:indoor_dataset_name.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "Indoor3D",
            "description": "$rc:indoor_dataset_name.descr"
        },
        "spatial_reference": {
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "depends": [
                "indoor_dataset_name"
            ],
            "description": "$rc:spatial_reference.descr"
        },
        "output_dataset": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_dataset.title",
            "datatype": {
                "type": "DEFeatureDataset"
            }
        }
    },
    "environments": [
