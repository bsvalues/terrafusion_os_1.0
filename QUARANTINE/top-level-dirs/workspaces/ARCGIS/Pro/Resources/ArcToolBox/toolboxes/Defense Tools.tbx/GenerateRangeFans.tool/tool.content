{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\GenerateRangeFans",
    "displayname": "$rc:title",
    "helpcontent": "74010003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_range_fan_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_range_fan_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "symbologylayer": "MT_RangeFanOutput.lyrx",
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_range_fan_feature_class.descr"
        },
        "inner_radius": {
            "displayname": "$rc:inner_radius.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:inner_radius.descr"
        },
        "outer_radius": {
            "displayname": "$rc:outer_radius.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:outer_radius.descr"
        },
        "horizontal_start_angle": {
            "displayname": "$rc:horizontal_start_angle.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:horizontal_start_angle.descr"
        },
        "horizontal_end_angle": {
            "displayname": "$rc:horizontal_end_angle.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:horizontal_end_angle.descr"
        },
        "distance_units": {
            "type": "optional",
            "displayname": "$rc:distance_units.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "METERS",
                        "code": "$rc:distance_units.domain.METERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:distance_units.domain.KILOMETERS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:distance_units.domain.MILES"
                    },
                    {
                        "value": "NAUTICAL_MILES",
                        "code": "$rc:distance_units.domain.NAUTICAL_MILES"
                    },
                    {
                        "value": "FEET",
                        "code": "$rc:distance_units.domain.FEET"
                    },
                    {
                        "value": "US_SURVEY_FEET",
                        "code": "$rc:distance_units.domain.US_SURVEY_FEET"
                    }
                ]
            },
            "value": "METERS",
            "description": "$rc:distance_units.descr"
        },
        "angle_units": {
            "type": "optional",
            "displayname": "$rc:angle_units.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DEGREES",
                        "code": "$rc:angle_units.domain.DEGREES"
                    },
                    {
                        "value": "MILS",
                        "code": "$rc:angle_units.domain.MILS"
                    },
                    {
                        "value": "RADS",
                        "code": "$rc:angle_units.domain.RADS"
                    },
                    {
                        "value": "GRADS",
                        "code": "$rc:angle_units.domain.GRADS"
                    }
                ]
            },
            "value": "DEGREES",
            "description": "$rc:angle_units.descr"
        }
    },
    "environments": [
        "outputCoordinateSystem",
        "scratchWorkspace",
        "workspace"
    ]
}
