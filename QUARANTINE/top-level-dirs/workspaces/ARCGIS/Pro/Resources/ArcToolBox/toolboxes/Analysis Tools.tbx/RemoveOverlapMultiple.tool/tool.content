{
    "type": "FunctionTool",
    "guid": "{3D5470FD-33A4-4D44-ADA2-ABB2224DA89E}/RemoveOverlapMultiple",
    "displayname": "$rc:title",
    "helpcontent": "1020009",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPFeatureLayer",
                        "displayname": "$rc:in_features.dt.title1"
                    }
                ]
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "out_feature_class": {
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "in_features"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "featuretype.rule": "AsSpecified",
                "featuretype": "Simple",
                "geometrytype.rule": "AsSpecified",
                "geometrytype": "Polygon",
                "extenttype.rule": "Union",
                "fields.rule": "None",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class.descr"
        },
        "method": {
            "type": "optional",
            "displayname": "$rc:method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "CENTER_LINE",
                        "code": "$rc:method.domain.CENTER_LINE"
                    },
                    {
                        "value": "THIESSEN",
                        "code": "$rc:method.domain.THIESSEN"
                    },
                    {
                        "value": "GRID",
                        "code": "$rc:method.domain.GRID"
                    }
                ]
            },
            "value": "CENTER_LINE",
            "description": "$rc:method.descr"
        },
        "join_attributes": {
            "type": "optional",
            "displayname": "$rc:join_attributes.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ALL",
                        "code": "$rc:join_attributes.domain.ALL"
                    },
                    {
                        "value": "NO_FID",
                        "code": "$rc:join_attributes.domain.NO_FID"
                    },
                    {
                        "value": "ONLY_FID",
                        "code": "$rc:join_attributes.domain.ONLY_FID"
                    }
                ]
            },
            "value": "ALL",
            "description": "$rc:join_attributes.descr"
        }
    },
    "environments": [
        "workspace"
    ]
