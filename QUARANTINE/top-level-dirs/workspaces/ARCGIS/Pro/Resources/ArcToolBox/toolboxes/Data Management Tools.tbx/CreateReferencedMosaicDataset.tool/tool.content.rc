{
    "map": {
        "build_boundary.descr": "<xdoc><p>Rebuild the boundary. If the selection covers a smaller area than the source mosaic dataset, this is recommended.</p><p>This is only available if the mosaic dataset is created in a geodatabase.</p><ul><li>Checked—Generate the boundary. This is the default.</li><li>Unchecked—Do not generate the boundary.</li></ul></xdoc>",
        "build_boundary.title": "Build Boundary",
        "coordinate_system.descr": "The projection for the output mosaic dataset.",
        "coordinate_system.title": "Coordinate System",
        "description": "Creates a separate mosaic dataset from items in an existing mosaic dataset.",
        "extent.descr": "<xdoc><p>The minimum and maximum coordinates for the extent. If a dataset is selected in <span class=\"esri_uicontrol\">Extent from Dataset</span>, those coordinates will automatically appear here.</p></xdoc>",
        "extent.title": "Extent",
        "in_dataset.descr": "The mosaic dataset from which items will be selected.",
        "in_dataset.title": "Mosaic Dataset",
        "in_template_dataset.descr": "<xdoc><p>Select raster datasets based on the extent of another image or feature class. Raster datasets that lay along the defined extent will be included in the mosaic dataset. To manually input the minimum and maximum coordinates for the extent, use the <span class=\"esri_uicontrol\">Extent</span> parameter.</p></xdoc>",
        "in_template_dataset.title": "Extent from Dataset",
        "lod_field.descr": "<xdoc><note type=\"legacy\"/><p group=\"note\">This parameter has been deprecated and is ignored in tool execution. It remains for backward compatibility reasons.</p></xdoc>",
        "lod_field.title": "Scale Field",
        "maxps_field.descr": "Specify a field from the footprint attribute table that defines the maximum cell size for displaying the mosaic dataset; otherwise, only a footprint will be displayed.",
        "maxps_field.title": "Maximum Cell Size Field",
        "minps_field.descr": "Specify a field from the footprint attribute table that defines the minimum cell size for displaying the mosaic dataset; otherwise, only a footprint will be displayed.",
        "minps_field.title": "Minimum Cell Size Field",
        "number_of_bands.descr": "The number of bands that the referenced mosaic dataset will have.",
        "number_of_bands.title": "Number of Bands",
        "out_mosaic_dataset.descr": "The referenced mosaic dataset to be created.",
        "out_mosaic_dataset.title": "Output Mosaic Dataset",
        "params.category1": "Pixel Properties",
        "params.category2": "Selection",
        "params.category3": "Visibility",
        "pixel_type.descr": "<xdoc><p>The bit depth, or radiometric resolution, of the mosaic dataset. If this is not defined, it will be taken from the first raster dataset.</p><ul><li><span title=\"1_BIT\">1-bit</span>—The pixel type will be a 1-bit unsigned integer. The values can be 0 or 1.</li><li><span title=\"2_BIT\">2-bit</span>—The pixel type will be a 2-bit unsigned integer. The values supported can range from 0 to 3.</li><li><span title=\"4_BIT\">4-bit</span>—The pixel type will be a 4-bit unsigned integer. The values supported can range from 0 to 15.</li><li><span title=\"8_BIT_UNSIGNED\">8-bit unsigned</span>—The pixel type will be an unsigned 8-bit data type. The values supported can range from 0 to 255.</li><li><span title=\"8_BIT_SIGNED\">8-bit signed</span>—The pixel type will be a signed 8-bit data type. The values supported can range from -128 to 127.</li><li><span title=\"16_BIT_UNSIGNED\">16-bit unsigned</span>—The pixel type will be a 16-bit unsigned data type. The values can range from 0 to 65,535.</li><li><span title=\"16_BIT_SIGNED\">16-bit signed</span>—The pixel type will be a 16-bit signed data type. The values can range from -32,768 to 32,767.</li><li><span title=\"32_BIT_UNSIGNED\">32-bit unsigned</span>—The pixel type will be a 32-bit unsigned data type. The values can range from 0 to 4,294,967,295.</li><li><span title=\"32_BIT_SIGNED\">32-bit signed</span>—The pixel type will be a 32-bit signed data type. The values can range from -2,147,483,648 to 2,147,483,647.</li><li><span title=\"32_BIT_FLOAT\">32-bit floating point</span>—The pixel type will be a 32-bit data type supporting decimals.</li><li><span title=\"64_BIT\">64-bit</span>—The pixel type will be a 64-bit data type supporting decimals.</li></ul></xdoc>",
        "pixel_type.domain.16_BIT_SIGNED": "16-bit signed",
        "pixel_type.domain.16_BIT_UNSIGNED": "16-bit unsigned",
        "pixel_type.domain.1_BIT": "1-bit",
        "pixel_type.domain.2_BIT": "2-bit",
        "pixel_type.domain.32_BIT_FLOAT": "32-bit floating point",
        "pixel_type.domain.32_BIT_SIGNED": "32-bit signed",
        "pixel_type.domain.32_BIT_UNSIGNED": "32-bit unsigned",
        "pixel_type.domain.4_BIT": "4-bit",
        "pixel_type.domain.64_BIT": "64-bit",
        "pixel_type.domain.8_BIT_SIGNED": "8-bit signed",
        "pixel_type.domain.8_BIT_UNSIGNED": "8-bit unsigned",
        "pixel_type.title": "Pixel Type",
        "pixelsize.descr": "Set a maximum cell size to display the mosaic instead of specifying a field. If you zoom out beyond this cell size, only the footprint will be displayed.",
        "pixelsize.title": "Maximum Visible Cell Size",
        "select_using_features.descr": "<xdoc><p>Limit the extent to the shape or envelope when a feature class is selected in the <span class=\"esri_uicontrol\">Extent from Dataset</span> parameter.</p><ul><li>Checked—Select based on the shape of the feature. This is the default.</li><li>Unchecked—Select based on the extent of the feature class.</li></ul></xdoc>",
        "select_using_features.title": "Using Input Geometry for Selection",
        "title": "Create Referenced Mosaic Dataset",
        "where_clause.descr": "An SQL expression to select raster datasets that will be included in the output mosaic dataset.",
        "where_clause.title": "Query Definition"
    }
}
