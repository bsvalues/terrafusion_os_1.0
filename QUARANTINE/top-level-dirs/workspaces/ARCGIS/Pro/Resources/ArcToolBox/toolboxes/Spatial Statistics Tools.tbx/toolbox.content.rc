{
    "map": {
        "descr": "The Spatial Statistics toolbox contains statistical tools for analyzing spatial distributions, patterns, processes, and relationships. While there may be similarities between spatial and nonspatial (traditional) statistics in terms of concepts and objectives, spatial statistics are unique in that they were developed specifically for use with geographic data. Unlike traditional nonspatial statistical methods, they incorporate space (proximity, area, connectivity, and/or other spatial relationships) directly into their mathematics.",
        "title": "Spatial Statistics Tools",
        "toolset1.name": "Assessing Sensitivity",
        "toolset2.name": "Analyzing Patterns",
        "toolset3.name": "Modeling Spatial Relationships",
        "toolset4.name": "Mapping Clusters",
        "toolset5.name": "Utilities",
        "toolset6.name": "Measuring Geographic Distributions",
        "toolset7.name": "Spatial Component Utilities (Moran Eigenvectors)"
    }
}
