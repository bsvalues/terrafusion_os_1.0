                        "value": "true",
                        "code": "REQUIRE_SYMBOL"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_SYMBOL_REQUIRED"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:require_symbol_from_table.descr"
        },
        "create_annotation_when_feature_added": {
            "enabled": "false",
