{
    "map": {
        "create_seq.descr": "<xdoc><p>Specifies whether database sequences will be created in the specified workspace.<ul><li>Checked—Database sequences will be created. This is the default.</li><li>Unchecked—Database sequences will not be created.</li></ul></p></xdoc>",
        "create_seq.title": "Create Sequences",
        "definition_method.descr": "<xdoc><p>Specifies the method that will be used to define the format of the ID.</p><ul><li><span title=\"BUILDER\">Builder</span>— The ID format will be constructed using the <span class=\"esri_uicontrol\">ID Builder</span> parameter.</li><li><span title=\"TABLE\">Table</span>—The ID format will be defined from a table using the <span class=\"esri_uicontrol\">ID Definition Table</span> parameter.</li><li><span title=\"CODED_VALUES\">Code Values</span>— A configuration entry and sequence will be generated for each combination of coded values from the selected fields.</li></ul></xdoc>",
        "definition_method.domain.BUILDER": "Builder",
        "definition_method.domain.CODED_VALUES": "Code Values",
        "definition_method.domain.TABLE": "Table",
        "definition_method.title": "Definition Type",
        "description": "Creates an attribute rule that generates a unique value for a field from a query. The tool outputs a .csv file containing an ArcGIS Arcade attribute rule based on the inputs provided, a Python file that contains the code for generating sequences in the workspace, and an ID file for visualizing generated IDs.",
        "field.descr": "The name of the existing field the rule will be applied to.",
        "field.title": "Field",
        "id_builder.descr": "<xdoc><p>A set of format options that will define the attribute rule. This includes an SQL expression that will be used to apply different formats and sequences per asset, as well as padding, prefix, and suffix values.<ul><li>Filter SQL—An optional SQL expression that will be used to determine whether the sequence will be applied to the row.</li><li>Description—An optional description of the entry that will be added to the rule settings in the attribute rule.</li><li>Sequence Name—The name that will be assigned to the database sequence. For enterprise geodatabases, the name must meet sequence name requirements for the database platform you&apos;re using and must be unique in the database. For file geodatabases, the name must be unique to the file geodatabase.</li><li>Starting Value—The starting number of the sequence. If you do not provide a starting number, the sequence will start at 1. If you do provide a starting number, it must be greater than 0.</li><li>Increment Value—Describes how the sequence numbers will be incremented. For example, if the sequence starts at 10 and the increment value is 5, the next value in the sequence is 15, and the next value after that is 20. If you do not specify an increment value, sequence values will increment by 1.</li><li>Prefix—An optional string or value that will be placed before the sequence value.</li><li>Suffix—An optional string or value that will be placed after the sequence value.</li><li> Padding—An optional positive number that represents the number of digits, where zeros will be used to fill the unused digits. For example, a value of 5 will represent the sequence value of 1 as 00001.</li><li>Separator—An optional value that will be used to join the prefix, sequence, and suffix.</li></ul></p><p>A preview of the string will display in the <span class=\"esri_uicontrol\">Geoprocessing</span> pane from the values entered in the format options.</p></xdoc>",
        "id_builder.dt.title1": "Filter SQL",
        "id_builder.dt.title2": "Description",
        "id_builder.dt.title3": "Sequence Name",
        "id_builder.dt.title4": "Starting Value",
        "id_builder.dt.title5": "Increment Value",
        "id_builder.dt.title6": "Prefix",
        "id_builder.dt.title7": "Suffix",
        "id_builder.dt.title8": "Padding",
        "id_builder.dt.title9": "Separator",
        "id_builder.title": "ID Builder",
        "id_coded_value.descr": "The fields that will be used to generate an SQL expression and configuration for an ID.",
        "id_coded_value.title": "Coded Value Fields",
        "id_table.descr": "<xdoc><p>A table or record set that defines the ID format. This includes the SQL expression that will be used to apply different formats and sequences per asset, as well as padding, prefix, and suffix values.</p><p>The table must include the following fields:<ul><li>WhereClause—An optional SQL expression that will be used to determine whether the sequence will be applied to the row.</li><li>Description—An optional description of the entry that will be added to the rule settings in the attribute rule.</li><li>SequenceName—The name that will be assigned to the database sequence. For enterprise geodatabases, the name must meet sequence name requirements for the database platform you&apos;re using and must be unique in the database. For file geodatabases, the name must be unique to the file geodatabase.</li><li>StartingValue—The starting number of the sequence. If you do not provide a starting number, the sequence will start at 1. If specified, the starting number must be greater than 0.</li><li>IncrementValue—Describes how the sequence numbers will increment. For example, if the sequence starts at 10 and the increment value is 5, the next value in the sequence will be 15, and the next value after that will be 20. If you do not specify an increment value, sequence values will increment by 1.</li><li>Prefix—An optional string or value that will be placed before the sequence value.</li><li>Suffix—An optional string or value that will be placed after the sequence value.</li><li>Padding—An optional positive number that represents the number of digits, where zeros will be used to fill the unused digits. For example, a value of 5 will represent the sequence value of 1 as 00001.</li><li> Separator—An optional value that will be used to join the prefix, sequence, and suffix.</li></ul></p></xdoc>",
        "id_table.title": "ID Definition Table",
        "in_table.descr": "The dataset that the new rule will be applied to.",
        "in_table.title": "Input Table",
        "out_folder.descr": "<xdoc><p>The folder where the output .csv file will be saved. The name of the file will be taken from the <span class=\"esri_uicontrol\">Input Table</span> parameter value.</p></xdoc>",
        "out_folder.title": "Output Folder",
        "out_id_file.title": "ID Definition Table",
        "out_rule_csv.title": "Output Rule CSV",
        "out_seq_script.title": "Python Sequence Script",
        "title": "Generate ID Attribute Rule",
        "where_clause.descr": "An SQL expression that limits the rows that the attribute rule will be applied to.",
        "where_clause.title": "Expression"
    }
}
