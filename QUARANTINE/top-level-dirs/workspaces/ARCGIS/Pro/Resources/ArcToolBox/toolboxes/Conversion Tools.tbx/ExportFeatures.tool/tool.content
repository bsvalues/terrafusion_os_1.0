{
    "type": "FunctionTool",
    "guid": "{2a10c246-9c0e-4b69-b05c-098155abda49}",
    "displayname": "$rc:title",
    "helpcontent": "2040014",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "description": "$rc:in_features.descr"
        },
        "out_features": {
            "direction": "out",
            "displayname": "$rc:out_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "in_features"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "fields.rule": "Maintain",
                "clonedependency": "true",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_features.descr"
        },
        "where_clause": {
            "type": "optional",
            "displayname": "$rc:where_clause.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "in_features"
            ],
            "category": "$rc:params.category1",
            "description": "$rc:where_clause.descr"
        },
        "use_field_alias_as_name": {
            "type": "optional",
            "displayname": "$rc:use_field_alias_as_name.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "USE_ALIAS"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NOT_USE_ALIAS"
                    }
                ]
            },
            "value": "false",
            "category": "$rc:params.category2",
            "description": "$rc:use_field_alias_as_name.descr"
        },
        "field_mapping": {
            "type": "optional",
            "displayname": "$rc:field_mapping.title",
            "datatype": {
                "type": "GPFieldMapping"
            },
            "depends": [
                "in_features"
            ],
            "category": "$rc:params.category2",
            "description": "$rc:field_mapping.descr"
        },
        "sort_field": {
            "type": "optional",
            "displayname": "$rc:sort_field.title",
            "category": "$rc:params.category3",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:sort_field.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:sort_field.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double",
                            "Text",
                            "Date"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "ASCENDING",
                                "code": "$rc:sort_field.domain.item2.ASCENDING"
                            },
                            {
                                "value": "DESCENDING",
                                "code": "$rc:sort_field.domain.item2.DESCENDING"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:sort_field.descr"
        }
    },
    "environments": [
        "MDomain",
        "MResolution",
        "MTolerance",
        "XYDomain",
        "XYResolution",
        "XYTolerance",
        "ZDomain",
        "ZResolution",
        "ZTolerance",
        "autoCommit",
        "configKeyword",
        "extent",
        "geographicTransformations",
        "maintainAttachments",
        "outputCoordinateSystem",
        "outputMFlag",
        "outputZFlag",
        "outputZValue",
        "preserveGlobalIds",
        "qualifiedFieldNames",
        "transferDomains",
        "workspace"
    ]
}
