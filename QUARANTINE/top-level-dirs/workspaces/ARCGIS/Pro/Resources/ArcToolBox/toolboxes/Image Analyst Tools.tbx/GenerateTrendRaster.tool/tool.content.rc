{
    "map": {
        "cycle_length.descr": "<xdoc><p>The length of periodic variation to model. This parameter is required when <span class=\"esri_uicontrol\">Trend Type</span> is set to <span class=\"esri_uicontrol\">Harmonic</span>. For example, leaf greenness often has one strong cycle of variation in a single year, so the cycle length is 1 year. Hourly temperature data has one strong cycle of variation throughout a single day, so the cycle length is 1 day.</p><p>The default length is 1 year for data that varies on an annual cycle.</p></xdoc>",
        "cycle_length.title": "Length of Cycle",
        "cycle_unit.descr": "<xdoc><p>Specifies the time unit to be used for the length of a harmonic cycle.</p><ul><li><span title=\"DAYS\">Days</span>—The unit for the length of the harmonic cycle is days.</li><li><span title=\"YEARS\">Years</span>—The unit for the length of the harmonic cycle is years. This is the default.</li></ul></xdoc>",
        "cycle_unit.domain.DAYS": "Days",
        "cycle_unit.domain.YEARS": "Years",
        "cycle_unit.title": "Cycle Unit",
        "description": "Estimates the trend for each pixel along a dimension for one or more variables in a multidimensional raster.",
        "dimension.descr": "The dimension along which a trend will be extracted for the variable or variables selected in the analysis.",
        "dimension.title": "Dimension",
        "frequency.descr": "<xdoc><p>The frequency or the polynomial order number to use in the trend fitting. If the trend type is polynomial, this parameter specifies the polynomial order. If the trend type is harmonic, this parameter specifies the number of models to use to fit the trend.</p><p>This parameter is only included in the trend analysis when the dimension being analyzed is time.</p><p>If the <span class=\"esri_uicontrol\">Trend Type</span> parameter is <span class=\"esri_uicontrol\">Harmonic</span>, the default value is 1, meaning a first order harmonic curve is used to fit the model.</p><p>If the <span class=\"esri_uicontrol\">Trend Type</span> parameter is <span class=\"esri_uicontrol\">Polynomial</span>, the default value is 2, or second order polynomial.</p></xdoc>",
        "frequency.title": "Frequency / Polynomial Order",
        "ignore_nodata.descr": "<xdoc><p>Specifies whether NoData values will be ignored in the analysis.</p><ul><li>Checked—The analysis will include all valid pixels along a given dimension and ignore NoData pixels. This is the default.</li><li>Unchecked—The analysis will result in NoData if there are NoData values for the pixels along the given dimension.</li></ul></xdoc>",
        "ignore_nodata.title": "Ignore NoData",
        "in_multidimensional_raster.descr": "The input multidimensional raster dataset.",
        "in_multidimensional_raster.title": "Input Multidimensional Raster",
        "line_type.descr": "<xdoc><p>Specifies the type of trend analysis to perform to pixel values along a dimension.</p><ul><li><span title=\"LINEAR\">Linear</span>—Variable pixel values will be fitted along a linear trend line. This is the default.</li><li><span title=\"POLYNOMIAL\">Polynomial</span>—Variable pixel values will be fitted along a second order polynomial trend line.</li><li><span title=\"HARMONIC\">Harmonic</span>—Variable pixel values will be fitted along a harmonic trend line.</li><li><span title=\"MANN-KENDALL\">Mann-Kendall</span>—Variable pixel values will be evaluated using the Mann-Kendall trend test.</li><li><span title=\"SEASONAL-KENDALL\">Seasonal-Kendall</span>—Variable pixel values will be evaluated using the Seasonal-Kendall trend test.</li></ul></xdoc>",
        "line_type.domain.HARMONIC": "Harmonic",
        "line_type.domain.LINEAR": "Linear",
        "line_type.domain.MANN-KENDALL": "Mann-Kendall",
        "line_type.domain.POLYNOMIAL": "Polynomial",
        "line_type.domain.SEASONAL-KENDALL": "Seasonal-Kendall",
        "line_type.title": "Trend Type",
        "out_multidimensional_raster.descr": "The output Cloud Raster Format (CRF) multidimensional raster dataset.",
        "out_multidimensional_raster.title": "Output Multidimensional Raster",
        "params.category1": "Model Statistics",
        "r2.descr": "<xdoc><p>Specifies whether the R-squared goodness-of-fit statistic for the trend fit line will be calculated.</p><ul><li>Checked—The R-squared value will be calculated and displayed in the raster dataset properties window under <span class=\"esri_uicontrol\">Statistics</span>.</li><li>Unchecked—The R-squared value will not be calculated. This is the default.</li></ul></xdoc>",
        "r2.title": "R-Squared",
        "rmse.descr": "<xdoc><p>Specifies whether the root mean square error (RMSE) of the trend fit line will be calculated.</p><ul><li>Checked—The RMSE will be calculated and displayed in the raster dataset properties window under <span class=\"esri_uicontrol\">Statistics</span>. This is the default.</li><li>Unchecked—The RMSE will not be calculated.</li></ul></xdoc>",
        "rmse.title": "RMSE",
        "seasonal_period.descr": "<xdoc><p>Specifies the time unit to be used for the length of a seasonal period when performing the Seasonal-Kendall test.</p><ul><li><span title=\"DAYS\">Days</span>—The unit for the length of the seasonal period is days. This is the default.</li><li><span title=\"MONTHS\">Months</span>—The unit for the length of the seasonal period is months.</li></ul></xdoc>",
        "seasonal_period.domain.DAYS": "Days",
        "seasonal_period.domain.MONTHS": "Months",
        "seasonal_period.title": "Seasonal Period",
        "slope_p_value.descr": "<xdoc><p>Specifies whether the p-value statistic for the slope coefficient of the trend line will be calculated.</p><ul><li>Checked—The p-value will be calculated and displayed in the raster dataset properties window under <span class=\"esri_uicontrol\">Statistics</span>.</li><li>Unchecked—The p-value will not be calculated. This is the default.</li></ul></xdoc>",
        "slope_p_value.title": "P-Value of Slope Coefficient",
        "title": "Generate Trend Raster",
        "variables.descr": "The variable or variables for which trends will be calculated. If no variable is specified, the first variable in the multidimensional raster will be analyzed.",
        "variables.title": "Variables [Dimension Info] (Description)"
    }
}
