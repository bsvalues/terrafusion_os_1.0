                "items": [
                    {
                        "value": "MINIMUM",
                        "code": "$rc:statisticstype.domain.MINIMUM"
                    },
                    {
                        "value": "MAXIMUM",
                        "code": "$rc:statisticstype.domain.MAXIMUM"
                    },
                    {
                        "value": "WEIGHTED_MEAN",
                        "code": "$rc:statisticstype.domain.WEIGHTED_MEAN"
                    }
                ]
            },
            "value": "MINIMUM",
            "description": "$rc:statisticstype.descr"
        }
    },
