                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:inputstreamraster.descr"
        },
        "inputSurfaceRaster": {
            "displayname": "$rc:inputsurfaceraster.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEImageServer"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:inputsurfaceraster.descr"
        },
        "outputName": {
            "displayname": "$rc:outputname.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:outputname.descr"
        },
        "inputFlowDirectionRaster": {
            "type": "optional",
            "displayname": "$rc:inputflowdirectionraster.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEImageServer"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:inputflowdirectionraster.descr"
        },
        "distanceType": {
            "type": "optional",
            "displayname": "$rc:distancetype.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "VERTICAL",
                        "code": "$rc:distancetype.domain.VERTICAL"
                    },
                    {
                        "value": "HORIZONTAL",
                        "code": "$rc:distancetype.domain.HORIZONTAL"
                    }
                ]
            },
            "value": "VERTICAL",
            "description": "$rc:distancetype.descr"
        },
        "flowDirectionType": {
            "type": "optional",
            "displayname": "$rc:flowdirectiontype.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "D8",
                        "code": "$rc:flowdirectiontype.domain.D8"
                    },
                    {
                        "value": "MFD",
                        "code": "$rc:flowdirectiontype.domain.MFD"
                    },
                    {
                        "value": "DINF",
                        "code": "$rc:flowdirectiontype.domain.DINF"
                    }
                ]
            },
            "value": "D8",
            "description": "$rc:flowdirectiontype.descr"
        },
        "outputRaster": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:outputraster.title",
            "datatype": {
                "type": "GPRasterLayer"
            }
        },
        "statisticsType": {
            "type": "optional",
            "displayname": "$rc:statisticstype.title",
            "datatype": {
                "type": "GPString"
