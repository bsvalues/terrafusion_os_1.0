{
    "map": {
        "attributes.descr": "<xdoc><p>Specifies the attributes that will be transferred from the input features to the output features.</p><ul><li><span title=\"ONLY_FID\">Only feature IDs</span>—Only the FID field from the input features will be transferred to the output features. This is the default.</li><li><span title=\"NO_FID\">All attributes except feature IDs</span>—All the attributes except the FID from the input features will be transferred to the output features.</li><li><span title=\"ALL\">All attributes</span>—All the attributes from the input features will be transferred to the output features.</li></ul></xdoc>",
        "attributes.domain.ALL": "All attributes",
        "attributes.domain.NO_FID": "All attributes except feature IDs",
        "attributes.domain.ONLY_FID": "Only feature IDs",
        "attributes.title": "Transfer Attributes",
        "description": "Creates a feature class of polygon masks from a symbolized input line layer.",
        "input_layer.descr": "The input line layer from which the masks will be created.",
        "input_layer.title": "Input Layer",
        "margin.descr": "<xdoc><p>The space in page units surrounding the symbolized input features used to create the mask polygons. Typically, masking polygons are created with a small margin around the symbol to improve visual appearance. Margin values are specified in either page units or map units. Most of the time, you will specify your margin distance value in page units.</p><p>The margin cannot be negative.</p></xdoc>",
        "margin.title": "Margin",
        "output_fc.descr": "The feature class that will contain the mask features.",
        "output_fc.title": "Output Feature Class",
        "reference_scale.descr": "The reference scale used for calculating the masking geometry when masks are specified in page units. This is typically the reference scale of the map.",
        "reference_scale.title": "Reference Scale",
        "spatial_reference.descr": "The spatial reference of the map in which the masking polygons will be created. This is not the spatial reference that will be assigned to the output feature class. It is the spatial reference of the map in which the masking polygons will be used, since the position of symbology may change when features are projected.",
        "spatial_reference.title": "Calculation coordinate system",
        "title": "Cul-De-Sac Masks"
    }
}
