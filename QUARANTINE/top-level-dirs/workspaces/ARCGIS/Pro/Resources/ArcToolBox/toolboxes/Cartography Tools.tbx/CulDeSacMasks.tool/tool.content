{
    "type": "FunctionTool",
    "guid": "{7a639dfb-d2ec-49e7-b4bd-b49dc117244d}",
    "displayname": "$rc:title",
    "helpcontent": "10010001",
    "description": "$rc:description",
    "product": "300",
    "params": {
        "input_layer": {
            "displayname": "$rc:input_layer.title",
            "datatype": {
                "type": "GPLayer"
            },
            "domain": {
                "type": "GPLayerDomain",
                "geometrytype": [
                    "Polyline"
                ]
            },
            "description": "$rc:input_layer.descr"
        },
        "output_fc": {
            "direction": "out",
            "displayname": "$rc:output_fc.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "description": "$rc:output_fc.descr"
        },
        "reference_scale": {
            "control_guid": "{B23D9E8D-E360-4670-919E-A7F8FFF0DC19}",
            "displayname": "$rc:reference_scale.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0",
            "description": "$rc:reference_scale.descr"
        },
        "spatial_reference": {
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "description": "$rc:spatial_reference.descr"
        },
        "margin": {
            "displayname": "$rc:margin.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                }
            },
            "value": "0 Points",
            "description": "$rc:margin.descr"
        },
        "attributes": {
            "displayname": "$rc:attributes.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NO_FID",
                        "code": "$rc:attributes.domain.NO_FID"
                    },
                    {
                        "value": "ONLY_FID",
                        "code": "$rc:attributes.domain.ONLY_FID"
                    },
                    {
                        "value": "ALL",
                        "code": "$rc:attributes.domain.ALL"
                    }
                ]
            },
            "value": "ONLY_FID",
            "description": "$rc:attributes.descr"
        }
    },
    "environments": [
        "cartographicCoordinateSystem"
    ]
}
