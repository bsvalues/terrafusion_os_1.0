{
    "map": {
        "camera_heading.descr": "The camera orientation of the first rotation around the z-axis of the camera. The value is in degrees. The heading values are measured in the positive clockwise direction in which north is defined as 0 degrees. -999 is used when the orientation is unknown.",
        "camera_heading.title": "Camera Heading",
        "camera_height.descr": "The height of the camera above the ground when the imagery was captured. The unit is meters. Camera height is used to determine the visible extent of the image. Large values will result in a greater view extent. Values should not be less than 0.",
        "camera_height.title": "Camera Height",
        "camera_pitch.descr": "The camera orientation of the second rotation around the x-axis of the camera in the positive counterclockwise direction. The value is in degrees. The pitch is 0 degrees when the camera is facing straight down to the ground. The valid range of pitch is from 0 to 180 degrees, with 180 degrees for a camera facing straight up and 90 degrees for a camera facing the horizon.",
        "camera_pitch.title": "Camera Pitch",
        "camera_roll.descr": "The camera orientation of the final rotation around the z-axis of the camera in the positive clockwise direction. The value is in degrees. Valid values range from -90 to 90.",
        "camera_roll.title": "Camera Roll",
        "constant_elevation.descr": "<xdoc><p>The constant ground elevation value for the entire dataset. The <span class=\"esri_uicontrol\">Vertical Measurement Unit</span> parameter value will be used as the unit for constant elevation.</p><p>This parameter is active when the <span class=\"esri_uicontrol\">Elevation Source</span> parameter value is specified as <span class=\"esri_uicontrol\">Constant Elevation</span>.</p></xdoc>",
        "constant_elevation.title": "Constant Elevation",
        "coverage_percent.descr": "<xdoc><p>A percentage that modifies the extent of the image’s ground footprint. The ground footprint of each image is computed to search for images that contain the selected location, which is identified as a red cross on the map.</p><p>A negative percentage value reduces the size of the ground footprint and a positive percentage value increases it. This parameter can be used to exclude or include points on the edge of an image. For example, a value of -30 will reduce the size of the footprint by 30 percent and a value of 20 will increase it by 20 percent. Valid values range from -50 to 50.</p></xdoc>",
        "coverage_percent.title": "Coverage Percentage",
        "dem.descr": "<xdoc><p>The URL that references the input digital elevation model. A dynamic image service or a tile image service can be used as the digital elevation model.</p><p>This parameter is active when the <span class=\"esri_uicontrol\">Elevation Source</span> parameter value is specified as <span class=\"esri_uicontrol\">DEM</span>.</p></xdoc>",
        "dem.title": "Digital Elevation Model",
        "dem_path_prefix.descr": "<xdoc><p>The prefix that will be used to build the DEM path in conjunction with the <span class=\"esri_fieldname\">Elevation Source</span> URL in the attribute.</p></xdoc>",
        "dem_path_prefix.title": "DEM Path Prefix",
        "dem_path_suffix.descr": "<xdoc><p>The suffix that will be used to build the DEM path in conjunction with the <span class=\"esri_fieldname\">Elevation Source</span> URL in the attribute.</p></xdoc>",
        "dem_path_suffix.title": "DEM Path Suffix",
        "depth_image_path_prefix.descr": "<xdoc><p>The prefix that will be used to build the depth image path in conjunction with the <span class=\"esri_fieldname\">Depth Image</span> attribute.</p></xdoc>",
        "depth_image_path_prefix.title": "Depth Image Path Prefix",
        "depth_image_path_suffix.descr": "<xdoc><p>The suffix that will be used to build the depth image path in conjunction with the <span class=\"esri_fieldname\">Depth Image</span> attribute.</p></xdoc>",
        "depth_image_path_suffix.title": "Depth Image Path Suffix",
        "description": "Updates or modifies oriented imagery dataset properties.",
        "elevation_source.descr": "<xdoc><p>Specifies the elevation source that will be used.</p><ul><li><span title=\"DEM\">DEM</span>—The elevation source will be a digital elevation model that is a dynamic image service or a tile image service.</li><li><span title=\"CONSTANT_ELEVATION\">Constant Elevation</span>—The elevation source will be a constant ground elevation value for the entire dataset.</li><li><span title=\"NONE\">None</span>—The elevation source will be removed.</li></ul></xdoc>",
        "elevation_source.domain.CONSTANT_ELEVATION": "Constant Elevation",
        "elevation_source.domain.DEM": "DEM",
        "elevation_source.domain.NONE": "None",
        "elevation_source.title": "Elevation Source",
        "far_distance.descr": "The farthest usable distance of the imagery from the camera position. The unit is meters. Far distances should be greater than 0.",
        "far_distance.title": "Far Distance",
        "footprint_item.descr": "The name of the footprint feature class. The feature class should be in the same geodatabase as the oriented imagery dataset.",
        "footprint_item.title": "Footprint Item",
        "hfov.descr": "The camera's scope in the horizontal direction. The value is in degrees. Valid values range from 0 to 360.",
        "hfov.title": "Horizontal Field of View",
        "image_path_prefix.descr": "<xdoc><p>The prefix that will be used to build the image path in conjunction with the <span class=\"esri_fieldname\">Image</span> attribute.</p></xdoc>",
        "image_path_prefix.title": "Image Path Prefix",
        "image_path_suffix.descr": "<xdoc><p>The suffix that will be used to build the image path in conjunction with the <span class=\"esri_fieldname\">Image</span> attribute.</p></xdoc>",
        "image_path_suffix.title": "Image Path Suffix",
        "image_rotation.descr": "The orientation of the camera in degrees relative to the scene when the image was captured. The rotation is added in addition to the camera roll. Valid values range from-360 to 360.",
        "image_rotation.title": "Image Rotation",
        "in_oriented_imagery_dataset.descr": "The path and name of the oriented imagery dataset.",
        "in_oriented_imagery_dataset.title": "Oriented Imagery Dataset",
        "lod.descr": "<xdoc><p>The scale defined in a tiling schema. The scale represents the zoom level value. Each successive level improves resolution and map scale by double when compared to the previous level.</p><p>This parameter is enabled when the <span class=\"esri_uicontrol\">Digital Elevation Model</span> parameter value is a tile image service.</p></xdoc>",
        "lod.title": "Level of Detail",
        "maximum_distance.descr": "The maximum search distance that will be used when querying the dataset features. The maximum distance cannot be less than zero. The unit is meters.",
        "maximum_distance.title": "Maximum Distance",
        "near_distance.descr": "The nearest usable distance of the imagery from the camera position. The unit is meters.",
        "near_distance.title": "Near Distance",
        "orientation_accuracy.descr": "<xdoc><p>The standard deviation in accuracy values separated by semicolons. The standard deviation values are added in the following order and format:<ul><li>Camera location in XY direction in meters</li><li>Camera Height in meters</li><li>Camera Heading in degrees</li><li>Camera Pitch in degrees</li><li>Camera Roll in degrees</li><li>Near distance in meters</li><li>Far distance in meters</li><li>Elevation in meters</li></ul></p><p>For example, if the GPS has a +/– 10 meters RMS in x,y-coordinates and +/– 20 meters in height, the orientation accuracy value is 10;20.</p></xdoc>",
        "orientation_accuracy.title": "Orientation Accuracy",
        "oriented_imagery_type.descr": "<xdoc><p>Specifies the type of images in the dataset.</p><ul><li><span title=\"HORIZONTAL\">Horizontal</span>— Images in which the exposure is parallel to the ground and looking to the horizon are in the dataset.</li><li><span title=\"OBLIQUE\">Oblique</span>—Images in which the exposure is at an angle to the ground, typically at about 45 degrees, so the sides of objects can be seen are in the dataset.</li><li><span title=\"NADIR\">Nadir</span>—Images in which the exposure is perpendicular to the ground and looking straight down are in the dataset. Only the top of objects can be seen.</li><li><span title=\"360\">360</span>—Images taken using cameras that provide 360-degree spherical surround views or have been stitched together as 360-degree views from multiple cameras are in the dataset.</li><li><span title=\"INSPECTION\">Inspection</span>— Close-up images of assets are in the dataset.</li><li><span title=\"NONE\">None</span>—The oriented imagery type will be removed from the dataset.</li></ul></xdoc>",
        "oriented_imagery_type.domain.360": "360",
        "oriented_imagery_type.domain.HORIZONTAL": "Horizontal",
        "oriented_imagery_type.domain.INSPECTION": "Inspection",
        "oriented_imagery_type.domain.NADIR": "Nadir",
        "oriented_imagery_type.domain.NONE": "None",
        "oriented_imagery_type.domain.OBLIQUE": "Oblique",
        "oriented_imagery_type.title": "Oriented Imagery Type",
        "out_oriented_imagery_dataset.title": "Output Oriented Imagery Dataset",
        "params.category1": "Primary",
        "params.category2": "Orientation",
        "params.category3": "Affixes",
        "raster_function.descr": "<xdoc><p>The raster function processing template that will be applied to the image service.</p><p>This parameter is active when the <span class=\"esri_uicontrol\">Digital Elevation Model</span> parameter value is a dynamic image service.</p></xdoc>",
        "raster_function.title": "Raster Function",
        "time_interval_unit.descr": "<xdoc><p>Specifies the time measurement unit that will be used to filter images.</p><ul><li><span title=\"MINUTES\">Minutes</span>— Images will be filtered by minutes.</li><li><span title=\"HOURS\">Hours</span>— Images will be filtered by hours.</li><li><span title=\"DAYS\">Days</span>— Images will be filtered by days.</li><li><span title=\"WEEKS\">Weeks</span>— Images will be filtered by weeks.</li><li><span title=\"MONTHS\">Months</span>— Images will be filtered by months.</li><li><span title=\"YEARS\">Years</span>— Images will be filtered by years.</li></ul></xdoc>",
        "time_interval_unit.domain.DAYS": "Days",
        "time_interval_unit.domain.HOURS": "Hours",
        "time_interval_unit.domain.MINUTES": "Minutes",
        "time_interval_unit.domain.MONTHS": "Months",
        "time_interval_unit.domain.WEEKS": "Weeks",
        "time_interval_unit.domain.YEARS": "Years",
        "time_interval_unit.title": "Time Interval Unit",
        "title": "Update Oriented Imagery Dataset Properties",
        "vertical_measurement_unit.descr": "<xdoc><p>Specifies the unit that will be used for all vertical measurements.</p><ul><li><span title=\"METER\">Meter</span>—Meters will be used as the unit of measurement.</li><li><span title=\"FEET\">Feet</span>—Feet will be used as the unit of measurement.</li></ul></xdoc>",
        "vertical_measurement_unit.domain.FEET": "Feet",
        "vertical_measurement_unit.domain.METER": "Meter",
        "vertical_measurement_unit.title": "Vertical Measurement Unit",
        "vfov.descr": "The camera's scope in the vertical direction. The value is in degrees. Valid values range from 0 to 180.",
        "vfov.title": "Vertical  Field of View"
    }
}
