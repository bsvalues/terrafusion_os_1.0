{
    "type": "FunctionTool",
    "guid": "{33CA4A60-4D2E-4583-8844-3D0A75F6D305}/UpgradeWorkflowDatabase",
    "displayname": "$rc:title",
    "helpcontent": "35000012",
    "description": "$rc:description",
    "product": "200",
    "extensions": [
        "40"
    ],
    "params": {
        "Input_Database_Connection": {
            "displayname": "$rc:input_database_connection.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Remote Database"
                ]
            },
            "description": "$rc:input_database_connection.descr"
        },
        "User_Store": {
            "type": "optional",
            "displayname": "$rc:user_store.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TRADITIONAL",
                        "code": "$rc:user_store.domain.TRADITIONAL"
                    },
                    {
                        "value": "PORTAL",
                        "code": "$rc:user_store.domain.PORTAL"
                    }
                ]
            },
            "description": "$rc:user_store.descr"
        },
        "Output_DatabasePath": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_databasepath.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "jtc"
                ]
            }
        }
    },
    "environments": [
        "configKeyword"
    ]
}
