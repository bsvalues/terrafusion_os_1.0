{
    "type": "FunctionTool",
    "guid": "{bfcb2043-95c8-4bfd-956b-1ca1c830ce63}",
    "displayname": "$rc:title",
    "helpcontent": "3040010",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "out_path": {
            "displayname": "$rc:out_path.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEFeatureDataset"
                    }
                ]
            },
            "description": "$rc:out_path.descr"
        },
        "out_name": {
            "displayname": "$rc:out_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:out_name.descr"
        },
        "geometry_type": {
            "type": "optional",
            "displayname": "$rc:geometry_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POINT",
                        "code": "$rc:geometry_type.domain.POINT"
                    },
                    {
                        "value": "MULTIPOINT",
                        "code": "$rc:geometry_type.domain.MULTIPOINT"
                    },
                    {
                        "value": "POLYGON",
                        "code": "$rc:geometry_type.domain.POLYGON"
                    },
                    {
                        "value": "POLYLINE",
                        "code": "$rc:geometry_type.domain.POLYLINE"
                    }
                ]
            },
            "value": "POLYGON",
            "description": "$rc:geometry_type.descr"
        },
        "template": {
            "type": "optional",
            "displayname": "$rc:template.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "description": "$rc:template.descr"
        },
        "has_m": {
            "type": "optional",
            "displayname": "$rc:has_m.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DISABLED",
                        "code": "$rc:has_m.domain.DISABLED"
                    },
                    {
                        "value": "SAME_AS_TEMPLATE",
                        "code": "$rc:has_m.domain.SAME_AS_TEMPLATE"
                    },
                    {
                        "value": "ENABLED",
                        "code": "$rc:has_m.domain.ENABLED"
                    }
                ]
            },
            "value": "DISABLED",
            "description": "$rc:has_m.descr"
        },
        "has_z": {
            "type": "optional",
            "displayname": "$rc:has_z.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DISABLED",
                        "code": "$rc:has_z.domain.DISABLED"
                    },
                    {
                        "value": "SAME_AS_TEMPLATE",
                        "code": "$rc:has_z.domain.SAME_AS_TEMPLATE"
                    },
                    {
                        "value": "ENABLED",
                        "code": "$rc:has_z.domain.ENABLED"
                    }
                ]
            },
            "value": "DISABLED",
            "description": "$rc:has_z.descr"
        },
        "spatial_reference": {
            "type": "optional",
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "depends": [
                "out_path"
            ],
            "defaultenvironmentname": "outputCoordinateSystem",
            "description": "$rc:spatial_reference.descr"
        },
        "config_keyword": {
            "type": "optional",
            "displayname": "$rc:config_keyword.title",
            "datatype": {
                "type": "GPString"
            },
            "defaultenvironmentname": "configKeyword",
            "description": "$rc:config_keyword.descr"
        },
        "out_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            }
        }
    },
    "environments": [
        "configKeyword",
        "workspace"
    ]
}
