{
    "map": {
        "allow_any_lookup_value.descr": "<xdoc><p>Specifies whether a value that is not in the lookup table can be added. The <span class=\"esri_uicontrol\">Lookup Display</span> parameter cannot be configured when this option is checked.</p><ul><li>Checked—Allow a value to be configured when one is not present in the table.</li><li>Unchecked—Don&apos;t allow a lookup display value to be configured. This is the default.</li></ul></xdoc>",
        "allow_any_lookup_value.title": "Allow any lookup value",
        "description": "Configures a lookup table for one or more fields used in a multifield route ID.",
        "field_applied_to.descr": "<xdoc><p>The route ID field in the LRS Network in which the <span class=\"esri_uicontrol\">Lookup Table</span> will be configured.</p></xdoc>",
        "field_applied_to.title": "Field Applied To",
        "in_feature_class.descr": "The input LRS Network feature class in which the lookup table will be configured. The network must have a multifield route ID.",
        "in_feature_class.title": "LRS Network Feature Class",
        "lookup_display.descr": "<xdoc><p>The <span class=\"esri_uicontrol\">Lookup Table</span> description field. This field appears in the text box for the multifield route ID.</p></xdoc>",
        "lookup_display.title": "Lookup Display",
        "lookup_key.descr": "<xdoc><p>The key field in the <span class=\"esri_uicontrol\">Lookup Table</span>.</p></xdoc>",
        "lookup_key.title": "Lookup Key",
        "lookup_table.descr": "A table that contains a list of street names and their corresponding GNIS codes. It can be a stand-alone table or reside in an SDE.",
        "lookup_table.title": "Lookup Table",
        "out_feature_class.title": "Output Network Feature Class",
        "summary": "<xdoc><p>Configures a lookup table for one or more fields used in a multifield route ID.</p><p>This tool can be run after Create LRS Network From Existing Dataset or Modify LRS Network for a multifield route ID.</p><p>A lookup table is an alternative to using coded value domains when a field that makes up a multifield route ID has several hundred or thousands of potential values, for example, a list of street names or a Geographic Names Information System (GNIS) code. The lookup table is used primarily when creating a route.</p></xdoc>",
        "title": "Configure Lookup Table"
    }
}
