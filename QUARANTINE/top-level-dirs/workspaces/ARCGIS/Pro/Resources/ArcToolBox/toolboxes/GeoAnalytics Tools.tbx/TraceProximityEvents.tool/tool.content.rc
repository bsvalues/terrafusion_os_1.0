{
    "map": {
        "attribute_match_criteria.descr": "The fields used to constrain the proximity event.",
        "attribute_match_criteria.title": "Attribute Match Criteria",
        "data_store.descr": "<xdoc><p>Specifies the ArcGIS Data Store where the output will be stored. All results stored in a spatiotemporal big data store will be stored in WGS84. Results stored in a relational data store will maintain their coordinate system.</p><ul><li><span title=\"SPATIOTEMPORAL_DATA_STORE\">Spatiotemporal big data store</span>—Output will be stored in a spatiotemporal big data store. This is the default.</li><li><span title=\"RELATIONAL_DATA_STORE\">Relational data store</span>—Output will be stored in a relational data store.</li></ul></xdoc>",
        "data_store.domain.RELATIONAL_DATA_STORE": "Relational data store",
        "data_store.domain.SPATIOTEMPORAL_DATA_STORE": "Spatiotemporal big data store",
        "data_store.title": "Data Store",
        "description": "Traces events that are near each other in space (location) and time. The time-enabled point data must include features that represent an instant in time.",
        "distance_method.descr": "<xdoc><p>Specifies the distance type that will be used with the <span class=\"esri_uicontrol\">Spatial Search Distance</span> parameter.</p><ul><li><span title=\"PLANAR\">Planar</span>—Planar distance will be used between features. This is the default.</li><li><span title=\"GEODESIC\">Geodesic</span>—Geodesic distance will be used between features. This line type takes into account the curvature of the spheroid and correctly deals with data near the dateline and poles.</li></ul></xdoc>",
        "distance_method.domain.GEODESIC": "Geodesic",
        "distance_method.domain.PLANAR": "Planar",
        "distance_method.title": "Distance Method",
        "entities_interest_ids.descr": "<xdoc><p>The entity names and start times for the entities of interest. This parameter is supported only when <span class=\"esri_uicontrol\">Entities of Interest IDs</span> is specified for the <span class=\"esri_uicontrol\">Define Entities of Interest Using</span> parameter.</p><p><ul><li>Entity ID—A unique entity name. The names are case sensitive and must be strings.</li><li>Starting From—An optional starting time to trace an entity of interest. If a time is not specified, January 1, 1970, will be used.</li></ul></p></xdoc>",
        "entities_interest_ids.dt.title1": "Entity ID",
        "entities_interest_ids.dt.title2": "Starting From",
        "entities_interest_ids.title": "Entities of Interest IDs",
        "entities_interest_layer.descr": "<xdoc><p>The layer or table that contains the entities of interest. This parameter is supported only when <span class=\"esri_uicontrol\">Selected features in a specified entity of interest layer</span> is specified for the <span class=\"esri_uicontrol\">Define Entities of Interest Using</span> parameter.</p></xdoc>",
        "entities_interest_layer.title": "Entities of Interest Layer",
        "entities_of_interest_input_type.descr": "<xdoc><p>Specifies the entities of interest.</p><ul><li><span title=\"ID_START_TIME\">Entities of Interest IDs</span>—Entity names and times will be used as the entities of interest. This is the default.</li><li><span title=\"SELECTED_FEATURE\">Selected features in a specified entity of interest layer</span>—The selected feature in a specified entity of interest layer will be used as the entities of interest.</li></ul></xdoc>",
        "entities_of_interest_input_type.domain.ID_START_TIME": "Entities of Interest IDs",
        "entities_of_interest_input_type.domain.SELECTED_FEATURE": "Selected features in a specified entity of interest layer",
        "entities_of_interest_input_type.title": "Define Entities of Interest Using",
        "entity_id_field.descr": "The text field representing unique IDs for each entity.",
        "entity_id_field.title": "Entity ID Field",
        "in_points.descr": "The time-enabled point feature class that will be used to trace proximity events.",
        "in_points.title": "Input Points",
        "include_tracks_layer.descr": "<xdoc><p>Specifies whether an output layer containing the first trace event and all subsequent features for that specified entity will be generated.</p><ul><li>Checked—An output layer containing the first trace event and all subsequent features will be generated.</li><li>Unchecked—An output layer containing the first trace event and all subsequent features will not be generated. This is the default.</li></ul></xdoc>",
        "include_tracks_layer.title": "Output Tracks",
        "max_trace_depth.descr": "The maximum degrees of separation between an entity of interest and an entity farther down the trace (downstream).",
        "max_trace_depth.title": "Maximum Trace Depth",
        "output.title": "Output Proximity Events",
        "output_name.descr": "The name of the output feature service.",
        "output_name.title": "Output Name",
        "params.category1": "Additional Outputs",
        "params.category2": "Advanced Options",
        "params.category3": "Data Store",
        "spatial_search_distance.descr": "The maximum distance between two points to be considered in proximity. Features within the spatial search distance and temporal search distance criteria are considered to be in proximity of each other.",
        "spatial_search_distance.title": "Spatial Search Distance",
        "summary": "<xdoc><p>Traces events that are near each other in space (location) and time. The time-enabled point data must include features that represent an instant in time.</p><p><note type=\"legacy\"/><p group=\"note\">The ArcGIS GeoAnalytics Server extension is being deprecated in ArcGIS Enterprise. The final release of GeoAnalytics Server was included with ArcGIS Enterprise 11.3. This geoprocessing tool is available through ArcGIS Enterprise 11.3 and earlier versions.</p></p></xdoc>",
        "temporal_search_distance.descr": "The maximum duration between two points to be considered in proximity. Features within the temporal search distance and that meet the spatial search distance criteria are considered to be in proximity of each other.",
        "temporal_search_distance.title": "Temporal Search Distance",
        "title": "Trace Proximity Events",
        "tracks_layer.title": "Output Tracks"
    }
}
