{
    "type": "FunctionTool",
    "guid": "{2F03DDCD-3D0E-422C-863C-24FDF2FCA288}/ExecuteReviewerBatchJob",
    "displayname": "$rc:title",
    "helpcontent": "47000002",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "47"
    ],
    "params": {
        "reviewer_workspace": {
            "displayname": "$rc:reviewer_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:reviewer_workspace.descr"
        },
        "session": {
            "displayname": "$rc:session.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:session.descr"
        },
        "batch_job_file": {
            "displayname": "$rc:batch_job_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "rbj"
                ]
            },
            "description": "$rc:batch_job_file.descr"
        },
        "production_workspace": {
            "type": "optional",
            "displayname": "$rc:production_workspace.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "description": "$rc:production_workspace.descr"
        },
        "analysis_area": {
            "type": "optional",
            "control_guid": "{BEDF969C-20D2-4C41-96DA-32408CA72BF6}",
            "displayname": "$rc:analysis_area.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPFeatureLayer"
                    },
                    {
                        "type": "GPExtent"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFeatureClassDomain",
                        "geometrytype": [
                            "Polygon"
                        ]
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:analysis_area.descr"
        },
        "changed_features": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:changed_features.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CHANGED_FEATURES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "ALL_FEATURES"
                    }
                ]
            },
            "description": "$rc:changed_features.descr"
        },
        "tableView": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:tableview.title",
            "datatype": {
                "type": "GPTableView"
            }
        },
        "production_workspaceversion": {
            "type": "optional",
            "displayname": "$rc:production_workspaceversion.title",
            "datatype": {
                "type": "GPString"
            },
            "depends": [
                "production_workspace"
            ],
            "description": "$rc:production_workspaceversion.descr"
        }
    },
    "environments": [
        "extent",
        "workspace"
    ]
