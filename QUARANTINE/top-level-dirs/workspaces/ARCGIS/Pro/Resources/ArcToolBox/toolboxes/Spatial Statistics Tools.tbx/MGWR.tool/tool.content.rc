        "distance_gradient.descr": "The customized Gradient Search options for individual explanatory variables. For each explanatory variable to be customized, provide the variable, the minimum search distance, and the maximum search distance in the columns.",
        "distance_gradient.dt.title1": "Explanatory Variable",
        "distance_gradient.dt.title2": "Minimum Search Distance",
