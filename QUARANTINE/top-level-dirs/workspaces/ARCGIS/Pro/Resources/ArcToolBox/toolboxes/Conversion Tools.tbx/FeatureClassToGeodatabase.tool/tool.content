{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "2040001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_Features": {
            "displayname": "$rc:input_features.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "description": "$rc:input_features.descr"
        },
        "Output_Geodatabase": {
            "displayname": "$rc:output_geodatabase.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEFeatureDataset"
                    }
                ]
            },
            "description": "$rc:output_geodatabase.descr"
        },
        "Derived_Geodatabase": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:derived_geodatabase.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEFeatureDataset"
                    }
                ]
            },
            "depends": [
                "Output_Geodatabase"
            ],
            "schema": {
                "type": "GPContainerSchema",
                "generateoutputcatalogpath": "true"
            },
            "value_datatype": {
                "type": "DEWorkspace"
            },
            "value": "tmp"
        }
    },
    "environments": [
        "MDomain",
        "MResolution",
        "MTolerance",
        "XYDomain",
        "XYResolution",
        "XYTolerance",
        "ZDomain",
        "ZResolution",
        "ZTolerance",
        "autoCommit",
