{
    "map": {
        "description": "Extracts the cells of a raster based on a set of coordinate points.",
        "extraction_area.descr": "<xdoc><p>Identifies whether to extract cells based on the specified point locations (inside) or outside the point locations (outside) .</p><ul><li><span title=\"INSIDE\">Inside</span>—The cell in which the selected point falls will be written to the output raster. All cells outside the box will receive NoData on the output raster.</li><li><span title=\"OUTSIDE\">Outside</span>—The cells outside the input points should be selected and written to the output raster.</li></ul></xdoc>",
        "extraction_area.domain.INSIDE": "Inside",
        "extraction_area.domain.OUTSIDE": "Outside",
        "extraction_area.title": "Extraction area",
        "in_raster.descr": "The input raster from which cells will be extracted.",
        "in_raster.title": "Input raster",
        "out_raster.descr": "The output raster containing the cell values extracted from the input raster.",
        "out_raster.title": "Output raster",
        "points.descr": "<xdoc><p>The points where values will be extracted from the raster.</p><p>The points are specified as x,y coordinate pairs in the same map units as the input raster.</p></xdoc>",
        "points.title": "Input points",
        "summary": "<xdoc><p>Extracts the cells of a raster based on a set of coordinate points.</p><note type=\"legacy\"/><p group=\"note\">This tool is deprecated and will be removed in a future release.</p><p group=\"note\">The Extract by Mask tool provides enhanced functionality or performance.</p></xdoc>",
        "title": "Extract by Points"
    }
}
