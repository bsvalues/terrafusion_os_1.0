            "category": "$rc:params.category2",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "key.field": [
                    "EMPTY"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:area_description_field.descr"
        },
        "title": {
            "type": "optional",
            "displayname": "$rc:title.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:title.descr"
        },
        "subtitle": {
            "type": "optional",
            "displayname": "$rc:subtitle.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "value": "Prepared By Business Analyst for ArcGIS Pro",
            "description": "$rc:subtitle.descr"
        },
        "output_files": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_files.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "DEFile"
                }
            }
        },
        "report_per_feature": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:report_per_feature.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE_REPORT_PER_FEATURE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "CREATE_SINGLE_REPORT"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:report_per_feature.descr"
        },
        "add_infographic_header": {
