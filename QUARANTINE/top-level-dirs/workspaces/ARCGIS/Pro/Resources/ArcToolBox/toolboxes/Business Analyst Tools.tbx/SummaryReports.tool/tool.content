                    "EMPTY"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:store_longitude_field.descr"
        },
        "ring_id_field": {
            "type": "optional",
            "displayname": "$rc:ring_id_field.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "key.field": [
                    "EMPTY"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:ring_id_field.descr"
