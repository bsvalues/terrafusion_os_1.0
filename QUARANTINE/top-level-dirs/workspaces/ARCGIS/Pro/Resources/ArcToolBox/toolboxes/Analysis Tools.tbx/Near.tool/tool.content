    "params": {
        "in_features": {
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "featuretype": [
                    "Simple",
                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexEdge",
                    "RasterCatalogItem"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "near_features": {
            "displayname": "$rc:near_features.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPFeatureLayer"
                }
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "featuretype": [
                    "Simple",
                    "SimpleJunction",
                    "SimpleEdge",
                    "ComplexEdge",
                    "RasterCatalogItem"
                ]
            },
            "description": "$rc:near_features.descr"
        },
        "search_radius": {
            "type": "optional",
            "displayname": "$rc:search_radius.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:search_radius.descr"
        },
        "location": {
            "type": "optional",
            "displayname": "$rc:location.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "LOCATION"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_LOCATION"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:location.descr"
        },
        "angle": {
            "type": "optional",
            "displayname": "$rc:angle.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ANGLE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_ANGLE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:angle.descr"
        },
        "out_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "depends": [
                "in_features"
            ]
        },
        "method": {
            "type": "optional",
            "displayname": "$rc:method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PLANAR",
                        "code": "$rc:method.domain.PLANAR"
                    },
                    {
                        "value": "GEODESIC",
                        "code": "$rc:method.domain.GEODESIC"
                    }
                ]
            },
            "value": "PLANAR",
            "description": "$rc:method.descr"
        },
        "field_names": {
            "type": "optional",
            "displayname": "$rc:field_names.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPString",
                        "displayname": "$rc:field_names.dt.title1"
                    },
                    {
                        "type": "GPString",
