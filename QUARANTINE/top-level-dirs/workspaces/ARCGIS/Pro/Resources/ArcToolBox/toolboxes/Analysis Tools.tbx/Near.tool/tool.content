                    },
                    {
                        "value": "NauticalMilesInt",
                        "code": "$rc:distance_unit.domain.NauticalMilesInt"
                    },
                    {
                        "value": "MilesInt",
                        "code": "$rc:distance_unit.domain.MilesInt"
                    },
                    {
                        "value": "YardsInt",
                        "code": "$rc:distance_unit.domain.YardsInt"
                    },
                    {
                        "value": "FeetInt",
                        "code": "$rc:distance_unit.domain.FeetInt"
                    },
