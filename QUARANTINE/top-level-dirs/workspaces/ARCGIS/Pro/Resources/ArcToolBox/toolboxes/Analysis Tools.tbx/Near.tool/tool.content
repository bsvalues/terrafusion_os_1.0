                            },
                            {
                                "value": "NEAR_Y",
                                "code": "$rc:field_names.domain.item1.NEAR_Y"
                            },
                            {
                                "value": "NEAR_ANGLE",
                                "code": "$rc:field_names.domain.item1.NEAR_ANGLE"
                            },
                            {
                                "value": "NEAR_FC",
                                "code": "$rc:field_names.domain.item1.NEAR_FC"
                            }
                        ]
                    }
                ]
