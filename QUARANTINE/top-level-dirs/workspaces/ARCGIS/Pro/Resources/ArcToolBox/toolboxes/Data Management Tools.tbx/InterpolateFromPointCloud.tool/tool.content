{
    "type": "FunctionTool",
    "guid": "{ef2a755c-2bcb-4c00-936e-df2e9404b1bd}",
    "displayname": "$rc:title",
    "helpcontent": "3190212",
    "description": "$rc:description",
    "product": "200",
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_container": {
            "displayname": "$rc:in_container.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEFolder"
                    },
                    {
                        "type": "DEFile"
                    },
                    {
                        "type": "DEFeatureClass"
                    },
                    {
                        "type": "GPFeatureLayer"
                    }
                ]
            },
            "domain": {
                "type": "GPBrowseFiltersDomain",
                "filters": [
                    "esri_browseDialogFilters_folders_withCloudStorage"
                ]
            },
            "description": "$rc:in_container.descr"
        },
        "out_raster": {
            "direction": "out",
            "displayname": "$rc:out_raster.title",
            "datatype": {
                "type": "DERasterDataset"
            },
            "description": "$rc:out_raster.descr"
        },
        "cell_size": {
            "displayname": "$rc:cell_size.title",
