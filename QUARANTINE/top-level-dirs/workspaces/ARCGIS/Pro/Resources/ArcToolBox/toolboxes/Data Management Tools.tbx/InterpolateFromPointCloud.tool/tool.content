                "type": "GPDouble"
            },
            "description": "$rc:cell_size.descr"
        },
        "interpolation_method": {
            "displayname": "$rc:interpolation_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TRIANGULATION",
                        "code": "$rc:interpolation_method.domain.TRIANGULATION"
                    },
                    {
                        "value": "NATURAL_NEIGHBOR",
                        "code": "$rc:interpolation_method.domain.NATURAL_NEIGHBOR"
                    },
                    {
                        "value": "IDW",
                        "code": "$rc:interpolation_method.domain.IDW"
                    }
                ]
            },
            "value": "TRIANGULATION",
            "description": "$rc:interpolation_method.descr"
        },
        "smooth_method": {
            "displayname": "$rc:smooth_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "GAUSS3x3",
                        "code": "$rc:smooth_method.domain.GAUSS3x3"
                    },
                    {
                        "value": "GAUSS5x5",
                        "code": "$rc:smooth_method.domain.GAUSS5x5"
                    },
                    {
                        "value": "GAUSS7x7",
                        "code": "$rc:smooth_method.domain.GAUSS7x7"
                    },
                    {
                        "value": "GAUSS9x9",
                        "code": "$rc:smooth_method.domain.GAUSS9x9"
                    },
                    {
                        "value": "NONE",
                        "code": "$rc:smooth_method.domain.NONE"
                    }
                ]
            },
            "value": "GAUSS5x5",
            "description": "$rc:smooth_method.descr"
        },
        "surface_type": {
            "type": "optional",
            "displayname": "$rc:surface_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DTM",
                        "code": "$rc:surface_type.domain.DTM"
                    },
                    {
                        "value": "DSM",
                        "code": "$rc:surface_type.domain.DSM"
                    }
                ]
            },
            "value": "DTM",
            "description": "$rc:surface_type.descr"
        },
        "fill_dem": {
            "type": "optional",
            "displayname": "$rc:fill_dem.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
