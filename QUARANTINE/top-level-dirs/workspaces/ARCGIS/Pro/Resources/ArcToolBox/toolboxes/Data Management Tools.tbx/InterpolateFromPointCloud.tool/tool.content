                            },
                            {
                                "value": "ReuseHighNoise",
                                "code": "$rc:options.domain.item1.ReuseHighNoise"
                            }
                        ]
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:options.descr"
