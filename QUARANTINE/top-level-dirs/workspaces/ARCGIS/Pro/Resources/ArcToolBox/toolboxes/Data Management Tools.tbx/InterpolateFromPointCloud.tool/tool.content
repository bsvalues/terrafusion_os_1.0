            "displayname": "$rc:options.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPString",
                        "displayname": "$rc:options.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:options.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
