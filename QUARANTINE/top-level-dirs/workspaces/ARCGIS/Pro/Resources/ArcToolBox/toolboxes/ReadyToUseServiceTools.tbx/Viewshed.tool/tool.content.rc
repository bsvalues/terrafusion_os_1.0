{
    "map": {
        "demresolution.descr": "<xdoc><p>Specifies the approximate spatial resolution (cell size) of the source elevation data used for the calculation.</p><p>The resolution keyword is an approximation of the spatial resolution of the digital elevation model. Many elevation sources are distributed in units of arc seconds; the keyword is an approximation in meters for easier understanding.</p><ul><li><span title=\"FINEST\">Finest</span>—The finest units available for the extent are used.</li><li><span title=\"10m\">10 meters</span>—The elevation source resolution is 1/3 arc second or approximately 10 meters.</li><li><span title=\"24m\">24 meters</span>—The elevation source is the Airbus WorldDEM4Ortho dataset at 24 meters resolution.</li><li><span title=\"30m\">30 meters</span>—The elevation source resolution is 1 arc second or approximately 30 meters.</li><li><span title=\"90m\">90 meters</span>—The elevation source resolution is 3 arc seconds or approximately 90 meters. This is the default.</li></ul></xdoc>",
        "demresolution.domain.10m": "10 meters",
        "demresolution.domain.24m": "24 meters",
        "demresolution.domain.30m": "30 meters",
        "demresolution.domain.90m": "90 meters",
        "demresolution.domain.FINEST": "Finest",
        "demresolution.title": "DEM Resolution",
        "description": "Returns polygons of visible areas for a given set of input observation points.",
        "generalizeviewshedpolygons.descr": "<xdoc><p>Specifies whether the viewshed polygons will be generalized.</p><p>The viewshed calculation is based on a raster elevation model that creates a result with stair-stepped edges. To create a more pleasing appearance and improve performance, the default behavior generalizes the polygons. This generalization will not change the accuracy of the result for any location more than one half of the DEM resolution.</p><ul><li>Checked—The viewshed polygons will be generalized. This is the default.</li><li>Unchecked—The viewshed polygons will not be generalized.</li></ul></xdoc>",
        "generalizeviewshedpolygons.title": "Generalize Viewshed Polygons",
        "inputpoints.descr": "The point features to use as the observer locations.",
        "inputpoints.title": "Input Point Features",
        "maximumdistance.descr": "The maximum distance to calculate the viewshed.",
        "maximumdistance.title": "Maximum Distance",
        "maximumdistanceunits.descr": "<xdoc><p>Specifies the units for the <span class=\"esri_uicontrol\">Maximum Distance</span> parameter.</p><ul><li><span title=\"Meters\">Meters</span>—The units are meters. This is the default.</li><li><span title=\"Kilometers\">Kilometers</span>—The units are kilometers.</li><li><span title=\"Feet\">Feet</span>—The units are feet.</li><li><span title=\"Yards\">Yards</span>—The units are yards.</li><li><span title=\"Miles\">Miles</span>—The units are miles.</li></ul></xdoc>",
        "maximumdistanceunits.domain.Feet": "Feet",
        "maximumdistanceunits.domain.Kilometers": "Kilometers",
        "maximumdistanceunits.domain.Meters": "Meters",
        "maximumdistanceunits.domain.Miles": "Miles",
        "maximumdistanceunits.domain.Yards": "Yards",
        "maximumdistanceunits.title": "Maximum Distance Units",
        "observerheight.descr": "The height above the surface of the observer. The default value of 1.75 meters is an average height of a person. If you are looking from an elevated location such as an observation tower or a tall building, use that height instead.",
        "observerheight.title": "Observer Height",
        "observerheightunits.descr": "<xdoc><p>Specifies the units for the <span class=\"esri_uicontrol\">Observer Height</span> parameter.</p><ul><li><span title=\"Meters\">Meters</span>—The units are meters. This is the default.</li><li><span title=\"Kilometers\">Kilometers</span>—The units are kilometers.</li><li><span title=\"Feet\">Feet</span>—The units are feet.</li><li><span title=\"Yards\">Yards</span>—The units are yards.</li><li><span title=\"Miles\">Miles</span>—The units are miles.</li></ul></xdoc>",
        "observerheightunits.domain.Feet": "Feet",
        "observerheightunits.domain.Kilometers": "Kilometers",
        "observerheightunits.domain.Meters": "Meters",
        "observerheightunits.domain.Miles": "Miles",
        "observerheightunits.domain.Yards": "Yards",
        "observerheightunits.title": "Observer Height Units",
        "outputviewshed.title": "Output Viewshed",
        "surfaceoffset.descr": "The height above the surface of the object you are viewing. The default value is 0. If you are viewing buildings or wind turbines, use their height.",
        "surfaceoffset.title": "Surface Offset",
        "surfaceoffsetunits.descr": "<xdoc><p>Specifies the units for the <span class=\"esri_uicontrol\">Surface Offset</span> parameter.</p><ul><li><span title=\"Meters\">Meters</span>—The units are meters. This is the default.</li><li><span title=\"Kilometers\">Kilometers</span>—The units are kilometers.</li><li><span title=\"Feet\">Feet</span>—The units are feet.</li><li><span title=\"Yards\">Yards</span>—The units are yards.</li><li><span title=\"Miles\">Miles</span>—The units are miles.</li></ul></xdoc>",
        "surfaceoffsetunits.domain.Feet": "Feet",
        "surfaceoffsetunits.domain.Kilometers": "Kilometers",
        "surfaceoffsetunits.domain.Meters": "Meters",
        "surfaceoffsetunits.domain.Miles": "Miles",
        "surfaceoffsetunits.domain.Yards": "Yards",
        "surfaceoffsetunits.title": "Surface Offset Units",
        "title": "Viewshed"
    }
}
