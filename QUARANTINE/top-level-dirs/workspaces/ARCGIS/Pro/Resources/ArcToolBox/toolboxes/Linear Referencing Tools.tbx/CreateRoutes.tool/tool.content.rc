{
    "map": {
        "build_index.descr": "<xdoc><p>Specifies whether an attribute index will be created for the route identifier field that is written to the output route feature class.</p><ul><li>Checked—An attribute index will be created. This is the default.</li><li>Unchecked—An attribute index will not be created.</li></ul></xdoc>",
        "build_index.title": "Build index",
        "coordinate_priority.descr": "<xdoc><p>The position from which measures will be accumulated for each output route. This parameter is ignored when the measure source is <span class=\"esri_uicontrol\">Values from two fields</span>.</p><ul><li><span title=\"UPPER_LEFT\">Upper left corner</span>—Measures will be accumulated from the point closest to the minimum bounding rectangle&apos;s upper left corner. This is the default.</li><li><span title=\"LOWER_LEFT\">Lower left corner</span>—Measures will be accumulated from the point closest to the minimum bounding rectangle&apos;s lower left corner.</li><li><span title=\"UPPER_RIGHT\">Upper right corner</span>—Measures will be accumulated from the point closest to the minimum bounding rectangle&apos;s upper right corner.</li><li><span title=\"LOWER_RIGHT\">Lower right corner</span>—Measures will be accumulated from the point closest to the minimum bounding rectangle&apos;s lower right corner.</li></ul></xdoc>",
        "coordinate_priority.domain.LOWER_LEFT": "Lower left corner",
        "coordinate_priority.domain.LOWER_RIGHT": "Lower right corner",
        "coordinate_priority.domain.UPPER_LEFT": "Upper left corner",
        "coordinate_priority.domain.UPPER_RIGHT": "Upper right corner",
        "coordinate_priority.title": "Coordinate Priority",
        "description": "Creates routes from existing lines. The input line features that share a common identifier are merged to create a single route.",
        "from_measure_field.descr": "<xdoc><p>A field containing measure values. This field must be numeric and is required when the measure source is <span class=\"esri_uicontrol\">Values from a single field</span> or <span class=\"esri_uicontrol\">Values from two fields</span>.</p></xdoc>",
        "from_measure_field.title": "From-Measure Field",
        "ignore_gaps.descr": "<xdoc><p>Specifies whether spatial gaps will be ignored when calculating the measures on disjointed routes. This parameter is applicable when the measure source is <span class=\"esri_uicontrol\">Length of features</span> or <span class=\"esri_uicontrol\">Values from a single field</span>.</p><ul><li>Checked—Spatial gaps will be ignored. Measure values will be continuous for disjointed routes. This is the default.</li><li>Unchecked—Spatial gaps will not be ignored. The measure values on disjointed routes will have gaps. The gap distance is calculated using the straight-line distance between the endpoints of the disjointed parts.</li></ul></xdoc>",
        "ignore_gaps.title": "Ignore spatial gaps",
        "in_line_features.descr": "The features from which routes will be created.",
        "in_line_features.title": "Input Line Features",
        "measure_factor.descr": "A value multiplied by the measure length of each input line before they are merged to create route measures. The default is 1.",
        "measure_factor.title": "Measure Factor",
        "measure_offset.descr": "A value added to the route measures after the input lines have been merged to create a route. The default is 0.",
        "measure_offset.title": "Measure Offset",
        "measure_source.descr": "<xdoc><p>Specifies how route measures will be accumulated.</p><ul><li><span title=\"LENGTH\">Length of features</span>—The geometric length of the input features will be used to accumulate the measures. This is the default.</li><li><span title=\"ONE_FIELD\">Values from a single field</span>—The value stored in a single field will be used to accumulate the measures.</li><li><span title=\"TWO_FIELDS\">Values from two fields</span>—The values stored in both the from- and to-measure fields will be used to accumulate the measures.</li></ul></xdoc>",
        "measure_source.domain.LENGTH": "Length of features",
        "measure_source.domain.ONE_FIELD": "Values from a single field",
        "measure_source.domain.TWO_FIELDS": "Values from two fields",
        "measure_source.title": "Measure Source",
        "out_feature_class.descr": "The feature class that will be created. It can be a shapefile or a geodatabase feature class.",
        "out_feature_class.title": "Output Route Feature Class",
        "route_id_field.descr": "The field containing values that uniquely identify each route. The field can be a numeric, text, or GUID field.",
        "route_id_field.title": "Route Identifier Field",
        "title": "Create Routes",
        "to_measure_field.descr": "<xdoc><p>A field containing measure values. This field must be numeric and is required when the measure source is <span class=\"esri_uicontrol\">Values from two fields</span>.</p></xdoc>",
        "to_measure_field.title": "To-Measure Field"
    }
}
