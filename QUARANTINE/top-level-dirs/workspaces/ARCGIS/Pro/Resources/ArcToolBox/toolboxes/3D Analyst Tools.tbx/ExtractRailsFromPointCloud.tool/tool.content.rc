        "class_codes.descr": "The class codes that will be used for rail points.",
        "class_codes.title": "Rail Class Codes",
        "description": "Extracts rail track lines and center lines from classified \nrailroad tracks in a LAS dataset, point cloud scene layer package, or I3S point cloud layer.",
        "horizontal_rail_tolerance.descr": "The distance that will be used in the x,y direction to identify points that belong to the same rail in a given track. The default is 10 centimeters.",
        "horizontal_rail_tolerance.title": "Horizontal Rail Tolerance",
        "horizontal_simplification_tolerance.descr": "The distance that will be used to simplify the output rail line in the x,y direction. The horizontal position of the simplified rail will not deviate from the original by more than this amount. The default is 2 millimeters.",
        "horizontal_simplification_tolerance.title": "Horizontal Simplification Tolerance",
        "horizontal_smoothing_kernel_distance.descr": "The x,y distance that will be used to apply a weighted average-based smoothing function in the horizontal direction onto the output rail lines. This parameter will help to overcome the distortions of incomplete, misclassified, or noisy rail points. The default is 0.8 meters.",
        "horizontal_smoothing_kernel_distance.title": "Horizontal Smoothing Kernel Distance",
