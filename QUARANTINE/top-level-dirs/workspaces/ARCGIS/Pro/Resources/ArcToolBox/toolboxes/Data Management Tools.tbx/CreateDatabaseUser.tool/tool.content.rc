{
    "map": {
        "description": "Creates a database user with privileges sufficient to create data in the database.",
        "input_database.descr": "The connection file to an Oracle, PostgreSQL, or SQL Server database or an enterprise geodatabase in those databases. Ensure that the connection is made as a user with privileges to create users in the database. When connecting to Oracle, you must connect as the sys user.",
        "input_database.title": "Input Database Connection",
        "out_result.title": "Database User Created",
        "role.descr": "The name of the existing database role to which the new user will be added.",
        "role.title": "Role",
        "tablespace_name.descr": "The name of the tablespace that will be used as the default tablespace for the new user in an Oracle database. You can specify a preconfigured tablespace, or, if the tablespace does not exist, it will be created in the Oracle default storage location with its size set to 400 MB. If no tablespace is provided, the user's default tablespace will be set to the Oracle default tablespace.",
        "tablespace_name.title": "Tablespace Name",
        "title": "Create Database User",
        "user_authentication_type.descr": "<xdoc><p>Specifies the authentication type for the user. Use this parameter only if an operating system login exists for which you want to create a database user. This parameter is only supported for SQL Server and Oracle databases.</p><ul><li>Checked—An operating system-authenticated user will be created. The corresponding login must already exist.</li><li>Unchecked—A database-authenticated user will be created. This is the default.</li></ul></xdoc>",
        "user_authentication_type.title": "Create Operating System Authenticated User",
        "user_name.descr": "<xdoc><p>The name of the new database user.</p><p>If you create a database user for an operating system login, the username must be the same as the login name.</p></xdoc>",
        "user_name.title": "Database User",
        "user_password.descr": "<xdoc><p>The password for the new user. The password policy of the underlying database is enforced.</p><p>If you create a database user for an operating system login, no input is required.</p></xdoc>",
        "user_password.title": "Database User Password"
    }
}
