{
    "map": {
        "angular_limit.descr": "<xdoc><p>The maximum deviation of the best fit line&apos;s interior angles that will be tolerated when using the <span class=\"esri_uicontrol\">Right Angles and Diagonals</span> (RIGHT_ANGLES_AND_DIAGONALS) method. This value should generally be kept to less than 5° to obtain best results. This parameter is disabled for other regularization methods.</p></xdoc>",
        "angular_limit.title": "Angular Deviation Limit",
        "description": "Regularizes building footprints that have common boundaries.",
        "group.descr": "The field that will be used to determine which features share coincident, non-overlapping boundaries.",
        "group.title": "Grouping Field",
        "in_features.descr": "The input features that will be processed.",
        "in_features.title": "Input Features",
        "method.descr": "<xdoc><p>The method that will be used to regularize the input features.</p><ul><li><span title=\"RIGHT_ANGLES\">Right angles</span>—Identifies the best line segments that fit the input feature vertices along 90° and 180° angles.</li><li><span title=\"RIGHT_ANGLES_AND_DIAGONALS\">Right angles and diagonals</span>—Identifies the best line segments that fit the input feature vertices along 90°, 135°, and 180° interior angles.</li><li><span title=\"ANY_ANGLES\">Any angles</span>—Identifies the best fit line that falls along any angle while reducing the overall vertex count of the input features.</li></ul></xdoc>",
        "method.domain.ANY_ANGLES": "Any angles",
        "method.domain.RIGHT_ANGLES": "Right angles",
        "method.domain.RIGHT_ANGLES_AND_DIAGONALS": "Right angles and diagonals",
        "method.title": "Method",
        "out_feature_class.descr": "The feature class that will be produced.",
        "out_feature_class.title": "Output Feature Class",
        "precision.descr": "The precision of the spatial grid that will be used in the regularization process. Valid values range from 0.05 to 0.25.",
        "precision.title": "Precision",
        "title": "Regularize Adjacent Building Footprint",
        "tolerance.descr": "The maximum distance that the regularized footprint can deviate from the boundary of its originating feature.",
        "tolerance.title": "Tolerance"
    }
}
