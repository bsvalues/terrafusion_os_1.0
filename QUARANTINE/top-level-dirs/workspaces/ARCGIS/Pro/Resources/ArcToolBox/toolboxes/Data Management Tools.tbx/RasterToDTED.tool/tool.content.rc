        "derived_folder.title": "Updated Folder",
        "description": "Splits a raster dataset into separate files based on the DTED tiling structure.",
        "dted_level.descr": "<xdoc><p>Select an appropriate level based on the resolution of your elevation data.</p><ul><li><span title=\"DTED_0\">Level 0</span>— 900 m</li><li><span title=\"DTED_1\">Level 1</span>— 90 m</li><li><span title=\"DTED_2\">Level 2</span>—30 m</li></ul></xdoc>",
        "dted_level.domain.DTED_0": "Level 0",
        "dted_level.domain.DTED_1": "Level 1",
        "dted_level.domain.DTED_2": "Level 2",
        "dted_level.title": "DTED Level",
        "in_raster.descr": "Select a single band raster dataset that represents elevation.",
        "in_raster.title": "Input Raster",
        "out_folder.descr": "Select a destination where the folder structure and DTED files will be created.",
        "out_folder.title": "Output Folder",
        "resampling_type.descr": "<xdoc><p>Choose an appropriate technique based on the type of data you have.</p><ul><li><span title=\"NEAREST\">Nearest</span>—The fastest resampling method, and it minimizes changes to pixel values. Suitable for discrete data, such as land cover.</li><li><span title=\"BILINEAR\">Bilinear</span>—Calculates the value of each pixel by averaging (weighted for distance) the values of the surrounding 4 pixels. Suitable for continuous data.</li><li><span title=\"CUBIC\">Cubic</span>—Calculates the value of each pixel by fitting a smooth curve based on the surrounding 16 pixels. Produces the smoothest image, but can create values outside of the range found in the source data. Suitable for continuous data.</li></ul></xdoc>",
        "resampling_type.domain.BILINEAR": "Bilinear",
        "resampling_type.domain.CUBIC": "Cubic",
        "resampling_type.domain.NEAREST": "Nearest",
        "resampling_type.title": "Resampling Technique",
        "title": "Raster To DTED"
    }
