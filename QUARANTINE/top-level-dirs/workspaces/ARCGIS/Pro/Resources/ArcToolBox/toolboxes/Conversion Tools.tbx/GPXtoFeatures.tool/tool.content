{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "2210001",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "Input_GPX_File": {
            "displayname": "$rc:input_gpx_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "gpx"
                ]
            },
            "description": "$rc:input_gpx_file.descr"
        },
        "Output_Feature_class": {
            "direction": "out",
            "displayname": "$rc:output_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_feature_class.descr"
        },
        "Output_Type": {
            "displayname": "$rc:output_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POINTS",
                        "code": "$rc:output_type.domain.POINTS"
                    },
                    {
                        "value": "TRACKS_AS_LINES",
                        "code": "$rc:output_type.domain.TRACKS_AS_LINES"
                    }
                ]
            },
            "value": "POINTS",
            "description": "$rc:output_type.descr"
        }
    },
    "environments": [
        "scratchWorkspace",
        "workspace"
    ]
}
