            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ALLOW"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_ALLOW"
                    }
                ]
