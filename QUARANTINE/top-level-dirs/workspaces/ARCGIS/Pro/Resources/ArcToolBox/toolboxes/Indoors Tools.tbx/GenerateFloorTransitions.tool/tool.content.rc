{
    "map": {
        "delete_existing_transitions.descr": "<xdoc><p>Specifies whether existing transition features in selected transition spaces will be deleted before creating new transition features. If this parameter is not used, the <span class=\"esri_uicontrol\">Updated Transitions</span> value will include both existing and newly created transition features.</p><ul><li>Checked—Existing transition features will be deleted. This is the default.</li><li>Unchecked—Existing transition features will not be deleted.</li></ul></xdoc>",
        "delete_existing_transitions.title": "Delete Existing Transitions",
        "description": "Creates or updates transition line features that connect floors vertically.",
        "elevator_delay.descr": "The average elevator transit time. It is one-half the time in seconds that an elevator passenger can expect to spend waiting to enter and exit the elevator. Using this parameter can improve routing and transit time calculations. The value must be equal to or greater than zero.",
        "elevator_delay.title": "Elevator Delay",
        "elevator_unit_exp.descr": "<xdoc><p>An SQL expression used to define which <span class=\"esri_uicontrol\">Transition Unit Features</span> values represent lift-based transitions, such as elevators.</p></xdoc>",
        "elevator_unit_exp.title": "Elevator Unit Expression",
        "facility_features.descr": "The input polygon features representing a facility or facilities. In the Indoors model, this is the Facilities layer. Only the facilities represented by these features will be processed.",
        "facility_features.title": "Input Facility Features",
        "pathway_features.descr": "The input polyline features representing preliminary pathways. The new transition features will snap to these polyline features. In the Indoors model, this is the PrelimPathways layer.",
        "pathway_features.title": "Pathway Features",
        "stairway_unit_exp.descr": "<xdoc><p>An SQL expression used to define which <span class=\"esri_uicontrol\">Transition Unit Features</span> values represent step-based transitions, such as stairs and escalators.</p></xdoc>",
        "stairway_unit_exp.title": "Stairway Unit Expression",
        "summary": "<xdoc><p>Creates or updates transition line features that connect floors vertically.</p><p>Selected transition unit polygons are used to generate vertical transition lines between levels in a facility. These transition features are used in conjunction with pathway features to generate a network for routing.</p></xdoc>",
        "target_transitions.descr": "An existing feature class or layer that will be updated with the new transitions. In the Indoors model, this is the PrelimTransitions layer.",
        "target_transitions.title": "Target Transitions",
        "title": "Generate Floor Transitions",
        "transition_unit_features.descr": "The input polygon features representing the transition spaces in a facility. In the Indoors model, this is the Units layer.",
        "transition_unit_features.title": "Transition Unit Features",
        "updated_transitions.title": "Updated Transitions"
    }
}
