        "service_type": {
            "display_order": "2",
            "displayname": "$rc:service_type.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ONLINE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "EXISTING"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:service_type.descr"
        },
        "output_file": {
