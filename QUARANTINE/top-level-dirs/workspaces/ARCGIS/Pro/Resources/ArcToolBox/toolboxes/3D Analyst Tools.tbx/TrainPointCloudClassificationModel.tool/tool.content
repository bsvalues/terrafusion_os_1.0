                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0.01",
                "max": "100"
            },
            "value": "100",
            "description": "$rc:epoch_iterations.descr"
        },
        "learning_rate": {
            "type": "optional",
            "display_order": "16",
            "displayname": "$rc:learning_rate.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1e-10",
                "max": "0.99999999989999999"
