            "type": "optional",
            "display_order": "13",
            "displayname": "$rc:max_epochs.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPLong"
            },
            "value": "25",
            "description": "$rc:max_epochs.descr"
        },
        "epoch_iterations": {
            "type": "optional",
            "display_order": "14",
            "displayname": "$rc:epoch_iterations.title",
            "category": "$rc:params.category2",
