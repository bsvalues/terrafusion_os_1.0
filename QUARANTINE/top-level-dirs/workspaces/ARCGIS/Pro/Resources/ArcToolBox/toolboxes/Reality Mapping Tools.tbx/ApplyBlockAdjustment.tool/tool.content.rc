{
    "map": {
        "adjust_footprints.descr": "<xdoc><p>Specifies whether the footprint geometry will be updated using the same transformation that will be applied to the image.<ul><li>Unchecked—The footprint geometry will not be updated. This is the default.</li><li>Checked—The footprint geometry will be updated. If a control point table is provided, it will also be transformed.</li></ul></p></xdoc>",
        "adjust_footprints.title": "Adjust Footprints",
        "adjust_tiepoints.descr": "<xdoc><p>Specifies whether the tie points will be updated when a solution point table is provided. This parameter is only used when the <span class=\"esri_uicontrol\">Solution Point Table</span> parameter value is provided.<ul><li>Unchecked—The tie points will not be updated. This is the default.</li><li>Checked—The tie points will be updated when a solution point table is provided.</li></ul></p></xdoc>",
        "adjust_tiepoints.title": "Adjust Tiepoints",
        "adjustment_operation.descr": "<xdoc><p>Specifies whether the mosaic dataset will be adjusted using the solution table or whether the mosaic dataset will be reset so there are no adjustments applied.</p><ul><li><span title=\"ADJUST\">Adjust the mosaic dataset</span>—The mosaic dataset will be adjusted using the input solution table.</li><li><span title=\"RESET\">Reset the mosaic dataset</span>—The mosaic dataset will be reset so there are no adjustments applied to it.</li><li><span title=\"REACTIVATE\">Reactivate image status</span>—Images dropped from the adjustment will be restored to active status.<p>Images without the minimum number of control points required for adjustment are dropped from the computation in the standard adjustment operation, such that the images are categorized as Inactive in the footprints table, the <span class=\"esri_fieldname\">maxPS</span> value is set to 0, the imagery is not visible in the map, and the tie points statuses for the dropped images are disabled. This option will restore the <span class=\"esri_fieldname\">Category</span> status to Primary and ensure the <span class=\"esri_fieldname\">maxPS</span> value is resumed. Images that were included in the adjustment process are unaffected by this option.</p></li></ul></xdoc>",
        "adjustment_operation.domain.ADJUST": "Adjust the mosaic dataset",
        "adjustment_operation.domain.REACTIVATE": "Reactivate image status",
        "adjustment_operation.domain.RESET": "Reset the mosaic dataset",
        "adjustment_operation.title": "Adjustment Operation",
        "control_point_table.descr": "The input control point table that will have the same adjustments applied as the solution table adjustments.",
        "control_point_table.title": "Control Point Table",
        "dem.descr": "<xdoc><p>The DEM that will be used in the block adjustment. This DEM will only be used if it is a higher resolution than any existing DEM in the mosaic dataset.</p><p>If this input DEM is used, the geometric function of the mosaic dataset will be updated using this input.</p></xdoc>",
        "dem.title": "Input DEM",
        "description": "Applies the geographic adjustments to the mosaic dataset items. This tool uses the solution table from the Compute Block Adjustments tool.",
        "in_mosaic_dataset.descr": "The input mosaic dataset to adjust.",
        "in_mosaic_dataset.title": "Input Mosaic Dataset",
        "input_solution_table.descr": "The solution table that will be used when adjusting the mosaic dataset. This is the output from the Compute Block Adjustments tool.",
        "input_solution_table.title": "Input Solution Table",
        "out_control_point_table.title": "Output Control Points",
        "out_mosaic_dataset.title": "Updated Input Mosaic Dataset",
        "pan_to_ms_scaling_factor.descr": "The scaling factor between the pan-sharpened resolution and the multispectral resolution that will be used if the mosaic dataset contains pan-sharpened rasters.",
        "pan_to_ms_scaling_factor.title": "Pan-To-MS Scaling Factor",
        "solution_point_table.descr": "<xdoc><p>The solution point table that will be used to update the status field for the control point table. This parameter is only used when the <span class=\"esri_uicontrol\">Control Point Table</span> parameter value is provided.</p></xdoc>",
        "solution_point_table.title": "Solution Point Table",
        "summary": "<xdoc><p>Applies the geographic adjustments to the mosaic dataset items. This tool uses the solution table from the Compute Block Adjustments tool.</p><p>This tool can also reset the geographic adjustments back to the original location.</p></xdoc>",
        "title": "Apply Block Adjustment",
        "zoffset.descr": "The vertical offset that will be used to adjust the elevation layer within the mosaic dataset's Geometric function.",
        "zoffset.title": "Z offset"
    }
