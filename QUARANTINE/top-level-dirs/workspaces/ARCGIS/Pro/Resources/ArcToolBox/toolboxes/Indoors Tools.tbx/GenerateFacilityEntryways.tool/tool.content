{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "68010006",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_level_features": {
            "display_order": "0",
            "displayname": "$rc:in_level_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_level_features.descr"
        },
        "in_unit_features": {
            "display_order": "1",
            "displayname": "$rc:in_unit_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_unit_features.descr"
        },
        "in_door_features": {
            "display_order": "3",
            "displayname": "$rc:in_door_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_door_features.descr"
        },
        "target_entryways": {
            "display_order": "4",
            "displayname": "$rc:target_entryways.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:target_entryways.descr"
        },
        "buffer_size": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:buffer_size.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "10"
            },
            "value": "0.5",
            "description": "$rc:buffer_size.descr"
        },
        "entryway_use_type": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:entryway_use_type.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "Entry",
            "description": "$rc:entryway_use_type.descr"
        },
        "exterior_unit_exp": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:exterior_unit_exp.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "in_unit_features"
            ],
            "description": "$rc:exterior_unit_exp.descr"
        },
        "delete_existing_entryways": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:delete_existing_entryways.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "DELETE_FEATURES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_DELETE_FEATURES"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:delete_existing_entryways.descr"
        },
        "updated_entryways": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_entryways.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "target_entryways"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "level_id_field": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:level_id_field.title",
            "datatype": {
                "type": "Field"
            },
            "value": "LEVEL_ID",
            "description": "$rc:level_id_field.descr"
        },
        "use_type_field": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:use_type_field.title",
            "datatype": {
                "type": "Field"
            },
            "value": "USE_TYPE",
            "description": "$rc:use_type_field.descr"
        }
    }
}
