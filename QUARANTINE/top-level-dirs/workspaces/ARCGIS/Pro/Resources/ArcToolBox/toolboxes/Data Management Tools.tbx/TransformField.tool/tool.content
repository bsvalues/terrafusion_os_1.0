{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3060020",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "in_table": {
            "display_order": "0",
            "displayname": "$rc:in_table.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPTableView"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "description": "$rc:in_table.descr"
        },
        "fields": {
            "display_order": "4",
            "displayname": "$rc:fields.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:fields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:fields.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double",
                            "BigInteger"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain"
                    }
                ]
            },
            "depends": [
                "in_table"
            ],
            "description": "$rc:fields.descr"
        },
        "method": {
            "type": "optional",
            "display_order": "1",
            "displayname": "$rc:method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INVX",
                        "code": "$rc:method.domain.INVX"
                    },
                    {
                        "value": "SQRT",
                        "code": "$rc:method.domain.SQRT"
                    },
                    {
                        "value": "LOG",
                        "code": "$rc:method.domain.LOG"
                    },
                    {
                        "value": "BOX-COX",
                        "code": "$rc:method.domain.BOX-COX"
                    },
                    {
                        "value": "INV_SQRT",
                        "code": "$rc:method.domain.INV_SQRT"
                    },
                    {
                        "value": "INV_LOG",
                        "code": "$rc:method.domain.INV_LOG"
                    },
                    {
                        "value": "INV_BOX-COX",
                        "code": "$rc:method.domain.INV_BOX-COX"
                    }
                ]
            },
            "value": "BOX-COX",
            "description": "$rc:method.descr"
        },
        "power": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:power.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:power.descr"
        },
        "shift": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:shift.title",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:shift.descr"
        },
        "updated_table": {
            "type": "derived",
            "direction": "out",
            "display_order": "5",
            "displayname": "$rc:updated_table.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPTableView"
                    },
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "depends": [
                "in_table"
            ],
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "extent"
    ]
}
