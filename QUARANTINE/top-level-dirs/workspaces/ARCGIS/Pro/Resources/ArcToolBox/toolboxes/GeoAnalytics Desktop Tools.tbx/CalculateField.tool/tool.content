{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "69000011",
    "description": "$rc:description",
    "product": "300",
    "attributes": [
        "GeoAnalyticsRuleExpression",
        "spark"
    ],
    "params": {
        "input_layer": {
            "displayname": "$rc:input_layer.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:input_layer.descr"
        },
        "output": {
            "direction": "out",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEFeatureClass"
                    },
                    {
                        "type": "DETable"
                    }
                ]
            },
            "depends": [
                "input_layer"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output.descr"
        },
        "field_to_calculate": {
            "displayname": "$rc:field_to_calculate.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "NEW_FIELD",
                        "code": "$rc:field_to_calculate.domain.NEW_FIELD"
                    },
                    {
                        "value": "EXISTING_FIELD",
                        "code": "$rc:field_to_calculate.domain.EXISTING_FIELD"
                    }
                ]
            },
            "value": "NEW_FIELD",
            "description": "$rc:field_to_calculate.descr"
        },
        "field_name": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:field_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:field_name.descr"
        },
        "existing_field": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:existing_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Float",
                    "Double",
                    "Text",
                    "Date"
                ]
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:existing_field.descr"
        },
        "field_type": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:field_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "DATE",
                        "code": "$rc:field_type.domain.DATE"
                    },
                    {
                        "value": "DOUBLE",
                        "code": "$rc:field_type.domain.DOUBLE"
                    },
                    {
                        "value": "INTEGER",
                        "code": "$rc:field_type.domain.INTEGER"
                    },
                    {
                        "value": "STRING",
                        "code": "$rc:field_type.domain.STRING"
                    }
                ]
            },
            "description": "$rc:field_type.descr"
        },
        "expression": {
            "displayname": "$rc:expression.title",
            "datatype": {
                "type": "GPCalculatorExpression"
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:expression.descr"
        },
        "track_aware": {
            "type": "optional",
            "displayname": "$rc:track_aware.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "TRACK_AWARE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NOT_TRACK_AWARE"
                    }
                ]
            },
            "description": "$rc:track_aware.descr"
        },
        "track_fields": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:track_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Float",
                    "Double",
                    "Text",
                    "Date"
                ]
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:track_fields.descr"
        },
        "time_boundary_split": {
            "type": "optional",
            "displayname": "$rc:time_boundary_split.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_boundary_split.descr"
        },
        "time_boundary_reference": {
            "type": "optional",
            "displayname": "$rc:time_boundary_reference.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_boundary_reference.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
