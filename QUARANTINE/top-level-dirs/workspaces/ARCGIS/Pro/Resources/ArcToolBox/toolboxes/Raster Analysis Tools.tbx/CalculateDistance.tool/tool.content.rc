{
    "map": {
        "allocationfield.descr": "A field on the source input that holds the values that define each source. It must be of type integer.",
        "allocationfield.title": "Allocation Field",
        "description": "Calculates the Euclidean distance from a single source or set of sources.",
        "distancemethod.descr": "<xdoc><p>Specifies whether to calculate the distance using a planar (flat earth) or a geodesic (ellipsoid) method.</p><ul><li><span title=\"Planar\">Planar</span>—The distance calculation will be performed on a projected flat plane using a 2D Cartesian coordinate system. This is the default.</li><li><span title=\"Geodesic\">Geodesic</span>—The distance calculation will be performed on the ellipsoid. Therefore, regardless of input or output projection, the results do not change.</li></ul></xdoc>",
        "distancemethod.domain.Geodesic": "Geodesic",
        "distancemethod.domain.Planar": "Planar",
        "distancemethod.title": "Distance Method",
        "inputbarrierrasterorfeatures.descr": "<xdoc><p>Dataset that defines the barriers.</p><p>The barriers can be defined by an integer or floating point raster, or a feature layer.</p></xdoc>",
        "inputbarrierrasterorfeatures.title": "Input Barrier Raster or Features",
        "inputsourcerasterorfeatures.descr": "<xdoc><p>The layer that defines the sources to calculate the distance to. The layer can be image service or feature service.</p><p>For image service, the input type can be integer or floating point.</p><p>For feature service, the input can be point, line or polygon.</p></xdoc>",
        "inputsourcerasterorfeatures.title": "Input Source Raster or Features",
        "maximumdistance.descr": "<xdoc><p>The maximum distance to calculate out to.</p><p>The unit values are <span class=\"esri_uicontrol\">Kilometers</span>, <span class=\"esri_uicontrol\">Meters</span>, <span class=\"esri_uicontrol\">Statute Miles</span>, <span class=\"esri_uicontrol\">International Yards</span>, <span class=\"esri_uicontrol\">International Feet</span>, <span class=\"esri_uicontrol\">US Survey Miles</span>, <span class=\"esri_uicontrol\">US Survey Yards</span>, and <span class=\"esri_uicontrol\">US Survey Feet</span>.</p><p>The default units are meters.</p></xdoc>",
        "maximumdistance.title": "Maximum Distance",
        "outputallocationname.descr": "The name of the output allocation raster service.",
        "outputallocationname.title": "Output Allocation Name",
        "outputallocationraster.title": "Output Allocation Raster",
        "outputbackdirectionname.descr": "The name of the output back direction raster service.",
        "outputbackdirectionname.title": "Output Back Direction Name",
        "outputbackdirectionraster.title": "Output Back Direction Raster",
        "outputcellsize.descr": "<xdoc><p>Set the cell size and units for the output raster.</p><p>The unit values are <span class=\"esri_uicontrol\">Kilometers</span>, <span class=\"esri_uicontrol\">Meters</span>, <span class=\"esri_uicontrol\">Statute Miles</span>, <span class=\"esri_uicontrol\">International Yards</span>, <span class=\"esri_uicontrol\">International Feet</span>, <span class=\"esri_uicontrol\">US Survey Miles</span>, <span class=\"esri_uicontrol\">US Survey Yards</span>, and <span class=\"esri_uicontrol\">US Survey Feet</span>.</p><p>The default units are meters.</p></xdoc>",
        "outputcellsize.title": "Output Cell Size",
        "outputdirectionname.descr": "The name of the output direction raster service.",
        "outputdirectionname.title": "Output Direction Name",
        "outputdirectionraster.title": "Output Direction Raster",
        "outputdistancename.descr": "The name of the output distance raster service.",
        "outputdistancename.title": "Output Distance Name",
        "outputdistanceraster.title": "Output Distance Raster",
        "summary": "<xdoc><p>Calculates the Euclidean distance from a single source or set of sources.</p><note type=\"legacy\"/><p group=\"note\">This tool is deprecated and will be removed in a future release.</p><p group=\"note\">The Distance Accumulation or Distance Allocation tools provide enhanced functionality or performance.</p></xdoc>",
        "title": "Calculate Distance"
    }
