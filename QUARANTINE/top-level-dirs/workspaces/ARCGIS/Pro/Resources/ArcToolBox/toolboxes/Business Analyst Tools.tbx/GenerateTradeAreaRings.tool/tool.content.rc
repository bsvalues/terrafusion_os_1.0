{
    "map": {
        "description": "Creates rings around point locations.",
        "dissolve_option.descr": "<xdoc><p>Specifies whether overlapping or nonoverlapping service areas for a single location will be used when multiple distances are specified.</p><ul><li><span title=\"OVERLAP\">Overlap</span>—Each polygon will include the area reachable from the facility up to the distance value. This is the default.</li><li><span title=\"SPLIT\">Split</span>—Each polygon will include only the area between consecutive distance values.</li></ul></xdoc>",
        "dissolve_option.domain.OVERLAP": "Overlap",
        "dissolve_option.domain.SPLIT": "Split",
        "dissolve_option.title": "Dissolve Option",
        "expression.descr": "A fields-based expression to calculate the radii.",
        "expression.title": "Distance Expression",
        "id_field.descr": "A unique ID field in the ring center layer.",
        "id_field.title": "ID Field",
        "in_features.descr": "The input features containing the center points for the rings.",
        "in_features.title": "Input Features",
        "input_method.descr": "<xdoc><p>Specifies the type of value that is to be used for each drive time.</p><ul><li><span title=\"VALUES\">Values</span>—Uses a constant value (all trade areas will be the same size). This is the default.</li><li><span title=\"EXPRESSION\">Expression</span>—The values from a field or an expression (trade areas can be a different size).</li></ul></xdoc>",
        "input_method.domain.EXPRESSION": "Expression",
        "input_method.domain.VALUES": "Values",
        "input_method.title": "Input Method",
        "out_feature_class.descr": "The feature class that will contain the output ring features.",
        "out_feature_class.title": "Output Feature Class",
        "radii.descr": "The distances, in ascending size, used to create rings around the input features.",
        "radii.title": "Distances",
        "remove_overlap.descr": "<xdoc><p>Creates overlapping concentric rings or removes overlap.</p><ul><li>Checked—Thiessen polygons are used to remove overlap between output ring polygons.</li><li>Unchecked—Output ring features are created with overlap. This is the default.</li></ul></xdoc>",
        "remove_overlap.title": "Remove Overlap",
        "title": "Generate Trade Area Rings",
        "units.descr": "The linear unit to be used with the distance values.",
        "units.title": "Distance Units"
    }
}
