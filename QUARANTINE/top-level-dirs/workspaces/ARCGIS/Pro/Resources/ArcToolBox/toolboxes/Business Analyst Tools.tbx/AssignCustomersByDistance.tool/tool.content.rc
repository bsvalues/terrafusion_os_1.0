        "params.category1": "Network Parameters",
        "search_tolerance.descr": "<xdoc><p>The maximum distance that input points can be from the network. Points located beyond the search tolerance will be excluded from processing.</p><p>The parameter requires a distance value and units for the tolerance. The default value is 5000 meters.</p></xdoc>",
        "search_tolerance.title": "Search Tolerance",
