{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\TimeSeriesClustering",
    "displayname": "$rc:title",
    "helpcontent": "50000005",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_cube": {
            "display_order": "0",
            "displayname": "$rc:in_cube.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "nc"
                ]
            },
            "description": "$rc:in_cube.descr"
        },
        "analysis_variable": {
            "display_order": "1",
            "displayname": "$rc:analysis_variable.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:analysis_variable.descr"
        },
        "output_features": {
            "direction": "out",
            "display_order": "2",
            "displayname": "$rc:output_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_features.descr"
        },
        "characteristic_of_interest": {
            "display_order": "3",
            "displayname": "$rc:characteristic_of_interest.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "VALUE",
                        "code": "$rc:characteristic_of_interest.domain.VALUE"
                    },
                    {
                        "value": "PROFILE",
                        "code": "$rc:characteristic_of_interest.domain.PROFILE"
                    },
                    {
                        "value": "PROFILE_FOURIER",
                        "code": "$rc:characteristic_of_interest.domain.PROFILE_FOURIER"
                    }
                ]
            },
            "description": "$rc:characteristic_of_interest.descr"
        },
        "cluster_count": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:cluster_count.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:cluster_count.descr"
        },
        "output_table_for_charts": {
            "type": "optional",
            "direction": "out",
            "display_order": "7",
            "displayname": "$rc:output_table_for_charts.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:output_table_for_charts.descr"
        },
        "shape_characteristic_to_ignore": {
            "enabled": "false",
            "type": "optional",
            "display_order": "4",
            "control_guid": "{38C34610-C7F7-11D5-A693-0008C711C8C1}",
            "displayname": "$rc:shape_characteristic_to_ignore.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TIME_LAG",
                        "code": "$rc:shape_characteristic_to_ignore.domain.TIME_LAG"
                    },
                    {
                        "value": "RANGE",
                        "code": "$rc:shape_characteristic_to_ignore.domain.RANGE"
                    }
                ]
            },
            "description": "$rc:shape_characteristic_to_ignore.descr"
        },
        "enable_time_series_popups": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:enable_time_series_popups.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE_POPUP"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_POPUP"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:enable_time_series_popups.descr"
        }
    },
    "environments": [
        "parallelProcessingFactor",
        "randomGenerator"
    ]
}
