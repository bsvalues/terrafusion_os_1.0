{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "51030003",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "GeoAnalyticsRuleExpression",
        "spark"
    ],
    "params": {
        "input_layer": {
            "display_order": "0",
            "displayname": "$rc:input_layer.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "featuretype": [
                    "Simple"
                ],
                "portaltype": [
                    "DataStoreCatalogLayer"
                ]
            },
            "description": "$rc:input_layer.descr"
        },
        "output_name": {
            "display_order": "1",
            "displayname": "$rc:output_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:output_name.descr"
        },
        "track_fields": {
            "display_order": "2",
            "displayname": "$rc:track_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text",
                    "Date"
                ]
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:track_fields.descr"
        },
        "method": {
            "display_order": "3",
            "displayname": "$rc:method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "GEODESIC",
                        "code": "$rc:method.domain.GEODESIC"
                    },
                    {
                        "value": "PLANAR",
                        "code": "$rc:method.domain.PLANAR"
                    }
                ]
            },
            "value": "GEODESIC",
            "description": "$rc:method.descr"
        },
        "buffer_type": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:buffer_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FIELD",
                        "code": "$rc:buffer_type.domain.FIELD"
                    },
                    {
                        "value": "EXPRESSION",
                        "code": "$rc:buffer_type.domain.EXPRESSION"
                    }
                ]
            },
            "description": "$rc:buffer_type.descr"
        },
        "buffer_field": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:buffer_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text"
                ]
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:buffer_field.descr"
        },
        "buffer_expression": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:buffer_expression.title",
            "datatype": {
                "type": "GPCalculatorExpression"
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:buffer_expression.descr"
        },
        "time_split": {
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:time_split.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_split.descr"
        },
        "summary_fields": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:summary_fields.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:summary_fields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:summary_fields.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Short",
                            "Long",
                            "Float",
                            "Double",
                            "Text",
                            "Date"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "COUNT",
                                "code": "$rc:summary_fields.domain.item2.COUNT"
                            },
                            {
                                "value": "SUM",
                                "code": "$rc:summary_fields.domain.item2.SUM"
                            },
                            {
                                "value": "MEAN",
                                "code": "$rc:summary_fields.domain.item2.MEAN"
                            },
                            {
                                "value": "MIN",
                                "code": "$rc:summary_fields.domain.item2.MIN"
                            },
                            {
                                "value": "MAX",
                                "code": "$rc:summary_fields.domain.item2.MAX"
                            },
                            {
                                "value": "STDDEV",
                                "code": "$rc:summary_fields.domain.item2.STDDEV"
                            },
                            {
                                "value": "VAR",
                                "code": "$rc:summary_fields.domain.item2.VAR"
                            },
                            {
                                "value": "RANGE",
                                "code": "$rc:summary_fields.domain.item2.RANGE"
                            },
                            {
                                "value": "ANY",
                                "code": "$rc:summary_fields.domain.item2.ANY"
                            },
                            {
                                "value": "FIRST",
                                "code": "$rc:summary_fields.domain.item2.FIRST"
                            },
                            {
                                "value": "LAST",
                                "code": "$rc:summary_fields.domain.item2.LAST"
                            }
                        ]
                    }
                ]
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:summary_fields.descr"
        },
        "output": {
            "type": "derived",
            "direction": "out",
            "display_order": "15",
            "displayname": "$rc:output.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "data_store": {
            "type": "optional",
            "display_order": "15",
            "displayname": "$rc:data_store.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SPATIOTEMPORAL_DATA_STORE",
                        "code": "$rc:data_store.domain.SPATIOTEMPORAL_DATA_STORE"
                    },
                    {
                        "value": "RELATIONAL_DATA_STORE",
                        "code": "$rc:data_store.domain.RELATIONAL_DATA_STORE"
                    }
                ]
            },
            "value": "SPATIOTEMPORAL_DATA_STORE",
            "description": "$rc:data_store.descr"
        },
        "distance_split": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:distance_split.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Yards",
                    "Miles",
                    "NauticalMiles",
                    "Meters",
                    "Kilometers",
                    "FeetInt",
                    "YardsInt",
                    "MilesInt",
                    "NauticalMilesInt"
                ]
            },
            "description": "$rc:distance_split.descr"
        },
        "time_boundary_split": {
            "type": "optional",
            "display_order": "11",
            "displayname": "$rc:time_boundary_split.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Milliseconds",
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_boundary_split.descr"
        },
        "time_boundary_reference": {
            "type": "optional",
            "display_order": "12",
            "displayname": "$rc:time_boundary_reference.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_boundary_reference.descr"
        },
        "split_expression": {
            "type": "optional",
            "display_order": "13",
            "displayname": "$rc:split_expression.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPCalculatorExpression"
            },
            "depends": [
                "input_layer"
            ],
            "description": "$rc:split_expression.descr"
        },
        "split_type": {
            "type": "optional",
            "display_order": "14",
            "displayname": "$rc:split_type.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "GAP",
                        "code": "$rc:split_type.domain.GAP"
                    },
                    {
                        "value": "FINISH_LAST",
                        "code": "$rc:split_type.domain.FINISH_LAST"
                    },
                    {
                        "value": "START_NEXT",
                        "code": "$rc:split_type.domain.START_NEXT"
                    }
                ]
            },
            "value": "GAP",
            "description": "$rc:split_type.descr"
        }
    },
    "environments": [
        "extent",
        "outputCoordinateSystem",
        "workspace"
    ]
}
