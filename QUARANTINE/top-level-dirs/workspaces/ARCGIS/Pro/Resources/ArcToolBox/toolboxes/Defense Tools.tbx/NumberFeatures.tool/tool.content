{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\NumberFeatures",
    "displayname": "$rc:title",
    "helpcontent": "74030004",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "input_data_change"
    ],
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polyline",
                    "Multipoint",
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "field_to_number": {
            "display_order": "1",
            "displayname": "$rc:field_to_number.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Text"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:field_to_number.descr"
        },
        "in_area": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:in_area.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_area.descr"
        },
        "spatial_sort_method": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:spatial_sort_method.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UR",
                        "code": "$rc:spatial_sort_method.domain.UR"
                    },
                    {
                        "value": "UL",
                        "code": "$rc:spatial_sort_method.domain.UL"
                    },
                    {
                        "value": "LR",
                        "code": "$rc:spatial_sort_method.domain.LR"
                    },
                    {
                        "value": "LL",
                        "code": "$rc:spatial_sort_method.domain.LL"
                    },
                    {
                        "value": "PEANO",
                        "code": "$rc:spatial_sort_method.domain.PEANO"
                    },
                    {
                        "value": "CENTER",
                        "code": "$rc:spatial_sort_method.domain.CENTER"
                    },
                    {
                        "value": "COUNTERCLOCKWISE",
                        "code": "$rc:spatial_sort_method.domain.COUNTERCLOCKWISE"
                    },
                    {
                        "value": "CLOCKWISE",
                        "code": "$rc:spatial_sort_method.domain.CLOCKWISE"
                    },
                    {
                        "value": "NONE",
                        "code": "$rc:spatial_sort_method.domain.NONE"
                    }
                ]
            },
            "value": "UR",
            "description": "$rc:spatial_sort_method.descr"
        },
        "new_field_type": {
            "enabled": "false",
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:new_field_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SHORT",
                        "code": "$rc:new_field_type.domain.SHORT"
                    },
                    {
                        "value": "LONG",
                        "code": "$rc:new_field_type.domain.LONG"
                    },
                    {
                        "value": "TEXT",
                        "code": "$rc:new_field_type.domain.TEXT"
                    }
                ]
            },
            "value": "LONG",
            "description": "$rc:new_field_type.descr"
        },
        "out_feature_class": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "in_features"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        },
        "starting_number": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:starting_number.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "1",
            "description": "$rc:starting_number.descr"
        },
        "increment_by": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:increment_by.title",
            "datatype": {
                "type": "GPLong"
            },
            "value": "1",
            "description": "$rc:increment_by.descr"
        },
        "center_point": {
            "enabled": "false",
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:center_point.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:center_point.descr"
        },
        "add_distance_and_bearing": {
            "enabled": "false",
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:add_distance_and_bearing.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ADD_DISTANCE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DONT_ADD_DISTANCE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:add_distance_and_bearing.descr"
        }
    },
    "environments": [
        "extent",
        "scratchWorkspace",
        "workspace"
    ]
}
