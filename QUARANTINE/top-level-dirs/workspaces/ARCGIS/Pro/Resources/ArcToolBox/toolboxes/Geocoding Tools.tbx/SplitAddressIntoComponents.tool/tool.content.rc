        "country_code.domain.USA": "United States",
        "country_code.domain.ZAF": "South Africa",
        "country_code.title": "Country or Region",
        "description": "Splits street address information into address components and creates a table or feature class with the additional components added as unique fields.",
        "in_address_data.descr": "<xdoc><p>The table or feature class containing street address information that will be split into individual address components.</p><p>Zone information, such as city, neighborhood, subregion, and postal code, is not supported.</p></xdoc>",
        "in_address_data.title": "Input Address Data",
        "in_address_fields.descr": "<xdoc><p>The field or fields in the input table or feature class that, when concatenated, will form the street address to be split. Zone information, such as city, neighborhood, subregion, and postal code, is not supported.</p><p>The order in which the fields are selected is the order the fields will be concatenated.</p></xdoc>",
        "in_address_fields.title": "Input Address Fields",
        "in_exceptions.descr": "<xdoc><p>The table that contains street parsing exceptions.</p><p>The table can be in any supported table format.</p></xdoc>",
        "in_exceptions.title": "Exceptions File",
        "out_address_data.descr": "The output feature class or table that will contain the split street address data.",
        "out_address_data.title": "Output Address Data",
        "title": "Split Address Into Components"
    }
}
