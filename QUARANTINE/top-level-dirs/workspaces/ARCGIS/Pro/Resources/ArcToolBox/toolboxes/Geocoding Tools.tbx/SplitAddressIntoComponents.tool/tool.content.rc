{
    "map": {
        "country_code.descr": "<xdoc><p>Specifies the country addressing structure that will be used to split addresses into components.</p><p>The default is the regional setting of the operating system.</p><ul><li><span title=\"AUS\">Australia</span>—The address structure of Australia will be used.</li><li><span title=\"AUT\">Austria</span>—The address structure of Austria will be used.</li><li><span title=\"BEL\">Belgium</span>—The address structure of Belgium will be used.</li><li><span title=\"CAN\">Canada</span>—The address structure of Canada will be used.</li><li><span title=\"CHE\">Switzerland</span>—The address structure of Switzerland will be used.</li><li><span title=\"CZE\">Czechia</span>—The address structure of Czechia will be used.</li><li><span title=\"DEU\">Germany</span>—The address structure of Germany will be used.</li><li><span title=\"ESP\">Spain</span>—The address structure of Spain will be used.</li><li><span title=\"EST\">Estonia</span>—The address structure of Estonia will be used.</li><li><span title=\"FRA\">France</span>—The address structure of France will be used.</li><li><span title=\"GBR\">Great Britain</span>—The address structure of Great Britain will be used.</li><li><span title=\"ISR\">Israel</span>—The address structure of Israel will be used.</li><li><span title=\"ITA\">Italy</span>—The address structure of Italy will be used.</li><li><span title=\"LTU\">Lithuania</span>—The address structure of Lithuania will be used.</li><li><span title=\"LVA\">Latvia</span>—The address structure of Latvia will be used.</li><li><span title=\"NLD\">Netherlands</span>—The address structure of Netherlands will be used.</li><li><span title=\"PRI\">Puerto Rico</span>—The address structure of Puerto Rico will be used.</li><li><span title=\"SWE\">Sweden</span>—The address structure of Sweden will be used.</li><li><span title=\"USA\">United States</span>— The address structure of United States will be used.</li><li><span title=\"ZAF\">South Africa</span>—The address structure of South Africa will be used.</li></ul></xdoc>",
        "country_code.domain.AUS": "Australia",
        "country_code.domain.AUT": "Austria",
