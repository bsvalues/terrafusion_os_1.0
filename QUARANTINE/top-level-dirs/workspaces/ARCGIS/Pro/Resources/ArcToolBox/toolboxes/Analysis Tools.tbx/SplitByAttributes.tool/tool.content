                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEFeatureDataset"
                    }
                ]
            },
            "description": "$rc:target_workspace.descr"
        },
        "Split_Fields": {
            "displayname": "$rc:split_fields.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "Field"
                }
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double",
                    "Text",
                    "Date",
                    "BigInteger",
                    "DateOnly",
                    "TimestampOffset"
                ]
            },
            "depends": [
                "Input_Table"
            ],
            "description": "$rc:split_fields.descr"
        },
        "Target_Workspace2": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:target_workspace2.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEWorkspace"
                    },
                    {
                        "type": "DEFeatureDataset"
                    }
                ]
            },
            "depends": [
                "Target_Workspace"
            ],
            "schema": {
                "type": "GPContainerSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    },
    "environments": [
        "MDomain",
        "MResolution",
        "MTolerance",
        "XYDomain",
        "XYResolution",
        "XYTolerance",
        "configKeyword",
        "extent",
        "outputCoordinateSystem",
