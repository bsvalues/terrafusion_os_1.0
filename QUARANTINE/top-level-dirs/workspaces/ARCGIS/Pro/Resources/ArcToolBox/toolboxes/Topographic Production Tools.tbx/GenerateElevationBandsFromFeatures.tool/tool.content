                "fieldtype": [
                    "Double",
                    "Long",
                    "Short"
                ]
            },
            "depends": [
                "contour_features"
            ],
            "description": "$rc:elevation_field.descr"
        },
        "area_of_interest": {
            "displayname": "$rc:area_of_interest.title",
