{
    "type": "FunctionTool",
    "guid": "{33724566-2738-4FE2-903A-A8C439127E50}/GenerateSurveyReportForTargets",
    "displayname": "$rc:title",
    "helpcontent": "62070013",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "33",
        "35"
    ],
    "params": {
        "target_profile": {
            "displayname": "$rc:target_profile.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "sgprofile"
                ]
            },
            "description": "$rc:target_profile.descr"
        },
        "target_group": {
            "displayname": "$rc:target_group.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "sgtargetgroup"
                ]
            },
            "description": "$rc:target_group.descr"
        },
        "core_target": {
            "displayname": "$rc:core_target.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:core_target.descr"
        },
        "developmental_target": {
            "displayname": "$rc:developmental_target.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:developmental_target.descr"
        },
        "report_folder": {
            "displayname": "$rc:report_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "category": "$rc:params.category1",
            "description": "$rc:report_folder.descr"
        },
        "report_type": {
            "type": "optional",
            "displayname": "$rc:report_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UNDERSTANDING_YOUR_TARGET",
                        "code": "$rc:report_type.domain.UNDERSTANDING_YOUR_TARGET"
                    },
                    {
                        "value": "DEVELOPING_MARKET_STRATEGIES",
                        "code": "$rc:report_type.domain.DEVELOPING_MARKET_STRATEGIES"
                    },
                    {
                        "value": "CUSTOM",
                        "code": "$rc:report_type.domain.CUSTOM"
                    }
                ]
            },
            "value": "CUSTOM",
            "description": "$rc:report_type.descr"
        },
        "survey_categories": {
            "type": "optional",
            "displayname": "$rc:survey_categories.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "description": "$rc:survey_categories.descr"
        },
        "report_title": {
            "type": "optional",
            "displayname": "$rc:report_title.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:report_title.descr"
        },
        "report_format": {
            "type": "optional",
            "displayname": "$rc:report_format.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "description": "$rc:report_format.descr"
        },
        "output_report": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_report.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "DEFile"
                }
            }
        }
    },
    "environments": [
        "baDataSource",
        "workspace"
    ]
}
