{
    "map": {
        "airport_control_point_feature_class.descr": "<xdoc><p>The point features containing an <span class=\"esri_uicontrol\">Airport Elevation</span> feature, displaced threshold features, or both. Values provided for the <span class=\"esri_uicontrol\">Airport Elevation</span> parameter will take precedence over these point features.</p></xdoc>",
        "airport_control_point_feature_class.title": "Input Airport Control Point Feature",
        "airport_elevation.descr": "<xdoc><p>The highest elevation on any of the runways of the airport. Provide the value in the vertical coordinate system linear units of the target feature class. If no value is provided, the highest point of the <span class=\"esri_uicontrol\">Input Runway Features</span> parameter value will be used.</p></xdoc>",
        "airport_elevation.title": "Airport Elevation",
        "custom_json_file.descr": "The import configuration, in JSON format, that will be used to create the custom OIS.",
        "custom_json_file.title": "Custom JSON File",
        "description": "Creates obstruction identification surfaces (OIS) based on the Unified Facilities Criteria (UFC) 3-260-01 that is prescribed by MIL-STD 3007. These surfaces provide planning, design, construction, sustainment, restoration, and modernization criteria for the United States Department of Defense. Surfaces are created as polygon or multipatch features.",
        "highend_clear_way_length.descr": "The length of the area at the high end of the runway. The unit of measurement is based on the input runway features.",
        "highend_clear_way_length.title": "Length of High Runway End Clearway",
        "in_flight_rule.descr": "<xdoc><p>Specifies the flight rule. These are the rules that govern the procedures for conducting flight, either instrument or under visual conditions.</p><ul><li><span title=\"INSTRUMENT\">Instrument</span>—The flight rule is instrument flight condition.</li><li><span title=\"VISUAL\">Visual</span>—The flight rule is visual flight condition.</li></ul></xdoc>",
        "in_flight_rule.domain.INSTRUMENT": "Instrument",
        "in_flight_rule.domain.VISUAL": "Visual",
        "in_flight_rule.title": "Flight Rule",
        "in_runway_class.descr": "<xdoc><p>Specifies the runway class. Runways are classified as either Class A or Class B based on aircraft type.</p><ul><li><span title=\"CLASS_A\">Class A</span>—The runway classification is Class A.</li><li><span title=\"CLASS_B\">Class B</span>—The runway classification is Class B.</li></ul></xdoc>",
        "in_runway_class.domain.CLASS_A": "Class A",
        "in_runway_class.domain.CLASS_B": "Class B",
        "in_runway_class.title": "Runway Class",
        "in_runway_features.descr": "The input runway dataset. The feature class must be z-enabled and contain polylines.",
        "in_runway_features.title": "Input Runway Features",
        "in_service_type.descr": "<xdoc><p>Specifies the type of military service.</p><ul><li><span title=\"AIRFORCE\">Air Force</span>—The service type is Air Force.</li><li><span title=\"ARMY\">Army</span>—The service type is Army.</li><li><span title=\"NAVY\">Navy</span>—The service type is Navy.</li><li><span title=\"MARINECORPS\">Marine Corps</span>—The service type is Marine Corps.</li></ul></xdoc>",
        "in_service_type.domain.AIRFORCE": "Air Force",
        "in_service_type.domain.ARMY": "Army",
        "in_service_type.domain.MARINECORPS": "Marine Corps",
        "in_service_type.domain.NAVY": "Navy",
        "in_service_type.title": "Service Type",
        "in_wing_type.descr": "<xdoc><p>Specifies the wing type of the aircraft.</p><ul><li><span title=\"FIXED\">Fixed</span>—The wing type is fixed.</li><li><span title=\"ROTARY\">Rotary</span>—The wing type is rotary.</li></ul><p>If you specify <span class=\"esri_uicontrol\">Rotary</span>, the <span class=\"esri_uicontrol\">Runway Class</span> parameter will default to the <span class=\"esri_uicontrol\">Class A</span> option without affecting the surface generation.</p></xdoc>",
        "in_wing_type.domain.FIXED": "Fixed",
        "in_wing_type.domain.ROTARY": "Rotary",
        "in_wing_type.title": "Wing Type",
        "lowend_clear_way_length.descr": "The length of the area at the low end of the runway. The unit of measurement is based on the input runway features.",
        "lowend_clear_way_length.title": "Length of Low Runway End Clearway",
        "out_ois_features.title": "Output OIS Features",
        "target_ois_features.descr": "The existing output feature class that will contain the generated UFC surfaces.",
        "target_ois_features.title": "Target OIS Features",
        "title": "Unified Facilities Criteria"
    }
}
