{
    "type": "FunctionTool",
    "guid": "{53123095-232e-403a-b127-2317d1ee5c35}",
    "displayname": "$rc:title",
    "helpcontent": "68000008",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "target_gdb": {
            "displayname": "$rc:target_gdb.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPWorkspaceDomain",
                "workspacetype": [
                    "Local Database",
                    "Remote Database"
                ]
            },
            "defaultenvironmentname": "workspace",
            "description": "$rc:target_gdb.descr"
        },
        "indoor_dataset_name": {
            "displayname": "$rc:indoor_dataset_name.title",
            "datatype": {
                "type": "GPString"
            },
            "value": "Indoor",
            "description": "$rc:indoor_dataset_name.descr"
        },
        "spatial_reference": {
            "displayname": "$rc:spatial_reference.title",
            "datatype": {
                "type": "GPSpatialReference"
            },
            "depends": [
                "indoor_dataset_name"
            ],
            "description": "$rc:spatial_reference.descr"
        },
        "output_dataset": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:output_dataset.title",
            "datatype": {
                "type": "DEFeatureDataset"
            }
        },
        "create_attribute_rules": {
            "type": "optional",
            "displayname": "$rc:create_attribute_rules.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CREATE_RULES"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_CREATE_RULES"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:create_attribute_rules.descr"
        }
    },
    "environments": [
        "configKeyword",
        "workspace"
    ]
}
