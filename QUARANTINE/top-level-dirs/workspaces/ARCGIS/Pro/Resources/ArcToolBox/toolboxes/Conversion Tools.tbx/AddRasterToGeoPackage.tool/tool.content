{
    "type": "FunctionTool",
    "guid": "{9beb0cdb-51ed-4b1e-8f20-f5b6ab560ebe}",
    "displayname": "$rc:title",
    "helpcontent": "2130001",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{29f0df2a-0bfd-49be-90cf-5e74f3aae8d5}"
    ],
    "params": {
        "in_dataset": {
            "displayname": "$rc:in_dataset.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "description": "$rc:in_dataset.descr"
        },
        "target_geopackage": {
            "displayname": "$rc:target_geopackage.title",
            "datatype": {
                "type": "DEWorkspace"
            },
            "domain": {
                "type": "GPBrowseFiltersDomain",
                "filters": [
                    "esri_browseDialogFilters_folders",
                    "esri_browseDialogFilters_sqlite"
                ]
            },
            "description": "$rc:target_geopackage.descr"
        },
        "raster_name": {
            "displayname": "$rc:raster_name.title",
            "datatype": {
                "type": "GPString"
            },
            "depends": [
                "target_geopackage"
            ],
            "description": "$rc:raster_name.descr"
        },
        "tiling_scheme": {
            "type": "optional",
            "displayname": "$rc:tiling_scheme.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TILED",
                        "code": "$rc:tiling_scheme.domain.TILED"
                    },
                    {
                        "value": "ARCGISONLINE_SCHEME",
                        "code": "$rc:tiling_scheme.domain.ARCGISONLINE_SCHEME"
                    },
                    {
                        "value": "GOOGLE_EARTH_WEB_MERCATOR",
                        "code": "$rc:tiling_scheme.domain.GOOGLE_EARTH_WEB_MERCATOR"
                    },
                    {
                        "value": "NSGPROFILE_SCALED_TRANSVERSE_MERCATOR",
                        "code": "$rc:tiling_scheme.domain.NSGPROFILE_SCALED_TRANSVERSE_MERCATOR"
                    },
                    {
                        "value": "NSGPROFILE_WGS84_GEOGRAPHIC",
                        "code": "$rc:tiling_scheme.domain.NSGPROFILE_WGS84_GEOGRAPHIC"
                    },
                    {
                        "value": "FROM_FILE",
                        "code": "$rc:tiling_scheme.domain.FROM_FILE"
                    }
                ]
            },
            "value": "TILED",
            "description": "$rc:tiling_scheme.descr"
        },
        "tiling_scheme_file": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:tiling_scheme_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xml"
                ]
            },
            "description": "$rc:tiling_scheme_file.descr"
        },
        "out_geopackage_raster": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_geopackage_raster.title",
            "datatype": {
                "type": "DERasterDataset"
            },
            "depends": [
                "target_geopackage"
            ]
        },
        "area_of_interest": {
            "type": "optional",
            "displayname": "$rc:area_of_interest.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "value_xml": "<GPFeatureRecordSetLayer xsi:type='typens:GPFeatureRecordSetLayer' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xmlns:xs='http://www.w3.org/2001/XMLSchema' xmlns:typens='http://www.esri.com/schemas/ArcGIS/3.4.0'><RecordSet xsi:type='typens:RecordSet'><Fields xsi:type='typens:Fields'><FieldArray xsi:type='typens:ArrayOfField'><Field xsi:type='typens:Field'><Name>OID</Name><Type>esriFieldTypeOID</Type><IsNullable>false</IsNullable><Length>4</Length><Precision>0</Precision><Scale>0</Scale><Required>true</Required><Editable>false</Editable></Field><Field xsi:type='typens:Field'><Name>updateGeom</Name><Type>esriFieldTypeGeometry</Type><IsNullable>true</IsNullable><Length>0</Length><Precision>0</Precision><Scale>0</Scale><GeometryDef xsi:type='typens:GeometryDef'><AvgNumPoints>0</AvgNumPoints><GeometryType>esriGeometryPolygon</GeometryType><HasM>false</HasM><HasZ>false</HasZ><SpatialReference xsi:type='typens:GeographicCoordinateSystem'><WKT>GEOGCS[&quot;GCS_WGS_1984&quot;,DATUM[&quot;D_WGS_1984&quot;,SPHEROID[&quot;WGS_1984&quot;,6378137.0,298.257223563]],PRIMEM[&quot;Greenwich&quot;,0.0],UNIT[&quot;Degree&quot;,0.0174532925199433],AUTHORITY[&quot;EPSG&quot;,4326]]</WKT><XOrigin>-400</XOrigin><YOrigin>-400</YOrigin><XYScale>999999999.99999988</XYScale><ZOrigin>-100000</ZOrigin><ZScale>10000</ZScale><MOrigin>-100000</MOrigin><MScale>10000</MScale><XYTolerance>8.983152841195215e-09</XYTolerance><ZTolerance>0.001</ZTolerance><MTolerance>0.001</MTolerance><HighPrecision>true</HighPrecision><LeftLongitude>-180</LeftLongitude><WKID>4326</WKID><LatestWKID>4326</LatestWKID></SpatialReference></GeometryDef></Field><Field xsi:type='typens:Field'><Name>updateGeom_Length</Name><Type>esriFieldTypeDouble</Type><IsNullable>true</IsNullable><Length>0</Length><Precision>0</Precision><Scale>0</Scale><Required>true</Required><Editable>false</Editable></Field><Field xsi:type='typens:Field'><Name>updateGeom_Area</Name><Type>esriFieldTypeDouble</Type><IsNullable>true</IsNullable><Length>0</Length><Precision>0</Precision><Scale>0</Scale><Required>true</Required><Editable>false</Editable></Field></FieldArray></Fields><Records xsi:type='typens:ArrayOfRecord'></Records></RecordSet><OIDFieldName>OID</OIDFieldName><ShapeFieldName>updateGeom</ShapeFieldName></GPFeatureRecordSetLayer>",
            "description": "$rc:area_of_interest.descr"
        }
    },
    "environments": [
        "compression",
        "pyramid"
    ]
}
