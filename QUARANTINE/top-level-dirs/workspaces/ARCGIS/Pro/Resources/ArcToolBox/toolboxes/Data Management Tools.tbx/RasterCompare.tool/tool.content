                        "displayname": "$rc:parameter_tolerances.dt.title2"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:parameter_tolerances.dt.title3"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "All",
                                "code": "$rc:parameter_tolerances.domain.item1.All"
                            },
                            {
                                "value": "Extent",
                                "code": "$rc:parameter_tolerances.domain.item1.Extent"
                            },
                            {
                                "value": "Pixel_Value",
                                "code": "$rc:parameter_tolerances.domain.item1.Pixel_Value"
                            },
                            {
                                "value": "Statistics_Minimum",
                                "code": "$rc:parameter_tolerances.domain.item1.Statistics_Minimum"
                            },
                            {
                                "value": "Statistics_Maximum",
                                "code": "$rc:parameter_tolerances.domain.item1.Statistics_Maximum"
                            },
                            {
                                "value": "Statistics_Mean",
                                "code": "$rc:parameter_tolerances.domain.item1.Statistics_Mean"
                            },
                            {
                                "value": "Statistics_Standard_Deviation",
                                "code": "$rc:parameter_tolerances.domain.item1.Statistics_Standard_Deviation"
                            }
                        ]
                    },
                    {
                        "type": "GPNumericDomain",
                        "allowempty": "false"
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "Fraction",
                                "code": "$rc:parameter_tolerances.domain.item3.Fraction"
                            },
                            {
                                "value": "Value",
                                "code": "$rc:parameter_tolerances.domain.item3.Value"
                            }
                        ]
                    }
                ]
            },
            "description": "$rc:parameter_tolerances.descr"
        },
        "attribute_tolerances": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:attribute_tolerances.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
