        },
        "compare_status": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:compare_status.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "NO_DIFFERENCES_FOUND"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "DIFFERENCES_FOUND"
                    }
                ]
