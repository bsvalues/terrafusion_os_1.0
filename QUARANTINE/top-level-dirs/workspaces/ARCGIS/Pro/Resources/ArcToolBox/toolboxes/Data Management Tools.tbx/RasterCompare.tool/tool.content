                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "description": "$rc:in_base_raster.descr"
        },
        "in_test_raster": {
            "display_order": "1",
            "displayname": "$rc:in_test_raster.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPRasterLayer"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "description": "$rc:in_test_raster.descr"
        },
        "compare_type": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:compare_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "RASTER_DATASET",
                        "code": "$rc:compare_type.domain.RASTER_DATASET"
                    },
                    {
                        "value": "GDB_RASTER_DATASET",
                        "code": "$rc:compare_type.domain.GDB_RASTER_DATASET"
                    },
                    {
                        "value": "MOSAIC_DATASET",
                        "code": "$rc:compare_type.domain.MOSAIC_DATASET"
                    }
                ]
            },
            "value": "RASTER_DATASET",
            "description": "$rc:compare_type.descr"
        },
        "ignore_option": {
            "type": "optional",
            "display_order": "3",
            "control_guid": "{38C34610-C7F7-11D5-A693-0008C711C8C1}",
            "displayname": "$rc:ignore_option.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:ignore_option.descr"
        },
        "continue_compare": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:continue_compare.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CONTINUE_COMPARE"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_CONTINUE_COMPARE"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:continue_compare.descr"
        },
        "out_compare_file": {
            "type": "optional",
            "direction": "out",
            "display_order": "8",
            "displayname": "$rc:out_compare_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "txt",
                    "csv"
                ]
            },
            "description": "$rc:out_compare_file.descr"
        },
        "parameter_tolerances": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:parameter_tolerances.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "GPString",
                        "displayname": "$rc:parameter_tolerances.dt.title1"
                    },
                    {
