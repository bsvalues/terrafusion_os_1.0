{
    "map": {
        "description": "Refines the interior orientation for each image in the mosaic dataset by constructing an affine transformation from a fiducial table.",
        "fiducial_table.descr": "The fiducial table created using the Compute Fiducials tool.",
        "fiducial_table.title": "Fiducial Table",
        "film_coordinate_system.descr": "<xdoc><p>Defines the film coordinate system of the scanned aerial photograph. It is used in computing fiducial information and affine transformation construction.</p><ul><li><span title=\"NO_CHANGE\">No change</span>—Maintain the coordinate system of the mosaic dataset. Do not change the film coordinate system of the scanned aerial photograph. Maintain the coordinate system of the mosaic dataset.</li><li><span title=\"X_RIGHT_Y_UP\">X right, Y up</span>—The origin of the scanned photo&apos;s coordinate system is the center, and positive X points right and positive Y points up.</li><li><span title=\"X_UP_Y_LEFT\">X up, Y left</span>—The origin of the scanned photo&apos;s coordinate system is the center, and positive X points up and positive Y points left.</li><li><span title=\"X_LEFT_Y_DOWN\">X left, Y down</span>—The origin of the scanned photo&apos;s coordinate system is the center, and positive X points left and positive Y points down.</li><li><span title=\"X_DOWN_Y_RIGHT\">X down, Y right</span>—The origin of the scanned photo&apos;s coordinate system is the center, and positive X points down and positive Y points right.</li></ul></xdoc>",
        "film_coordinate_system.domain.NO_CHANGE": "No change",
        "film_coordinate_system.domain.X_DOWN_Y_RIGHT": "X down, Y right",
        "film_coordinate_system.domain.X_LEFT_Y_DOWN": "X left, Y down",
        "film_coordinate_system.domain.X_RIGHT_Y_UP": "X right, Y up",
        "film_coordinate_system.domain.X_UP_Y_LEFT": "X up, Y left",
        "film_coordinate_system.title": "Film Coordinate System",
        "in_mosaic_dataset.descr": "The mosaic dataset that is created from scanned aerial photos using the scanned raster type or frame camera raster type.",
        "in_mosaic_dataset.title": "Input Mosaic Dataset",
        "out_mosaic_dataset.title": "Output Mosaic Dataset",
        "title": "Update Interior Orientation",
        "update_footprints.descr": "<xdoc><p>Generates or updates the footprints of the digital photos in the mosaic dataset.</p><ul><li>Checked—The footprints will be generated or updated.</li><li>Unchecked—The footprints will not be generated or updated. This is the default</li></ul></xdoc>",
