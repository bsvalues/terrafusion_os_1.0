{
    "map": {
        "description": "Adds the fields POINT_X and POINT_Y to the point input features and calculates their values. It also appends the POINT_Z and POINT_M fields if the input features are Z- and M-enabled.",
        "in_features.descr": "<xdoc><p>The point features whose x,y coordinates will be appended as <span class=\"esri_fieldname\">POINT_X</span> and <span class=\"esri_fieldname\">POINT_Y</span> fields.</p></xdoc>",
        "in_features.title": "Input Features",
        "out_features.title": "Updated Input Features",
        "summary": "<xdoc><p>Adds the fields <span class=\"esri_fieldname\">POINT_X</span> and <span class=\"esri_fieldname\">POINT_Y</span> to the point input features and calculates their values. It also appends the <span class=\"esri_fieldname\">POINT_Z</span> and <span class=\"esri_fieldname\">POINT_M</span> fields if the input features are Z- and M-enabled.</p></xdoc>",
        "title": "Add XY Coordinates"
    }
