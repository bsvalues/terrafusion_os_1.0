{
    "type": "FunctionTool",
    "guid": "{F6243FE3-8552-4511-BBCE-F882B7099A58}/AnalyzeLASRunwayObstacles",
    "displayname": "$rc:title",
    "helpcontent": "64020001",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "53",
        "70"
    ],
    "params": {
        "in_ois_features": {
            "display_order": "0",
            "displayname": "$rc:in_ois_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "MultiPatch"
                ]
            },
            "description": "$rc:in_ois_features.descr"
        },
        "in_las_obstacles": {
            "display_order": "1",
            "displayname": "$rc:in_las_obstacles.title",
            "datatype": {
                "type": "GPLasDatasetLayer"
            },
            "description": "$rc:in_las_obstacles.descr"
        },
        "out_obstacle_feature_class": {
            "type": "optional",
            "direction": "out",
            "display_order": "4",
            "displayname": "$rc:out_obstacle_feature_class.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFeatureClassDomain",
                        "geometrytype": [
                            "Point"
                        ]
                    }
                ]
            },
            "description": "$rc:out_obstacle_feature_class.descr"
        },
        "target_folder": {
            "type": "optional",
            "direction": "out",
            "display_order": "5",
            "displayname": "$rc:target_folder.title",
            "datatype": {
                "type": "DEFolder"
            },
            "description": "$rc:target_folder.descr"
        },
        "out_las_obstacles": {
            "enabled": "false",
            "type": "optional",
            "direction": "out",
            "display_order": "6",
            "displayname": "$rc:out_las_obstacles.title",
            "datatype": {
                "type": "GPLasDatasetLayer"
            },
            "description": "$rc:out_las_obstacles.descr"
        },
        "vertical_clearance": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:vertical_clearance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "value": "0",
            "description": "$rc:vertical_clearance.descr"
        },
        "vertical_clearance_unit": {
            "enabled": "false",
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:vertical_clearance_unit.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:vertical_clearance_unit.domain.KILOMETERS"
                    },
                    {
                        "value": "METERS",
                        "code": "$rc:vertical_clearance_unit.domain.METERS"
                    },
                    {
                        "value": "DECIMETERS",
                        "code": "$rc:vertical_clearance_unit.domain.DECIMETERS"
                    },
                    {
                        "value": "CENTIMETERS",
                        "code": "$rc:vertical_clearance_unit.domain.CENTIMETERS"
                    },
                    {
                        "value": "MILLIMETERS",
                        "code": "$rc:vertical_clearance_unit.domain.MILLIMETERS"
                    },
                    {
                        "value": "NAUTICAL_MILES",
                        "code": "$rc:vertical_clearance_unit.domain.NAUTICAL_MILES"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:vertical_clearance_unit.domain.MILES"
                    },
                    {
                        "value": "YARDS",
                        "code": "$rc:vertical_clearance_unit.domain.YARDS"
                    },
                    {
                        "value": "FEET",
                        "code": "$rc:vertical_clearance_unit.domain.FEET"
                    },
                    {
                        "value": "INCHES",
                        "code": "$rc:vertical_clearance_unit.domain.INCHES"
                    },
                    {
                        "value": "DECIMAL_DEGREES",
                        "code": "$rc:vertical_clearance_unit.domain.DECIMAL_DEGREES"
                    },
                    {
                        "value": "POINTS",
                        "code": "$rc:vertical_clearance_unit.domain.POINTS"
                    },
                    {
                        "value": "UNKNOWN",
                        "code": "$rc:vertical_clearance_unit.domain.UNKNOWN"
                    }
                ]
            },
            "value": "METERS",
            "description": "$rc:vertical_clearance_unit.descr"
        }
    },
    "environments": [
        "workspace"
    ]
}
