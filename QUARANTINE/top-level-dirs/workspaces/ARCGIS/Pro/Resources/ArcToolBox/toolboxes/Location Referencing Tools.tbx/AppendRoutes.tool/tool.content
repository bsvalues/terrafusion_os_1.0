            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "ADD",
                        "code": "$rc:load_type.domain.ADD"
                    },
                    {
                        "value": "RETIRE_BY_ROUTE_ID",
