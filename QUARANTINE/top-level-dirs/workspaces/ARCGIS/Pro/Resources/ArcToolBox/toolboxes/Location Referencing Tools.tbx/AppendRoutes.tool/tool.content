            "type": "optional",
            "displayname": "$rc:consider_existing_centerlines.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "CONSIDER"
                    },
                    {
                        "type": "GPBoolean",
