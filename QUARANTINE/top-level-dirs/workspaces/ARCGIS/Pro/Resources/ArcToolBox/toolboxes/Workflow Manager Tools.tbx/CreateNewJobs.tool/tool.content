{
    "type": "FunctionTool",
    "guid": "{33CA4A60-4D2E-4583-8844-3D0A75F6D305}/CreateNewJobs",
    "displayname": "$rc:title",
    "helpcontent": "35020002",
    "description": "$rc:description",
    "product": "200",
    "extensions": [
        "40"
    ],
    "params": {
        "Input_DatabasePath": {
            "displayname": "$rc:input_databasepath.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "jtc"
                ]
            },
            "description": "$rc:input_databasepath.descr"
        },
        "Job_Type": {
            "displayname": "$rc:job_type.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:job_type.descr"
        },
        "Number_of_Jobs": {
            "displayname": "$rc:number_of_jobs.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:number_of_jobs.descr"
        },
        "Assignment_Type": {
            "type": "optional",
            "displayname": "$rc:assignment_type.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:assignment_type.descr"
        },
        "Assign_To": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:assign_to.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:assign_to.descr"
        },
        "Priority": {
            "type": "optional",
            "displayname": "$rc:priority.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:priority.descr"
        },
        "Feature_Layer_LOI": {
            "type": "optional",
            "control_guid": "{60061247-BCA8-473E-A7AF-A2026DDE1C2D}",
            "displayname": "$rc:feature_layer_loi.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Multipoint",
                    "Point"
                ]
            },
            "description": "$rc:feature_layer_loi.descr"
        },
        "Union": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:union.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "UNION"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_UNION"
                    }
                ]
            },
            "depends": [
                "Feature_Layer_LOI"
            ],
            "description": "$rc:union.descr"
        },
        "Job_ID": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:job_id.title",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            }
        }
    }
}
