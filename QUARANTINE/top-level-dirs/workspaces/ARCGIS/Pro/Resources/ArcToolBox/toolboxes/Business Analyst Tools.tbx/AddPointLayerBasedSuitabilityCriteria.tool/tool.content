{
    "type": "FunctionTool",
    "guid": "{33724566-2738-4FE2-903A-A8C439127E50}/AddPointLayerBasedSuitabilityCriteria",
    "displayname": "$rc:title",
    "helpcontent": "62050002",
    "description": "$rc:description",
    "product": "100",
    "extensions": [
        "33",
        "35"
    ],
    "params": {
        "in_analysis_layer": {
            "displayname": "$rc:in_analysis_layer.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPFeatureLayer"
                    },
                    {
                        "type": "GPGroupLayer"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFeatureClassDomain",
                        "geometrytype": [
                            "Polygon"
                        ]
                    },
                    {
                        "type": "null"
                    }
                ]
            },
            "description": "$rc:in_analysis_layer.descr"
        },
        "site_layer_id_field": {
            "displayname": "$rc:site_layer_id_field.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "depends": [
                "in_analysis_layer"
            ],
            "description": "$rc:site_layer_id_field.descr"
        },
        "in_point_features": {
            "displayname": "$rc:in_point_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ]
            },
            "description": "$rc:in_point_features.descr"
        },
        "criteria_type": {
            "displayname": "$rc:criteria_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "COUNT",
                        "code": "$rc:criteria_type.domain.COUNT"
                    },
                    {
                        "value": "WEIGHT",
                        "code": "$rc:criteria_type.domain.WEIGHT"
                    },
                    {
                        "value": "MINIMAL_DISTANCE",
                        "code": "$rc:criteria_type.domain.MINIMAL_DISTANCE"
                    }
                ]
            },
            "value": "COUNT",
            "description": "$rc:criteria_type.descr"
        },
        "distance_type": {
            "type": "optional",
            "displayname": "$rc:distance_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:distance_type.descr"
        },
        "units": {
            "type": "optional",
            "displayname": "$rc:units.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:units.descr"
        },
        "in_site_centers_features": {
            "type": "optional",
            "displayname": "$rc:in_site_centers_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ]
            },
            "description": "$rc:in_site_centers_features.descr"
        },
        "site_centers_id_field": {
            "type": "optional",
            "displayname": "$rc:site_centers_id_field.title",
            "datatype": {
                "type": "Field"
            },
            "depends": [
                "in_site_centers_features"
            ],
            "description": "$rc:site_centers_id_field.descr"
        },
        "weight_field": {
            "displayname": "$rc:weight_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Double",
                    "Float",
                    "Long",
                    "BigInteger",
                    "Short"
                ]
            },
            "depends": [
                "in_point_features"
            ],
            "description": "$rc:weight_field.descr"
        },
        "statistics_type": {
            "type": "optional",
            "displayname": "$rc:statistics_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SUM",
                        "code": "$rc:statistics_type.domain.SUM"
                    },
                    {
                        "value": "AVE",
                        "code": "$rc:statistics_type.domain.AVE"
                    },
                    {
                        "value": "STD_DEV",
                        "code": "$rc:statistics_type.domain.STD_DEV"
                    },
                    {
                        "value": "MIN",
                        "code": "$rc:statistics_type.domain.MIN"
                    },
                    {
                        "value": "MAX",
                        "code": "$rc:statistics_type.domain.MAX"
                    }
                ]
            },
            "description": "$rc:statistics_type.descr"
        },
        "out_analysis_layer": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_analysis_layer.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPFeatureLayer"
                    },
                    {
                        "type": "GPGroupLayer"
                    }
                ]
            },
            "depends": [
                "in_analysis_layer"
            ]
        },
        "out_criteria_name": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_criteria_name.title",
            "datatype": {
                "type": "GPString"
            },
            "depends": [
                "criteria_type"
            ]
        },
        "cutoff_distance": {
            "type": "optional",
            "displayname": "$rc:cutoff_distance.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPNumericDomain",
                "allowempty": "true",
                "low": {
                    "inclusive": "true",
                    "val": "0"
                }
            },
            "description": "$rc:cutoff_distance.descr"
        }
    },
    "environments": [
        "baDataSource",
        "baNetworkSource",
        "workspace"
    ]
}
