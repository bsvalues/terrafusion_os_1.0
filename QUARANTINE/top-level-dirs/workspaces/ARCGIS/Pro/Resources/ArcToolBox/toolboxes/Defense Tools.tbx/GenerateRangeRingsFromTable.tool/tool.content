{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\GenerateRangeRingsFromTable",
    "displayname": "$rc:title",
    "helpcontent": "74010002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "in_table": {
            "display_order": "1",
            "displayname": "$rc:in_table.title",
            "datatype": {
                "type": "DETable"
            },
            "description": "$rc:in_table.descr"
        },
        "out_feature_class_rings": {
            "direction": "out",
            "display_order": "6",
            "displayname": "$rc:out_feature_class_rings.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "symbologylayer": "MT_RangeRings.lyrx",
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class_rings.descr"
        },
        "lookup_name": {
            "display_order": "2",
            "displayname": "$rc:lookup_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:lookup_name.descr"
        },
        "range_rings_type": {
            "display_order": "3",
            "displayname": "$rc:range_rings_type.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "INTERVAL",
                        "code": "$rc:range_rings_type.domain.INTERVAL"
                    },
                    {
                        "value": "MIN_MAX",
                        "code": "$rc:range_rings_type.domain.MIN_MAX"
                    }
                ]
            },
            "value": "INTERVAL",
            "description": "$rc:range_rings_type.descr"
        },
        "out_feature_class_radials": {
            "type": "optional",
            "direction": "out",
            "display_order": "7",
            "displayname": "$rc:out_feature_class_radials.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "symbologylayer": "MT_RangeRadials.lyrx",
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_feature_class_radials.descr"
        },
        "number_of_radials": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:number_of_radials.title",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:number_of_radials.descr"
        },
        "distance_units": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:distance_units.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "METERS",
                        "code": "$rc:distance_units.domain.METERS"
                    },
                    {
                        "value": "KILOMETERS",
                        "code": "$rc:distance_units.domain.KILOMETERS"
                    },
                    {
                        "value": "MILES",
                        "code": "$rc:distance_units.domain.MILES"
                    },
                    {
                        "value": "NAUTICAL_MILES",
                        "code": "$rc:distance_units.domain.NAUTICAL_MILES"
                    },
                    {
                        "value": "FEET",
                        "code": "$rc:distance_units.domain.FEET"
                    },
                    {
                        "value": "US_SURVEY_FEET",
                        "code": "$rc:distance_units.domain.US_SURVEY_FEET"
                    }
                ]
            },
            "value": "METERS",
            "description": "$rc:distance_units.descr"
        },
        "lookup_name_field": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:lookup_name_field.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Text"
                ]
            },
            "depends": [
                "in_table"
            ],
            "value": "Name",
            "description": "$rc:lookup_name_field.descr"
        },
        "min_range_field": {
            "enabled": "false",
