        },
        "number_of_rings_field": {
            "type": "optional",
            "display_order": "11",
            "displayname": "$rc:number_of_rings_field.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Long",
                    "Short"
                ]
            },
            "depends": [
                "in_table"
