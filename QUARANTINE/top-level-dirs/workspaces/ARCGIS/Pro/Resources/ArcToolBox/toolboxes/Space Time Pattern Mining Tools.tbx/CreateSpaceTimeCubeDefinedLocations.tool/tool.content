{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\CreateSpaceTimeCubeDefinedLocations",
    "displayname": "$rc:title",
    "helpcontent": "50000004",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_features": {
            "display_order": "0",
            "displayname": "$rc:in_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon",
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_features.descr"
        },
        "output_cube": {
            "direction": "out",
            "display_order": "1",
            "displayname": "$rc:output_cube.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "nc"
                ]
            },
            "description": "$rc:output_cube.descr"
        },
        "location_id": {
            "display_order": "2",
            "displayname": "$rc:location_id.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Text"
                ]
            },
            "depends": [
                "in_features"
            ],
            "description": "$rc:location_id.descr"
        },
        "temporal_aggregation": {
            "display_order": "5",
            "displayname": "$rc:temporal_aggregation.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "APPLY_TEMPORAL_AGGREGATION"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_TEMPORAL_AGGREGATION"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:temporal_aggregation.descr"
        },
        "time_field": {
            "display_order": "6",
            "displayname": "$rc:time_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Date",
                    "DateOnly",
                    "TimestampOffset"
                ]
            },
            "description": "$rc:time_field.descr"
        },
        "time_step_interval": {
            "display_order": "7",
            "displayname": "$rc:time_step_interval.title",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days",
                    "Weeks",
                    "Months",
                    "Years"
                ]
            },
            "description": "$rc:time_step_interval.descr"
        },
        "time_step_alignment": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:time_step_alignment.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "END_TIME",
                        "code": "$rc:time_step_alignment.domain.END_TIME"
                    },
                    {
                        "value": "START_TIME",
                        "code": "$rc:time_step_alignment.domain.START_TIME"
                    },
                    {
                        "value": "REFERENCE_TIME",
                        "code": "$rc:time_step_alignment.domain.REFERENCE_TIME"
                    }
                ]
            },
            "value": "END_TIME",
            "description": "$rc:time_step_alignment.descr"
        },
        "reference_time": {
            "enabled": "false",
            "type": "optional",
            "display_order": "9",
            "displayname": "$rc:reference_time.title",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:reference_time.descr"
        },
        "variables": {
            "enabled": "false",
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:variables.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:variables.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:variables.dt.title2"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Double",
                            "Float",
                            "Short",
                            "Long"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "DROP_LOCATIONS",
                                "code": "$rc:variables.domain.item2.DROP_LOCATIONS"
                            },
                            {
                                "value": "ZEROS",
                                "code": "$rc:variables.domain.item2.ZEROS"
                            },
                            {
                                "value": "SPATIAL_NEIGHBORS",
                                "code": "$rc:variables.domain.item2.SPATIAL_NEIGHBORS"
                            },
                            {
                                "value": "SPACE_TIME_NEIGHBORS",
                                "code": "$rc:variables.domain.item2.SPACE_TIME_NEIGHBORS"
                            },
                            {
                                "value": "TEMPORAL_TREND",
                                "code": "$rc:variables.domain.item2.TEMPORAL_TREND"
                            }
                        ]
                    }
                ]
            },
            "description": "$rc:variables.descr"
        },
        "summary_fields": {
            "enabled": "false",
            "type": "optional",
            "display_order": "11",
            "displayname": "$rc:summary_fields.title",
            "datatype": {
                "type": "GPValueTable",
                "datatypes": [
                    {
                        "type": "Field",
                        "displayname": "$rc:summary_fields.dt.title1"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:summary_fields.dt.title2"
                    },
                    {
                        "type": "GPString",
                        "displayname": "$rc:summary_fields.dt.title3"
                    }
                ]
            },
            "domain": {
                "type": "GPCompositeDomain",
                "items": [
                    {
                        "type": "GPFieldDomain",
                        "fieldtype": [
                            "Double",
                            "Float",
                            "Short",
                            "Long"
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "SUM",
                                "code": "$rc:summary_fields.domain.item2.SUM"
                            },
                            {
                                "value": "MEAN",
                                "code": "$rc:summary_fields.domain.item2.MEAN"
                            },
                            {
                                "value": "MIN",
                                "code": "$rc:summary_fields.domain.item2.MIN"
                            },
                            {
                                "value": "MAX",
                                "code": "$rc:summary_fields.domain.item2.MAX"
                            },
                            {
                                "value": "STD",
                                "code": "$rc:summary_fields.domain.item2.STD"
                            },
                            {
                                "value": "MEDIAN",
                                "code": "$rc:summary_fields.domain.item2.MEDIAN"
                            }
                        ]
                    },
                    {
                        "type": "GPCodedValueDomain",
                        "items": [
                            {
                                "value": "DROP_LOCATIONS",
                                "code": "$rc:summary_fields.domain.item3.DROP_LOCATIONS"
                            },
                            {
                                "value": "ZEROS",
                                "code": "$rc:summary_fields.domain.item3.ZEROS"
                            },
                            {
                                "value": "SPATIAL_NEIGHBORS",
                                "code": "$rc:summary_fields.domain.item3.SPATIAL_NEIGHBORS"
                            },
                            {
                                "value": "SPACE_TIME_NEIGHBORS",
                                "code": "$rc:summary_fields.domain.item3.SPACE_TIME_NEIGHBORS"
                            },
                            {
                                "value": "TEMPORAL_TREND",
                                "code": "$rc:summary_fields.domain.item3.TEMPORAL_TREND"
                            }
                        ]
                    }
                ]
            },
            "description": "$rc:summary_fields.descr"
        },
        "in_related_table": {
            "type": "optional",
            "display_order": "3",
            "displayname": "$rc:in_related_table.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:in_related_table.descr"
        },
        "related_location_id": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:related_location_id.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger",
                    "Text"
                ]
            },
            "depends": [
                "in_related_table"
            ],
            "description": "$rc:related_location_id.descr"
        }
    },
    "environments": [
        "geographicTransformations",
        "outputCoordinateSystem",
        "parallelProcessingFactor",
        "scratchWorkspace",
        "workspace"
    ]
