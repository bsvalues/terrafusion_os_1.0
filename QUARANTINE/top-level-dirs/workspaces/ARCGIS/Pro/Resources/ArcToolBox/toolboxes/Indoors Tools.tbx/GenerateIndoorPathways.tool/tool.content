{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "68000003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_level_features": {
            "display_order": "0",
            "displayname": "$rc:in_level_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_level_features.descr"
        },
        "in_detail_features": {
            "display_order": "1",
            "displayname": "$rc:in_detail_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:in_detail_features.descr"
        },
        "target_pathways": {
            "display_order": "3",
            "displayname": "$rc:target_pathways.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:target_pathways.descr"
        },
        "lattice_rotation": {
            "type": "optional",
            "display_order": "4",
            "displayname": "$rc:lattice_rotation.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0",
                "max": "180"
            },
            "description": "$rc:lattice_rotation.descr"
        },
        "lattice_density": {
            "type": "optional",
            "display_order": "5",
            "displayname": "$rc:lattice_density.title",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0.25",
                "max": "2.8999999999999999"
            },
            "value": "0.6",
            "description": "$rc:lattice_density.descr"
        },
        "restricted_unit_features": {
            "type": "optional",
            "display_order": "6",
            "displayname": "$rc:restricted_unit_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:restricted_unit_features.descr"
        },
        "restricted_unit_exp": {
            "type": "optional",
            "display_order": "7",
            "displayname": "$rc:restricted_unit_exp.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "restricted_unit_features"
            ],
            "description": "$rc:restricted_unit_exp.descr"
        },
        "detail_exp": {
            "type": "optional",
            "display_order": "2",
            "displayname": "$rc:detail_exp.title",
            "datatype": {
                "type": "GPSQLExpression"
            },
            "depends": [
                "in_detail_features"
            ],
            "description": "$rc:detail_exp.descr"
        },
        "updated_pathways": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:updated_pathways.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "depends": [
                "target_pathways"
            ],
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            }
        }
    }
}
