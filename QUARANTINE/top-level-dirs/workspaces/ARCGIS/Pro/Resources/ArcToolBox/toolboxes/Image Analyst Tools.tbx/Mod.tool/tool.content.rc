{
    "map": {
        "description": "Finds the remainder (modulo) of the first raster when divided by the second raster on a cell-by-cell basis.",
        "in_raster_or_constant1.descr": "<xdoc><p>The numerator input.</p><p>A number can be used as an input for this parameter, provided a raster is specified for the other parameter. To specify a number for both inputs, the cell size and extent must first be set in the environment.</p></xdoc>",
        "in_raster_or_constant1.title": "Input raster or constant value 1",
        "in_raster_or_constant2.descr": "<xdoc><p>The denominator input.</p><p>A number can be used as an input for this parameter, provided a raster is specified for the other parameter. To specify a number for both inputs, the cell size and extent must first be set in the environment.</p></xdoc>",
        "in_raster_or_constant2.title": "Input raster or constant value 2",
        "out_raster.descr": "<xdoc><p>The output raster.</p><p>The cell values are the remainder of the division of the values in the first input by the second input.</p></xdoc>",
        "out_raster.title": "Output raster",
        "title": "Mod"
    }
}
