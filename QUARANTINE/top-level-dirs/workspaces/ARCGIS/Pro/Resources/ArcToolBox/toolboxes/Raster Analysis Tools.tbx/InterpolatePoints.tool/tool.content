{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\InterpolatePoints",
    "displayname": "$rc:title",
    "helpcontent": "54030002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "inputPointFeatures": {
            "displayname": "$rc:inputpointfeatures.title",
            "datatype": {
                "type": "GPFeatureRecordSetLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Multipoint"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:inputpointfeatures.descr"
        },
        "interpolateField": {
            "displayname": "$rc:interpolatefield.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "Float",
                    "Double"
                ]
            },
            "depends": [
                "inputPointFeatures"
            ],
            "description": "$rc:interpolatefield.descr"
        },
        "outputName": {
            "displayname": "$rc:outputname.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:outputname.descr"
        },
        "optimizeFor": {
            "type": "optional",
            "displayname": "$rc:optimizefor.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "SPEED",
                        "code": "$rc:optimizefor.domain.SPEED"
                    },
                    {
                        "value": "BALANCE",
                        "code": "$rc:optimizefor.domain.BALANCE"
                    },
                    {
                        "value": "ACCURACY",
                        "code": "$rc:optimizefor.domain.ACCURACY"
                    }
                ]
            },
            "value": "BALANCE",
            "description": "$rc:optimizefor.descr"
        },
        "transformData": {
            "type": "optional",
            "displayname": "$rc:transformdata.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "TRANSFORM"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_TRANSFORM"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:transformdata.descr"
        },
        "sizeOfLocalModels": {
            "type": "optional",
            "displayname": "$rc:sizeoflocalmodels.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "30",
                "max": "500"
            },
            "description": "$rc:sizeoflocalmodels.descr"
        },
        "numberOfNeighbors": {
            "type": "optional",
            "displayname": "$rc:numberofneighbors.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "1",
                "max": "64"
            },
            "description": "$rc:numberofneighbors.descr"
        },
        "outputCellSize": {
            "type": "optional",
            "displayname": "$rc:outputcellsize.title",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Meters",
                    "Kilometers",
                    "Feet",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:outputcellsize.descr"
        },
        "outputPredictionError": {
            "type": "optional",
            "displayname": "$rc:outputpredictionerror.title",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "OUTPUT_ERROR"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_OUTPUT_ERROR"
                    }
                ]
            },
            "value": "false",
            "description": "$rc:outputpredictionerror.descr"
        },
        "outputRaster": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:outputraster.title",
            "datatype": {
                "type": "GPRasterLayer"
            }
        },
        "outputErrorRaster": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:outputerrorraster.title",
            "datatype": {
                "type": "GPRasterLayer"
            }
        }
    },
    "environments": [
        "cellSize",
        "extent",
        "mask",
        "outputCoordinateSystem",
        "pyramid",
        "snapRaster"
    ]
}
