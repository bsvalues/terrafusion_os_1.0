        "exclude_sources_from_polygon_generation": {
            "type": "optional",
            "control_guid": "{38C34610-C7F7-11D5-A693-0008C711C8C1}",
            "displayname": "$rc:exclude_sources_from_polygon_generation.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPString"
                }
            },
