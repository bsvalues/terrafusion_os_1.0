{
    "type": "FunctionTool",
    "guid": "{cb4499fa-4ecb-4016-a3d5-33a47ee076ca}",
    "displayname": "$rc:title",
    "helpcontent": "13010017",
    "description": "$rc:description",
    "product": "100",
    "categories": [
        "{7479dc37-304a-4078-a72f-d5c89b85822a}"
    ],
    "params": {
        "network_data_source": {
            "displayname": "$rc:network_data_source.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "GPNetworkDatasetLayer"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "description": "$rc:network_data_source.descr"
        },
        "layer_name": {
            "type": "optional",
            "displayname": "$rc:layer_name.title",
            "datatype": {
                "type": "GPString"
            },
            "description": "$rc:layer_name.descr"
        },
        "travel_mode": {
            "type": "optional",
            "displayname": "$rc:travel_mode.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:travel_mode.descr"
        },
        "travel_direction": {
            "type": "optional",
            "displayname": "$rc:travel_direction.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "TO_FACILITIES",
                        "code": "$rc:travel_direction.domain.TO_FACILITIES"
                    },
                    {
                        "value": "FROM_FACILITIES",
