            "value": "RINGS",
            "description": "$rc:geometry_at_cutoffs.descr"
        },
        "polygon_trim_distance": {
            "type": "optional",
            "displayname": "$rc:polygon_trim_distance.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "value": "100 Meters",
            "description": "$rc:polygon_trim_distance.descr"
