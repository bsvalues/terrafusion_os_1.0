        "out_network_analysis_layer": {
            "type": "derived",
            "direction": "out",
            "displayname": "$rc:out_network_analysis_layer.title",
            "datatype": {
                "type": "GPNALayer"
            }
        },
        "ignore_invalid_locations": {
            "type": "optional",
            "displayname": "$rc:ignore_invalid_locations.title",
            "category": "$rc:params.category4",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "SKIP"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "HALT"
                    }
                ]
            },
            "value": "true",
