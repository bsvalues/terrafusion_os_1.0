            "datatype": {
                "type": "GPMultiValue",
                "datatype": {
                    "type": "GPDouble"
                }
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:cutoffs.descr"
        },
        "time_of_day": {
            "type": "optional",
            "displayname": "$rc:time_of_day.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_of_day.descr"
        },
        "time_zone": {
            "type": "optional",
            "displayname": "$rc:time_zone.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "UTC",
                        "code": "$rc:time_zone.domain.UTC"
                    },
                    {
                        "value": "LOCAL_TIME_AT_LOCATIONS",
                        "code": "$rc:time_zone.domain.LOCAL_TIME_AT_LOCATIONS"
                    }
                ]
            },
            "value": "LOCAL_TIME_AT_LOCATIONS",
            "description": "$rc:time_zone.descr"
        },
        "output_type": {
            "type": "optional",
            "displayname": "$rc:output_type.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "POLYGONS",
                        "code": "$rc:output_type.domain.POLYGONS"
                    },
                    {
                        "value": "LINES",
                        "code": "$rc:output_type.domain.LINES"
                    },
                    {
                        "value": "POLYGONS_AND_LINES",
                        "code": "$rc:output_type.domain.POLYGONS_AND_LINES"
                    }
                ]
            },
            "value": "POLYGONS",
            "description": "$rc:output_type.descr"
        },
        "polygon_detail": {
            "type": "optional",
            "displayname": "$rc:polygon_detail.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "GENERALIZED",
                        "code": "$rc:polygon_detail.domain.GENERALIZED"
                    },
                    {
                        "value": "STANDARD",
                        "code": "$rc:polygon_detail.domain.STANDARD"
                    },
                    {
                        "value": "HIGH",
                        "code": "$rc:polygon_detail.domain.HIGH"
                    }
                ]
            },
            "value": "STANDARD",
            "description": "$rc:polygon_detail.descr"
        },
        "geometry_at_overlaps": {
            "type": "optional",
            "displayname": "$rc:geometry_at_overlaps.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
