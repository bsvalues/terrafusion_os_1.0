                        "code": "$rc:geometry_at_overlaps.domain.DISSOLVE"
                    },
                    {
                        "value": "SPLIT",
                        "code": "$rc:geometry_at_overlaps.domain.SPLIT"
                    }
                ]
            },
            "value": "OVERLAP",
            "description": "$rc:geometry_at_overlaps.descr"
        },
        "geometry_at_cutoffs": {
            "type": "optional",
            "displayname": "$rc:geometry_at_cutoffs.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "RINGS",
                        "code": "$rc:geometry_at_cutoffs.domain.RINGS"
                    },
                    {
                        "value": "DISKS",
                        "code": "$rc:geometry_at_cutoffs.domain.DISKS"
                    }
                ]
