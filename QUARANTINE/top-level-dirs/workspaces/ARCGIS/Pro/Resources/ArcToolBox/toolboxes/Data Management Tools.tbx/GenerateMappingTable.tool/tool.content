{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "3400002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_workbook": {
            "displayname": "$rc:in_workbook.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xlsx"
                ]
            },
            "description": "$rc:in_workbook.descr"
        },
        "out_table": {
            "direction": "out",
            "displayname": "$rc:out_table.title",
            "datatype": {
                "type": "DETable"
            },
            "schema": {
                "type": "GPTableSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_table.descr"
        }
    }
}
