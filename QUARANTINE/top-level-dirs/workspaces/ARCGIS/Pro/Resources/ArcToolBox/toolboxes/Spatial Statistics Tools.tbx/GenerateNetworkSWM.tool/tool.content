{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\GenerateNetworkSWM",
    "displayname": "$rc:title",
    "helpcontent": "90600112",
    "description": "$rc:description",
    "product": "100",
    "attributes": [
        "credits"
    ],
    "params": {
        "Input_Feature_Class": {
            "displayname": "$rc:input_feature_class.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:input_feature_class.descr"
        },
        "Unique_ID_Field": {
            "displayname": "$rc:unique_id_field.title",
            "datatype": {
                "type": "Field"
            },
            "domain": {
                "type": "GPFieldDomain",
                "fieldtype": [
                    "Short",
                    "Long",
                    "BigInteger"
                ]
            },
            "depends": [
                "Input_Feature_Class"
            ],
            "description": "$rc:unique_id_field.descr"
        },
        "Output_Spatial_Weights_Matrix_File": {
            "direction": "out",
            "displayname": "$rc:output_spatial_weights_matrix_file.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "swm"
                ]
            },
            "description": "$rc:output_spatial_weights_matrix_file.descr"
        },
        "Input_Network_Data_Source": {
            "displayname": "$rc:input_network_data_source.title",
            "datatype": {
                "type": "GPNetworkDataSource"
            },
            "description": "$rc:input_network_data_source.descr"
        },
        "Travel_Mode": {
            "displayname": "$rc:travel_mode.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain"
            },
            "description": "$rc:travel_mode.descr"
        },
        "Impedance_Distance_Cutoff": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:impedance_distance_cutoff.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Meters",
                    "Kilometers",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "description": "$rc:impedance_distance_cutoff.descr"
        },
        "Impedance_Temporal_Cutoff": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:impedance_temporal_cutoff.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPTimeUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Seconds",
                    "Minutes",
                    "Hours",
                    "Days"
                ]
            },
            "description": "$rc:impedance_temporal_cutoff.descr"
        },
        "Impedance_Cost_Cutoff": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:impedance_cost_cutoff.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDouble"
            },
            "description": "$rc:impedance_cost_cutoff.descr"
        },
        "Maximum_Number_of_Neighbors": {
            "type": "optional",
            "displayname": "$rc:maximum_number_of_neighbors.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLong"
            },
            "description": "$rc:maximum_number_of_neighbors.descr"
        },
        "Time_of_Day": {
            "type": "optional",
            "displayname": "$rc:time_of_day.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPDate"
            },
            "description": "$rc:time_of_day.descr"
        },
        "Time_Zone": {
            "type": "optional",
            "displayname": "$rc:time_zone.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "LOCAL_TIME_AT_LOCATIONS",
                        "code": "$rc:time_zone.domain.LOCAL_TIME_AT_LOCATIONS"
                    },
                    {
                        "value": "UTC",
                        "code": "$rc:time_zone.domain.UTC"
                    }
                ]
            },
            "value": "LOCAL_TIME_AT_LOCATIONS",
            "description": "$rc:time_zone.descr"
        },
        "Barriers": {
            "type": "optional",
            "displayname": "$rc:barriers.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Point",
                    "Polygon",
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:barriers.descr"
        },
        "Search_Tolerance": {
            "type": "optional",
            "displayname": "$rc:search_tolerance.title",
            "category": "$rc:params.category1",
            "datatype": {
                "type": "GPLinearUnit"
            },
            "domain": {
                "type": "GPUnitDomain",
                "items": [
                    "Feet",
                    "Meters",
                    "Kilometers",
                    "Miles",
                    "FeetInt",
                    "MilesInt"
                ]
            },
            "value": "5000 Meters",
            "description": "$rc:search_tolerance.descr"
        },
        "Conceptualization_of_Spatial_Relationships": {
            "type": "optional",
            "displayname": "$rc:conceptualization_of_spatial_relationships.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "FIXED",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.FIXED"
                    },
                    {
                        "value": "INVERSE",
                        "code": "$rc:conceptualization_of_spatial_relationships.domain.INVERSE"
                    }
                ]
            },
            "value": "FIXED",
            "description": "$rc:conceptualization_of_spatial_relationships.descr"
        },
        "Exponent": {
            "enabled": "false",
            "type": "optional",
            "displayname": "$rc:exponent.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPDouble"
            },
            "domain": {
                "type": "GPRangeDomain",
                "min": "0.10000000000000001",
                "max": "4"
            },
            "value": "1",
            "description": "$rc:exponent.descr"
        },
        "Row_Standardization": {
            "type": "optional",
            "displayname": "$rc:row_standardization.title",
            "category": "$rc:params.category2",
            "datatype": {
                "type": "GPBoolean"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPBoolean",
                        "value": "true",
                        "code": "ROW_STANDARDIZATION"
                    },
                    {
                        "type": "GPBoolean",
                        "value": "false",
                        "code": "NO_STANDARDIZATION"
                    }
                ]
            },
            "value": "true",
            "description": "$rc:row_standardization.descr"
        }
    },
    "environments": [
        "extent",
        "scratchWorkspace",
        "workspace"
    ]
}
