{
    "type": "ScriptTool",
    "displayname": "$rc:title",
    "helpcontent": "68000002",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "target_unit_features": {
            "display_order": "0",
            "displayname": "$rc:target_unit_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:target_unit_features.descr"
        },
        "target_detail_features": {
            "display_order": "1",
            "displayname": "$rc:target_detail_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polyline"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:target_detail_features.descr"
        },
        "target_level_features": {
            "display_order": "2",
            "displayname": "$rc:target_level_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:target_level_features.descr"
        },
        "target_facility_features": {
            "display_order": "3",
            "displayname": "$rc:target_facility_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:target_facility_features.descr"
        },
        "in_excel_template": {
            "display_order": "6",
            "displayname": "$rc:in_excel_template.title",
            "datatype": {
                "type": "DEFile"
            },
            "domain": {
                "type": "GPFileDomain",
                "filetypes": [
                    "xls",
                    "xlsx"
                ]
            },
            "description": "$rc:in_excel_template.descr"
        },
        "uniqueid_delimiter": {
            "display_order": "7",
            "displayname": "$rc:uniqueid_delimiter.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "PERIOD",
                        "code": "$rc:uniqueid_delimiter.domain.PERIOD"
                    },
                    {
                        "value": "HYPHEN",
                        "code": "$rc:uniqueid_delimiter.domain.HYPHEN"
                    },
                    {
                        "value": "UNDERSCORE",
                        "code": "$rc:uniqueid_delimiter.domain.UNDERSCORE"
                    }
                ]
            },
            "value": "PERIOD",
            "description": "$rc:uniqueid_delimiter.descr"
        },
        "sliver_threshold": {
            "type": "optional",
            "display_order": "8",
            "displayname": "$rc:sliver_threshold.title",
            "datatype": {
                "type": "GPLong"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "type": "GPLong",
                        "value": "0",
                        "code": "0"
                    },
                    {
                        "type": "GPLong",
                        "value": "1",
                        "code": "1"
                    },
                    {
                        "type": "GPLong",
