        },
        "area_unit_of_measure": {
            "type": "optional",
            "display_order": "10",
            "displayname": "$rc:area_unit_of_measure.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
