{
    "type": "PythonScriptTool",
    "python_class": "..\\toolbox.module.py\\DOFToObstacleFeatures",
    "displayname": "$rc:title",
    "helpcontent": "73030003",
    "description": "$rc:description",
    "product": "100",
    "params": {
        "in_table": {
            "displayname": "$rc:in_table.title",
            "datatype": {
                "type": "GPTableView"
            },
            "description": "$rc:in_table.descr"
        },
        "out_obstacle_features": {
            "direction": "out",
            "displayname": "$rc:out_obstacle_features.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_obstacle_features.descr"
        },
        "out_obstacle_buffers": {
            "direction": "out",
            "displayname": "$rc:out_obstacle_buffers.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "schema": {
                "type": "GPFeatureSchema",
                "generateoutputcatalogpath": "true"
            },
            "description": "$rc:out_obstacle_buffers.descr"
        },
        "clip_features": {
            "type": "optional",
            "displayname": "$rc:clip_features.title",
            "datatype": {
                "type": "GPFeatureLayer"
            },
            "domain": {
                "type": "GPFeatureClassDomain",
                "geometrytype": [
                    "Polygon"
                ],
                "featuretype": [
                    "Simple"
                ]
            },
            "description": "$rc:clip_features.descr"
        }
    }
}
