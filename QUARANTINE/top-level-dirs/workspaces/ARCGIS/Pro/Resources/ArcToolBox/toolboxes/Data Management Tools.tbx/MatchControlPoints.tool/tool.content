{
    "type": "FunctionTool",
    "guid": "{32763805-9299-455c-ba5c-cef382828443}",
    "displayname": "$rc:title",
    "helpcontent": "3190009",
    "description": "$rc:description",
    "product": "200",
    "attributes": [
        "mCPU"
    ],
    "params": {
        "in_mosaic_dataset": {
            "displayname": "$rc:in_mosaic_dataset.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEMosaicDataset"
                    },
                    {
                        "type": "GPMosaicLayer"
                    }
                ]
            },
            "description": "$rc:in_mosaic_dataset.descr"
        },
        "in_control_points": {
            "displayname": "$rc:in_control_points.title",
            "datatype": {
                "type": "GPComposite",
                "datatypes": [
                    {
                        "type": "DEFile"
                    },
                    {
                        "type": "DEFeatureClass"
                    },
                    {
                        "type": "GPFeatureLayer"
                    },
                    {
                        "type": "GPString"
                    }
                ]
            },
            "description": "$rc:in_control_points.descr"
        },
        "out_control_points": {
            "direction": "out",
            "displayname": "$rc:out_control_points.title",
            "datatype": {
                "type": "DEFeatureClass"
            },
            "description": "$rc:out_control_points.descr"
        },
        "similarity": {
            "type": "optional",
            "displayname": "$rc:similarity.title",
            "datatype": {
                "type": "GPString"
            },
            "domain": {
                "type": "GPCodedValueDomain",
                "items": [
                    {
                        "value": "LOW",
                        "code": "$rc:similarity.domain.LOW"
                    },
                    {
                        "value": "MEDIUM",
                        "code": "$rc:similarity.domain.MEDIUM"
                    },
                    {
                        "value": "HIGH",
                        "code": "$rc:similarity.domain.HIGH"
                    }
                ]
            },
            "value": "HIGH",
            "description": "$rc:similarity.descr"
        }
    },
    "environments": [
        "parallelProcessingFactor",
        "workspace"
    ]
}
