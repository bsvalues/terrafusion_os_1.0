        {
          "type" : "CIMLabelClass",
          "expression" : "var label;\r\n\r\nfunction repSpecChar(str){\r\n    str = Replace(str, \"&\", '&amp;')\r\n    str = Replace(str, \"<\", '&lt;')\r\n    return str\r\n}\r\n\r\nIf (IsEmpty($feature.Name)==true){ //If the name is empty return an empty label (even if it has area)\r\n    return label;\r\n}\r\nElse if ($feature.IsSeed != 1){\r\n    label = \"<BOL>\" + repSpecChar($feature.Name) + \"</BOL>\"\r\n    if (IsEmpty($feature.StatedArea)==true){\r\n        return label; //if the area is empty only the parcel name is returned\r\n    }\r\n    Else {\r\n        if (IsEmpty($feature.statedareaunit)==true) {\r\n            label = label + \"\\n\" + \"<fnt size = '8'>\" + Round($feature.statedarea, 2) + \" Unknown\" + \"</fnt>\";\r\n            return label;\r\n        }\r\n        label = label + \"\\n\" + \"<fnt size = '8'>\" + Round($feature.statedarea, 2) + \" \" + DomainName($feature, 'statedareaunit') + \"</fnt>\";\r\n        return label;\r\n    }\r\n}",
