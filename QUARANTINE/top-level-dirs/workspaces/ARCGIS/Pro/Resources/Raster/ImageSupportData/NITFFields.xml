<?xml version="1.0" encoding="UTF-8"?>
<NITF>
    <!-- File Header -->
    <Header>
      <Field name="_treID" hidden='true'>
          <Name>Internal TRE ID</Name>
      </Field>

      <Field name="FHDR" hidden='true'>
          <Name>File Profile Name</Name>
      </Field>

      <Field name="FDT" format='date'/>
      
      <Field name="FBKGC" format='color'/>

      <Field name="ONAME"/>
      
      <Field name="OPHONE"/>
      
      <!--
      <Field name="FL" hidden='true'/>
      <Field name="HL" hidden='true'/>
      <Field name="NUMI" hidden='true'/>
      <Field name="NUMS" hidden='true'/>
      <Field name="NUMX" hidden='true'/>
      <Field name="NUMT" hidden='true'/>
      <Field name="NUMDES" hidden='true'/>
      <Field name="NUMRES" hidden='true'/>
      <Field name="UDHDL" hidden='true'/>
      <Field name="XHDL" hidden='true'/>
      <Field name="XHDLOFL" hidden='true'/>
      <Field name="ImageSizes" info="false"/>
      <Field name="ImageSize" info="false"/>
      -->
      
    </Header>

    <!-- Security -->
    <Security>
    </Security>

    <!-- Image Header -->
    <Image>
      <Field name="IM" hidden='true'/>
    </Image>
    
    <Band>
    </Band>

    <!-- Text Header -->
    <Text>
      <Field name="DataPath" format='external' info="false">
        <FieldName>Contents</FieldName>
      </Field>
      <Field name="DataLength"  info="false">
        <FieldName>Length</FieldName>
      </Field>
      <Field name="DataOffset"  info="false">
        <FieldName>Offset</FieldName>
      </Field>
    </Text>
    
    <!-- DES Header -->
    <DES>
      <Field name="DE" hidden='true'/>
      <Field name="DataPath" format='external' info="false">
        <FieldName>Contents</FieldName>
      </Field>
      <Field name="DataLength"  info="false">
        <FieldName>Length</FieldName>
      </Field>
      <Field name="DataOffset"  info="false">
        <FieldName>Offset</FieldName>
      </Field>
    </DES>

    <!-- TREs -->
    <TRE name="STDIDC">        
      <Field name="ACQUISITION_DATE" format='date'/>
    </TRE>

    <TRE name="RAW_TRE">
      <Field name="_isRaw" hidden='true'/>
      <Field name="raw_data" format='base64' info="false">
        <FieldName>Contents</FieldName>
      </Field>
    </TRE>

    <TRE name="TRE_OVERFLOW">
      <Field name="DataPath" hidden='true' info="false"/>
      <Field name="DataLength" hidden="true" info="false"/>
      <Field name="DataOffset" hidden="true" info="false"/>
    </TRE>
    
</NITF>