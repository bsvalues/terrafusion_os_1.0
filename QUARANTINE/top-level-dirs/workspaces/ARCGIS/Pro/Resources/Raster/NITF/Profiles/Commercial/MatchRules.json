      "Key": "$/FileHeader/NUMI$",
      "Operator": "Equals",
      "Value": "001"
    },
    "MatchRule-2Images": {
      "Key": "$/FileHeader/NUMI$",
      "Operator": "Equals",
      "Value": "002"
    },
    "MatchRule-ImageIs1Band": {
      "Key": "$/Images/%i/NBANDS$",
      "Operator": "Equals",
      "Value": "1"
    },
    "MatchRule-ImageIs3Bands": {
      "Key": "$/Images/%i/NBANDS$",
      "Operator": "Equals",
      "Value": "3"
    },
    "MatchRule-ImageIs4Bands": {
      "Key": "$/Images/%i/NBANDS$",
      "Operator": "Equals",
