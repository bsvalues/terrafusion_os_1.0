    "MatchRule-ImageHasIREPIsRGB": {
      "Key": "$/Images/%i/IREP$",
      "Operator": "Equals",
      "Value": "RGB"
    },
    "MatchRule-ImageHasIREPIsMULTI": {
      "Key": "$/Images/%i/IREP$",
      "Operator": "Equals",
      "Value": "MULTI"
    },
    "MatchRule-ImageHasIREPIsRGBorMULTI": {
      "Key": {
        "Aliases": [],
        "SourcePaths": [
          {
            "Path": "$/Images/%i/IREP$",
            "Map": [
              ["RGB", "yes"],
              ["MULTI", "yes"]
            ]
          }
        ],
        "Default": null
      },
      "Operator": "Equals",
      "Value": "yes"
    },
