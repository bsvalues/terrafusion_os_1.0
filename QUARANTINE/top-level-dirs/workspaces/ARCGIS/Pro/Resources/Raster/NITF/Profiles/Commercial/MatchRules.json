    "MatchRule-MatchMission": {
      "Key": "Properties.json#Mission-Match-Property",
      "Operator": "Equals",
      "Value": "@{MissionMatch}"
    },
    "MatchKey-Product": "Properties.json#ProductName-Property",
    "MatchRule-ProductIsNOT": {
      "Key": "#MatchKey-Product",
      "Operator": "NotEqual",
      "Value": ["P1", "P2", "G1", "G2", "G3", "R1", "R2", "R3"]
    },
    "MatchRule-ProductIsP2": {
      "Key": "#MatchKey-Product",
      "Operator": "Equals",
      "Value": "P2"
    },
    "MatchRule-ProductIsP1": {
      "Key": "#MatchKey-Product",
      "Operator": "Equals",
      "Value": "P1"
    },
