  <!-- CacheInfo ===================================================== -->
  <xs:complexType name="CacheInfo">
    <xs:sequence>
      <xs:element name="TileCacheInfo" type="TileCacheInfo" nillable="true" minOccurs="0"/>
      <xs:element name="TileImageInfo" type="TileImageInfo" nillable="true" minOccurs="0"/>
