/* $Id: st_domain_stats.sts,v 1.10.1.2, 2009-04-13 18:08:33Z, Kevin Watt$ 
$NoKeywords$ */ 
CREATE OR REPLACE Type st_domain_stats Authid current_user AS object
        --C_Type_Release 1001
(
  curnum number,
  STATIC FUNCTION odcigetinterfaces(ifclist  OUT sys.odciobjectlist)
         RETURN NUMBER,
  STATIC FUNCTION odcistatscollect(col       sys.odcicolinfo,
                                   options   sys.ODCIStatsOptions,
                                   rawstats  OUT raw,
                                   env       sys.odcienv)
         RETURN NUMBER,
  STATIC FUNCTION odcistatsdelete(col       sys.odcicolinfo,
                                  ia        sys.odciindexinfo,  
                                  rawstats  OUT raw,
                                  env       sys.odcienv)
         RETURN NUMBER,
  STATIC FUNCTION odcistatscollect(ia        sys.odciindexinfo,
                                   options   sys.odcistatsoptions,
                                   rawstats  OUT raw,
                                   env       sys.odcienv)
         RETURN NUMBER,
  STATIC FUNCTION odcistatsdelete(ia        sys.odciindexinfo, 
                                  rawstats  OUT raw,
                                  env       sys.odcienv) 
         RETURN NUMBER,
  STATIC FUNCTION odcistatsselectivity(pred     sys.odcipredinfo,
                                       sel      Out number, 
                                       args     sys.odciargdesclist,
                                       strt     number,
                                       stop     number,  
                                       object1  &1..st_geometry, 
                                       object2  &1..st_geometry,
                                       env      sys.odcienv)
         Return number,
  STATIC FUNCTION odcistatsselectivity(pred    sys.odcipredinfo,
                                       sel     Out number, 
                                       args    sys.odciargdesclist,
                                       strt    number,
                                       stop    number, 
                                       object  &1..st_geometry, 
                                       minx    number, 
                                       miny    number,
                                       maxx    number,
                                       maxy    number,
                                       env     sys.odcienv) 
         Return number,
  STATIC FUNCTION odcistatsselectivity(pred     sys.odcipredinfo,
                                       sel      Out number, 
                                       args     sys.odciargdesclist,
                                       strt     number,
                                       stop     number, 
                                       object1  &1..st_geometry,
                                       object2  &1..st_geometry,
                                       matrix   varchar2, 
                                       env      sys.odcienv) 
         Return number,
  STATIC FUNCTION odcistatsselectivity(pred     sys.odcipredinfo,
                                       sel      Out number,
                                       args     sys.odciargdesclist,
                                       strt     number,
                                       stop     number,
                                       object1  SDE.st_geometry,
                                       object2  SDE.st_geometry,
                                       distance number,
                                       env      sys.odcienv) 
         Return number,
  STATIC FUNCTION odcistatsindexcost(ia    sys.odciindexinfo,
                                     sel   number,
                                     cost  Out sys.odcicost, 
                                     qi    sys.odciqueryinfo,
                                     pred  sys.odcipredinfo,
                                     args  sys.odciargdesclist,
                                     strt  number,
                                     stop  number,  
                                     minx  number,
                                     miny  number, 
                                     maxx  number, 
                                     maxy  number,
                                     env   sys.odcienv)
         Return number,
  STATIC FUNCTION odcistatsindexcost(ia      sys.odciindexinfo,
                                     sel     number,
                                     cost    Out sys.odcicost, 
                                     qi      sys.odciqueryinfo,
                                     pred    sys.odcipredinfo,
                                     args    sys.odciargdesclist,
                                     strt    number,
                                     stop    number,  
                                     object  &1..st_geometry,
                                     env     sys.odcienv) 
         Return number,
  STATIC FUNCTION odcistatsindexcost(ia      sys.odciindexinfo,
                                     sel     number,
                                     cost    Out sys.odcicost, 
                                     qi      sys.odciqueryinfo,
                                     pred    sys.odcipredinfo,
                                     args    sys.odciargdesclist,
                                     strt    number,
                                     stop    number,  
                                     object  &1..st_geometry,
                                     matrix  varchar2,
                                     env     sys.odcienv) 
         Return number,
  STATIC FUNCTION odcistatsindexcost
                                    (ia      sys.odciindexinfo,
                                     sel     number,
                                     cost    Out sys.odcicost,
                                     qi      sys.odciqueryinfo,
                                     pred    sys.odcipredinfo,
                                     args    sys.odciargdesclist,
                                     strt    number,
                                     stop    number,
                                     object  SDE.st_geometry,
                                     distance number,
                                     env     sys.odcienv) 
         Return number,
         -- PRAGMA restrict_references(ODCIStatsIndexCost, WNDS, WNPS),
  STATIC FUNCTION odcistatsfunctioncost(func     sys.odcifuncinfo,
                                        cost     Out sys.odcicost, 
                                        args     sys.odciargdesclist,
                                        object1  &1..st_geometry,
                                        object2  &1..st_geometry,
                                        env      sys.odcienv)
         Return number,
  STATIC FUNCTION odcistatsfunctioncost(func    sys.odcifuncinfo,
                                        cost    Out sys.odcicost, 
                                        args    sys.odciargdesclist,
                                        object  &1..st_geometry, 
                                        minx    number, 
                                        miny    number, 
                                        maxx    number, 
                                        maxy    number,
                                        env     sys.odcienv)
         Return number,
  STATIC FUNCTION odcistatsfunctioncost(func     sys.odcifuncinfo,
                                        cost     Out sys.odcicost, 
                                        args     sys.odciargdesclist,
                                        object1  &1..st_geometry,
                                        object2  &1..st_geometry,
                                        matrix   varchar2,
                                        env      sys.odcienv)
         Return number,
  STATIC FUNCTION odcistatsfunctioncost 
                                       (func     sys.odcifuncinfo,
                                        cost     Out sys.odcicost,
                                        args     sys.odciargdesclist,
                                        object1  SDE.st_geometry,
                                        object2  SDE.st_geometry,
                                        distance number,
                                        env      sys.odcienv) 
         Return number,
  STATIC FUNCTION get_release
         RETURN NUMBER
);
/

