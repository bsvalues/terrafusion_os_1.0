<?xml version="1.0" encoding="utf-8" ?>
  <castle>
    <facilities>
      <!-- add our workflow service bus -->
      <facility id="rhino.esb">
				<bus threadCount="50"
						 numberOfRetries="5"
						 endpoint="rhino.queues://localhost:22022/trueautomation_servicebus" name="ServiceBus"
					consumeInTransaction="false" />

				<messages>
          <!-- XXX FIXME revisit this! -->
          <add name="TrueAutomation.WorkflowService.Messages"
							 endpoint="rhino.queues://localhost:22022/trueautomation_servicebus" />
        </messages>
      </facility>
    </facilities>
  </castle>

