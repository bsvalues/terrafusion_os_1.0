<?xml version="1.0"?>
<configuration>
  <!-- define our custom configuration sections -->
  <configSections>
    <section name="castle" type="Castle.Windsor.Configuration.AppDomain.CastleSectionHandler, Castle.Windsor"/>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net"/>
    <section name="repositoryConfiguration" type="TrueAutomation.Core.Persistence.NHibernate.Config.RepositoriesConfigurationSection, TrueAutomation.Core.Persistence.NHibernate, Culture=neutral, PublicKeyToken=ff3a2d1ac5316cc0"/>
    <section name="databaseConfiguration" type="TrueAutomation.Core.Persistence.NHibernate.Config.DatabasesConfigurationSection, TrueAutomation.Core.Persistence.NHibernate, Culture=neutral, PublicKeyToken=ff3a2d1ac5316cc0"/>
    <section name="serviceHosting" type="TrueAutomation.Core.WCF.Config.ServicesConfigurationSection, TrueAutomation.Core, Culture=neutral, PublicKeyToken=ff3a2d1ac5316cc0"/>
    <section name="rhino.esb" type="Rhino.ServiceBus.Config.BusConfigurationSection, Rhino.ServiceBus" requirePermission="false"/>
    <section name="rhino.consumers" type="TrueAutomation.ServiceBus.MessageBus.ConsumerConfiguration, TrueAutomation.ServiceBus.MessageBus"/>
  </configSections>
  
  <!-- configure any connection strings -->
  <connectionStrings>
    <add name="InstanceStore" connectionString="Data Source=VM64DEVDB9008;Initial Catalog=workflow_persistence;Integrated Security=True;Asynchronous Processing=True" providerName="System.Data.SqlClient"/>
    
    <add name="PACSQuerySqlConnection" connectionString="Data Source=VM64DEVDB9008;Initial Catalog=pacs_chelan_workflow_dev;Integrated Security=SSPI;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  
  <!-- configure our Castle Windsor IoC configuration -->
  <castle>
    <components>
    </components>
  </castle>
  
  <rhino.esb>
    <bus threadCount="1" numberOfRetries="1" endpoint="rhino.queues://localhost:22022/trueautomation_servicebus" name="ServiceBus"/>
    <messages>
      <!-- XXX FIXME revisit this! -->
      <add name="TrueAutomation.WorkflowService.Messages" endpoint="rhino.queues://localhost:22022/trueautomation_servicebus"/>
    </messages>
  </rhino.esb>
  <!-- configure our logging output -->
  <log4net configSource="log4net.config"/>
  <rhino.consumers>
    <Assemblies>
      <add name="TrueAutomation.ServiceBus.MessageBus.dll"/>
      <add name="TrueAutomation.ServiceBus.MessageBus.Consumers.dll"/>
    </Assemblies>
  </rhino.consumers>
  
  <!-- configure our available custom object repository types.
			 this registers custom object repositories in a specified
			 assembly, with their corresponding service descriptor
			 interfaces from another assembly, in the global service
			 locator IoC container -->
  <repositoryConfiguration>
    <repositories>
      <!--
			<clear />
			<add name="repositoryset1"
					 repositoryAssembly="repository-assembly1"
					 serviceDescriptor="interface-assembly1"/>
			-->
    </repositories>
  </repositoryConfiguration>
  
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" from="TA.TestEmail@gmail.com">
        <!-- TA SMTP Server
				<network
          host= "172.16.0.26"
          port="25"
          defaultCredentials="true"
					userName =""
					password =""
        /> 
-->
        <!-- Using G-Mail SMTP Server temporarily -->
        <network host="smtp.gmail.com" port="587" defaultCredentials="true" userName="TA.TestEmail" password="lpstatest" enableSsl="true"/>
      </smtp>
    </mailSettings>
  </system.net>
  
  <!-- configure any database connections -->
  <databaseConfiguration>
    <databases>
      <clear/>
      <add name="Task Service" settingsFile="TaskService.db.cfg.xml">
        <mappingAssemblies>
          <add name="Task Service Data Access Layer" assembly="TrueAutomation.TaskService.DAL.NHibernate"/>
        </mappingAssemblies>
      </add>
      <add name="Security Service" settingsFile="SecurityService.db.cfg.xml">
        <mappingAssemblies>
          <add name="Security Service Data Access Layer" assembly="TrueAutomation.SecurityService.DAL.NHibernate"/>
        </mappingAssemblies>
      </add>
      <add name="Workflow Service" settingsFile="WorkflowService.db.cfg.xml">
        <mappingAssemblies>
          <add name="Workflow Service Data Access Layer" assembly="TrueAutomation.WorkflowService.DAL.NHibernate"/>
        </mappingAssemblies>
      </add>
      <add name="PACS Service" settingsFile="PACSService.db.cfg.xml">
        <mappingAssemblies>
          <add name="PACS Service Data Access Layer" assembly="TrueAutomation.PACSService.DAL.NHibernate"/>
        </mappingAssemblies>
      </add>
      <add name="ESB Service" settingsFile="ServiceBus.db.cfg.xml">
        <mappingAssemblies>
          <add name="Service Bus Data Access Layer" assembly="TrueAutomation.ServiceBus.DAL.NHibernate"/>
        </mappingAssemblies>
      </add>
      <add name="Document Management Service" settingsFile="DocumentManagementService.db.cfg.xml">
        <mappingAssemblies>
          <add name="Document Management Service Data Access Layer" assembly="TrueAutomation.DocumentManagement.DAL.NHibernate"/>
        </mappingAssemblies>
      </add>
    </databases>
  </databaseConfiguration>
  
  <!-- configure our list of services that we want to host -->
  <serviceHosting>
    <services>
      <clear/>
      <add name="Workflow Task Service" service="TrueAutomation.TaskService.WCF.ITaskService, TrueAutomation.TaskService.WCF, Culture=neutral, PublicKeyToken=ff3a2d1ac5316cc0" enabled="true"/>
      <add name="Security Service" service="TrueAutomation.SecurityService.WCF.ISecurityService, TrueAutomation.SecurityService.WCF, Culture=neutral, PublicKeyToken=ff3a2d1ac5316cc0" enabled="true"/>
      <add name="Workflow Service" service="TrueAutomation.WorkflowService.WCF.IWorkflowService, TrueAutomation.WorkflowService.WCF, Culture=neutral, PublicKeyToken=ff3a2d1ac5316cc0" enabled="true"/>
      <add name="PACS Service" service="TrueAutomation.PACSService.WCF.IPACSService, TrueAutomation.PACSService.WCF, Culture=neutral, PublicKeyToken=ff3a2d1ac5316cc0" enabled="true"/>
      <add name="ESB Service" service="TrueAutomation.ServiceBus.WCF.IServiceBus, TrueAutomation.ServiceBus.WCF, Culture=neutral, PublicKeyToken=ff3a2d1ac5316cc0" enabled="true"/>
      <add name="Document Management Service" service="TrueAutomation.DocumentManagement.WCF.IDocumentManagementService, TrueAutomation.DocumentManagement.WCF, Culture=neutral, PublicKeyToken=ff3a2d1ac5316cc0" enabled="true"/>
    </services>
  </serviceHosting>
  
  <!--<system.diagnostics>
    <sources>
      <source name ="System.ServiceModel" switchValue="Verbose">
        <listeners>
          <add name="xml" />
        </listeners>
      </source>
      <source name ="System.ServiceModel.MessageLogging"
              switchValue="Verbose, ActivityTracing">
        <listeners>
          <add name="xml" />
        </listeners>
      </source>
      <source name ="System.Runtime.Serialization" switchValue="Verbose">
        <listeners>
          <add name="xml" />
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add name="xml" type="System.Diagnostics.XmlWriterTraceListener"
           traceOutputOptions="LogicalOperationStack"
           initializeData="C:\log\WCFTrace.svclog" />
    </sharedListeners>
    <trace autoflush="true" />
  </system.diagnostics>-->
  
  <!-- configure the service behaviors and bindings for any services -->
  <system.serviceModel>
    <!-- define our service behaviors -->
    <behaviors>
      <serviceBehaviors>
        <behavior name="TrueAutomation.DefaultServiceBehavior">
          <dataContractSerializer maxItemsInObjectGraph="2147483647"/>
          <serviceMetadata httpGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="false"/>
          <bufferedReceive maxPendingMessagesPerChannel="2147483647"/>
        </behavior>
      </serviceBehaviors>

      <endpointBehaviors>
        <behavior name="TrueAutomation.MaxSizeBehavior">
          <dataContractSerializer maxItemsInObjectGraph="2147483647"/>
        </behavior>
      </endpointBehaviors>
    </behaviors>

    <!-- define our service bindings -->
    <bindings>
      <wsHttpBinding>
        <!-- define our server-side binding configuration -->
        <binding name="TrueAutomation.DefaultWsHttpBinding" maxReceivedMessageSize="2147483647">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647"/>
        </binding>

        <!-- define our client-side binding configuration -->
        <binding name="TrueAutomation.ClientBinding" closeTimeout="00:15:00" openTimeout="00:15:00" receiveTimeout="00:15:00" sendTimeout="00:15:00" bypassProxyOnLocal="false" transactionFlow="false" hostNameComparisonMode="StrongWildcard" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647" messageEncoding="Text" textEncoding="utf-8" useDefaultWebProxy="true" allowCookies="false">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647"/>
          <reliableSession ordered="true" inactivityTimeout="00:15:00" enabled="false"/>
          <security mode="Message">
            <transport clientCredentialType="Windows" proxyCredentialType="None" realm=""/>
            <message clientCredentialType="Windows" negotiateServiceCredential="true" algorithmSuite="Default"/>
          </security>
        </binding>
      </wsHttpBinding>
    </bindings>
    
    <!-- define our hosted service configuration -->
    <services>
      <!-- Task Service Setup -->
      <service name="TrueAutomation.TaskService.WCF.TaskService" behaviorConfiguration="TrueAutomation.DefaultServiceBehavior">
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="TrueAutomation.DefaultWsHttpBinding" contract="TrueAutomation.TaskService.WCF.ITaskService">
          <identity>
            <dns value="localhost"/>
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8732/TrueAutomation/Services/TaskService/"/>
          </baseAddresses>
        </host>
      </service>
      <!-- Security Service Setup -->
      <service name="TrueAutomation.SecurityService.WCF.SecurityService" behaviorConfiguration="TrueAutomation.DefaultServiceBehavior">
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="TrueAutomation.DefaultWsHttpBinding" contract="TrueAutomation.SecurityService.WCF.ISecurityService">
          <identity>
            <dns value="localhost"/>
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8732/TrueAutomation/Services/SecurityService/"/>
          </baseAddresses>
        </host>
      </service>
      <!-- Workflow Service Setup -->
      <service name="TrueAutomation.WorkflowService.WCF.WorkflowService" behaviorConfiguration="TrueAutomation.DefaultServiceBehavior">
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="TrueAutomation.DefaultWsHttpBinding" contract="TrueAutomation.WorkflowService.WCF.IWorkflowService">
          <identity>
            <dns value="localhost"/>
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8732/TrueAutomation/Services/WorkflowService/"/>
          </baseAddresses>
        </host>
      </service>
      <!-- PACS Service Setup -->
      <service name="TrueAutomation.PACSService.WCF.PACSService" behaviorConfiguration="TrueAutomation.DefaultServiceBehavior">
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="TrueAutomation.DefaultWsHttpBinding" contract="TrueAutomation.PACSService.WCF.IPACSService">
          <identity>
            <dns value="localhost"/>
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8732/TrueAutomation/Services/PACSService/"/>
          </baseAddresses>
        </host>
      </service>
      <!-- ESB Service Setup -->
      <service name="TrueAutomation.ServiceBus.WCF.ServiceBus" behaviorConfiguration="TrueAutomation.DefaultServiceBehavior">
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="TrueAutomation.DefaultWsHttpBinding" contract="TrueAutomation.ServiceBus.WCF.IServiceBus">
          <identity>
            <dns value="localhost"/>
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8732/TrueAutomation/Services/ServiceBus/"/>
          </baseAddresses>
        </host>
      </service>
      <!-- Document Management Service Setup -->
      <service name="TrueAutomation.DocumentManagement.WCF.DocumentManagementService" behaviorConfiguration="TrueAutomation.DefaultServiceBehavior">
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="TrueAutomation.DefaultWsHttpBinding" contract="TrueAutomation.DocumentManagement.WCF.IDocumentManagementService">
          <identity>
            <dns value="localhost"/>
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8732/TrueAutomation/Services/DocumentManagementService"/>
          </baseAddresses>
        </host>
      </service>
    </services>

    <!-- define our client-side bindings -->
    <client>
      <endpoint address="http://localhost:8732/TrueAutomation/Services/WorkflowService/" binding="wsHttpBinding" bindingConfiguration="TrueAutomation.ClientBinding" behaviorConfiguration="TrueAutomation.MaxSizeBehavior" contract="WorkflowServiceReference.IWorkflowService" name="WSHttpBinding_IWorkflowService">
        <identity>
          <dns value="localhost"/>
        </identity>
      </endpoint>
      <endpoint address="http://localhost:8732/TrueAutomation/Services/SecurityService/" binding="wsHttpBinding" bindingConfiguration="TrueAutomation.ClientBinding" behaviorConfiguration="TrueAutomation.MaxSizeBehavior" contract="SecurityServiceReference.ISecurityService" name="WSHttpBinding_ISecurityService">
        <identity>
          <dns value="localhost"/>
        </identity>
      </endpoint>
      <endpoint address="http://localhost:8732/TrueAutomation/Services/TaskService/" binding="wsHttpBinding" bindingConfiguration="TrueAutomation.ClientBinding" behaviorConfiguration="TrueAutomation.MaxSizeBehavior" contract="TaskServiceReference.ITaskService" name="WSHttpBinding_ITaskService">
        <identity>
          <dns value="localhost"/>
        </identity>
      </endpoint>
      <endpoint address="http://localhost:8732/TrueAutomation/Services/PACSService/" binding="wsHttpBinding" bindingConfiguration="TrueAutomation.ClientBinding" behaviorConfiguration="TrueAutomation.MaxSizeBehavior" contract="PACSServiceReference.IPACSService" name="WSHttpBinding_IPACSService">
        <identity>
          <dns value="localhost"/>
        </identity>
      </endpoint>
      <endpoint address="http://localhost:8732/TrueAutomation/Services/ServiceBus/" binding="wsHttpBinding" bindingConfiguration="TrueAutomation.ClientBinding" behaviorConfiguration="TrueAutomation.MaxSizeBehavior" contract="ServiceBusReference.IServiceBus" name="WSHttpBinding_IServiceBus">
        <identity>
          <dns value="localhost"/>
        </identity>
      </endpoint>
      <endpoint address="http://localhost:8732/TrueAutomation/Services/DocumentManagementService/" binding="wsHttpBinding" bindingConfiguration="TrueAutomation.ClientBinding" behaviorConfiguration="TrueAutomation.MaxSizeBehavior" contract="DocumentManagementServiceReference.IDocumentManagementService" name="WSHttpBinding_IDocumentManagementService">
        <identity>
          <dns value="localhost"/>
        </identity>
      </endpoint>
    </client>
    <!--<diagnostics>
      <messageLogging
           logEntireMessage="true"
           logMalformedMessages="false"
           logMessagesAtServiceLevel="true"
           logMessagesAtTransportLevel="false"/>
    </diagnostics>-->
  </system.serviceModel>
  <!-- this next bit is critical for SQLite under .NET 4.0, otherwise
			 you'll get hard-to understand errors trying to initialize the
			 NHibernate configuration stuff -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    
  <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>
  <appSettings>
    <add key="CustomOrderedListWFName" value="SystemWFCustomOrderedList"/>
    <add key="CustomOrderedListWFVersion" value="1"/>
    <add key="ClientSettingsProvider.ServiceUri" value=""/>
    <add key="TAAppSvrName" value="localhost"/>
    <add key="TAAppSvrUserName" value="System"/>
    <add key="TAAppSvrPassword" value="system2600"/>
    <add key="TAAppSvrEnvironment" value="0"/>
    <add key="TAAppSvrRemoteUserFlag" value="false"/>
    <!--
		For EXCEL 2003
		ExcelConnectionStringProvider - value="Microsoft.Jet.OLEDB.4.0;"
		ExcelConnectionStringProperties - value="Excel 8.0;"
		
		For EXCEL 2007
		ExcelConnectionStringProvider - value="Microsoft.ACE.OLEDB.12.0;"
		ExcelConnectionStringProperties - value="Excel 12.0 Xml;"

    <add key="ExcelConnectionStringProvider" value="Microsoft.ACE.OLEDB.12.0;"/>
		<add key="ExcelConnectionStringProperties" value="Excel 12.0 Xml;"/>
		-->

    <add key="ExcelConnectionStringProvider" value="Microsoft.Jet.OLEDB.4.0;"/>
    <add key="ExcelConnectionStringProperties" value="Excel 8.0;"/>

  </appSettings>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri=""/>
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400"/>
      </providers>
    </roleManager>
  </system.web>
</configuration>
