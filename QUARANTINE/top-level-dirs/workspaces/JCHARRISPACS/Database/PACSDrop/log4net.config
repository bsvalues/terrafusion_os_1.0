<?xml version="1.0" encoding="utf-8" ?>

<!-- configure our logging output -->
<log4net>
	<!-- file logging configuration -->
	<appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
		<file value="TrueAutomation.Services.Host." />
		<param name="AppendToFile" value="true" />
		<param name="RollingStyle" value="Date" />
		<param name="DatePattern" value="yyyy.MM.dd'.log'" />
		<param name="StaticLogFileName" value="false" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger - %message%newline"/>
		</layout>
	</appender>

	<!--appender name="UdpAppender"
									type="log4net.Appender.UdpAppender">
		<param name="RemoteAddress"
							value="127.0.0.1" />
		<param name="RemotePort"
							value="8088" />
		<layout type="log4net.Layout.XmlLayout">
			<param name="Prefix"
								value="" />
		</layout>
	</apender-->
	
	<appender name="ForwardingAppender" type="log4net.Appender.ForwardingAppender" >
		<threshold value="INFO"/>
		<appender-ref ref="ColoredConsoleAppender" />
	</appender>
	
	<!-- console logging configuration -->
	<appender name="ColoredConsoleAppender" type="log4net.Appender.ColoredConsoleAppender">
		<target value="Console.Error" />
		<mapping>
			<level value="FATAL" />
			<foreColor value="Red" />
			<backColor value="White" />
		</mapping>
		<mapping>
			<level value="ERROR" />
			<foreColor value="Red, HighIntensity" />
		</mapping>
		<mapping>
			<level value="WARN" />
			<foreColor value="Yellow, HighIntensity" />
		</mapping>
		<mapping>
			<level value="INFO" />
			<foreColor value="Cyan, HighIntensity" />
		</mapping>
		<mapping>
			<level value="DEBUG" />
			<foreColor value="Green, HighIntensity" />
		</mapping>
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
		</layout>
	</appender>
	
	<!-- configure basic logging for everyone -->
	<root>
		<!-- value of level may be ALL, DEBUG, INFO, WARN, ERROR, FATAL, or OFF -->
		<level value="INFO"/>
		<appender-ref ref="ForwardingAppender" />
		<appender-ref ref="RollingLogFileAppender" />
		
	</root>
	
	<!-- configure NHibernate logging -->
	<logger name="NHibernate" additive="false">
		<level value="ERROR" />
		<appender-ref ref="ForwardingAppender" />
		

	</logger>

	<logger name="NHibernate.SQL">
		<level value="INFO" />
		<appender-ref ref="RollingLogFileAppender" />
		<appender-ref ref="ForwardingAppender" />
		<appender-ref ref="ColoredConsoleAppender" />

	</logger>

	<!-- configure Rhino logging -->
	<logger name="Rhino.ServiceBus" additive="false">
		<level value="INFO" />
		<appender-ref ref="ForwardingAppender" />
		<appender-ref ref="RollingLogFileAppender" />
		
	</logger>
	<!-- configure Rhino logging -->
	<logger name="Rhino.Queues" additive="false">
		<level value="ERROR" />
		<appender-ref ref="ForwardingAppender" />
		<appender-ref ref="RollingLogFileAppender" />
		<!-->appender-ref ref="UdpAppender" /-->

		

	</logger>
</log4net>
