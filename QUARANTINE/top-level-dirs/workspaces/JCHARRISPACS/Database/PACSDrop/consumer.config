<?xml version="1.0"?>
<castle>
  <facilities>
    <!-- add our workflow service bus -->
    <facility id="rhino.esb">
      <bus threadCount="1"
           numberOfRetries="5"
           endpoint="msmq://localhost/" name="Consumer" />
      <messages>
        <!-- XXX FIXME revisit this! -->
        <add name="TrueAutomation.WorkflowService.Messages"
             endpoint="msmq://localhost/trueautomation.workflowservice" />
      </messages>
    </facility>
  </facilities>
</castle>