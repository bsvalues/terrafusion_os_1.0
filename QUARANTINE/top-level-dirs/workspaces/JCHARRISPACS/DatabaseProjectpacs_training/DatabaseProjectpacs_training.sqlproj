<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="0.1.12-preview" />
  <PropertyGroup>
    <Name>DatabaseProjectpacs_training</Name>
    <ProjectGuid>{612A138F-A553-4A85-A9B2-1F72FB7FF7DD}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql150DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <TreatTSqlWarningsAsErrors>False</TreatTSqlWarningsAsErrors>
    <SuppressTSqlWarnings></SuppressTSqlWarnings>
    <SuppressMissingDependenciesErrors>True</SuppressMissingDependenciesErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.Dacpacs.Master" Version="160.2.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tables-only build matching pacs_oltp approach.
         StoredProcedures contain inline GRANTs referencing domain-specific roles
         (tracking_writer, pacsnonprivy, CO\*, etc.) that cause SQL71501 build
         errors when Security files are excluded. Exclude them to produce a
         deployable tables-only DACPAC. Views, Functions, Security, and
         Assemblies also excluded for the same reasons as pacs_oltp. -->
    <Build Remove="dbo/Views/**/*.sql" />
    <Build Remove="**/Views/**/*.sql" />
    <Build Remove="Security/**/*.sql" />
    <Build Remove="Assemblies/**/*.sql" />
    <Build Remove="dbo/StoredProcedures/**/*.sql" />
    <Build Remove="**/StoredProcedures/**/*.sql" />
    <Build Remove="dbo/Functions/**/*.sql" />
    <Build Remove="**/Functions/**/*.sql" />
    <!-- Exclude problematic tables (same as pacs_oltp) -->
    <Build Remove="dbo/Tables/reet_webportal_import.sql" />
    <Build Remove="dbo/Tables/reet_webportal_import_property.sql" />
    <Build Remove="dbo/Tables/reet_webportal_import_account.sql" />
    <Build Remove="dbo/Tables/reet_wac_code.sql" />
    <Build Remove="dbo/Tables/user_input_query_idlist.sql" />
    <!-- Additional table exclusions needed for pacs_training (refs to excluded objects) -->
    <Build Remove="dbo/Tables/address.sql" />
    <Build Remove="dbo/Tables/pending_address.sql" />
    <Build Remove="dbo/Tables/reet.sql" />
    <Build Remove="dbo/Tables/sale.sql" />
    <Build Remove="dbo/Tables/user_input_query.sql" />
  </ItemGroup>
  <Target Name="BeforeBuild">
    <Delete Files="$(BaseIntermediateOutputPath)\project.assets.json" />
  </Target>
</Project>