{
  "folders": [
    {
      "path": "../marketplace/RAGPanel/rag-engine",
      "name": "\ud83e\udde0 RAG Engine Core"
    },
    {
      "path": "../marketplace/RAGPanel/document-processing",
      "name": "\ud83d\udcc4 Document Processing"
    },
    {
      "path": "../marketplace/RAGPanel/knowledge-base",
      "name": "\ud83d\udcda Knowledge Base"
    },
    {
      "path": "../marketplace/RAGPanel/vector-database",
      "name": "\ud83d\udd0d Vector Database"
    },
    {
      "path": "../marketplace/RAGPanel/ai-search",
      "name": "\ud83e\udd16 AI-Powered Search"
    },
    {
      "path": "../marketplace/RAGPanel/embedding-service",
      "name": "\ud83c\udfaf Embedding Service"
    },
    {
      "path": "../marketplace/RAGPanel/testing",
      "name": "\ud83e\uddea RAG Tests"
    },
    {
      "path": "../SDK",
      "name": "\ud83d\udce6 Platform SDK (read-only)"
    },
    {
      "path": "../backend",
      "name": "\ud83d\udd27 Shared Backend (read-only)"
    },
    {
      "path": "../docs/ragpanel",
      "name": "\ud83d\udcda RAG Docs"
    },
    {
      "path": "../config",
      "name": "\u2699\ufe0f Config (shared)"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/out": true,
      "**/.pytest_cache": true,
      "**/__pycache__": true,
      "../marketplace/*/": true,
      "!../marketplace/RAGPanel": false,
      "../frontend": true,
      "../backend": true,
      "../os-platform": true,
      "../terrafusion-cos": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/out": true,
      "../frontend": true,
      "../backend": true,
      "../os-platform": true
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "python.defaultInterpreter": "./marketplace/RAGPanel/.venv/bin/python",
    "typescript.tsdk": "node_modules/typescript/lib",
    "eslint.workingDirectories": [
      "./marketplace/RAGPanel/ai-search"
    ],
    "terrafusion.sync": {
      "autoSync": true,
      "syncInterval": 20,
      "conflictResolution": "prompt",
      "sharedState": {
        "backend": "read-only",
        "sdk": "read-only",
        "config": "shared-write"
      },
      "ragIntegration": true
    },
    "terrafusion.rag": {
      "enableRAG": true,
      "documentProcessing": true,
      "vectorDatabase": true,
      "embeddingService": true,
      "aiSearch": true,
      "knowledgeBase": true,
      "retrievalMode": "hybrid"
    },
    "terrafusion.ai": {
      "llmProvider": "azure-openai",
      "embeddingModel": "text-embedding-ada-002",
      "ragModel": "gpt-4-turbo",
      "vectorEngine": "pinecone",
      "searchEngine": "elasticsearch"
    },
    "terrafusion.compliance": {
      "fismaMode": "MODERATE",
      "nist80053": true,
      "dataPrivacy": true,
      "informationGovernance": true,
      "auditTrail": "comprehensive"
    },
    "terrafusion.performance": {
      "vectorSearch": "optimized",
      "embeddingCache": true,
      "queryOptimization": true,
      "resultCaching": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.debugpy",
      "ms-python.pylint",
      "ms-python.flake8",
      "ms-toolsai.jupyter",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "streetsidesoftware.code-spell-checker",
      "ms-azuretools.vscode-docker",
      "redhat.vscode-yaml",
      "ms-vscode.vscode-json"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Start RAG Engine",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/RAGPanel/rag-engine",
        "program": "rag_server.py",
        "console": "integratedTerminal",
        "env": {
          "TERRAFUSION_SERVICE": "ragpanel",
          "RAG_MODE": "development",
          "VECTOR_DB_ENABLED": "true"
        }
      },
      {
        "name": "Debug Document Processing",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/RAGPanel/document-processing",
        "program": "document_processor.py",
        "console": "integratedTerminal",
        "env": {
          "DOC_DEBUG": "true",
          "PROCESSING_MODE": "batch"
        }
      },
      {
        "name": "Debug Embedding Service",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/RAGPanel/embedding-service",
        "program": "embedding_server.py",
        "console": "integratedTerminal",
        "env": {
          "EMBEDDING_DEBUG": "true",
          "OPENAI_API_KEY": "${env:OPENAI_API_KEY}"
        }
      },
      {
        "name": "Start AI Search Interface",
        "type": "node",
        "request": "launch",
        "cwd": "${workspaceFolder}/marketplace/RAGPanel/ai-search",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "console": "integratedTerminal",
        "env": {
          "SEARCH_DEBUG": "true",
          "RAG_ENGINE_URL": "http://localhost:8080"
        }
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build RAG Panel",
        "type": "shell",
        "command": "python",
        "args": [
          "setup.py",
          "build"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/RAGPanel"
        },
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Test RAG Panel",
        "type": "shell",
        "command": "pytest",
        "args": [
          "tests/",
          "-v"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/RAGPanel"
        },
        "problemMatcher": [],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      },
      {
        "label": "Start Vector Database",
        "type": "shell",
        "command": "docker-compose",
        "args": [
          "up",
          "-d",
          "pinecone-local"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/RAGPanel"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Process Documents",
        "type": "shell",
        "command": "python",
        "args": [
          "process_documents.py",
          "--batch"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/RAGPanel/document-processing"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Index Knowledge Base",
        "type": "shell",
        "command": "python",
        "args": [
          "index_knowledge.py"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/RAGPanel/knowledge-base"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Test RAG Query",
        "type": "shell",
        "command": "python",
        "args": [
          "test_rag.py",
          "--query",
          "${input:ragQuery}"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/RAGPanel/rag-engine"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "Generate Embeddings",
        "type": "shell",
        "command": "python",
        "args": [
          "generate_embeddings.py"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/RAGPanel/embedding-service"
        },
        "problemMatcher": [],
        "group": "none"
      },
      {
        "label": "RAG Performance Test",
        "type": "shell",
        "command": "python",
        "args": [
          "performance_test.py"
        ],
        "options": {
          "cwd": "${workspaceFolder}/marketplace/RAGPanel/testing"
        },
        "problemMatcher": [],
        "group": "none"
      }
    ]
  },
  "inputs": [
    {
      "id": "ragQuery",
      "description": "Enter RAG query:",
      "default": "What are the property assessment procedures?",
      "type": "promptString"
    }
  ]
}