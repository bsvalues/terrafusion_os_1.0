{
  "folders": [
    { "path": "../frontend", "name": "🎨 Frontend Application" },
    { "path": "../platform/design-system", "name": "🎨 Design System" },
    { "path": "../SDK", "name": "📦 Component SDK" },
    { "path": "../tests", "name": "🧪 Frontend Tests" },
    { "path": "../config", "name": "⚙️ Configuration" }
  ],
  "settings": {
    "workbench.colorCustomizations": {
      "titleBar.activeBackground": "#00FFEE",
      "titleBar.activeForeground": "#0A0E1A"
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/backend": true,
      "**/bin": true,
      "**/obj": true,
      "**/dist": true,
      "**/build": true
    },
    "search.exclude": {
      "**/backend": true,
      "**/node_modules": true,
      "**/dist": true
    },
    "typescript.preferences.preferTypeOnlyAutoImports": true,
    "typescript.suggest.includeCompletionsForModuleExports": false,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "eslint.workingDirectories": ["../frontend"],
    "terrafusion.role": "frontend_development",
    "terrafusion.responsibility": "react_quantum_ui"
  },
  "extensions": {
    "recommendations": [
      // === React 18 & TypeScript - 15 extensions ===
      "ms-vscode.vscode-typescript-next",
      "dsznajder.es7-react-js-snippets",
      "wix.vscode-import-cost",
      "formulahendry.auto-rename-tag",
      "pmneo.tsimporter",
      "chakrounanas.turbo-console-log",
      "steoates.autoimport",
      "xabikos.javascriptsnippets",
      "planbcoding.vscode-react-refactor",
      "burkeholland.simple-react-snippets",
      "rodrigovallades.es7-react-js-snippets",
      "jamesbirtles.svelte-vscode",
      "styled-components.vscode-styled-components",
      "csstools.postcss",
      "jpoissonnier.vscode-styled-components",

      // === Tailwind CSS & Styling - 8 extensions ===
      "bradlc.vscode-tailwindcss",
      "sudoaugustin.tailwindcss-utilities",
      "bourhaouta.tailwindshades",
      "austenc.tailwind-docs",
      "maciekkoks.tailwindcss-color-preview",
      "pranaygp.vscode-css-peek",
      "stylelint.vscode-stylelint",
      "zignd.html-css-class-completion",

      // === Testing & Quality - 12 extensions ===
      "ms-playwright.playwright",
      "orta.vscode-jest",
      "firsttris.vscode-jest-runner",
      "vitest.explorer",
      "hbenl.vscode-test-explorer",
      "ryanluker.vscode-coverage-gutters",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "sonarsource.sonarlint-vscode",
      "streetsidesoftware.code-spell-checker",
      "editorconfig.editorconfig",
      "usernamehw.errorlens",

      // === Storybook & Component Development - 6 extensions ===
      "chromatic.chromatic-addon",
      "unifiedjs.vscode-mdx",
      "silvenon.mdx",
      "yoavbls.pretty-ts-errors",
      "lokalise.i18n-ally",
      "antfu.iconify",

      // === Build Tools & DevOps - 8 extensions ===
      "ms-azuretools.vscode-docker",
      "ms-vscode-remote.remote-containers",
      "github.vscode-github-actions",
      "eamodio.gitlens",
      "gruntfuggly.todo-tree",
      "donjayamanne.githistory",
      "github.vscode-pull-request-github",
      "mhutchie.git-graph",

      // === Accessibility & UX - 6 extensions ===
      "deque-systems.vscode-axe-linter",
      "maxvanderschee.web-accessibility",
      "webhint.vscode-webhint",
      "vincaslt.highlight-matching-tag",
      "naumovs.color-highlight",
      "kamikillerto.vscode-colorize",

      // === Productivity & Utilities - 10 extensions ===
      "christian-kohler.path-intellisense",
      "formulahendry.auto-close-tag",
      "coenraads.bracket-pair-colorizer-2",
      "oderwat.indent-rainbow",
      "aaron-bond.better-comments",
      "wayou.vscode-todo-highlight",
      "alefragnani.bookmarks",
      "hediet.vscode-drawio",
      "earshinov.sort-lines-by-selection",
      "ms-vsliveshare.vsliveshare",

      // === AI & Documentation - 5 extensions ===
      "github.copilot",
      "github.copilot-chat",
      "visualstudioexptteam.vscodeintellicode",
      "yzhang.markdown-all-in-one",
      "bierner.markdown-mermaid"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🔧 Build: Production",
        "type": "shell",
        "command": "npm run build",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": "$tsc"
      },
      {
        "label": "🔧 Build: Clean Build Zone",
        "type": "shell",
        "command": "npm run build",
        "options": { "cwd": "${workspaceFolder}/_CLEAN_BUILD_ZONE" },
        "group": "build"
      },
      {
        "label": "🚀 Dev: Start Vite Server",
        "type": "shell",
        "command": "npm run dev",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "isBackground": true,
        "problemMatcher": {
          "pattern": { "regexp": "." },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*VITE.*$",
            "endsPattern": "^.*Local:.*$"
          }
        }
      },
      {
        "label": "📚 Storybook: Start Dev",
        "type": "shell",
        "command": "npm run storybook",
        "options": { "cwd": "${workspaceFolder}/_CLEAN_BUILD_ZONE" },
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "📚 Storybook: Build Static",
        "type": "shell",
        "command": "npm run build-storybook",
        "options": { "cwd": "${workspaceFolder}/_CLEAN_BUILD_ZONE" },
        "group": "build"
      },
      {
        "label": "🧪 Test: Unit Tests",
        "type": "shell",
        "command": "npm run test:unit",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "group": { "kind": "test", "isDefault": true }
      },
      {
        "label": "🧪 Test: E2E Tests",
        "type": "shell",
        "command": "npm run test:e2e",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "group": "test"
      },
      {
        "label": "🧪 Test: Coverage Report",
        "type": "shell",
        "command": "npm run test:coverage",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "group": "test"
      },
      {
        "label": "🔍 Quality: Lint & Format",
        "type": "shell",
        "command": "npm run quality",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "group": "test"
      },
      {
        "label": "🔍 Quality: Type Check",
        "type": "shell",
        "command": "npm run type-check",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "group": "test"
      },
      {
        "label": "🛡️ Compliance: Government Validation",
        "type": "shell",
        "command": "npm run government:compliance",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "group": "test"
      },
      {
        "label": "🔒 Security: Audit Dependencies",
        "type": "shell",
        "command": "npm audit",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "group": "test"
      },
      {
        "label": "🧹 Clean: Artifacts",
        "type": "shell",
        "command": "rm -rf dist node_modules/.vite",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "group": "none"
      },
      {
        "label": "📦 Install: Dependencies",
        "type": "shell",
        "command": "npm install",
        "options": { "cwd": "${workspaceFolder}/frontend" },
        "group": "none"
      },
      {
        "label": "📚 Docs: Generate API Docs",
        "type": "shell",
        "command": "npm run docs:api",
        "options": { "cwd": "${workspaceFolder}/_CLEAN_BUILD_ZONE" },
        "group": "none"
      },
      {
        "label": "📚 Docs: Sync Design Tokens",
        "type": "shell",
        "command": "npm run docs:tokens",
        "options": { "cwd": "${workspaceFolder}/_CLEAN_BUILD_ZONE" },
        "group": "none"
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug: Chrome",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:5173",
        "webRoot": "${workspaceFolder}/frontend",
        "sourceMaps": true,
        "preLaunchTask": "🚀 Dev: Start Vite Server",
        "userDataDir": "${workspaceFolder}/.vscode/chrome-debug",
        "runtimeArgs": [
          "--auto-open-devtools-for-tabs"
        ]
      },
      {
        "name": "Debug: Edge",
        "type": "msedge",
        "request": "launch",
        "url": "http://localhost:5173",
        "webRoot": "${workspaceFolder}/frontend",
        "sourceMaps": true,
        "preLaunchTask": "🚀 Dev: Start Vite Server"
      },
      {
        "name": "Debug: Vite Server",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "dev"],
        "cwd": "${workspaceFolder}/frontend",
        "console": "integratedTerminal"
      },
      {
        "name": "Attach: Node Process",
        "type": "node",
        "request": "attach",
        "port": 9229,
        "skipFiles": ["<node_internals>/**"],
        "restart": true
      },
      {
        "name": "Debug: Jest Tests",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "test:unit", "--", "--runInBand"],
        "cwd": "${workspaceFolder}/frontend",
        "console": "integratedTerminal"
      },
      {
        "name": "Debug: Playwright Tests",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/frontend/node_modules/.bin/playwright",
        "args": ["test", "--debug"],
        "cwd": "${workspaceFolder}/frontend",
        "console": "integratedTerminal"
      },
      {
        "name": "Debug: Storybook",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:6006",
        "webRoot": "${workspaceFolder}/_CLEAN_BUILD_ZONE",
        "preLaunchTask": "📚 Storybook: Start Dev"
      }
    ]
  }
}
