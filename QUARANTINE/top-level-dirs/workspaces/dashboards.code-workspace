{
  "settings": {
    "workbench.iconTheme": "terrafusion-icons",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    },
    "editor.formatOnSave": true,
    "terrafusion.focus": "Real-time Dashboards & Widgets",
    "terrafusion.team": "Dashboard & Widgets Team",
    "workbench.colorTheme": "TerraFusion Dark"
  },
  "folders": [
    {
      "path": "../terra-fusion-dashboard",
      "name": "terra-fusion-dashboard"
    },
    {
      "path": "../monitoring",
      "name": "monitoring"
    },
    {
      "path": "../analytics-platform",
      "name": "analytics-platform"
    }
  ],
  "extensions": {
    "recommendations": [
      "ms-vscode.vscode-typescript-next",
      "bradlc.vscode-tailwindcss",
      "ms-dotnettools.csharp",
      "ms-python.python",
      "ms-vscode.powershell",
      "GitHub.copilot",
      "terrafusion.ai-agent-tools"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Dashboards",
        "type": "node",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build Dashboards",
        "type": "shell",
        "command": "echo 'Build task for ${workspaceFolder}'",
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Test Dashboards",
        "type": "shell",
        "command": "echo 'Test task for ${workspaceFolder}'",
        "problemMatcher": [],
        "group": {
          "kind": "test",
          "isDefault": true
        }
      }
    ]
  }
}
