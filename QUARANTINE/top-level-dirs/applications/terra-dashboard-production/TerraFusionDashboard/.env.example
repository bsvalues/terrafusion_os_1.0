# TerraFusion Environment Configuration Template
# Copy this file to .env and customize for your environment

# Application Configuration
NODE_ENV=development
PORT=5000
VITE_PORT=3000

# Application Settings
APP_NAME=TerraFusion
APP_VERSION=1.0.0

# County Configuration
DEFAULT_COUNTY=benton
COUNTY_DATA_SYNC_INTERVAL=3600000

# Feature Flags
ENABLE_AI_AGENTS=true
ENABLE_WEBSOCKETS=true
ENABLE_MONITORING=true
ENABLE_ANALYTICS=true

# Development Settings
DEBUG_MODE=true
LOG_LEVEL=info

# Security Settings (use strong values in production)
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3000

# Database Configuration
# DATABASE_URL is automatically provided by Replit PostgreSQL service
# For local development, use: postgresql://username:password@localhost:5432/terrafusion

# External Services (add actual keys to secrets/.env.secrets)
# OPENAI_API_KEY=sk-your-key-here
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# GOOGLE_MAPS_API_KEY=AIza...
# MAPBOX_ACCESS_TOKEN=pk...
# SENDGRID_API_KEY=SG...
# BENTON_COUNTY_API_KEY=...
# ARCGIS_API_TOKEN=...
# SENTRY_DSN=https://...
# MIXPANEL_TOKEN=...