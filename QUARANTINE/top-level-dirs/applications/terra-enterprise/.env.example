# TerraFusion Enterprise Environment Variables

# Database Configuration
POSTGRES_PASSWORD=secure_password_change_in_production
DATABASE_URL=postgresql://terrafusion:secure_password@localhost:5432/terrafusion_enterprise

# Authentication
JWT_SECRET=your_super_secure_jwt_secret_here_change_in_production

# AI Integration
OPENAI_API_KEY=your_openai_api_key_here

# Monitoring
GRAFANA_PASSWORD=admin_change_in_production

# Application URLs
ORCHESTRATOR_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# County Configuration
COUNTY_NAME=Benton County
COUNTY_STATE=WA
COUNTY_FIPS=53005
