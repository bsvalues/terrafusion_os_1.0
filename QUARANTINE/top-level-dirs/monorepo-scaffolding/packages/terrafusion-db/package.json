{
  "name": "@terrafusion/db",
  "version": "1.0.0",
  "description": "TerraFusion Database Layer - County Data Isolation",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "migrate": "node dist/migrations/run.js",
    "migrate:generate": "node dist/migrations/generate.js",
    "db:seed": "node dist/seeds/run.js",
    "clean": "rimraf dist"
  },
  "keywords": [
    "terrafusion",
    "database",
    "orm",
    "county-isolation",
    "postgres",
    "government",
    "migrations"
  ],
  "author": "TerraFusion Elite Government OS Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "pg": "^8.11.0",
    "drizzle-orm": "^0.29.0",
    "drizzle-kit": "^0.20.0",
    "postgres": "^3.4.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0",
    "date-fns": "^3.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.10.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "rollup": "^4.0.0",
    "jest": "^29.5.0",
    "rimraf": "^5.0.0"
  }
}
