{
  "name": "terrafusion-os-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TerraFusion OS - Government AI Operating System Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "echo 'Building championship services...' && cargo build --release",
