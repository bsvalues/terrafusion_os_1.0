{
  "name": "TerraFusion Integration & Readiness Audit",
  "version": "3.1.0",
  "authority": "TerraFusion-OS Program Office",
  "target_client": {
    "county": "Benton County",
    "state": "WA",
    "environments": ["dev", "staging", "prod"],
    "default_env": "staging",
    "data_domains": ["Assessor", "Treasurer", "GIS", "PublicRecords", "Permitting"]
  },

  "start_here": [
    "Run `npm run ai-training` first (index codebase, hydrate embeddings, load module registry).",
    "Use the 11-layer protection system before responding to any request.",
    "Follow the AI agent validation pipeline end-to-end before marking any module READY."
  ],

  "system_paths": {
    "monorepo_root": ".",
    "module_registry": "registry/MODULES.json",
    "marketplace_manifest_dir": "marketplace/manifests",
    "trust_fabric": "trust-fabric/",
    "ui_apps_dir": "apps/",
    "services_dir": "services/",
    "ops_scripts": "ops/scripts/",
    "docs_root": "docs/",
    "k8s": "deploy/k8s/",
    "compose": "deploy/compose/",
    "dashboards": "observability/grafana/",
    "policies": "policies/"
  },

  "required_pipelines": {
    "protection_11_layer": [
      "StaticCodeScan",
      "SecretsLeakScan",
      "LicenseCompliance",
      "SBOMGen",
      "SLSA-Attestation",
      "ContainerSign",
      "VulnScan",
      "IaCPolicyCheck",
      "DependencyPinning",
      "ProvenanceRecord",
      "RuntimePolicyEnforce"
    ],
    "agent_validation_pipeline": [
      "RepoIndexing",
      "ConfigResolve(.env, secrets, feature-flags)",
      "SchemaSync(DB/PostGIS/Prisma/EFCore)",
      "BuildAll",
      "Unit+ComponentTests",
      "IntegrationTests(API↔DB↔Queue)",
      "E2E-UI(Playwright)",
      "Lighthouse+A11y(508/WCAG2.1 AA)",
      "Security(NIST-800-53-lite, OWASP ASVS)",
      "TrustFabric(SBOM, attestations, cosign-verify)",
      "Perf(Bench/Load/Apdex SLO)",
      "Observability(health, logs, traces, metrics)",
      "DisasterRecovery(backup/restore smoke)",
      "GoNoGoGate"
    ]
  },

  "acceptance_thresholds": {
    "overall_min": 0.97,
    "gates": {
      "tests_pass_rate": 0.98,
      "lighthouse_performance": 0.80,
      "lighthouse_accessibility": 0.95,
      "api_contract_coverage": 1.0,
      "security_findings_blockers": 0,
      "p0_open_defects": 0
    }
  },

  "scoring_weights": {
    "os_integration": 0.20,
    "marketplace_compliance": 0.15,
    "trust_fabric_attestation": 0.15,
    "ui_ux_readiness": 0.15,
    "backend_stability": 0.15,
    "data_integration_quality": 0.10,
    "observability_slos": 0.10
  },

  "module_readiness_checklist": [
    "Has marketplace manifest and passes schema validation",
    "Builds clean in CI (no warnings escalated as errors)",
    "All unit/integration/e2e tests pass with coverage ≥ 85%",
    "API contract matches OpenAPI/GraphQL schema snapshots",
    "Service registers in OS service catalog; port & health endpoints OK",
    "Trust Fabric: SBOM present; cosign verify OK; SLSA attestation stored",
    "UI present in TerraFusion Interface; Playwright smoke suite green",
    "Lighthouse: Perf ≥ 80, A11y ≥ 95, Best-Practices ≥ 95, SEO ≥ 90",
    "Section 508/WCAG2.1 AA checks pass (axe-core/pa11y)",
    "Config via env/secret manager; no hardcoded secrets",
    "PostGIS/DB migrations forward & rollback clean",
    "Observability: /health, /metrics, tracing spans, structured logs",
    "Disaster recovery: seed data + backup/restore smoke succeeds",
    "Security: OWASP ASVS checks; zero High/Critical vulns",
    "Docs: README, ops runbook, API docs, changelog up to date"
  ],

  "marketplace_validation_rules": {
    "manifest_schema": "policies/marketplace-manifest.schema.json",
    "required_fields": [
      "name","version","id","category","permissions","capabilities",
      "api.contract","ui.entry","screenshots","pricing.tier","support.contact"
    ],
    "plugin_sdk_min_version": ">=2.5.0",
    "permission_model": ["least-privilege","scoped-tokens","tenant-aware"],
    "signing": ["cosign_attestation_required", "hashdeep_verification"]
  },

  "trust_fabric_requirements": {
    "sbom_format": ["CycloneDX-json"],
    "attestations": ["build","test","scan","deploy"],
    "sigstore": { "cosign_verify": true, "rekor_log": true },
    "provenance": { "slsa_level": "SLSA-2+ target" }
  },

  "ui_validation": {
    "playwright_suite": "apps/tests/e2e",
    "lighthouse_budget": "policies/lighthouse-budget.json",
    "accessibility_tools": ["axe-core", "pa11y-ci"],
    "design_tokens": "apps/design-system/tokens.json",
    "brand_rules": "policies/brand/brand-rules.md"
  },

  "security_validation": {
    "static_analysis": ["semgrep","trivy","gitleaks"],
    "dep_scan": ["trivy","npm audit --production","cargo audit","dotnet list package --vulnerable"],
    "nist_controls_min": ["AC","AU","CM","CP","IA","IR","SC","SI"],
    "owasp_asvs_min_level": "L2"
  },

  "observability_slo": {
    "apdex": ">=0.90",
    "p95_latency_ms": { "ui": 1200, "api": 300 },
    "error_rate_pct": { "ui": 0.5, "api": 0.2 },
    "uptime_pct_30d": 99.5
  },

  "commands": {
    "prep": [
      "npm run ai-training",
      "npm run ai-agent-briefing",
      "npm run monitor-agents"
    ],
    "build_test": [
      "make build-all || npm run build:all",
      "make test-all || npm run test:all",
      "npm run e2e",
      "npm run lighthouse:audit",
      "npm run a11y:check"
    ],
    "security_trust": [
      "npm run sbom:gen",
      "npm run sign:containers",
      "npm run verify:cosign",
      "npm run scan:full"
    ],
    "deploy_check": [
      "docker compose -f deploy/compose/stack.yml up -d",
      "kubectl apply -k deploy/k8s/overlays/${ENV}",
      "kubectl rollout status deploy/*",
      "curl -fsSL http://localhost:${PORT}/health"
    ],
    "observability": [
      "npm run seed:demo-data -- --tenant=benton",
      "npm run check:slos",
      "npm run backup:smoke && npm run restore:smoke"
    ]
  },

  "module_catalog_source_of_truth": {
    "file": "registry/MODULES.json",
    "schema": {
      "id": "string",
      "name": "string",
      "category": "Core|Essential|Extended",
      "service": { "path": "string", "port": "number", "health": "string" },
      "ui": { "path": "string", "entry": "string", "routes": "string[]" },
      "apis": [{ "type": "REST|GraphQL", "spec": "path", "version": "string" }],
      "db": { "migrations": "path", "requires_postgis": "boolean" },
      "marketplace": { "manifest": "path", "sdk_version": "string" },
      "trust_fabric": { "sbom": "path", "attestations": "path[]" },
      "status": "DRAFT|INTEGRATING|READY|BLOCKED",
      "owners": [{ "team": "string", "contact": "email" }],
      "tags": "string[]"
    }
  },

  "example_module_entry": {
    "id": "tf.gis.parcel-viewer",
    "name": "Parcel Viewer",
    "category": "Core",
    "service": { "path": "services/parcel-viewer", "port": \${{TF_PORT_5310:-5310}}, "health": "/health" },
    "ui": { "path": "apps/parcel-viewer", "entry": "apps/parcel-viewer/src/main.tsx", "routes": ["/gis/parcel/:id"] },
    "apis": [{ "type": "GraphQL", "spec": "services/parcel-viewer/schema.graphql", "version": "1.2.0" }],
    "db": { "migrations": "services/parcel-viewer/migrations", "requires_postgis": true },
    "marketplace": { "manifest": "marketplace/manifests/parcel-viewer.json", "sdk_version": "2.7.1" },
    "trust_fabric": { "sbom": "trust-fabric/sbom/parcel-viewer.cdx.json", "attestations": ["trust-fabric/attest/parcel-viewer/*.json"] },
    "status": "INTEGRATING",
    "owners": [{ "team": "GIS", "contact": "gis-team@terrafusion.local" }],
    "tags": ["Benton", "PostGIS", "Map", "Assessor"]
  },

  "audit_flow": [
    "Load MODULES.json; for each module, run gated checks in parallel with dependency ordering.",
    "Fail-fast on P0 issues; open issues with labels: P0/P1, domain, module-id.",
    "Aggregate metrics, compute weighted readiness, produce Go/No-Go per module.",
    "If READY and signed: publish to Marketplace (staging), then promote to prod on change freeze window.",
    "Generate Benton County Demo Dataset seeds and run cross-module scenarios."
  ],

  "cross_module_scenarios": [
    "Parcel→Valuation→Appeals→Tax Roll pipeline executes successfully",
    "Public Records request traverses workflow and exports redacted PDF",
    "Treasurer payment posts, reconciles, and reflects in taxpayer portal",
    "GIS layer change propagates to UI and API caches within SLA",
    "User RBAC: Public/User/Assessor/Realtor/CountyAdmin happy-path + abuse-path"
  ],

  "artifacts_to_emit": {
    "reports": [
      "reports/integration-readiness-summary.md",
      "reports/module-matrix.csv",
      "reports/security-trust-fabric-report.md",
      "reports/ui-lighthouse-report.html",
      "reports/slo-validation.json"
    ],
    "automation": [
      "ops/generated/k8s-readyset-${ENV}.yaml",
      "ops/generated/compose-readyset.yml",
      "ops/generated/promote-plan.md"
    ],
    "tickets": {
      "provider": "GitHub",
      "labels": ["terraformation","integration","trust-fabric","benton"],
      "assignees_by_domain": {
        "GIS": ["@team-gis"],
        "Valuation": ["@team-valuation"],
        "Treasurer": ["@team-treasury"]
      }
    }
  },

  "decision_gates": [
    { "name": "Gate A - Build & Tests", "require": ["BuildAll","Unit+Integration≥0.98 pass"] },
    { "name": "Gate B - Security & Trust", "require": ["Zero High/Critical", "Cosign Verify", "SBOM present"] },
    { "name": "Gate C - UI/UX & A11y", "require": ["Playwright green", "A11y ≥ 0.95", "Brand rules pass"] },
    { "name": "Gate D - Data & Migrations", "require": ["Fwd/Rbk clean", "Seed OK"] },
    { "name": "Gate E - Observability & SLOs", "require": ["Apdex ≥ 0.90", "p95 OK", "Uptime ≥ 99.5% (rolling)"] },
    { "name": "Gate F - Go/No-Go", "require": ["WeightedScore ≥ 0.97", "P0=0"] }
  ],

  "final_validation_for_benton": [
    "Run county-specific config suite: `npm run county:apply -- --tenant=benton`",
    "Execute cross-module scenarios with Benton demo/seed data",
    "Publish signed artifacts to Marketplace (prod) behind feature flags",
    "Flip progressive rollout to 10%/30%/100% with error budget guardrails",
    "Archive all provenance & reports in trust-fabric/ledger/"
  ]
}

