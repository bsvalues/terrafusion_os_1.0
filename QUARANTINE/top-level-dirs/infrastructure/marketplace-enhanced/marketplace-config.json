{
  "marketplace": {
    "name": "Terrafusion Plugin Marketplace",
    "version": "1.0.0",
    "description": "Dynamic plugin marketplace for Terrafusion ecosystem",
    "categories": [
      "Visualization",
      "Analytics",
      "Data Processing",
      "Integration",
      "Reporting"
    ],
    "sidebar": {
      "enabled": true,
      "position": "right",
      "width": 320,
      "sections": [
        {
          "id": "installed",
          "title": "Installed Plugins",
          "icon": "📦",
          "filter": "enabled:true"
        },
        {
          "id": "featured",
          "title": "Featured",
          "icon": "⭐",
          "filter": "featured:true"
        },
        {
          "id": "all",
          "title": "All Plugins",
          "icon": "🔍",
          "filter": "*"
        }
      ]
    },
    "loader": {
      "pluginDirectory": "/marketplace/plugins/",
      "autoLoad": true,
      "hotReload": true,
      "cacheEnabled": true
    },
    "ui": {
      "showInMainNav": true,
      "navLabel": "Marketplace",
      "navIcon": "🛒",
      "theme": {
        "primary": "#1e40af",
        "secondary": "#7c3aed",
        "accent": "#10b981"
      }
    }
  }
}