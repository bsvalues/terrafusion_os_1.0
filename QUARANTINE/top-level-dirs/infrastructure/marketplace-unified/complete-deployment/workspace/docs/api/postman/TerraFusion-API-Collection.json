{
  "info": {
    "name": "Terrafusion Master Workspace API",
    "description": "Comprehensive API collection for Terrafusion Master Workspace platform including authentication, service management, monitoring, testing, and WebSocket endpoints.",
    "version": "3.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.terrafusion.dev/v1",
      "type": "string",
      "description": "Base URL for the Terrafusion API"
    },
    {
      "key": "localUrl",
      "value": "http://localhost:3000/api",
      "type": "string",
      "description": "Local development URL"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "JWT access token for authentication"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string",
      "description": "Refresh token for obtaining new access tokens"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string",
      "description": "API key for service-to-service authentication"
    },
    {
      "key": "testSessionId",
      "value": "",
      "type": "string",
      "description": "Current test session ID"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('accessToken', response.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', response.refreshToken);",
                  "}",
                  "",
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has tokens', () => {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('accessToken');",
                  "    pm.expect(response).to.have.property('refreshToken');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"SecureP@ssw0rd!\",\n    \"deviceId\": \"postman-client\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', response.accessToken);",
                  "}",
                  "",
                  "pm.test('Status code is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          }
        }
      ]
    },
    {
      "name": "Multi-Tenant Management",
      "item": [
        {
          "name": "List Tenants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tenants?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["tenants"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Create Tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('tenant_id', response.id);",
                  "}",
                  "",
                  "pm.test('Status code is 201', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has tenant ID', () => {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('id');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Sample County Government\",\n    \"domain\": \"samplecounty.gov\",\n    \"adminEmail\": \"admin@samplecounty.gov\",\n    \"metadata\": {\n        \"population\": 250000,\n        \"timezone\": \"America/New_York\"\n    }\n}"
            },
            "url": {
              "raw": "{{base_url}}/tenants",
              "host": ["{{base_url}}"],
              "path": ["tenants"]
            }
          }
        },
        {
          "name": "Get Tenant Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tenants/{{tenant_id}}",
              "host": ["{{base_url}}"],
              "path": ["tenants", "{{tenant_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "List Reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/analytics/reports?category=financial",
              "host": ["{{base_url}}"],
              "path": ["analytics", "reports"],
              "query": [
                {
                  "key": "category",
                  "value": "financial"
                }
              ]
            }
          }
        },
        {
          "name": "Execute Report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"startDate\": \"2025-01-01\",\n    \"endDate\": \"2025-01-31\",\n    \"filters\": {\n        \"department\": \"Finance\",\n        \"includeSubDepartments\": true\n    }\n}"
            },
            "url": {
              "raw": "{{base_url}}/analytics/reports/financial-summary/execute",
              "host": ["{{base_url}}"],
              "path": ["analytics", "reports", "financial-summary", "execute"]
            }
          }
        }
      ]
    },
    {
      "name": "System Monitoring",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Get Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/metrics",
              "host": ["{{base_url}}"],
              "path": ["metrics"]
            }
          }
        }
      ]
    },
    {
      "name": "AI Workflows",
      "item": [
        {
          "name": "Create Workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Document Processing Workflow\",\n    \"description\": \"Automated document classification and data extraction\",\n    \"steps\": [\n        {\n            \"type\": \"ocr\",\n            \"config\": {\n                \"language\": \"en\",\n                \"enhanceQuality\": true\n            }\n        },\n        {\n            \"type\": \"classify\",\n            \"config\": {\n                \"model\": \"document-classifier-v2\",\n                \"categories\": [\"invoice\", \"receipt\", \"contract\", \"other\"]\n            }\n        },\n        {\n            \"type\": \"extract\",\n            \"config\": {\n                \"fields\": [\"date\", \"amount\", \"vendor\", \"items\"]\n            }\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/ai/workflows",
              "host": ["{{base_url}}"],
              "path": ["ai", "workflows"]
            }
          }
        },
        {
          "name": "Execute Workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"documentUrl\": \"https://storage.terrafusionmarket.com/documents/invoice-2025-001.pdf\",\n    \"metadata\": {\n        \"source\": \"email\",\n        \"department\": \"Finance\"\n    }\n}"
            },
            "url": {
              "raw": "{{base_url}}/ai/workflows/{{workflow_id}}/execute",
              "host": ["{{base_url}}"],
              "path": ["ai", "workflows", "{{workflow_id}}", "execute"]
            }
          }
        }
      ]
    },
    {
      "name": "Quantum Computing",
      "item": [
        {
          "name": "Submit Quantum Computation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"algorithm\": \"quantum-optimization\",\n    \"parameters\": {\n        \"problemType\": \"resource-allocation\",\n        \"constraints\": [\n            {\"type\": \"budget\", \"value\": 1000000},\n            {\"type\": \"time\", \"value\": \"2025-12-31\"}\n        ],\n        \"objectiveFunction\": \"maximize-efficiency\"\n    },\n    \"qubits\": 20\n}"
            },
            "url": {
              "raw": "{{base_url}}/quantum/compute",
              "host": ["{{base_url}}"],
              "path": ["quantum", "compute"]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request script",
          "console.log('Executing request to:', pm.request.url.toString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test script",
          "pm.test('Response time is less than 1000ms', () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});"
        ]
      }
    }
  ]
}
