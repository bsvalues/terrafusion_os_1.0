{
  "dashboard": {
    "id": null,
    "uid": "terrafusion-app",
    "title": "Terrafusion Application Performance",
    "tags": ["application", "apm", "terrafusion"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
        "type": "graph",
        "title": "Response Time Percentiles",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, http_request_duration_seconds_bucket{job=\"$service\"})",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, http_request_duration_seconds_bucket{job=\"$service\"})",
            "legendFormat": "P95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, http_request_duration_seconds_bucket{job=\"$service\"})",
            "legendFormat": "P99",
            "refId": "C"
          }
        ],
        "yaxes": [{ "format": "ms", "min": 0 }, { "format": "short" }]
      },
      {
        "id": 2,
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
        "type": "graph",
        "title": "Request Rate",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"$service\"}[5m])) by (status)",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "yaxes": [{ "format": "reqps" }, { "format": "short" }]
      },
      {
        "id": 3,
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
        "type": "graph",
        "title": "Error Rate",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"$service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"$service\"}[5m])) * 100",
            "legendFormat": "Error Rate %",
            "refId": "A"
          }
        ],
        "yaxes": [{ "format": "percent", "min": 0 }, { "format": "short" }],
        "thresholds": [{ "value": 1, "colorMode": "critical" }]
      },
      {
        "id": 4,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "type": "graph",
        "title": "Service Dependencies Health",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "service_dependency_health{service=\"$service\"}",
            "legendFormat": "{{dependency}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "percent", "min": 0, "max": 100 },
          { "format": "short" }
        ]
      },
      {
        "id": 5,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "type": "heatmap",
        "title": "Request Latency Heatmap",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(increase(http_request_duration_seconds_bucket{job=\"$service\"}[1m])) by (le)",
            "format": "heatmap",
            "legendFormat": "{{le}}",
            "refId": "A"
          }
        ],
        "dataFormat": "timeseries",
        "yAxis": {
          "format": "ms",
          "decimals": 0
        }
      },
      {
        "id": 6,
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
        "type": "table",
        "title": "Top Errors",
        "datasource": "Elasticsearch",
        "targets": [
          {
            "query": "index=\"terrafusion-logs-*\" AND level:ERROR | stats count by error_type, message | sort count desc | head 10",
            "refId": "A",
            "timeField": "@timestamp"
          }
        ]
      },
      {
        "id": 7,
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
        "type": "stat",
        "title": "APDEX Score",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "(sum(rate(http_requests_total{job=\"$service\",status!~\"5..\",duration_le=\"0.5\"}[5m])) + 0.5 * sum(rate(http_requests_total{job=\"$service\",status!~\"5..\",duration_gt=\"0.5\",duration_le=\"2\"}[5m]))) / sum(rate(http_requests_total{job=\"$service\"}[5m]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.7 },
                { "color": "green", "value": 0.9 }
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 8,
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
        "type": "stat",
        "title": "Active Users",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "active_users{service=\"$service\"}",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center"
        }
      },
      {
        "id": 9,
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 24 },
        "type": "stat",
        "title": "Avg Response Time",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "avg(rate(http_request_duration_seconds_sum{job=\"$service\"}[5m]) / rate(http_request_duration_seconds_count{job=\"$service\"}[5m])) * 1000",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 300 },
                { "color": "red", "value": 1000 }
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
        "type": "stat",
        "title": "SLO Compliance",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "slo_compliance{service=\"$service\"}",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 95 },
                { "color": "green", "value": 99 }
              ]
            }
          }
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(http_requests_total, job)",
          "multi": false,
          "includeAll": false,
          "current": {
            "text": "v1_foundation",
            "value": "v1_foundation"
          }
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "ALERTS{service=\"$service\"}",
          "name": "Service Alerts",
          "tagKeys": "severity,alertname",
          "titleFormat": "{{ alertname }}",
          "textFormat": "{{ description }}"
        },
        {
          "datasource": "Elasticsearch",
          "enable": true,
          "index": "terrafusion-logs-*",
          "query": "level:ERROR AND service:$service",
          "name": "Errors",
          "tagsField": "error_type",
          "textField": "message",
          "timeField": "@timestamp"
        }
      ]
    }
  }
}
