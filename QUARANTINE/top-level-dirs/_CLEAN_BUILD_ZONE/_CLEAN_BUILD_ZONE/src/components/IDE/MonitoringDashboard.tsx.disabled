import React, { useState, useEffect } from 'react';
import {
  Box,
  Grid,
  Card,
  CardContent,
  Typography,
  LinearProgress,
  Chip,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Paper,
  Alert,
  IconButton,
  Tooltip,
  Switch,
  FormControlLabel,
  Select,
  MenuItem,
  FormControl,
  InputLabel,
  CircularProgress,
  Badge
} from '@mui/material';
import {
  Refresh,
  Timeline,
  Speed,
  Security,
  Storage,
  CloudQueue,
  Warning,
  CheckCircle,
  Error,
  Info,
  Settings,
  FullscreenExit,
  Fullscreen,
  PlayArrow,
  Pause
} from '@mui/icons-material';
import { Line, Bar, Doughnut } from 'react-chartjs-2';
import {
  Chart as ChartJS,
  CategoryScale,
  LinearScale,
  PointElement,
  LineElement,
  BarElement,
  ArcElement,
  Title,
  Tooltip as ChartTooltip,
  Legend,
  Filler
} from 'chart.js';

// Register Chart.js components
ChartJS.register(
  CategoryScale,
  LinearScale,
  PointElement,
  LineElement,
  BarElement,
  ArcElement,
  Title,
  ChartTooltip,
  Legend,
  Filler
);

interface SystemMetrics {
  timestamp: string;
  cpu: number;
  memory: number;
  disk: number;
  network: {
    inbound: number;
    outbound: number;
  };
  apiResponseTime: number;
  errorRate: number;
  activeConnections: number;
  throughput: number;
}

interface ServiceStatus {
  name: string;
  status: 'healthy' | 'warning' | 'critical' | 'unknown';
  uptime: string;
  responseTime: number;
  errorCount: number;
  lastCheck: string;
  version: string;
  instances: number;
}

interface ComplianceMetric {
  category: string;
  score: number;
  status: 'compliant' | 'warning' | 'violation';
  lastAudit: string;
  findings: string[];
}

const MonitoringDashboard: React.FC = () => {
  const [metrics, setMetrics] = useState<SystemMetrics[]>([]);
  const [services, setServices] = useState<ServiceStatus[]>([]);
  const [compliance, setCompliance] = useState<ComplianceMetric[]>([]);
  const [loading, setLoading] = useState(true);
  const [autoRefresh, setAutoRefresh] = useState(true);
  const [refreshInterval, setRefreshInterval] = useState(5000);
  const [isFullscreen, setIsFullscreen] = useState(false);
  const [selectedTimeRange, setSelectedTimeRange] = useState('1h');

  // Initialize sample data
  useEffect(() => {
    generateSampleData();
    const interval = setInterval(() => {
      if (autoRefresh) {
        updateMetrics();
      }
    }, refreshInterval);

    return () => clearInterval(interval);
  }, [autoRefresh, refreshInterval]);

  const generateSampleData = () => {
    const now = new Date();
    const sampleMetrics: SystemMetrics[] = [];
    
    for (let i = 0; i < 60; i++) {
      const timestamp = new Date(now.getTime() - (60 - i) * 60000);
      sampleMetrics.push({
        timestamp: timestamp.toISOString(),
        cpu: Math.random() * 80 + 10,
        memory: Math.random() * 70 + 20,
        disk: Math.random() * 60 + 30,
        network: {
          inbound: Math.random() * 1000 + 100,
          outbound: Math.random() * 800 + 50
        },
        apiResponseTime: Math.random() * 50 + 5,
        errorRate: Math.random() * 5,
        activeConnections: Math.floor(Math.random() * 1000 + 100),
        throughput: Math.random() * 10000 + 1000
      });
    }

    const sampleServices: ServiceStatus[] = [
      {
        name: 'TerraFusion API Gateway',
        status: 'healthy',
        uptime: '99.9%',
        responseTime: 6,
        errorCount: 2,
        lastCheck: new Date().toISOString(),
        version: '1.0.0',
        instances: 3
      },
      {
        name: 'AI Swarm Controller (50,000 agents)',
        status: 'healthy',
        uptime: '99.8%',
        responseTime: 12,
        errorCount: 0,
        lastCheck: new Date().toISOString(),
        version: '2.1.0',
        instances: 7
      },
      {
        name: 'PostgreSQL Database',
        status: 'healthy',
        uptime: '100%',
        responseTime: 3,
        errorCount: 0,
        lastCheck: new Date().toISOString(),
        version: '15.4',
        instances: 2
      },
      {
        name: 'Redis Cache',
        status: 'warning',
        uptime: '98.5%',
        responseTime: 2,
        errorCount: 5,
        lastCheck: new Date().toISOString(),
        version: '7.0',
        instances: 1
      },
      {
        name: 'Elasticsearch',
        status: 'healthy',
        uptime: '99.7%',
        responseTime: 8,
        errorCount: 1,
        lastCheck: new Date().toISOString(),
        version: '8.9.0',
        instances: 3
      }
    ];

    const sampleCompliance: ComplianceMetric[] = [
      {
        category: 'FISMA Compliance',
        score: 94,
        status: 'compliant',
        lastAudit: new Date().toISOString(),
        findings: ['All security controls implemented', 'Audit logs active']
      },
      {
        category: 'NIST Framework',
        score: 87,
        status: 'warning',
        lastAudit: new Date().toISOString(),
        findings: ['Minor configuration updates needed', '2 recommendations pending']
      },
      {
        category: 'Section 508',
        score: 96,
        status: 'compliant',
        lastAudit: new Date().toISOString(),
        findings: ['Accessibility standards met', 'WCAG 2.1 AA compliant']
      }
    ];

    setMetrics(sampleMetrics);
    setServices(sampleServices);
    setCompliance(sampleCompliance);
    setLoading(false);
  };

  const updateMetrics = () => {
    const newMetric: SystemMetrics = {
      timestamp: new Date().toISOString(),
      cpu: Math.random() * 80 + 10,
      memory: Math.random() * 70 + 20,
      disk: Math.random() * 60 + 30,
      network: {
        inbound: Math.random() * 1000 + 100,
        outbound: Math.random() * 800 + 50
      },
      apiResponseTime: Math.random() * 50 + 5,
      errorRate: Math.random() * 5,
      activeConnections: Math.floor(Math.random() * 1000 + 100),
      throughput: Math.random() * 10000 + 1000
    };

    setMetrics(prev => [...prev.slice(1), newMetric]);
  };

  const getStatusIcon = (status: string) => {
    switch (status) {
      case 'healthy':
        return <CheckCircle style={{ color: '#4caf50' }} />;
      case 'warning':
        return <Warning style={{ color: '#ff9800' }} />;
      case 'critical':
        return <Error style={{ color: '#f44336' }} />;
      default:
        return <Info style={{ color: '#2196f3' }} />;
    }
  };

  const getComplianceColor = (score: number) => {
    if (score >= 95) return '#4caf50';
    if (score >= 85) return '#ff9800';
    return '#f44336';
  };

  const chartOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: {
        position: 'top' as const,
      },
    },
    scales: {
      y: {
        beginAtZero: true,
        max: 100
      }
    }
  };

  const performanceData = {
    labels: metrics.slice(-20).map(m => new Date(m.timestamp).toLocaleTimeString()),
    datasets: [
      {
        label: 'CPU Usage (%)',
        data: metrics.slice(-20).map(m => m.cpu),
        borderColor: 'rgb(255, 99, 132)',
        backgroundColor: 'rgba(255, 99, 132, 0.2)',
        fill: true
      },
      {
        label: 'Memory Usage (%)',
        data: metrics.slice(-20).map(m => m.memory),
        borderColor: 'rgb(54, 162, 235)',
        backgroundColor: 'rgba(54, 162, 235, 0.2)',
        fill: true
      }
    ]
  };

  const networkData = {
    labels: metrics.slice(-10).map(m => new Date(m.timestamp).toLocaleTimeString()),
    datasets: [
      {
        label: 'Inbound (MB/s)',
        data: metrics.slice(-10).map(m => m.network.inbound / 1024),
        backgroundColor: 'rgba(75, 192, 192, 0.6)'
      },
      {
        label: 'Outbound (MB/s)',
        data: metrics.slice(-10).map(m => m.network.outbound / 1024),
        backgroundColor: 'rgba(255, 159, 64, 0.6)'
      }
    ]
  };

  const serviceStatusData = {
    labels: ['Healthy', 'Warning', 'Critical'],
    datasets: [{
      data: [
        services.filter(s => s.status === 'healthy').length,
        services.filter(s => s.status === 'warning').length,
        services.filter(s => s.status === 'critical').length
      ],
      backgroundColor: ['#4caf50', '#ff9800', '#f44336']
    }]
  };

  if (loading) {
    return (
      <Box display="flex" justifyContent="center" alignItems="center" minHeight="400px">
        <CircularProgress />
      </Box>
    );
  }

  return (
    <Box sx={{ p: 3, bgcolor: '#f5f5f5', minHeight: '100vh' }}>
      {/* Header Controls */}
      <Box display="flex" justifyContent="between" alignItems="center" mb={3}>
        <Typography variant="h4" component="h1" color="primary">
          TerraFusion System Monitoring
        </Typography>
        <Box display="flex" gap={2} alignItems="center">
          <FormControl size="small">
            <InputLabel>Time Range</InputLabel>
            <Select
              value={selectedTimeRange}
              onChange={(e) => setSelectedTimeRange(e.target.value)}
              label="Time Range"
            >
              <MenuItem value="5m">5 Minutes</MenuItem>
              <MenuItem value="1h">1 Hour</MenuItem>
              <MenuItem value="24h">24 Hours</MenuItem>
              <MenuItem value="7d">7 Days</MenuItem>
            </Select>
          </FormControl>
          <FormControlLabel
            control={
              <Switch
                checked={autoRefresh}
                onChange={(e) => setAutoRefresh(e.target.checked)}
              />
            }
            label="Auto Refresh"
          />
          <Tooltip title="Manual Refresh">
            <IconButton onClick={updateMetrics}>
              <Refresh />
            </IconButton>
          </Tooltip>
          <Tooltip title={isFullscreen ? "Exit Fullscreen" : "Fullscreen"}>
            <IconButton onClick={() => setIsFullscreen(!isFullscreen)}>
              {isFullscreen ? <FullscreenExit /> : <Fullscreen />}
            </IconButton>
          </Tooltip>
        </Box>
      </Box>

      <Grid container spacing={3}>
        {/* System Performance Overview */}
        <Grid item xs={12}>
          <Card>
            <CardContent>
              <Typography variant="h6" gutterBottom>
                <Timeline sx={{ mr: 1 }} />
                System Performance Overview
              </Typography>
              <Box height="300px">
                <Line data={performanceData} options={chartOptions} />
              </Box>
            </CardContent>
          </Card>
        </Grid>

        {/* Key Metrics Cards */}
        <Grid item xs={12} md={3}>
          <Card>
            <CardContent>
              <Typography color="textSecondary" gutterBottom>
                API Response Time
              </Typography>
              <Typography variant="h4">
                {metrics[metrics.length - 1]?.apiResponseTime.toFixed(1)}ms
              </Typography>
              <Chip 
                label="Excellent" 
                color="success" 
                size="small" 
                sx={{ mt: 1 }}
              />
            </CardContent>
          </Card>
        </Grid>

        <Grid item xs={12} md={3}>
          <Card>
            <CardContent>
              <Typography color="textSecondary" gutterBottom>
                Active Connections
              </Typography>
              <Typography variant="h4">
                {metrics[metrics.length - 1]?.activeConnections.toLocaleString()}
              </Typography>
              <Chip 
                label="Normal" 
                color="primary" 
                size="small" 
                sx={{ mt: 1 }}
              />
            </CardContent>
          </Card>
        </Grid>

        <Grid item xs={12} md={3}>
          <Card>
            <CardContent>
              <Typography color="textSecondary" gutterBottom>
                Error Rate
              </Typography>
              <Typography variant="h4">
                {metrics[metrics.length - 1]?.errorRate.toFixed(2)}%
              </Typography>
              <Chip 
                label="Low" 
                color="success" 
                size="small" 
                sx={{ mt: 1 }}
              />
            </CardContent>
          </Card>
        </Grid>

        <Grid item xs={12} md={3}>
          <Card>
            <CardContent>
              <Typography color="textSecondary" gutterBottom>
                AI Agents Active
              </Typography>
              <Typography variant="h4">
                50,000
              </Typography>
              <Chip 
                label="Full Capacity" 
                color="success" 
                size="small" 
                sx={{ mt: 1 }}
              />
            </CardContent>
          </Card>
        </Grid>

        {/* Network Activity */}
        <Grid item xs={12} md={6}>
          <Card>
            <CardContent>
              <Typography variant="h6" gutterBottom>
                <CloudQueue sx={{ mr: 1 }} />
                Network Activity
              </Typography>
              <Box height="250px">
                <Bar data={networkData} options={{ ...chartOptions, scales: { y: { beginAtZero: true } } }} />
              </Box>
            </CardContent>
          </Card>
        </Grid>

        {/* Service Status */}
        <Grid item xs={12} md={6}>
          <Card>
            <CardContent>
              <Typography variant="h6" gutterBottom>
                <Speed sx={{ mr: 1 }} />
                Service Status Distribution
              </Typography>
              <Box height="250px" display="flex" justifyContent="center">
                <Doughnut data={serviceStatusData} options={{ maintainAspectRatio: false }} />
              </Box>
            </CardContent>
          </Card>
        </Grid>

        {/* Services Table */}
        <Grid item xs={12}>
          <Card>
            <CardContent>
              <Typography variant="h6" gutterBottom>
                <Settings sx={{ mr: 1 }} />
                Service Health Status
              </Typography>
              <TableContainer component={Paper}>
                <Table>
                  <TableHead>
                    <TableRow>
                      <TableCell>Service</TableCell>
                      <TableCell>Status</TableCell>
                      <TableCell>Uptime</TableCell>
                      <TableCell>Response Time</TableCell>
                      <TableCell>Errors</TableCell>
                      <TableCell>Version</TableCell>
                      <TableCell>Instances</TableCell>
                    </TableRow>
                  </TableHead>
                  <TableBody>
                    {services.map((service) => (
                      <TableRow key={service.name}>
                        <TableCell>{service.name}</TableCell>
                        <TableCell>
                          <Box display="flex" alignItems="center" gap={1}>
                            {getStatusIcon(service.status)}
                            <Typography variant="caption" sx={{ textTransform: 'capitalize' }}>
                              {service.status}
                            </Typography>
                          </Box>
                        </TableCell>
                        <TableCell>{service.uptime}</TableCell>
                        <TableCell>{service.responseTime}ms</TableCell>
                        <TableCell>
                          <Badge badgeContent={service.errorCount} color="error">
                            <Typography variant="body2">
                              {service.errorCount === 0 ? 'None' : service.errorCount}
                            </Typography>
                          </Badge>
                        </TableCell>
                        <TableCell>{service.version}</TableCell>
                        <TableCell>{service.instances}</TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </TableContainer>
            </CardContent>
          </Card>
        </Grid>

        {/* Government Compliance */}
        <Grid item xs={12}>
          <Card>
            <CardContent>
              <Typography variant="h6" gutterBottom>
                <Security sx={{ mr: 1 }} />
                Government Compliance Status
              </Typography>
              <Grid container spacing={2}>
                {compliance.map((comp) => (
                  <Grid item xs={12} md={4} key={comp.category}>
                    <Box p={2} border="1px solid #ddd" borderRadius={1}>
                      <Typography variant="subtitle1" gutterBottom>
                        {comp.category}
                      </Typography>
                      <Box display="flex" alignItems="center" gap={2} mb={2}>
                        <LinearProgress 
                          variant="determinate" 
                          value={comp.score} 
                          sx={{ 
                            flexGrow: 1, 
                            height: 10, 
                            borderRadius: 5,
                            '& .MuiLinearProgress-bar': {
                              backgroundColor: getComplianceColor(comp.score)
                            }
                          }} 
                        />
                        <Typography variant="h6">
                          {comp.score}%
                        </Typography>
                      </Box>
                      <Chip 
                        label={comp.status.toUpperCase()} 
                        color={comp.status === 'compliant' ? 'success' : 'warning'}
                        size="small"
                      />
                      <Typography variant="caption" display="block" sx={{ mt: 1 }}>
                        Last Audit: {new Date(comp.lastAudit).toLocaleDateString()}
                      </Typography>
                    </Box>
                  </Grid>
                ))}
              </Grid>
            </CardContent>
          </Card>
        </Grid>
      </Grid>

      {/* Real-time Alerts */}
      {services.some(s => s.status === 'warning' || s.status === 'critical') && (
        <Box position="fixed" bottom={20} right={20} maxWidth={400}>
          {services
            .filter(s => s.status === 'warning' || s.status === 'critical')
            .map(service => (
              <Alert 
                key={service.name}
                severity={service.status === 'critical' ? 'error' : 'warning'}
                sx={{ mb: 1 }}
              >
                <strong>{service.name}</strong>: {service.status} status detected
              </Alert>
            ))
          }
        </Box>
      )}
    </Box>
  );
};

export default MonitoringDashboard;