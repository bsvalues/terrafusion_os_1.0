{
  "$schema": "https://terrafusion.dev/schemas/design-tokens.json",
  "version": "1.0.0",
  "tagline": "Government. Transcended.",
  "colors": {
    "trust-blue": "#0099ff",
    "transcend-cyan": "#00ffee",
    "success-green": "#00ffaa",
    "deep-space": "#0b1020",
    "midnight": "#1a1f3a",
    "alert-red": "#ff4444",
    "caution-amber": "#ffaa00",
    "clarity-light": "#e0f7ff",
    "white": "#ffffff"
  },
  "gradients": {
    "clarity": "linear-gradient(135deg, #0099ff 0%, #00ffee 50%, #00ffaa 100%)",
    "transcendence": "linear-gradient(135deg, #00ffee 0%, #00ffaa 100%)",
    "dark-bg": "linear-gradient(180deg, #0b1020 0%, #0a0f1c 100%)"
  },
  "typography": {
    "fontFamily": "'Segoe UI', -apple-system, system-ui, sans-serif",
    "fontMono": "'Cascadia Code', 'Fira Code', 'SF Mono', monospace",
    "scale": {
      "overline": "12px",
      "caption": "14px",
      "body": "16px",
      "body-large": "18px",
      "h3": "24px",
      "h2": "28px",
      "h1": "36px",
      "display": "48px",
      "display-large": "72px"
    },
    "weight": {
      "thin": "100",
      "extralight": "200",
      "light": "300",
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "extrabold": "800",
      "black": "900"
    },
    "letterSpacing": {
      "tight": "-0.02em",
      "normal": "0em",
      "wide": "0.01em",
      "wider": "0.05em"
    }
  },
  "geometry": {
    "borderRadius": {
      "sm": "6px",
      "md": "12px",
      "lg": "24px",
      "full": "50px"
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px",
      "2xl": "48px",
      "3xl": "64px"
    }
  },
  "effects": {
    "blur": {
      "sm": "10px",
      "md": "20px",
      "lg": "40px"
    },
    "glow": {
      "transcend": "0 0 40px rgba(0, 255, 238, 0.5)",
      "clarity": "0 0 60px rgba(0, 153, 255, 0.5)",
      "success": "0 0 30px rgba(0, 255, 170, 0.5)"
    },
    "shadow": {
      "sm": "0 2px 8px rgba(0, 0, 0, 0.3)",
      "md": "0 4px 16px rgba(0, 0, 0, 0.4)",
      "lg": "0 8px 32px rgba(0, 0, 0, 0.5)"
    }
  },
  "motion": {
    "easing": {
      "transcend": "cubic-bezier(0.4, 0, 0.2, 1)",
      "clarity": "cubic-bezier(0.43, 0.13, 0.23, 0.96)",
      "entrance": "cubic-bezier(0.0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "duration": {
      "micro": "150ms",
      "quick": "300ms",
      "normal": "500ms",
      "slow": "800ms",
      "page": "1200ms"
    }
  },
  "animations": {
    "transcendence-pulse": {
      "duration": "3s",
      "timing": "ease-in-out",
      "iteration": "infinite",
      "keyframes": {
        "0%": "transform: scale(1); opacity: 0.9; filter: brightness(1);",
        "50%": "transform: scale(1.05); opacity: 1; filter: brightness(1.2);",
        "100%": "transform: scale(1); opacity: 0.9; filter: brightness(1);"
      }
    },
    "clarity-fade": {
      "duration": "1.2s",
      "timing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "keyframes": {
        "0%": "opacity: 0; transform: translateY(-20px);",
        "100%": "opacity: 1; transform: translateY(0);"
      }
    },
    "float": {
      "duration": "6s",
      "timing": "ease-in-out",
      "iteration": "infinite",
      "keyframes": {
        "0%, 100%": "transform: translateY(0);",
        "50%": "transform: translateY(-20px);"
      }
    }
  }
}
