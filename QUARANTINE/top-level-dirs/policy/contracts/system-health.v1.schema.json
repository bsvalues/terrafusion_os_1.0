{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerraFusion System Health Contract",
  "type": "object",
  "required": [
    "status",
    "moduleCount",
    "healthyModules",
    "warnings",
    "systemComponents"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["Healthy", "Degraded", "Unhealthy"]
    },
    "moduleCount": {
      "type": "integer",
      "minimum": 0
    },
    "healthyModules": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "systemComponents": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "intentFilter": {
      "type": ["string", "null"]
    },
    "moduleCountActive": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "moduleCountTotal": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "moduleCountFilteredOut": {
      "type": ["integer", "null"],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
