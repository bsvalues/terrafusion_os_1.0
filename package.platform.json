{
  "name": "@terrafusion/cos-platform",
  "version": "1.0.0-platform",
  "description": "TerraFusion County Operating System - Platform Substrate for Government Technology Vendors",
  "keywords": [
    "government",
    "platform",
    "substrate",
    "vendor-integration",
    "county-os",
    "zero-rewrite",
    "ai-agents",
    "compliance"
  ],
  "author": "TerraFusion Platform Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/cos-platform.git"
  },
  "workspaces": [
    "platform/core",
    "platform/vendor-integration",
    "platform/security-mesh",
    "platform/data-plane",
    "platform/agent-fabric",
    "platform/observability",
    "platform/api-gateway",
    "platform/ui-shell",
    "vendor-sdk",
    "developer-tools",
    "testing"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:platform": "npm run dev --workspace=platform/core",
    "dev:gateway": "npm run dev --workspace=platform/api-gateway",
    "dev:ui-shell": "npm run dev --workspace=platform/ui-shell",
    "dev:observability": "npm run dev --workspace=platform/observability",

    "build": "npm run build:platform && npm run build:vendor-sdk && npm run build:developer-tools",
    "build:platform": "npm run build --workspaces --if-present",
    "build:vendor-sdk": "npm run build --workspace=vendor-sdk",
    "build:developer-tools": "npm run build --workspace=developer-tools",

    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "jest --config=testing/jest.config.js",
    "test:integration": "npm run test --workspace=testing",
    "test:e2e": "playwright test --config=testing/playwright.config.ts",
    "test:vendor-integration": "npm run test:vendor-integration --workspace=testing",

    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",

    "docker:build": "docker build -t terrafusion/cos-platform .",
    "docker:dev": "docker-compose -f developer-tools/docker-compose.dev.yml up -d",
    "docker:stop": "docker-compose -f developer-tools/docker-compose.dev.yml down",

    "k8s:deploy:dev": "kubectl apply -k deployment/platform/overlays/development",
    "k8s:deploy:staging": "kubectl apply -k deployment/platform/overlays/staging",
    "k8s:deploy:prod": "kubectl apply -k deployment/platform/overlays/production",

    "create:vendor-integration": "node developer-tools/scripts/create-vendor-integration.js",
    "create:platform-service": "node developer-tools/scripts/create-platform-service.js",
    "generate:vendor-sdk": "npm run generate --workspace=vendor-sdk",
    "generate:api-docs": "node developer-tools/scripts/generate-api-docs.js",
    "generate:sidecar": "node developer-tools/scripts/generate-sidecar-config.js",

    "validate:os-compatible": "node developer-tools/scripts/validate-os-compatible.js",
    "validate:security": "npm run security-audit && npm run compliance-check",
    "security-audit": "npm audit && node developer-tools/scripts/security-scan.js",
    "compliance-check": "node developer-tools/scripts/compliance-validation.js",

    "monitor": "npm run monitor --workspace=platform/observability",
    "logs": "kubectl logs -l app=terrafusion-platform -f",
    "metrics": "open http://localhost:3000/dashboards",

    "vendor:onboard": "node developer-tools/scripts/vendor-onboarding.js",
    "vendor:certify": "node developer-tools/scripts/vendor-certification.js",
    "vendor:validate": "npm run validate:os-compatible",

    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",

    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules dist coverage",
    "reset": "npm run clean && npm install",
    "fresh": "npm run reset && npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.0.0",
    "playwright": "^1.40.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitepress": "^1.0.0"
  },
  "dependencies": {
    "zod": "^3.22.0",
    "winston": "^3.11.0",
    "prom-client": "^15.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "volta": {
    "node": "20.10.0",
    "npm": "10.2.0"
  },
  "config": {
    "platform": {
      "version": "1.0.0",
      "name": "TerraFusion cOS",
      "type": "vendor-substrate"
    }
  }
}