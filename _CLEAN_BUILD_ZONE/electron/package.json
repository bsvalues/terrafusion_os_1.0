{
  "name": "terrafusion-government-os",
  "version": "1.0.0",
  "description": "Terrafusion Government OS - Complete Desktop Operating System for Counties",
  "main": "main.js",
  "author": "Terrafusion Technologies",
  "license": "Proprietary",
  "scripts": {
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "npm run build",
    "build:installer": "electron-builder --win --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "gov.terrafusion.os",
    "productName": "Terrafusion Government OS",
    "copyright": "© 2025 Terrafusion Technologies - Government AI Operating System",
    "directories": {
      "output": "../../dist/electron",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "assets/**/*",
      "../dist/**/*",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "../../backend/dist",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../../backend/data",
        "to": "data", 
        "filter": ["**/*.db", "**/*.json"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "msi", 
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator",
      "publisherName": "Terrafusion Technologies",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"] 
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "bundleVersion": "1.0.0"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"] 
        }
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Terrafusion Government OS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "displayLanguageSelector": false,
      "runAfterFinish": true,
      "menuCategory": true
    },
    "msi": {
      "oneClick": false,
      "warningsAsErrors": false,
      "upgradeCode": "12345678-1234-1234-1234-123456789012"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410, 
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.1.4",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.4.0"
  }
}
