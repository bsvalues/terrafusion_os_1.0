# BENTON COUNTY WASHINGTON - Primary Deployment Configuration
# TerraFusion OS Government Operating System
# Harris PACS is the CAMA vendor system - NOT Harris County

# Primary County Configuration
COUNTY_NAME="Benton County"
COUNTY_STATE="Washington"
COUNTY_FIPS="53005"
DEPLOYMENT_TARGET="Production"

# CAMA Vendor System (Harris PACS)
CAMA_VENDOR="Harris PACS"
CAMA_SYSTEM_TYPE="Property Assessment"
CAMA_INTEGRATION_TYPE="Real-time Sync"

# Dynamic Port Configuration for Benton County
export TF_COUNTY="benton-county-washington"
export TF_CAMA_VENDOR="harris-pacs"
export TF_DEPLOYMENT_ENV="benton-production"

# Benton County Specific Ports
export TF_API_PORT=5050
export TF_BENTON_SHELL_PORT=3103
export TF_BENTON_CAMA_PORT=8300

# Harris PACS CAMA Vendor Ports (NOT Harris County)
export TF_HARRIS_PACS_PORT=8300
export TF_HARRIS_SYNC_PORT=8301
export TF_HARRIS_GIS_PORT=8302

# Validation URLs for Benton County
export TF_BENTON_API_URL="http://localhost:${TF_BENTON_API_PORT}"
export TF_BENTON_SHELL_URL="http://localhost:${TF_BENTON_SHELL_PORT}"
export TF_HARRIS_PACS_URL="http://localhost:${TF_HARRIS_PACS_PORT}"

echo "🏛️ BENTON COUNTY WASHINGTON Configuration Loaded"
echo "🔗 Harris PACS CAMA Vendor Integration Ready"
echo "⚡ TerraFusion OS Government Operating System Active"