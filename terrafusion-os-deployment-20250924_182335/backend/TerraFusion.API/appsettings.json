{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=terrafusion.db"
  },
  "JwtSettings": {
    "SecretKey": "Terrafusion-OS-1.0-JWT-Secret-Key-Must-Be-At-Least-32-Characters-Long-For-Security",
    "Issuer": "Terrafusion.API",
    "Audience": "Terrafusion.Client",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "AllowedOrigins": [
    "http://localhost:${TF_SHELL_PORT:-3103}",
    "https://localhost:${TF_SHELL_HTTPS_PORT:-3105}",
    "http://localhost:${TF_DEV_SERVER_PORT:-4000}",
    "http://localhost:${TF_STORYBOOK_PORT:-6006}",
    "http://localhost:${TF_SHELL_PORT:-3103}"
  ],
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/terrafusion-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AIEngine": {
    "MaxConcurrentInferences": 10,
    "ModelCacheSizeGB": 4,
    "DefaultTimeoutSeconds": 30,
    "EnableGPUAcceleration": true
  },
  "CostForge": {
    "CacheExpirationMinutes": 30,
    "MaxPropertiesPerRequest": 100,
    "EnableRealTimeUpdates": true
  },
  "Security": {
    "EnableRateLimiting": true,
    "MaxRequestsPerMinute": 100,
    "EnableIPWhitelist": false,
    "RequireHttps": false,
    "EnableCors": true
  },
  "Performance": {
    "EnableResponseCompression": true,
    "EnableResponseCaching": true,
    "DefaultCacheExpirationMinutes": 15
  },
  "AuditLogging": {
    "Enabled": true,
    "LogToDatabase": true,
    "LogToFile": true,
    "RetentionDays": 90,
    "LogLevel": "Information"
  },
  "TerraFusion": {
    "Grpc": {
      "UseTls": false,
      "Host": "127.0.0.1",
      "Port": 50051,
      "CertificatePath": "c:\\Users\\bsval\\terrafusion_os_1.0\\certs",
      "EnableMutualTls": false,
      "TimeoutSeconds": 30
    }
  }
}
