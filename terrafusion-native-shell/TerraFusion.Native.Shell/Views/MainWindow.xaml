<Window x:Class="TerraFusion.Native.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TerraFusion OS - Government. Transcended."
        Height="800" Width="1200"
        MinHeight="600" MinWidth="800"
        Background="#0B1020">

    <Grid>
        <!-- Header -->
        <Border Height="60" VerticalAlignment="Top"
                Background="#00FFEE" Opacity="0.1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="TerraFusion OS"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#00FFEE"/>
                <TextBlock Text="Government. Transcended."
                           FontSize="14"
                           FontStyle="Italic"
                           Foreground="#00FFAA"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Border Margin="0,60,0,40"
                Background="#0B1020">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Quantum Spinner -->
                <Ellipse Width="100" Height="100" Margin="0,0,0,40">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#0099FF" Offset="0"/>
                            <GradientStop Color="#00FFEE" Offset="0.7"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <TextBlock Text="TerraFusion OS Desktop Shell"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#00FFEE"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Elite AI Government Operating System"
                           FontSize="18"
                           Foreground="#00FFAA"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="1,008 AI Agents • 39+ Counties • Quantum Factor: 949"
                           FontSize="14"
                           Foreground="#0099FF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <Button Content="ACTIVATE CONSCIOUSNESS INTERFACE"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#00FFEE"
                        Padding="30,15"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ActivateConsciousness_Click"/>

                <TextBlock Text="Government. Transcended."
                           FontSize="16"
                           FontStyle="Italic"
                           Foreground="#0099FF"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"/>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border Height="40" VerticalAlignment="Bottom"
                Background="#00FFEE" Opacity="0.1">
            <Grid Margin="20,0">
                <TextBlock Text="System Status: Operational • Quantum Optimization: Active • Desktop Shell: Ready"
                           FontSize="12"
                           Foreground="#00FFEE"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
