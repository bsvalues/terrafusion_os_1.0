<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<log4net>
		 
		<appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
			<file value="sync.log" />
			<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
			<appendToFile value="true" />
			<maximumFileSize value="10MB" />
			<maxSizeRollBackups value="50" />
			 <rollingStyle value="Size" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date [%thread] %-5level %logger - %message%newline"/>
			</layout>
		</appender>

		<appender name="RollingFileXML" type="log4net.Appender.RollingFileAppender">
			<file type="log4net.Util.PatternString" value="sync.log.xml" />

			<appendToFile value="true" />
			<maximumFileSize value="10MB" />
			<maxSizeRollBackups value="50" />
			<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
			<rollingStyle value="Size" />
			<layout type="log4net.Layout.XmlLayoutSchemaLog4j">
				<locationInfo value="true" />
			</layout>
		</appender>

		<appender name="TraceAppender" type="log4net.Appender.TraceAppender" >
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date [%-3thread] %-5level %logger - %message%newline"/>
			</layout>
		</appender>

		<!-- console logging configuration -->
		<appender name="ColoredConsoleAppender" type="log4net.Appender.ColoredConsoleAppender">
			<target value="Console.Error" />
			<mapping>
				<level value="FATAL" />
				<foreColor value="Red" />
				<backColor value="White" />
			</mapping>
			<mapping>
				<level value="ERROR" />
				<foreColor value="Red, HighIntensity" />
			</mapping>
			<mapping>
				<level value="WARN" />
				<foreColor value="Yellow, HighIntensity" />
			</mapping>
			<mapping>
				<level value="INFO" />
				<foreColor value="White, HighIntensity" />
			</mapping>
			<mapping>
				<level value="DEBUG" />
				<foreColor value="Green, HighIntensity" />
			</mapping>
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
			</layout>
		</appender>
		 
		<!-- SMTP Email logging configuration -->
		<appender name="SmtpAppender" type="log4net.Appender.SmtpAppender">
			<to value="GBurge@harriscomputer.com, JWebber@harriscomputer.com,TBarrera@harriscomputer.com, Jcoco@harriscomputer.com" />
			<from value="PACSSyncService@harriscomputer.com" />
			<subject value="PACS SyncService Error" />
			<smtpHost value="172.16.4.9" />
			<authentication value="Basic" />
			<port value="25" />
			<!--<username value="XXXX" />
			<password value="XXXX" />-->
			<bufferSize value="1" />
			<EnableSsl value="false"/>
			<lossy value="true" />
			<evaluator type="log4net.Core.LevelEvaluator">
				<threshold value="ERROR"/>
			</evaluator>
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%newline%date [%thread] %-5level %logger [%property{NDC}] - %message%newline%newline%newline" />
			</layout>
		</appender>
		
		<root>
			<!-- value of level may be ALL, DEBUG, INFO, WARN, ERROR, FATAL, or OFF -->
			<level value="INFO" />
			<appender-ref ref="RollingFile" />
			<!-- <appender-ref ref="RollingFileXML" /> -->
			<appender-ref ref="TraceAppender" />
			<appender-ref ref="ColoredConsoleAppender" />
			<appender-ref ref="SmtpAppender" />
		</root>
	</log4net>
</configuration>