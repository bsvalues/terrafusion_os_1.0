{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "county_set": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "data_sha256": {
      "type": "string"
    },
    "exp": {
      "type": "string"
    },
    "issued_at": {
      "type": "string"
    },
    "nbf": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "report_type": {
      "enum": [
        "levy_summary",
        "assessment_roll_summary",
        "ops_health",
        "other"
      ],
      "type": "string"
    },
    "signing": {
      "additionalProperties": false,
      "properties": {
        "group_pub_sha256": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "cosmic_tss"
          ],
          "type": "string"
        },
        "participants_used": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "signature_sha256": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "group_pub_sha256",
        "signature_sha256",
        "participants_used"
      ],
      "type": "object"
    },
    "speclock_manifest_sha256": {
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "report_type",
    "issued_at",
    "nbf",
    "exp",
    "county_set",
    "data_sha256",
    "speclock_manifest_sha256",
    "signing"
  ],
  "title": "TerraFusion State Report v1",
  "type": "object"
}
