{
  "$schema": "../../speclock.schema.json",
  "id": "runtimecert.v1",
  "surface": "runtimecert",
  "version": "1.0.0",
  "status": "active",
  "created": "2025-06-14T00:00:00Z",
  "updated": "2025-06-14T00:00:00Z",
  "owners": ["platform-team"],
  "description": "Runtime certification gate for county go-live acceptance. Validates all contract compliance before production deployment.",

  "success_criteria": {
    "SC-1": {
      "description": "tf-runtime cert <county> command exists and runs all contract checks",
      "test": "CertificationTests.Cert_CommandExecutes_AllContractsChecked"
    },
    "SC-2": {
      "description": "Cert report outputs to artifacts/cert/<timestamp>/cert.report.json",
      "test": "CertificationTests.Cert_OutputsJsonReport_ToArtifactsPath"
    },
    "SC-3": {
      "description": "Cert report outputs human-readable artifacts/cert/<timestamp>/cert.report.md",
      "test": "CertificationTests.Cert_OutputsMarkdownReport_ToArtifactsPath"
    },
    "SC-4": {
      "description": "--strict mode fails on any warning (not just errors)",
      "test": "CertificationTests.Cert_StrictMode_FailsOnWarnings"
    },
    "SC-5": {
      "description": "--base-url <url> allows targeting remote TerraFusion instances",
      "test": "CertificationTests.Cert_BaseUrl_TargetsRemoteInstance"
    },
    "SC-6": {
      "description": "Exit code 0 = all pass, 1 = any fail, 2 = error (deterministic)",
      "test": "CertificationTests.Cert_ExitCodes_Deterministic"
    },
    "SC-7": {
      "description": "PACS contract check calls /ops/pacs/proof and validates response",
      "test": "CertificationTests.Cert_PacsCheck_ValidatesProofEndpoint"
    },
    "SC-8": {
      "description": "SpecLock contract check validates INDEX.json consistency",
      "test": "CertificationTests.Cert_SpecLockCheck_ValidatesIndex"
    },
    "SC-9": {
      "description": "Report includes timestamp, duration, county, base_url, all check results",
      "test": "CertificationTests.Cert_ReportStructure_Deterministic"
    },
    "SC-10": {
      "description": "Historical reports are never overwritten (timestamp-based paths)",
      "test": "CertificationTests.Cert_Reports_NeverOverwritten"
    }
  },

  "cli_interface": {
    "command": "tf-runtime",
    "subcommand": "cert",
    "synopsis": "tf-runtime cert <county> [--strict] [--base-url <url>] [--output <dir>]",
    "arguments": {
      "county": {
        "type": "string",
        "required": true,
        "description": "County identifier (e.g., benton, yakima)"
      }
    },
    "options": {
      "--strict": {
        "type": "flag",
        "default": false,
        "description": "Fail on warnings, not just errors"
      },
      "--base-url": {
        "type": "string",
        "default": "http://localhost:5000",
        "description": "Target TerraFusion instance URL"
      },
      "--output": {
        "type": "string",
        "default": "artifacts/cert",
        "description": "Output directory for reports"
      }
    },
    "exit_codes": {
      "0": "All checks passed",
      "1": "One or more checks failed",
      "2": "Runtime error (network, config, etc.)"
    }
  },

  "report_schema": {
    "type": "object",
    "required": ["timestamp", "county", "base_url", "duration_ms", "result", "checks"],
    "properties": {
      "timestamp": {
        "type": "string",
        "format": "date-time",
        "description": "ISO 8601 timestamp of certification run"
      },
      "county": {
        "type": "string",
        "description": "County identifier"
      },
      "base_url": {
        "type": "string",
        "description": "Target instance URL"
      },
      "duration_ms": {
        "type": "integer",
        "description": "Total certification duration in milliseconds"
      },
      "result": {
        "type": "string",
        "enum": ["PASS", "FAIL", "ERROR"],
        "description": "Overall certification result"
      },
      "strict_mode": {
        "type": "boolean",
        "description": "Whether strict mode was enabled"
      },
      "checks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "status", "duration_ms"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Check name (e.g., pacs_contract, speclock_index)"
            },
            "status": {
              "type": "string",
              "enum": ["PASS", "WARN", "FAIL", "SKIP", "ERROR"],
              "description": "Check result"
            },
            "duration_ms": {
              "type": "integer",
              "description": "Check duration in milliseconds"
            },
            "message": {
              "type": "string",
              "description": "Human-readable result message"
            },
            "details": {
              "type": "object",
              "description": "Check-specific detail payload"
            }
          }
        }
      },
      "summary": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "passed": { "type": "integer" },
          "warned": { "type": "integer" },
          "failed": { "type": "integer" },
          "skipped": { "type": "integer" },
          "errors": { "type": "integer" }
        }
      }
    }
  },

  "checks": {
    "pacs_contract": {
      "description": "Validates PACS contract compliance via /ops/pacs/proof",
      "endpoint": "/ops/pacs/proof",
      "validations": [
        "response.enabled == true",
        "response.contract.name == 'pacscontract.v1'",
        "response.contract.version == '1.0.0'",
        "no 'missing' status in views/indexes/procedures"
      ],
      "fail_behavior": "fail_closed"
    },
    "speclock_index": {
      "description": "Validates SpecLock INDEX.json consistency",
      "validations": [
        "INDEX.json exists and parses",
        "All referenced spec files exist",
        "All active locks have valid status"
      ],
      "fail_behavior": "fail_closed"
    },
    "health_ready": {
      "description": "Validates /healthz/ready returns 200",
      "endpoint": "/healthz/ready",
      "validations": [
        "response.status_code == 200"
      ],
      "fail_behavior": "fail_closed"
    },
    "health_live": {
      "description": "Validates /healthz/live returns 200",
      "endpoint": "/healthz/live",
      "validations": [
        "response.status_code == 200"
      ],
      "fail_behavior": "warn"
    }
  },

  "error_codes": {
    "CERT_NETWORK_ERROR": {
      "description": "Cannot reach target instance",
      "exit_code": 2,
      "behavior": "error"
    },
    "CERT_CHECK_FAILED": {
      "description": "One or more certification checks failed",
      "exit_code": 1,
      "behavior": "fail_closed"
    },
    "CERT_STRICT_WARNING": {
      "description": "Warning treated as failure in strict mode",
      "exit_code": 1,
      "behavior": "fail_closed"
    }
  },

  "artifacts": {
    "report_json": {
      "path": "artifacts/cert/{timestamp}/cert.report.json",
      "description": "Machine-readable certification report"
    },
    "report_md": {
      "path": "artifacts/cert/{timestamp}/cert.report.md",
      "description": "Human-readable certification report"
    }
  },

  "dependencies": [
    "pacscontract.v1",
    "runtimecontract.v1"
  ],

  "test_file": "backend/tests/TerraFusion.Unit.SmokeTests/CertificationTests.cs",
  "implementation_files": [
    "tools/runtime-cert/tf-runtime.py",
    "tools/runtime-cert/checks/pacs_check.py",
    "tools/runtime-cert/checks/speclock_check.py",
    "tools/runtime-cert/checks/health_check.py"
  ]
}
