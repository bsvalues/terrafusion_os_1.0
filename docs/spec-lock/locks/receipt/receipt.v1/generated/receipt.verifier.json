{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terrafusion.io/schemas/receipt.verifier.v1.json",
  "title": "TerraFusion Receipt Verifier Contract v1",
  "description": "Machine-readable verification contract for citizen-verifiable receipts",
  "version": "1.0.0",
  "generated_at": "2025-12-13T00:00:00Z",
  "verifier": {
    "name": "TerraFusion Receipt Verifier",
    "version": "1.0.0",
    "offline_capable": true,
    "endpoints": {
      "public_proof": "/public/proof/:id",
      "ops_speclock": "/ops/speclock",
      "ops_proof": "/ops/speclock/proof"
    }
  },
  "verification_steps": [
    {
      "step": 1,
      "name": "schema_validation",
      "description": "Validate receipt against receipt.schema.json",
      "required": true,
      "offline": true,
      "action": "jsonschema_validate",
      "schema_ref": "receipt.schema.json"
    },
    {
      "step": 2,
      "name": "time_window_check",
      "description": "Verify nbf <= now <= exp",
      "required": true,
      "offline": true,
      "action": "time_window_validate",
      "rules": {
        "nbf_lte_exp": "receipt.nbf <= receipt.exp",
        "issued_before_exp": "receipt.issued_at <= receipt.exp",
        "current_in_window": "receipt.nbf <= now && now <= receipt.exp"
      }
    },
    {
      "step": 3,
      "name": "artifact_hash_verify",
      "description": "Recompute artifact SHA-256 and compare",
      "required": true,
      "offline": true,
      "action": "sha256_verify",
      "input": "artifact_content",
      "expected": "receipt.artifact.sha256"
    },
    {
      "step": 4,
      "name": "manifest_anchor_verify",
      "description": "Verify speclock_manifest_sha256 matches known manifest",
      "required": true,
      "offline": false,
      "action": "manifest_lookup",
      "hash_field": "receipt.speclock_manifest_sha256",
      "lookup_endpoint": "/ops/speclock"
    },
    {
      "step": 5,
      "name": "signature_verify",
      "description": "Verify cryptographic signature based on signing mode",
      "required": true,
      "offline": true,
      "action": "signature_verify",
      "modes": {
        "mythic_cosign": {
          "verifier": "cosign verify-blob",
          "inputs": ["receipt_json", "bundle_path", "public_key"]
        },
        "cosmic_tss": {
          "verifier": "speclock-tss verify",
          "inputs": ["receipt_json", "signature", "group_pub"]
        }
      }
    }
  ],
  "qr_payload_contract": {
    "version": "1.0.0",
    "format": "base64url",
    "max_bytes": 2953,
    "compression": "gzip",
    "schema": {
      "type": "object",
      "required": ["v", "id", "h", "u"],
      "properties": {
        "v": {
          "type": "integer",
          "description": "QR payload version (always 1)",
          "const": 1
        },
        "id": {
          "type": "string",
          "description": "Receipt ID",
          "maxLength": 64
        },
        "h": {
          "type": "string",
          "description": "Truncated artifact hash (first 16 hex chars)",
          "pattern": "^[a-f0-9]{16}$"
        },
        "u": {
          "type": "string",
          "description": "Verification URL path",
          "pattern": "^/public/proof/"
        },
        "t": {
          "type": "integer",
          "description": "Issued timestamp (Unix epoch seconds)",
          "minimum": 0
        }
      }
    },
    "example": {
      "v": 1,
      "id": "r-2025-12-13-001",
      "h": "1234567890abcdef",
      "u": "/public/proof/r-2025-12-13-001",
      "t": 1734048000
    }
  },
  "foia_bundle_contract": {
    "version": "1.0.0",
    "format": "zip",
    "required_files": [
      {
        "path": "receipt.json",
        "description": "The signed receipt document"
      },
      {
        "path": "artifact.bin",
        "description": "The original artifact content"
      },
      {
        "path": "manifest.json",
        "description": "SpecLock manifest at time of issuance"
      },
      {
        "path": "proof.json",
        "description": "Cryptographic proof chain"
      },
      {
        "path": "VERIFY.md",
        "description": "Human-readable verification instructions"
      }
    ],
    "optional_files": [
      {
        "path": "signature.sig",
        "description": "Raw signature bytes (if applicable)"
      },
      {
        "path": "bundle.json",
        "description": "Cosign bundle (if mythic_cosign mode)"
      }
    ]
  },
  "error_codes": {
    "SCHEMA_INVALID": "Receipt does not conform to schema",
    "TIME_WINDOW_EXPIRED": "Receipt validity window has expired",
    "TIME_WINDOW_NOT_YET_VALID": "Receipt not yet valid (nbf in future)",
    "ARTIFACT_HASH_MISMATCH": "Artifact SHA-256 does not match receipt",
    "MANIFEST_NOT_FOUND": "Referenced SpecLock manifest not found",
    "MANIFEST_HASH_MISMATCH": "Manifest hash does not match",
    "SIGNATURE_INVALID": "Cryptographic signature verification failed",
    "SIGNATURE_MODE_UNKNOWN": "Unknown signing mode",
    "QR_DECODE_FAILED": "Failed to decode QR payload",
    "QR_VERSION_UNSUPPORTED": "QR payload version not supported"
  },
  "determinism_rules": {
    "json_serialization": "keys sorted lexicographically, no trailing whitespace",
    "hash_format": "lowercase hex, 64 characters",
    "timestamp_format": "RFC3339 UTC with Z suffix",
    "qr_encoding": "base64url without padding"
  }
}
