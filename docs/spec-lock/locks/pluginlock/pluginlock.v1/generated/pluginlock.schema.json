{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terrafusion.io/schemas/pluginlock.generated.v1.schema.json",
  "title": "TerraFusion PluginLock v1 (Generated)",
  "description": "Auto-generated schema for plugin permission validation - DO NOT EDIT MANUALLY",
  "type": "object",
  "required": [
    "permissions",
    "plugin_id",
    "sbom_sha256",
    "slsa_provenance_sha256",
    "version"
  ],
  "properties": {
    "permissions": {
      "additionalProperties": false,
      "properties": {
        "compute": {
          "additionalProperties": false,
          "properties": {
            "max_cpu_ms": {
              "description": "Maximum CPU time in milliseconds",
              "maximum": 60000,
              "minimum": 100,
              "type": "integer"
            },
            "max_memory_mb": {
              "description": "Maximum memory in megabytes",
              "maximum": 4096,
              "minimum": 16,
              "type": "integer"
            }
          },
          "required": ["max_cpu_ms", "max_memory_mb"],
          "type": "object"
        },
        "data_scopes": {
          "description": "Data access scopes requested",
          "items": {
            "enum": [
              "assessment_read",
              "assessment_write",
              "audit_log_read",
              "config_read",
              "gis_read",
              "gis_write",
              "property_read",
              "property_write",
              "user_profile_read"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "network": {
          "additionalProperties": false,
          "properties": {
            "allow_domains": {
              "description": "Explicit allowlist of domains",
              "items": {
                "format": "hostname",
                "type": "string"
              },
              "type": "array"
            },
            "deny_domains": {
              "description": "Explicit denylist (takes precedence over allow)",
              "items": {
                "format": "hostname",
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": ["allow_domains", "deny_domains"],
          "type": "object"
        },
        "storage": {
          "description": "Storage access types",
          "items": {
            "enum": [
              "cloud_blob",
              "local_cache",
              "persistent_local",
              "session_storage"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "telemetry_required": {
          "default": true,
          "description": "Whether telemetry reporting is required",
          "type": "boolean"
        }
      },
      "required": ["compute", "data_scopes", "network", "storage"],
      "type": "object"
    },
    "plugin_id": {
      "description": "Unique plugin identifier (reverse domain notation)",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "type": "string"
    },
    "sbom_sha256": {
      "description": "SHA-256 of SBOM (Software Bill of Materials)",
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "slsa_provenance_sha256": {
      "description": "SHA-256 of SLSA provenance attestation",
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "version": {
      "description": "Semantic version (X.Y.Z with optional prerelease/build)",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?(\\+[a-zA-Z0-9]+)?$",
      "type": "string"
    }
  },
  "additionalProperties": false
}
