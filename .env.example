# Database
POSTGRES_PASSWORD=postgres

# Auth
TF_JWT_AUDIENCE=terrafusion-api
TF_JWT_ISSUER=http://keycloak:8080/realms/terrafusion

# Optional overrides
ASPNETCORE_ENVIRONMENT=Development
# TerraFusion tfctl defaults
TF_ENV=dev
TF_API_PORT=8090
TF_SWARM_BUS=nats://localhost:4222
TF_MCP_URL=ws://localhost:8765/mcp
# For socket activation, set TF_API_PORT=0 and use systemd socket units
