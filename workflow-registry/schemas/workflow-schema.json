{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerraFusion Workflow Schema",
  "description": "Machine-readable workflow definition for government processes",
  "type": "object",
  "required": ["id", "name", "version", "department", "steps", "triggers", "outputs"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tf-workflow-[a-z0-9-]+$",
      "description": "Unique workflow identifier"
    },
    "name": {
      "type": "string",
      "description": "Human-readable workflow name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)"
    },
    "department": {
      "type": "string",
      "enum": ["assessor", "treasurer", "auditor", "planning", "permits", "sheriff", "prosecutor", "public_works", "human_services", "it"],
      "description": "County department responsible for workflow"
    },
    "category": {
      "type": "string",
      "enum": ["property_assessment", "tax_collection", "permitting", "appeals", "enforcement", "reporting", "citizen_services", "internal_operations"],
      "description": "Workflow category for organization"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical", "emergency"],
      "description": "Processing priority level"
    },
    "sla": {
      "type": "object",
      "properties": {
        "response_time_hours": {"type": "number"},
        "completion_time_hours": {"type": "number"},
        "escalation_time_hours": {"type": "number"}
      },
      "required": ["response_time_hours", "completion_time_hours"]
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["manual", "scheduled", "event", "api", "citizen_request", "system_alert"]
          },
          "condition": {"type": "string"},
          "data_required": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "type": {
            "type": "string",
            "enum": ["human_task", "automated_task", "system_integration", "decision_point", "parallel_processing", "wait_condition"]
          },
          "agent_requirements": {
            "type": "object",
            "properties": {
              "agent_type": {"type": "string", "enum": ["field_general", "operational_force", "specialist", "human"]},
              "skills_required": {"type": "array", "items": {"type": "string"}},
              "estimated_duration_minutes": {"type": "number"}
            }
          },
          "inputs": {"type": "array", "items": {"type": "string"}},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "conditions": {
            "type": "object",
            "properties": {
              "success_criteria": {"type": "string"},
              "failure_criteria": {"type": "string"},
              "escalation_criteria": {"type": "string"}
            }
          },
          "integrations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "system": {"type": "string"},
                "action": {"type": "string"},
                "endpoint": {"type": "string"}
              }
            }
          },
          "next_steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "condition": {"type": "string"},
                "step_id": {"type": "string"}
              }
            }
          }
        },
        "required": ["id", "name", "type"]
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "success_outputs": {"type": "array", "items": {"type": "string"}},
        "failure_outputs": {"type": "array", "items": {"type": "string"}},
        "notifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "recipient": {"type": "string"},
              "condition": {"type": "string"},
              "template": {"type": "string"}
            }
          }
        }
      }
    },
    "compliance": {
      "type": "object",
      "properties": {
        "regulations": {"type": "array", "items": {"type": "string"}},
        "audit_requirements": {"type": "array", "items": {"type": "string"}},
        "data_retention_days": {"type": "number"},
        "security_level": {"type": "string", "enum": ["public", "internal", "confidential", "restricted", "top_secret"]}
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "success_rate_target": {"type": "number", "minimum": 0, "maximum": 1},
        "average_completion_time_target_hours": {"type": "number"},
        "cost_per_execution_target": {"type": "number"},
        "citizen_satisfaction_target": {"type": "number", "minimum": 0, "maximum": 5}
      }
    },
    "created_by": {"type": "string"},
    "created_date": {"type": "string", "format": "date-time"},
    "last_modified_by": {"type": "string"},
    "last_modified_date": {"type": "string", "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["draft", "review", "approved", "active", "deprecated"],
      "description": "Workflow lifecycle status"
    }
  }
}