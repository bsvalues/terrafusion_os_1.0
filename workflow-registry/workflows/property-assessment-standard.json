{
  "id": "tf-workflow-property-assessment-standard",
  "name": "Standard Property Assessment Workflow",
  "version": "1.0.0",
  "department": "assessor",
  "category": "property_assessment",
  "priority": "high",
  "sla": {
    "response_time_hours": 2,
    "completion_time_hours": 48,
    "escalation_time_hours": 72
  },
  "triggers": [
    {
      "type": "scheduled",
      "condition": "annual_assessment_cycle",
      "data_required": ["parcel_id", "property_data", "market_conditions"]
    },
    {
      "type": "event",
      "condition": "property_transfer",
      "data_required": ["sale_price", "transfer_date", "property_improvements"]
    },
    {
      "type": "citizen_request",
      "condition": "assessment_appeal",
      "data_required": ["appeal_reason", "supporting_documents", "requested_value"]
    }
  ],
  "steps": [
    {
      "id": "step_001_data_collection",
      "name": "Collect Property Data",
      "type": "automated_task",
      "agent_requirements": {
        "agent_type": "operational_force",
        "skills_required": ["data_collection", "gis_analysis", "harris_pacs_integration"],
        "estimated_duration_minutes": 15
      },
      "inputs": ["parcel_id"],
      "outputs": ["property_characteristics", "improvement_details", "land_attributes", "comparable_sales"],
      "conditions": {
        "success_criteria": "all_required_data_collected == true",
        "failure_criteria": "missing_critical_data == true",
        "escalation_criteria": "data_collection_time > 30_minutes"
      },
      "integrations": [
        {
          "system": "harris_pacs",
          "action": "fetch_property_record",
          "endpoint": "/api/properties/{parcel_id}"
        },
        {
          "system": "gis_system",
          "action": "get_spatial_data",
          "endpoint": "/api/spatial/parcel/{parcel_id}"
        },
        {
          "system": "market_data",
          "action": "get_comparables",
          "endpoint": "/api/comparables/search"
        }
      ],
      "next_steps": [
        {
          "condition": "success",
          "step_id": "step_002_valuation_analysis"
        },
        {
          "condition": "failure",
          "step_id": "step_010_manual_review"
        }
      ]
    },
    {
      "id": "step_002_valuation_analysis",
      "name": "Perform Automated Valuation",
      "type": "automated_task",
      "agent_requirements": {
        "agent_type": "field_general",
        "skills_required": ["property_valuation", "statistical_analysis", "market_analysis"],
        "estimated_duration_minutes": 30
      },
      "inputs": ["property_characteristics", "comparable_sales", "market_conditions"],
      "outputs": ["cost_approach_value", "sales_comparison_value", "income_approach_value", "final_assessed_value"],
      "conditions": {
        "success_criteria": "valuation_confidence > 0.85",
        "failure_criteria": "valuation_confidence < 0.60",
        "escalation_criteria": "value_variance > 25_percent"
      },
      "integrations": [
        {
          "system": "valuation_kernel",
          "action": "calculate_value",
          "endpoint": "/api/valuation/calculate"
        },
        {
          "system": "market_analytics",
          "action": "analyze_trends",
          "endpoint": "/api/market/trends"
        }
      ],
      "next_steps": [
        {
          "condition": "success && valuation_confidence > 0.90",
          "step_id": "step_003_quality_assurance"
        },
        {
          "condition": "success && valuation_confidence <= 0.90",
          "step_id": "step_005_peer_review"
        },
        {
          "condition": "failure",
          "step_id": "step_010_manual_review"
        }
      ]
    },
    {
      "id": "step_003_quality_assurance",
      "name": "Automated Quality Assurance",
      "type": "automated_task",
      "agent_requirements": {
        "agent_type": "specialist",
        "skills_required": ["quality_assurance", "data_validation", "compliance_checking"],
        "estimated_duration_minutes": 10
      },
      "inputs": ["final_assessed_value", "valuation_methodology", "supporting_data"],
      "outputs": ["qa_report", "compliance_status", "accuracy_score"],
      "conditions": {
        "success_criteria": "qa_score > 0.95 && compliance_status == 'passed'",
        "failure_criteria": "qa_score < 0.80 || compliance_violations > 0",
        "escalation_criteria": "critical_errors > 0"
      },
      "integrations": [
        {
          "system": "qa_engine",
          "action": "validate_assessment",
          "endpoint": "/api/qa/validate"
        },
        {
          "system": "compliance_checker",
          "action": "check_regulations",
          "endpoint": "/api/compliance/check"
        }
      ],
      "next_steps": [
        {
          "condition": "success",
          "step_id": "step_004_finalization"
        },
        {
          "condition": "failure",
          "step_id": "step_005_peer_review"
        }
      ]
    },
    {
      "id": "step_004_finalization",
      "name": "Finalize Assessment",
      "type": "automated_task",
      "agent_requirements": {
        "agent_type": "operational_force",
        "skills_required": ["record_management", "system_integration", "notification_services"],
        "estimated_duration_minutes": 5
      },
      "inputs": ["final_assessed_value", "qa_report", "supporting_documentation"],
      "outputs": ["assessment_record", "notice_generated", "database_updated"],
      "conditions": {
        "success_criteria": "record_saved == true && notice_sent == true",
        "failure_criteria": "system_error == true",
        "escalation_criteria": "finalization_time > 15_minutes"
      },
      "integrations": [
        {
          "system": "harris_pacs",
          "action": "update_assessment",
          "endpoint": "/api/assessments/update"
        },
        {
          "system": "notification_service",
          "action": "send_notice",
          "endpoint": "/api/notifications/send"
        },
        {
          "system": "audit_log",
          "action": "log_transaction",
          "endpoint": "/api/audit/log"
        }
      ],
      "next_steps": [
        {
          "condition": "success",
          "step_id": "step_999_completion"
        },
        {
          "condition": "failure",
          "step_id": "step_010_manual_review"
        }
      ]
    },
    {
      "id": "step_005_peer_review",
      "name": "Peer Review by Field General",
      "type": "human_task",
      "agent_requirements": {
        "agent_type": "field_general",
        "skills_required": ["senior_valuation", "peer_review", "decision_making"],
        "estimated_duration_minutes": 45
      },
      "inputs": ["valuation_analysis", "qa_concerns", "supporting_data"],
      "outputs": ["review_decision", "revised_value", "review_comments"],
      "conditions": {
        "success_criteria": "review_completed == true",
        "failure_criteria": "review_time > 60_minutes",
        "escalation_criteria": "disagreement_with_original > 20_percent"
      },
      "next_steps": [
        {
          "condition": "approved",
          "step_id": "step_004_finalization"
        },
        {
          "condition": "rejected",
          "step_id": "step_002_valuation_analysis"
        },
        {
          "condition": "escalated",
          "step_id": "step_010_manual_review"
        }
      ]
    },
    {
      "id": "step_010_manual_review",
      "name": "Manual Review and Resolution",
      "type": "human_task",
      "agent_requirements": {
        "agent_type": "human",
        "skills_required": ["expert_valuation", "complex_analysis", "regulatory_compliance"],
        "estimated_duration_minutes": 120
      },
      "inputs": ["all_previous_data", "error_reports", "escalation_reasons"],
      "outputs": ["manual_assessment", "resolution_plan", "process_improvements"],
      "conditions": {
        "success_criteria": "manual_review_completed == true",
        "failure_criteria": "review_time > 240_minutes",
        "escalation_criteria": "unable_to_resolve == true"
      },
      "next_steps": [
        {
          "condition": "resolved",
          "step_id": "step_004_finalization"
        },
        {
          "condition": "escalated",
          "step_id": "step_011_supervisor_review"
        }
      ]
    },
    {
      "id": "step_999_completion",
      "name": "Workflow Completion",
      "type": "automated_task",
      "agent_requirements": {
        "agent_type": "operational_force",
        "skills_required": ["workflow_management", "metrics_collection"],
        "estimated_duration_minutes": 2
      },
      "inputs": ["final_outputs", "process_metrics"],
      "outputs": ["completion_report", "performance_metrics", "quality_scores"],
      "conditions": {
        "success_criteria": "workflow_completed == true",
        "failure_criteria": "false",
        "escalation_criteria": "false"
      },
      "integrations": [
        {
          "system": "metrics_collector",
          "action": "record_completion",
          "endpoint": "/api/metrics/record"
        },
        {
          "system": "dashboard",
          "action": "update_statistics",
          "endpoint": "/api/dashboard/update"
        }
      ],
      "next_steps": []
    }
  ],
  "outputs": {
    "success_outputs": [
      "final_assessed_value",
      "assessment_notice",
      "compliance_certificate",
      "quality_report"
    ],
    "failure_outputs": [
      "error_report",
      "escalation_notice",
      "manual_intervention_required"
    ],
    "notifications": [
      {
        "recipient": "property_owner",
        "condition": "assessment_completed",
        "template": "assessment_notice_template"
      },
      {
        "recipient": "supervisor",
        "condition": "escalation_required",
        "template": "escalation_alert_template"
      },
      {
        "recipient": "quality_team",
        "condition": "quality_issues_detected",
        "template": "quality_alert_template"
      }
    ]
  },
  "compliance": {
    "regulations": ["RCW 84.40", "WAC 458-07", "USPAP_Standards"],
    "audit_requirements": ["assessment_methodology", "comparable_sales_verification", "quality_control_procedures"],
    "data_retention_days": 2555,
    "security_level": "internal"
  },
  "metrics": {
    "success_rate_target": 0.95,
    "average_completion_time_target_hours": 36,
    "cost_per_execution_target": 125.50,
    "citizen_satisfaction_target": 4.2
  },
  "created_by": "ai_swarm_system",
  "created_date": "2025-09-21T14:30:00Z",
  "last_modified_by": "ai_swarm_system",
  "last_modified_date": "2025-09-21T14:30:00Z",
  "status": "active"
}