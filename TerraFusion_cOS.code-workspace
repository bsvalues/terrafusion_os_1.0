{
  "settings": {
    "TerraFusion.cOS.Version": "1.0.0-platform",
    "TerraFusion.Architecture": "VENDOR_SUBSTRATE_PLATFORM",
    "TerraFusion.Warning": "PLATFORM_SUBSTRATE_NOT_STANDALONE_APPLICATION",
    "TerraFusion.OS.Type": "COUNTY_OPERATING_SYSTEM_SUBSTRATE",
    "TerraFusion.AI.Agents": 50000,
    "TerraFusion.Vendor.Integration": "ZERO_REWRITE_PATTERN",
    "TerraFusion.Status": "VENDOR_ECOSYSTEM_OPERATIONAL",
    "workbench.colorTheme": "Default Dark+",
    "files.associations": {
      "*.terrafusion": "json",
      "*.cos": "typescript",
      "*.substrate": "yaml",
      "*.vendor": "json",
      "AI_AGENT_START_HERE.md": "markdown",
      "VENDOR_*.md": "markdown"
    },
    "editor.rulers": [80, 120],
    "workbench.startupEditor": "readme",
    "typescript.preferences.importModuleSpecifier": "relative",
    "rust-analyzer.cargo.features": ["all"],
    "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
    "python.defaultInterpreterPath": "./.venv/Scripts/python",
    "yaml.schemas": {
      "./platform/schemas/vendor-integration.schema.json": ["**/*.vendor.yaml"],
      "./platform/schemas/sidecar-config.schema.json": ["**/*.sidecar.yaml"]
    }
  },
  "extensions": {
    "recommendations": [
      "ms-vscode.vscode-typescript-next",
      "ms-vscode.csharp",
      "rust-lang.rust-analyzer",
      "ms-python.python",
      "ms-kubernetes-tools.vscode-kubernetes-tools",
      "ms-vscode.vscode-docker",
      "redhat.vscode-yaml",
      "bradlc.vscode-tailwindcss",
      "esbenp.prettier-vscode"
    ]
  },
  "folders": [
    {
      "name": "🏛️ Platform Core",
      "path": "./platform/core"
    },
    {
      "name": "🔧 Vendor Integration",
      "path": "./platform/vendor-integration"
    },
    {
      "name": "🛡️ Security Mesh",
      "path": "./platform/security-mesh"
    },
    {
      "name": "📊 Data Plane",
      "path": "./platform/data-plane"
    },
    {
      "name": "🤖 Agent Fabric",
      "path": "./platform/agent-fabric"
    },
    {
      "name": "📈 Observability",
      "path": "./platform/observability"
    },
    {
      "name": "🌐 API Gateway",
      "path": "./platform/api-gateway"
    },
    {
      "name": "🎨 UI Shell",
      "path": "./platform/ui-shell"
    },
    {
      "name": "🛠️ Developer Tools",
      "path": "./developer-tools"
    },
    {
      "name": "📦 Vendor SDK",
      "path": "./vendor-sdk"
    },
    {
      "name": "🧪 Testing & QA",
      "path": "./testing"
    },
    {
      "name": "📚 Documentation",
      "path": "./docs"
    },
    {
      "name": "🚀 Deployment",
      "path": "./deployment"
    },
    {
      "name": "💼 Business Intelligence",
      "path": "./business-intelligence"
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build Platform Core",
        "type": "shell",
        "command": "npm run build:platform",
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "Start Developer Environment",
        "type": "shell",
        "command": "docker-compose -f developer-tools/docker-compose.dev.yml up -d",
        "group": "test",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "Run Vendor Integration Tests",
        "type": "shell",
        "command": "npm run test:vendor-integration",
        "group": "test",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "Deploy Platform Stack",
        "type": "shell",
        "command": "kubectl apply -k deployment/platform/overlays/development",
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      },
      {
        "label": "Generate Vendor SDK",
        "type": "shell",
        "command": "npm run generate:vendor-sdk",
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        }
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Platform Core Debug",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/platform/core/dist/index.js",
        "env": {
          "NODE_ENV": "development",
          "PLATFORM_MODE": "debug"
        }
      },
      {
        "name": ".NET API Debug",
        "type": "dotnet",
        "request": "launch",
        "program": "${workspaceFolder}/platform/core/dotnet/bin/Debug/net8.0/TerraFusion.Platform.dll",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "PLATFORM_MODE": "debug"
        }
      },
      {
        "name": "Rust Performance Engine Debug",
        "type": "lldb",
        "request": "launch",
        "program": "${workspaceFolder}/platform/performance-engine/target/debug/terrafusion-engine",
        "env": {
          "RUST_LOG": "debug"
        }
      }
    ]
  }
}