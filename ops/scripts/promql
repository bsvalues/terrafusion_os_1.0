#!/usr/bin/env bash
# Prometheus Query Helper — CLI wrapper for PromQL queries
# Usage: promql "query_expression" [--format json|value|table]
# Example: promql "tfos:ri{service='api'}" --format value

set -euo pipefail

PROM_URL="${PROMETHEUS_URL:-http://localhost:9090}"
QUERY="${1:-}"
FORMAT="${2:---format}"
FORMAT="${3:-json}"

if [ -z "$QUERY" ]; then
    echo "Usage: promql 'query_expression' [--format json|value|table]"
    echo ""
    echo "Examples:"
    echo "  promql 'up'"
    echo "  promql 'tfos:ri{service=\"api\"}' --format value"
    echo "  promql 'rate(http_requests_total[5m])' --format table"
    echo ""
    echo "Environment:"
    echo "  PROMETHEUS_URL=${PROM_URL}"
    exit 1
fi

# URL-encode query
ENCODED_QUERY=$(echo "$QUERY" | jq -sRr @uri)

# Execute query
RESPONSE=$(curl -sf "${PROM_URL}/api/v1/query?query=${ENCODED_QUERY}" || {
    echo "Error: Failed to query Prometheus at ${PROM_URL}"
    exit 1
})

# Check response status
STATUS=$(echo "$RESPONSE" | jq -r '.status')
if [ "$STATUS" != "success" ]; then
    echo "Error: Query failed"
    echo "$RESPONSE" | jq -r '.error // .errorType'
    exit 1
fi

# Format output
case "$FORMAT" in
    json)
        echo "$RESPONSE" | jq '.'
        ;;
    value)
        echo "$RESPONSE" | jq -r '.data.result[0].value[1] // "N/A"'
        ;;
    table)
        echo "$RESPONSE" | jq -r '.data.result[] | [.metric.service // .metric.__name__, .value[1]] | @tsv' | column -t
        ;;
    *)
        echo "Unknown format: $FORMAT"
        exit 1
        ;;
esac
