# ═══════════════════════════════════════════════════════════════
# TerraFusion OS — Caddy Reverse Proxy
# Automatic HTTPS via Let's Encrypt. Zero manual cert management.
# ═══════════════════════════════════════════════════════════════

{$TF_STAGING_DOMAIN:staging.terrafusionmarket.com} {
	# API backend — all /api/* and health endpoints
	handle /healthz* {
		reverse_proxy terrafusion-api:5000
	}
	handle /version {
		reverse_proxy terrafusion-api:5000
	}
	handle /api/* {
		reverse_proxy terrafusion-api:5000
	}
	handle /hubs/* {
		reverse_proxy terrafusion-api:5000
	}

	# Grafana dashboard (behind /grafana/ subpath)
	handle_path /grafana/* {
		reverse_proxy grafana:3000
	}

	# Frontend — everything else
	handle {
		reverse_proxy terrafusion-frontend:80
	}

	# Security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
