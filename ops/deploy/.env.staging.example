# ═══════════════════════════════════════════════════════════════
# TerraFusion OS — Staging Environment Variables
# Copy to .env and fill in real values before first deploy.
#
# Usage:
#   cp .env.staging.example .env
#   nano .env   # fill in values
#   docker compose -f docker-compose.staging.yml up -d
# ═══════════════════════════════════════════════════════════════

# ── Required (deploy will fail without these) ────────────────
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING_64_CHARS

# ── Release tracking (set by CI, override manually for testing) ─
TF_RELEASE_SHA=dev-local
TF_IMAGE_TAG=latest

# ── Domain (must match DNS A record) ────────────────────────────
TF_STAGING_DOMAIN=staging.terrafusionmarket.com

# ── Grafana admin (change from default) ──────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA
