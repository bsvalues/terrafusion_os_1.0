# Per-environment internal proxy — no TLS (edge proxy handles TLS).
# Listens on :80 inside the Docker network only.
:80 {
    encode gzip zstd

    @health path /health
    handle @health {
        header {
            X-Release-Sha "{$TF_RELEASE_SHA}"
            X-Release-Environment "{$TF_RELEASE_ENV}"
            X-Release-Deployed-At "{$TF_RELEASE_DEPLOYED_AT}"
        }
        reverse_proxy backend:5000
    }

    handle /api/* {
        reverse_proxy backend:5000
    }

    handle /hubs/* {
        reverse_proxy backend:5000
    }

    handle {
        reverse_proxy frontend:80
    }
}
