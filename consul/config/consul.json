{
  "datacenter": "terrafusion-dc1",
  "domain": "terrafusion.local",
  "data_dir": "/consul/data",
  "log_level": "INFO",
  "server": true,
  "bootstrap_expect": 1,
  "ui_config": {
    "enabled": true
  },
  "client_addr": "0.0.0.0",
  "connect": {
    "enabled": true
  },
  "acl": {
    "enabled": true,
    "default_policy": "allow",
    "enable_token_persistence": true
  },
  "encrypt": "REPLACE_WITH_CONSUL_ENCRYPT_KEY",
  "services": [
    {
      "name": "terrafusion-api",
      "port": \${{TF_API_PORT:-5000}},
      "tags": ["api", "gateway", "government"],
      "check": {
        "http": "http://host.docker.internal:${TF_API_PORT:-5046}/health",
        "interval": "30s",
        "timeout": "5s"
      }
    },
    {
      "name": "terrafusion-frontend",
      "port": \${{TF_API_PORT:-5000}},
      "tags": ["frontend", "ui", "pwa"],
      "check": {
        "http": "http://host.docker.internal:${TF_FRONTEND_PORT:-3102}/health",
        "interval": "30s",
        "timeout": "5s"
      }
    },
    {
      "name": "terrafusion-message-bus",
      "port": \${{TF_API_PORT:-5000}},
      "tags": ["messaging", "websocket", "events"],
      "check": {
        "tcp": "host.docker.internal:${TF_STATIC_PORT:-8080}",
        "interval": "30s",
        "timeout": "5s"
      }
    }
  ],
  "telemetry": {
    "prometheus_retention_time": "24h",
    "disable_hostname": false
  }
}