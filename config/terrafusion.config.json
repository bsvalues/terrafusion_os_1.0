{
  "mode": "OS",
  "layers": {
    "core": "TerraFusionKernel",
    "interfaces": ["PWA", "Browser", "Electron", "Tauri"],
    "modules": "PluginArchitecture"
  },
  "endpoints": {
    "core": "ws://localhost:\${{TF_PORT_7000:-7000}}/terrafusion/core",
    "modules": "ws://localhost:\${{TF_PORT_7000:-7000}}/terrafusion/modules",
    "marketplace": "ws://localhost:\${{TF_PORT_7000:-7000}}/terrafusion/marketplace"
  },
  "communication": {
    "primary": "websocket",
    "fallback": "https_polling"
  },
  "security": {
    "vault": "SecureVault",
    "permissions": "RBAC",
    "audit": "ComprehensiveLogger",
    "encryption": "E2E"
  },
  "deployment": {
    "master_node": {
      "type": "physical_server",
      "components": [
        "terrafusion_core",
        "api_gateway",
        "marketplace_server",
        "browser_distribution_server"
      ]
    },
    "satellite_terminals": {
      "type": "virtual_machines",
      "access_method": "terrafusion_browser",
      "connection": "websocket_persistent",
      "fallback": "https_polling"
    }
  }
}
