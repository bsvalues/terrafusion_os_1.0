# TerraFusion OS - Environment Configuration Template
# Copy this file to .env and update with your values

# Application Settings
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production

# Database Configuration
DB_PASSWORD=TerraFusion2025!
DATABASE_PATH=/app/data/terrafusion.db
# For PostgreSQL (production):
# DATABASE_CONNECTION=Host=postgres;Database=terrafusion;Username=terrafusion;Password=TerraFusion2025!

# Authentication
JWT_SECRET=TerraFusion-Secure-Key-Change-In-Production-2025-RandomString123
JWT_ISSUER=TerraFusion
JWT_AUDIENCE=TerraFusionAPI
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# Redis Cache
REDIS_CONNECTION=redis:6379
REDIS_PASSWORD=

# AI Services Configuration
AI_COMMAND_BRAIN_URL=http://ai-command-brain:3001
AI_SWARM_URL=http://ai-swarm:3002
AI_ADVANCED_URL=http://ai-advanced:3003
AI_SWARM_SIZE=1008
AI_MCP_TOOLS=87

# Monitoring & Logging
LOG_LEVEL=Information
AUDIT_ENABLED=true
AUDIT_LOG_TO_DATABASE=true
AUDIT_LOG_TO_FILE=true
AUDIT_RETENTION_DAYS=90

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
RATE_LIMITING_ENABLED=true
RATE_LIMITING_REQUESTS_PER_MINUTE=60

# SSL/TLS (Production)
SSL_ENABLED=false
SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# External Services
HARRIS_PACS_URL=https://api.harrispacs.com
HARRIS_PACS_API_KEY=your-api-key-here

# County Configuration
DEFAULT_COUNTY=benton
COUNTY_NAME=Benton County
COUNTY_STATE=WA

# Performance
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30
CACHE_DURATION_MINUTES=5

# Docker Specific
DOCKER_REGISTRY=terrafusion
COMPOSE_PROJECT_NAME=terrafusion-os
