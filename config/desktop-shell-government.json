{
  "desktop_shell_config": {
    "government_mode": true,
    "security_level": "government_grade",
    "accessibility": {
      "section_508_compliant": true,
      "wcag_level": "AAA",
      "screen_reader_support": true,
      "keyboard_navigation": true,
      "high_contrast_available": true,
      "font_scaling": true,
      "voice_control": true
    },
    "government_applications": {
      "quick_launch": [
        {
          "name": "Emergency Management",
          "icon": "🚨",
          "module": "emergency-management-portal",
          "priority": "critical",
          "shortcut": "Ctrl+Alt+E"
        },
        {
          "name": "Property Assessment",
          "icon": "🏠",
          "module": "property-assessor",
          "priority": "high",
          "shortcut": "Ctrl+Alt+P"
        },
        {
          "name": "Tax Collection",
          "icon": "💰",
          "module": "tax-collector",
          "priority": "high",
          "shortcut": "Ctrl+Alt+T"
        },
        {
          "name": "Education Management",
          "icon": "📚",
          "module": "education-management-portal",
          "priority": "high",
          "shortcut": "Ctrl+Alt+Ed"
        },
        {
          "name": "Parks & Recreation",
          "icon": "🌳",
          "module": "parks-recreation-portal",
          "priority": "medium",
          "shortcut": "Ctrl+Alt+R"
        },
        {
          "name": "Transportation",
          "icon": "🚍",
          "module": "smart-transportation-portal",
          "priority": "medium",
          "shortcut": "Ctrl+Alt+Tr"
        }
      ],
      "system_tools": [
        {
          "name": "System Monitor",
          "icon": "📊",
          "module": "system-monitor",
          "priority": "low"
        },
        {
          "name": "AI Agent Console",
          "icon": "🤖",
          "module": "ai-console",
          "priority": "low"
        },
        {
          "name": "Trust Fabric",
          "icon": "🛡️",
          "module": "trust-fabric",
          "priority": "critical"
        }
      ]
    },
    "desktop_widgets": {
      "default_widgets": [
        {
          "id": "emergency_alerts",
          "name": "Emergency Alerts",
          "type": "notification",
          "position": {"x": 20, "y": 20},
          "size": {"width": 300, "height": 120},
          "data_source": "emergency-management-portal",
          "refresh_interval": 10,
          "priority": "critical"
        },
        {
          "id": "system_health",
          "name": "TerraFusion System Health",
          "type": "status",
          "position": {"x": 340, "y": 20},
          "size": {"width": 250, "height": 100},
          "data_source": "system-monitor",
          "refresh_interval": 30,
          "priority": "high"
        },
        {
          "id": "active_workflows",
          "name": "Active Government Workflows",
          "type": "workflow",
          "position": {"x": 20, "y": 160},
          "size": {"width": 300, "height": 200},
          "data_source": "workflow-engine",
          "refresh_interval": 60,
          "priority": "medium"
        },
        {
          "id": "ai_agent_status",
          "name": "AI Agent Status",
          "type": "monitoring",
          "position": {"x": 340, "y": 140},
          "size": {"width": 250, "height": 120},
          "data_source": "ai-swarm",
          "refresh_interval": 45,
          "priority": "medium"
        }
      ],
      "widget_settings": {
        "auto_arrange": true,
        "snap_to_grid": true,
        "transparency": 0.9,
        "always_on_top": false,
        "government_theme": true
      }
    },
    "themes": {
      "government_dark": {
        "name": "TerraFusion Government Dark",
        "primary_color": "#0099ff",
        "secondary_color": "#00ffaa",
        "accent_color": "#00ffee",
        "background_color": "#0b1020",
        "text_color": "#ffffff",
        "window_decoration": "government_standard"
      },
      "government_light": {
        "name": "TerraFusion Government Light",
        "primary_color": "#0077cc",
        "secondary_color": "#00cc88",
        "accent_color": "#00ccbb",
        "background_color": "#f5f5f5",
        "text_color": "#333333",
        "window_decoration": "government_standard"
      },
      "high_contrast": {
        "name": "Government High Contrast",
        "primary_color": "#ffffff",
        "secondary_color": "#ffff00",
        "accent_color": "#00ffff",
        "background_color": "#000000",
        "text_color": "#ffffff",
        "window_decoration": "high_contrast"
      }
    },
    "security": {
      "audit_logging": true,
      "session_timeout": 30,
      "screen_lock_timeout": 15,
      "secure_clipboard": true,
      "watermark_enabled": true,
      "screenshot_protection": true
    },
    "performance": {
      "gpu_acceleration": true,
      "hardware_acceleration": true,
      "memory_optimization": true,
      "background_process_limit": 50,
      "animation_quality": "high"
    },
    "government_compliance": {
      "fisma_compliant": true,
      "section_508_validated": true,
      "fedramp_ready": true,
      "sox_compliant": true,
      "audit_trail_enabled": true
    }
  }
}