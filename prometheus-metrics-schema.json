    "metrics": {
      "performance_metrics": {
        "terrafusion_api_requests_total": {
          "type": "counter",
          "description": "Total number of API requests to TerraFusion OS",
          "labels": ["method", "endpoint", "status_code", "county"]
        },
        "terrafusion_api_request_duration_seconds": {
          "type": "histogram",
          "description": "Request duration in seconds for TerraFusion OS API",
          "labels": ["method", "endpoint", "county"],
          "buckets": [0.001, 0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0]
        },
        "terrafusion_rust_engine_operations_total": {
          "type": "counter", 
          "description": "Total operations processed by Elite Rust Performance Engine",
          "labels": ["crate", "operation_type", "success"]
        },
        "terrafusion_rust_engine_latency_ms": {
          "type": "histogram",
          "description": "Elite Rust Performance Engine operation latency in milliseconds",
          "labels": ["crate", "operation"],
          "buckets": [0.5, 1.0, 2.0, 5.0, 10.0, 25.0, 50.0, 100.0, 250.0, 500.0]
        }
      },
