{
  "name": "terrafusion-public-safety-frontend",
  "version": "1.0.0",
  "description": "TerraFusion Public Safety & Law Enforcement Frontend - Advanced incident response, officer management, and emergency dispatch for Benton County, Washington",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist node_modules/.vite",
    "analyze": "npx vite-bundle-analyzer"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "react-leaflet": "^4.2.1",
    "leaflet": "^1.9.4",
    "react-calendar": "^4.6.0",
    "react-datepicker": "^4.21.0",
    "date-fns": "^2.30.0",
    "recharts": "^2.8.0",
    "react-modal": "^3.16.1",
    "react-tooltip": "^5.21.4",
    "react-csv": "^2.2.2",
    "xlsx": "^0.18.5",
    "jspdf": "^2.5.1",
    "socket.io-client": "^4.7.2",
    "axios": "^1.5.0",
    "lodash": "^4.17.21",
    "classnames": "^2.3.2",
    "react-hook-form": "^7.45.4",
    "react-select": "^5.7.4",
    "react-table": "^7.8.0",
    "react-virtualized": "^9.22.5",
    "react-window": "^1.8.8",
    "react-intersection-observer": "^9.5.2",
    "framer-motion": "^10.16.4",
    "react-hotkeys-hook": "^4.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/leaflet": "^1.9.7",
    "@types/lodash": "^4.14.195",
    "@types/react-csv": "^1.1.3",
    "@types/react-table": "^7.7.14",
    "@types/react-virtualized": "^9.21.21",
    "@types/react-window": "^1.8.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "prettier": "^3.0.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^0.34.0",
    "@vitest/coverage-v8": "^0.34.0",
    "jsdom": "^22.1.0"
  },
  "keywords": [
    "terrafusion",
    "public safety",
    "law enforcement",
    "emergency response",
    "police department",
    "fire department",
    "911 dispatch",
    "incident management",
    "officer tracking",
    "crime analytics",
    "emergency management",
    "benton county",
    "washington state",
    "government software",
    "public sector",
    "first responders",
    "emergency services",
    "public safety technology",
    "law enforcement software",
    "dispatch system"
  ],
  "author": "TerraFusion OS Development Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion-os/public-safety-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/terrafusion-os/public-safety-frontend/issues"
  },
  "homepage": "https://terrafusion-os.gov/public-safety",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  }
}