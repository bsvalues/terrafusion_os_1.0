{
  "name": "terrafusion-research-engine-frontend",
  "version": "1.0.0",
  "description": "TerraFusion Research Engine Frontend - Autonomous Research Coordination Dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite --port ${TF_API_PORT:-5000}",
    "build": "tsc && vite build",
    "preview": "vite preview --port ${TF_API_PORT:-5000}",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.8.0",
    "socket.io-client": "^4.7.2",
    "react-syntax-highlighter": "^15.5.0",
    "react-markdown": "^9.0.0",
    "react-diff-viewer": "^3.1.1",
    "monaco-editor": "^0.44.0",
    "@monaco-editor/react": "^4.6.0",
    "react-flow-renderer": "^10.3.17",
    "dagre": "^0.8.5",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.284.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-syntax-highlighter": "^15.5.7",
    "@types/dagre": "^0.7.48",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "typescript": "^5.2.2",
    "vite": "^4.5.0"
  },
  "keywords": [
    "terrafusion",
    "research-engine",
    "autonomous-research",
    "ai-agents",
    "research-coordination",
    "government-research",
    "react",
    "typescript",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bsvalues/terrafusion_os_1.0.git",
    "directory": "services/research-engine/frontend"
  },
  "author": "TerraFusion OS Team",
  "license": "TerraFusion Government License",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}