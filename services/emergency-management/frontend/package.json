{
  "name": "terrafusion-emergency-management-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "TerraFusion Emergency Management & Disaster Response - Advanced incident command, emergency notifications, disaster response coordination, and crisis management for Benton County Washington",
  "type": "module",
  "scripts": {
    "dev": "vite --port ${TF_PORT_5280:-5280} --host",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --port ${TF_PORT_5280:-5280} --host",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "axios": "^1.6.2",
    "socket.io-client": "^4.7.4",
    "date-fns": "^2.30.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.8.0",
    "framer-motion": "^10.16.16",
    "react-query": "^3.39.3",
    "react-hook-form": "^7.48.2",
    "react-select": "^5.8.0",
    "react-datepicker": "^4.25.0",
    "react-modal": "^3.16.1",
    "react-toastify": "^9.1.3",
    "lucide-react": "^0.294.0",
    "classnames": "^2.3.2",
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "react-beautiful-dnd": "^13.1.1",
    "react-hotkeys-hook": "^4.4.1",
    "qrcode.react": "^3.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "file-saver": "^2.0.5",
    "xlsx": "^0.18.5",
    "uuid": "^9.0.1",
    "@turf/turf": "^6.5.0",
    "proj4": "^2.9.2",
    "d3": "^7.8.5",
    "react-virtualized": "^9.22.5",
    "react-window": "^1.8.8",
    "fuse.js": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-runtime-caching": "^6.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/leaflet": "^1.9.8",
    "@types/react-modal": "^3.16.3",
    "@types/react-beautiful-dnd": "^13.1.7",
    "@types/uuid": "^9.0.7",
    "@types/file-saver": "^2.0.7",
    "@types/d3": "^7.4.3",
    "@types/react-virtualized": "^9.21.29",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "jsdom": "^22.1.0",
    "prettier": "^3.1.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/user-event": "^14.5.1"
  },
  "keywords": [
    "emergency-management",
    "disaster-response",
    "incident-command",
    "crisis-management",
    "emergency-alerts",
    "benton-county",
    "terrafusion",
    "government",
    "public-safety",
    "emergency-services",
    "disaster-preparedness",
    "response-coordination",
    "emergency-notifications",
    "incident-tracking",
    "resource-management"
  ],
  "author": "TerraFusion OS - Government Operating System",
  "license": "Proprietary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terrafusion/emergency-management.git"
  },
  "homepage": "https://github.com/terrafusion/emergency-management#readme",
  "bugs": {
    "url": "https://github.com/terrafusion/emergency-management/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}