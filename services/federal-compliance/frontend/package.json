{
  "name": "terrafusion-federal-compliance-frontend",
  "version": "2.0.0",
  "description": "TerraFusion OS Federal Compliance Service Frontend - FISMA, NIST, and Government Regulatory Compliance Dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite --port ${TF_FRONTEND_3015_PORT:-3015} --host",
    "build": "tsc && vite build",
    "build:gov": "tsc && vite build --mode government",
    "preview": "vite preview --port ${TF_FRONTEND_3015_PORT:-3015}",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "security:audit": "npm audit && npm audit fix",
    "compliance:check": "echo 'Running FISMA compliance validation...' && npm run lint && npm run type-check",
    "start": "npm run dev"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "socket.io-client": "^4.7.4",
    "recharts": "^2.8.0",
    "lucide-react": "^0.294.0",
    "date-fns": "^2.30.0",
    "react-virtualized": "^9.22.5",
    "react-table": "^7.8.0",
    "@tanstack/react-table": "^8.10.7",
    "react-hook-form": "^7.48.2",
    "zod": "^3.22.4",
    "@hookform/resolvers": "^3.3.2",
    "framer-motion": "^10.16.5",
    "react-dropzone": "^14.2.3",
    "xlsx": "^0.18.5",
    "jspdf": "^2.5.1",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-virtualized": "^9.21.29",
    "@types/react-table": "^7.7.18",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "vitest": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "jsdom": "^22.1.0"
  },
  "keywords": [
    "terrafusion",
    "federal-compliance",
    "government",
    "fisma",
    "nist",
    "regulatory-compliance",
    "audit-management",
    "government-dashboard",
    "compliance-tracking",
    "regulatory-oversight"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/terrafusion-os"
  },
  "author": "TerraFusion OS Development Team",
  "license": "Government Use",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  }
}