{
  "name": "terrafusion-testing-suite-frontend",
  "version": "1.0.0",
  "description": "TerraFusion Testing Suite Frontend - Automated testing dashboard for ecosystem quality assurance",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.7.2",
    "recharts": "^2.8.0",
    "date-fns": "^2.30.0",
    "react-router-dom": "^6.15.0",
    "axios": "^1.5.0",
    "react-query": "^3.39.3",
    "react-hot-toast": "^2.4.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-diff-viewer": "^3.1.1",
    "react-virtualized": "^9.22.5",
    "react-window": "^1.8.8",
    "monaco-editor": "^0.41.0",
    "@monaco-editor/react": "^4.5.1",
    "prismjs": "^1.29.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-syntax-highlighter": "^15.5.7",
    "@types/react-virtualized": "^9.21.22",
    "@types/react-window": "^1.8.5",
    "@types/prismjs": "^1.26.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^0.34.0",
    "@vitest/ui": "^0.34.0",
    "c8": "^8.0.1"
  },
  "keywords": [
    "terrafusion",
    "testing",
    "quality-assurance",
    "automation",
    "dashboard",
    "government",
    "react",
    "typescript"
  ],
  "author": "TerraFusion OS Team",
  "license": "Government",
  "homepage": "http://localhost:${TF_PORT_4000:-4000}",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/terrafusion-os"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}