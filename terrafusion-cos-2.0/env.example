# TerraFusion cOS 2.0 - Environment Configuration
# MIT PhD Systems Design Engineer Standards
# Vendor Substrate Platform

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Database Configuration
DATABASE_URL=postgresql://terrafusion:terrafusion@localhost:5432/terrafusion_cos_2_0
POSTGRES_DB=terrafusion_cos_2_0
POSTGRES_USER=terrafusion
POSTGRES_PASSWORD=terrafusion
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=terrafusion

# Security Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-here-change-in-production
ENCRYPTION_KEY=your-32-character-encryption-key-here
SECRET_KEY=your-secret-key-for-session-management
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# TerraFusion Services
KERNEL_URL=http://localhost:8000
SUBSTRATE_URL=http://localhost:8001
AI_SWARM_URL=http://localhost:8002
SECURITY_MESH_URL=http://localhost:8003
TERRAFUSION_SYNC_URL=http://localhost:8004
TERRA_FLOW_URL=http://localhost:8005

# Applications
COSTFORGE_AI_URL=http://localhost:8006
TERRAFUSION_IDE_URL=http://localhost:8007
FRONTEND_URL=http://localhost:3000

# Monitoring
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001

# Vendor Integration
VENDOR_API_KEY=your-vendor-api-key-here
VENDOR_WEBHOOK_SECRET=your-vendor-webhook-secret-here

# Compliance
FISMA_COMPLIANCE=true
NIST_800_53_COMPLIANCE=true
SECTION_508_COMPLIANCE=true
FEDRAMP_COMPLIANCE=false

# Performance
MAX_WORKERS=4
WORKER_TIMEOUT=30
KEEPALIVE_TIMEOUT=5
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_FORMAT=json
LOG_FILE=/app/logs/terrafusion-cos-2.0.log
LOG_ROTATION=daily
LOG_RETENTION=30

# Health Checks
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Development
RELOAD=true
WORKERS=1
ACCESS_LOG=true
ERROR_LOG=true

# Production
RELOAD=false
WORKERS=4
ACCESS_LOG=false
ERROR_LOG=true

# SSL/TLS
SSL_ENABLED=false
SSL_CERT_PATH=/app/ssl/cert.pem
SSL_KEY_PATH=/app/ssl/key.pem

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=/app/storage
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,json,xml

# Cache Configuration
CACHE_TYPE=redis
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Session Configuration
SESSION_TYPE=redis
SESSION_TTL=86400
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=strict

# WebSocket Configuration
WS_ENABLED=true
WS_HEARTBEAT_INTERVAL=30
WS_HEARTBEAT_TIMEOUT=60

# Background Tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Testing
TEST_DATABASE_URL=postgresql://terrafusion:terrafusion@localhost:5432/terrafusion_cos_2_0_test
TEST_REDIS_URL=redis://localhost:6379/15

# Documentation
API_DOCS_ENABLED=true
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# Metrics
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_PORT=9090

# Tracing
TRACING_ENABLED=false
TRACING_SERVICE_NAME=terrafusion-cos-2.0
TRACING_AGENT_HOST=localhost
TRACING_AGENT_PORT=6831

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION=30
BACKUP_PATH=/app/backups

# Alerting
ALERTING_ENABLED=true
ALERTING_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
ALERTING_EMAIL=alerts@terrafusion.gov

# Feature Flags
FEATURE_AI_SWARM=true
FEATURE_SECURITY_MESH=true
FEATURE_TERRAFUSION_SYNC=true
FEATURE_TERRA_FLOW=true
FEATURE_COSTFORGE_AI=true
FEATURE_TERRAFUSION_IDE=true
FEATURE_VENDOR_INTEGRATION=true
FEATURE_COMPLIANCE_AUTOMATION=true

# Vendor Specific
HARRIS_API_URL=https://api.harris.com
HARRIS_API_KEY=your-harris-api-key
HARRIS_WEBHOOK_SECRET=your-harris-webhook-secret

TYLER_API_URL=https://api.tylertech.com
TYLER_API_KEY=your-tyler-api-key
TYLER_WEBHOOK_SECRET=your-tyler-webhook-secret

ESRI_API_URL=https://api.esri.com
ESRI_API_KEY=your-esri-api-key
ESRI_WEBHOOK_SECRET=your-esri-webhook-secret

# Government Compliance
GOVERNMENT_ENTITY_ID=your-government-entity-id
GOVERNMENT_ENTITY_NAME=Your Government Entity
GOVERNMENT_ENTITY_TYPE=county
GOVERNMENT_ENTITY_STATE=WA
GOVERNMENT_ENTITY_COUNTY=Benton

# Audit and Compliance
AUDIT_ENABLED=true
AUDIT_LOG_LEVEL=INFO
AUDIT_RETENTION_DAYS=2555
COMPLIANCE_REPORTING=true
COMPLIANCE_REPORT_SCHEDULE=0 0 1 * *

# Performance Monitoring
PERFORMANCE_MONITORING=true
PERFORMANCE_THRESHOLD_MS=100
PERFORMANCE_ALERT_THRESHOLD_MS=500
PERFORMANCE_SAMPLING_RATE=0.1

# Security Monitoring
SECURITY_MONITORING=true
SECURITY_ALERT_THRESHOLD=5
SECURITY_BLOCK_THRESHOLD=10
SECURITY_BLOCK_DURATION=3600

# Data Privacy
DATA_PRIVACY_ENABLED=true
DATA_RETENTION_DAYS=2555
DATA_ANONYMIZATION=true
DATA_ENCRYPTION_AT_REST=true
DATA_ENCRYPTION_IN_TRANSIT=true

# Disaster Recovery
DISASTER_RECOVERY_ENABLED=true
DISASTER_RECOVERY_RTO=3600
DISASTER_RECOVERY_RPO=900
DISASTER_RECOVERY_BACKUP_LOCATION=s3://terrafusion-backups

# High Availability
HA_ENABLED=false
HA_PRIMARY_NODE=node1
HA_SECONDARY_NODE=node2
HA_FAILOVER_TIMEOUT=30
HA_HEALTH_CHECK_INTERVAL=10

# Load Balancing
LOAD_BALANCER_ENABLED=true
LOAD_BALANCER_ALGORITHM=round_robin
LOAD_BALANCER_HEALTH_CHECK=true
LOAD_BALANCER_STICKY_SESSIONS=false

# Auto Scaling
AUTO_SCALING_ENABLED=false
AUTO_SCALING_MIN_INSTANCES=2
AUTO_SCALING_MAX_INSTANCES=10
AUTO_SCALING_TARGET_CPU=70
AUTO_SCALING_TARGET_MEMORY=80

# Cost Optimization
COST_OPTIMIZATION_ENABLED=true
COST_OPTIMIZATION_THRESHOLD=1000
COST_OPTIMIZATION_ALERT_EMAIL=cost-alerts@terrafusion.gov

# Quality Assurance
QA_ENABLED=true
QA_AUTOMATED_TESTING=true
QA_CODE_COVERAGE_THRESHOLD=95
QA_PERFORMANCE_TESTING=true
QA_SECURITY_TESTING=true

# Continuous Integration
CI_ENABLED=true
CI_BUILD_TIMEOUT=1800
CI_TEST_TIMEOUT=900
CI_DEPLOY_TIMEOUT=600

# Continuous Deployment
CD_ENABLED=false
CD_AUTO_DEPLOY=false
CD_DEPLOYMENT_STRATEGY=blue_green
CD_ROLLBACK_ENABLED=true

# Infrastructure as Code
IAC_ENABLED=true
IAC_PROVIDER=terraform
IAC_STATE_BACKEND=s3
IAC_STATE_BUCKET=terrafusion-terraform-state

# Container Registry
CONTAINER_REGISTRY=registry.terrafusion.gov
CONTAINER_REGISTRY_USERNAME=terrafusion
CONTAINER_REGISTRY_PASSWORD=your-registry-password

# Kubernetes
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=terrafusion-cos-2-0
KUBERNETES_CLUSTER=terrafusion-cluster
KUBERNETES_CONTEXT=terrafusion-context

# Service Mesh
SERVICE_MESH_ENABLED=false
SERVICE_MESH_PROVIDER=istio
SERVICE_MESH_NAMESPACE=istio-system

# API Gateway
API_GATEWAY_ENABLED=true
API_GATEWAY_PROVIDER=kong
API_GATEWAY_URL=http://localhost:8001
API_GATEWAY_ADMIN_URL=http://localhost:8001/admin

# Message Queue
MESSAGE_QUEUE_ENABLED=true
MESSAGE_QUEUE_PROVIDER=redis
MESSAGE_QUEUE_URL=redis://localhost:6379/3

# Event Streaming
EVENT_STREAMING_ENABLED=false
EVENT_STREAMING_PROVIDER=kafka
EVENT_STREAMING_BROKERS=localhost:9092
EVENT_STREAMING_TOPIC=terrafusion-events

# Search Engine
SEARCH_ENGINE_ENABLED=false
SEARCH_ENGINE_PROVIDER=elasticsearch
SEARCH_ENGINE_URL=http://localhost:9200
SEARCH_ENGINE_INDEX=terrafusion

# Object Storage
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=terrafusion-storage
OBJECT_STORAGE_REGION=us-west-2

# CDN
CDN_ENABLED=false
CDN_PROVIDER=cloudfront
CDN_DOMAIN=cdn.terrafusion.gov

# DNS
DNS_ENABLED=false
DNS_PROVIDER=route53
DNS_DOMAIN=terrafusion.gov
DNS_SUBDOMAIN=api

# Certificate Management
CERT_MANAGEMENT_ENABLED=false
CERT_PROVIDER=letsencrypt
CERT_EMAIL=certificates@terrafusion.gov
CERT_DOMAIN=api.terrafusion.gov

# Monitoring and Alerting
MONITORING_ENABLED=true
MONITORING_PROVIDER=prometheus
MONITORING_URL=http://localhost:9090
ALERTING_PROVIDER=alertmanager
ALERTING_URL=http://localhost:9093

# Logging
LOGGING_ENABLED=true
LOGGING_PROVIDER=elasticsearch
LOGGING_URL=http://localhost:9200
LOGGING_INDEX=terrafusion-logs

# Tracing
TRACING_ENABLED=false
TRACING_PROVIDER=jaeger
TRACING_URL=http://localhost:16686

# Metrics
METRICS_ENABLED=true
METRICS_PROVIDER=prometheus
METRICS_URL=http://localhost:9090
METRICS_PATH=/metrics

# Dashboards
DASHBOARDS_ENABLED=true
DASHBOARDS_PROVIDER=grafana
DASHBOARDS_URL=http://localhost:3001
DASHBOARDS_USERNAME=admin
DASHBOARDS_PASSWORD=terrafusion

# Reporting
REPORTING_ENABLED=true
REPORTING_SCHEDULE=0 0 * * *
REPORTING_FORMAT=pdf
REPORTING_EMAIL=reports@terrafusion.gov

# Backup and Recovery
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION=30
BACKUP_PROVIDER=s3
BACKUP_BUCKET=terrafusion-backups

# Disaster Recovery
DR_ENABLED=false
DR_RTO=3600
DR_RPO=900
DR_BACKUP_LOCATION=s3://terrafusion-dr-backups

# High Availability
HA_ENABLED=false
HA_PRIMARY_NODE=node1
HA_SECONDARY_NODE=node2
HA_FAILOVER_TIMEOUT=30

# Load Balancing
LB_ENABLED=true
LB_ALGORITHM=round_robin
LB_HEALTH_CHECK=true
LB_STICKY_SESSIONS=false

# Auto Scaling
AS_ENABLED=false
AS_MIN_INSTANCES=2
AS_MAX_INSTANCES=10
AS_TARGET_CPU=70
AS_TARGET_MEMORY=80

# Cost Optimization
COST_OPTIMIZATION_ENABLED=true
COST_THRESHOLD=1000
COST_ALERT_EMAIL=cost-alerts@terrafusion.gov

# Quality Assurance
QA_ENABLED=true
QA_AUTOMATED_TESTING=true
QA_CODE_COVERAGE_THRESHOLD=95
QA_PERFORMANCE_TESTING=true
QA_SECURITY_TESTING=true

# Continuous Integration
CI_ENABLED=true
CI_BUILD_TIMEOUT=1800
CI_TEST_TIMEOUT=900
CI_DEPLOY_TIMEOUT=600

# Continuous Deployment
CD_ENABLED=false
CD_AUTO_DEPLOY=false
