{
  "title": "Golden Service \u2014 Flexible SRE (Labels/Ingress Agnostic)",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": "$ds",
        "label": "Namespace",
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "current": {
          "text": "golden",
          "value": "golden"
        }
      },
      {
        "name": "workload",
        "type": "textbox",
        "label": "Workload regex (pod or deployment)",
        "query": ".*grfe.*",
        "current": {
          "text": ".*grfe.*",
          "value": ".*grfe.*"
        }
      },
      {
        "name": "ingress_mode",
        "type": "custom",
        "label": "Ingress mode",
        "query": "nginx,envoy,traefik,none",
        "current": {
          "text": "nginx",
          "value": "nginx"
        }
      },
      {
        "name": "container_metric_set",
        "type": "custom",
        "label": "Container metrics source",
        "query": "cadvisor,ksm",
        "current": {
          "text": "cadvisor",
          "value": "cadvisor"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests/sec (by route)",
      "datasource": "$ds",
      "targets": [
        {
          "expr": "sum by (route) (rate(grfe_requests_total{namespace=~\"$namespace\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingress p95 latency",
      "datasource": "$ds",
      "targets": [
        {
          "refId": "A",
          "hide": false,
          "expr": "histogram_quantile(0.95, sum(rate(nginx_ingress_controller_request_duration_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])) by (le))",
          "legendFormat": "nginx p95",
          "exemplar": true
        },
        {
          "refId": "B",
          "hide": false,
          "expr": "histogram_quantile(0.95, sum(rate(envoy_http_downstream_rq_time_bucket{namespace=~\"$namespace\"}[$__rate_interval])) by (le))",
          "legendFormat": "envoy p95"
        },
        {
          "refId": "C",
          "hide": false,
          "expr": "histogram_quantile(0.95, sum(rate(traefik_service_request_duration_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])) by (le))",
          "legendFormat": "traefik p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "transformations": []
    },
    {
      "type": "timeseries",
      "title": "5xx error rate (%)",
      "datasource": "$ds",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(nginx_ingress_controller_requests{status=~\"5..\",namespace=~\"$namespace\"}[$__rate_interval])) / sum(rate(nginx_ingress_controller_requests{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "nginx"
        },
        {
          "refId": "B",
          "expr": "100 * sum(rate(envoy_http_downstream_rq{response_code_class=\"5\",namespace=~\"$namespace\"}[$__rate_interval])) / sum(rate(envoy_http_downstream_rq{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "envoy"
        },
        {
          "refId": "C",
          "expr": "100 * sum(rate(traefik_service_requests_total{code=~\"5..\",namespace=~\"$namespace\"}[$__rate_interval])) / sum(rate(traefik_service_requests_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "traefik"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU (per pod)",
      "datasource": "$ds",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$workload\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} cAdvisor"
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$workload\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} ksm-equiv"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory (bytes per pod)",
      "datasource": "$ds",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_usage_bytes{namespace=~\"$namespace\", pod=~\"$workload\"})",
          "legendFormat": "{{pod}} cAdvisor"
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"$workload\"})",
          "legendFormat": "{{pod}} working_set"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Quota rejections / min",
      "datasource": "$ds",
      "targets": [
        {
          "expr": "sum(increase(grfe_quota_reject_total{namespace=~\"$namespace\"}[$__rate_interval]))"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}