{
  "dashboard": {
    "id": null,
    "title": "Terrafusion OS Overview",
    "tags": ["terrafusion", "overview"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "System Health Overview",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"terrafusion-backend\"}",
            "legendFormat": "Backend API"
          },
          {
            "expr": "up{job=\"terrafusion-frontend\"}",
            "legendFormat": "Frontend"
          },
          {
            "expr": "up{job=\"ai-swarm\"}",
            "legendFormat": "AI Swarm"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "green", "value": 1 }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "AI Agent Count",
        "type": "stat",
        "targets": [
          {
            "expr": "ai_agent_total_count",
            "legendFormat": "Total AI Agents"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 500 },
                { "color": "green", "value": 1000 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Response Time - Backend API",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"terrafusion-backend\"}[5m]))",
            "legendFormat": "95th Percentile"
          },
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"terrafusion-backend\"}[5m]))",
            "legendFormat": "50th Percentile"
          }
        ],
        "yAxes": [
          {
            "label": "Response Time (seconds)",
            "unit": "s"
          }
        ]
      },
      {
        "id": 4,
        "title": "Request Rate - Backend API",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"terrafusion-backend\"}[5m])",
            "legendFormat": "Requests/sec"
          }
        ],
        "yAxes": [
          {
            "label": "Requests per Second",
            "unit": "reqps"
          }
        ]
      },
      {
        "id": 5,
        "title": "Error Rate - Backend API",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"terrafusion-backend\", status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"terrafusion-backend\"}[5m]) * 100",
            "legendFormat": "Error Rate %"
          }
        ],
        "yAxes": [
          {
            "label": "Error Rate (%)",
            "unit": "percent"
          }
        ]
      },
      {
        "id": 6,
        "title": "System Resources",
        "type": "graph",
        "targets": [
          {
            "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU Usage %"
          },
          {
            "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
            "legendFormat": "Memory Usage %"
          }
        ],
        "yAxes": [
          {
            "label": "Usage (%)",
            "unit": "percent"
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
