{
  "title": "TerraFusion OS - Benton County Production Dashboard",
  "timezone": "browser",
  "tags": ["terrafusion", "benton-county", "government", "production"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus Datasource",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": "${ds}",
        "label": "Namespace",
        "query": "label_values(container_cpu_usage_seconds_total, namespace)",
        "regex": "terrafusion.*",
        "refresh": 1,
        "current": {
          "text": "terrafusion-prod",
          "value": "terrafusion-prod"
        }
      },
      {
        "name": "county",
        "type": "query", 
        "datasource": "${ds}",
        "label": "County",
        "query": "label_values(terrafusion_api_requests_total, county)",
        "refresh": 1,
        "current": {
          "text": "benton",
          "value": "benton"
        }
      },
      {
        "name": "host",
        "type": "query",
        "datasource": "${ds}",
        "label": "TerraFusion Host",
        "query": "label_values(nginx_ingress_controller_requests{namespace=~\"${namespace}\"}, host)",
        "regex": ".*bentoncountywa.terrafusion.gov",
        "refresh": 1,
        "current": {
          "text": "api.bentoncountywa.terrafusion.gov",
          "value": "api.bentoncountywa.terrafusion.gov"
        }
      }
    ]
  },
  "panels": [
    {
      "title": "TerraFusion OS - Executive Overview",
      "type": "stat",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(terrafusion_ai_agents_total{namespace=~\"${namespace}\"})",
          "legendFormat": "Active AI Agents"
        },
        {
          "expr": "sum(rate(terrafusion_api_requests_total{namespace=~\"${namespace}\", county=~\"${county}\"}[5m])) * 60",
          "legendFormat": "API Requests/min"
        },
        {
          "expr": "sum(terrafusion_ai_swarm_efficiency{namespace=~\"${namespace}\", county=~\"${county}\"})",
          "legendFormat": "AI Swarm Efficiency %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "TerraFusion API Gateway - Request Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {
          "expr": "sum(rate(nginx_ingress_controller_requests{namespace=~\"${namespace}\", host=~\"${host}\"}[5m])) by (host, method)",
          "legendFormat": "{{host}} - {{method}}"
        },
        {
          "expr": "sum(rate(terrafusion_api_requests_total{namespace=~\"${namespace}\", county=~\"${county}\"}[5m])) by (endpoint, method)",
          "legendFormat": "{{endpoint}} - {{method}}"
        }
      ],
      "yAxes": [
        {
          "label": "Requests/sec",
          "min": 0
        }
      ],
      "legend": {
        "show": true,
        "values": true,
        "current": true
      }
    },
    {
      "title": "Elite Rust Performance Engine - Operations",
      "type": "graph", 
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "sum(rate(terrafusion_rust_engine_operations_total{namespace=~\"${namespace}\"}[5m])) by (crate, operation_type)",
          "legendFormat": "{{crate}} - {{operation_type}}"
        }
      ],
      "yAxes": [
        {
          "label": "Operations/sec",
          "min": 0
        }
      ],
      "legend": {
        "show": true,
        "values": true,
        "current": true
      }
    },
    {
      "title": "API Response Times (P95)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nginx_ingress_controller_request_duration_seconds_bucket{namespace=~\"${namespace}\", host=~\"${host}\"}[5m])) by (host, le))",
          "legendFormat": "{{host}} P95"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(terrafusion_api_request_duration_seconds_bucket{namespace=~\"${namespace}\", county=~\"${county}\"}[5m])) by (endpoint, le))",
          "legendFormat": "{{endpoint}} P95"
        }
      ],
      "yAxes": [
        {
          "label": "Seconds",
          "min": 0,
          "max": 0.1
        }
      ],
      "legend": {
        "show": true,
        "values": true,
        "current": true
      }
    },
    {
      "title": "Elite Rust Engine - Latency (P99)", 
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(terrafusion_rust_engine_latency_ms_bucket{namespace=~\"${namespace}\"}[5m])) by (crate, operation, le)) / 1000",
          "legendFormat": "{{crate}} - {{operation}} P99"
        }
      ],
      "yAxes": [
        {
          "label": "Seconds",
          "min": 0,
          "max": 0.005
        }
      ],
      "legend": {
        "show": true,
        "values": true,
        "current": true
      }
    },
    {
      "title": "AI Swarm Coordination",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [
        {
          "expr": "sum(terrafusion_ai_agents_total{namespace=~\"${namespace}\"}) by (tier, agent_type, status)",
          "legendFormat": "Tier {{tier}} - {{agent_type}} ({{status}})"
        },
        {
          "expr": "sum(terrafusion_quantum_coherence{namespace=~\"${namespace}\"}) by (agent_type)",
          "legendFormat": "Quantum Coherence - {{agent_type}}"
        }
      ],
      "yAxes": [
        {
          "label": "Count / Coherence Level",
          "min": 0
        }
      ],
      "legend": {
        "show": true,
        "values": true,
        "current": true
      }
    },
    {
      "title": "Government Operations",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [
        {
          "expr": "sum(rate(terrafusion_property_assessments_total{namespace=~\"${namespace}\", county=~\"${county}\"}[5m])) by (assessment_type, status)",
          "legendFormat": "{{assessment_type}} - {{status}}"
        },
        {
          "expr": "sum(rate(terrafusion_compliance_events_total{namespace=~\"${namespace}\"}[5m])) by (event_type, security_level)",
          "legendFormat": "{{event_type}} - {{security_level}}"
        }
      ],
      "yAxes": [
        {
          "label": "Events/sec",
          "min": 0
        }
      ],
      "legend": {
        "show": true,
        "values": true,
        "current": true
      }
    },
    {
      "title": "Resource Utilization",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"${namespace}\", container!=\"POD\", container!=\"\"}[5m])) by (container) * 100",
          "legendFormat": "CPU % - {{container}}"
        },
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"${namespace}\", container!=\"POD\", container!=\"\"}) by (container) / 1024 / 1024",
          "legendFormat": "Memory MB - {{container}}"
        }
      ],
      "yAxes": [
        {
          "label": "CPU % / Memory MB",
          "min": 0
        }
      ],
      "legend": {
        "show": true,
        "values": true,
        "current": true
      }
    },
    {
      "title": "Security & Compliance",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "targets": [
        {
          "expr": "sum(rate(terrafusion_security_events_total{namespace=~\"${namespace}\"}[5m])) by (event_type, severity)",
          "legendFormat": "{{event_type}} - {{severity}}"
        },
        {
          "expr": "sum(rate(terrafusion_authentication_attempts_total{namespace=~\"${namespace}\"}[5m])) by (method, success)",
          "legendFormat": "Auth {{method}} - {{success}}"
        }
      ],
      "yAxes": [
        {
          "label": "Events/sec",
          "min": 0
        }
      ],
      "legend": {
        "show": true,
        "values": true,
        "current": true
      }
    }
  ]
}