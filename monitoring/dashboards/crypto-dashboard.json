{
  "dashboard": {
    "id": null,
    "title": "Terrafusion OS 1.0 - Cryptographic Operations Dashboard",
    "tags": ["terrafusion", "cryptography", "security", "government"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
      "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "panels": [
      {
        "id": 1,
        "title": "Signature Verification Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(crypto_signature_verifications_total{status=\"success\"}[5m]) / rate(crypto_signature_verifications_total[5m]) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 98 },
                { "color": "green", "value": 99.5 }
              ]
            }
          }
        },
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Cross-Platform Verification Consensus",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(crypto_consensus_verifications_total{status=\"success\"}[5m]) / rate(crypto_consensus_verifications_total[5m]) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 95 },
                { "color": "green", "value": 98 }
              ]
            }
          }
        },
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 }
      },
      {
        "id": 3,
        "title": "Average Verification Time",
        "type": "stat",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(crypto_verification_duration_seconds_bucket[5m])) * 1000",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 35 },
                { "color": "red", "value": 50 }
              ]
            }
          }
        },
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 }
      },
      {
        "id": 4,
        "title": "Active AI Agents",
        "type": "stat",
        "targets": [
          {
            "expr": "crypto_active_agents_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 800 },
                { "color": "green", "value": 1000 }
              ]
            }
          }
        },
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 }
      },
      {
        "id": 5,
        "title": "Signature Verification Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(crypto_signature_verifications_total{status=\"success\"}[5m])",
            "legendFormat": "Successful Verifications",
            "refId": "A"
          },
          {
            "expr": "rate(crypto_signature_verifications_total{status=\"failed\"}[5m])",
            "legendFormat": "Failed Verifications",
            "refId": "B"
          },
          {
            "expr": "rate(crypto_signature_verifications_total{status=\"error\"}[5m])",
            "legendFormat": "Verification Errors",
            "refId": "C"
          }
        ],
        "yAxes": [
          {
            "label": "Verifications/sec",
            "min": 0
          }
        ],
        "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 }
      },
      {
        "id": 6,
        "title": "Verification Latency Distribution",
        "type": "heatmap",
        "targets": [
          {
            "expr": "rate(crypto_verification_duration_seconds_bucket[5m])",
            "format": "heatmap",
            "refId": "A"
          }
        ],
        "heatmap": {
          "xBucketSize": null,
          "yBucketSize": null,
          "xAxis": {
            "show": true
          },
          "yAxis": {
            "show": true,
            "label": "Response Time (ms)",
            "logBase": 1
          }
        },
        "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 }
      },
      {
        "id": 7,
        "title": "Key Management Health",
        "type": "table",
        "targets": [
          {
            "expr": "key_management_health_status",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "status" },
              "properties": [
                {
                  "id": "mappings",
                  "value": [
                    {
                      "options": {
                        "0": { "text": "Healthy", "color": "green" }
                      },
                      "type": "value"
                    },
                    {
                      "options": {
                        "1": { "text": "Warning", "color": "yellow" }
                      },
                      "type": "value"
                    },
                    {
                      "options": {
                        "2": { "text": "Critical", "color": "red" }
                      },
                      "type": "value"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 17 }
      },
      {
        "id": 8,
        "title": "Anomaly Detection Alerts",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(crypto_anomaly_detections_total{severity=\"high\"}[5m])",
            "legendFormat": "High Severity Anomalies",
            "refId": "A"
          },
          {
            "expr": "rate(crypto_anomaly_detections_total{severity=\"medium\"}[5m])",
            "legendFormat": "Medium Severity Anomalies",
            "refId": "B"
          },
          {
            "expr": "rate(crypto_quarantine_events_total[5m])",
            "legendFormat": "Agent Quarantines",
            "refId": "C"
          }
        ],
        "yAxes": [
          {
            "label": "Events/sec",
            "min": 0
          }
        ],
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 17 }
      },
      {
        "id": 9,
        "title": "Circuit Breaker Status",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(crypto_circuit_breaker_open_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        },
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 17 }
      },
      {
        "id": 10,
        "title": "Provider Verification Comparison",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(crypto_provider_verifications_total{provider=\"nodejs\",status=\"success\"}[5m])",
            "legendFormat": "Node.js Provider",
            "refId": "A"
          },
          {
            "expr": "rate(crypto_provider_verifications_total{provider=\"dotnet\",status=\"success\"}[5m])",
            "legendFormat": ".NET Provider",
            "refId": "B"
          },
          {
            "expr": "rate(crypto_provider_verifications_total{provider=\"openssl\",status=\"success\"}[5m])",
            "legendFormat": "OpenSSL Provider",
            "refId": "C"
          }
        ],
        "yAxes": [
          {
            "label": "Verifications/sec",
            "min": 0
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 }
      },
      {
        "id": 11,
        "title": "Ed25519 Key Rotation Schedule",
        "type": "table",
        "targets": [
          {
            "expr": "crypto_key_age_days",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "age_days" },
              "properties": [
                {
                  "id": "thresholds",
                  "value": {
                    "steps": [
                      { "color": "green", "value": 0 },
                      { "color": "yellow", "value": 76 },
                      { "color": "red", "value": 90 }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 }
      },
      {
        "id": 12,
        "title": "Authentication Success Rate by Agent",
        "type": "heatmap",
        "targets": [
          {
            "expr": "rate(agent_authentication_attempts_total{status=\"success\"}[5m]) by (agent_id)",
            "format": "heatmap",
            "refId": "A"
          }
        ],
        "heatmap": {
          "xAxis": {
            "show": true
          },
          "yAxis": {
            "show": true,
            "label": "Agent ID",
            "logBase": 1
          }
        },
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 }
      },
      {
        "id": 13,
        "title": "Security Events Timeline",
        "type": "logs",
        "targets": [
          {
            "expr": "{job=\"terrafusion-security\"} |= \"SECURITY\" | json",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": true,
          "enableLogDetails": true
        },
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 41 }
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Security Incidents",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "ALERTS{alertname=~\"Crypto.*|Security.*\"}",
          "iconColor": "red",
          "titleFormat": "{{alertname}}",
          "textFormat": "{{description}}"
        }
      ]
    },
    "templating": {
      "list": [
        {
          "name": "environment",
          "type": "query",
          "query": "label_values(environment)",
          "current": {
            "value": "production",
            "text": "production"
          }
        },
        {
          "name": "cluster",
          "type": "query",
          "query": "label_values(cluster)",
          "current": {
            "value": "terrafusion-gov-cluster",
            "text": "terrafusion-gov-cluster"
          }
        }
      ]
    }
  }
}
