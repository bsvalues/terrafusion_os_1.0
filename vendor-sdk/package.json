{
  "name": "@terrafusion/vendor-sdk",
  "version": "1.0.0",
  "description": "TerraFusion cOS Vendor Integration SDK - Zero-Rewrite Platform Integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run build:templates",
    "build:templates": "cp -r src/templates dist/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "npm run test -- --testPathPattern=integration",
    "generate": "node scripts/generate-sdk.js",
    "validate": "node scripts/validate-integration.js",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf dist coverage",
    "prepare": "npm run build"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "jsonwebtoken": "^9.0.0",
    "uuid": "^9.0.0",
    "ws": "^8.14.0",
    "eventemitter3": "^5.0.0",
    "zod": "^3.22.0",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "peerDependencies": {
    "@kubernetes/client-node": "^0.20.0"
  },
  "keywords": [
    "terrafusion",
    "vendor-sdk",
    "integration",
    "government",
    "zero-rewrite",
    "platform",
    "county-os"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./sidecar": "./dist/sidecar/index.js",
    "./auth": "./dist/auth/index.js",
    "./events": "./dist/events/index.js",
    "./data": "./dist/data/index.js",
    "./ui": "./dist/ui/index.js",
    "./testing": "./dist/testing/index.js"
  },
  "files": [
    "dist",
    "templates",
    "schemas",
    "README.md"
  ]
}