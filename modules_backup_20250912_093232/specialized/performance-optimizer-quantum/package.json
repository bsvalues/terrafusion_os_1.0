{
  "name": "@terrafusion/performance-optimizer-quantum",
  "version": "2.0.0",
  "description": "MIT PhD-Level Quantum Performance Optimization Framework for TerraFusion OS",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "docs": "typedoc src/index.ts",
    "start:optimizer": "node dist/performance-optimizer.js",
    "start:predictor": "node dist/bottleneck-predictor.js",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:security": "jest tests/security.test.js",
    "test:performance": "jest tests/performance.test.js",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:install": "cd mcp-server && npm install"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.20.0",
    "systeminformation": "^5.21.22",
    "pidusage": "^3.0.2",
    "node-cache": "^5.1.2",
    "redis": "^4.6.13",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "ws": "^8.16.0",
    "winston": "^3.11.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/uuid": "^9.0.8",
    "@types/lodash": "^4.14.202",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.2",
    "vitest": "^1.4.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "typedoc": "^0.25.12",
    "jest": "^29.0.0",
    "@jest/globals": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "supertest": "^6.0.0",
    "nyc": "^15.0.0"
  },
  "keywords": [
    "terrafusion",
    "performance",
    "optimization",
    "quantum",
    "mit-phd",
    "ml-powered",
    "bottleneck-prediction",
    "government"
  ],
  "author": "TerraFusion AI Performance Team",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "mcp": {
    "server": "./mcp-server",
    "tools": [
      "quantum-interface",
      "experimental-executor",
      "research-coordinator"
    ],
    "capabilities": [
      "real-time-communication"
    ]
  }
}
