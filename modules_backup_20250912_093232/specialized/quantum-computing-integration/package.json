{
  "name": "@terrafusion/quantum-computing-integration",
  "version": "1.0.0",
  "description": "True Quantum Computing Integration for TerraFusion OS - MIT PhD-Level Quantum Algorithms and Hybrid Computing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:quantum": "npm run test -- --testPathPattern=quantum",
    "benchmark": "node dist/benchmarks/quantum-performance.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "prepare": "npm run clean && npm run build",
    "quantum:simulate": "node dist/simulators/quantum-simulator.js",
    "quantum:benchmark": "node dist/benchmarks/quantum-vs-classical.js",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:security": "jest tests/security.test.js",
    "test:performance": "jest tests/performance.test.js",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:install": "cd mcp-server && npm install"
  },
  "keywords": [
    "quantum-computing",
    "quantum-algorithms",
    "hybrid-computing",
    "quantum-machine-learning",
    "quantum-cryptography",
    "quantum-optimization",
    "qiskit",
    "cirq",
    "terrafusion",
    "government-ai",
    "mit-phd-level"
  ],
  "author": "TerraFusion Quantum Research Team",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.15.0",
    "@tensorflow/tfjs-node-gpu": "^4.15.0",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "rxjs": "^7.8.1",
    "mathjs": "^12.2.0",
    "ml-matrix": "^6.10.7",
    "numeric": "^1.2.6",
    "complex.js": "^2.1.1",
    "fft-js": "^0.0.12",
    "node-fft": "^0.2.2",
    "gaussian": "^1.3.0",
    "probability-distributions": "^0.9.1",
    "stats-lite": "^2.2.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "axios": "^1.6.2",
    "ioredis": "^5.3.2",
    "bull": "^4.12.2",
    "p-queue": "^8.0.1",
    "eventemitter3": "^5.0.1",
    "node-cache": "^5.1.2",
    "cron": "^3.1.6",
    "chalk": "^4.1.2",
    "inquirer": "^9.2.12",
    "commander": "^11.1.0",
    "yargs": "^17.7.2",
    "dotenv": "^16.3.1",
    "config": "^3.3.9",
    "joi": "^17.11.0",
    "zod": "^3.22.4",
    "ws": "^8.14.2",
    "socket.io": "^4.7.4",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "rate-limiter-flexible": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/jest": "^29.5.8",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "@types/mathjs": "^9.4.2",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2",
    "rimraf": "^5.0.5",
    "nodemon": "^3.0.2",
    "benchmark": "^2.1.4",
    "@types/benchmark": "^2.1.5",
    "@jest/globals": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "supertest": "^6.0.0",
    "nyc": "^15.0.0"
  },
  "peerDependencies": {
    "qiskit": ">=0.45.0",
    "cirq": ">=1.3.0",
    "pennylane": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "qiskit": {
      "optional": true
    },
    "cirq": {
      "optional": true
    },
    "pennylane": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TerraFusion-AI/quantum-computing-integration.git"
  },
  "bugs": {
    "url": "https://github.com/TerraFusion-AI/quantum-computing-integration/issues"
  },
  "homepage": "https://terrafusion.ai/modules/quantum-computing",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.terrafusion.ai"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/explicit-function-return-type": "warn",
      "complexity": [
        "warn",
        15
      ],
      "max-lines": [
        "warn",
        500
      ]
    }
  },
  "funding": {
    "type": "government",
    "url": "https://terrafusion.ai/funding"
  },
  "quantum": {
    "simulators": {
      "default": "terrafusion-quantum-simulator",
      "backends": [
        "aer",
        "qasm",
        "statevector",
        "clifford"
      ],
      "maxQubits": 40,
      "maxCircuitDepth": 1000
    },
    "hardware": {
      "providers": [
        "ibm",
        "google",
        "rigetti",
        "ionq"
      ],
      "protocols": [
        "openqasm",
        "cirq",
        "quil",
        "braket"
      ],
      "connectivity": "cloud-hybrid"
    },
    "algorithms": {
      "optimization": [
        "qaoa",
        "vqe",
        "quantum-annealing"
      ],
      "ml": [
        "qml",
        "variational-classifiers",
        "quantum-kernels"
      ],
      "cryptography": [
        "shor",
        "grover",
        "quantum-key-distribution"
      ],
      "simulation": [
        "hamiltonian-simulation",
        "quantum-monte-carlo"
      ]
    }
  },
  "mcp": {
    "server": "./mcp-server",
    "tools": [
      "quantum-interface",
      "experimental-executor",
      "research-coordinator"
    ],
    "capabilities": [
      "api-server",
      "external-services",
      "real-time-communication"
    ]
  }
}
