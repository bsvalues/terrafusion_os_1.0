{
  "name": "@terrafusion/next-generation-security",
  "version": "1.0.0",
  "description": "Next-Generation Security Framework for TerraFusion OS - MIT PhD-Level Quantum-Resistant Cryptography and AI-Powered Threat Defense",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:security": "jest tests/security.test.js",
    "test:crypto": "npm run test -- --testPathPattern=crypto",
    "benchmark": "node dist/benchmarks/crypto-performance.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "prepare": "npm run clean && npm run build",
    "security:scan": "node dist/scanners/vulnerability-scanner.js",
    "crypto:test": "node dist/crypto/quantum-resistance-test.js",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:performance": "jest tests/performance.test.js",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:install": "cd mcp-server && npm install"
  },
  "keywords": [
    "next-generation-security",
    "quantum-resistant-cryptography",
    "post-quantum-crypto",
    "ai-threat-defense",
    "zero-trust-architecture",
    "homomorphic-encryption",
    "secure-multiparty-computation",
    "blockchain-security",
    "biometric-authentication",
    "behavioral-analytics",
    "terrafusion",
    "government-security",
    "mit-phd-level"
  ],
  "author": "TerraFusion Security Research Team",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.15.0",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "rxjs": "^7.8.1",
    "crypto": "^1.0.1",
    "node-forge": "^1.3.1",
    "elliptic": "^6.5.4",
    "tweetnacl": "^1.0.3",
    "bcrypt": "^5.1.1",
    "argon2": "^0.31.2",
    "scrypt": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-jwt": "^4.0.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.0",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.3",
    "otplib": "^12.0.1",
    "face-api.js": "^0.22.2",
    "node-nlp": "^4.27.0",
    "sentiment": "^5.0.2",
    "compromise": "^14.11.0",
    "mathjs": "^12.2.0",
    "ml-matrix": "^6.10.7",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "axios": "^1.6.2",
    "ioredis": "^5.3.2",
    "bull": "^4.12.2",
    "p-queue": "^8.0.1",
    "eventemitter3": "^5.0.1",
    "node-cache": "^5.1.2",
    "cron": "^3.1.6",
    "chalk": "^4.1.2",
    "inquirer": "^9.2.12",
    "commander": "^11.1.0",
    "yargs": "^17.7.2",
    "dotenv": "^16.3.1",
    "config": "^3.3.9",
    "joi": "^17.11.0",
    "zod": "^3.22.4",
    "ws": "^8.14.2",
    "socket.io": "^4.7.4",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "jimp": "^0.22.10"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/jest": "^29.5.8",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "@types/mathjs": "^9.4.2",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/passport-jwt": "^3.0.13",
    "@types/express-session": "^1.17.10",
    "@types/speakeasy": "^2.0.10",
    "@types/qrcode": "^1.5.5",
    "@types/multer": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2",
    "rimraf": "^5.0.5",
    "nodemon": "^3.0.2",
    "benchmark": "^2.1.4",
    "@types/benchmark": "^2.1.5",
    "@jest/globals": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "supertest": "^6.0.0",
    "nyc": "^15.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TerraFusion-AI/next-generation-security.git"
  },
  "bugs": {
    "url": "https://github.com/TerraFusion-AI/next-generation-security/issues"
  },
  "homepage": "https://terrafusion.ai/modules/next-gen-security",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.terrafusion.ai"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/explicit-function-return-type": "warn",
      "complexity": [
        "warn",
        15
      ],
      "max-lines": [
        "warn",
        600
      ]
    }
  },
  "funding": {
    "type": "government",
    "url": "https://terrafusion.ai/funding"
  },
  "security": {
    "cryptography": {
      "post_quantum": {
        "enabled": true,
        "algorithms": [
          "kyber",
          "dilithium",
          "falcon",
          "sphincs+"
        ],
        "key_sizes": [
          512,
          1024,
          2048,
          4096
        ]
      },
      "homomorphic": {
        "enabled": true,
        "schemes": [
          "bfv",
          "ckks",
          "bgv"
        ],
        "security_levels": [
          128,
          192,
          256
        ]
      },
      "threshold": {
        "enabled": true,
        "schemes": [
          "shamir",
          "blakley",
          "asmuth-bloom"
        ]
      }
    },
    "authentication": {
      "multi_factor": {
        "enabled": true,
        "factors": [
          "knowledge",
          "possession",
          "inherence",
          "location",
          "behavior"
        ]
      },
      "biometric": {
        "enabled": true,
        "modalities": [
          "fingerprint",
          "face",
          "iris",
          "voice",
          "gait",
          "keystroke"
        ]
      },
      "behavioral": {
        "enabled": true,
        "patterns": [
          "typing",
          "mouse",
          "navigation",
          "interaction"
        ]
      }
    },
    "threat_defense": {
      "ai_powered": {
        "enabled": true,
        "models": [
          "anomaly_detection",
          "behavioral_analysis",
          "pattern_recognition"
        ]
      },
      "zero_trust": {
        "enabled": true,
        "principles": [
          "verify_explicitly",
          "least_privilege",
          "assume_breach"
        ]
      },
      "adaptive": {
        "enabled": true,
        "responses": [
          "blocking",
          "throttling",
          "monitoring",
          "alerting"
        ]
      }
    }
  },
  "mcp": {
    "server": "./mcp-server",
    "tools": [
      "quantum-interface",
      "experimental-executor",
      "research-coordinator",
      "file-manager",
      "upload-handler"
    ],
    "capabilities": [
      "api-server",
      "file-processing",
      "external-services",
      "real-time-communication"
    ]
  }
}
