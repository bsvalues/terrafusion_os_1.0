{
  "name": "singularity-preparation-framework",
  "version": "1.0.0",
  "description": "🌠 Ultimate AI system for preparing and managing the transition to technological singularity",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:security": "jest tests/security.test.js",
    "test:performance": "jest tests/performance.test.js",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:install": "cd mcp-server && npm install"
  },
  "keywords": [
    "technological-singularity",
    "ai-superintelligence",
    "singularity-preparation",
    "intelligence-explosion",
    "post-human-intelligence",
    "artificial-general-intelligence",
    "singularity-management",
    "transcendent-ai",
    "evolutionary-singularity",
    "intelligence-amplification"
  ],
  "author": "TerraFusion OS Team",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs": "^4.15.0",
    "@tensorflow/tfjs-node": "^4.15.0",
    "axios": "^1.6.2",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "moment": "^2.29.4",
    "mathjs": "^12.2.0",
    "json-schema": "^0.4.0",
    "semver": "^7.5.4",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.12",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "nodemailer": "^6.9.7",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "brain.js": "^2.0.0-beta.22",
    "ml-matrix": "^6.10.7",
    "natural": "^6.7.0",
    "socket.io": "^4.7.4",
    "redis": "^4.6.10"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/jest": "^29.5.8",
    "@types/lodash": "^4.14.202",
    "@types/uuid": "^9.0.7",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.1",
    "jest": "^29.0.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "rimraf": "^5.0.5",
    "nodemon": "^3.0.2",
    "@jest/globals": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "supertest": "^6.0.0",
    "nyc": "^15.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/no-explicit-any": "warn",
      "prefer-const": "error",
      "no-var": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/singularity-preparation-framework.git"
  },
  "bugs": {
    "url": "https://github.com/terrafusion/singularity-preparation-framework/issues"
  },
  "homepage": "https://github.com/terrafusion/singularity-preparation-framework#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "mcp": {
    "server": "./mcp-server",
    "tools": [
      "quantum-interface",
      "experimental-executor",
      "research-coordinator",
      "ml-model-server",
      "prediction-interface"
    ],
    "capabilities": [
      "machine-learning-models",
      "external-services",
      "real-time-communication"
    ]
  }
}
