{
  "id": "ai-ml-pipeline",
  "metadata": {
    "name": "AI/ML Pipeline",
    "description": "Complete machine learning pipeline with Python, TensorFlow, and MLOps tools",
    "category": "Machine Learning",
    "tags": [
      "python",
      "tensorflow",
      "scikit-learn",
      "jupyter",
      "mlflow",
      "docker"
    ],
    "dependencies": {
      "python": ">=3.9.0",
      "pip": ">=21.0.0"
    },
    "requirements": ["Python 3.9+", "Docker (optional)", "CUDA GPU (optional)"],
    "author": "Terrafusion Team",
    "version": "1.0.0",
    "icon": "brain"
  },
  "variables": [
    {
      "name": "PROJECT_NAME",
      "description": "Name of your ML project",
      "default_value": "my-ml-pipeline",
      "required": true,
      "validation_pattern": "^[a-z][a-z0-9-_]*$"
    },
    {
      "name": "AUTHOR_NAME",
      "description": "Author name",
      "default_value": "Your Name",
      "required": true
    },
    {
      "name": "DESCRIPTION",
      "description": "Project description",
      "default_value": "An AI/ML pipeline for data processing and model training",
      "required": false
    },
    {
      "name": "ML_FRAMEWORK",
      "description": "Primary ML framework (tensorflow/pytorch/sklearn)",
      "default_value": "tensorflow",
      "required": true,
      "validation_pattern": "^(tensorflow|pytorch|sklearn)$"
    },
    {
      "name": "USE_GPU",
      "description": "Enable GPU support (true/false)",
      "default_value": "false",
      "required": false,
      "validation_pattern": "^(true|false)$"
    },
    {
      "name": "PYTHON_VERSION",
      "description": "Python version",
      "default_value": "3.11",
      "required": false,
      "validation_pattern": "^3\\.(9|10|11|12)$"
    }
  ],
  "file_mappings": {},
  "post_install_commands": [
    "python -m venv venv",
    "source venv/bin/activate && pip install -r requirements.txt",
    "echo 'AI/ML pipeline created successfully!'",
    "echo 'Activate virtual environment: source venv/bin/activate'",
    "echo 'Start Jupyter: jupyter lab'"
  ]
}
