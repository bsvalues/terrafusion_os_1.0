{
  "$schema": "https://tauri.app/v1/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:\${{TF_FRONTEND_3008_PORT:-3008}}",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "CostForge AI",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": false
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "startDragging": true
      },
      "dialog": {
        "all": false,
        "open": true,
        "save": true,
        "message": true,
        "ask": true,
        "confirm": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "copyFile": false,
        "createDir": true,
        "removeFile": false,
        "removeDir": false,
        "renameFile": false,
        "exists": true,
        "scope": [
          "$APPDATA/Terrafusion/08-costforge-ai/**",
          "$APPDATA/Terrafusion/shared/**"
        ]
      },
      "path": {
        "all": false,
        "resolve": true,
        "normalize": true,
        "join": true,
        "dirname": true,
        "basename": true,
        "isAbsolute": true
      },
      "http": {
        "all": false,
        "request": true,
        "scope": [
          "https://api.terrafusion.com/**",
          "https://costforge-api.terrafusion.com/**",
          "https://*.terrafusion.com/**"
        ]
      },
      "notification": {
        "all": false,
        "isPermissionGranted": true,
        "requestPermission": true,
        "notify": true
      }
    },
    "bundle": {
      "active": true,
      "category": "BusinessApp",
      "copyright": "© 2025 Terrafusion Team",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.terrafusion.08-costforge-ai",
      "longDescription": "CostForge AI - Advanced Construction Cost Management with AI-powered insights, property valuation, and quantum-enhanced analytics for the modern construction industry.",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "AI-powered construction cost management platform",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.terrafusion.com https://costforge-api.terrafusion.com https://*.terrafusion.com; img-src 'self' data: https:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;"
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "CostForge AI - The Future of Construction Cost Management",
        "width": 1400,
        "minWidth": 1200,
        "minHeight": 800,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Light"
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  }
}
