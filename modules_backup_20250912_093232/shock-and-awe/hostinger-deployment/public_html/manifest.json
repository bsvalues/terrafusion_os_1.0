{
  "name": "Terrafusion Market",
  "short_name": "Terrafusion",
  "description": "AI-powered government property assessment platform delivering 914x faster valuations",
  "version": "1.0.0",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#1a365d",
  "theme_color": "#1a365d",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en-US",
  "categories": ["business", "government", "productivity"],
  "screenshots": [
