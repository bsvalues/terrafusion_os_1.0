  "infrastructure": {
    "minRequirements": {
      "cpu": "64 cores",
      "memory": "128GB",
      "disk": "500GB",
      "network": "10Gbps"
    },
    "recommendedRequirements": {
      "cpu": "128 cores",
      "memory": "256GB",
      "disk": "1TB SSD",
      "network": "25Gbps"
    },
    "scalability": {
      "autoScaling": true,
      "minInstances": 2,
      "maxInstances": 10,
      "scaleUpThreshold": 80,
      "scaleDownThreshold": 30
    }
  },
  "monitoring": {
    "enabled": true,
    "metricsCollection": {
      "interval": 15,
      "retention": "30d"
    },
    "healthChecks": {
      "enabled": true,
      "interval": 30,
      "timeout": 10,
      "retries": 3
    },
    "alerting": {
      "enabled": true,
      "channels": ["email", "slack", "webhook"],
      "thresholds": {
        "errorRate": 5,
        "responseTime": 2000,
        "cpuUsage": 80,
        "memoryUsage": 85,
        "diskUsage": 90
      }
    }
  },
  "security": {
    "tls": {
      "enabled": true,
      "minVersion": "1.2",
      "cipherSuites": ["TLS_AES_256_GCM_SHA384", "TLS_CHACHA20_POLY1305_SHA256"]
    },
    "authentication": {
      "required": true,
      "methods": ["oauth2", "saml", "ldap"]
    },
    "authorization": {
      "rbac": true,
      "policies": "strict"
    },
    "compliance": {
      "standards": ["SOC2", "FISMA", "FedRAMP"],
      "auditLogging": true,
      "dataEncryption": true
    }
  },
  "backup": {
    "enabled": true,
    "schedule": "0 2 * * *",
    "retention": "90d",
    "encryption": true,
    "offsite": true
  },
  "rollback": {
    "enabled": true,
    "maxAttempts": 3,
    "timeout": 600,
    "verification": {
      "healthChecks": true,
      "smokeTests": true,
      "dataIntegrity": true
    }
  },
  "notifications": {
    "deployment": {
      "start": true,
      "success": true,
      "failure": true,
      "rollback": true
    },
    "channels": {
      "email": {
        "enabled": true,
        "recipients": ["deployment-team@terrafusion.gov"]
      },
      "slack": {
        "enabled": true,
        "webhook": "https://hooks.slack.com/services/deployment-alerts"
      },
      "webhook": {
        "enabled": true,
        "url": "https://monitoring.terrafusion.gov/webhooks/deployment"
      }
    }
  }
