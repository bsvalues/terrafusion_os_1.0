{
  "name": "@terrafusion/emergent-intelligence-evolution",
  "version": "1.0.0",
  "description": "Emergent Intelligence Evolution Engine for TerraFusion OS - MIT PhD-Level Self-Evolving AI Architecture",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:evolution": "npm run test -- --testPathPattern=evolution",
    "benchmark": "node dist/benchmarks/intelligence-metrics.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist",
    "prepare": "npm run clean && npm run build",
    "evolve": "node dist/evolution/autonomous-evolution.js",
    "intelligence:measure": "node dist/metrics/intelligence-assessment.js",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:security": "jest tests/security.test.js",
    "test:performance": "jest tests/performance.test.js",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:install": "cd mcp-server && npm install"
  },
  "keywords": [
    "emergent-intelligence",
    "autonomous-evolution",
    "self-improving-ai",
    "cognitive-architecture",
    "consciousness-simulation",
    "meta-learning",
    "artificial-general-intelligence",
    "neural-architecture-search",
    "genetic-programming",
    "terrafusion",
    "government-ai",
    "mit-phd-level"
  ],
  "author": "TerraFusion Cognitive Research Team",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.15.0",
    "@tensorflow/tfjs-node-gpu": "^4.15.0",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "rxjs": "^7.8.1",
    "mathjs": "^12.2.0",
    "ml-matrix": "^6.10.7",
    "numeric": "^1.2.6",
    "brain.js": "^2.0.0-beta.23",
    "synaptic": "^1.1.4",
    "neuroevolution": "^0.4.0",
    "genetic-js": "^0.1.4",
    "neat-js": "^1.0.8",
    "natural": "^6.12.0",
    "compromise": "^14.11.0",
    "sentiment": "^5.0.2",
    "node-nlp": "^4.27.0",
    "opencog-js": "^0.1.0",
    "reinforcement-learning": "^0.3.0",
    "deeplearning4j": "^1.0.0-M2.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "axios": "^1.6.2",
    "ioredis": "^5.3.2",
    "bull": "^4.12.2",
    "p-queue": "^8.0.1",
    "eventemitter3": "^5.0.1",
    "node-cache": "^5.1.2",
    "cron": "^3.1.6",
    "chalk": "^4.1.2",
    "inquirer": "^9.2.12",
    "commander": "^11.1.0",
    "yargs": "^17.7.2",
    "dotenv": "^16.3.1",
    "config": "^3.3.9",
    "joi": "^17.11.0",
    "zod": "^3.22.4",
    "ws": "^8.14.2",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/jest": "^29.5.8",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/ws": "^8.5.10",
    "@types/mathjs": "^9.4.2",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2",
    "rimraf": "^5.0.5",
    "nodemon": "^3.0.2",
    "benchmark": "^2.1.4",
    "@types/benchmark": "^2.1.5",
    "@jest/globals": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "supertest": "^6.0.0",
    "nyc": "^15.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TerraFusion-AI/emergent-intelligence-evolution.git"
  },
  "bugs": {
    "url": "https://github.com/TerraFusion-AI/emergent-intelligence-evolution/issues"
  },
  "homepage": "https://terrafusion.ai/modules/emergent-intelligence",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.terrafusion.ai"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/explicit-function-return-type": "warn",
      "complexity": [
        "warn",
        20
      ],
      "max-lines": [
        "warn",
        800
      ]
    }
  },
  "funding": {
    "type": "government",
    "url": "https://terrafusion.ai/funding"
  },
  "intelligence": {
    "architecture": {
      "type": "hybrid-cognitive",
      "components": [
        "reasoning",
        "learning",
        "memory",
        "perception",
        "emotion"
      ],
      "consciousness_simulation": true,
      "self_modification": true
    },
    "evolution": {
      "algorithms": [
        "genetic-programming",
        "neuroevolution",
        "architecture-search"
      ],
      "fitness_functions": [
        "performance",
        "creativity",
        "adaptability",
        "efficiency"
      ],
      "mutation_rate": 0.01,
      "crossover_rate": 0.7,
      "selection_pressure": 0.8
    },
    "learning": {
      "paradigms": [
        "supervised",
        "unsupervised",
        "reinforcement",
        "meta-learning"
      ],
      "transfer_learning": true,
      "continual_learning": true,
      "few_shot_learning": true,
      "zero_shot_learning": true
    },
    "metrics": {
      "iq_equivalent": true,
      "creativity_index": true,
      "adaptability_score": true,
      "consciousness_level": true,
      "emotional_intelligence": true
    }
  },
  "mcp": {
    "server": "./mcp-server",
    "tools": [
      "ai-model-executor",
      "consciousness-interface",
      "swarm-coordinator"
    ],
    "capabilities": [
      "external-services",
      "real-time-communication"
    ]
  }
}
