{
  "dashboard": {
    "title": "Terrafusion OS - Production Monitoring",
    "tags": ["terrafusion", "production", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "AI Swarm Status",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "terrafusion_swarm_agents_total",
            "legendFormat": "Total Agents"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 500, "color": "yellow" },
                { "value": 1008, "color": "green" }
              ]
            },
            "unit": "none",
            "decimals": 0
          }
        }
      },
      {
        "id": 2,
        "title": "Valuations Per Second",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
        "targets": [
          {
            "expr": "rate(terrafusion_valuations_total[5m])",
            "legendFormat": "Valuations/sec"
          }
        ],
        "yaxes": [
          {
            "format": "ops",
            "label": "Valuations/sec",
            "show": true
          }
        ],
        "lines": true,
        "fill": 2,
        "linewidth": 2,
        "aliasColors": {
          "Valuations/sec": "#00d2ff"
        }
      },
      {
        "id": 3,
        "title": "System Health",
        "type": "gauge",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "targets": [
          {
            "expr": "terrafusion_system_health_percentage",
            "legendFormat": "Health"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 50, "color": "orange" },
                { "value": 80, "color": "yellow" },
                { "value": 95, "color": "green" }
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 4,
        "title": "Properties Processed",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "terrafusion_properties_processed_total",
            "legendFormat": "Properties"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "decimals": 0,
            "thresholds": {
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 50000, "color": "yellow" },
                { "value": 94149, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Response Time Distribution",
        "type": "heatmap",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(terrafusion_response_time_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "dataFormat": "timeseries",
        "cards": {
          "cardPadding": 2,
          "cardRound": 2
        },
        "color": {
          "mode": "spectrum",
          "scheme": "interpolateBlues"
        },
        "yAxis": {
          "format": "ms",
          "decimals": 0
        }
      },
      {
        "id": 6,
        "title": "Module Performance",
        "type": "table",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "topk(14, terrafusion_module_requests_total) by (module)",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "module": "Module",
                "Value": "Requests"
              }
            }
          }
        ]
      },
      {
        "id": 7,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "rate(terrafusion_errors_total[5m])",
            "legendFormat": "{{error_type}}"
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [0.01],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "60s",
          "handler": 1,
          "name": "High Error Rate",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 8,
        "title": "CPU Usage by Component",
        "type": "piechart",
        "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
        "targets": [
          {
            "expr": "terrafusion_cpu_usage_percent",
            "legendFormat": "{{component}}"
          }
        ],
        "pieType": "donut",
        "legendDisplayMode": "table",
        "legendPlacement": "right"
      },
      {
        "id": 9,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
        "targets": [
          {
            "expr": "terrafusion_memory_usage_bytes / 1024 / 1024 / 1024",
            "legendFormat": "{{component}}"
          }
        ],
        "yaxes": [
          {
            "format": "GB",
            "label": "Memory",
            "show": true
          }
        ]
      },
      {
        "id": 10,
        "title": "AI Agent Activity",
        "type": "graph",
        "gridPos": { "h": 6, "w": 24, "x": 0, "y": 22 },
        "targets": [
          {
            "expr": "terrafusion_agent_active_count",
            "legendFormat": "Active Agents"
          },
          {
            "expr": "terrafusion_agent_idle_count",
            "legendFormat": "Idle Agents"
          },
          {
            "expr": "terrafusion_agent_processing_count",
            "legendFormat": "Processing"
          }
        ],
        "stack": true,
        "lines": true,
        "fill": 3
      }
    ],
    "refresh": "5s",
    "schemaVersion": 16,
    "style": "dark",
    "templating": {
      "list": [
        {
          "name": "county",
          "type": "query",
          "query": "label_values(terrafusion_properties_processed_total, county)",
          "current": {
            "text": "Benton",
            "value": "benton"
          }
        },
        {
          "name": "environment",
          "type": "custom",
          "options": [
            { "text": "Production", "value": "production" },
            { "text": "Staging", "value": "staging" },
            { "text": "Development", "value": "development" }
          ],
          "current": {
            "text": "Production",
            "value": "production"
          }
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "terrafusion_deployment_info",
          "name": "Deployments",
          "tagKeys": "version,county",
          "titleFormat": "Deployment"
        }
      ]
    }
  }
}
