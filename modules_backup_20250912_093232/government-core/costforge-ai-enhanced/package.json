{
  "name": "@terrafusion/costforge-ai-enhanced",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "MIT PhD Enhanced CostForge AI - Building Cost Building System (BCBS) with Consciousness Processing",
  "originalSystem": "TerraBuild/TerraFusionBuild",
  "scripts": {
    "dev": "vite dev --port ${TF_FRONTEND_3008_PORT:-3008}",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:fast": "vite build --mode production",
    "build:analyze": "vite build --mode production && npx vite-bundle-analyzer dist",
    "dev:fast": "vite dev --host --clearScreen false",
    "preview:fast": "vite preview --host",
    "mcp:start": "cd mcp-server && python index.py",
    "mcp:dev": "cd mcp-server && python index.py --dev",
    "consciousness:check": "cd mcp-server && python -c \"from index import costforge_ai; print(f'CostForge AI Consciousness Level: {costforge_ai.consciousness_metrics.get_enhancement_score():.3f}')\"",
    "terrabuild:migrate": "echo 'Original TerraBuild/TerraFusionBuild system integrated with MIT PhD consciousness processing'",
    "test:consciousness": "cd mcp-server && python -m pytest tests/ -v"
  },
