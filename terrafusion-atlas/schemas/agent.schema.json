{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerraFusion AI Agent",
  "description": "AI agent, swarm member, or autonomous system",
  "type": "object",
  "required": ["id", "name", "owner", "lifecycle", "source_path", "agent_type"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^agent\\.[a-z0-9.-]+$"
    },
    "name": {"type": "string"},
    "description": {"type": "string"},
    "owner": {"type": "string"},
    "lifecycle": {
      "type": "string",
      "enum": ["active", "deprecated", "experimental", "archived"]
    },
    "source_path": {"type": "string"},
    "agent_type": {
      "type": "string",
      "enum": ["autonomous", "supervised", "swarm-member", "coordinator", "specialist"]
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Agent capabilities (e.g., valuation, analysis, coordination)"
    },
    "swarm": {
      "type": "string",
      "description": "Swarm ID if part of a swarm"
    },
    "model_info": {
      "type": "object",
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "version": {"type": "string"}
      }
    }
  }
}
