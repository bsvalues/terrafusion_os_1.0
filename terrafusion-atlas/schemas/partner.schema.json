{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerraFusion Partner",
  "description": "Partner integration, vendor SDK, or partnership asset",
  "type": "object",
  "required": ["id", "name", "owner", "source_path"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "owner": {"type": "string"},
    "source_path": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "partner_name": {"type": "string"},
    "integration_type": {"type": "string", "enum": ["sdk", "api", "data-feed", "white-label"]},
    "contract_expires": {"type": "string", "format": "date"}
  }
}
