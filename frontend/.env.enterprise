# TerraFusion Frontend - Enterprise Environment Configuration
# Service Mesh + Trust Fabric + Circuit Breaker Architecture

# ===== PRODUCTION CONFIGURATION =====
# Use these settings for production deployment

# Service Discovery (Consul)
CONSUL_HOST=consul.terrafusion.internal
CONSUL_PORT=8500
CONSUL_SECURE=true

# Trust Fabric
VITE_TRUST_FABRIC_URL=wss://trust-fabric.terrafusion.internal/fabric

# Backend Services (discovered dynamically, these are fallbacks)
VITE_API_URL=https://api.terrafusion.internal
VITE_API_PORT=443

# ===== DEVELOPMENT CONFIGURATION =====
# Override with .env.local for local development

# Service Discovery (Local Consul)
# CONSUL_HOST=localhost
# CONSUL_PORT=8500
# CONSUL_SECURE=false

# Trust Fabric (Local)
# VITE_TRUST_FABRIC_URL=ws://localhost:8080/fabric

# Backend Services (Local development)
# VITE_API_URL=http://localhost:5000
# VITE_API_PORT=5000

# ===== CIRCUIT BREAKER CONFIGURATION =====
VITE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
VITE_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60000
VITE_CIRCUIT_BREAKER_MONITORING_PERIOD=120000
VITE_CIRCUIT_BREAKER_EXPECTED_ERROR_RATE=0.1

# ===== SECURITY CONFIGURATION =====
VITE_ATTESTATION_REQUIRED=true
VITE_DID_CACHE_TTL=3600000
VITE_RESPONSE_CACHE_TTL=300000

# ===== OBSERVABILITY =====
VITE_TELEMETRY_ENABLED=true
VITE_HEALTH_CHECK_INTERVAL=30000
VITE_METRICS_COLLECTION=true

# ===== FEATURE FLAGS =====
VITE_SERVICE_MESH_ENABLED=true
VITE_TRUST_FABRIC_ENABLED=true
VITE_CIRCUIT_BREAKER_ENABLED=true
VITE_FALLBACK_MODE=false
