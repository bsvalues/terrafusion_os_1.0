# TERRAFUSION OS - DEPLOYMENT CONFIGURATION
# ----------------------------------------

# [Identity]
# The active sovereign domain (e.g., 'benton-wa', 'franklin-wa')
VITE_SOVEREIGN_DOMAIN=benton-wa

# [Features]
# Toggle the Costforge AI Simulation Engine
VITE_ENABLE_SIMULATION_ENGINE=true

# Enable the Axiom File System Lattice
VITE_ENABLE_AXIOM_FS=true

# Enable Sovereign Dashboard
VITE_ENABLE_DASHBOARD=true

# [Data]
# Use baked-in "Golden Parcel" data for demonstration
VITE_USE_MOCK_DATA=true

# Dev Preview Auth Bypass
# - Use this when running local preview flows where backend auth isn't configured
# - In conjunction with VITE_USE_MOCK_DATA=true, this prevents 401-driven redirect loops to /login
VITE_DEV_PREVIEW_BYPASS_AUTH=true

# Suggested defaults for dev-preview (use /api to leverage Vite proxy)
VITE_API_URL=/api

# [Performance]
# Force reduced motion for low-end hardware
VITE_ENABLE_REDUCED_MOTION=false

# [Debug]
# Show debug overlays
VITE_ENABLE_DEBUG_OVERLAYS=false
