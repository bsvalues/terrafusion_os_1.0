# TerraFusion OS 1.0 — Frontend Environment Variables
# Copy to .env.development.local for local overrides.

# API endpoint (proxied via vite.config.ts in development)
VITE_API_URL=http://localhost:5000

# Consciousness service WebSocket URL
VITE_CONSCIOUSNESS_URL=http://localhost:3004

# County sovereign domain (for multi-county deployments)
VITE_SOVEREIGN_DOMAIN=localhost

# Accessibility: force reduced motion for all animations
VITE_FORCE_REDUCE_MOTION=false
