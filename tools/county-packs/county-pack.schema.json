{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://terrafusion.os/schemas/county-pack-config.json",
  "title": "TerraFusion County Pack Configuration",
  "description": "JSON Schema for county.json files in TerraFusion County Packs",
  "type": "object",
  "required": ["countyName", "fipsCode", "state", "timezone", "features"],
  "properties": {
    "countyName": {
      "type": "string",
      "description": "Official county name",
      "minLength": 1,
      "examples": ["Benton County", "King County"]
    },
    "fipsCode": {
      "type": "string",
      "description": "5-digit FIPS code (format: SSCCC where SS=state, CCC=county)",
      "pattern": "^\\d{5}$",
      "examples": ["53005", "53033"]
    },
    "state": {
      "type": "string",
      "description": "Two-letter state code",
      "enum": ["WA"],
      "examples": ["WA"]
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone identifier",
      "examples": ["America/Los_Angeles", "America/Chicago"]
    },
    "population": {
      "type": "integer",
      "description": "County population (for capacity planning)",
      "minimum": 0
    },
    "features": {
      "type": "array",
      "description": "Enabled TerraFusion features",
      "items": {
        "type": "string",
        "enum": [
          "property-assessment",
          "tax-calculation",
          "harris-pacs-integration",
          "gis-visualization",
          "citizen-portal",
          "payment-processing",
          "document-management",
          "mobile-app",
          "ai-swarm"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "integrations": {
      "type": "object",
      "description": "External system integration metadata",
      "properties": {
        "erpSystem": {
          "type": "string",
          "description": "Enterprise Resource Planning system",
          "examples": ["Tyler Technologies Vision", "SAP"]
        },
        "gisProvider": {
          "type": "string",
          "description": "GIS mapping provider",
          "examples": ["Esri ArcGIS Enterprise", "MapBox"]
        },
        "pacsVersion": {
          "type": "string",
          "description": "Property Assessment Computer System version",
          "examples": ["Harris PACS 9.0", "Harris PACS 10.0"]
        },
        "paymentGateway": {
          "type": "string",
          "description": "Payment processing gateway",
          "examples": ["Stripe", "PayPal", "Authorize.Net"]
        }
      }
    },
    "customFields": {
      "type": "object",
      "description": "County-specific metadata (free-form)",
      "additionalProperties": true
    },
    "deployment": {
      "type": "object",
      "description": "Deployment configuration metadata",
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        },
        "parcelCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of property parcels in county"
        },
        "syncFrequency": {
          "type": "string",
          "pattern": "^\\d+[hmd]$",
          "description": "Data sync frequency (e.g., 4h, 30m, 1d)",
          "examples": ["4h", "30m", "1d"]
        },
        "backupRetention": {
          "type": "string",
          "pattern": "^\\d+[dmy]$",
          "description": "Backup retention period (e.g., 90d, 6m, 1y)",
          "examples": ["90d", "6m", "1y"]
        },
        "highAvailability": {
          "type": "boolean",
          "description": "Enable high availability configuration"
        }
      }
    }
  },
  "additionalProperties": false
}
