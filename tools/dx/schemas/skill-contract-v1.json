{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://terrafusion.dev/schemas/skill-contract-v1.json",
  "title": "TerraFusion Skill Contract",
  "description": "Contract definition for a governed DX Spine skill",
  "type": "object",
  "required": ["skill", "version", "description", "ownerLane", "riskLevel"],
  "properties": {
    "$schema": { "type": "string" },
    "skill": { "type": "string", "pattern": "^tf-[a-z0-9-]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "ownerLane": { "type": "string", "enum": ["dev", "governance", "ops", "security", "data"] },
    "riskLevel": { "type": "string", "enum": ["read", "write-safe", "write-local", "write-remote", "write-production", "destructive"] },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of capability identifiers this skill provides"
    },
    "inputSchema": {
      "type": "object",
      "description": "JSON Schema for skill inputs"
    },
    "outputSchema": {
      "type": "object",
      "description": "JSON Schema for skill outputs"
    }
  }
}
