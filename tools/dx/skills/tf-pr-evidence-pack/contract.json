      "branch": "feature/phase-7-evidence-pack",
      "pr": 315,
      "artifacts": {
        "testResults": {
          "total": 716,
          "passed": 658,
          "failed": 0,
          "skipped": 58,
          "passRate": 91.9
        },
        "coverage": {
          "line": 97.2,
          "branch": 94.1,
          "function": 98.5,
          "statement": 97.0,
          "meetsThreshold": true
        },
        "lint": {
          "errors": 0,
          "warnings": 3,
          "clean": true
        },
        "compliance": {
          "fismaHigh": true,
          "nist80053": true,
          "violations": 0,
          "controlsCovered": 247,
          "controlsTotal": 247
        },
        "accessibility": {
          "wcag21AA": true,
          "section508": true,
          "violations": 0,
          "warnings": 2
        },
        "security": {
          "vulnerabilities": {
            "critical": 0,
            "high": 0,
            "medium": 0,
            "low": 1
          },
          "dependencyAudit": true,
          "sastClean": true
        },
        "contractDrift": {
          "totalContracts": 9,
          "driftedContracts": 0,
          "zeroDrift": true
        }
      },
      "summary": {
        "totalChecks": 7,
        "passed": 7,
        "failed": 0,
        "verdict": "pass"
      }
    },
    "receipt": {
      "version": "1.0",
      "cid": "bafybeig-example-cid-placeholder",
      "generatedAt": "2026-02-13T12:00:00Z",
      "generator": "tdc",
      "integrityHash": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "verdict": "pass"
    }
  }
}
