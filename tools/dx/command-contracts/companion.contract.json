{
  "$schema": "../context-pack/contract-schema.json",
  "command": "companion",
  "description": "AI Workspace Companion with 15 specialized capabilities for TerraFusion development",
  "aliases": {
    "vscode": "TerraFusion: Companion",
    "claude": "/companion",
    "codex": "codex companion",
    "tdc": "tdc companion"
  },
  "riskLevel": "read",
  "ownerLane": "dev",
  "requiresConfirmation": false,
  "auditRequired": false,
  "emitsContextPack": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["status", "health", "capabilities", "generate", "review", "test", "refactor", "solve", "architect", "compliance", "context", "watch", "sync"],
        "default": "status",
        "description": "Action to perform"
      },
      "target": {
        "type": "string",
        "description": "Target file, description, or query for the action"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["status", "companion"],
    "properties": {
      "status": {
        "type": "string",
        "enum": ["success", "error", "pending"]
      },
      "companion": {
        "type": "object",
        "required": ["status", "capabilities", "sessionDuration"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["active", "inactive", "error"]
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "total": { "type": "integer" },
              "active": { "type": "integer" },
              "aiPowered": { "type": "integer" }
            }
          },
          "sessionDuration": {
            "type": "string",
            "description": "Human-readable session duration"
          },
          "lastAction": {
            "type": "string"
          }
        }
      },
      "health": {
        "type": "object",
        "properties": {
          "overall": { "type": "string", "enum": ["excellent", "good", "warning", "critical"] },
          "services": { "type": "object" }
        }
      },
      "result": {
        "type": "object",
        "description": "Action-specific result data"
      }
    }
  },
  "goldenSnapshot": {
    "input": { "action": "status" },
    "output": {
      "status": "success",
      "companion": {
        "status": "active",
        "capabilities": {
          "total": 15,
          "active": 15,
          "aiPowered": 7
        },
