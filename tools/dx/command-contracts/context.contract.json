{
  "$schema": "../context-pack/contract-schema.json",
  "command": "context",
  "description": "Context Pack operations for AI-assisted development",
  "aliases": {
    "vscode": "TerraFusion: Context",
    "claude": "/context",
    "codex": "codex context",
    "tdc": "tdc context"
  },
  "riskLevel": "read",
  "ownerLane": "dev",
  "requiresConfirmation": false,
  "auditRequired": false,
  "emitsContextPack": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["view", "regenerate", "validate", "list"],
        "default": "view",
        "description": "Context Pack operation"
      },
      "scope": {
        "type": "string",
        "enum": ["backend", "frontend", "os-platform", "all"],
        "default": "all",
        "description": "Scope of context generation"
      },
      "format": {
        "type": "string",
        "enum": ["json", "markdown", "xml"],
        "default": "json",
        "description": "Output format"
      },
      "includeTests": {
        "type": "boolean",
        "default": true,
        "description": "Include test context"
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["status", "contextPacks", "metadata"],
    "properties": {
      "status": {
        "type": "string",
        "enum": ["success", "partial", "error"]
      },
      "contextPacks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "path", "size", "lastUpdated"],
          "properties": {
            "name": { "type": "string" },
            "path": { "type": "string" },
            "size": { "type": "integer" },
            "lastUpdated": { "type": "string", "format": "date-time" },
            "status": { "type": "string", "enum": ["valid", "stale", "invalid"] },
            "scope": { "type": "string" },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "lineCount": { "type": "integer" }
                }
              }
            }
          }
        }
      },
      "metadata": {
        "type": "object",
        "properties": {
          "totalPacks": { "type": "integer" },
          "totalSize": { "type": "integer" },
          "valid": { "type": "integer" },
          "stale": { "type": "integer" },
          "invalid": { "type": "integer" }
        }
      }
    }
  },
  "goldenSnapshot": {
    "status": "success",
    "contextPacks": [
      {
