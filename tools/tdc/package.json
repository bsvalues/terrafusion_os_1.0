{
  "name": "@terrafusion/tdc",
  "version": "1.0.0",
  "private": true,
  "description": "TerraFusion Developer Console - Workspace orchestration system",
  "workspaces": [
    "cli",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "clean": "npm run clean --workspaces",
    "tdc": "node cli/dist/index.js",
    "dev:cli": "npm run dev --workspace=@terrafusion/tdc-cli",
    "dev:engine": "npm run dev --workspace=@terrafusion/transparency-engine"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "axios": "^1.5.0",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jest": "^29.5.0",
    "@types/inquirer": "^9.0.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.0",
    "ts-jest": "^29.1.0",
    "tsx": "^3.12.0",
    "typescript": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "terrafusion",
    "government",
    "os",
    "cli",
    "developer-console"
  ],
  "license": "MIT"
}
