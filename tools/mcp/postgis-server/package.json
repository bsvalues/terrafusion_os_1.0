{
  "name": "@terrafusion/mcp-postgis-server",
  "version": "1.0.0",
  "description": "MCP server exposing PostGIS spatial queries to Claude",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "mcp",
    "postgis",
    "spatial",
    "terrafusion",
    "model-context-protocol"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:queries": "tsx tests/validate-queries.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "pg": "^8.11.3",
    "dotenv": "^16.4.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/pg": "^8.10.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "author": "TerraFusion OS Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsvalues/terrafusion_os_1.0.git",
    "directory": "tools/mcp/postgis-server"
  }
}
