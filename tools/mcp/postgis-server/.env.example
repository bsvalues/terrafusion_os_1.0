# TerraFusion MCP PostGIS Server - Environment Configuration
# Copy this file to .env and configure for your environment

# ============================================================================
# PostgreSQL Connection
# ============================================================================

# PostgreSQL host (use 'localhost' for local dev, service name for Docker)
POSTGRES_HOST=localhost

# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# Database name (TerraFusion production database)
POSTGRES_DB=terrafusion

# PostgreSQL user (should have SELECT permissions on Properties table)
POSTGRES_USER=terrafusion_user

# PostgreSQL password (REQUIRED - never commit actual password)
POSTGRES_PASSWORD=

# Connection pool settings
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20

# Query timeout in milliseconds (default: 30000 = 30 seconds)
QUERY_TIMEOUT_MS=30000

# ============================================================================
# MCP Server Configuration
# ============================================================================

# MCP server port (default: 8080)
MCP_SERVER_PORT=8080

# Server mode: 'stdio' for Claude Desktop, 'http' for API access
MCP_SERVER_MODE=http

# Enable CORS for browser access (true/false)
ENABLE_CORS=true

# Allowed origins for CORS (comma-separated, use * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Log directory (relative to server root)
LOG_DIR=logs

# Enable query logging (logs all SQL queries with execution time)
LOG_QUERIES=true

# Slow query threshold in milliseconds (logs queries exceeding this time)
SLOW_QUERY_THRESHOLD_MS=1000

# ============================================================================
# Security & County Isolation
# ============================================================================

# Allowed county IDs (comma-separated, empty for all)
# Example: ALLOWED_COUNTY_IDS=1,2,3 (only allows Benton, Franklin, Walla Walla)
# Leave empty to allow all counties
ALLOWED_COUNTY_IDS=

# Require API key for requests (true/false)
REQUIRE_API_KEY=false

# API key for authentication (when REQUIRE_API_KEY=true)
API_KEY=

# Maximum results per query (prevents excessive data transfer)
MAX_QUERY_RESULTS=1000

# ============================================================================
# PostGIS Configuration
# ============================================================================

# SRID for spatial operations (4326 = WGS84 lat/lng)
DEFAULT_SRID=4326

# Default geometry simplification tolerance in meters
DEFAULT_SIMPLIFY_TOLERANCE=1.0

# Enable spatial index hints (true/false)
USE_SPATIAL_INDEX_HINTS=true

# ============================================================================
# Performance & Monitoring
# ============================================================================

# Enable performance monitoring (tracks query execution times)
ENABLE_PERFORMANCE_MONITORING=true

# Performance metrics retention in days
METRICS_RETENTION_DAYS=7

# Health check interval in seconds
HEALTH_CHECK_INTERVAL_SECONDS=30

# ============================================================================
# Development & Testing
# ============================================================================

# Enable test mode (uses mock data, disables real DB connections)
TEST_MODE=false

# Mock data file path (when TEST_MODE=true)
MOCK_DATA_PATH=tests/fixtures/mock-parcels.json

# Enable debug SQL output (prints SQL queries to console)
DEBUG_SQL=false

# Enable stack traces in error responses
ENABLE_STACK_TRACES=false

# ============================================================================
# Docker/Kubernetes Deployment
# ============================================================================

# Node environment (development | production | test)
NODE_ENV=development

# Graceful shutdown timeout in milliseconds
SHUTDOWN_TIMEOUT_MS=10000

# Enable clustering (use multiple CPU cores)
ENABLE_CLUSTERING=false

# Number of worker processes (0 = auto-detect based on CPU cores)
WORKER_COUNT=0

# ============================================================================
# Feature Flags
# ============================================================================

# Enable experimental features (may have breaking changes)
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable query caching (caches frequent queries in Redis)
ENABLE_QUERY_CACHE=false

# Redis connection string (when ENABLE_QUERY_CACHE=true)
REDIS_URL=redis://localhost:6379

# Query cache TTL in seconds
QUERY_CACHE_TTL=300
