{
  "name": "terrafusion-workspace-companion",
  "version": "1.0.0",
  "description": "AI Workspace Companion Agent for Terrafusion OS 1.0",
  "main": "launch-companion.ts",
  "scripts": {
    "companion": "ts-node launch-companion.ts",
    "companion:dev": "ts-node launch-companion.ts --dev",
    "companion:quiet": "ts-node launch-companion.ts --quiet",
    "companion:status": "ts-node launch-companion.ts --status",
    "companion:help": "ts-node launch-companion.ts --help",
    "build": "tsc",
    "dev": "ts-node --watch launch-companion.ts",
    "test": "jest",
    "test:boundaries": "jest tests/write-boundary.test.ts --verbose",
    "test:boundaries:coverage": "jest tests/write-boundary.test.ts --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "start": "npm run companion"
  },
  "keywords": [
    "terrafusion",
    "ai",
    "workspace",
    "companion",
    "agent",
    "government",
    "operating-system"
  ],
  "author": "Terrafusion Development Team",
  "license": "Proprietary",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@types/node": "^20.14.0",
    "openai": "^4.52.7",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.6.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "files": [
    "*.ts",
    "*.js",
    "*.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bsvalues/terrafusion_os_1.0.git",
    "directory": "ai-workspace-companion"
  },
  "bugs": {
    "url": "https://github.com/bsvalues/terrafusion_os_1.0/issues"
  },
  "homepage": "https://github.com/bsvalues/terrafusion_os_1.0#readme"
}
