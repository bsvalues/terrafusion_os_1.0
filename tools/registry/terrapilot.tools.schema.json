{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "terrapilot.tools.schema.json",
  "title": "TerraPilot Tool Registry Schema",
  "description": "Schema for TerraPilot tool manifest - Gate 4 write-lane enforcement",
  "type": "object",
  "required": ["version", "tools"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": { "type": "string" },
    "lastUpdated": {
      "type": "string",
      "format": "date"
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/definitions/Tool" }
    }
  },
  "definitions": {
    "Suite": {
      "type": "string",
      "enum": ["forge", "atlas", "dais", "dossier", "os", "pilot", "gpt"]
    },
    "Risk": {
      "type": "string",
      "enum": ["read_only", "write_low", "write_high", "irreversible"]
    },
    "TouchTarget": {
      "type": "string",
      "enum": [
        "parcel",
        "dossier",
        "workflow",
        "notice",
        "trace",
        "model",
        "map"
      ]
    },
    "Mode": {
      "type": "string",
      "enum": ["pilot", "muse"]
    },
    "CommandIntent": {
      "type": "string",
      "enum": ["inspect", "explain", "plan", "simulate", "mutate", "execute"]
    },
    "MutationClass": {
      "type": "string",
      "enum": ["none", "transient", "durable"]
    },
    "VisibilityClass": {
      "type": "string",
      "enum": ["public", "restricted", "secret"]
    },
    "CommandGovernanceMeta": {
      "type": "object",
      "required": ["intent", "mutation", "visibility"],
      "additionalProperties": false,
      "properties": {
        "intent": { "$ref": "#/definitions/CommandIntent" },
        "mutation": { "$ref": "#/definitions/MutationClass" },
        "visibility": { "$ref": "#/definitions/VisibilityClass" }
      }
    },
    "Tool": {
      "type": "object",
      "required": ["toolId", "suite", "risk"],
      "properties": {
        "toolId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique tool identifier (snake_case)"
        },
        "displayName": {
          "type": "string",
          "description": "Human-readable tool name"
        },
        "suite": { "$ref": "#/definitions/Suite" },
        "mode": { "$ref": "#/definitions/Mode" },
        "risk": { "$ref": "#/definitions/Risk" },
        "writeLane": {
          "oneOf": [{ "$ref": "#/definitions/Suite" }, { "type": "null" }],
          "description": "Write lane (null for read_only tools)"
        },
        "touches": {
          "type": "array",
          "items": { "$ref": "#/definitions/TouchTarget" },
          "description": "Data domains this tool reads or modifies"
        },
        "description": { "type": "string" },
        "endpoints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Backend API routes used by this tool"
        },
        "uiSurfaces": {
          "type": "array",
          "items": { "type": "string" },
          "description": "UI surfaces where this tool appears"
        },
        "requiresConfirmation": {
          "type": "boolean",
          "description": "Whether tool requires user confirmation before execution"
        },
        "reasonCodeRequired": {
          "type": "boolean",
          "description": "Whether tool requires reason code for audit trail"
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "annual_certification",
              "appeal_response",
              "correction",
              "exemption_change",
              "new_construction",
              "market_adjustment",
              "catastrophic_loss",
              "clerical_error",
              "board_directive",
              "supervisor_override",
              "emergency"
            ]
          },
          "description": "Allowed reason codes for this tool (required for write_high/irreversible)"
        },
        "requiresSupervisorApproval": {
          "type": "boolean",
          "description": "Whether tool requires supervisor approval (required for irreversible)"
        },
        "supervisorRoles": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Roles authorized to approve this tool (required for irreversible)"
        },
        "crossSuiteReads": {
          "type": "array",
          "items": { "$ref": "#/definitions/Suite" },
          "description": "Suites this tool reads from (cross-lane read allowlist)"
        },
        "piiHandling": {
          "type": "string",
          "enum": ["none", "sanitize", "payload_ref"],
          "description": "How this tool handles PII data (required for dais suite or notice/workflow touches)"
        },
        "tracePolicy": {
          "type": "string",
          "enum": ["none", "summary_only", "payload_ref"],
          "description": "How this tool logs to TerraTrace (required if touches includes trace)"
        },
        "payloadStore": {
          "type": "string",
          "enum": ["dossier", "secure-blob", "case-store"],
          "description": "Where payload refs are stored (required if tracePolicy is payload_ref)"
        },
        "governance": {
          "$ref": "#/definitions/CommandGovernanceMeta",
          "description": "Optional command governance metadata for preflight policy checks"
        }
      }
    }
  }
}
