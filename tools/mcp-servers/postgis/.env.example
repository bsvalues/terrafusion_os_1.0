# TerraFusion PostGIS MCP Server Configuration
# Copy this file to .env and configure for your environment

# PostgreSQL Connection (PostGIS enabled)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=terrafusion
POSTGRES_USER=terrafusion_user
POSTGRES_PASSWORD=your_secure_password_here

# Connection string (alternative to individual params)
# DATABASE_URL=postgresql://user:password@localhost:5432/terrafusion

# MCP Server Configuration
MCP_SERVER_NAME=terrafusion-postgis
MCP_SERVER_VERSION=1.0.0

# County Isolation (REQUIRED for multi-tenant security)
# Leave empty to allow all counties (NOT RECOMMENDED for production)
ALLOWED_COUNTY_IDS=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Query Limits (prevent resource exhaustion)
MAX_RESULTS_PER_QUERY=1000
QUERY_TIMEOUT_MS=30000

# Cache Configuration (optional)
ENABLE_QUERY_CACHE=false
CACHE_TTL_SECONDS=300

# Performance Monitoring
ENABLE_PERFORMANCE_METRICS=true
SLOW_QUERY_THRESHOLD_MS=1000
