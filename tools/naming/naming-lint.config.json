{
  "version": 2,
  "ruleId": "naming-governance",
  "description": "Enforces constitutional naming rules. Bans retired placeholder labels; canonical replacement is 'TerraCanon'.",
  "root": ".",
  "bannedPhrases": [
    {
      "phrase": "TerraFusion IDE",
      "message": "Retired placeholder label. Use 'TerraCanon' — the OS's own creation/development/maintenance environment."
    }
  ],
  "extensions": [
    ".md",
    ".txt",
    ".ts",
    ".tsx",
    ".js",
    ".mjs",
    ".cjs",
    ".json",
    ".yml",
    ".yaml",
    ".toml",
    ".ini"
  ],
  "excludeDirs": [
    ".git",
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".next",
    ".turbo",
    ".cache",
    ".pnpm-store",
    ".vercel",
    "out",
    "target",
    ".quarantine",
    "quarantine",
    "archived",
    "archive",
    "zzz-archive",
    "worktrees",
    ".worktrees",
    "TerraFusionIDE",
    "TERRAFUSION_ULTIMATE_STANDALONE",
    "IDEGateway",
    ".ai",
    "ai-systems",
    "packages"
  ],
  "excludeFiles": [
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock",
    "naming-lint.test.mjs",
    "naming-lint.config.json",
    "r3-constitutional-gates.json"
  ],
  "maxFileBytes": 2000000,
  "required": []
}
