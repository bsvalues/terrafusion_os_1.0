# TerraFusion cOS Production Docker Configuration
# Multi-stage build for optimized production deployment

# Build stage
FROM python:3.12-slim as builder

# Set build arguments
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=2.0.0-enterprise

# Add metadata
LABEL maintainer="TerraFusion DevOps <devops@terrafusion.gov>" \
      org.opencontainers.image.title="TerraFusion cOS" \
      org.opencontainers.image.description="Government-grade County Operating System" \
      org.opencontainers.image.version=${VERSION} \
      org.opencontainers.image.created=${BUILD_DATE} \
      org.opencontainers.image.revision=${VCS_REF} \
      org.opencontainers.image.vendor="TerraFusion Technologies" \
      org.opencontainers.image.classification="CONFIDENTIAL"

# Set working directory
WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
COPY requirements-prod.txt .

# Install build dependencies and Python packages
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libc6-dev \
    libffi-dev \
    libssl-dev \
    && pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir -r requirements-prod.txt \
    && apt-get purge -y gcc g++ libc6-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Production stage
FROM python:3.12-slim as production

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TERRAFUSION_ENV=production \
    TERRAFUSION_LOG_LEVEL=INFO

# Create non-root user for security
RUN groupadd -r terrafusion && useradd -r -g terrafusion -d /app -s /bin/bash terrafusion

# Set working directory
WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    postgresql-client \
    redis-tools \
    && rm -rf /var/lib/apt/lists/*

# Copy application code
COPY --chown=terrafusion:terrafusion . .

# Create necessary directories
RUN mkdir -p /app/logs /app/data /app/tmp \
    && chown -R terrafusion:terrafusion /app

# Set up health check
COPY deployment/production/healthcheck.py /app/healthcheck.py
RUN chmod +x /app/healthcheck.py

# Expose port
EXPOSE 8090

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python /app/healthcheck.py || exit 1

# Switch to non-root user
USER terrafusion

# Set entry point
COPY deployment/production/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["python", "desktop/api_server.py"]

# Security scanning and vulnerability management
FROM production as security-scan
USER root
RUN pip install --no-cache-dir safety bandit
COPY deployment/production/security-scan.sh /security-scan.sh
RUN chmod +x /security-scan.sh && /security-scan.sh
USER terrafusion