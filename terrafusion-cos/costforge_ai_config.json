{
  "system": {
    "name": "CostForge AI Professional Valuation Platform",
    "version": "3.0.0",
    "deployment_environment": "production",
    "compliance_standards": ["USPAP", "IAAO", "FISMA_MODERATE", "NIST_CYBERSECURITY"]
  },
  
  "county_configuration": {
    "county_name": "Benton County Washington",
    "assessor_office": "Benton County Assessor's Office",
    "total_parcels": 89247,
    "assessment_cycle": "annual",
    "current_assessment_year": 2025,
    "next_revaluation": 2026
  },
  
  "assessor_profile": {
    "title": "County Assessor",
    "total_experience_years": null,
    "pacs_experience_years": null,
    "cama_system_experience": null,
    "valuation_specialties": ["residential", "commercial", "industrial", "agricultural"],
    "certifications": ["RES", "CAE", "AAS"],
    "role_in_system_design": "Lead Technical Advisor"
  },
  
  "valuation_engines": {
    "cost_approach": {
      "enabled": true,
      "primary_data_source": "Marshall_Swift_replacement",
      "local_cost_modifiers": true,
      "depreciation_models": ["physical", "functional", "economic"],
      "update_frequency": "quarterly"
    },
    "sales_comparison": {
      "enabled": true,
      "comparable_radius_miles": 5.0,
      "minimum_comparables": 3,
      "maximum_comparables": 10,
      "time_adjustment_months": 24,
      "similarity_threshold": 0.75
    },
    "income_approach": {
      "enabled": true,
      "applicable_property_types": ["commercial", "industrial", "rental_residential"],
      "cap_rate_sources": ["local_market", "investor_surveys", "published_rates"],
      "vacancy_allowance": 0.05
    },
    "market_analysis": {
      "enabled": true,
      "trend_analysis_years": 5,
      "market_conditions_factors": ["supply", "demand", "financing", "economic_indicators"],
      "seasonal_adjustments": true
    }
  },
  
  "ai_components": {
    "neural_network": {
      "architecture": "deep_learning",
      "layers": ["input", "embedding", "lstm", "attention", "dense", "output"],
      "training_epochs": 1000,
      "validation_split": 0.2
    },
    "feature_engineering": {
      "property_features": ["size", "age", "condition", "location", "amenities"],
      "market_features": ["trends", "comparables", "economic_indicators"],
      "derived_features": ["price_per_sqft", "age_adjusted_value", "location_premium"]
    },
    "model_ensemble": {
      "models": ["random_forest", "gradient_boosting", "neural_network", "linear_regression"],
      "weighting_strategy": "performance_based",
      "cross_validation_folds": 5
    }
  },
  
  "data_sources": {
    "pacs_integration": {
      "system_type": "Harris_Govern_PACS",
      "connection_type": "API",
      "sync_frequency": "real_time",
      "data_tables": ["parcels", "improvements", "sales", "assessments"]
    },
    "mls_integration": {
      "enabled": true,
      "provider": "RMLS",
      "update_frequency": "daily",
      "historical_depth_months": 36
    },
    "external_data": {
      "economic_indicators": "Federal_Reserve_API",
      "construction_costs": "RSMeans_API",
      "market_trends": "CoStar_API",
      "demographic_data": "Census_API"
    }
  },
  
  "performance_targets": {
    "processing_time_seconds": {
      "residential": 8,
      "commercial": 15,
      "complex_commercial": 30
    },
    "accuracy_targets": {
      "residential": 0.95,
      "commercial": 0.90,
      "industrial": 0.85
    },
    "confidence_thresholds": {
      "high_confidence": 0.90,
      "medium_confidence": 0.75,
      "review_required": 0.60
    }
  },
  
  "integration_points": {
    "harris_govern_pacs": {
      "cost_system_replacement": true,
      "marshall_swift_replacement": true,
      "dcs_mobile_enhancement": true,
      "api_endpoints": ["/valuation", "/batch_processing", "/audit_trail"]
    },
    "woolpert_gis": {
      "spatial_analysis": true,
      "parcel_boundary_integration": true,
      "location_intelligence": true
    },
    "terrafusion_platform": {
      "substrate_integration": true,
      "security_mesh": true,
      "ai_swarm_coordination": true
    }
  },
  
  "vendor_partnerships": {
    "harris_govern": {
      "relationship": "existing_pacs_vendor",
      "integration_opportunity": "ai_valuation_replacement",
      "target_markets": ["existing_pacs_customers", "new_counties"],
      "revenue_model": "licensing_plus_support"
    },
    "woolpert": {
      "relationship": "gis_services_partner",
      "integration_opportunity": "comprehensive_government_platform",
      "target_markets": ["gis_customers", "government_solutions"],
      "revenue_model": "platform_partnership"
    }
  },
  
  "ui_components": {
    "valuation_interface": {
      "property_input_form": true,
      "real_time_processing": true,
      "results_visualization": true,
      "confidence_indicators": true
    },
    "analysis_dashboard": {
      "comparable_properties_map": true,
      "market_trends_charts": true,
      "valuation_breakdown": true,
      "ai_reasoning_display": true
    },
    "administrative_tools": {
      "batch_processing": true,
      "audit_trail_viewer": true,
      "performance_monitoring": true,
      "system_configuration": true
    },
    "reporting_system": {
      "standard_reports": true,
      "custom_report_builder": true,
      "export_formats": ["PDF", "Excel", "XML"],
      "automated_distribution": true
    }
  },
  
  "security_configuration": {
    "authentication": {
      "method": "multi_factor",
      "integration": "active_directory",
      "session_timeout_minutes": 30
    },
    "authorization": {
      "role_based_access": true,
      "data_classification_levels": ["public", "internal", "confidential", "restricted"],
      "audit_logging": "comprehensive"
    },
    "data_protection": {
      "encryption_at_rest": "AES_256",
      "encryption_in_transit": "TLS_1_3",
      "key_management": "HSM"
    }
  },
  
  "deployment_configuration": {
    "infrastructure": {
      "environment": "on_premises_plus_cloud_hybrid",
      "high_availability": true,
      "disaster_recovery": true,
      "backup_retention_days": 2555
    },
    "scaling": {
      "auto_scaling": true,
      "load_balancing": true,
      "resource_monitoring": true
    },
    "monitoring": {
      "performance_metrics": true,
      "error_tracking": true,
      "user_activity_logging": true,
      "compliance_reporting": true
    }
  }
}