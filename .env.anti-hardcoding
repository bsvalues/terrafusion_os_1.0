# ========================================
# ANTI-HARDCODING ENFORCEMENT
# ========================================
# This function validates that all required environment variables are set
validate_anti_hardcoding() {
    local missing_vars=()
    
    # Core service ports (from .env.ports)
    [[ -z "$TF_API_PORT" ]] && missing_vars+=("TF_API_PORT")
    [[ -z "$TF_SHELL_PORT" ]] && missing_vars+=("TF_SHELL_PORT")
    [[ -z "$TF_CONSCIOUSNESS_PORT" ]] && missing_vars+=("TF_CONSCIOUSNESS_PORT")
    [[ -z "$TF_LEVY_PORT" ]] && missing_vars+=("TF_LEVY_PORT")
    [[ -z "$TF_TRENDS_PORT" ]] && missing_vars+=("TF_TRENDS_PORT")
    
    if [[ ${#missing_vars[@]} -gt 0 ]]; then
        echo "❌ ANTI-HARDCODING VIOLATION: Missing required environment variables:"
        printf '   - %s\n' "${missing_vars[@]}"
        echo ""
        echo "TerraFusion OS enforces strict anti-hardcoding. All configuration must use environment variables."
        echo "Please set the missing variables and try again."
        return 1
    fi
    
    echo "✅ Anti-hardcoding validation passed - all required environment variables are set"
    return 0
}

