  "monitoring": {
    "grafana": {
      "url": "http://localhost:\${{TF_ADMIN_PORT:-8080}}",
      "dashboards": [
        "executive-overview",
        "application-health",
        "ai-performance",
        "infrastructure"
      ]
    },
    "prometheus": {
      "url": "http://localhost:\${{TF_ADMIN_PORT:-8080}}"
    }
  },
  "aiAssistant": {
    "enabled": true,
    "name": "Terrafusion AI DevOps Assistant",
    "endpoint": "http://localhost:\${{TF_ADMIN_PORT:-8080}}/ai/assist",
    "features": [
      "Deployment assistance",
      "Troubleshooting help",
      "Performance optimization",
      "Security recommendations"
    ]
  },
  "themes": {
    "default": "championship",
    "available": [
      {
        "id": "championship",
        "name": "Championship Blue",
        "primary": "#1f4e79",
        "secondary": "#00a86b"
      },
      {
        "id": "dark",
        "name": "Dark Mode",
        "primary": "#0a192f",
        "secondary": "#64ffda"
      },
      {
        "id": "light",
        "name": "Light Mode",
        "primary": "#ffffff",
        "secondary": "#1f4e79"
      }
    ]
  },
  "quickActions": [
    {
      "name": "Deploy All",
      "icon": "rocket",
      "command": "tfusion deploy --all"
    },
    {
      "name": "Health Check",
      "icon": "heart",
      "command": "tfusion health --all"
    },
    {
      "name": "View Logs",
      "icon": "document",
      "command": "tfusion logs --tail"
    },
    {
      "name": "AI Assistant",
      "icon": "brain",
      "command": "tfusion ai --interactive"
    }
  ],
  "updates": {
    "checkOnStartup": true,
    "channel": "stable",
    "autoUpdate": false
  }
}
