{
  "name": "terrafusion-county-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Terrafusion County OS - ONE system to rule them all",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test:full": "jest --coverage --watchAll=false",
    "test:unit": "jest --testPathPattern=unit --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:visual": "node testing-suite/ultimate-testing-framework.js --mode=visual",
    "test:performance": "node testing-suite/ultimate-testing-framework.js --mode=performance",
    "test:ai-swarm": "node testing-suite/ultimate-testing-framework.js --mode=swarm",
    "test:critical": "jest --testPathPattern=\"(critical|smoke)\" --bail",
    "audit:security": "node scripts/audit-security.cjs",
    "dev:setup": "./scripts/team-setup.sh",
    "dev:utils": "node scripts/dev-utils.js",
    "quality:full": "npm run lint && npm run type-check && npm run test:full && npm run audit:security"
  },
  "dependencies": {
    "2": "^3.0.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.3",
    "@mui/material": "^5.14.5",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.84.2",
    "@tauri-apps/api": "^1.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.481.0",
    "netlify-cli": "^23.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.7.3",
    "tailwind-merge": "^2.6.0",
    "wouter": "^3.5.2",
    "zod": "^3.24.0",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@tauri-apps/cli": "^1.5.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
