{
  "name": "Terrafusion OS - Government. Transcended.",
  "short_name": "Terrafusion",
  "description": "Turn Complexity into Clarity. Enterprise Property Assessment Platform for Government.",
  "version": "2.0.0",
  "manifest_version": 3,
  "start_url": "/",
  "display": "standalone",
  "orientation": "landscape",
  "theme_color": "#0b1020",
  "background_color": "#0b1020",
  "categories": ["business", "government", "productivity"],
  "lang": "en-US",
  "dir": "ltr",
  "scope": "/",
  "icons": [
    {
      "src": "/icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/dashboard.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "label": "Terrafusion Dashboard"
    },
    {
      "src": "/screenshots/costforge.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "label": "CostForge AI Valuation Engine"
    },
    {
      "src": "/screenshots/marketplace.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "label": "Module Marketplace"
    }
  ],
  "shortcuts": [
    {
      "name": "CostForge AI",
      "short_name": "Valuation",
      "description": "Launch property valuation engine",
      "url": "/modules/costforge",
      "icons": [
        {
          "src": "/icons/costforge-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Marketplace",
      "short_name": "Store",
      "description": "Browse and install modules",
      "url": "/modules/marketplace",
      "icons": [
        {
          "src": "/icons/marketplace-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", ".csv", ".xlsx", ".json"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "terrafusion",
      "url": "/protocol?url=%s"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false
}
