# 🏆 Benton County Championship Demo - Environment Configuration

# Database Configuration
POSTGRES_PASSWORD=championship2025
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=terrafusion_benton
POSTGRES_USER=terrafusion

# Redis Configuration
REDIS_PASSWORD=championship2025
REDIS_HOST=redis
REDIS_PORT=6379

# Application Configuration
NODE_ENV=production
PORT=3000
DEMO_MODE=championship

# Monitoring Configuration
GRAFANA_PASSWORD=championship2025
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
API_KEY=your-api-key-for-external-integrations

# County Configuration
COUNTY_NAME=Benton County
COUNTY_STATE=Washington
ASSESSOR_NAME=Benton County Assessor's Office

# TerraFusion Configuration
TERRAFUSION_VERSION=3.0.0
TERRAFUSION_MODE=championship
TERRAFUSION_TIER=enterprise

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

# External Integrations
GIS_API_ENDPOINT=https://gis.bentoncountywa.gov/api
TAX_SYSTEM_ENDPOINT=https://tax.bentoncountywa.gov/api
ASSESSMENT_API_KEY=your-assessment-api-key

# Performance Configuration
MAX_CONCURRENT_REQUESTS=1000
RESPONSE_TIMEOUT_MS=30000
CACHE_TTL_SECONDS=3600

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_SIZE=100mb
LOG_MAX_FILES=10