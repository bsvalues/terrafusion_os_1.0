{
  "compilerOptions": {
    "jsxImportSource": "react",
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ],
    "jsx": "react-jsx"
  },
  "imports": {
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@4.2.1",
    "postcss": "npm:postcss@8.4.38",
    "react-dom": "npm:react-dom@18.2.0",
    "vite": "npm:vite@5.2.11",
    "tailwindcss": "npm:tailwindcss@3.4.1",
    "autoprefixer": "npm:autoprefixer@10.4.19",
    "date-fns": "https://esm.sh/date-fns@3.6.0",
    "lucide-react": "https://esm.sh/lucide-react@0.368.0?external=react",
    "react": "npm:react@18.2.0"
  },
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite",
    "build": "deno run -A --node-modules-dir npm:vite build"
  }
}
