{
  "tasks": {
    "dev": "deno run -A --unstable-detect-cjs --node-modules-dir npm:vite",
    "build": "deno run -A --unstable-detect-cjs --node-modules-dir npm:vite build"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "imports": {
    "react": "npm:react@18.3.1",
    "react-dom": "npm:react-dom@18.3.1",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@4.2.1",
    "vite": "npm:vite@5.2.11",
    "tailwindcss": "npm:tailwindcss@3.4.1",
    "autoprefixer": "npm:autoprefixer@10.4.19",
    "postcss": "npm:postcss@8.4.38"
  }
}
