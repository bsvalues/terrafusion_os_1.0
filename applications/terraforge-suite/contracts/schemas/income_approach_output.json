{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "income_approach_output.json",
  "title": "Income Approach Output",
  "description": "USPAP-aligned output from income approach (direct capitalization method)",
  "type": "object",
  "required": [
    "subjectId",
    "effectiveDate",
    "indicatedValue",
    "incomeAnalysis",
    "qualityIndicators",
    "generatedAt"
  ],
  "properties": {
    "subjectId": {
      "type": "string",
      "minLength": 1
    },
    "effectiveDate": {
      "type": "string",
      "format": "date"
    },
    "indicatedValue": {
      "type": "integer",
      "minimum": 0,
      "description": "Value indicated by income approach (integer cents)"
    },
    "incomeAnalysis": {
      "type": "object",
      "required": [
        "potentialGrossIncome",
        "effectiveGrossIncome",
        "totalOperatingExpenses",
        "netOperatingIncome",
        "capitalizationRate"
      ],
      "properties": {
        "potentialGrossIncome": {
          "type": "integer",
          "minimum": 0,
          "description": "PGI: Total possible income (integer cents)"
        },
        "vacancyLoss": {
          "type": "integer",
          "minimum": 0,
          "description": "Vacancy and collection loss (integer cents)"
        },
        "otherIncome": {
          "type": "integer",
          "minimum": 0,
          "description": "Additional income (integer cents)"
        },
        "effectiveGrossIncome": {
          "type": "integer",
          "minimum": 0,
          "description": "EGI = PGI - vacancy + other income (integer cents)"
        },
        "operatingExpenseBreakdown": {
          "type": "object",
          "properties": {
            "taxes": { "type": "integer", "minimum": 0 },
            "insurance": { "type": "integer", "minimum": 0 },
            "utilities": { "type": "integer", "minimum": 0 },
            "maintenance": { "type": "integer", "minimum": 0 },
            "management": { "type": "integer", "minimum": 0 },
            "reserves": { "type": "integer", "minimum": 0 },
            "other": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "totalOperatingExpenses": {
          "type": "integer",
          "minimum": 0,
          "description": "Total operating expenses (integer cents)"
        },
        "netOperatingIncome": {
          "type": "integer",
          "minimum": 0,
          "description": "NOI = EGI - operating expenses (integer cents)"
        },
        "capitalizationRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Cap rate applied"
        },
        "expenseRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Operating expenses / EGI"
        }
      },
      "additionalProperties": false
    },
    "qualityIndicators": {
      "type": "object",
      "required": ["confidenceLevel", "dataQuality"],
      "properties": {
        "confidenceLevel": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Overall confidence in income approach result"
        },
        "dataQuality": {
          "type": "string",
          "enum": ["verified", "estimated", "incomplete"],
          "description": "Quality of income/expense data"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Any flags or concerns"
        },
        "capRateSupport": {
          "type": "string",
          "enum": ["strong", "moderate", "weak"],
          "description": "How well the cap rate is supported by market data"
        }
      },
      "additionalProperties": false
    },
    "explanation": {
      "type": "string",
      "description": "Human-readable explanation of the income approach analysis"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of generation"
    }
  },
  "additionalProperties": false
}
