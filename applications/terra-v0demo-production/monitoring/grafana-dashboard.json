{
  "dashboard": {
    "id": null,
    "title": "Terrafusion Quantum Infrastructure Dashboard",
    "tags": ["terrafusion", "quantum", "infrastructure"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "System Health Score",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(terrafusion_quantum_efficiency) * 100",
            "legendFormat": "Overall Health %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 85 },
                { "color": "green", "value": 95 }
              ]
            },
            "unit": "percent"
          }
        },
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Quantum Processing Efficiency",
        "type": "timeseries",
        "targets": [
          {
            "expr": "terrafusion_quantum_efficiency",
            "legendFormat": "Quantum Efficiency"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 }
      },
      {
        "id": 3,
        "title": "Active Users",
        "type": "stat",
        "targets": [
          {
            "expr": "terrafusion_active_users",
            "legendFormat": "Current Users"
          }
        ],
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 }
      },
      {
        "id": 4,
        "title": "Response Time Distribution",
        "type": "heatmap",
        "targets": [
          {
            "expr": "rate(terrafusion_response_time_seconds_bucket[5m])",
            "legendFormat": "{{le}}"
          }
        ],
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
      },
      {
        "id": 5,
        "title": "Properties Processed Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(terrafusion_properties_processed_total[5m])",
            "legendFormat": "Properties/sec"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
      },
      {
        "id": 6,
        "title": "AI Model Accuracy",
        "type": "gauge",
        "targets": [
          {
            "expr": "terrafusion_ai_accuracy",
            "legendFormat": "AI Accuracy"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "yellow", "value": 0.8 },
                { "color": "green", "value": 0.9 }
              ]
            },
            "unit": "percentunit"
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
