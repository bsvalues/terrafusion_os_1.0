{
  "name": "🏛️ TerraFusion OS - Master Command Center",
  "folders": [
    {
      "name": "📋 Core Teams",
      "path": "./Team_Workspaces/Core_Teams"
    },
    {
      "name": "⚡ Specialized Teams",
      "path": "./Team_Workspaces/Specialized_Teams"
    },
    {
      "name": "🚀 Platform Teams",
      "path": "./Team_Workspaces/Platform_Teams"
    },
    {
      "name": "🎯 Championship Monitoring",
      "path": "../scripts"
    },
    {
      "name": "📊 Sacred Mathematics Framework",
      "path": "../championship"
    },
    {
      "name": "🏛️ Government Services",
      "path": "../government-core"
    },
    {
      "name": "⚡ Infrastructure Excellence",
      "path": "../infrastructure"
    }
  ],
  "settings": {
    "azureML.showWelcomePage": false,
    "azureML.enableWorkspaceCompletions": false,
    "python.defaultInterpreterPath": "../.venv/Scripts/python.exe",
    "terrafusion.quantum_factor": 949,
    "terrafusion.target_score": 12.0,
    "terrafusion.current_achievement": 11.383,
    "terrafusion.sacred_mathematics": "OPERATIONAL",
    "terrafusion.role": "OS_MASTER_COMMAND_CENTER",
    "terrafusion.deployment_status": "PRODUCTION_AUTHORIZED",
    "terrafusion.counties": 39,
    "terrafusion.citizens": 975000,
    "terrafusion.ai_agents": 1008,
    "terrafusion.harmony_index": 0.999,
    "terrafusion.government_status": "TRANSCENDED",
    "cSpell.words": [
      "TERRAFUSION"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🏆 Championship Status Report",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/../scripts/mission-completion-report.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/.."
      },
      {
        "name": "🚀 Production Deployment Status",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/../scripts/execute-production-deployment.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/.."
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🎯 Validate Championship Achievement",
        "type": "shell",
        "command": "python",
        "args": [
          "../scripts/mission-completion-report.py"
        ],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "options": {
          "cwd": "${workspaceFolder}/.."
        }
      },
      {
        "label": "🏛️ Deploy to Counties",
        "type": "shell",
        "command": "python",
        "args": [
          "../scripts/execute-production-deployment.py"
        ],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "options": {
          "cwd": "${workspaceFolder}/.."
        }
      },
      {
        "label": "⚡ Open Core Team Workspaces",
        "type": "shell",
        "command": "code",
        "args": [
          "Team_Workspaces/Core_Teams"
        ],
        "group": "build"
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-dotnettools.csharp",
      "ms-vscode.vscode-typescript-next",
      "esbenp.prettier-vscode",
      "ms-vscode.powershell"
    ],
    "unwantedRecommendations": [
      "ms-toolsai.vscode-ai"
    ]
  }
}
