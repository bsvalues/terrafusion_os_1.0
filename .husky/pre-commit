#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "?? TERRAFUSION OS 1.0 QUALITY GATE: Pre-commit validation"
echo "?? AI-Powered Code Quality Enforcement"

# Run lint-staged for code formatting
echo "?? Running code formatting and linting..."
npx lint-staged || exit 1

# Optional strict gates (enable with TERRAFUSION_STRICT=1)
if [ "$TERRAFUSION_STRICT" = "1" ]; then
  echo "?? Running TypeScript type checking (strict mode)..."
  npm run type-check || exit 1

  echo "?? Running critical test suite (strict mode)..."
  npm run test:critical || exit 1

  echo "??? Running security vulnerability scan (strict mode)..."
  npm audit --audit-level moderate || exit 1

  echo "?? Validating AI model configurations (strict mode)..."
  npm run validate:ai-models || exit 1
else
  echo "ℹ️  STRICT checks skipped (set TERRAFUSION_STRICT=1 to enable)"
fi

# Check for large files (always)
echo "?? Checking for large files..."
git diff --cached --name-only | xargs -I {} sh -c 'if [ -f "{}" ] && [ $(stat -f%z "{}" 2>/dev/null || stat -c%s "{}" 2>/dev/null || echo 0) -gt 10485760 ]; then echo "? File {} is larger than 10MB"; exit 1; fi'

echo "? Quality gate passed - TerraFusion OS 1.0 code approved for commit (strict gates optional)"
