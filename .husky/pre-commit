#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔒 TERRAFUSION OS 1.0 QUALITY GATE: Pre-commit validation"
echo "🤖 AI-Powered Code Quality Enforcement"

# Run lint-staged for code formatting
echo "📝 Running code formatting and linting..."
npx lint-staged

# Run TypeScript type checking
echo "🔍 Running TypeScript type checking..."
npm run type-check

# Run critical tests
echo "🧪 Running critical test suite..."
npm run test:critical

# Run security checks
echo "🛡️ Running security vulnerability scan..."
npm audit --audit-level moderate

# Run AI model validation (if models changed)
echo "🧠 Validating AI model configurations..."
npm run validate:ai-models

# Check for large files
echo "📦 Checking for large files..."
git diff --cached --name-only | xargs -I {} sh -c 'if [ -f "{}" ] && [ $(stat -f%z "{}" 2>/dev/null || stat -c%s "{}" 2>/dev/null || echo 0) -gt 10485760 ]; then echo "❌ File {} is larger than 10MB"; exit 1; fi'

echo "✅ Quality gate passed - TerraFusion OS 1.0 code approved for commit"
