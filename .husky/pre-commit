#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "husky(pre-commit): running lint-staged"
npx lint-staged

# Staged changes are expected (lint-staged may fix+stage).
# But unstaged drift is not allowed—it's how gremlins leak across lanes.
if ! git diff --quiet; then
  echo ""
  echo "ERROR: pre-commit introduced unstaged changes. Refusing to commit."
  echo ""
  echo "Unstaged changes:"
  git diff --name-status || true
  echo ""
  echo "Hint: stage the changes intentionally or adjust lint-staged config to avoid touching unrelated files."
  exit 1
fi

echo "husky(pre-commit): OK (no unstaged drift)"
