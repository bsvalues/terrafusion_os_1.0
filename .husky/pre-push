#!/usr/bin/env sh
HOOK_DIR="$(dirname -- "$0")"
if [ -f "$HOOK_DIR/_/husky.sh" ]; then
  . "$HOOK_DIR/_/husky.sh"
fi

# ============================================================================
# SPECLOCK: TerraFusion Pre-Push Quality Gate (pnpm-first, deterministic)
# Contract: Must pass on clean machine with pnpm installed
# Note: Lockfile truth is ROOT pnpm-lock.yaml (workspace-aware builds)
#       frontend/pnpm-lock.yaml was removed — do NOT recreate it.
#
# Environment Variables:
#   TF_STRICT_PUSH=1  - Fail on ANY test/lint error (CI mode)
#   TF_STRICT_PUSH=0  - Warn but allow push (default, development mode)
# ============================================================================

echo "🏛️ TerraFusion OS Pre-Push Quality Gate Validation"
echo "================================================="

# Strictness mode: TF_STRICT_PUSH=1 fails on errors, default warns
STRICT_MODE="${TF_STRICT_PUSH:-0}"
if [ "$STRICT_MODE" = "1" ]; then
  echo "🔒 STRICT MODE ENABLED (TF_STRICT_PUSH=1)"
fi

# Gate 0: Verify pnpm is available (machine determinism)
command -v pnpm >/dev/null 2>&1 || {
  echo "❌ pnpm is required for TerraFusion quality gates."
  echo "   Install via: npm install -g pnpm"
  echo "   Or via Corepack: corepack enable && corepack prepare pnpm@latest --activate"
  exit 1
}

# Gate 1: Verify root lockfile exists (single source of truth)
if [ ! -f "pnpm-lock.yaml" ]; then
  echo "❌ pnpm-lock.yaml not found at repo root. Repository may be corrupted."
  exit 1
fi

# Gate 2: Untracked-file guard — no mystery files in governed paths
# Prevents agent branch-switching contamination from leaking into pushes
UNTRACKED_GOVERNED="$(git ls-files --others --exclude-standard \
  os-platform/core/ \
  tools/registry/ \
  packages/os-core/ \
  frontend/apps/os-shell/ \
  2>/dev/null)"

if [ -n "$UNTRACKED_GOVERNED" ]; then
  echo "❌ Untracked files in governed paths — refusing push:"
  echo "$UNTRACKED_GOVERNED" | sed 's/^/   /'
  echo "   Either: git add them, .gitignore them, or delete them."
  exit 1
fi

# Gate 3: Verify root deps exist (npm workspace for root, pnpm for frontend)
if [ ! -d "node_modules" ]; then
  echo "⚠️ Root node_modules not found. Installing..."
  npm install --legacy-peer-deps || {
    echo "❌ Failed to install root dependencies."
    exit 1
  }
fi

# Gate 4: Verify vitest is available from root
if ! npx vitest --version >/dev/null 2>&1; then
  echo "❌ vitest not available. Run: npm install"
  exit 1
fi

echo "✅ Pre-flight checks passed"
echo ""

# Helper: Run command, fail in strict mode or warn in dev mode
run_gate() {
  local name="$1"
  shift
  echo "$name"
  if "$@"; then
    return 0
  else
    if [ "$STRICT_MODE" = "1" ]; then
      echo "❌ $name FAILED (strict mode)"
      exit 1
    else
      echo "⚠️ $name failed (non-blocking in dev mode)"
      return 0
    fi
  fi
}

run_gate "🧪 Running unit tests..." npm run test:unit

echo ""
run_gate "🔒 Running security audit..." npm run security:scan

echo ""
run_gate "📊 Running performance validation..." npm run performance:benchmark

echo ""
run_gate "🤖 Validating AI agent coordination..." npm run ai-swarm:monitor

echo ""
run_gate "🏛️ Government compliance validation..." npm run government:compliance

echo ""
run_gate "🏗️ Build verification..." npm run build

echo ""
echo "✅ Core quality gates passed! Government. Transcended."
if [ "$STRICT_MODE" != "1" ]; then
  echo "💡 Tip: Set TF_STRICT_PUSH=1 to enable strict mode (CI behavior)"
fi
