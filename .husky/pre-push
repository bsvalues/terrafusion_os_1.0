#!/usr/bin/env bash
set -euo pipefail

# Husky pre-push: MUST be check-only.
# This hook is allowed to run validation (tests/scans/build),
# but it must NEVER modify tracked files nor stage changes.
#
# If any command mutates the working tree or index, we fail fast
# and report WHICH step caused it.

# Ensure we run from repo root
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "husky(pre-push): enforcing check-only (no working tree or index mutations)"

die() {
  echo ""
  echo "ERROR: $1"
  echo ""
  echo "Working tree changes:"
  git diff --name-status || true
  echo ""
  echo "Index (staged) changes:"
  git diff --cached --name-status || true
  exit 1
}

assert_clean() {
  if ! git diff --quiet; then
    die "Working tree is dirty before running pre-push."
  fi
  if ! git diff --cached --quiet; then
    die "Index is dirty (staged changes) before running pre-push."
  fi
}

run_step() {
  local name="$1"
  shift

  echo ""
  echo "husky(pre-push): step => $name"
  assert_clean

  # Run the step
  "$@"

  # Fail if anything changed
  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo ""
    echo "husky(pre-push): MUTATION DETECTED after step: $name"
    die "Pre-push must not mutate the repo. Fix the offending step or move generation to an explicit command."
  fi
}

# If you need an emergency escape hatch while repairing the chain:
#   HUSKY_NO_MUTATION_GUARD=1 git push
if [[ "${HUSKY_NO_MUTATION_GUARD:-0}" == "1" ]]; then
  echo "husky(pre-push): WARNING guard disabled via HUSKY_NO_MUTATION_GUARD=1"
  exit 0
fi

assert_clean

# --- Heavy chain (each isolated so we can pinpoint the mutator) ---
run_step "cross-lane-core-touch-guard" bash scripts/guards/cross-lane-core-touch-guard.sh
run_step "test:unit" npm run -s test:unit
if [[ "${TF_SECURITY_SCAN:-0}" == "1" ]]; then
  run_step "security:scan" npm run -s security:scan
else
  echo ""
  echo "husky(pre-push): step => security:scan (SKIPPED; set TF_SECURITY_SCAN=1 to enable locally)"
fi
if [[ "${TF_PERF_BENCH:-0}" == "1" ]]; then
  run_step "performance:benchmark" npm run -s performance:benchmark
else
  echo ""
  echo "husky(pre-push): step => performance:benchmark (SKIPPED; set TF_PERF_BENCH=1 to enable locally)"
fi
if [[ "${TF_AI_SWARM_MONITOR:-0}" == "1" ]]; then
  run_step "ai-swarm:monitor" npm run -s ai-swarm:monitor
else
  echo ""
  echo "husky(pre-push): step => ai-swarm:monitor (SKIPPED; set TF_AI_SWARM_MONITOR=1 to enable locally)"
fi
if [[ "${TF_GOV_COMPLIANCE:-0}" == "1" ]]; then
  run_step "government:compliance" npm run -s government:compliance
else
  echo ""
  echo "husky(pre-push): step => government:compliance (SKIPPED; set TF_GOV_COMPLIANCE=1 to enable locally)"
fi
run_step "build" npm run -s build

echo ""
echo "husky(pre-push): OK (no mutations detected)"
