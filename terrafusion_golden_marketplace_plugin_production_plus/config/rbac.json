{
  "jwt": {
    "issuer": "https://terrafusion-os",
    "audience": "marketplace",
    "jwks_uri": "https://terrafusion-os/.well-known/jwks.json"
  },
  "role_claim": "https://terrafusion-os/roles",
  "enforcement": {
    "deny_by_default": true,
    "mappings": {
      "/api/*": [
        "User"
      ],
      "/api/graph/*": [
        "Assessor",
        "CountyAdmin",
        "EnterpriseAdmin"
      ],
      "/api/opt/*": [
        "Assessor",
        "CountyAdmin",
        "EnterpriseAdmin"
      ],
      "/api/billing/*": [
        "CountyAdmin",
        "EnterpriseAdmin"
      ]
    }
  }
}