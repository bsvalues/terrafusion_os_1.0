FROM mcr.microsoft.com/dotnet/sdk:8.0

LABEL org.opencontainers.image.title="TerraFusion local .NET dev toolbox"
LABEL org.opencontainers.image.description="Local-only .NET SDK toolbox for TerraFusion developer workflows"

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_NOLOGO=1
ENV DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

WORKDIR /workspace

CMD ["bash"]
