# TerraFusion OS 1.0 - AI Services Docker Build

# Stage 1: Base Image
FROM node:20-alpine
WORKDIR /app

# Copy package files for dependencies
COPY compose/ai-services/package*.json ./

# Install production dependencies
RUN npm install --only=production

# Copy AI services source code
COPY compose/ai-services/ ./

# The command to run will be specified in the docker-compose.yml
# e.g., command: ["node", "ai-swarm.js"]
