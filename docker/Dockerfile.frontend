# TerraFusion OS Frontend - Government-Grade React Application
# Multi-stage Docker build optimized for production deployment
# Features: React 18, TypeScript, Material-UI, Quantum Performance UI

# Stage 1: Build Environment
FROM node:18-alpine AS build-env
LABEL maintainer="TerraFusion Infrastructure Squad Alpha"
LABEL stage="build"

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache \
    git \
    python3 \
    make \
    g++ \
    curl \
    ca-certificates \
    && rm -rf /var/cache/apk/*

# Copy package files for dependency caching
COPY frontend/package*.json ./
COPY frontend/yarn.lock* ./

# Install dependencies with production optimizations
RUN npm ci --only=production --no-audit --no-fund && \
    npm cache clean --force

# Copy source code
COPY frontend/ ./

# Build application with quantum optimizations
ENV NODE_ENV=production \
    REACT_APP_API_URL=/api \
    REACT_APP_QUANTUM_ENABLED=true \
    REACT_APP_AI_SWARM_SIZE=1008 \
    REACT_APP_PERFORMANCE_TARGET=379000000 \
    GENERATE_SOURCEMAP=false \
    INLINE_RUNTIME_CHUNK=false

RUN npm run build && \
    npm run build:analyze || true

# Stage 2: Nginx Production Server
FROM nginx:1.29.4-alpine AS runtime
LABEL org.opencontainers.image.title="TerraFusion OS Frontend"
LABEL org.opencontainers.image.description="Government React UI with quantum performance"
LABEL org.opencontainers.image.vendor="TerraFusion Technologies"

# Install security updates
RUN apk update && \
    apk add --no-cache \
    curl \
    ca-certificates \
    && rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S terrafusion && \
    adduser -S terrafusion -u 1001 -G terrafusion

# Copy built application
COPY --from=build-env --chown=terrafusion:terrafusion /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# Copy security headers configuration
COPY docker/nginx/security-headers.conf /etc/nginx/conf.d/security-headers.conf

# Create required directories
RUN mkdir -p /var/cache/nginx /var/log/nginx /var/run/nginx && \
    chown -R terrafusion:terrafusion /var/cache/nginx /var/log/nginx /var/run/nginx /usr/share/nginx/html

# Switch to non-root user
USER terrafusion

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

# Metadata
LABEL quantum.ui.framework="react-18"
LABEL quantum.performance.optimized="true"
LABEL security.headers="enabled"
LABEL government.compliant="true"