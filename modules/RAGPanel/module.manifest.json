{
  "id": "RAGPanel",
  "name": "RAGPanel - Advanced AI Knowledge System",
  "version": "1.0.0",
  "description": "Advanced RAG Services with Ollama + ChromaDB Integration for government knowledge management",
  "category": "ai-advanced",
  "tier": "tier-1",
  "author": "TerraFusion OS",
  "license": "MIT",
  "pricing": {
    "base": 230,
    "currency": "USD",
    "billing": "monthly",
    "features": [
      "Ollama LLM Integration",
      "ChromaDB Vector Database",
      "Document Processing & Indexing",
      "Government Knowledge Base",
      "Real-time AI Chat Interface",
      "Multi-model Support",
      "Query Analytics",
      "Advanced RAG Pipeline"
    ]
  },
  "capabilities": [
    "frontend",
    "backend",
    "database",
    "api",
    "ai",
    "rag",
    "vector_search",
    "document_processing"
  ],
  "endpoints": {
    "health": "/modules/RAGPanel/health",
    "api": "/modules/RAGPanel/api",
    "ui": "/modules/RAGPanel/ui",
    "chat": "/modules/RAGPanel/chat",
    "documents": "/modules/RAGPanel/documents",
    "vector": "/modules/RAGPanel/vector"
  },
  "ports": {
    "frontend": 3006,
    "backend": 5006,
    "ollama": 11434,
    "chromadb": 8000
  },
  "dependencies": [
    "government-core",
    "ai-swarm"
  ],
  "permissions": [
    "ai.chat",
    "ai.models",
    "documents.read",
    "documents.write",
    "vector.search",
    "knowledge.access"
  ],
  "configuration": {
    "models": {
      "default": "llama2:13b",
      "available": ["llama2:13b", "codellama:7b", "mistral:7b"],
      "context_length": 4096,
      "temperature": 0.7
    },
    "vector_db": {
      "provider": "chromadb",
      "collection": "government_knowledge",
      "embedding_model": "all-MiniLM-L6-v2",
      "chunk_size": 512,
      "chunk_overlap": 50
    },
    "document_processing": {
      "supported_formats": ["PDF", "DOCX", "TXT", "MD", "HTML"],
      "auto_index": true,
      "ocr_enabled": true
    }
  },
  "ai_features": {
    "rag_pipeline": true,
    "semantic_search": true,
    "document_qa": true,
    "context_aware_responses": true,
    "source_attribution": true,
    "multi_turn_conversations": true
  },
  "ui": {
    "icon": "🧠",
    "color": "#0099ff",
    "theme": "terrafusion-government",
    "layout": "chat-centric"
  },
  "marketplace": {
    "featured": true,
    "revenue_sharing": "70_30",
    "compatibility": ["all_counties"],
    "requirements": ["terrafusion_os_1.0"],
