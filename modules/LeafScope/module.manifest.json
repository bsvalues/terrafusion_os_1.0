{
  "id": "LeafScope",
  "name": "LeafScope - Advanced Geospatial Platform",
  "version": "1.0.0",
  "description": "PostGIS-Powered Spatial Analysis with React + Leaflet for government geospatial operations",
  "category": "geospatial",
  "tier": "tier-1",
  "author": "TerraFusion OS",
  "license": "MIT",
  "pricing": {
    "base": 195,
    "currency": "USD",
    "billing": "monthly",
    "features": [
      "PostGIS Integration",
      "Advanced Spatial Analysis",
      "Interactive Mapping Interface",
      "Multi-format Data Import/Export",
      "Real-time Query Builder",
      "WMS/WFS Services",
      "Coordinate System Support",
      "Professional GIS Tools"
    ]
  },
  "capabilities": [
    "frontend",
    "backend",
    "database",
    "api",
    "gis",
    "spatial_analysis",
    "mapping",
    "data_processing"
  ],
  "endpoints": {
    "health": "/modules/LeafScope/health",
    "api": "/modules/LeafScope/api",
    "ui": "/modules/LeafScope/ui",
    "wms": "/modules/LeafScope/wms",
    "wfs": "/modules/LeafScope/wfs",
    "geoserver": "/modules/LeafScope/geoserver"
  },
  "ports": {
    "frontend": 3007,
    "backend": 5007,
    "geoserver": 8080,
    "postgis": 5432
  },
  "dependencies": [
    "government-core",
    "property-workbench",
    "gispro"
  ],
  "permissions": [
    "gis.read",
    "gis.write",
    "spatial.analysis",
    "data.import",
    "data.export",
    "postgis.access",
    "mapping.admin"
  ],
  "configuration": {
    "database": {
      "type": "postgis",
      "extensions": ["postgis", "postgis_topology", "fuzzystrmatch", "postgis_tiger_geocoder"],
      "spatial_ref_sys": true
    },
    "coordinate_systems": [
      "EPSG:4326", "EPSG:3857", "EPSG:2927", "EPSG:4269"
    ],
    "data_formats": {
      "import": ["SHP", "GeoJSON", "KML", "GPX", "GML", "DXF"],
      "export": ["SHP", "GeoJSON", "KML", "CSV", "PDF", "PNG"]
    },
    "map_services": {
      "wms_enabled": true,
      "wfs_enabled": true,
      "wmts_enabled": true,
      "tiling": "XYZ"
    },
    "analysis_tools": {
      "buffer": true,
      "overlay": true,
      "proximity": true,
      "network": true,
      "topology": true,
      "geostatistics": true
    }
  },
  "gis_features": {
    "interactive_mapping": true,
    "layer_management": true,
    "spatial_queries": true,
    "attribute_editing": true,
    "geocoding": true,
    "routing": true,
    "printing": true,
    "3d_visualization": false
  },
  "ui": {
    "icon": "🌍",
    "color": "#0099ff",
    "theme": "terrafusion-government",
    "layout": "map-centric"
  },
  "marketplace": {
    "featured": true,
    "revenue_sharing": "70_30",
    "compatibility": ["all_counties"],
    "requirements": ["terrafusion_os_1.0", "postgis"],
    "rating": 4.8,
    "downloads": 428
  },
  "hot_swap": {
    "enabled": true,
    "restart_required": false,
    "dependencies": ["postgis"]
  },
  "status": "active",
