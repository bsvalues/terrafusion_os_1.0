{
  "name": "@terrafusion/unified-system",
  "version": "1.0.0",
  "description": "Unified system integration platform for seamless module coordination and system-wide operations",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "npm run build:system",
    "build:system": "webpack --mode=production",
    "test": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:system": "jest --testPathPattern=system",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate": "npm run lint && npm run test",
    "system:check": "node scripts/system-health-check.js",
    "system:integrate": "node scripts/module-integration.js"
  },
  "dependencies": {
    "express": "^4.18.0",
    "ws": "^8.13.0",
    "redis": "^4.6.0",
    "lodash": "^4.17.21",
    "@terrafusion/core": "^1.0.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "webpack": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "@types/node": "^20.0.0"
  },
  "keywords": ["terrafusion", "unified", "system-integration", "coordination", "government"],
  "author": "Terrafusion OS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/terrafusion-os"
  },
  "terrafusion": {
    "module": true,
    "category": "system-integration",
    "government-compliant": true,
    "integration-hub": true,
    "system-coordinator": true
  }
}