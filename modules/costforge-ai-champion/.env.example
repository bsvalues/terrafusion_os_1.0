# CostForge AI Champion - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ================================
# SERVER CONFIGURATION
# ================================
NODE_ENV=development
PORT=3009

# ================================
# AI SERVICE CONFIGURATION
# ================================

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# ================================
# DATABASE CONFIGURATION
# ================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Direct Connection (Alternative to Supabase)
DATABASE_URL=postgresql://username:password@localhost:5432/costforge

# ================================
# CORS AND SECURITY
# ================================

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3008,tauri://localhost,https://localhost:3008

# JWT Secret (for future authentication features)
JWT_SECRET=your-jwt-secret-key-here

# ================================
# EXTERNAL SERVICES
# ================================

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50mb

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# ================================
# LOGGING AND MONITORING
# ================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# External Monitoring (optional)
SENTRY_DSN=your-sentry-dsn
DATADOG_API_KEY=your-datadog-api-key

# ================================
# DEVELOPMENT SETTINGS
# ================================

# Enable detailed error messages
DEBUG_MODE=true

# Mock external services for testing
MOCK_AI_SERVICES=false
MOCK_DATABASE=false

# ================================
# PRODUCTION SETTINGS
# ================================

# SSL Configuration
SSL_ENABLED=false
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ================================
# FEATURE FLAGS
# ================================

# Enable/disable specific features
ENABLE_AR_VISUALIZATION=true
ENABLE_3D_MODELS=true
ENABLE_AI_PREDICTIONS=true
ENABLE_COST_MATRIX_IMPORT=true
ENABLE_ANALYTICS=true

# ================================
# CACHE CONFIGURATION
# ================================

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# ================================
# BACKUP CONFIGURATION
# ================================

# Automated backup settings
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=./backups