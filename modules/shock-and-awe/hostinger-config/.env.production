# TerraFusion Market - Production Environment Configuration
# For Hostinger deployment

# Domain Configuration
DOMAIN=terrafusionmarket.io
SITE_URL=https://terrafusionmarket.io
API_BASE_URL=https://terrafusionmarket.io/api

# FTP Deployment Settings
FTP_HOST=files.000webhost.com
FTP_PORT=21
FTP_USER=
FTP_PASS=
REMOTE_PATH=/public_html

# Database Configuration (Hostinger MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_PREFIX=tf_

# Security Settings
SESSION_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=

# Application Settings
NODE_ENV=production
LOG_LEVEL=warn
DEBUG=false

# Performance Settings
CACHE_TTL=3600
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000

# Email Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@terrafusionmarket.io

# Analytics
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=

# CDN and Asset Management
CDN_URL=
ASSET_VERSION=1.0.0
ENABLE_COMPRESSION=true

# API Keys (External Services)
MAPS_API_KEY=
WEATHER_API_KEY=
GEOCODING_API_KEY=

# Monitoring and Notifications
WEBHOOK_URL=
SLACK_WEBHOOK=
UPTIME_MONITOR_URL=

# Feature Flags
ENABLE_DEMO=true
ENABLE_CONTACT_FORM=true
ENABLE_REGISTRATION=false
ENABLE_PAYMENT=false

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# CORS Settings
CORS_ORIGIN=https://terrafusionmarket.io
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# Backup Settings
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP=true

# SSL/TLS Configuration
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
ENABLE_HSTS=true

# Content Security Policy
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com
CSP_STYLE_SRC='self' 'unsafe-inline' https://fonts.googleapis.com
CSP_FONT_SRC='self' https://fonts.gstatic.com
CSP_IMG_SRC='self' data: https:
CSP_CONNECT_SRC='self' https://www.google-analytics.com

# File Upload Limits (Hostinger Shared Hosting)
MAX_FILE_SIZE=10485760
MAX_FILES=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=TerraFusion Market is currently undergoing maintenance. Please check back soon.
MAINTENANCE_ALLOWED_IPS=

# Timezone
TIMEZONE=America/Los_Angeles

# Logging
LOG_FILE=/public_html/logs/app.log
ERROR_LOG_FILE=/public_html/logs/error.log
ACCESS_LOG_FILE=/public_html/logs/access.log