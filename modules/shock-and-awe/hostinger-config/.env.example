# TerraFusion Market - Environment Configuration Template
# Copy this file to .env.production and fill in your values

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
DOMAIN=terrafusionmarket.io
SITE_URL=https://terrafusionmarket.io
API_BASE_URL=https://terrafusionmarket.io/api

# =============================================================================
# HOSTINGER FTP CONFIGURATION
# =============================================================================
# Get these from your Hostinger control panel
FTP_HOST=files.000webhost.com
FTP_PORT=21
FTP_USER=your_hostinger_username
FTP_PASS=your_hostinger_password
REMOTE_PATH=/public_html

# =============================================================================
# DATABASE CONFIGURATION (MYSQL)
# =============================================================================
# Create database in Hostinger MySQL panel first
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_PREFIX=tf_

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate strong secrets for production
SESSION_SECRET=your_long_random_session_secret_here
JWT_SECRET=your_long_random_jwt_secret_here
ENCRYPTION_KEY=your_32_character_encryption_key_here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
LOG_LEVEL=warn
DEBUG=false

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
CACHE_TTL=3600
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Use Hostinger SMTP settings
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=your_email@terrafusionmarket.io
SMTP_PASS=your_email_password
FROM_EMAIL=noreply@terrafusionmarket.io

# =============================================================================
# ANALYTICS AND TRACKING
# =============================================================================
# Optional: Add your tracking IDs
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# =============================================================================
# CDN AND ASSETS
# =============================================================================
# Optional: Configure CDN
CDN_URL=
ASSET_VERSION=1.0.0
ENABLE_COMPRESSION=true

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
# Optional: For enhanced features
MAPS_API_KEY=your_google_maps_api_key
WEATHER_API_KEY=your_weather_api_key
GEOCODING_API_KEY=your_geocoding_api_key

# =============================================================================
# MONITORING AND NOTIFICATIONS
# =============================================================================
# Optional: For alerts and monitoring
WEBHOOK_URL=your_webhook_url_for_notifications
SLACK_WEBHOOK=your_slack_webhook_url
UPTIME_MONITOR_URL=your_uptime_monitor_webhook

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_DEMO=true
ENABLE_CONTACT_FORM=true
ENABLE_REGISTRATION=false
ENABLE_PAYMENT=false

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# =============================================================================
# CORS SETTINGS
# =============================================================================
CORS_ORIGIN=https://terrafusionmarket.io
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization

# =============================================================================
# BACKUP SETTINGS
# =============================================================================
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP=true

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
ENABLE_HSTS=true

# =============================================================================
# CONTENT SECURITY POLICY
# =============================================================================
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com
CSP_STYLE_SRC='self' 'unsafe-inline' https://fonts.googleapis.com
CSP_FONT_SRC='self' https://fonts.gstatic.com
CSP_IMG_SRC='self' data: https:
CSP_CONNECT_SRC='self' https://www.google-analytics.com

# =============================================================================
# FILE UPLOAD LIMITS
# =============================================================================
# Hostinger shared hosting limits
MAX_FILE_SIZE=10485760
MAX_FILES=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# =============================================================================
# MAINTENANCE MODE
# =============================================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=TerraFusion Market is currently undergoing maintenance. Please check back soon.
MAINTENANCE_ALLOWED_IPS=

# =============================================================================
# TIMEZONE AND LOCALIZATION
# =============================================================================
TIMEZONE=America/Los_Angeles
DEFAULT_LOCALE=en_US

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_FILE=/public_html/logs/app.log
ERROR_LOG_FILE=/public_html/logs/error.log
ACCESS_LOG_FILE=/public_html/logs/access.log
LOG_MAX_SIZE=10MB
LOG_MAX_FILES=5

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# These are only used in development
# DEV_FTP_HOST=localhost
# DEV_DB_HOST=localhost
# DEV_DOMAIN=localhost:3000

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit this file with real credentials to version control
# 2. Use strong, unique passwords for all services
# 3. Regularly rotate secrets and API keys
# 4. Monitor access logs for suspicious activity
# 5. Keep backups of configuration in a secure location