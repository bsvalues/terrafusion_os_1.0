{
  "name": "@terrafusion/terrafusion-market",
  "version": "1.0.0",
  "description": "Terrafusion Market - Government Property Intelligence Platform",
  "main": "index.html",
  "homepage": "https://terrafusionmarket.io",
  "scripts": {
    "start": "npm run serve",
    "dev": "npm run serve:dev",
    "serve": "serve dist -s -p 3000",
    "serve:dev": "live-server --port=3000 --open=/ --watch=.",
    "build": "npm run build:production",
    "build:production": "npm run clean && npm run build:assets && npm run build:optimize && npm run build:copy",
    "build:development": "npm run clean && npm run build:assets && npm run build:copy",
    "build:assets": "npm run build:css && npm run build:js",
    "build:css": "npm run build:css:main && npm run build:css:components",
    "build:css:main": "postcss styles/main.css -o dist/styles/main.css --config postcss.config.js",
    "build:css:components": "postcss styles/components.css -o dist/styles/components.css --config postcss.config.js",
    "build:js": "npm run build:js:main && npm run build:js:modules",
    "build:js:main": "webpack --config webpack.config.js --mode=production",
    "build:js:modules": "concat-cli -f js/main.js js/demo.js js/animations.js js/quantum-viz.js -o dist/js/main.js",
    "build:optimize": "npm run optimize:images && npm run optimize:html && npm run optimize:assets",
    "build:copy": "npm run copy:html && npm run copy:assets && npm run copy:config",
    "clean": "rimraf dist && mkdir -p dist/{js,styles,assets,api,error-pages}",
    "copy:html": "cp index.html dist/ && cp hostinger-config/maintenance.html dist/",
    "copy:assets": "cp -r assets dist/ 2>/dev/null || mkdir -p dist/assets",
    "copy:config": "cp .htaccess dist/ && cp manifest.json dist/ && cp sw.js dist/",
    "optimize:images": "imagemin assets/*.{jpg,jpeg,png,gif,svg} --out-dir=dist/assets",
    "optimize:html": "html-minifier --collapse-whitespace --remove-comments --minify-css --minify-js dist/index.html -o dist/index.html",
    "optimize:assets": "npm run gzip:assets",
    "gzip:assets": "gzip -9 -k dist/js/*.js && gzip -9 -k dist/styles/*.css",
    "deploy": "bash deploy.sh",
    "deploy:staging": "bash deploy.sh --domain=staging.terrafusionmarket.io",
    "deploy:production": "bash deploy.sh --domain=terrafusionmarket.io",
    "deploy:hostinger": "npm run build:production && bash deploy.sh",
    "test": "jest --coverage",
    "test:e2e": "playwright test",
    "test:lighthouse": "lighthouse https://terrafusionmarket.io --output=html --output-path=./reports/lighthouse.html",
    "test:performance": "npm run test:lighthouse && npm run test:pagespeed",
    "test:pagespeed": "psi https://terrafusionmarket.io --strategy=mobile",
    "lint": "eslint js/ --fix",
    "lint:css": "stylelint styles/*.css --fix",
    "lint:html": "htmlhint index.html",
    "format": "prettier --write .",
    "validate": "npm run lint && npm run test && npm run build:production",
    "precommit": "npm run validate",
    "predeploy": "npm run validate",
    "backup": "mkdir -p backups && tar -czf backups/terrafusion-market-$(date +%Y%m%d_%H%M%S).tar.gz .",
    "restore": "echo 'Use: tar -xzf backups/[backup-file] to restore'",
    "monitor": "npm run test:performance",
    "health-check": "curl -f https://terrafusionmarket.io/health || exit 1",
    "status": "curl -s https://terrafusionmarket.io/api/status | json_pp",
    "setup:hostinger": "npm run setup:env && npm run setup:db",
    "setup:env": "cp hostinger-config/.env.production .env",
    "setup:db": "echo 'Run database-setup.sql in Hostinger MySQL panel'",
    "logs": "tail -f logs/*.log",
    "analyze": "webpack-bundle-analyzer dist/js/main.js",
    "security": "npm audit --audit-level=moderate",
    "update": "npm update && npm audit fix"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "helmet": "^7.0.0",
    "rate-limiter-flexible": "^2.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "autoprefixer": "^10.4.0",
    "babel-loader": "^10.0.0",
    "concat-cli": "^4.0.0",
    "core-js": "^3.45.0",
    "css-loader": "^7.1.2",
    "cssnano": "^6.0.0",
    "eslint": "^8.0.0",
    "html-minifier": "^4.0.0",
    "htmlhint": "^1.1.4",
    "imagemin": "^8.0.0",
    "imagemin-cli": "^7.0.0",
    "jest": "^29.0.0",
    "lighthouse": "^10.4.0",
    "live-server": "^1.2.2",
    "playwright": "^1.36.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^10.1.0",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.0.0",
    "psi": "^4.1.0",
    "rimraf": "^5.0.0",
    "serve": "^14.2.0",
    "style-loader": "^4.0.0",
    "stylelint": "^15.10.0",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.88.0",
    "webpack-bundle-analyzer": "^4.9.0",
    "webpack-cli": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "terrafusion",
    "property-assessment",
    "government",
    "ai",
    "real-estate",
    "valuation",
    "hostinger",
    "production"
  ],
  "author": "Terrafusion Market Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/terrafusion-market"
  },
  "bugs": {
    "url": "https://github.com/terrafusion/terrafusion-market/issues"
  },
  "terrafusion": {
    "module": true,
    "category": "web-application",
    "government-compliant": true,
    "production-ready": true,
    "hostinger-compatible": true,
    "deployment-target": "terrafusionmarket.io"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.min.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": "eslint:recommended",
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error"
    }
  },
  "stylelint": {
    "extends": "stylelint-config-standard",
    "rules": {
      "indentation": 4
    }
  }
}
