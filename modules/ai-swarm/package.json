{
  "name": "@terrafusion/ai-swarm",
  "version": "1.0.0",
  "description": "AI agent swarm orchestration system for coordinating 1,008 intelligent agents",
  "main": "SwarmOrchestrator.ts",
  "scripts": {
    "start": "ts-node SwarmOrchestrator.ts",
    "dev": "ts-node --watch SwarmOrchestrator.ts",
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:swarm": "jest --testPathPattern=swarm",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "swarm:start": "node dist/SwarmOrchestrator.js --agents=1008",
    "swarm:dev": "node dist/SwarmOrchestrator.js --agents=41",
    "swarm:stop": "pkill -f SwarmOrchestrator",
    "mission:launch": "ts-node launch-strategic-mission.ts launch",
    "mission:status": "ts-node launch-strategic-mission.ts status",
    "mission:test": "ts-node launch-strategic-mission.ts test",
    "strategic:deploy": "ts-node launch-strategic-mission.ts deploy",
    "strategic:execute": "ts-node launch-strategic-mission.ts execute",
    "phase2:launch": "ts-node launch-phase2-enhancement.ts launch",
    "phase2:status": "ts-node launch-phase2-enhancement.ts status",
    "phase2:test": "ts-node launch-phase2-enhancement.ts test",
    "phase2:monitor": "ts-node launch-phase2-enhancement.ts monitor",
    "enhancement:deploy": "ts-node launch-phase2-enhancement.ts deploy",
    "enhancement:execute": "ts-node launch-phase2-enhancement.ts execute"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.0.0",
    "chalk": "^5.0.0",
    "figlet": "^1.6.0",
    "lodash": "^4.17.21",
    "redis": "^4.6.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "uuid": "^9.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/jest": "^29.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0"
  },
  "keywords": [
    "ai",
    "swarm",
    "orchestration",
    "agents",
    "coordination",
    "government",
    "terrafusion"
  ],
  "author": "Terrafusion OS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/terrafusion-os"
  },
  "terrafusion": {
    "module": true,
    "category": "ai-coordination",
    "government-compliant": true,
    "ai-enabled": true,
    "performance-critical": true,
    "swarm-size": 1008
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
