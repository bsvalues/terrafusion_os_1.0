# TerraFusion OS Backend - Enhanced Development Dockerfile
# Optimized for developer productivity, security, and performance
# Features: Multi-stage build, security hardening, debugging tools, hot reload

# Stage 1: Base Development Environment
FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS dev-base
LABEL maintainer="TerraFusion Infrastructure Squad Alpha"
LABEL stage="development"
LABEL security.scan="enabled"

# Install development dependencies and security tools
RUN apk add --no-cache \
    curl \
    git \
    bash \
    ca-certificates \
    openssl \
    procps \
    htop \
    && update-ca-certificates \
    && rm -rf /var/cache/apk/*

# Create non-root development user
RUN addgroup -g 1001 -S devuser && \
    adduser -S devuser -u 1001 -G devuser -s /bin/bash

# Set working directory
WORKDIR /app

# Install global development tools
RUN dotnet tool install --global dotnet-ef --version 8.0.* && \
    dotnet tool install --global dotnet-dump --version 8.0.* && \
    dotnet tool install --global dotnet-trace --version 8.0.* && \
    dotnet tool install --global dotnet-counters --version 8.0.* && \
    dotnet tool install --global dotnet-monitor --version 8.0.*

# Add tools to PATH for all users
ENV PATH="$PATH:/root/.dotnet/tools:/home/devuser/.dotnet/tools"

# Stage 2: Development Runtime
FROM dev-base AS development

# Copy project files first for better layer caching
COPY --chown=devuser:devuser TerraFusion.sln ./
COPY --chown=devuser:devuser TerraFusion.API/*.csproj ./TerraFusion.API/
COPY --chown=devuser:devuser TerraFusion.Core/*.csproj ./TerraFusion.Core/
COPY --chown=devuser:devuser TerraFusion.Data/*.csproj ./TerraFusion.Data/
COPY --chown=devuser:devuser TerraFusion.AI/*.csproj ./TerraFusion.AI/

# Switch to development user for security
USER devuser

# Restore dependencies (cached layer)
RUN dotnet restore TerraFusion.sln --verbosity minimal

# Copy source code
COPY --chown=devuser:devuser . .

# Set development environment variables
ENV ASPNETCORE_ENVIRONMENT=Development \
    ASPNETCORE_URLS=https://+:5001;http://+:5000 \
    DOTNET_USE_POLLING_FILE_WATCHER=true \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_WATCH_RESTART_ON_RUDE_EDIT=true \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

# Development-specific optimizations
ENV DOTNET_GCServer=0 \
    DOTNET_GCConcurrent=1 \
    DOTNET_GCRetainVM=0 \
    DOTNET_ThreadPool_UnfairSemaphoreSpinLimit=6

# Create required directories
RUN mkdir -p /app/logs /app/data /app/temp /app/uploads && \
    chmod 755 /app/logs /app/data /app/temp /app/uploads

# Generate development SSL certificate (user-specific)
RUN dotnet dev-certs https --clean && \
    dotnet dev-certs https --trust --quiet || true

# Expose ports
EXPOSE 5000 5001

# Health check for development
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Development startup with enhanced watch capabilities
CMD ["dotnet", "watch", "run", "--project", "TerraFusion.API", \
     "--urls", "https://+:5001;http://+:5000", \
     "--verbosity", "minimal", \
     "--no-hot-reload"]

# Metadata for development tracking
LABEL development.hot-reload="enabled"
LABEL development.debugging="enabled"
LABEL security.user="non-root"
LABEL performance.optimized="development"
