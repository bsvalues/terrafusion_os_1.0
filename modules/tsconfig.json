{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "**/src/**/*.ts",
    "**/src/**/*.tsx",
    "**/frontend/src/**/*.ts", 
    "**/frontend/src/**/*.tsx",
    "**/PWA/**/*.ts",
    "**/PWA/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts", "**/*.spec.ts"]
}
