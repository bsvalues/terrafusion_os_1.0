{
  "name": "self-modifying-architecture",
  "version": "1.0.0",
  "description": "🧬 Self-Modifying Architecture - AI system that autonomously redesigns its own code architecture for Phase 4B transcendent evolution",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "evolve:architecture": "ts-node src/evolution/architecture-evolver.ts",
    "modify:core": "ts-node src/modification/core-modifier.ts",
    "optimize:performance": "ts-node src/optimization/performance-optimizer.ts",
    "redesign:system": "ts-node src/redesign/system-redesigner.ts",
    "validate:evolution": "ts-node src/validation/evolution-validator.ts",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:security": "jest tests/security.test.js",
    "test:performance": "jest tests/performance.test.js"
  },
  "keywords": [
    "self-modifying-architecture",
    "autonomous-evolution",
    "ai-transcendence",
    "system-redesign",
    "code-evolution",
    "architecture-optimization",
    "self-improvement",
    "transcendent-ai",
    "phase-4b",
    "terrafusion-os"
  ],
  "author": "TerraFusion OS Team",
  "license": "MIT",
  "dependencies": {
    "@babel/core": "^7.23.6",
    "@babel/parser": "^7.23.6",
    "@babel/traverse": "^7.23.6",
    "@babel/types": "^7.23.6",
    "@babel/generator": "^7.23.6",
    "typescript": "^5.3.3",
    "ts-morph": "^21.0.1",
    "esprima": "^4.0.1",
    "escodegen": "^2.1.0",
    "acorn": "^8.11.3",
    "recast": "^0.23.4",
    "jscodeshift": "^0.15.1",
    "@typescript-eslint/parser": "^6.17.0",
    "@typescript-eslint/typescript-estree": "^6.17.0",
    "prettier": "^3.1.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "uuid": "^9.0.1",
    "chokidar": "^3.5.3",
    "fs-extra": "^11.2.0",
    "path": "^0.12.7",
    "child_process": "^1.0.2",
    "crypto": "^1.0.1",
    "vm2": "^3.9.19",
    "isolated-vm": "^4.7.2",
    "worker_threads": "^1.0.0",
    "cluster": "^0.7.7",
    "performance-hooks": "^1.0.0",
    "v8": "^0.1.0",
    "redis": "^4.6.11",
    "mongodb": "^6.3.0",
    "elasticsearch": "^16.7.3",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.14.202",
    "@types/uuid": "^9.0.7",
    "@types/fs-extra": "^11.0.4",
    "@types/babel__core": "^7.20.5",
    "@types/babel__parser": "^7.1.1",
    "@types/babel__traverse": "^7.20.5",
    "@types/babel__types": "^7.20.5",
    "@types/babel__generator": "^7.6.8",
    "@types/esprima": "^4.0.6",
    "@types/escodegen": "^0.0.10",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "@jest/globals": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "supertest": "^6.0.0",
    "nyc": "^15.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/explicit-function-return-type": "warn",
      "@typescript-eslint/no-explicit-any": "warn"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/self-modifying-architecture"
  },
  "bugs": {
    "url": "https://github.com/terrafusion/self-modifying-architecture/issues"
  },
  "homepage": "https://github.com/terrafusion/self-modifying-architecture#readme"
}