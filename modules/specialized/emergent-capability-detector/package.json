{
  "name": "emergent-capability-detector",
  "version": "1.0.0",
  "description": "🌟 Emergent Capability Detector - AI system that identifies and catalyzes unprogrammed capabilities for Phase 4B transcendent evolution",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "detect:capabilities": "ts-node src/detection/capability-detector.ts",
    "analyze:emergence": "ts-node src/analysis/emergence-analyzer.ts",
    "catalog:abilities": "ts-node src/catalog/ability-cataloger.ts",
    "foster:development": "ts-node src/fostering/capability-fosterer.ts",
    "validate:emergent": "ts-node src/validation/emergent-validator.ts",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:security": "jest tests/security.test.js",
    "test:performance": "jest tests/performance.test.js",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:install": "cd mcp-server && npm install"
  },
  "keywords": [
    "emergent-capabilities",
    "unprogrammed-abilities",
    "ai-transcendence",
    "capability-detection",
    "emergence-analysis",
    "spontaneous-skills",
    "transcendent-ai",
    "phase-4b",
    "terrafusion-os"
  ],
  "author": "TerraFusion OS Team",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs": "^4.15.0",
    "@tensorflow/tfjs-node": "^4.15.0",
    "natural": "^6.11.0",
    "compromise": "^14.10.0",
    "brain.js": "^2.0.0",
    "ml-matrix": "^6.10.8",
    "ml-regression": "^5.0.0",
    "opencv4nodejs": "^5.6.0",
    "clustering-algorithms": "^1.0.0",
    "anomaly-detection": "^2.1.0",
    "pattern-recognition": "^3.0.0",
    "behavior-analysis": "^1.5.0",
    "capability-mapping": "^2.2.0",
    "emergence-metrics": "^1.8.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "uuid": "^9.0.1",
    "chokidar": "^3.5.3",
    "fs-extra": "^11.2.0",
    "redis": "^4.6.11",
    "mongodb": "^6.3.0",
    "elasticsearch": "^16.7.3",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.14.202",
    "@types/uuid": "^9.0.7",
    "@types/fs-extra": "^11.0.4",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.2",
    "@jest/globals": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "supertest": "^6.0.0",
    "nyc": "^15.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/explicit-function-return-type": "warn",
      "@typescript-eslint/no-explicit-any": "warn"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/emergent-capability-detector"
  },
  "bugs": {
    "url": "https://github.com/terrafusion/emergent-capability-detector/issues"
  },
  "homepage": "https://github.com/terrafusion/emergent-capability-detector#readme",
  "mcp": {
    "server": "./mcp-server",
    "tools": [
      "quantum-interface",
      "experimental-executor",
      "research-coordinator",
      "ml-model-server",
      "prediction-interface"
    ],
    "capabilities": [
      "machine-learning-models"
    ]
  }
}