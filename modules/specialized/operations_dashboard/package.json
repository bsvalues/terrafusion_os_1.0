{
  "name": "@terrafusion/operations_dashboard",
  "version": "1.0.0",
  "description": "TerraFusion OS Module: operations_dashboard",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "Remove-Item -Recurse -Force dist, coverage -ErrorAction SilentlyContinue",
    "docs": "typedoc src/index.ts",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:install": "cd mcp-server && npm install"
  },
  "keywords": [
    "terrafusion",
    "government",
    "ai",
    "operations_dashboard"
  ],
  "author": "TerraFusion OS Team",
  "license": "PROPRIETARY",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "typedoc": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bsvalues/terrafusion_os_1.0",
    "directory": "modules/operations_dashboard"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "mcp": {
    "server": "./mcp-server",
    "tools": [
      "quantum-interface",
      "experimental-executor",
      "research-coordinator"
    ],
    "capabilities": []
  }
}