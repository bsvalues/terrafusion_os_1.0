{
  "name": "plugins-beyond-plugins-mcp-server",
  "description": "MCP Server for plugins-beyond-plugins",
  "version": "1.0.0",
  "category": "infrastructure",
  "capabilities": [],
  "tools": [
    "build-executor",
    "deployment-manager",
    "monitoring-interface"
  ],
  "integration": {
    "terrafusionOS": true,
    "aiSwarm": true,
    "government": false
  },
  "transport": {
    "type": "stdio"
  },
