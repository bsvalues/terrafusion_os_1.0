{
  "name": "@terrafusion/development",
  "version": "1.0.0",
  "description": "Development tools and utilities for Terrafusion OS including DevOps automation and testing frameworks",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm:watch:*\"",
    "start": "npm run dev",
    "build": "npm run build:all",
    "build:all": "npm run build:modules && npm run build:tools",
    "build:modules": "echo 'Building development modules...'",
    "build:tools": "echo 'Building development tools...'",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "format": "prettier --write .",
    "validate": "npm run lint && npm run test",
    "watch:modules": "nodemon --watch modules --exec 'npm run build:modules'",
    "watch:tools": "nodemon --watch tools --exec 'npm run build:tools'",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:install": "cd mcp-server && npm install"
  },
  "dependencies": {
    "express": "^4.18.0",
    "lodash": "^4.17.21",
    "fs-extra": "^11.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "jest": "^29.0.0",
    "playwright": "^1.40.0",
    "nodemon": "^3.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "development",
    "tools",
    "devops",
    "government",
    "automation",
    "terrafusion"
  ],
  "author": "Terrafusion OS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/terrafusion-os"
  },
  "terrafusion": {
    "module": true,
    "category": "development",
    "development-tools": true,
    "devops-enabled": true
  },
  "mcp": {
    "server": "./mcp-server",
    "tools": [
      "build-executor",
      "deployment-manager",
      "monitoring-interface"
    ],
    "capabilities": [
      "api-server"
    ]
  }
}