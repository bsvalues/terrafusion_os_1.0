{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": false,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitThis": false
  },
  "include": [
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx",
    "consciousness-service/**/*.ts",
    "sdk/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "from D",
    "archive",
    "coverage",
    "dist",
    "obj",
    "TerraFusionDevelopment",
    "modules/shock-and-awe",
    "docs/enhancement-plans",
    "Brand_Assets",
    "deployment/advanced",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.config.*",
    "**/*broken*",
    "**/*experimental*",
    "tests",
    "scripts",
    "modules",
    "backend"
  ]
}
