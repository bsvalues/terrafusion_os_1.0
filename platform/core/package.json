{
  "name": "@terrafusion/platform-core",
  "version": "1.0.0",
  "description": "TerraFusion cOS Platform Core Services - Identity, Policy, and Orchestration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run build:assets",
    "build:assets": "cp -r src/assets dist/",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf dist coverage",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@kubernetes/client-node": "^0.20.0",
    "express": "^4.18.0",
    "helmet": "^7.1.0",
    "winston": "^3.11.0",
    "prom-client": "^15.0.0",
    "node-vault": "^0.10.0",
    "jsonwebtoken": "^9.0.0",
    "bcrypt": "^5.1.0",
    "zod": "^3.22.0",
    "redis": "^4.6.0",
    "pg": "^8.11.0",
    "amqplib": "^0.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "keywords": [
    "terrafusion",
    "platform",
    "core",
    "identity",
    "orchestration",
    "government",
    "kubernetes"
  ]
}