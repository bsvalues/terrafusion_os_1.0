import React from 'react';
import { Routes, Route } from 'react-router-dom';
import styled from 'styled-components';
import { motion } from 'framer-motion';

import { 
  TFHeader, 
  TFCard, 
  TFButton,
  TerraFusionBrand
} from '../../packages/shared/src/components/BrandComponents';

import { Dashboard } from './pages/Dashboard';
import { Services } from './pages/Services';
import { Analytics } from './pages/Analytics';
import { Settings } from './pages/Settings';
import AdvancedDashboard from './components/AdvancedDashboard';

const AppContainer = styled.div`
  min-height: 100vh;
  background: ${TerraFusionBrand.COLORS.gradients.dark};
  font-family: ${TerraFusionBrand.TYPOGRAPHY.fonts.primary};
`;

const MainContent = styled(motion.main)`
  padding: 2rem;
  max-width: 1200px;
  margin: 0 auto;
`;

const Hero = styled(motion.section)`
  text-align: center;
  padding: 4rem 2rem;
  background: ${TerraFusionBrand.COLORS.gradients.hero};
  color: white;
  margin-bottom: 2rem;
  border-radius: 12px;
  position: relative;
  overflow: hidden;
  
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    z-index: 1;
  }
  
  > * {
    position: relative;
    z-index: 2;
  }
`;

const Title = styled(motion.h1)`
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 1rem;
  background: linear-gradient(45deg, #ffffff, #e0e7ff);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
`;

const Subtitle = styled(motion.p)`
  font-size: 1.5rem;
  margin-bottom: 2rem;
  opacity: 0.9;
`;

const QuickActions = styled(motion.div)`
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
  margin-top: 2rem;
`;

export const App: React.FC = () => {
  return (
    <AppContainer>
      <TFHeader 
        showMetrics={true}
      />
      
      <MainContent
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.6 }}
      >
        <Routes>
          <Route path="/" element={<HomePage />} />
          <Route path="/dashboard" element={<Dashboard />} />
          <Route path="/advanced" element={<AdvancedDashboard />} />
          <Route path="/services" element={<Services />} />
          <Route path="/analytics" element={<Analytics />} />
          <Route path="/settings" element={<Settings />} />
        </Routes>
      </MainContent>
    </AppContainer>
  );
};

const HomePage: React.FC = () => {
  return (
    <>
      <Hero
        initial={{ opacity: 0, scale: 0.95 }}
        animate={{ opacity: 1, scale: 1 }}
        transition={{ duration: 0.8 }}
      >
        <Title
          initial={{ opacity: 0, y: -20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.2 }}
        >
          TerraFusion OS
        </Title>
        <Subtitle
          initial={{ opacity: 0, y: -10 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.4 }}
        >
          Government. Transcended.
        </Subtitle>
        <motion.div
          initial={{ opacity: 0, y: 10 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.6 }}
        >
          <TFButton variant="primary" size="lg">
            Access Government Services
          </TFButton>
        </motion.div>
      </Hero>

      <QuickActions
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        transition={{ duration: 0.6, delay: 0.8 }}
      >
        <TFCard>
          <h3>🏛️ Government Services</h3>
          <p>Access property records, tax information, and citizen services</p>
          <TFButton variant="primary">
            View Services
          </TFButton>
        </TFCard>

        <TFCard>
          <h3>📊 System Dashboard</h3>
          <p>Monitor system health, performance metrics, and service status</p>
          <TFButton variant="secondary">
            View Dashboard
          </TFButton>
        </TFCard>

        <TFCard>
          <h3>🚀 Advanced Dashboard</h3>
          <p>Real-time TerraFusion OS monitoring with live API testing</p>
          <TFButton variant="transcend">
            Advanced View
          </TFButton>
        </TFCard>

        <TFCard>
          <h3>🔍 Analytics</h3>
          <p>Government analytics, insights, and data visualization</p>
          <TFButton variant="primary">
            View Analytics
          </TFButton>
        </TFCard>

        <TFCard>
          <h3>⚙️ System Settings</h3>
          <p>Configure system settings, user preferences, and integrations</p>
          <TFButton variant="primary">
            Open Settings
          </TFButton>
        </TFCard>
      </QuickActions>
    </>
  );
};
