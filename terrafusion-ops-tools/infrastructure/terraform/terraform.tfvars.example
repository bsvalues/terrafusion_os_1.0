# TerraFusion Infrastructure Configuration Example
# Copy this file to terraform.tfvars and customize for your environment

# Project Configuration
project_name = "terrafusion"
environment  = "production"  # Options: development, staging, production
aws_region   = "us-west-2"   # Primary AWS region
vpc_cidr     = "10.0.0.0/16" # VPC CIDR block

# Database Configuration
db_instance_class              = "db.r6g.xlarge"  # RDS instance type
db_allocated_storage           = 1000             # Initial storage in GB
db_backup_retention_period     = 30              # Backup retention in days
db_multi_az                   = true             # Enable Multi-AZ for HA
db_performance_insights_enabled = true           # Enable Performance Insights

# EKS Cluster Configuration
eks_cluster_version     = "1.28"                # Kubernetes version
eks_node_instance_types = ["m6i.xlarge"]        # EC2 instance types for nodes
eks_node_desired_capacity = 5                   # Desired number of nodes
eks_node_max_capacity    = 10                   # Maximum number of nodes
eks_node_min_capacity    = 3                    # Minimum number of nodes

# Redis Configuration
redis_node_type               = "cache.r7g.large" # ElastiCache node type
redis_num_cache_clusters      = 3                # Number of cache nodes
redis_snapshot_retention_limit = 7               # Snapshot retention in days

# Security Configuration
enable_deletion_protection   = true  # Protect critical resources from deletion
enable_encryption_at_rest   = true  # Enable encryption for all data at rest
enable_encryption_in_transit = true  # Enable encryption for data in transit
enable_enhanced_monitoring  = true  # Enable detailed monitoring

# CloudWatch Configuration
cloudwatch_log_retention_days = 30   # Log retention period
enable_cloudwatch_insights   = true  # Enable Container Insights

# S3 Configuration
s3_versioning_enabled         = true # Enable object versioning
s3_lifecycle_transition_days  = 30   # Days before transitioning to IA
s3_backup_retention_years     = 7    # Backup retention in years

# Network Configuration
enable_nat_gateway    = true  # Enable NAT Gateway for private subnets
single_nat_gateway    = false # Use one NAT Gateway per AZ for HA
enable_vpc_flow_logs  = true  # Enable VPC Flow Logs
enable_dns_hostnames  = true  # Enable DNS hostnames
enable_dns_support    = true  # Enable DNS support

# Load Balancer Configuration
alb_enable_deletion_protection = true  # Protect ALB from deletion
alb_enable_access_logs        = true  # Enable ALB access logs
alb_idle_timeout             = 60    # ALB idle timeout in seconds

# Domain and SSL Configuration (optional)
# domain_name      = "terrafusion.example.com"
# certificate_arn  = "arn:aws:acm:us-west-2:123456789012:certificate/12345678-1234-1234-1234-123456789012"
enable_http_redirect = true  # Redirect HTTP to HTTPS

# Backup Configuration
backup_schedule_expression = "cron(0 2 * * ? *)"  # Daily at 2 AM UTC
backup_delete_after_days  = 30                    # Delete backups after 30 days

# Monitoring and Alerting Configuration
enable_detailed_monitoring      = true                        # Enable detailed monitoring
sns_notifications_email        = "alerts@example.com"        # Email for alerts
cpu_utilization_threshold      = 80                          # CPU alert threshold (%)
memory_utilization_threshold   = 85                          # Memory alert threshold (%)

# Cost Management Configuration
enable_cost_anomaly_detection     = true  # Enable cost anomaly detection
cost_budget_limit                 = 5000  # Monthly budget limit in USD
cost_budget_threshold_percentage  = 80    # Budget alert threshold (%)

# Disaster Recovery Configuration
enable_cross_region_backup = true        # Enable cross-region backups
backup_region             = "us-east-1"  # Backup region for DR

# Auto Scaling Configuration
enable_auto_scaling        = true  # Enable auto scaling
auto_scaling_target_cpu    = 70    # Target CPU for scaling (%)
auto_scaling_target_memory = 75    # Target memory for scaling (%)

# Feature Flags
enable_spot_instances      = false # Use spot instances for cost savings
enable_graviton_instances  = true  # Use ARM-based Graviton instances
enable_container_insights  = true  # Enable CloudWatch Container Insights
enable_service_mesh       = false # Enable service mesh

# Development and Testing Features
enable_development_tools  = false # Enable dev/debug tools
enable_load_testing      = false # Enable load testing infrastructure
enable_canary_deployments = true  # Enable canary deployments

# Compliance and Security Features
enable_compliance_monitoring = true  # Enable AWS Config compliance
enable_security_hub         = true  # Enable AWS Security Hub
enable_guardduty           = true  # Enable GuardDuty threat detection
enable_waf                 = true  # Enable AWS WAF

# Resource Tagging
additional_tags = {
  "CostCenter"    = "Engineering"
  "Department"    = "Technology"
  "Application"   = "TerraFusion"
  "BusinessUnit"  = "Product"
  "Compliance"    = "SOC2"
}

cost_center     = "ENG-001"
owner          = "DevOps Team"
contact_email  = "devops@example.com"

# Environment-Specific Overrides
# Uncomment and modify based on your environment

# Development Environment
# environment                    = "development"
# db_instance_class             = "db.r6g.large"
# db_allocated_storage          = 200
# db_backup_retention_period    = 7
# db_multi_az                   = false
# eks_node_desired_capacity     = 3
# eks_node_max_capacity         = 5
# eks_node_min_capacity         = 2
# redis_node_type              = "cache.r7g.medium"
# redis_num_cache_clusters     = 2
# single_nat_gateway           = true
# enable_deletion_protection   = false
# cloudwatch_log_retention_days = 7
# cost_budget_limit            = 1000

# Staging Environment
# environment                    = "staging"
# db_instance_class             = "db.r6g.large"
# db_allocated_storage          = 500
# db_backup_retention_period    = 14
# db_multi_az                   = false
# eks_node_desired_capacity     = 3
# eks_node_max_capacity         = 8
# eks_node_min_capacity         = 2
# redis_node_type              = "cache.r7g.medium"
# redis_num_cache_clusters     = 2
# enable_deletion_protection   = false
# cloudwatch_log_retention_days = 14
# cost_budget_limit            = 2000

# High Availability Production Settings
# db_multi_az                  = true
# redis_num_cache_clusters     = 5
# eks_node_min_capacity        = 5
# eks_node_desired_capacity    = 8
# eks_node_max_capacity        = 20
# enable_cross_region_backup   = true
# backup_delete_after_days     = 90

# Cost Optimization Settings
# enable_spot_instances        = true
# enable_graviton_instances    = true
# single_nat_gateway           = true
# cloudwatch_log_retention_days = 14
# s3_lifecycle_transition_days = 7

# Security Hardening Settings
# enable_waf                   = true
# enable_guardduty             = true
# enable_security_hub          = true
# enable_compliance_monitoring = true
# enable_encryption_at_rest    = true
# enable_encryption_in_transit = true