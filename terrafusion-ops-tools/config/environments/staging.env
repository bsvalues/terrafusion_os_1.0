# TerraFusion Staging Environment Configuration
# This file contains environment-specific settings for the staging environment

# Environment Information
ENVIRONMENT=staging
PROJECT_NAME=terrafusion
AWS_REGION=us-west-2
DEPLOYMENT_STAGE=staging

# Database Configuration
DATABASE_HOST=terrafusion-staging-postgres.cluster-xyz.us-west-2.rds.amazonaws.com
DATABASE_PORT=\${{TF_POSTGRES_PORT:-5432}}
DATABASE_NAME=terrafusion_staging
DATABASE_USER=terrafusion_staging_user
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=30
DATABASE_LOG_QUERIES=false

# Redis Configuration
REDIS_HOST=terrafusion-staging-redis.abc123.cache.amazonaws.com
REDIS_PORT=\${{TF_POSTGRES_PORT:-5432}}
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_TIMEOUT=5
REDIS_SSL=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=\${{TF_POSTGRES_PORT:-5432}}
API_WORKERS=4
API_DEBUG=false
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=https://staging.terrafusion.com,https://staging-admin.terrafusion.com
API_RATE_LIMIT=5000
API_RATE_LIMIT_WINDOW=3600

# AI Engine Configuration
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=\${{TF_POSTGRES_PORT:-5432}}
AI_ENGINE_WORKERS=2
AI_ENGINE_DEBUG=false
AI_ENGINE_MODEL_CACHE_SIZE=1024
AI_ENGINE_PREDICTION_TIMEOUT=45
AI_ENGINE_LOG_LEVEL=INFO

# Frontend Configuration
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=\${{TF_POSTGRES_PORT:-5432}}
FRONTEND_API_URL=https://staging-api.terrafusion.com
FRONTEND_WS_URL=wss://staging-api.terrafusion.com
FRONTEND_DEBUG=false
FRONTEND_HOT_RELOAD=false

# Authentication Configuration
JWT_SECRET_KEY=staging-jwt-secret-from-ssm
JWT_EXPIRATION=86400
JWT_ALGORITHM=HS256
SESSION_TIMEOUT=7200
PASSWORD_MIN_LENGTH=8
ENABLE_2FA=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/terrafusion/app.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=14
ENABLE_STRUCTURED_LOGGING=true

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=\${{TF_POSTGRES_PORT:-5432}}
METRICS_PATH=/metrics
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_INTERVAL=30
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://jaeger-collector:14268/api/traces

# Storage Configuration
FILE_UPLOAD_MAX_SIZE=100MB
FILE_UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,csv,xlsx,zip
FILE_STORAGE_BACKEND=s3
FILE_STORAGE_PATH=/tmp/terrafusion/uploads
S3_BUCKET_NAME=terrafusion-staging-assets
S3_REGION=us-west-2

# Email Configuration
EMAIL_BACKEND=ses
SMTP_HOST=email-smtp.us-west-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=staging-smtp-user
SMTP_PASSWORD=staging-smtp-password-from-ssm
SMTP_TLS=true
EMAIL_FROM=noreply@staging.terrafusion.com
EMAIL_ADMIN=admin@staging.terrafusion.com

# Cache Configuration
CACHE_BACKEND=redis
CACHE_DEFAULT_TIMEOUT=600
CACHE_KEY_PREFIX=terrafusion:staging
ENABLE_CACHE_COMPRESSION=true
CACHE_MAX_ENTRIES=50000

# Security Configuration
SECURITY_LEVEL=medium
ENABLE_CSRF_PROTECTION=true
ENABLE_XSS_PROTECTION=true
ENABLE_CONTENT_TYPE_SNIFFING=false
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
ENABLE_RATE_LIMITING=true
FAILED_LOGIN_ATTEMPTS_LIMIT=5
ACCOUNT_LOCKOUT_DURATION=600

# Development Tools (disabled in staging)
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILER=false
ENABLE_QUERY_LOGGING=false
ENABLE_MOCK_SERVICES=false
MOCK_AI_RESPONSES=false
ENABLE_FIXTURES=false

# Feature Flags
FEATURE_NEW_DASHBOARD=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_EXPORT_FUNCTIONALITY=true
FEATURE_BETA_FEATURES=true
FEATURE_EXPERIMENTAL_UI=false

# Testing Configuration
ENABLE_TEST_MODE=false
TEST_DATABASE_NAME=terrafusion_staging_test
TEST_REDIS_DB=1
LOAD_TEST_DATA=false
ENABLE_MOCK_PAYMENTS=true

# Performance Configuration
ENABLE_GZIP_COMPRESSION=true
STATIC_FILE_CACHING=true
API_RESPONSE_CACHING=true
DATABASE_QUERY_CACHING=true
ASYNC_TASK_QUEUE=celery
CELERY_BROKER_URL=redis://terrafusion-staging-redis.abc123.cache.amazonaws.com:6379/2

# Production-like Features
AUTO_RELOAD=false
HOT_MODULE_REPLACEMENT=false
SOURCE_MAPS=false
MINIFY_ASSETS=true
BUNDLE_ANALYZER=false
DEV_SERVER_PROXY=false

# Container Configuration
CONTAINER_MEMORY_LIMIT=1Gi
CONTAINER_CPU_LIMIT=1000m
CONTAINER_MEMORY_REQUEST=512Mi
CONTAINER_CPU_REQUEST=500m

# Kubernetes Configuration
K8S_NAMESPACE=terrafusion-staging
K8S_CONTEXT=staging-cluster
K8S_SERVICE_TYPE=ClusterIP
K8S_INGRESS_CLASS=alb
HELM_CHART_VERSION=1.0.0-staging

# External Services Configuration
WEATHER_API_KEY=staging-weather-api-key-from-ssm
MAPS_API_KEY=staging-maps-api-key-from-ssm
ANALYTICS_API_KEY=staging-analytics-api-key-from-ssm
PAYMENT_GATEWAY_URL=https://staging.payment.example.com
NOTIFICATION_SERVICE_URL=https://staging-notifications.terrafusion.com

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=terrafusion-staging-backups
BACKUP_ENCRYPTION=true

# Compliance Configuration
GDPR_COMPLIANCE=true
DATA_RETENTION_DAYS=365
AUDIT_LOGGING=true
ENCRYPTION_AT_REST=true
ENCRYPTION_IN_TRANSIT=true

# Resource Limits
MAX_REQUEST_SIZE=500MB
MAX_CONCURRENT_REQUESTS=500
CONNECTION_POOL_SIZE=25
WORKER_MEMORY_LIMIT=1024MB
WORKER_CPU_LIMIT=2.0

# Staging URLs
API_BASE_URL=https://staging-api.terrafusion.com/api/v1
FRONTEND_BASE_URL=https://staging.terrafusion.com
ADMIN_PANEL_URL=https://staging-admin.terrafusion.com
DOCS_URL=https://staging-api.terrafusion.com/docs
SWAGGER_URL=https://staging-api.terrafusion.com/swagger

# Load Balancer Configuration
ALB_SCHEME=internet-facing
ALB_SUBNETS=subnet-staging-1,subnet-staging-2,subnet-staging-3
ALB_SECURITY_GROUPS=sg-staging-alb
ALB_CERTIFICATE_ARN=arn:aws:acm:us-west-2:account:certificate/staging-cert-id

# Auto Scaling Configuration
AUTO_SCALING_ENABLED=true
MIN_REPLICAS=2
MAX_REPLICAS=8
TARGET_CPU_UTILIZATION=70
TARGET_MEMORY_UTILIZATION=75
SCALE_UP_COOLDOWN=300
SCALE_DOWN_COOLDOWN=600

# Monitoring and Alerting
CLOUDWATCH_LOG_GROUP=/aws/ecs/terrafusion-staging
CLOUDWATCH_LOG_STREAM=app
PROMETHEUS_NAMESPACE=terrafusion-staging
GRAFANA_DASHBOARD_ID=staging-dashboard
ALERT_MANAGER_URL=https://staging-alerts.terrafusion.com

# Database Performance
DATABASE_MAX_CONNECTIONS=100
DATABASE_STATEMENT_TIMEOUT=60000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT=30000
DATABASE_SHARED_BUFFERS=256MB
DATABASE_EFFECTIVE_CACHE_SIZE=1GB

# Redis Performance
REDIS_MAX_MEMORY=512mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_TIMEOUT=30
REDIS_TCP_KEEPALIVE=60

# CDN Configuration
CDN_ENABLED=true
CDN_DOMAIN=cdn-staging.terrafusion.com
CDN_CACHE_POLICY=staging-cache-policy
STATIC_FILES_CDN=true
API_RESPONSES_CDN=false

# SSL/TLS Configuration
TLS_VERSION=1.2
SSL_CIPHERS=ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:DHE+CHACHA20:!aNULL:!MD5:!DSS
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# Error Handling
ERROR_TRACKING_DSN=https://staging-sentry-dsn@sentry.io/project
ERROR_TRACKING_ENVIRONMENT=staging
ERROR_SAMPLE_RATE=0.1
ENABLE_ERROR_NOTIFICATIONS=true
ERROR_NOTIFICATION_SLACK=https://hooks.slack.com/staging-webhook

# Data Pipeline Configuration
ETL_SCHEDULE=0 4 * * *
DATA_WAREHOUSE_URL=staging-redshift.cluster.amazonaws.com
DATA_EXPORT_S3_BUCKET=terrafusion-staging-exports
ANALYTICS_PROCESSING_ENABLED=true

# Third-party Integrations
STRIPE_PUBLISHABLE_KEY=pk_test_staging_key
STRIPE_SECRET_KEY=sk_test_staging_key_from_ssm
SENDGRID_API_KEY=staging-sendgrid-key-from-ssm
TWILLIO_ACCOUNT_SID=staging-twilio-sid-from-ssm
GOOGLE_ANALYTICS_ID=GA-STAGING-123456

# Version Information
APP_VERSION=1.0.0-staging
BUILD_NUMBER=${BUILD_NUMBER:-unknown}
GIT_COMMIT=${GIT_COMMIT:-unknown}
BUILD_DATE=${BUILD_DATE:-unknown}

# Health Check Configuration
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_TIMEOUT=10
READINESS_PROBE_PATH=/ready
LIVENESS_PROBE_PATH=/alive
STARTUP_PROBE_PATH=/startup

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30
GRACEFUL_SHUTDOWN_ENABLED=true
DRAIN_CONNECTIONS_TIMEOUT=20

# Regional Configuration
PRIMARY_REGION=us-west-2
BACKUP_REGION=us-east-1
MULTI_REGION_ENABLED=false
CROSS_REGION_REPLICATION=true

# Environment-specific Secrets (loaded from AWS Systems Manager)
# These values reference SSM parameters and will be resolved at runtime
DATABASE_URL=ssm:///terrafusion/staging/database/url
REDIS_URL=ssm:///terrafusion/staging/redis/url
SECRET_KEY=ssm:///terrafusion/staging/app/secret_key
JWT_SECRET=ssm:///terrafusion/staging/jwt/secret
STRIPE_SECRET=ssm:///terrafusion/staging/stripe/secret_key