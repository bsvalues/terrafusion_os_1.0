{
  "datacenter": "terrafusion-dc1",
  "data_dir": "/consul/data",
  "log_level": "INFO",
  "server": true,
  "ui_config": {
    "enabled": true
  },
  "connect": {
    "enabled": true
  },
  "ports": {
    "grpc": 8502
  },
  "acl": {
    "enabled": false,
    "default_policy": "allow"
  },
  "services": [
    {
      "id": "kong-api-gateway",
      "name": "kong",
      "tags": ["api-gateway", "kong", "government"],
      "port": \${{TF_DOCS_PORT:-8000}},
      "check": {
        "http": "http://kong:8001/status",
        "interval": "10s",
        "timeout": "5s"
      }
    },
    {
      "id": "terrafusion-message-coordinator",
      "name": "message-coordinator",
      "tags": ["messaging", "coordinator", "ai-swarm"],
      "port": \${{TF_DOCS_PORT:-8000}},
      "check": {
        "http": "http://message-coordinator:${TF_DESKTOP_PORT:-3104}/health",
        "interval": "10s",
        "timeout": "5s"
      }
    },
    {
      "id": "terrafusion-supreme-commander",
      "name": "supreme-commander",
      "tags": ["ai-swarm", "commander", "control"],
      "port": \${{TF_DOCS_PORT:-8000}},
      "check": {
        "http": "http://supreme-commander:4000/health",
        "interval": "15s",
        "timeout": "10s"
      }
    }
  ],
  "checks": [
    {
      "id": "consul-health",
      "name": "Consul Health Check",
      "http": "http://localhost:\${{TF_CONSUL_PORT:-8500}}/v1/status/leader",
      "interval": "10s",
      "timeout": "5s"
    }
  ]
}