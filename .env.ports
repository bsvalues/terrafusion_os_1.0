# TerraFusion OS - Elite Dynamic Port Management System
# MIT PhD-level Systems Engineering for Government Operating System

# ============================================================================
# DYNAMIC PORT ENVIRONMENT CONFIGURATION
# All TerraFusion OS services use environment variables for port assignment
# with intelligent fallback defaults for seamless operation
# ============================================================================

# Core OS Services (Primary Layer)
TF_API_PORT=${TF_API_PORT:-5050}                    # .NET 8.0 API Gateway
TF_API_HTTPS_PORT=${TF_API_HTTPS_PORT:-5047}        # .NET 8.0 API Gateway HTTPS
TF_SHELL_PORT=${TF_SHELL_PORT:-3103}                # Experience Suite v5 PWA Shell
TF_CONSCIOUSNESS_PORT=${TF_CONSCIOUSNESS_PORT:-3104} # Consciousness Service
TF_SHELL_HTTPS_PORT=${TF_SHELL_HTTPS_PORT:-3105}    # Experience Suite v5 HTTPS
TF_ENHANCEMENT_PORT=${TF_ENHANCEMENT_PORT:-3106}    # Enhancement Orchestration Service
# Elite Rust Performance Engine (6-Crate Architecture)
TF_RUST_MAIN_PORT=${TF_RUST_MAIN_PORT:-8100}        # Main Rust Engine Coordinator
TF_RUST_AGENT_PORT=${TF_RUST_AGENT_PORT:-8101}      # Agent Coordination Engine
TF_RUST_GEOSPATIAL_PORT=${TF_RUST_GEOSPATIAL_PORT:-8102}  # Geospatial Engine
TF_RUST_VALUATION_PORT=${TF_RUST_VALUATION_PORT:-8103}    # Valuation Kernel
TF_RUST_SECURITY_PORT=${TF_RUST_SECURITY_PORT:-8104}      # Security Layer
TF_RUST_PERFORMANCE_PORT=${TF_RUST_PERFORMANCE_PORT:-8105} # Performance Monitor
TF_RUST_FFI_PORT=${TF_RUST_FFI_PORT:-8106}          # FFI Bridge

# AI Swarm Coordination (50,000+ Agents)
TF_AI_COMMANDER_PORT=${TF_AI_COMMANDER_PORT:-9000}   # Supreme Commander Claude
TF_AI_GENERAL_PORT=${TF_AI_GENERAL_PORT:-9001}       # Field Generals (1,220 agents)
TF_AI_OPERATIONAL_PORT=${TF_AI_OPERATIONAL_PORT:-9002} # Operational Forces (48,779 agents)
TF_AI_SWARM_METRICS_PORT=${TF_AI_SWARM_METRICS_PORT:-9003} # Swarm Metrics
TF_AI_COORDINATION_PORT=${TF_AI_COORDINATION_PORT:-9004}   # Agent Coordination

# Infrastructure Services (Dynamic Defaults)
TF_DATABASE_PORT=${TF_DATABASE_PORT:-5432}           # PostgreSQL Primary
TF_REDIS_PORT=${TF_REDIS_PORT:-6379}                 # Redis Cache
TF_CONSUL_PORT=${TF_CONSUL_PORT:-8500}               # Service Discovery
TF_KONG_PORT=${TF_KONG_PORT:-8000}                   # API Gateway
TF_KONG_ADMIN_PORT=${TF_KONG_ADMIN_PORT:-8001}       # Kong Admin
TF_RABBITMQ_PORT=${TF_RABBITMQ_PORT:-5672}           # Message Queue
TF_RABBITMQ_ADMIN_PORT=${TF_RABBITMQ_ADMIN_PORT:-15672} # RabbitMQ Admin

# Monitoring & Observability
TF_PROMETHEUS_PORT=${TF_PROMETHEUS_PORT:-9090}       # Prometheus Metrics
TF_GRAFANA_PORT=${TF_GRAFANA_PORT:-3000}             # Grafana Dashboards
TF_JAEGER_PORT=${TF_JAEGER_PORT:-16686}              # Distributed Tracing
TF_ELASTICSEARCH_PORT=${TF_ELASTICSEARCH_PORT:-9200} # Log Aggregation

# Government Module System (32+ Hot-Swappable Modules)
TF_MODULE_BASE_PORT=${TF_MODULE_BASE_PORT:-10000}    # Base port for modules
TF_MODULE_REGISTRY_PORT=${TF_MODULE_REGISTRY_PORT:-10001} # Module Registry
TF_MODULE_MARKETPLACE_PORT=${TF_MODULE_MARKETPLACE_PORT:-10002} # Marketplace

# Development & Testing
TF_DEV_SERVER_PORT=${TF_DEV_SERVER_PORT:-4000}       # Development Server
TF_TEST_PORT=${TF_TEST_PORT:-4001}                   # Test Server
TF_STORYBOOK_PORT=${TF_STORYBOOK_PORT:-6006}         # Component Development

# Security & Compliance
TF_VAULT_PORT=${TF_VAULT_PORT:-8200}                 # HashiCorp Vault
TF_KEYCLOAK_PORT=${TF_KEYCLOAK_PORT:-8080}           # Identity Management
TF_AUDIT_PORT=${TF_AUDIT_PORT:-7000}                 # Audit Logging

# Harris PACS Integration Ports (CAMA Vendor System for BENTON COUNTY)
TF_HARRIS_PACS_PORT=${TF_HARRIS_PACS_PORT:-8300}     # Harris PACS CAMA System Integration
TF_HARRIS_SYNC_PORT=${TF_HARRIS_SYNC_PORT:-8301}     # Real-time CAMA Data Sync Service
TF_HARRIS_GIS_PORT=${TF_HARRIS_GIS_PORT:-8302}       # CAMA GIS Data Integration

# County-specific configurations for BENTON COUNTY WASHINGTON
if [[ "${TF_COUNTY}" == "benton" ]] || [[ "${TF_COUNTY}" == "benton-county" ]] || [[ "${TF_COUNTY}" == "washington" ]]; then
    export TF_API_PORT=${TF_BENTON_API_PORT:-5046}
    export TF_SHELL_PORT=${TF_BENTON_SHELL_PORT:-3103}
    export TF_CAMA_PORT=${TF_BENTON_CAMA_PORT:-8300}
    echo "🏛️ Benton County Washington Configuration Loaded"
fi

# Harris PACS CAMA Vendor Configuration (NOT Harris County)
if [[ "${TF_CAMA_VENDOR}" == "harris-pacs" ]]; then
    export TF_HARRIS_PACS_PORT=${TF_HARRIS_PACS_PORT:-8300}
    export TF_HARRIS_SYNC_PORT=${TF_HARRIS_SYNC_PORT:-8301}
    export TF_HARRIS_GIS_PORT=${TF_HARRIS_GIS_PORT:-8302}
    echo "🔗 Harris PACS CAMA Vendor Integration Active"
fi

# Golden Ratio Engine (φ-governed Mathematics)
TF_GOLDEN_RATIO_PORT=${TF_GOLDEN_RATIO_PORT:-8700}   # Golden Ratio Engine
TF_GOLDEN_METRICS_PORT=${TF_GOLDEN_METRICS_PORT:-8701} # φ-based Metrics

# ============================================================================
# AUTOMATIC PORT DISCOVERY AND CONFLICT RESOLUTION
# ============================================================================

# Service Discovery URL Format
TF_SERVICE_DISCOVERY_URL="http://localhost:${TF_CONSUL_PORT}"

# Health Check URLs (All services expose /health endpoint)
TF_API_HEALTH_URL="http://localhost:${TF_API_PORT}/health"
TF_SHELL_HEALTH_URL="http://localhost:${TF_SHELL_PORT}/health"
TF_RUST_HEALTH_URL="http://localhost:${TF_RUST_MAIN_PORT}/health"

# ============================================================================
# EXPORT ALL ENVIRONMENT VARIABLES FOR SYSTEM-WIDE ACCESS
# ============================================================================

echo "✅ TerraFusion OS Dynamic Port Management System Initialized"
echo "🎯 API Gateway: localhost:${TF_API_PORT}"
echo "🖥️ Experience Suite Shell: localhost:${TF_SHELL_PORT}" 
echo "⚡ Rust Performance Engine: localhost:${TF_RUST_MAIN_PORT}"
echo "🤖 AI Swarm Commander: localhost:${TF_AI_COMMANDER_PORT}"
echo "🏛️ Government Operating System Ready"
TF_CONSUL_DNS_PORT=8600
TF_PROMETHEUS_PORT=9090
TF_ALERTMANAGER_PORT=9093
TF_DEBUG_PORT=9999
