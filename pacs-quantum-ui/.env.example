# TrueAutomation/PACS Quantum UI Environment Variables

# Backend API URL (leave empty for proxy to localhost:5000)
VITE_API_URL=

# Development Mode
VITE_DEV_MODE=true

# SignalR Hub URLs
VITE_QUANTUM_HUB_URL=/hubs/quantum-ai
VITE_SWARM_HUB_URL=/hubs/swarm

# Feature Flags
VITE_ENABLE_3D_VISUALIZATION=true
VITE_ENABLE_QUANTUM_OPTIMIZATION=true
VITE_ENABLE_REAL_TIME_UPDATES=true

# Analytics
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_KEY=
