{
  "datacenter": "terrafusion-dc",
  "domain": "terrafusion.local",
  "data_dir": "/consul/data",
  "log_level": "INFO",
  "server": true,
  "bootstrap_expect": 1,
  "ui_config": {
    "enabled": true
  },
  "client_addr": "0.0.0.0",
  "bind_addr": "0.0.0.0",
  "advertise_addr": "{{ GetInterfaceIP \"eth0\" }}",
  "ports": {
    "grpc": 8502,
    "http": 8500,
    "https": -1,
    "serf_lan": 8301,
    "serf_wan": 8302,
    "server": 8300,
    "dns": 8600
  },
  "connect": {
    "enabled": true,
    "enable_mesh_gateway_wan_federation": false
  },
  "acl": {
    "enabled": false,
    "default_policy": "allow",
    "enable_token_persistence": true
  },
  "performance": {
    "raft_multiplier": 1
  },
  "telemetry": {
    "prometheus_retention_time": "30s",
    "disable_hostname": true
  },
  "services": [
    {
      "id": "terrafusion-backend",
      "name": "terrafusion-backend",
      "tags": ["api", "backend", "terrafusion"],
      "port": \${{TF_ADMIN_PORT:-8080}},
      "check": {
        "http": "http://terrafusion-backend:${TF_STATIC_PORT:-8080}/health",
        "interval": "30s",
        "timeout": "10s"
      },
      "connect": {
        "sidecar_service": {
          "proxy": {
            "upstreams": [
              {
                "destination_name": "postgres",
                "local_bind_port": 5432
              },
              {
                "destination_name": "redis",
                "local_bind_port": 6379
              },
              {
                "destination_name": "trust-fabric",
                "local_bind_port": 7000
              }
            ]
          }
        }
      }
    },
    {
      "id": "terrafusion-frontend",
      "name": "terrafusion-frontend",
      "tags": ["frontend", "ui", "terrafusion"],
      "port": \${{TF_ADMIN_PORT:-8080}},
      "check": {
        "http": "http://terrafusion-frontend:${TF_FRONTEND_PORT:-3102}/health",
        "interval": "30s",
        "timeout": "10s"
      },
      "connect": {
        "sidecar_service": {
          "proxy": {
            "upstreams": [
              {
                "destination_name": "terrafusion-backend",
                "local_bind_port": 8080
              }
            ]
          }
        }
      }
    },
    {
      "id": "trust-fabric",
      "name": "trust-fabric",
      "tags": ["attestation", "security", "trust"],
      "port": \${{TF_ADMIN_PORT:-8080}},
      "check": {
        "http": "http://trust-fabric:7000/health",
        "interval": "30s",
        "timeout": "10s"
      },
      "connect": {
        "sidecar_service": {
          "proxy": {
            "upstreams": [
              {
                "destination_name": "spire-server",
                "local_bind_port": 8081
              },
              {
                "destination_name": "vault",
                "local_bind_port": 8200
              }
            ]
          }
        }
      }
    },
    {
      "id": "postgres",
      "name": "postgres",
      "tags": ["database", "postgres", "storage"],
      "port": \${{TF_ADMIN_PORT:-8080}},
      "check": {
        "tcp": "postgres:5432",
        "interval": "30s",
        "timeout": "10s"
      }
    },
    {
      "id": "redis",
      "name": "redis",
      "tags": ["cache", "redis", "session"],
      "port": \${{TF_ADMIN_PORT:-8080}},
      "check": {
        "tcp": "redis:6379",
        "interval": "30s",
        "timeout": "10s"
      }
    }
  ]
}
