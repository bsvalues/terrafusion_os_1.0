# TerraFusion OS Port Configuration
# This file standardizes ALL ports across the system to eliminate conflicts

# Core Services
TERRAFUSION_API_PORT=5041
TERRAFUSION_FRONTEND_PORT=8000
TERRAFUSION_DASHBOARD_PORT=3000

# Database Services  
POSTGRES_PORT=5432
REDIS_PORT=6379

# Monitoring
PROMETHEUS_PORT=9090

# Development
VITE_DEV_PORT=3000

# API URLs (derived from above)
VITE_API_URL=http://localhost:5041/api
REACT_APP_API_URL=http://localhost:5041

# Environment
NODE_ENV=development
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5041

# Instructions:
# 1. Source this file: source .env.ports
# 2. All services should use these environment variables
# 3. NO MORE HARDCODED PORTS!
