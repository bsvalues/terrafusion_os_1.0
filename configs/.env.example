# TerraFusion OS Environment Configuration
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control

# Database Configuration
DB_HOST=localhost
DB_NAME=terrafusion_production
DB_USER=terrafusion_user
DB_PASSWORD=your_secure_database_password_here

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_government_grade
JWT_ISSUER=TerraFusion-Production
JWT_AUDIENCE=TerraFusion-Government-Users
JWT_EXPIRATION_HOURS=8

# Security Configuration
ENCRYPTION_KEY=your_32_character_encryption_key_here
API_RATE_LIMIT_PER_MINUTE=100
API_RATE_LIMIT_BURST=200

# Redis Configuration (Optional)
REDIS_CONNECTION_STRING=localhost:6379

# Azure Key Vault (Production)
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# Government Compliance
GOVERNMENT_COMPLIANCE_LEVEL=FISMA-High
AUDIT_LOGGING_ENABLED=true
DATA_CLASSIFICATION=Sensitive

# AI Swarm Configuration
AI_SWARM_AGENTS=1008
QUANTUM_PERFORMANCE_ENABLED=true
PERFORMANCE_TARGET_MULTIPLIER=379000000

# Monitoring and Logging
SERILOG_MINIMUM_LEVEL=Information
LOG_FILE_PATH=/var/log/terrafusion/
MONITORING_ENDPOINT=https://monitoring.terrafusion.gov

# External Integration
FEDERAL_API_ENDPOINT=https://api.federal.gov
STATE_API_ENDPOINT=https://api.state.gov
COUNTY_API_ENDPOINT=https://api.county.gov

# Development Settings (Dev environment only)
DEVELOPMENT_MODE=false
SWAGGER_ENABLED=false
CORS_ALLOW_ALL=false