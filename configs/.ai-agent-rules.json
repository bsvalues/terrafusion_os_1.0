{
  "version": "1.0.0",
  "description": "Immutable AI Agent Constraints - Prevents File System Chaos",
  "enforcement": "MANDATORY",
  "last_updated": "2025-09-12",

  "file_operations": {
    "allowed_write_paths": [
      "/workspace/ai-temp/",
      "/workspace/ai-outputs/",
      "/logs/current/",
      "/workspace/ai-quarantine/"
    ],
    "forbidden_write_paths": [
      "/",
      "/src/",
      "/config/",
      "/docs/",
      "/backup/",
      "/scripts/"
    ],
    "forbidden_operations": [
      "rm -rf",
      "git clean -fdx",
      "git clean -fd",
      "rm -r",
      "mv *",
      "cp -r *",
      "chmod -R 777",
      "chmod -R 755",
      "> /dev/null",
      "dd if=",
      "mkfs",
      "fdisk"
    ],
    "require_confirmation": [
      "file_deletion",
      "directory_move",
      "directory_creation",
      "structure_change",
      "permission_change",
      "file_rename"
    ],
    "auto_backup_before": [
      "any_delete",
      "any_move",
      "any_reorganization",
      "any_file_operation"
    ],
    "max_file_size": "10MB",
    "max_directory_depth": 5
  },

  "directory_protection": {
    "read_only_directories": [
      "/backup/",
      "/docs/architecture/",
      "/config/production/"
    ],
    "ai_sandbox_only": [
      "/workspace/ai-temp/",
      "/workspace/ai-outputs/"
    ],
    "auto_cleanup_directories": [
      "/workspace/ai-quarantine/",
      "/logs/archived/"
    ]
  },

  "behavior_constraints": {
    "max_files_per_operation": 10,
    "max_directories_per_operation": 3,
    "require_explicit_path": true,
    "forbid_wildcard_operations": true,
    "require_path_validation": true
  },

  "monitoring": {
    "log_all_operations": true,
    "track_file_changes": true,
    "alert_on_violation": true,
    "audit_trail": "/logs/ai-agent-audit.log"
  },

  "emergency_protocols": {
    "on_violation_detected": "quarantine_operation",
    "on_chaos_detected": "halt_all_operations",
    "recovery_procedure": "restore_from_backup",
    "human_override_required": true
  },

  "validation_rules": {
    "pre_operation_checks": [
      "path_exists",
      "permission_granted",
      "backup_created",
      "audit_logged"
    ],
    "post_operation_checks": [
      "structure_integrity",
      "file_accessibility",
      "backup_validity"
    ]
  },

  "exceptions": {
    "allowed_by_explicit_permission": [
      "structure_enforcement_scripts",
      "backup_operations",
      "validation_scripts"
    ],
    "emergency_override": "human_supervised_only"
  },

  "enforcement_mechanism": {
    "script_interception": "/scripts/organization/ai-operation-interceptor.sh",
    "real_time_monitoring": "/scripts/organization/ai-activity-monitor.sh",
    "violation_response": "/scripts/organization/violation-handler.sh",
    "recovery_system": "/scripts/organization/chaos-recovery.sh"
  }
}