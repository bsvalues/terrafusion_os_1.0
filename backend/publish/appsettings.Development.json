{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=terrafusion-dev.db"
  },
  "JwtSettings": {
    "SecretKey": "${TF_DEV_JWT_SECRET}",
    "ExpirationMinutes": 120
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:3001",
    "http://localhost:5173",
    "http://localhost:5174",
    "http://localhost:8080"
  ],
  "Security": {
    "RequireHttps": false,
    "MaxRequestsPerMinute": 1000
  },
  "AIEngine": {
    "EnableGPUAcceleration": false,
    "DefaultTimeoutSeconds": 60
  }
}
