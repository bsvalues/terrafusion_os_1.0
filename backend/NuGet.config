<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Prevent cross-OS polluted fallback folders from breaking restore -->
  <fallbackPackageFolders>
  </fallbackPackageFolders>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
