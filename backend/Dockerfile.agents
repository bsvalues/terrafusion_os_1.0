# TFT-188: Dockerfile for TerraFusion AI Agent Service (Consciousness)
# Build: docker build -f Dockerfile.agents -t terrafusion-agents .
# Run:   docker run -p 3004:3004 terrafusion-agents

# ── Build stage ──────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy solution and project files for layer caching
COPY TerraFusion.sln ./
COPY Directory.Packages.props ./
COPY src/Directory.Build.targets src/
COPY src/TerraFusion.Consciousness/TerraFusion.Consciousness.csproj src/TerraFusion.Consciousness/
COPY src/TerraFusion.Core/TerraFusion.Core.csproj src/TerraFusion.Core/
COPY src/TerraFusion.Data/TerraFusion.Data.csproj src/TerraFusion.Data/
COPY src/TerraFusion.AI/TerraFusion.AI.csproj src/TerraFusion.AI/
COPY src/TerraFusion.Security/TerraFusion.Security.csproj src/TerraFusion.Security/
COPY src/TerraFusion.Abstractions/TerraFusion.Abstractions.csproj src/TerraFusion.Abstractions/
COPY src/TerraFusion.Operations/TerraFusion.Operations.csproj src/TerraFusion.Operations/
COPY src/TerraFusion.Levy/TerraFusion.Levy.csproj src/TerraFusion.Levy/
COPY src/TerraFusion.CostForge/TerraFusion.CostForge.csproj src/TerraFusion.CostForge/
COPY src/TerraFusion.Sync/TerraFusion.Sync.csproj src/TerraFusion.Sync/
COPY TerraFusion.Gateway/TerraFusion.Gateway.csproj TerraFusion.Gateway/

# Restore packages
RUN dotnet restore src/TerraFusion.Consciousness/TerraFusion.Consciousness.csproj --runtime linux-x64

# Copy all source code and publish
COPY . .

FROM build AS publish
WORKDIR /src/src/TerraFusion.Consciousness
RUN dotnet publish TerraFusion.Consciousness.csproj -c Release -o /app/publish \
    --self-contained false \
    --no-restore \
    /p:DebugType=None \
    /p:DebugSymbols=false

# ── Runtime stage ────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime

# Install curl for health checks
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Security: non-root user
RUN groupadd -r terrafusion && useradd -r -g terrafusion -s /sbin/nologin terrafusion

COPY --from=publish /app/publish .
RUN chown -R terrafusion:terrafusion /app

# Environment
ENV ASPNETCORE_URLS=http://+:3004
ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
ENV TZ=America/Los_Angeles

# AI Swarm configuration
ENV AI__SwarmEnabled=true
ENV AI__MaxAgents=1008
ENV AI__CoordinatorCount=8
ENV AI__FieldGeneralCount=48

EXPOSE 3004

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3004/health || exit 1

LABEL org.opencontainers.image.title="TerraFusion Consciousness" \
      org.opencontainers.image.description="TerraFusion AI Agent Swarm Orchestration" \
      org.opencontainers.image.vendor="TerraFusion" \
      terrafusion.component="consciousness" \
      terrafusion.compliance="FISMA-High"

USER terrafusion

ENTRYPOINT ["dotnet", "TerraFusion.Consciousness.dll"]
