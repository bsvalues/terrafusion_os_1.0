{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}",
    "Redis": "${REDIS_CONNECTION_STRING}"
  },
  "Database": {
    "ConnectionPool": {
      "MinSize": 5,
      "MaxSize": 100,
      "LifetimeSeconds": 300,
      "IdleLifetimeSeconds": 180,
      "PruningIntervalSeconds": 10,
      "EnableMultiplexing": true,
      "MaxAutoPrepare": 20,
      "AutoPrepareMinUsages": 5,
      "TimeoutSeconds": 30,
      "CommandTimeoutSeconds": 30,
      "CancellationTimeoutSeconds": 2,
      "SslMode": "Require",
      "KeepAliveSeconds": 30
    }
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpirationHours": "${JWT_EXPIRATION_HOURS}"
  },
  "Security": {
    "EncryptionKey": "${ENCRYPTION_KEY}",
    "ApiRateLimit": {
      "RequestsPerMinute": 100,
      "BurstLimit": 200
    }
  },
  "Government": {
    "ComplianceLevel": "FISMA-High",
    "AuditLogging": true,
    "DataClassification": "Sensitive"
  },
  "Cors": {
    "Production": {
      "AllowedOrigins": [
        "https://terrafusion.gov",
        "https://www.terrafusion.gov",
        "https://api.terrafusion.gov",
        "https://admin.terrafusion.gov"
      ]
    },
    "Staging": {
      "AllowedOrigins": [
        "https://staging.terrafusion.gov",
        "https://test.terrafusion.gov",
        "https://demo.terrafusion.gov"
      ]
    },
    "Government": {
      "AllowedOrigins": [
        "https://county.gov",
        "https://state.gov",
        "https://terrafusion.gov",
        "https://*.county.gov",
        "https://*.state.gov"
      ]
    },
    "Development": {
      "AllowedOrigins": [
        "http://localhost:\${{TF_FRONTEND_PORT:-3000}}",
        "http://localhost:\${{TF_FRONTEND_PORT:-3000}}",
        "https://localhost:\${{TF_FRONTEND_PORT:-3000}}",
        "https://localhost:\${{TF_FRONTEND_PORT:-3000}}"
      ]
    }
  }
}
