{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=terrafusion_dev;Username=postgres;Password=${TF_DEV_DB_PASSWORD}"
  },
  "JwtSettings": {
    "SecretKey": "${TF_DEV_JWT_SECRET}",
    "Issuer": "Terrafusion-Dev",
    "Audience": "Terrafusion-Users",
    "ExpirationHours": "24"
  },
  "Security": {
    "EncryptionKey": "${TF_DEV_ENCRYPTION_KEY}",
    "ApiRateLimit": {
      "RequestsPerMinute": 1000,
      "BurstLimit": 2000
    }
  }
}
