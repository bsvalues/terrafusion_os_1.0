{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information",
      "TerraFusion.StreamingAnalytics": "Information"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:3006;https://localhost:3007",
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_VIA_ENV_JwtSettings__SecretKey",
    "Issuer": "TerraFusion.StreamingAnalytics",
    "Audience": "TerraFusion.Frontend",
    "ExpirationMinutes": 60
  },
  "SignalR": {
    "KeepAliveInterval": 15,
    "ClientTimeoutInterval": 30,
    "MaximumReceiveMessageSize": 1048576,
    "StreamBufferCapacity": 10
  },
  "MetricBroadcast": {
    "IntervalMs": 2000,
    "EnabledMetrics": [
      "system.cpu",
      "system.memory",
      "agents.active",
      "swarm.coherence"
    ]
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.SignalR": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/streaming-analytics-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  }
}
