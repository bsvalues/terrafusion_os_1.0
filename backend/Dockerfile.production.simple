# TerraFusion OS 1.0 - Production Dockerfile
# Government-Grade Security | Multi-Stage Build | Performance Optimized

# Stage 1: Build Environment
FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build-env
LABEL maintainer="TerraFusion Production Engineering"
LABEL version="1.0.0"
LABEL environment="production"

# Install build dependencies
RUN apk add --no-cache curl ca-certificates && update-ca-certificates

# Set working directory
WORKDIR /src

# Copy solution and projects
COPY TerraFusion.sln ./
COPY TerraFusion.Abstractions/ ./TerraFusion.Abstractions/
COPY TerraFusion.Core/ ./TerraFusion.Core/
COPY TerraFusion.Data/ ./TerraFusion.Data/
COPY TerraFusion.API/ ./TerraFusion.API/
COPY Directory.Packages.props ./

# Restore dependencies
RUN dotnet restore TerraFusion.sln --verbosity minimal

# Build and publish
RUN dotnet publish TerraFusion.API/TerraFusion.API.csproj \
    -c Release \
    -o /app/publish \
    --no-restore \
    --verbosity minimal \
    /p:TreatWarningsAsErrors=false \
    /p:IsTestProject=false

# Stage 2: Production Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS production
LABEL maintainer="TerraFusion Production Engineering"
LABEL version="1.0.0"
LABEL environment="production"

# Install runtime dependencies
RUN apk add --no-cache curl ca-certificates tzdata icu-libs \
    && update-ca-certificates

# Create non-root user
RUN addgroup -g 1001 -S terrafusion && \
    adduser -S terrafusion -u 1001 -G terrafusion

# Set working directory
WORKDIR /app

# Copy published application
COPY --from=build-env --chown=terrafusion:terrafusion /app/publish ./

# Create directories
RUN mkdir -p logs data temp && chown -R terrafusion:terrafusion /app

# Configure environment
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# Switch to non-root user
USER terrafusion

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Entry point
ENTRYPOINT ["dotnet", "TerraFusion.API.dll"]
