# TFT-186: Multi-stage Dockerfile for TerraFusion API (Kernel)
# Build: docker build -f Dockerfile.api -t terrafusion-api .
# Run:   docker run -p 5000:5000 terrafusion-api

# ── Build stage ──────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy solution and project files first for layer caching
COPY TerraFusion.sln ./
COPY Directory.Packages.props ./
COPY src/Directory.Build.targets src/
COPY src/TerraFusion.API/TerraFusion.API.csproj src/TerraFusion.API/
COPY src/TerraFusion.Core/TerraFusion.Core.csproj src/TerraFusion.Core/
COPY src/TerraFusion.Data/TerraFusion.Data.csproj src/TerraFusion.Data/
COPY src/TerraFusion.AI/TerraFusion.AI.csproj src/TerraFusion.AI/
COPY src/TerraFusion.Security/TerraFusion.Security.csproj src/TerraFusion.Security/
COPY src/TerraFusion.Abstractions/TerraFusion.Abstractions.csproj src/TerraFusion.Abstractions/
COPY src/TerraFusion.Consciousness/TerraFusion.Consciousness.csproj src/TerraFusion.Consciousness/
COPY src/TerraFusion.Operations/TerraFusion.Operations.csproj src/TerraFusion.Operations/
COPY src/TerraFusion.Levy/TerraFusion.Levy.csproj src/TerraFusion.Levy/
COPY src/TerraFusion.CostForge/TerraFusion.CostForge.csproj src/TerraFusion.CostForge/
COPY src/TerraFusion.Sync/TerraFusion.Sync.csproj src/TerraFusion.Sync/
COPY TerraFusion.Gateway/TerraFusion.Gateway.csproj TerraFusion.Gateway/

# Restore NuGet packages with caching optimization
RUN dotnet restore src/TerraFusion.API/TerraFusion.API.csproj --runtime linux-x64

# Copy all source code
COPY . .

# Publish application in Release mode
FROM build AS publish
WORKDIR /src/src/TerraFusion.API
RUN dotnet publish TerraFusion.API.csproj -c Release -o /app/publish \
    --self-contained false \
    --no-restore \
    /p:DebugType=None \
    /p:DebugSymbols=false

# ── Runtime stage ────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime

# Install curl for health checks
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Security: run as non-root (FISMA-HIGH requirement)
RUN groupadd -r terrafusion && useradd -r -g terrafusion -s /sbin/nologin terrafusion

COPY --from=publish /app/publish .
RUN chown -R terrafusion:terrafusion /app

# Environment
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
ENV DOTNET_USE_POLLING_FILE_WATCHER=true
ENV TZ=America/Los_Angeles

EXPOSE 5000

# Health check: /health every 30s, 5s timeout, 3 retries
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

LABEL org.opencontainers.image.title="TerraFusion API" \
      org.opencontainers.image.description="TerraFusion OS Core API Kernel" \
      org.opencontainers.image.vendor="TerraFusion" \
      terrafusion.component="api" \
      terrafusion.compliance="FISMA-High"

USER terrafusion

ENTRYPOINT ["dotnet", "TerraFusion.API.dll"]
