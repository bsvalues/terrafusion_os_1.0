{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information"
    }
  },
  "AllowedHosts": "*",
  "JWT": {
    "Key": "TerraFusion_IDE_Ultimate_Secret_Key_2024_Government_Grade_Security",
    "Issuer": "TerraFusion.IDE.Gateway",
    "Audience": "TerraFusion.IDE.Client",
    "ExpiryMinutes": 480
  },
  "Services": {
    "TerraFusionAPI": "http://localhost:${TF_STATIC_PORT:-8080}",
    "RustDevEngine": "http://localhost:${TF_STATIC_PORT:-8080}",
    "AISwarm": "http://localhost:${TF_STATIC_PORT:-8080}",
    "OpsTools": "http://localhost:${TF_STATIC_PORT:-8080}"
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "terrafusion-api",
        "Match": {
          "Path": "/api/terrafusion/{**catch-all}"
        },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      },
      "dev-engine-route": {
        "ClusterId": "rust-dev-engine",
        "Match": {
          "Path": "/api/dev/{**catch-all}"
        },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      },
      "ai-swarm-route": {
        "ClusterId": "ai-swarm",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      },
      "ops-tools-route": {
        "ClusterId": "ops-tools",
        "Match": {
          "Path": "/api/ops/{**catch-all}"
        },
        "Transforms": [{ "PathPattern": "/api/{**catch-all}" }]
      }
    },
    "Clusters": {
      "terrafusion-api": {
        "Destinations": {
          "api": {
            "Address": "http://localhost:${TF_STATIC_PORT:-8080}/"
          }
        }
      },
      "rust-dev-engine": {
        "Destinations": {
          "dev": {
            "Address": "http://localhost:${TF_STATIC_PORT:-8080}/"
          }
        }
      },
      "ai-swarm": {
        "Destinations": {
          "ai": {
            "Address": "http://localhost:${TF_STATIC_PORT:-8080}/"
          }
        }
      },
      "ops-tools": {
        "Destinations": {
          "ops": {
            "Address": "http://localhost:${TF_STATIC_PORT:-8080}/"
          }
        }
      }
    }
  },
  "IDE": {
    "Name": "TerraFusion Ultimate IDE",
    "Version": "1.0.0",
    "Features": {
      "AICodeCompletion": true,
      "VisualWorkflowDesigner": true,
      "GovernmentCompliance": true,
      "RealTimeCollaboration": true,
      "AutomatedTesting": true,
      "DevOpsIntegration": true
    },
    "Capabilities": {
      "SupportedLanguages": [
        "Rust",
        "C#",
        "Python",
        "TypeScript",
        "SQL",
        "YAML",
        "JSON"
      ],
      "AIAgents": 1008,
      "TestOrchestrators": 716,
      "OpsTools": 45,
      "GovernmentModules": 32,
      "MaxConcurrentUsers": 100,
      "MaxProjectSize": "10GB"
    }
  }
}
