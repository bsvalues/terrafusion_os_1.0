{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=terrafusion.db",
    "UltimateCostForgeAI": "Data Source=ultimate_costforge.db",
    "TerraFusionDatabase": "Data Source=terrafusion.db"
  },
  "JwtSettings": {
    "SecretKey": "Terrafusion-OS-1.0-JWT-Secret-Key-Must-Be-At-Least-32-Characters-Long-For-Security",
    "Issuer": "Terrafusion.API",
    "Audience": "Terrafusion.Client",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "https://localhost:3001",
    "http://localhost:5173",
    "https://localhost:5174"
  ],
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/terrafusion-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AIEngine": {
    "MaxConcurrentInferences": 10,
    "ModelCacheSizeGB": 4,
    "DefaultTimeoutSeconds": 30,
    "EnableGPUAcceleration": true
  },
  "CostForge": {
    "QuantumFactor": 999,
    "AgentCount": 1000000,
    "TargetAccuracy": 0.999,
    "AnalysisDimensions": 147,
    "EnableQuantumOptimization": true,
    "EnableSwarmIntelligence": true,
    "EnableRevenueOptimization": true,
    "MaxConcurrentCalculations": 10000,
    "CalculationTimeout": 60000,
    "CachingEnabled": true,
    "CacheExpirationMinutes": 120
  },
  "UltimateCostForgeAI": {
    "UltimateQuantumFactor": 999,
    "UltimateAccuracyTarget": 99.9,
    "UltimateAgentCount": 1000000,
    "UltimateConsciousnessResonance": 0.9999,
    "UltimateDimensionalAnalysis": 147,
    "EnableUltimateQuantumOptimization": true,
    "EnableUltimateSwarmIntelligence": true,
    "EnableUltimateRevenueOptimization": true,
    "UltimateMaxConcurrentCalculations": 10000,
    "UltimateCalculationTimeout": 60000,
    "UltimateCachingEnabled": true,
    "UltimateCacheExpirationMinutes": 120
  },
  "Security": {
    "EnableRateLimiting": true,
    "MaxRequestsPerMinute": 100,
    "EnableIPWhitelist": false,
    "RequireHttps": false,
    "EnableCors": true
  },
  "Performance": {
    "EnableResponseCompression": true,
    "EnableResponseCaching": true,
    "DefaultCacheExpirationMinutes": 15
  },
  "AuditLogging": {
    "Enabled": true,
    "LogToDatabase": true,
    "LogToFile": true,
    "RetentionDays": 90,
    "LogLevel": "Information"
  },
  "TerraSync": {
    "BaseUrl": "http://localhost:3005",
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "HealthCheckIntervalSeconds": 60,
    "EnableFallbackMode": true
  }
}
