{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terrafusion/schemas/module.manifest.schema.json",
  "title": "TerraFusion Module Manifest",
  "type": "object",
  "required": ["name", "version", "enabled", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "name":        { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
    "version":     { "type": "string", "minLength": 1 },
    "title":       { "type": "string" },
    "description": { "type": "string" },
    "enabled":     { "type": "boolean" },
    "capabilities":{
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "path"],
        "properties": {
          "method": { "type": "string", "enum": ["GET","POST","PUT","PATCH","DELETE","WS"] },
          "path":   { "type": "string", "pattern": "^/" }
        },
        "additionalProperties": false
      }
    },
    "entrypoint": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type":     { "type": "string", "enum": ["service","worker","none"] },
        "assembly": { "type": "string" },
        "class":    { "type": "string" }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}