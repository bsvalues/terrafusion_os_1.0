{
  "ApiManagement": {
    "ServiceName": "terrafusion-api-management",
    "Tier": "Developer",
    "Location": "West US 2",
    "PublisherEmail": "admin@terrafusion.com",
    "PublisherName": "TerraFusion Systems",
    "Policies": {
      "Global": {
        "RateLimit": {
          "CallsPerSecond": 100,
          "RenewalPeriod": 60
        },
        "Cors": {
          "AllowedOrigins": ["*"],
          "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
          "AllowedHeaders": ["*"],
          "ExposeHeaders": ["*"]
        },
        "Authentication": {
          "Required": true,
          "ValidateJwt": true,
          "IssuerUrl": "https://login.microsoftonline.com/{tenant-id}/v2.0",
          "Audience": "api://terrafusion-api"
        }
      },
      "PropertyApi": {
        "RateLimit": {
          "CallsPerMinute": 1000,
          "CallsPerHour": 10000
        },
        "Caching": {
          "Duration": 300,
          "VaryByQueryString": true,
          "VaryByHeaders": ["Authorization"]
        }
      },
      "ReportsApi": {
        "RateLimit": {
          "CallsPerMinute": 500,
          "CallsPerHour": 5000
        },
        "RequiredRoles": ["PropertyManager", "Assessor", "SystemAdmin"]
      }
    },
    "Products": {
      "TerraFusionPublic": {
        "DisplayName": "TerraFusion Public API",
        "Description": "Public APIs for TerraFusion property management system",
        "SubscriptionRequired": true,
        "ApprovalRequired": false,
        "SubscriptionsLimit": 1000,
        "State": "published",
        "Terms": "Standard API terms of service"
      },
      "TerraFusionEnterprise": {
        "DisplayName": "TerraFusion Enterprise API",
        "Description": "Enterprise APIs with enhanced features and support",
        "SubscriptionRequired": true,
        "ApprovalRequired": true,
        "SubscriptionsLimit": 100,
        "State": "published",
        "Terms": "Enterprise API terms with SLA guarantees"
      }
    },
    "Apis": {
      "PropertyManagementApi": {
        "Path": "properties",
        "DisplayName": "Property Management API",
        "Description": "APIs for managing property records and assessments",
        "ServiceUrl": "https://terrafusion-backend.azurewebsites.net/api",
        "Protocols": ["https"],
        "SubscriptionKeyParameterNames": {
          "Header": "Ocp-Apim-Subscription-Key",
          "Query": "subscription-key"
        },
        "Operations": [
          {
            "Name": "GetProperties",
            "Method": "GET",
            "UrlTemplate": "/properties",
            "Description": "Get all properties with filtering and pagination"
          },
          {
            "Name": "GetProperty",
            "Method": "GET", 
            "UrlTemplate": "/properties/{id}",
            "Description": "Get a specific property by ID"
          },
          {
            "Name": "CreateProperty",
            "Method": "POST",
            "UrlTemplate": "/properties",
            "Description": "Create a new property record"
          },
          {
            "Name": "UpdateProperty",
            "Method": "PUT",
            "UrlTemplate": "/properties/{id}",
            "Description": "Update an existing property"
          },
          {
            "Name": "DeleteProperty",
            "Method": "DELETE",
            "UrlTemplate": "/properties/{id}",
            "Description": "Delete a property record"
          }
        ]
      },
      "ReportsApi": {
        "Path": "reports",
        "DisplayName": "Reports API",
        "Description": "APIs for generating and accessing reports",
        "ServiceUrl": "https://terrafusion-backend.azurewebsites.net/api",
        "Protocols": ["https"],
        "Operations": [
          {
            "Name": "GetAssessmentReport",
            "Method": "GET",
            "UrlTemplate": "/reports/assessment",
            "Description": "Generate assessment reports"
          },
          {
            "Name": "GetTaxReport",
            "Method": "GET",
            "UrlTemplate": "/reports/tax",
            "Description": "Generate tax collection reports"
          },
          {
            "Name": "GetComplianceReport",
            "Method": "GET",
            "UrlTemplate": "/reports/compliance",
            "Description": "Generate compliance reports"
          }
        ]
      },
      "IntegrationsApi": {
        "Path": "integrations",
        "DisplayName": "Integrations API",
        "Description": "APIs for managing third-party integrations",
        "ServiceUrl": "https://terrafusion-backend.azurewebsites.net/api",
        "Protocols": ["https"],
        "Operations": [
          {
            "Name": "GetIntegrations",
            "Method": "GET",
            "UrlTemplate": "/integrations",
            "Description": "Get available integrations"
          },
          {
            "Name": "ConfigureIntegration",
            "Method": "POST",
            "UrlTemplate": "/integrations/{name}/configure",
            "Description": "Configure an integration"
          },
          {
            "Name": "RegisterWebhook",
            "Method": "POST",
            "UrlTemplate": "/integrations/webhooks",
            "Description": "Register a webhook endpoint"
          },
          {
            "Name": "ProcessWebhook",
            "Method": "POST",
            "UrlTemplate": "/integrations/webhooks/{id}",
            "Description": "Process incoming webhook"
          }
        ]
      }
    },
    "Subscriptions": {
      "DeveloperTier": {
        "DisplayName": "Developer",
        "Description": "For developers and testing purposes",
        "CallsPerMinute": 100,
        "CallsPerMonth": 10000,
        "Price": "Free"
      },
      "BasicTier": {
        "DisplayName": "Basic",
        "Description": "For small to medium applications",
        "CallsPerMinute": 500,
        "CallsPerMonth": 100000,
        "Price": "$49/month"
      },
      "PremiumTier": {
        "DisplayName": "Premium",
        "Description": "For high-volume enterprise applications",
        "CallsPerMinute": 2000,
        "CallsPerMonth": 1000000,
        "Price": "$199/month"
      }
    },
    "SecurityPolicies": {
      "IpFiltering": {
        "Enabled": true,
        "AllowedIps": [],
        "BlockedIps": []
      },
      "ClientCertificates": {
        "Required": false,
        "ValidateChain": true,
        "ValidateRevocation": true
      },
      "OAuth2": {
        "AuthorizationServer": "https://login.microsoftonline.com/{tenant-id}/oauth2/v2.0/authorize",
        "TokenEndpoint": "https://login.microsoftonline.com/{tenant-id}/oauth2/v2.0/token",
        "Scopes": ["api://terrafusion-api/.default"]
      }
    },
    "Monitoring": {
      "ApplicationInsights": {
        "InstrumentationKey": "{application-insights-key}",
        "EnableRequestTracking": true,
        "EnableDependencyTracking": true,
        "EnableExceptionTracking": true,
        "EnablePerformanceCounters": true
      },
      "Diagnostics": {
        "EnableRequestBody": true,
        "EnableResponseBody": false,
        "MaxBodySize": 1048576,
        "SamplingPercentage": 100
      },
      "Alerts": {
        "HighErrorRate": {
          "Threshold": 5,
          "WindowMinutes": 5,
          "Actions": ["email", "webhook"]
        },
        "HighLatency": {
          "Threshold": 5000,
          "WindowMinutes": 5,
          "Actions": ["email"]
        },
        "QuotaExceeded": {
          "Threshold": 90,
          "WindowMinutes": 1,
          "Actions": ["email", "sms"]
        }
      }
    },
    "DeveloperPortal": {
      "Enabled": true,
      "CustomDomain": "developer.terrafusion.com",
      "Title": "TerraFusion Developer Portal",
      "Description": "Access TerraFusion APIs and documentation",
      "Features": {
        "ApiExplorer": true,
        "CodeSamples": true,
        "SdkGeneration": true,
        "InteractiveConsole": true,
        "UserRegistration": true,
        "SubscriptionManagement": true
      },
      "Branding": {
        "Logo": "https://terrafusion.com/assets/logo.png",
        "PrimaryColor": "#2563eb",
        "SecondaryColor": "#64748b",
        "CustomCss": ""
      }
    },
    "Caching": {
      "Redis": {
        "ConnectionString": "{redis-connection-string}",
        "DefaultExpiration": 300,
        "KeyPrefix": "apim:",
        "Policies": {
          "PropertyApi": {
            "CacheDuration": 600,
            "VaryByQueryString": true,
            "VaryByHeaders": ["Authorization", "Accept-Language"]
          },
          "ReportsApi": {
            "CacheDuration": 1800,
            "VaryByQueryString": true,
            "StaleWhileRevalidate": true
          }
        }
      }
    },
    "LoadBalancing": {
      "Strategy": "RoundRobin",
      "HealthChecks": {
        "Enabled": true,
        "Interval": 30,
        "Timeout": 10,
        "UnhealthyThreshold": 3,
        "HealthyThreshold": 2
      },
      "BackendPools": [
        {
          "Name": "TerraFusionBackend",
          "Servers": [
            {
              "Url": "https://terrafusion-backend-primary.azurewebsites.net",
              "Weight": 100,
              "Priority": 1
            },
            {
              "Url": "https://terrafusion-backend-secondary.azurewebsites.net",
              "Weight": 50,
              "Priority": 2
            }
          ]
        }
      ]
    }
  }
}
