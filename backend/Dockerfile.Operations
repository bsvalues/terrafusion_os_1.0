# ============================================================================
# TerraFusion Operations - Multi-Stage Production Docker Image
# Government. Transcended. - County Operations & Workflow Management
# ============================================================================
# Build Stage: Compile and publish .NET 8 application
# Runtime Stage: Optimized for county operations and workflow orchestration
# Health Checks: Operations health monitoring for Kubernetes orchestration
# Performance: <100ms workflow execution, bulk operations optimization
# Features: County data isolation, workflow automation, audit logging
# Security: Non-root user, minimal dependencies, FISMA-High compliance ready
# ============================================================================

# ============================================================================
# Stage 1: Build Stage - SDK Image for Compilation
# ============================================================================
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy solution and project files for dependency restoration
COPY ["TerraFusion.sln", "./"]
COPY ["TerraFusion.Operations/TerraFusion.Operations.csproj", "TerraFusion.Operations/"]
COPY ["TerraFusion.Data/TerraFusion.Data.csproj", "TerraFusion.Data/"]
COPY ["TerraFusion.AI/TerraFusion.AI.csproj", "TerraFusion.AI/"]

# Restore NuGet packages with caching optimization
RUN dotnet restore "TerraFusion.Operations/TerraFusion.Operations.csproj" --runtime linux-x64

# Copy all source code
COPY . .

# Build application in Release mode with optimization
WORKDIR "/src/TerraFusion.Operations"
RUN dotnet build "TerraFusion.Operations.csproj" -c Release -o /app/build --runtime linux-x64 --no-restore

# ============================================================================
# Stage 2: Publish Stage - Create Self-Contained Deployment
# ============================================================================
FROM build AS publish
RUN dotnet publish "TerraFusion.Operations.csproj" -c Release -o /app/publish \
    --runtime linux-x64 \
    --self-contained false \
    --no-restore \
    /p:PublishReadyToRun=true \
    /p:PublishSingleFile=false \
    /p:DebugType=None \
    /p:DebugSymbols=false

# ============================================================================
# Stage 3: Runtime Stage - Minimal Production Image
# ============================================================================
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime

# Install production dependencies
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create non-root user for security (FISMA-High requirement)
RUN groupadd -r terrafusion && useradd -r -g terrafusion terrafusion

# Copy published application from publish stage
COPY --from=publish /app/publish .

# Set ownership to non-root user
RUN chown -R terrafusion:terrafusion /app

# Switch to non-root user
USER terrafusion

# Expose ports
# Port 5002: Operations API endpoint
EXPOSE 5002

# Environment variables for production
ENV ASPNETCORE_URLS=http://+:5002 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    DOTNET_USE_POLLING_FILE_WATCHER=true \
    TZ=America/Los_Angeles

# Health check configuration
# Kubernetes uses this for readiness and liveness probes
# Checks operations health and workflow engine status
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5002/health || exit 1

# Labels for container metadata (OCI standard)
LABEL org.opencontainers.image.title="TerraFusion Operations" \
    org.opencontainers.image.description="TerraFusion OS Operations - County Workflow & Operations Management" \
    org.opencontainers.image.vendor="TerraFusion" \
    org.opencontainers.image.version="1.0.0" \
    org.opencontainers.image.created="2025-11-03" \
    org.opencontainers.image.source="https://github.com/terrafusion/terrafusion-os" \
    org.opencontainers.image.licenses="Proprietary" \
    terrafusion.component="operations" \
    terrafusion.tier="backend" \
    terrafusion.compliance="FISMA-High"

# Entrypoint: Start the Operations service
ENTRYPOINT ["dotnet", "TerraFusion.Operations.dll"]

# ============================================================================
# Build & Run Instructions
# ============================================================================
# Build image:
#   docker build -f Dockerfile.Operations -t terrafusion-operations:latest .
#
# Run container (development):
#   docker run -d -p 5002:5002 --name terrafusion-operations \
#     -e ASPNETCORE_ENVIRONMENT=Development \
#     -e ConnectionStrings__DefaultConnection="Host=postgres;Database=terrafusion;Username=postgres;Password=password" \
#     terrafusion-operations:latest
#
# Run container (production):
#   docker run -d -p 5002:5002 --name terrafusion-operations \
#     -e ASPNETCORE_ENVIRONMENT=Production \
#     -e ConnectionStrings__DefaultConnection="${DB_CONNECTION_STRING}" \
#     terrafusion-operations:latest
#
# View logs:
#   docker logs -f terrafusion-operations
#
# Check health:
#   curl http://localhost:5002/health
#
# Stop container:
#   docker stop terrafusion-operations
#   docker rm terrafusion-operations
# ============================================================================
