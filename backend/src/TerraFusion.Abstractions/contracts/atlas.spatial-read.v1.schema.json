{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://terrafusion.gov/contracts/atlas.spatial-read.v1.schema.json",
  "title": "Atlas Spatial Read Exchange",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "result"],
  "properties": {
    "request": { "$ref": "#/definitions/request" },
    "result": { "$ref": "#/definitions/result" }
  },
  "definitions": {
    "evidenceState": {
      "type": "string",
      "enum": ["canonical", "provider", "fallback", "unavailable"]
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude", "latitude"],
      "properties": {
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "frontFeet": { "type": "number", "minimum": 0 },
        "backFeet": { "type": "number", "minimum": 0 },
        "leftFeet": { "type": "number", "minimum": 0 },
        "rightFeet": { "type": "number", "minimum": 0 },
        "effectiveWidthFeet": { "type": "number", "minimum": 0 },
        "effectiveDepthFeet": { "type": "number", "minimum": 0 }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometryState"],
      "properties": {
        "geometryState": {
          "type": "string",
          "enum": ["polygon", "centroid_only", "unavailable"]
        },
        "centroid": { "$ref": "#/definitions/coordinate" },
        "dimensions": { "$ref": "#/definitions/dimensions" },
        "areaAcres": { "type": "number", "minimum": 0 },
        "areaSquareFeet": { "type": "number", "minimum": 0 },
        "outerRing": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/definitions/coordinate" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "geometryState": { "const": "polygon" } } },
          "then": {
            "properties": { "outerRing": {} },
            "required": ["outerRing"]
          }
        },
        {
          "if": {
            "properties": { "geometryState": { "const": "centroid_only" } }
          },
          "then": {
            "properties": { "centroid": {}, "outerRing": {} },
            "required": ["centroid"],
            "not": { "required": ["outerRing"] }
          }
        },
        {
          "if": {
            "properties": { "geometryState": { "const": "unavailable" } }
          },
          "then": {
            "properties": {
              "centroid": {},
              "dimensions": {},
              "areaAcres": {},
              "areaSquareFeet": {},
              "outerRing": {}
            },
            "not": {
              "anyOf": [
                { "required": ["centroid"] },
                { "required": ["dimensions"] },
                { "required": ["areaAcres"] },
                { "required": ["areaSquareFeet"] },
                { "required": ["outerRing"] }
              ]
            }
          }
        }
      ]
    },
    "zoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceState"],
      "properties": {
        "evidenceState": { "$ref": "#/definitions/evidenceState" },
        "zoneCode": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "flood": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceState"],
      "properties": {
        "evidenceState": { "$ref": "#/definitions/evidenceState" },
        "zone": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zoning": { "$ref": "#/definitions/zoning" },
        "flood": { "$ref": "#/definitions/flood" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countyId", "parcelId"],
      "properties": {
        "countyId": { "type": "string", "minLength": 1 },
        "parcelId": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "countyId",
        "parcelId",
        "evidenceState",
        "boundary",
        "layers"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "countyId": { "type": "string", "minLength": 1 },
        "parcelId": { "type": "string", "minLength": 1 },
        "evidenceState": { "$ref": "#/definitions/evidenceState" },
        "boundary": { "$ref": "#/definitions/boundary" },
        "layers": { "$ref": "#/definitions/layers" }
      }
    }
  }
}
