{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "TerraFusion.Consciousness": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=terrafusion_consciousness;Username=postgres;Password=CHANGE_ME_VIA_ENV_ConnectionStrings__DefaultConnection;Port=5432"
  },
  "ConsciousnessSettings": {
    "MaxAgentsPerLayer": 1000000,
    "QuantumProcessingEnabled": true,
    "ValidationRingsEnabled": true,
    "ComplianceLevel": "Government",
    "PerformanceMonitoring": true,
    "SecurityLevel": "Maximum"
  },
  "AILayerMesh": {
    "NATSJetStream": "nats://mesh.terrafusionmarket.com:4222",
    "MCPGateway": "https://mcp.terrafusionmarket.com/api/v1",
    "LayerTimeout": 30000,
    "MaxConcurrentOperations": 1000,
    "ValidationRingCount": 5,
    "MeshScalingEnabled": true
  },
  "QuantumSecurity": {
    "EncryptionLevel": "Quantum",
    "ThreatDetectionEnabled": true,
    "ComplianceFrameworks": ["FISMA", "FedRAMP", "SOC2"],
    "SecurityMonitoringEnabled": true
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "TerraFusion.Consciousness": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/consciousness-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 31
        }
      }
    ]
  },
  "MultimediaLimitations": {
    "MaxFileSizeInMB": 10,
    "AllowedFileTypes": ["jpg", "jpeg", "png", "gif", "pdf", "docx", "xlsx"],
    "VirusScanningEnabled": true
  },
  "BentonCounty": {
    "API": {
      "BaseUrl": "https://api.terrafusionmarket.io",
      "ApiKey": "CHANGE_ME_VIA_ENV_BentonCounty__API__ApiKey",
      "TimeoutSeconds": 30
    },
    "DataSync": {
      "SyncIntervalMinutes": 15,
      "BatchSize": 1000,
      "RetryCount": 3
    }
  }
}
