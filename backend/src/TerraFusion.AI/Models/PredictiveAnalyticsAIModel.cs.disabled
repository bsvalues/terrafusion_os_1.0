            _logger.LogWarning(ex, "TensorFlow initialization failed, using ML.NET only");
        }
    }

    /// <summary>
    /// Historical and contextual data for predictive analytics
    /// </summary>
    public class PredictiveData
    {
        [LoadColumn(0)]
        public float DayOfYear { get; set; } // 1-366

        [LoadColumn(1)]
        public float DayOfWeek { get; set; } // 1-7

        [LoadColumn(2)]
        public float HourOfDay { get; set; } // 0-23

        [LoadColumn(3)]
        public float MonthOfYear { get; set; } // 1-12

        [LoadColumn(4)]
        public float WeatherTemperature { get; set; }

        [LoadColumn(5)]
        public float WeatherPrecipitation { get; set; }

        [LoadColumn(6)]
        public string WeatherCondition { get; set; } = string.Empty;

        [LoadColumn(7)]
        public float PopulationDensity { get; set; }

        [LoadColumn(8)]
        public float EconomicIndex { get; set; }

        [LoadColumn(9)]
        public float UnemploymentRate { get; set; }

        [LoadColumn(10)]
        public float SchoolCalendarFactor { get; set; } // 0-1 scale

        [LoadColumn(11)]
        public bool IsHoliday { get; set; }

        [LoadColumn(12)]
        public bool IsPayDay { get; set; }

        [LoadColumn(13)]
        public float PreviousDayDemand { get; set; }

        [LoadColumn(14)]
        public float PreviousWeekDemand { get; set; }

        [LoadColumn(15)]
        public float PreviousMonthDemand { get; set; }

        [LoadColumn(16)]
        public float SeasonalTrend { get; set; }

        [LoadColumn(17)]
        public string ServiceType { get; set; } = string.Empty;

        [LoadColumn(18)]
        public string Department { get; set; } = string.Empty;

        [LoadColumn(19)]
        public float StaffCount { get; set; }

        [LoadColumn(20)]
        public float BudgetAllocation { get; set; }

        [LoadColumn(21)]
        public float CitizenSatisfactionScore { get; set; }

        [LoadColumn(22)]
        public float EmergencyIncidents { get; set; }

        [LoadColumn(23)]
        public float SpecialEvents { get; set; } // Number of special events in area

        [LoadColumn(24)]
        public float TrafficPatterns { get; set; }

        [LoadColumn(25)]
        [ColumnName("Label")]
        public float TargetDemand { get; set; }
    }

    /// <summary>
    /// Quantum-enhanced predictive analytics results
    /// </summary>
    public class PredictivePrediction
    {
        [ColumnName("Score")]
        public float PredictedDemand { get; set; }

        public float ConfidenceInterval { get; set; }

        public DemandLevel DemandLevel { get; set; }

        public ResourceAllocation OptimalResourceAllocation { get; set; } = new();

        public BudgetOptimization BudgetRecommendations { get; set; } = new();

        public EmergencyPrediction EmergencyForecast { get; set; } = new();

        public StaffingOptimization StaffingRecommendations { get; set; } = new();

        public CitizenImpactAnalysis CitizenImpact { get; set; } = new();

        public QuantumInsights QuantumEnhancedInsights { get; set; } = new();

        public DateTime PredictionTimestamp { get; set; } = DateTime.UtcNow;

        public TimeSpan PredictionHorizon { get; set; }

        public string ModelVersion { get; set; } = "3.0.0";

        public float ModelAccuracy { get; set; }

        public string[] ActionableRecommendations { get; set; } = Array.Empty<string>();
    }

    public enum DemandLevel
    {
        VeryLow = 1,
        Low = 2,
        Normal = 3,
        High = 4,
        VeryHigh = 5,
        Critical = 6
    }

    public class ResourceAllocation
    {
        public int RecommendedStaffCount { get; set; }
        public float OptimalBudgetAllocation { get; set; }
        public string[] PriorityServices { get; set; } = Array.Empty<string>();
        public Dictionary<string, float> DepartmentAllocation { get; set; } = new();
        public bool RequiresOvertime { get; set; }
