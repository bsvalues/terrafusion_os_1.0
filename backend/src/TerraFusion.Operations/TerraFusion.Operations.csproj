<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TerraFusion.Operations</AssemblyName>
    <RootNamespace>TerraFusion.Operations</RootNamespace>
    <AssemblyTitle>TerraFusion Elite Operational Excellence</AssemblyTitle>
    <AssemblyDescription>Championship-level operational excellence framework for TerraFusion OS</AssemblyDescription>
    <AssemblyCompany>TerraFusion Government Technologies</AssemblyCompany>
    <AssemblyProduct>TerraFusion OS</AssemblyProduct>
    <AssemblyCopyright>Copyright © 2024 TerraFusion Government Technologies</AssemblyCopyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-elite-operational-excellence</InformationalVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE;ELITE_OPERATIONAL</DefineConstants>
    <WarningLevel>5</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE;ELITE_OPERATIONAL;GOVERNMENT_TRANSCENDED</DefineConstants>
    <Optimize>true</Optimize>
    <WarningLevel>5</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <!-- 1591: missing XML doc; NU1903: NuGet known-vulnerability warning suppressed because
         AutoMapper 12.0.1 CVE (GHSA-rvv3-g6hj-g44x) has no patched version on nuget.org
         for the Extensions.DI companion package. Tracked for future remediation. -->
    <NoWarn>1591;NU1903</NoWarn>
    <!-- Prevent appsettings collision when referenced by TerraFusion.API -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <!-- Explicitly include content but exclude appsettings from publish -->
  <ItemGroup>
    <Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.Authorization" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" />
    <PackageReference Include="FluentValidation.AspNetCore" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.ML" />
    <PackageReference Include="Microsoft.ML.AutoML" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TerraFusion.AI\TerraFusion.AI.csproj" />
    <ProjectReference Include="..\TerraFusion.Abstractions\TerraFusion.Abstractions.csproj" />
    <ProjectReference Include="..\TerraFusion.Core\TerraFusion.Core.csproj" />
    <ProjectReference Include="..\TerraFusion.Data\TerraFusion.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="BackgroundServices\" />
    <Folder Include="Middleware\" />
    <Folder Include="Models\" />
    <Folder Include="Services\Implementation\" />
    <Folder Include="Services\Caching\" />
    <Folder Include="Services\Logging\" />
    <Folder Include="Validators\" />
    <Folder Include="Mappings\" />
    <Folder Include="Extensions\" />
    <Folder Include="Constants\" />
    <Folder Include="Utilities\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" />
    <None Include="ELITE_OPERATIONAL_EXCELLENCE.md" />
    <None Include="DEPLOYMENT_GUIDE.md" />
    <None Include="API_DOCUMENTATION.md" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="echo Building TerraFusion Elite Operational Excellence - Championship Level Government Technology" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="echo TerraFusion Elite Operational Excellence build completed - Government. Transcended." />
  </Target>

</Project>
