      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=terrafusion_dev_clean;Username=postgres;Password=devpassword123;Port=5432;Command Timeout=600;Timeout=30",
