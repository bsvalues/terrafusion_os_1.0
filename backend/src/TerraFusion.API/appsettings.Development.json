{
  "Port": "5000",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=:memory:",
    "BentonCountyLegacy": "Data Source=../../county-data/wa-benton/county.db",
    "HarrisPacsLegacy": "Data Source=harris_pacs_cache.db"
  },
  "Development": {
    "BypassDatabase": true,
    "EnableMockData": true,
    "DisableHealthChecks": false
  },
  "AuditLogging": {
    "Enabled": true,
    "LogToDatabase": false,
    "LogToFile": true,
    "RetentionDays": 30,
    "LogLevel": "Information"
  },
  "Features": {
    "DatabaseRequired": false
  },
  "EliteOperations": {
    "Enabled": true,
    "Mode": "Development",
    "DatabaseRequired": false,
    "MockDataEnabled": true
  },
  "JwtSettings": {
    "SecretKey": "Terrafusion-OS-1.0-Development-JWT-Secret-Key-For-Local-Development-Only",
    "ExpirationMinutes": 120
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:3001",
    "http://localhost:5173",
    "http://localhost:5174",
    "http://localhost:8080"
  ],
  "Cache": {
    "Redis": {
      "KeyPrefix": "terrafusion:benton:",
      "DefaultExpirationMinutes": 15,
      "EnableCompression": true,
      "CompressionThreshold": 1024,
      "ConnectionString": "localhost:6379",
      "EnableDegradedMode": true
    }
  },
  "BentonCounty": {
    "ParcelCount": 89447,
    "HarrisPACSVersion": "9.0",
    "SyncIntervalMinutes": 15,
    "AccuracyTarget": 0.999,
    "PerformanceTarget": "Elite"
  },
  "Security": {
    "RequireHttps": false,
    "MaxRequestsPerMinute": 1000
  },
  "AIEngine": {
    "EnableGPUAcceleration": false,
    "DefaultTimeoutSeconds": 60
  },
  "LegacyDatabases": {
    "BentonCounty": {
      "CountyName": "Benton County",
      "DatabaseType": "harris_pacs",
      "ConnectionString": "Data Source=../../county-data/wa-benton/county.db",
      "ImportBatchSize": 1000,
      "Enabled": true
    }
  }
}
