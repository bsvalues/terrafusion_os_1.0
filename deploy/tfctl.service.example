[Unit]
Description=TerraFusion cOS Launcher (tfctl)
After=network.target

[Service]
Type=simple
User=terrafusion
# Adjust WorkingDirectory to your repo root
WorkingDirectory=/opt/terrafusion
# Environment file (optional, see below)
EnvironmentFile=-/etc/sysconfig/tfctl
ExecStart=/usr/bin/python3 tfctl.py launch --open
# Use --fg only for dev; for unattended, omit so it backgrounds internally
Restart=on-failure
RestartSec=5s
# Hardening (tune as needed)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
