{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerraFusion Agent Events Contract v1",
  "type": "object",
  "required": ["events", "nextCursor"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tsUtc", "level", "agent", "topic", "message"],
        "properties": {
          "id": { "type": "string" },
          "tsUtc": { "type": "string", "format": "date-time" },
          "level": {
            "type": "string",
            "enum": ["Info", "Thinking", "Action", "Warn", "Error"]
          },
          "agent": { "type": "string" },
          "topic": { "type": "string" },
          "message": { "type": "string" },
          "correlationId": { "type": "string" },
          "data": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    },
    "nextCursor": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
