# TerraFusion OS Benton County UAT Environment Variables
# Configure for Benton County Washington government deployment

# =============================================================================
# BASIC CONFIGURATION
# =============================================================================

aws_region  = "us-west-2"  # Oregon region (closest to Washington State)
stack_name  = "terrafusion-bcw-uat"
environment = "uat"

# =============================================================================
# NETWORKING
# =============================================================================

vpc_cidr           = "10.60.0.0/16"
availability_zones = ["us-west-2a", "us-west-2b", "us-west-2c"]

# =============================================================================
# DATABASE CONFIGURATION (PostGIS for 89,247 Benton County Parcels)
# =============================================================================

db_instance_class       = "db.r6g.xlarge"    # 4 vCPU, 32 GB RAM
db_allocated_storage    = 500                # 500 GB for parcel data + history
db_backup_retention_days = 30                # Government compliance

# =============================================================================
# ELITE RUST PERFORMANCE ENGINE
# =============================================================================

rust_engine_cpu_units    = 2048    # 2 vCPU for sub-10ms responses
rust_engine_memory_mb    = 4096    # 4 GB for 50,000 performance agents
rust_engine_desired_count = 3      # High availability

# =============================================================================
# AI COORDINATION (1,008 Total Agents)
# =============================================================================

ai_supreme_commander_agents = 1      # Supreme Commander Claude
ai_field_general_agents     = 8      # Field Generals for strategic coordination
ai_operational_agents       = 999    # Operational forces
rust_performance_agents     = 50000  # Elite Rust performance agents

# =============================================================================
# SECURITY & COMPLIANCE
# =============================================================================

enable_tls           = true
government_domain    = "benton.wa.gov"
data_classification  = "sensitive"

# =============================================================================
# KUBERNETES CLUSTER
# =============================================================================

kubernetes_version = "1.28"

node_groups = {
  # API Gateway Servers (.NET 8.0)
  api_servers = {
    instance_types = ["c5.xlarge"]     # 4 vCPU, 8 GB RAM
    desired_size   = 3
    max_size       = 6
    min_size       = 3
    labels = {
      "terrafusion.io/workload" = "api"
      "terrafusion.io/language" = "dotnet"
    }
  }
  
  # AI Coordination (Memory-optimized for 1,008 agents)
  ai_coordination = {
    instance_types = ["r5.2xlarge"]   # 8 vCPU, 64 GB RAM
    desired_size   = 2
    max_size       = 4
    min_size       = 2
    labels = {
      "terrafusion.io/workload" = "ai-coordination"
      "terrafusion.io/agents"   = "1008"
    }
  }
  
  # TerraFusion Modules (35+ government applications)
  modules = {
    instance_types = ["c5.large"]     # 2 vCPU, 4 GB RAM
    desired_size   = 4
    max_size       = 8
    min_size       = 2
    labels = {
      "terrafusion.io/workload" = "modules"
      "terrafusion.io/count"    = "35"
    }
  }
  
  # Rust Performance Engine
  rust_engine = {
    instance_types = ["c5.xlarge"]    # CPU-optimized for performance
    desired_size   = 3
    max_size       = 6
    min_size       = 3
    labels = {
      "terrafusion.io/workload" = "rust-engine"
      "terrafusion.io/performance" = "elite"
    }
  }
}

# =============================================================================
# BENTON COUNTY SPECIFIC
# =============================================================================

benton_county_parcel_count = 89247
government_contact_email   = "it@co.benton.wa.us"

# =============================================================================
# COST & PERFORMANCE OPTIMIZATION
# =============================================================================

enable_spot_instances      = false  # Government requires stable instances
enable_auto_scaling        = true   # Dynamic scaling for workload management
enable_detailed_monitoring = true   # Required for government compliance

# =============================================================================
# COMPLIANCE & MONITORING
# =============================================================================

log_retention_days = 90  # 3 months for government audit requirements