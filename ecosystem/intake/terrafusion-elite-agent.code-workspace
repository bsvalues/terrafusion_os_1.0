  "settings": {
    "workbench.colorTheme": "Dark+ (default dark)",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorCustomizations": {
      "statusBar.noFolderBackground": "#0b1020",
      "panel.background": "#0f1419",
      "terminal.background": "#0b1020",
      "terminal.foreground": "#00ffee",
      "editor.background": "#0f1419",
      "editor.foreground": "#ffffff",
      "editorCursor.foreground": "#00ffee",
      "editor.selectionBackground": "#0099ff40",
      "editor.lineHighlightBackground": "#0099ff20",
      "editorGroupHeader.tabsBackground": "#0b1020",
      "tab.activeBackground": "#0099ff",
      "tab.activeForeground": "#ffffff",
      "tab.inactiveBackground": "#0b1020",
      "tab.inactiveForeground": "#00ffee",
      "sideBar.background": "#0f1419",
      "sideBar.foreground": "#00ffee",
      "sideBarSectionHeader.background": "#0099ff",
      "sideBarSectionHeader.foreground": "#ffffff"
    },
    "editor.fontFamily": "'Cascadia Code', 'Fira Code', 'SF Mono', Consolas, 'Courier New', monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 14,
    "editor.lineHeight": 1.5,
    "editor.fontWeight": "400",
    "editor.letterSpacing": 0.5,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.smoothScrolling": true,
    "editor.minimap.enabled": true,
    "editor.minimap.maxColumn": 120,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 120,
    "editor.rulers": [80, 120],
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit",
    },
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.encoding": "utf8",
    "files.eol": "\\n",
    "files.associations": {
      "*.ps1": "powershell",
      "*.toml": "toml",
      "*.yml": "yaml",
      "*.yaml": "yaml",
      "*.json": "jsonc",
      "*.md": "markdown",
      "Dockerfile*": "dockerfile",
      "*.env.*": "properties",
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/bin": true,
      "**/obj": true,
      "**/target": true,
      "**/.git": true,
      "**/.vscode": true,
      "**/coverage": true,
      "**/*.log": true,
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/build": true,
      "**/bin": true,
      "**/obj": true,
      "**/.git": false,
      "**/coverage": true,
    },
    "typescript.preferences.includePackageJsonAutoImports": "on",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "typescript.suggest.autoImports": true,
    "typescript.inlayHints.parameterNames.enabled": "all",
    "typescript.inlayHints.variableTypes.enabled": true,
    "typescript.inlayHints.functionLikeReturnTypes.enabled": true,
    "javascript.preferences.includePackageJsonAutoImports": "on",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "javascript.suggest.autoImports": true,
    "powershell.integratedConsole.showOnStartup": false,
    "powershell.developer.bundledModulesPath": "",
    "powershell.powerShellDefaultVersion": "PowerShell (x64)",
    "powershell.codeFormatting.preset": "OTBS",
    "powershell.codeFormatting.openBraceOnSameLine": true,
    "powershell.codeFormatting.newLineAfterOpenBrace": true,
    "powershell.codeFormatting.newLineAfterCloseBrace": true,
    "powershell.codeFormatting.whitespaceBeforeOpenBrace": true,
    "powershell.codeFormatting.whitespaceBeforeOpenParen": true,
    "powershell.codeFormatting.whitespaceAroundOperator": true,
    "powershell.codeFormatting.whitespaceAfterSeparator": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.profiles.windows": {
      "PowerShell": {
        "source": "PowerShell",
        "icon": "terminal-powershell",
        "args": ["-NoLogo"],
      },
      "Command Prompt": {
        "path": ["${env:windir}\\Sysnative\\cmd.exe", "${env:windir}\\System32\\cmd.exe"],
        "args": [],
        "icon": "terminal-cmd",
      },
      "TerraFusion Dev": {
        "path": "pwsh.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-Command",
          "Write-Host '🏛️ TerraFusion Elite Government OS - Engineering Agent Active' -ForegroundColor Cyan; Write-Host 'Government. Transcended. - Infrastructure Intelligence, Infinite Scale' -ForegroundColor Green; Write-Host ''; Set-Location '${workspaceFolder}'",
        ],
        "icon": "settings-gear",
      },
    },
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.fontFamily": "'Cascadia Code', 'Fira Code', Consolas, monospace",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "line",
    "git.confirmSync": false,
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "git.suggestSmartCommit": true,
    "git.decorations.enabled": true,
    "gitlens.views.repositories.files.layout": "tree",
    "gitlens.views.fileHistory.enabled": true,
    "gitlens.views.lineHistory.enabled": true,
    "gitlens.currentLine.enabled": true,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.statusBar.enabled": true,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.compactFolders": false,
    "breadcrumbs.enabled": true,
    "breadcrumbs.showFiles": true,
    "breadcrumbs.showSymbols": true,
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.startupEditor": "welcomePage",
    "extensions.autoUpdate": true,
    "extensions.autoCheckUpdates": true,
    "problems.decorations.enabled": true,
    "outline.showClasses": true,
    "outline.showFunctions": true,
    "outline.showVariables": true,
    "outline.showModules": true,
    "json.schemas": [
      {
        "fileMatch": ["**/package.json"],
        "url": "https://json.schemastore.org/package.json",
      },
      {
        "fileMatch": ["**/tsconfig.json", "**/tsconfig.*.json"],
        "url": "https://json.schemastore.org/tsconfig.json",
      },
      {
        "fileMatch": ["**/.eslintrc.json", "**/.eslintrc"],
        "url": "https://json.schemastore.org/eslintrc.json",
      },
    ],
    "yaml.schemas": {
      "https://json.schemastore.org/docker-compose.json": ["**/docker-compose*.yml", "**/docker-compose*.yaml"],
      "https://raw.githubusercontent.com/kubernetes/kubernetes/master/api/openapi-spec/swagger.json": [
        "**/k8s/**/*.yml",
        "**/k8s/**/*.yaml",
        "**/kubernetes/**/*.yml",
        "**/kubernetes/**/*.yaml",
      ],
    },
    "eslint.workingDirectories": [
      {
        "pattern": "./ecosystem/intake",
      },
      {
        "pattern": "./frontend",
      },
      {
        "pattern": "./terrabuild-modernization",
      },
    ],
    "eslint.format.enable": true,
    "eslint.codeAction.showDocumentation": {
      "enable": true,
    },
    "prettier.configPath": ".prettierrc",
    "prettier.ignorePath": ".prettierignore",
    "markdownlint.config": {
      "MD013": false,
      "MD033": false,
      "MD041": false,
    },
    "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
    "dotnet.inlayHints.enableInlayHintsForImplicitVariableTypes": true,
    "dotnet.inlayHints.enableInlayHintsForLambdaParameterTypes": true,
    "dotnet.inlayHints.enableInlayHintsForImplicitObjectCreation": true,
    "omnisharp.enableEditorConfigSupport": true,
    "csharp.format.enable": true,
    "csharp.semanticHighlighting.enabled": true,
    "docker.showStartPage": false,
    "kubernetes.vs-kubernetes.draft-path": "",
    "kubernetes.vs-kubernetes.helm-path": "",
    "kubernetes.vs-kubernetes.minikube-path": "",
    "kubernetes.vs-kubernetes.kubectl-path": "",
    "redhat.telemetry.enabled": false,
    "telemetry.telemetryLevel": "off",
    "workbench.settings.enableNaturalLanguageSearch": false,
    "security.workspace.trust.enabled": false,
    "github.copilot.enable": {
      "*": true,
      "yaml": true,
      "plaintext": false,
      "markdown": true,
      "typescript": true,
      "javascript": true,
      "powershell": true,
      "csharp": true,
      "json": true,
      "jsonc": true,
    },
    "github.copilot.editor.enableAutoCompletions": true,
    "github.copilot.chat.followUps": "on",
    "terminal.integrated.env.windows": {
      "TERRAFUSION_WORKSPACE": "${workspaceFolder}",
      "TERRAFUSION_ENV": "development",
      "TERRAFUSION_AGENT": "elite-government-os",
      "NODE_ENV": "development",
    },
    "dotnet.formatting.organizeImportsOnFormat": true,
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "🏛️ TerraFusion: System Status",
        "type": "shell",
        "command": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/ecosystem/intake/status-check.ps1"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "new",
          "showReuseMessage": true,
          "clear": false,
        },
        "problemMatcher": [],
      },
      {
        "label": "🔍 ZT-IP: Scan Legacy Application",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/ecosystem/intake/zt-intake-cli.ps1",
          "-Action",
          "scan",
          "-AppPath",
          "${input:legacyAppPath}",
        ],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": true,
          "panel": "new",
        },
        "problemMatcher": [],
      },
      {
        "label": "🚀 ZT-IP: Execute Integration",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/ecosystem/intake/zt-intake-cli.ps1",
          "-Action",
          "integrate",
          "-AppPath",
          "${input:legacyAppPath}",
        ],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": true,
          "panel": "new",
        },
        "problemMatcher": [],
      },
      {
        "label": "🎬 ZT-IP: Run Demo",
        "type": "shell",
        "command": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/ecosystem/intake/simple-demo.ps1"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": true,
          "panel": "new",
          "clear": true,
        },
        "problemMatcher": [],
      },
      {
        "label": "📦 Install ZT-IP Dependencies",
        "type": "shell",
        "command": "npm",
        "args": ["install"],
        "options": {
          "cwd": "${workspaceFolder}/ecosystem/intake",
        },
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared",
        },
        "problemMatcher": ["$eslint-stylish"],
      },
      {
        "label": "🔧 Build Backend Services",
        "type": "shell",
        "command": "dotnet",
        "args": ["build", "TerraFusion.sln"],
        "options": {
          "cwd": "${workspaceFolder}/backend",
        },
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared",
        },
        "problemMatcher": ["$msCompile"],
      },
      {
        "label": "🌐 Start Frontend Development",
        "type": "shell",
        "command": "npm",
        "args": ["run", "dev"],
        "options": {
          "cwd": "${workspaceFolder}/frontend",
        },
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "dedicated",
        },
        "isBackground": true,
        "problemMatcher": {
          "owner": "webpack",
          "pattern": {
            "regexp": "^([^\\s].*)\\((\\d+),(\\d+)\\):\\s+(warning|error)\\s+(\\w+):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "code": 5,
            "message": 6,
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^\\s*webpack",
            "endsPattern": "^\\s*webpack .* compiled",
          },
        },
      },
      {
        "label": "🤖 Start AI Agent Systems",
        "type": "shell",
        "command": "npm",
        "args": ["run", "dev"],
        "options": {
          "cwd": "${workspaceFolder}/ai-systems",
        },
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "dedicated",
        },
        "isBackground": true,
        "problemMatcher": [],
      },
      {
        "label": "🏗️ Start TerraBuild Modernization",
        "type": "shell",
        "command": "npm",
        "args": ["run", "dev"],
        "options": {
          "cwd": "${workspaceFolder}/terrabuild-modernization",
        },
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "dedicated",
        },
        "isBackground": true,
        "problemMatcher": [],
      },
      {
        "label": "🎯 TerraFusion: Full Development Stack",
        "dependsOrder": "parallel",
        "dependsOn": [
          "🔧 Build Backend Services",
          "🌐 Start Frontend Development",
          "🤖 Start AI Agent Systems",
          "🏗️ Start TerraBuild Modernization",
        ],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": true,
          "panel": "new",
        },
        "problemMatcher": [],
      },
      {
        "label": "🧪 Run All Tests",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-Command",
          "Write-Host '🧪 Running TerraFusion Test Suite...' -ForegroundColor Cyan; cd '${workspaceFolder}/ecosystem/intake' && npm test; cd '${workspaceFolder}/backend' && dotnet test; cd '${workspaceFolder}/frontend' && npm test",
        ],
        "group": "test",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": true,
          "panel": "new",
        },
        "problemMatcher": ["$eslint-stylish", "$msCompile"],
      },
      {
        "label": "🛡️ Security Audit",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-Command",
          "Write-Host '🛡️ Running TerraFusion Security Audit...' -ForegroundColor Red; cd '${workspaceFolder}/ecosystem/intake' && npm audit; cd '${workspaceFolder}/frontend' && npm audit; Write-Host '✅ Security audit completed' -ForegroundColor Green",
        ],
        "group": "test",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": true,
          "panel": "new",
        },
        "problemMatcher": [],
      },
      {
        "label": "🔍 Code Quality Check",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-Command",
          "Write-Host '🔍 Running TerraFusion Code Quality Check...' -ForegroundColor Yellow; cd '${workspaceFolder}/ecosystem/intake' && npm run lint; cd '${workspaceFolder}/frontend' && npm run lint; Write-Host '✅ Code quality check completed' -ForegroundColor Green",
        ],
        "group": "test",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": true,
          "panel": "new",
        },
        "problemMatcher": ["$eslint-stylish"],
      },
    ],
    "inputs": [
      {
        "id": "legacyAppPath",
        "description": "Path to legacy application for ZT-IP processing",
        "default": "C:\\LegacyApps\\SampleApp",
        "type": "promptString",
      },
    ],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🏛️ TerraFusion API",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "🔧 Build Backend Services",
        "program": "${workspaceFolder}/backend/TerraFusion.API/bin/Debug/net8.0/TerraFusion.API.dll",
        "args": [],
        "cwd": "${workspaceFolder}/backend/TerraFusion.API",
        "stopAtEntry": false,
        "serverReadyAction": {
          "action": "openExternally",
          "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        },
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "TERRAFUSION_ENV": "development",
        },
        "sourceFileMap": {
          "/Views": "${workspaceFolder}/Views",
        },
      },
      {
        "name": "🤖 TerraFusion AI Consciousness",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "🔧 Build Backend Services",
        "program": "${workspaceFolder}/backend/TerraFusion.Consciousness/bin/Debug/net8.0/TerraFusion.Consciousness.dll",
        "args": [],
        "cwd": "${workspaceFolder}/backend/TerraFusion.Consciousness",
        "stopAtEntry": false,
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:3004",
        },
      },
      {
        "name": "🔍 ZT-IP Scanner (Node.js)",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/ecosystem/intake/scan-runner.js",
        "args": ["${input:legacyAppPath}", "report"],
        "cwd": "${workspaceFolder}/ecosystem/intake",
        "env": {
          "NODE_ENV": "development",
          "TERRAFUSION_ENV": "development",
        },
        "console": "integratedTerminal",
        "skipFiles": ["<node_internals>/**"],
      },
      {
        "name": "🚀 ZT-IP Integration (Node.js)",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/ecosystem/intake/integration-runner.js",
        "args": ["${input:legacyAppPath}"],
        "cwd": "${workspaceFolder}/ecosystem/intake",
        "env": {
          "NODE_ENV": "development",
          "TERRAFUSION_ENV": "development",
        },
        "console": "integratedTerminal",
        "skipFiles": ["<node_internals>/**"],
      },
      {
        "name": "🏗️ TerraBuild Server",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/terrabuild-modernization/server/index.ts",
        "args": [],
        "cwd": "${workspaceFolder}/terrabuild-modernization",
        "env": {
          "NODE_ENV": "development",
          "PORT": "5000",
        },
        "console": "integratedTerminal",
        "skipFiles": ["<node_internals>/**"],
        "runtimeArgs": ["--loader", "tsx/esm"],
      },
    ],
    "compounds": [
      {
        "name": "🎯 TerraFusion Full Stack",
        "configurations": ["🏛️ TerraFusion API", "🤖 TerraFusion AI Consciousness", "🏗️ TerraBuild Server"],
        "stopAll": true,
        "presentation": {
          "hidden": false,
          "group": "TerraFusion",
          "order": 1,
        },
      },
    ],
  },
