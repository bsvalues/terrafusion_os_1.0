  "description": "TerraFusion Payment in Lieu of Taxes (PILT) Management - Government Revenue Excellence",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
