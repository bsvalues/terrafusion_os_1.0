{
  "name": "terra-levy",
  "displayName": "TerraLevy - Quantum Levy Management",
  "version": "1.0.0",
  "description": "Championship-level levy calculation, scenario analysis, and revenue projection system with quantum optimization and AI-driven compliance validation. Government. Transcended.",
  "author": "TerraFusion Elite Government OS Team",
  "category": "government-finance",
  "icon": "balance-scale-quantum",
  "targetCounties": [
    "benton",
    "king",
    "pierce",
    "spokane",
    "thurston",
    "*"
  ],
  "permissions": [
    "load:terra-levy",
    "read:levy-measures",
    "write:levy-scenarios",
    "read:levy-projections",
    "write:levy-calculations",
    "read:districts",
    "read:revenue-data"
  ],
  "requiredServices": [
    "terrafusion-api",
    "levy-calculation-service",
    "revenue-projection-service"
  ],
  "entryPoint": "index.tsx",
  "routes": [
    {
      "path": "/levy",
      "component": "LevyDashboard",
      "title": "Levy Management Dashboard",
      "icon": "dashboard-quantum"
    },
    {
      "path": "/levy/measures",
      "component": "LevyMeasuresView",
      "title": "Levy Measures",
      "icon": "document-check"
    },
    {
      "path": "/levy/measures/:id",
      "component": "LevyMeasureDetail",
      "title": "Levy Measure Detail",
      "icon": "document-detail"
    },
    {
      "path": "/levy/scenarios",
      "component": "ScenariosListView",
      "title": "Scenario Analysis",
      "icon": "chart-network"
    },
    {
      "path": "/levy/scenarios/compare",
      "component": "CompareView",
      "title": "Compare Scenarios",
      "icon": "compare-quantum"
    },
    {
      "path": "/levy/projections",
      "component": "ProjectionsView",
      "title": "Revenue Projections",
      "icon": "chart-line-up"
    },
    {
      "path": "/levy/calculate",
      "component": "LevyCalculatorView",
      "title": "Levy Calculator",
      "icon": "calculator-quantum"
    }
  ],
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@tanstack/react-query": "^5.0.0",
    "recharts": "^2.10.0",
    "date-fns": "^3.0.0"
  },
  "apiEndpoints": {
    "baseUrl": "/levy",
    "health": {
      "method": "GET",
      "path": "/levy/health"
    },
    "districts": {
      "method": "GET",
      "path": "/levy/districts"
    },
    "measures": {
      "list": {
        "method": "GET",
        "path": "/levy/measures"
      },
      "getById": {
        "method": "GET",
        "path": "/levy/measures/:id"
      },
      "compliance": {
        "method": "GET",
        "path": "/levy/measures/:id/compliance"
      }
    },
    "calculate": {
      "method": "POST",
      "path": "/levy/calculate"
    },
    "scenarios": {
      "list": {
        "method": "GET",
        "path": "/levy/scenarios"
      },
      "analyze": {
        "method": "POST",
        "path": "/levy/scenarios/analyze"
      },
      "compare": {
        "method": "POST",
        "path": "/levy/scenarios/compare"
      }
    },
    "projections": {
      "list": {
        "method": "GET",
        "path": "/levy/projections"
      },
      "generate": {
        "method": "POST",
        "path": "/levy/projections/generate"
      }
    }
  },
  "features": {
    "quantumOptimization": {
      "enabled": true,
      "factor": 949,
      "targetAccuracy": 0.995
    },
    "aiDrivenCompliance": {
      "enabled": true,
      "frameworks": ["RCW", "WAC", "STATUTORY_LIMITS"]
    },
    "scenarioAnalysis": {
      "enabled": true,
      "maxScenariosPerCompare": 10
    },
    "revenueProjections": {
      "enabled": true,
      "maxYears": 10,
      "confidenceIntervals": true
    },
    "realTimeCalculation": {
      "enabled": true,
      "quantumAccelerated": true
    }
  },
  "governmentCompliance": {
    "fisma": "HIGH",
    "nist": "800-53",
    "wcag": "2.1-AA",
    "dataResidency": "county-sovereign",
    "auditTrail": "comprehensive"
  },
  "brandVoice": "Government. Transcended.",
  "quantumTheme": {
    "primaryColor": "#00FFFF",
    "accentColor": "#0099FF",
    "gradientTheme": "clarity-gradient",
    "animationStyle": "quantum-pulse"
  },
  "minimumVersion": {
    "terrafusionOS": "1.0.0",
    "terrafusionAPI": "1.0.0"
  },
  "launchPriority": "high",
  "autoLoadCounties": ["benton"],
  "championship": {
    "accuracy": "99.5%+",
    "uptime": "99.99%",
    "scalability": "infinite",
    "optimizationFactor": 949
  }
}
