# TerraLevy Module Environment Configuration
# Copy this file to .env for local development

# Telemetry Configuration
# Enable telemetry emission (default: false for tests/dev, true for production)
VITE_ENABLE_TELEMETRY=false

# Application Insights Instrumentation Key (required when telemetry enabled)
# Get from Azure Portal > Application Insights > Properties
# VITE_APP_INSIGHTS_KEY=your-instrumentation-key-here

# API Configuration
# TerraLevy backend API base URL
VITE_API_BASE_URL=http://localhost:5000/api/levy
