# Snyk Policy File
# https://docs.snyk.io/snyk-cli/commands/policy
#
# Excludes derived/copied module trees from scanning to prevent duplicate PRs.
# See docs/ci/BRANCH_HYGIENE.md for authoritative manifest policy.

version: v1.25.0

exclude:
  global:
    # Deployment copies (not authoritative source)
    - deployment/**/package.json
    - deployment/**/package-lock.json
    - deployment/**/pnpm-lock.yaml

    # Championship deployment nested copies
    - '**/championship-deployment/**/package.json'
    - '**/championship-deployment/**/package-lock.json'

    # Review/staging copies
    - packages/government-edition-enhanced-MARKED-FOR-REVIEW/**

    # Build artifact subdirectories
    - '**/*-PRODUCTION/**/package.json'
    - '**/*-PRODUCTION/**/package-lock.json'

    # Duplicate infrastructure copies
    - docker/Dockerfile.*
    - '**/devops-kit/docker/**'
    - infrastructure/iac/container-optimization/**

    # Data/cost-matrices (derived workspace)
    - data/cost-matrices/**

    # Costforge copies (authoritative: marketplace/government-core/costforge-ai-enhanced/)
    - packages/**/08-costforge-ai/**
    - infrastructure/marketplace-unified/**/08-costforge-ai/**
    - costforge-ai-workspace/**
