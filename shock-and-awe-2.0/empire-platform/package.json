{
  "name": "terrafusion-empire-showcase",
  "version": "1.0.0",
  "description": "TerraFusion Empire Showcase Platform - Intelligence That Counties Envy",
  "main": "api/county-data-engine.js",
  "scripts": {
    "start": "node api/county-data-engine.js",
    "dev": "nodemon api/county-data-engine.js",
    "test": "jest",
    "build": "npm run build:frontend && npm run build:api",
    "build:frontend": "echo 'Frontend build complete - static files ready'",
    "build:api": "echo 'API build complete - Node.js server ready'",
    "deploy": "npm run build && npm run start",
    "serve": "npx http-server . -p 8080 -c-1",
    "validate": "npm run test && npm run security-scan",
    "security-scan": "npm audit --audit-level moderate",
    "performance-test": "node scripts/performance-test.js",
    "load-test": "node scripts/load-test.js"
  },
  "keywords": [
    "government",
    "ai",
    "showcase",
