      "name": "gov.events",
      "vhost": "/terrafusion",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "gov.dlx",
      "vhost": "/terrafusion",
