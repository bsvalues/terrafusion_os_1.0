        "x-message-ttl": 3600000,
        "x-max-length": 50000,
        "x-dead-letter-exchange": "gov.dlx"
      }
    },
    {
      "name": "agent.commands",
      "vhost": "/ai_agents",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-message-ttl": 1800000,
        "x-max-length": 1000000,
        "x-dead-letter-exchange": "agent.dlx"
      }
    },
    {
      "name": "agent.events",
      "vhost": "/ai_agents",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-message-ttl": 1800000,
        "x-max-length": 1000000,
        "x-dead-letter-exchange": "agent.dlx"
