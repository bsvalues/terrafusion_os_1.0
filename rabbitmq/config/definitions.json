    },
    {
      "user": "terrafusion",
      "vhost": "/government_ops",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "topic_permissions": [],
  "parameters": [],
  "global_parameters": [
    {
      "name": "cluster_name",
      "value": "terrafusion-cluster"
    }
  ],
  "policies": [
    {
      "vhost": "/terrafusion",
      "name": "government-ha-policy",
      "pattern": "gov\\.",
      "apply-to": "all",
      "definition": {
        "ha-mode": "all",
        "ha-sync-mode": "automatic",
        "message-ttl": 3600000,
        "max-length": 100000
      },
      "priority": 1
    },
    {
      "vhost": "/ai_agents",
      "name": "ai-agent-policy",
      "pattern": "agent\\.",
      "apply-to": "all",
      "definition": {
        "ha-mode": "all",
        "ha-sync-mode": "automatic",
        "message-ttl": 1800000,
        "max-length": 1000000
      },
      "priority": 1
    }
  ],
  "queues": [
    {
      "name": "gov.citizen.events",
      "vhost": "/terrafusion",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-message-ttl": 3600000,
        "x-max-length": 50000,
        "x-dead-letter-exchange": "gov.dlx"
      }
    },
    {
      "name": "gov.permit.events",
      "vhost": "/terrafusion",
      "durable": true,
      "auto_delete": false,
