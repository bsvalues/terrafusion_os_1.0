{
  "title": "Golden Service \u2014 SRE",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(kube_pod_info, namespace)",
        "current": {
          "text": "golden",
          "value": "golden"
        }
      },
      {
        "name": "route",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(grfe_requests_total, route)",
        "current": {
          "text": "all",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Req/s",
      "targets": [
        {
          "expr": "sum(rate(grfe_requests_total{namespace=\"$namespace\"}[1m]))"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Req/s by route",
      "targets": [
        {
          "expr": "sum by (route) (rate(grfe_requests_total{namespace=\"$namespace\"}[1m]))"
        }
      ]
    },
    {
      "type": "graph",
      "title": "p95 latency (ingress)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nginx_ingress_controller_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le))"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Error rate (5xx%)",
      "targets": [
        {
          "expr": "sum(rate(nginx_ingress_controller_requests{status=~\"5..\",namespace=\"$namespace\"}[5m])) / sum(rate(nginx_ingress_controller_requests{namespace=\"$namespace\"}[5m]))"
        }
      ]
    },
    {
      "type": "graph",
      "title": "CPU (service)",
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"grfe.*\"}[2m]))"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Memory (service)",
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_usage_bytes{namespace=\"$namespace\",pod=~\"grfe.*\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Quota Rejections/min",
      "targets": [
        {
          "expr": "sum(increase(grfe_quota_reject_total{namespace=\"$namespace\"}[5m]))"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}