# TerraLevy API Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Service Endpoints (Internal Microservices)
CORE_SERVICES_URL=http://localhost:5000
COLLECTION_ENGINE_URL=http://localhost:5001
ANALYTICS_PLATFORM_URL=http://localhost:5002
CITIZEN_PORTAL_URL=http://localhost:5003

# Database Configuration
DATABASE_URL=postgresql://localhost:5432/terralevy
REDIS_URL=redis://localhost:6379

# Security (FISMA-HIGH Compliance)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
ENCRYPTION_KEY=your-256-bit-encryption-key

# AI Services
AI_SERVICE_URL=http://localhost:8001
QUANTUM_SERVICE_URL=http://localhost:8002

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Audit Logging (FISMA-HIGH)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=detailed
