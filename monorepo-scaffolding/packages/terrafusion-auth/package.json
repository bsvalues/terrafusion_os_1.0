{
  "name": "@terrafusion/auth",
  "version": "1.0.0",
  "description": "TerraFusion Authentication Utilities - Government Security",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "security:scan": "audit-ci --config .audit-ci.json",
    "clean": "rimraf dist"
  },
  "keywords": [
    "terrafusion",
    "auth",
    "authentication",
    "security",
    "government",
    "fisma",
    "jwt",
    "oauth"
  ],
  "author": "TerraFusion Elite Government OS Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "jsonwebtoken": "^9.0.0",
    "jose": "^5.0.0",
    "bcryptjs": "^2.4.0",
    "crypto-js": "^4.2.0",
    "uuid": "^9.0.0",
    "axios": "^1.6.0",
    "date-fns": "^3.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/crypto-js": "^4.2.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "rollup": "^4.0.0",
    "jest": "^29.5.0",
    "rimraf": "^5.0.0",
    "audit-ci": "^6.6.0"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
