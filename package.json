{
  "name": "terrafusion-os",
  "version": "1.0.0",
  "description": "Government AI Operating System - Coordination Repository (Polyrepo Architecture)",
  "main": "frontend/electron/main.js",
  "homepage": "./",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/bsvalues/terrafusion_os_1.0.git"
  },
  "polyrepo": {
    "architecture": "Domain-Driven Design (DDD)",
    "totalRepositories": 12,
    "extractionPhase": "Phase 3C (October 2025)",
    "repositories": {
      "core": [
        "@terrafusion/core",
        "@terrafusion/shared",
        "@terrafusion/packages",
        "@terrafusion/modules"
      ],
      "domains": [
        "terrafusion-government-platform",
        "terrafusion-commercial-platform",
        "terrafusion-ai-platform",
        "terrafusion-infrastructure-platform"
      ],
      "specialized": [
        "terrafusion-specialized-modules",
        "terrafusion-developer-tools",
        "terrafusion-docs",
        "terrafusion-ui-components"
      ]
    },
    "documentation": [
      "POLYREPO_MIGRATION_GUIDE.md",
      "POLYREPO_QUICK_REFERENCE.md",
      "POLYREPO_STATUS.md",
      "REPOSITORY_DEPENDENCIES.md"
    ]
  },
  "scripts": {
    "tf": "node tools/tf.js",
    "tdc": "node tools/tf.js",
    "console": "node tools/tf.js",
    "ai-agent-info": "echo 'TERRAFUSION OS - Complete Government Operating System with 50,000+ AI Agents. NOT a web app. Read AI_AGENT_START_HERE.md first!'",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "dotnet watch run --project backend/Terrafusion.API/Terrafusion.API.csproj",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:setup": "node scripts/dev-setup.mjs",
    "backend:dev": "cd backend && dotnet run --project Terrafusion.API",
    "frontend:dev": "cd frontend && npm start",
    "electron": "npm run build:frontend && cd frontend/electron && npm run electron",
    "electron:dev": "concurrently \"npm run dev:backend\" \"cd frontend/electron && npm run electron:dev\"",
    "build": "npm run backend:build && npm run frontend:build",
    "backend:build": "cd backend && dotnet publish TerraFusion.sln -c Release -o ../dist/backend",
    "frontend:build": "cd frontend && npm run build",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "lint": "eslint src tests --ext .ts,.tsx,.js,.jsx",
    "lint:check": "eslint \"**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/basic.test.ts",
    "test:unit:watch": "vitest tests/unit tests/basic.test.ts",
    "test:unit:coverage": "vitest run --coverage tests/unit tests/basic.test.ts",
    "test:integration": "playwright test tests/integration --config=playwright.config.ts",
    "test:integration:headed": "playwright test tests/integration --headed",
    "test:e2e": "playwright test tests/e2e --config=playwright.config.ts",
    "test:e2e:headed": "playwright test tests/e2e --headed",
    "test:e2e:ui": "playwright test tests/e2e --ui",
    "test:playwright": "playwright test",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage": "npm run test:unit:coverage",
    "test:ci": "npm run test:unit",
    "test:ci:unit": "vitest run --coverage tests/unit tests/basic.test.ts",
    "test:ci:integration": "playwright test tests/integration --reporter=list",
    "test:ci:e2e": "playwright test tests/e2e --reporter=list",
    "test:ci:all": "npm run test:ci:unit && npm run test:ci:integration && npm run test:ci:e2e",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:verbose": "vitest run --reporter=verbose",
    "validate:ai-models": "node scripts/validate-ai-models.mjs",
    "backend:start:test": "cd backend && ASPNETCORE_ENVIRONMENT=Test dotnet run --project Terrafusion.API --urls=http://localhost:5000",
    "frontend:serve:test": "cd frontend && npm run preview -- --host --port 3000",
    "logs:collect": "mkdir -p logs && docker-compose logs > logs/docker-compose.log 2>&1 || echo 'No docker compose logs available'",
    "db:seed": "dotnet run --project backend/Terrafusion.API -- --seed",
    "db:reset": "dotnet ef database drop --project backend/Terrafusion.Data && npm run db:seed",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=list,html",
    "test:contracts": "vitest run tests/contracts/**/*.pact.test.ts",
    "mutate": "stryker run",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "lhci:serve": "npm run build && npm run start",
    "budget:print": "cat perf-budgets.json",
    "reports:merge": "node scripts/merge-lighthouse-budgets.mjs artifacts/lhci perf-budgets.json artifacts/reports",
    "reports:badge": "node scripts/update-readme-badge.mjs",
    "reports:coverage": "node scripts/generate-coverage-badge.mjs",
    "reports:budget-table": "node scripts/update-budget-table.mjs",
    "reports:failure-diff": "node scripts/generate-failure-diff.mjs",
    "reports:history": "node scripts/update-history.mjs",
    "gates": "node scripts/verify-quality-gates.mjs --coverage=0.97 --lcp=2500 --a11y=0",
    "backend:test": "cd backend && dotnet test",
    "frontend:test": "cd frontend && npm test",
    "migrate:data": "powershell -ExecutionPolicy Bypass -File ./migration/consolidate-data.ps1",
    "migrate:modules": "powershell -ExecutionPolicy Bypass -File ./migration/migrate-modules.ps1",
    "validate": "powershell -ExecutionPolicy Bypass -File ./migration/validate-system.ps1",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up",
    "deploy:windows": "powershell -ExecutionPolicy Bypass -File ./deployment/build-windows.ps1",
    "deploy:docker": "cd deployment/docker && docker build -t terrafusion-os:latest .",
    "deploy:terraform": "cd deployment/terraform && terraform apply -auto-approve",
    "mcp:init": "node mcp-init-validation.cjs init",
    "mcp:validate": "node mcp-init-validation.cjs validate",
    "companion": "cd ai-workspace-companion && npm run companion",
    "companion:dev": "cd ai-workspace-companion && npm run companion:dev",
    "companion:quiet": "cd ai-workspace-companion && npm run companion:quiet",
    "mcp:test": "node mcp-init-validation.js test-mcp",
    "test:mcp": "playwright test --config=playwright.mcp.config.ts",
    "test:government": "playwright test tests/government/",
    "test:ai-swarm": "playwright test tests/ai-swarm/",
    "test:quantum": "python3 backend/quantum-performance/quantum_test.py",
    "start:mcp": "claude-code --mcp-config ./mcp.config.js",
    "workflow:government": "node -e \"import('./claude-code-workflows.js').then(m => m.WorkflowOrchestrator.executeWorkflow('government-compliance-audit'))\"",
    "workflow:ai-swarm": "node -e \"import('./claude-code-workflows.js').then(m => m.WorkflowOrchestrator.executeWorkflow('ai-swarm-development'))\"",
    "security:scan": "node -e \"import('./mcp-security-config.js').then(m => new m.SecurityValidator(m.securityConfig).validateSecurityPosture())\"",
    "compliance:audit": "npm run mcp:validate && npm run security:scan",
    "performance:benchmark": "python backend/quantum-performance/quantum_performance_benchmark.py",
    "ai-swarm:monitor": "node backend/ai-swarm/orchestrators/supreme-commander-claude.js",
    "quantum:optimize": "python backend/quantum-performance/quantum_roi_calculator.py",
    "deploy:pilot": "tsx deployment/county-pilot-program.ts launch",
    "validate:plugin": "node ./scripts/validate-manifest.mjs modules/government-edition/PWA/plugin.json",
    "discover:tests:win": "powershell -ExecutionPolicy Bypass -File ./scripts/discover-all-tests.ps1",
    "discover:tests:unix": "bash ./scripts/discover-all-tests.sh",
    "discover:tests": "npm run discover:tests:win || npm run discover:tests:unix",
    "bench": "npm run bench:api && npm run bench:database && npm run bench:ai && npm run bench:report",
    "bench:api": "k6 run bench/suites/api-performance.bench.ts",
    "bench:database": "ts-node bench/suites/database-performance.bench.ts",
    "bench:ai": "python backend/ai-models/tests/benchmarks/run_benchmarks.py",
    "bench:integration": "ts-node bench/suites/integration-performance.bench.ts",
    "bench:report": "node bench/scripts/generate-report.js",
    "bench:ci": "npm run bench && node bench/scripts/validate-gates.js",
    "monitor-agents": "node scripts/ai-health-check.mjs",
    "ai-agent-briefing": "node scripts/ai-agent-briefing.mjs",
    "auto-correct": "node scripts/auto-corrector.mjs",
    "agent-violations": "cat AI_MONITORING/VIOLATION_TRACKER.md",
    "marketplace-training": "node scripts/marketplace-training-validation.mjs",
    "full-validation": "npm run ai-training && npm run monitor-agents && npm run marketplace-training && npm run auto-correct",
    "enhanced-training": "npm run ai-training && npm run marketplace-training && npm run monitor-agents",
    "lint:fix": "eslint src tests --ext .ts,.tsx,.js,.jsx --fix",
    "quality": "npm run lint && npm run format:check",
    "quality:fix": "npm run lint:fix && npm run format",
    "government:compliance": "npm run lint -- --rule 'jsx-a11y/*: error' --rule 'security/*: error'",
    "precommit": "npm run quality && npm test",
    "ai-training": "pwsh scripts/ai-agent-training.ps1",
    "validate-agent": "node sdk/terrafusion-os-sdk.js",
    "os-status": "echo 'TerraFusion OS: Government Operating System - 50,000+ AI Agents Operational'",
    "health:check": "ts-node .vscode/scripts/automated-health-check.ts",
    "health:check:verbose": "ts-node .vscode/scripts/automated-health-check.ts --verbose",
    "validate:pre-commit": "npm run lint && npm run type-check && npm test -- --passWithNoTests",
    "validate:pre-push": "npm run lint && npm run type-check && npm run test:all && npm run government:compliance",
    "validate:full": "npm run gates",
    "phd:verify": "echo '🎓 MIT PhD-Level Verification' && npm run health:check && npm run validate:full",
    "monitor:start": "ts-node .vscode/scripts/advanced-monitoring-system.ts",
    "remediate:auto": "ts-node .vscode/scripts/auto-remediation-engine.ts",
    "terrafusion:complete": "npm run health:check && npm run remediate:auto && npm run validate:full",
    "terrafusion:status": "echo '🏛️  TerraFusion OS Status' && npm run health:check && npm run monitor:start",
    "profile:start": "ts-node .vscode/scripts/real-time-performance-profiler.ts",
    "profile:30s": "PROFILE_DURATION=30000 ts-node .vscode/scripts/real-time-performance-profiler.ts",
    "profile:60s": "PROFILE_DURATION=60000 ts-node .vscode/scripts/real-time-performance-profiler.ts",
    "profile:5min": "PROFILE_DURATION=300000 ts-node .vscode/scripts/real-time-performance-profiler.ts",
    "generate:tests": "ts-node .vscode/scripts/comprehensive-test-generator.ts",
    "generate:tests:unit": "ts-node .vscode/scripts/comprehensive-test-generator.ts --unit-only",
    "generate:tests:integration": "ts-node .vscode/scripts/comprehensive-test-generator.ts --integration-only",
    "generate:tests:all": "npm run generate:tests && npm run test:all",
    "deploy:orchestrate": "ts-node .vscode/scripts/deployment-orchestrator.ts",
    "deploy:dev": "DEPLOY_ENV=development ts-node .vscode/scripts/deployment-orchestrator.ts",
    "deploy:staging": "DEPLOY_ENV=staging ts-node .vscode/scripts/deployment-orchestrator.ts",
    "deploy:production": "DEPLOY_ENV=production ts-node .vscode/scripts/deployment-orchestrator.ts",
    "terrafusion:phd": "echo '🎓 MIT PhD-Level Complete Verification' && npm run health:check && npm run profile:30s && npm run validate:full",
    "terrafusion:deploy": "echo '🚀 TerraFusion Deployment Pipeline' && npm run health:check && npm run test:all && npm run deploy:orchestrate"
  },
  "keywords": [
    "government",
    "ai",
    "operating-system",
    "property-valuation",
    "county-management",
    "pwa",
    "dotnet",
    "electron"
  ],
