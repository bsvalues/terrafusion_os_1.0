{
  "name": "terrafusion-os",
  "version": "1.0.0",
  "description": "Government AI Operating System - Coordination Repository (Polyrepo Architecture)",
  "main": "frontend/electron/main.js",
  "homepage": "./",
  "private": true,
  "type": "module",
  "bin": {
    "tf": "tools/bin/tf.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bsvalues/terrafusion_os_1.0.git"
  },
  "polyrepo": {
    "architecture": "Domain-Driven Design (DDD)",
    "totalRepositories": 12,
    "extractionPhase": "Phase 3C (October 2025)",
    "repositories": {
      "core": [
        "@terrafusion/core",
        "@terrafusion/shared",
        "@terrafusion/packages",
        "@terrafusion/modules"
      ],
      "domains": [
        "terrafusion-government-platform",
        "terrafusion-commercial-platform",
        "terrafusion-ai-platform",
        "terrafusion-infrastructure-platform"
      ],
      "specialized": [
        "terrafusion-specialized-modules",
        "terrafusion-developer-tools",
        "terrafusion-docs",
        "terrafusion-ui-components"
      ]
    },
    "documentation": [
      "POLYREPO_MIGRATION_GUIDE.md",
      "POLYREPO_QUICK_REFERENCE.md",
      "POLYREPO_STATUS.md",
      "REPOSITORY_DEPENDENCIES.md"
    ]
  },
  "scripts": {
    "r1:verify-evidence": "node tools/r1/verify-evidence.mjs",
    "r1:finalize-manifest": "node tools/r1/generate-final-manifest.mjs",
    "prepare": "husky install",
    "tf": "node tools/bin/tf.mjs",
    "tf:ship": "node tools/dev/tf-ship.mjs",
    "tf:slice": "node tools/dev/tf-slice.mjs",
    "tf:scope": "pnpm -C tools/scope-classifier scope -- --repoRoot=../..",
    "ci:scope-proof": "pnpm tf:scope",
    "ci:renovate-scope:log": "echo 'Renovate scope check simulated' > renovate_scope.log",
    "ci:dependency-scope-quarantine:log": "node scripts/governance/dependencyScopeQuarantine.mjs > ci_dependency_scope_quarantine.log 2>&1",
    "ci:dependency-scope-quarantine:gate": "node scripts/governance/dependencyScopeQuarantine.mjs",
    "ci:governance": "node scripts/governance/governanceSentinel.js",
    "ci:governance-proof": "pnpm run ci:scope-proof && pnpm run ci:renovate-scope:log && pnpm run ci:governance",
    "ci:governance-proof:log": "node scripts/ci/run_with_log.mjs pnpm run ci:governance-proof > ci_governance_proof.log 2>&1",
    "registry:generate": "tsx tools/registry/generate-modules.ts",
    "registry:check": "tsx tools/registry/generate-modules.ts --out frontend/apps/os-shell/src/config/generatedModules.ts && git diff --exit-code frontend/apps/os-shell/src/config/generatedModules.ts",
    "tdc": "node tools/bin/tf.mjs",
    "tdc:build": "tsc -p tools/tdc/tsconfig.json",
    "tdc:ui:tokens": "tsx tools/tdc/src/index.ts ui audit --tokens --out ui-token-compliance.contract.json --baseline ui-token-baseline.json",
    "tdc:ui:tokens:full": "tsx tools/tdc/src/index.ts ui audit --tokens --all --out ui-token-compliance.full.contract.json",
    "lint:ui": "pnpm -r --filter \"./frontend/apps/**\" --filter \"./packages/**\" lint",
    "ci:ui": "pnpm tdc:ui:tokens && pnpm lint:ui",
    "console": "node tools/bin/tf.mjs",
    "ai-agent-info": "echo 'TERRAFUSION OS - Complete Government Operating System with 50,000+ AI Agents. NOT a web app. Read AI_AGENT_START_HERE.md first!'",
    "dev:os:shell": "pnpm -C frontend run dev -- --open",
    "dev:os:modules": "node tools/dev/dev-os.mjs",
    "dev:os": "pnpm run dev:os:modules",
    "contract:check": "node tools/dev/manifest-guard.mjs",
    "verify:golden": "pnpm -C applications/terraforge-suite/harness run golden",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "concurrently -n api,pilot -c green,cyan \"cross-env ASPNETCORE_ENVIRONMENT=Development ASPNETCORE_URLS=http://localhost:5000 dotnet watch run --project backend/src/TerraFusion.API/TerraFusion.API.csproj\" \"pnpm run dev:pilot\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:preview": "node os-platform/core/pilot/dev-preview.mjs",
    "preview:smoke": "node os-platform/core/pilot/preview-smoke.mjs",
    "proof:r1:local": "node os-platform/core/pilot/r1-local-proof.mjs",
    "proof:benton:sync": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/benton-sync-proof.mjs",
    "proof:benton:comps": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/benton-comps-proof.mjs",
    "proof:phase5": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/phase5-proof-manifest.mjs",
    "proof:phase6": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/phase6-promotion-packet.mjs",
    "proof:phase7": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/phase7-deployment-alignment-packet.mjs",
    "proof:phase8": "node os-platform/core/pilot/phase8-deployed-operator-parity-packet.mjs",
    "proof:phase9": "node os-platform/core/pilot/phase9-runtime-role-separation-packet.mjs",
    "proof:phase10": "node os-platform/core/pilot/phase10-environment-identity-packet.mjs",
    "proof:phase11": "node os-platform/core/pilot/phase11-deployment-contract-packet.mjs",
    "proof:phase12": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/phase12-pacs-connected-runtime-packet.mjs",
    "proof:phase13": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/phase13-snapshot-promotion-packet.mjs",
    "proof:phase14": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/phase14-benton-operator-workflow-packet.mjs",
    "proof:phase15": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/phase15-data-quality-packet.mjs",
    "proof:phase16": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/phase16-monitoring-recovery-packet.mjs",
    "proof:phase17": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/phase17-go-live-packet.mjs",
    "proof:phase18": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/phase18-pacs-runtime-productization-packet.mjs",
    "proof:phase19": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/phase19-snapshot-promotion-automation-packet.mjs",
    "proof:phase20": "cross-env TF_API_PORT=5000 node os-platform/core/pilot/phase20-benton-acceptance-uat-packet.mjs",
    "backend:dev": "cross-env ASPNETCORE_ENVIRONMENT=Development ASPNETCORE_URLS=http://localhost:5000 dotnet run --project backend/src/TerraFusion.API/TerraFusion.API.csproj",
    "frontend:dev": "cd frontend && npm start",
    "dev:pilot": "cross-env TF_API_PORT=5000 PILOT_PORT=4317 node os-platform/core/pilot/dev-pilot-runtime.mjs",
    "electron": "npm run build:frontend && cd frontend/electron && npm run electron",
    "electron:dev": "concurrently \"npm run dev:backend\" \"cd frontend/electron && npm run electron:dev\"",
    "build": "npm run backend:build && npm run frontend:build",
    "backend:build": "cd backend && dotnet build TerraFusion.sln -c Release && dotnet publish src/TerraFusion.API/TerraFusion.API.csproj -c Release -o ../dist/backend/TerraFusion.API --no-build",
    "frontend:build": "cd frontend && npm run build",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx --no-error-on-unmatched-pattern --resolve-plugins-relative-to .",
    "lint:check": "eslint \"**/*.{ts,tsx}\"",
    "type-check": "tsc -p tsconfig.core.json",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test:governed": "pnpm run type-check && node --test os-platform/core/tests/phase83-tools.test.mjs",
    "test:governance:ui": "vitest run tests/governance/noNewRawColors.contract.test.ts tests/governance/uiTokenBaseline.contract.test.ts tests/governance/ratchetGuardScope.contract.test.ts tests/governance/tfHsAnchorsDefined.contract.test.ts",
    "lint:platform": "node scripts/platform-lint.mjs",
    "doctor": "node scripts/doctor.mjs",
    "tf:cli": "node tools/bin/tf.mjs",
    "canon": "node tools/canon/canon.mjs",
    "canon:doctor": "node tools/canon/canon.mjs doctor",
    "canon:gatefast": "node tools/canon/canon.mjs gatefast",
    "canon:ping": "node tools/canon/canon.mjs ping",
    "test:canon-gatefast": "node --test os-platform/core/tests/canon-gatefast.test.mjs",
    "test:canon-ping": "node --test os-platform/core/tests/canon-ping.test.mjs",
    "test:canon-doctor": "node --test os-platform/core/tests/canon-doctor.test.mjs",
    "trace:query": "node scripts/trace-query.mjs",
    "test:naming": "node --test tools/naming/naming-lint.test.mjs",
    "naming:lint": "node tools/naming/naming-lint.mjs",
    "support:bundle": "node scripts/support-bundle.mjs",
    "check:generated": "node tools/registry/check-generated-js.mjs",
    "build:core-js": "node tools/registry/build-core-js.mjs",
    "governance:check": "pnpm run typecheck:core && node --test os-platform/core/tests/phase83-tools.test.mjs && node --test os-platform/core/tests/phase85-tools.test.mjs && node --test os-platform/core/tests/phase86-toolrunner.test.mjs && node tools/registry/check-generated-js.mjs",
    "test": "npm run test:unit",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/basic.test.ts",
    "test:unit:watch": "vitest tests/unit tests/basic.test.ts",
    "test:unit:coverage": "vitest run --coverage tests/unit tests/basic.test.ts",
    "test:optional-deps": "vitest run tests/optional-deps",
    "test:integration": "playwright test tests/integration --config=tests/playwright.config.ts",
    "test:integration:headed": "playwright test tests/integration --headed",
    "test:e2e": "playwright test tests/e2e --config=tests/playwright.config.ts",
    "test:e2e:headed": "playwright test tests/e2e --config=tests/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test tests/e2e --config=tests/playwright.config.ts --ui",
    "e2e:pipeline": "tsx scripts/e2e-pipeline.ts",
    "test:playwright": "playwright test --config=tests/playwright.config.ts",
    "test:playwright:headed": "playwright test --config=tests/playwright.config.ts --headed",
    "test:playwright:debug": "playwright test --config=tests/playwright.config.ts --debug",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage": "npm run test:unit:coverage",
    "test:ci": "npm run test:unit",
    "test:ci:unit": "vitest run --coverage tests/unit tests/basic.test.ts",
    "test:ci:integration": "playwright test tests/integration --reporter=list",
    "test:ci:e2e": "playwright test tests/e2e --reporter=list",
    "test:ci:all": "npm run test:ci:unit && npm run test:ci:integration && npm run test:ci:e2e",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:verbose": "vitest run --reporter=verbose",
    "validate:ai-models": "node scripts/validate-ai-models.mjs",
    "backend:start:test": "cross-env ASPNETCORE_ENVIRONMENT=Test ASPNETCORE_URLS=http://localhost:5000 dotnet run --project backend/src/TerraFusion.API/TerraFusion.API.csproj",
    "frontend:serve:test": "cd frontend && npm run preview -- --host --port 3000",
    "logs:collect": "mkdir -p logs && docker-compose logs > logs/docker-compose.log 2>&1 || echo 'No docker compose logs available'",
    "db:seed": "dotnet run --project backend/src/TerraFusion.API/TerraFusion.API.csproj -- --seed",
    "db:reset": "dotnet ef database drop --project backend/src/TerraFusion.Data/TerraFusion.Data.csproj && npm run db:seed",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --config=tests/playwright.config.ts --reporter=list,html",
    "test:contracts": "vitest run tests/contracts/**/*.pact.test.ts",
    "mutate": "stryker run",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "lhci:serve": "npm run build && npm run start",
    "budget:print": "cat perf-budgets.json",
    "reports:merge": "node scripts/merge-lighthouse-budgets.mjs artifacts/lhci perf-budgets.json artifacts/reports",
    "reports:badge": "node scripts/update-readme-badge.mjs",
    "reports:coverage": "node scripts/generate-coverage-badge.mjs",
    "reports:budget-table": "node scripts/update-budget-table.mjs",
    "reports:failure-diff": "node scripts/generate-failure-diff.mjs",
    "reports:history": "node scripts/update-history.mjs",
    "gates": "node scripts/verify-quality-gates.mjs --coverage=0.97 --lcp=2500 --a11y=0",
    "backend:test": "cd backend && dotnet test",
    "frontend:test": "cd frontend && npm test",
    "migrate:data": "powershell -ExecutionPolicy Bypass -File ./migration/consolidate-data.ps1",
    "migrate:modules": "powershell -ExecutionPolicy Bypass -File ./migration/migrate-modules.ps1",
    "validate": "powershell -ExecutionPolicy Bypass -File ./migration/validate-system.ps1",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up",
    "deploy:windows": "powershell -ExecutionPolicy Bypass -File ./deployment/build-windows.ps1",
    "deploy:docker": "cd deployment/docker && docker build -t terrafusion-os:latest .",
    "deploy:terraform": "cd deployment/terraform && terraform apply -auto-approve",
    "mcp:init": "node mcp-init-validation.cjs init",
    "mcp:validate": "node mcp-init-validation.cjs validate",
    "companion": "cd ai-workspace-companion && npm run companion",
    "companion:dev": "cd ai-workspace-companion && npm run companion:dev",
    "companion:quiet": "cd ai-workspace-companion && npm run companion:quiet",
    "mcp:test": "node mcp-init-validation.js test-mcp",
    "test:mcp": "playwright test --config=playwright.mcp.config.ts",
    "test:government": "playwright test tests/government/",
    "test:ai-swarm": "playwright test tests/ai-swarm/",
    "test:ai-models": "npm run test:ai-swarm",
    "test:quantum": "python3 backend/quantum-performance/quantum_test.py",
    "start:mcp": "claude-code --mcp-config ./mcp.config.js",
    "workflow:government": "node -e \"import('./claude-code-workflows.js').then(m => m.WorkflowOrchestrator.executeWorkflow('government-compliance-audit'))\"",
    "workflow:ai-swarm": "node -e \"import('./claude-code-workflows.js').then(m => m.WorkflowOrchestrator.executeWorkflow('ai-swarm-development'))\"",
    "security:scan": "node tools/registry/security-scan-runner.mjs",
    "audit:contracts": "deno task -c tools/deno/terra_audit/deno.json audit:contracts",
    "compliance:audit": "npm run mcp:validate && npm run security:scan",
    "validate:compliance": "npm run compliance:audit",
    "performance:benchmark": "python backend/quantum-performance/quantum_performance_benchmark.py",
    "ai-swarm:monitor": "node backend/ai-swarm/orchestrators/supreme-commander-claude.js",
    "quantum:optimize": "python backend/quantum-performance/quantum_roi_calculator.py",
    "deploy:pilot": "tsx deployment/county-pilot-program.ts launch",
    "validate:plugin": "node ./scripts/validate-manifest.mjs modules/government-edition/PWA/plugin.json",
    "discover:tests:win": "powershell -ExecutionPolicy Bypass -File ./scripts/discover-all-tests.ps1",
    "discover:tests:unix": "bash ./scripts/discover-all-tests.sh",
    "discover:tests": "npm run discover:tests:win || npm run discover:tests:unix",
    "bench": "npm run bench:api && npm run bench:database && npm run bench:ai && npm run bench:report",
    "bench:api": "k6 run bench/suites/api-performance.bench.ts",
    "bench:database": "ts-node bench/suites/database-performance.bench.ts",
    "bench:ai": "python backend/ai-models/tests/benchmarks/run_benchmarks.py",
    "bench:integration": "ts-node bench/suites/integration-performance.bench.ts",
    "bench:report": "node bench/scripts/generate-report.js",
    "bench:ci": "npm run bench && node bench/scripts/validate-gates.js",
    "monitor-agents": "node scripts/ai-health-check.mjs",
    "ai-agent-briefing": "node scripts/ai-agent-briefing.mjs",
    "auto-correct": "node scripts/auto-corrector.mjs",
    "agent-violations": "cat AI_MONITORING/VIOLATION_TRACKER.md",
    "marketplace-training": "node scripts/marketplace-training-validation.mjs",
    "full-validation": "npm run ai-training && npm run monitor-agents && npm run marketplace-training && npm run auto-correct",
    "enhanced-training": "npm run ai-training && npm run marketplace-training && npm run monitor-agents",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix --no-error-on-unmatched-pattern --resolve-plugins-relative-to .",
    "quality": "npm run lint && npm run format:check",
    "quality:fix": "npm run lint:fix && npm run format",
    "government:compliance": "npm run lint -- --rule 'jsx-a11y/*: error' --rule 'security/*: error'",
    "precommit": "npm run quality && npm test",
    "ai-training": "pwsh scripts/ai-agent-training.ps1",
    "validate-agent": "node tools/registry/validate-agents.mjs",
    "validate:agents": "npm run validate-agent",
    "os-status": "echo 'TerraFusion OS: Government Operating System - 50,000+ AI Agents Operational'",
    "health:check": "ts-node .vscode/scripts/automated-health-check.ts",
    "health:check:verbose": "ts-node .vscode/scripts/automated-health-check.ts --verbose",
    "validate:pre-commit": "npm run lint && npm run type-check && npm test -- --passWithNoTests",
    "validate:pre-push": "npm run lint && npm run type-check && npm run test:all && npm run government:compliance",
    "validate:full": "npm run gates",
    "phd:verify": "echo '🎓 MIT PhD-Level Verification' && npm run health:check && npm run validate:full",
    "monitor:start": "ts-node .vscode/scripts/advanced-monitoring-system.ts",
    "remediate:auto": "ts-node .vscode/scripts/auto-remediation-engine.ts",
    "terrafusion:complete": "npm run health:check && npm run remediate:auto && npm run validate:full",
    "terrafusion:status": "echo '🏛️  TerraFusion OS Status' && npm run health:check && npm run monitor:start",
    "profile:start": "ts-node .vscode/scripts/real-time-performance-profiler.ts",
    "profile:30s": "PROFILE_DURATION=30000 ts-node .vscode/scripts/real-time-performance-profiler.ts",
    "profile:60s": "PROFILE_DURATION=60000 ts-node .vscode/scripts/real-time-performance-profiler.ts",
    "profile:5min": "PROFILE_DURATION=300000 ts-node .vscode/scripts/real-time-performance-profiler.ts",
    "generate:tests": "ts-node .vscode/scripts/comprehensive-test-generator.ts",
    "generate:tests:unit": "ts-node .vscode/scripts/comprehensive-test-generator.ts --unit-only",
    "generate:tests:integration": "ts-node .vscode/scripts/comprehensive-test-generator.ts --integration-only",
    "generate:tests:all": "npm run generate:tests && npm run test:all",
    "deploy:orchestrate": "ts-node .vscode/scripts/deployment-orchestrator.ts",
    "deploy:dev": "DEPLOY_ENV=development ts-node .vscode/scripts/deployment-orchestrator.ts",
    "deploy:staging": "DEPLOY_ENV=staging ts-node .vscode/scripts/deployment-orchestrator.ts",
    "deploy:production": "DEPLOY_ENV=production ts-node .vscode/scripts/deployment-orchestrator.ts",
    "terrafusion:phd": "echo '🎓 MIT PhD-Level Complete Verification' && npm run health:check && npm run profile:30s && npm run validate:full",
    "terrafusion:deploy": "echo '🚀 TerraFusion Deployment Pipeline' && npm run health:check && npm run test:all && npm run deploy:orchestrate",
    "perf:apply": "npx tsx tools/registry/perf-skill-audit/src/ralph-apply.ts",
    "perf:rollback": "npx tsx tools/registry/perf-skill-audit/src/perf-rollback.ts",
    "perf:dashboard": "npx tsx tools/registry/autonomy-viewer/src/generate.ts",
    "perf:bundle": "npx tsx tools/registry/autonomy-viewer/src/bundle.ts",
    "perf:verify-bundle": "npx tsx tools/registry/autonomy-viewer/src/verify-bundle.ts",
    "perf:verify-signature": "npx tsx tools/registry/autonomy-viewer/src/verify-signature.ts",
    "perf:custody": "npx tsx tools/registry/autonomy-viewer/src/custody-cli.ts",
    "perf:custody-attest": "npx tsx tools/registry/autonomy-viewer/src/custody-attest.ts",
    "perf:verify-custody": "npx tsx tools/registry/autonomy-viewer/src/verify-custody.ts",
    "tdc:ui:tokens:check": "tsx tools/registry/tdc-ui-tokens-check.ts"
  },
