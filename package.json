    "yargs": "^17.7.2"
  },
  "workspaces": [
    "frontend",
    "frontend/electron"
  ],
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "backend/**/*.cs": [
      "dotnet format"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "mcp": {
    "servers": {
      "terrafusion-enhanced": "./mcp-terrafusion-extension.js",
      "playwright-server": "@modelcontextprotocol/server-playwright",
      "filesystem": "@modelcontextprotocol/server-filesystem",
      "git": "@modelcontextprotocol/server-git"
    },
    "config": "./mcp.config.js",
    "workflows": "./claude-code-workflows.js",
    "security": "./mcp-security-config.js"
  },
  "terrafusion": {
