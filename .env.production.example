# TerraFusion OS Production Environment Template
# Use ${ENV_VAR} or replace values in your deployment environment.

COUNTY_NAME=${COUNTY_NAME}
COUNTY_STATE=${COUNTY_STATE}
COUNTY_CODE=${COUNTY_CODE}
COUNTY_FIPS=${COUNTY_FIPS}
ASPNETCORE_ENVIRONMENT=Production
TERRAFUSION_DEPLOYMENT_MODE=${TERRAFUSION_DEPLOYMENT_MODE}
GOVERNMENT_MODE=enabled
FISMA_COMPLIANCE_LEVEL=high

# Database
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=${POSTGRES_DB}
POSTGRES_USER=${POSTGRES_USER}
DATABASE_CONNECTION_POOL_SIZE=50
DATABASE_MAX_CONNECTIONS=200

# Redis
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_CONNECTION_POOL_SIZE=20

# TLS / Certificates
CERT_PASSWORD=${CERT_PASSWORD}
SSL_ENABLED=true
TLS_VERSION=1.3
ENCRYPTION_AT_REST=aes256
ENCRYPTION_IN_TRANSIT=tls13

# API Security
JWT_SECRET=${JWT_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
ELASTICSEARCH_PASSWORD=${ELASTICSEARCH_PASSWORD}

# Marketplace
MARKETPLACE_ENABLED=true
MARKETPLACE_BASE_URL=/api/marketplace
MARKETPLACE_AUTO_LOAD=true
MARKETPLACE_HOT_RELOAD=true
MARKETPLACE_MAX_PLUGIN_SIZE=50MB
MARKETPLACE_COMMISSION=0.30
MARKETPLACE_LICENSE_VALIDATION=true

# Data
DATA_PATH=./data
