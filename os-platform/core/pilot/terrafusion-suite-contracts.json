      "implementationAnchors": [
        {
          "path": "backend/src/TerraFusion.Core/Services/CountyStudySegmentDerivationService.cs",
          "patterns": [
            "DeriveAsync",
            "SegmentDerivationContractId",
            "Properties.AsNoTracking",
            "CamaCharacteristics.AsNoTracking",
            "ComparableSales.AsNoTracking",
            "SegmentDerivationResult"
          ]
        },
        {
          "path": "frontend/apps/os-shell/src/pages/forge/county-studio/countyStudyApi.ts",
          "patterns": [
            "derive-segments",
            "SegmentDerivationResult",
            "segmentSetApi"
          ]
        }
      ]
    },
    {
      "id": "terraforge_correction_priority_v1",
      "version": 1,
      "status": "codified",
      "population": "County Studio active segment alerts ranked for correction and defense workflow",
      "purpose": "Determine which segment/cohort problems route first into correction, approval, exception, and evidence workflows.",
      "owner": "TerraFusion.Core.Services.CountyStudyHealthService.ComputeCompositeRisk",
      "readPath": "GET /county-study/studies/{studyId}/health-summary plus GET /county-study/studies/{studyId}/evidence-packet",
      "sourceOfTruth": [
        "CountySegment metrics",
        "CountyStudyHealthService composite risk formula",
        "CountyExceptionSet lifecycle",
        "Evidence packet topRiskSegments"
      ],
      "metrics": [
        "correctionPriorityContractId",
        "compositeRisk",
        "reasons",
        "criticalCount",
        "warningCount",
        "healthyCount",
        "topAlerts",
        "topRiskSegments",
        "exceptionCount"
      ],
      "trustPosture": [
        "uses operational health population, not Statistics Compat population",
        "defense packet must carry segment-level trace",
        "exceptions remain workflow state, not metric truth"
      ],
      "proofArtifacts": [
        "os-platform/core/pilot/evidence/county-studio-correction-and-defense.latest.json",
        "os-platform/core/pilot/evidence/dev-data-truth-gate.latest.json"
      ],
      "forbiddenUses": [
        "Do not let AI summaries invent priority outside the composite risk contract.",
        "Do not rank demo/reference counties as production correction work.",
        "Do not export defense packets without segment-level trace."
      ],
      "implementationAnchors": [
        {
          "path": "backend/src/TerraFusion.Core/Services/CountyStudyHealthService.cs",
          "patterns": [
            "ComputeCompositeRisk",
            "CorrectionPriorityContractId",
            "BuildSegmentAlert",
            "OrderByDescending(a => a.CompositeRisk)",
            "CriticalCount"
          ]
        },
        {
          "path": "frontend/apps/os-shell/src/pages/forge/county-studio/countyStudyApi.ts",
          "patterns": [
            "correctionPriorityContractId",
            "EvidenceSegmentSignal",
            "topRiskSegments",
            "EvidencePacketDto"
          ]
        },
        {
          "path": "frontend/apps/os-shell/src/pages/forge/county-studio/components/CorrectionDefensePanel.tsx",
          "patterns": [
            "Correction & Defense Chain",
            "Promote Saved Scenario",
            "Export Evidence Packet"
          ]
        }
      ]
    }
  ],
  "agentEnforcement": {
    "mustReport": [
      "contract id",
      "population",
      "read path",
      "trust posture",
      "proof artifact"
    ],
    "rejectWhen": [
      "metric logic has no registered contract",
      "population is implicit",
      "demo/reference data is used as production proof",
      "AI summary lacks proof artifact",
      "County Studio health is compared directly to Statistics Compat"
    ]
  }
