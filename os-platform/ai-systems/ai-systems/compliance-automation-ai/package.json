{
  "name": "@terrafusion/compliance-automation-ai",
  "version": "2.0.0",
  "description": "Phase 2: AI-Powered Advanced Compliance Automation for TerraFusion OS",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "docs": "typedoc src/index.ts",
    "start:compliance-monitor": "node dist/compliance-monitor.js",
    "start:gap-analyzer": "node dist/gap-analyzer.js",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:security": "jest tests/security.test.js",
    "test:performance": "jest tests/performance.test.js",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:install": "cd mcp-server && npm install"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.20.0",
    "natural": "^6.12.0",
    "pdf-parse": "^1.1.1",
    "cheerio": "^1.0.0-rc.12",
    "axios": "^1.6.7",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "winston": "^3.11.0",
    "cron": "^3.1.6",
    "elastic-apm-node": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/uuid": "^9.0.8",
    "@types/lodash": "^4.14.202",
    "@types/cron": "^2.4.0",
    "typescript": "^5.4.2",
    "vitest": "^1.4.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "typedoc": "^0.25.12",
    "jest": "^29.0.0",
    "@jest/globals": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "supertest": "^6.0.0",
    "nyc": "^15.0.0"
  },
  "keywords": [
    "terrafusion",
    "compliance",
    "automation",
    "ai-powered",
    "gap-analysis",
    "phase-2",
    "government"
  ],
  "author": "TerraFusion AI Compliance Team",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "mcp": {
    "server": "./mcp-server",
    "tools": [
      "ai-model-executor",
      "consciousness-interface",
      "swarm-coordinator"
    ],
    "capabilities": [
      "external-services"
    ]
  }
}