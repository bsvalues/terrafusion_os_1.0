{
  "name": "ai-superintelligence-orchestrator-enhanced",
  "version": "2.0.0",
  "description": "MIT PhD AI Superintelligence Orchestrator with Consciousness, Quantum, and Spatiotemporal Intelligence",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:security": "jest tests/security.test.js",
    "test:performance": "jest tests/performance.test.js",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:install": "cd mcp-server && npm install"
  },
  "keywords": [
    "ai",
    "orchestration",
    "consciousness",
    "quantum",
    "spatiotemporal",
    "mcp",
    "government",
    "superintelligence"
  ],
  "author": "MIT PhD Systems Design Engineer",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "@jest/globals": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "supertest": "^6.0.0",
    "nyc": "^15.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/ai-superintelligence-orchestrator-enhanced.git"
  },
  "bugs": {
    "url": "https://github.com/terrafusion/ai-superintelligence-orchestrator-enhanced/issues"
  },
  "homepage": "https://github.com/terrafusion/ai-superintelligence-orchestrator-enhanced#readme",
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "mcp": {
    "server": "./mcp-server",
    "tools": [
      "ai-model-executor",
      "consciousness-interface",
      "swarm-coordinator"
    ],
    "capabilities": []
  }
}