{
  "mcpServers": {
    "claude-flow": {
      "command": "npx",
      "args": ["claude-flow@alpha", "mcp-server"],
      "env": {
        "CLAUDE_FLOW_MODE": "government",
        "TERRAFUSION_INTEGRATION": "true",
        "GOVERNMENT_GRADE": "true",
        "JURISDICTION_ISOLATION": "county"
      }
    },
    "ruv-swarm": {
      "command": "npx", 
      "args": ["ruv-swarm", "mcp-server"],
      "env": {
        "SWARM_MODE": "hive-mind",
        "COORDINATION_LEVEL": "queen-led",
        "NEURAL_ENHANCEMENT": "true"
      }
    },
    "terrafusion-government": {
      "command": "node",
      "args": ["./backend/mcp-servers/government-server/index.js"],
      "env": {
        "HARRIS_PACS_INTEGRATION": "true",
        "REVENUE_DISCOVERY": "true",
        "PROPERTY_ASSESSMENT": "true",
        "COMPLIANCE_MONITORING": "true"
      }
    },
    "harris-pacs-connector": {
      "command": "node",
      "args": ["./backend/mcp-servers/harris-pacs-server/index.js"],
      "env": {
        "PACS_VERSION": "12.4.7",
        "SYNC_FREQUENCY": "15000",
        "PARCEL_COUNT": "await DynamicPropertyService.GetPropertyCountAsync("benton")",
        "JURISDICTION": "benton_county_wa"
      }
    },
    "revenue-discovery-tools": {
      "command": "node", 
      "args": ["./backend/mcp-servers/revenue-server/index.js"],
      "env": {
        "AI_SWARM_SIZE": "300",
        "DISCOVERY_ALGORITHMS": "neural,pattern,predictive",
        "ROI_TRACKING": "true"
      }
    },
    "property-assessment-suite": {
      "command": "node",
      "args": ["./backend/mcp-servers/property-server/index.js"], 
      "env": {
        "ASSESSMENT_AGENTS": "200",
        "VALUATION_MODELS": "comparative,cost,income",
        "MARKET_DATA_INTEGRATION": "true"
      }
    },
    "compliance-monitoring-kit": {
      "command": "node",
      "args": ["./backend/mcp-servers/compliance-server/index.js"],
      "env": {
        "COMPLIANCE_AGENTS": "150", 
        "REGULATION_FRAMEWORKS": "FISMA,NIST,SOC2",
        "AUDIT_TRAIL": "comprehensive"
      }
    }
  }
}
