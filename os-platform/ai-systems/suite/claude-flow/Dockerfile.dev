# Claude-Flow v2.0.0 Alpha Development Dockerfile
# Optimized for TerraFusion OS integration with MCP tools and AI Swarm coordination
FROM node:18-alpine AS base

LABEL maintainer="TerraFusion AI Squad Alpha"
LABEL version="2.0.0-alpha"
LABEL component="claude-flow"
LABEL ai.hive-mind="enabled"
LABEL mcp.tools="87"

# Install system dependencies
RUN apk add --no-cache \
    curl \
    git \
    bash \
    python3 \
    py3-pip \
    sqlite \
    && rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S claudeflow && \
    adduser -S claudeflow -u 1001 -G claudeflow

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies
RUN npm ci --only=production && \
    npm cache clean --force

# Copy source code
COPY --chown=claudeflow:claudeflow . .

# Create required directories
RUN mkdir -p .swarm logs temp && \
    chown -R claudeflow:claudeflow .swarm logs temp

# Switch to non-root user
USER claudeflow

# Environment variables
ENV NODE_ENV=development \
    CLAUDE_FLOW_MODE=development \
    HIVE_MIND_ENABLED=true \
    MCP_TOOLS_COUNT=87 \
    AI_SWARM_INTEGRATION=true \
    SQLITE_DB_PATH=/app/.swarm/memory.db

# Expose ports
EXPOSE 8080 8081

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Start Claude-Flow with development features
CMD ["npm", "run", "dev"]
