# TerraFusion AI Swarm Orchestration Dockerfile
# Manages 1,008 AI agents for Benton County government operations
FROM python:3.11-alpine AS base

LABEL maintainer="TerraFusion AI Swarm Division"
LABEL swarm.size="1008"
LABEL county="benton"
LABEL integration="claude-flow"

# Install system dependencies
RUN apk add --no-cache \
    curl \
    git \
    bash \
    sqlite \
    redis \
    && rm -rf /var/cache/apk/*

# Create swarm user
RUN addgroup -g 1001 -S swarm && \
    adduser -S swarm -u 1001 -G swarm

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy swarm orchestration code
COPY --chown=swarm:swarm . .

# Create swarm directories
RUN mkdir -p swarm/agents swarm/logs swarm/models swarm/coordination && \
    chown -R swarm:swarm swarm

# Switch to swarm user
USER swarm

# Environment variables
ENV SWARM_SIZE=1008 \
    SWARM_MODE=development \
    PYTHON_UNBUFFERED=1 \
    PYTHONPATH=/app

# Expose swarm coordination port
EXPOSE 9000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:9000/swarm/health || exit 1

# Start AI Swarm orchestrator
CMD ["python", "-m", "swarm.orchestrator"]
