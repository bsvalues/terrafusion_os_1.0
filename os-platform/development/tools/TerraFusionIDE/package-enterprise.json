{
  "name": "terrafusion-ide-enterprise",
  "version": "2.0.0",
  "description": "🚀 Terrafusion IDE ULTIMATE POWER - Enterprise Government Technology Development Environment",
  "main": "src/main-ultimate.tsx",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "enterprise:install": "installer\\TERRAFUSION_ULTIMATE_INSTALLER.bat",
    "enterprise:launch": "launcher\\TERRAFUSION_ENTERPRISE_LAUNCHER.bat",
    "enterprise:uninstall": "uninstaller\\TERRAFUSION_ENTERPRISE_UNINSTALLER.bat",
    "enterprise:check": "system\\TERRAFUSION_SYSTEM_CHECKER.bat",
    "terrafusion:monitor": "echo 'Starting Terrafusion monitoring...'",
    "leafscope:start": "echo 'Starting LeafScope geospatial services...'",
    "postgis:optimize": "echo 'Optimizing PostGIS performance...'",
    "marketplace:start": "echo 'Starting Terrafusion Marketplace...'",
    "sdk:generate": "echo 'Generating Terrafusion SDK...'",
    "prometheus:start": "echo 'Starting Prometheus monitoring...'",
    "grafana:start": "echo 'Starting Grafana dashboards...'",
    "security:scan": "echo 'Running security scan...'",
    "compliance:audit": "echo 'Running compliance audit...'",
    "vulnerability:check": "echo 'Running vulnerability check...'",
    "access:control": "echo 'Running access control check...'"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.45.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.294.0",
    "axios": "^1.6.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1",
    "framer-motion": "^10.16.4",
    "aws-sdk": "^2.1490.0",
    "node-cron": "^3.0.3",
    "systeminformation": "^5.21.0",
    "winston": "^3.11.0",
    "@types/node": "^20.8.0",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/leaflet": "^1.9.8",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.8",
    "vitest": "^1.0.4",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "keywords": [
    "terrafusion",
    "ide",
    "enterprise",
    "government",
    "ai-swarm",
    "monaco-editor",
    "geospatial",
    "postgis",
    "monitoring",
    "compliance",
    "fisma",
    "nist",
    "section508",
    "plugin-development",
    "marketplace",
    "county-government",
    "enterprise-ide"
  ],
  "author": "Terrafusion AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/ide-enterprise"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "os": ["win32"],
  "cpu": ["x64"],
  "bin": {
    "terrafusion-ide": "./launcher/TERRAFUSION_ENTERPRISE_LAUNCHER.bat",
    "terrafusion-check": "./system/TERRAFUSION_SYSTEM_CHECKER.bat"
  }
}
