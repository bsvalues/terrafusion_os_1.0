{
  "name": "@terrafusion/security-analytics-quantum",
  "version": "2.0.0",
  "description": "MIT PhD-Level Quantum Security Analytics Framework for TerraFusion OS",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "docs": "typedoc src/index.ts",
    "start:threat-engine": "node dist/threat-engine.js",
    "start:behavioral-analytics": "node dist/behavioral-analytics.js",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:security": "jest tests/security.test.js",
    "test:performance": "jest tests/performance.test.js"
  },
  "dependencies": {
    "@tensorflow/tfjs-node": "^4.20.0",
    "crypto": "^1.0.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.3.1",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "fast-json-patch": "^3.1.1",
    "elasticsearch": "^8.12.0",
    "redis": "^4.6.13",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/uuid": "^9.0.8",
    "@types/lodash": "^4.14.202",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.4.2",
    "vitest": "^1.4.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "typedoc": "^0.25.12",
    "jest": "^29.0.0",
    "@jest/globals": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "supertest": "^6.0.0",
    "nyc": "^15.0.0"
  },
  "keywords": [
    "terrafusion",
    "security",
    "analytics",
    "quantum",
    "mit-phd",
    "threat-modeling",
    "behavioral-analytics",
    "government"
  ],
  "author": "TerraFusion AI Security Team",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}