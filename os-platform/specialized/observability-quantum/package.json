{
  "name": "@terrafusion/observability-quantum",
  "version": "2.0.0",
  "description": "MIT PhD-Level Quantum Observability Framework for TerraFusion OS",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage",
    "docs": "typedoc src/index.ts",
    "start:monitoring": "node dist/monitoring-engine.js",
    "start:analytics": "node dist/analytics-engine.js",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:security": "jest tests/security.test.js",
    "test:performance": "jest tests/performance.test.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/sdk-node": "^0.50.0",
    "@opentelemetry/exporter-jaeger": "^1.23.0",
    "@opentelemetry/exporter-prometheus": "^0.50.0",
    "prometheus-api-metrics": "^3.2.2",
    "prom-client": "^15.1.0",
    "elasticsearch": "^8.12.0",
    "winston": "^3.11.0",
    "winston-elasticsearch": "^0.17.4",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1",
    "rxjs": "^7.8.1",
    "onnxruntime-node": "^1.17.1",
    "tf.js": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/uuid": "^9.0.8",
    "@types/lodash": "^4.14.202",
    "typescript": "^5.4.2",
    "vitest": "^1.4.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "typedoc": "^0.25.12",
    "jest": "^29.0.0",
    "@jest/globals": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "supertest": "^6.0.0",
    "nyc": "^15.0.0"
  },
  "keywords": [
    "terrafusion",
    "observability",
    "monitoring",
    "quantum",
    "mit-phd",
    "ai-powered",
    "government"
  ],
  "author": "TerraFusion AI Team",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}