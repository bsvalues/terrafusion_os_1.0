{
  "name": "autonomous-research-engine",
  "version": "1.0.0",
  "description": "🔬 Autonomous Research Engine - AI-driven independent scientific research and breakthrough discovery system for TerraFusion OS Phase 4 transcendence",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "research:autonomous": "ts-node src/research/autonomous-research.ts",
    "discover:breakthrough": "ts-node src/discovery/breakthrough-detector.ts",
    "analyze:literature": "ts-node src/analysis/literature-analyzer.ts",
    "generate:hypothesis": "ts-node src/hypothesis/hypothesis-generator.ts",
    "validate:theory": "ts-node src/validation/theory-validator.ts",
    "test:unit": "jest tests/unit.test.js",
    "test:integration": "jest tests/integration.test.js",
    "test:security": "jest tests/security.test.js",
    "test:performance": "jest tests/performance.test.js",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:install": "cd mcp-server && npm install"
  },
  "keywords": [
    "autonomous-research",
    "ai-discovery",
    "breakthrough-detection",
    "scientific-research",
    "hypothesis-generation",
    "literature-analysis",
    "theory-validation",
    "transcendent-ai",
    "phase-4",
    "terrafusion-os"
  ],
  "author": "TerraFusion OS Team",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs": "^4.10.0",
    "@tensorflow/tfjs-node": "^4.10.0",
    "natural": "^6.10.0",
    "compromise": "^14.10.0",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^21.0.0",
    "cheerio": "^1.0.0-rc.12",
    "openai": "^4.20.0",
    "graphlib": "^2.1.8",
    "simple-statistics": "^7.8.3",
    "ml-matrix": "^6.10.8",
    "ml-regression": "^5.0.0",
    "jimp": "^0.22.10",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "redis": "^4.6.11",
    "mongodb": "^6.3.0",
    "elasticsearch": "^16.7.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.14.202",
    "@types/uuid": "^9.0.7",
    "@types/express": "^4.17.21",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.2",
    "@jest/globals": "^29.0.0",
    "jest-environment-node": "^29.0.0",
    "supertest": "^6.0.0",
    "nyc": "^15.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/explicit-function-return-type": "warn",
      "@typescript-eslint/no-explicit-any": "warn"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/autonomous-research-engine"
  },
  "bugs": {
    "url": "https://github.com/terrafusion/autonomous-research-engine/issues"
  },
  "homepage": "https://github.com/terrafusion/autonomous-research-engine#readme",
  "mcp": {
    "server": "./mcp-server",
    "tools": [
      "quantum-interface",
      "experimental-executor",
      "research-coordinator",
      "ml-model-server",
      "prediction-interface"
    ],
    "capabilities": [
      "machine-learning-models",
      "api-server",
      "real-time-communication"
    ]
  }
}