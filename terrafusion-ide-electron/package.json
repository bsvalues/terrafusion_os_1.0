{
  "name": "terrafusion-ide-electron",
  "version": "1.0.0",
  "description": "TerraFusion OS Desktop IDE - Government Coding Platform with AI Copilot",
  "main": "dist/main.js",
  "homepage": "./",
  "private": true,
  "scripts": {
    "start": "electron dist/main.js",
    "dev": "concurrently \"npm run build-main:watch\" \"npm run build-renderer:watch\" \"wait-on dist/main.js dist/renderer.js && electron dist/main.js\"",
    "serve": "node serve-dynamic.js",
    "dev-web": "npm run build && npm run serve",
    "build": "npm run build-main && npm run build-renderer",
    "build-main": "webpack --config webpack.main.config.js",
    "build-main:watch": "webpack --config webpack.main.config.js --watch",
    "build-renderer": "webpack --config webpack.renderer.config.js",
    "build-renderer:watch": "webpack --config webpack.renderer.config.js --watch --mode development",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "clean": "rm -rf dist node_modules/.cache",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@microsoft/signalr": "^8.0.0",
    "@monaco-editor/react": "4.7.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/x-data-grid": "^6.18.0",
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "framer-motion": "^10.16.16",
    "lodash": "^4.17.21",
    "lucide-react": "^0.540.0",
    "monaco-editor": "0.52.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "react-redux": "^9.0.4",
    "react-rnd": "^10.5.2",
    "react-router-dom": "^6.20.1",
    "reactflow": "11.11.4",
    "recharts": "^2.15.4",
    "styled-components": "6.1.19",
    "tailwind-merge": "^3.3.1",
    "three": "^0.179.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.179.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.7.6",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "postcss": "^8.4.32",
    "postcss-loader": "^7.3.3",
    "style-loader": "^3.3.3",
    "tailwindcss": "^3.3.6",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "wait-on": "^8.0.4",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "build": {
    "appId": "com.terrafusion.ide",
    "productName": "TerraFusion IDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
