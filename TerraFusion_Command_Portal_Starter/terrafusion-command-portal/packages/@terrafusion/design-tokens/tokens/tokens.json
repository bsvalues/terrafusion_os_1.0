{
  "$schema": "https://schemas.terrafusion.dev/design-tokens/v1.0.0",
  "$description": "TerraFusion Design System - TerraSphere-derived color palette optimized for government applications",
  "color": {
    "terra": {
      "$description": "Core TerraSphere color palette derived from logo analysis",
      "primary": {
        "$description": "Primary terra colors from the sphere's geological layers",
        "50": { "$value": "#f0f9ff", "$description": "Lightest terra - atmospheric rim" },
        "100": { "$value": "#e0f2fe", "$description": "Very light terra - cloud layer" },
        "200": { "$value": "#bae6fd", "$description": "Light terra - stratosphere" },
        "300": { "$value": "#7dd3fc", "$description": "Terra blue - oceanic reflection" },
        "400": { "$value": "#38bdf8", "$description": "Mid terra - primary ocean" },
        "500": { "$value": "#0ea5e9", "$description": "Core terra - deep ocean primary" },
        "600": { "$value": "#0284c7", "$description": "Dark terra - continental shelf" },
        "700": { "$value": "#0369a1", "$description": "Darker terra - deep water" },
        "800": { "$value": "#075985", "$description": "Very dark terra - abyssal" },
        "900": { "$value": "#0c4a6e", "$description": "Darkest terra - deep core" }
      },
      "earth": {
        "$description": "Earth tones from the sphere's geological features",
        "50": { "$value": "#fefdfb", "$description": "Lightest earth - mineral surface" },
        "100": { "$value": "#fef7ed", "$description": "Very light earth - sand dunes" },
        "200": { "$value": "#fed7aa", "$description": "Light earth - desert surface" },
        "300": { "$value": "#fdba74", "$description": "Earth amber - canyon walls" },
        "400": { "$value": "#fb923c", "$description": "Mid earth - geological strata" },
        "500": { "$value": "#f97316", "$description": "Core earth - volcanic orange" },
        "600": { "$value": "#ea580c", "$description": "Dark earth - magma chamber" },
        "700": { "$value": "#c2410c", "$description": "Darker earth - molten core" },
        "800": { "$value": "#9a3412", "$description": "Very dark earth - deep iron" },
        "900": { "$value": "#7c2d12", "$description": "Darkest earth - planetary core" }
      },
      "forest": {
        "$description": "Vegetation colors from the sphere's biological systems",
        "50": { "$value": "#f0fdf4", "$description": "Lightest forest - new growth" },
        "100": { "$value": "#dcfce7", "$description": "Very light forest - spring leaves" },
        "200": { "$value": "#bbf7d0", "$description": "Light forest - forest canopy" },
        "300": { "$value": "#86efac", "$description": "Forest green - healthy vegetation" },
        "400": { "$value": "#4ade80", "$description": "Mid forest - primary chlorophyll" },
        "500": { "$value": "#22c55e", "$description": "Core forest - deep vegetation" },
        "600": { "$value": "#16a34a", "$description": "Dark forest - old growth" },
        "700": { "$value": "#15803d", "$description": "Darker forest - forest floor" },
        "800": { "$value": "#166534", "$description": "Very dark forest - undergrowth" },
        "900": { "$value": "#14532d", "$description": "Darkest forest - deep roots" }
      }
    },
    "semantic": {
      "$description": "Semantic colors for government application states",
      "success": {
        "50": { "$value": "{color.terra.forest.50}", "$description": "Success state - lightest" },
        "500": { "$value": "{color.terra.forest.500}", "$description": "Success state - primary" },
        "700": { "$value": "{color.terra.forest.700}", "$description": "Success state - dark" }
      },
      "warning": {
        "50": { "$value": "{color.terra.earth.50}", "$description": "Warning state - lightest" },
        "500": { "$value": "{color.terra.earth.500}", "$description": "Warning state - primary" },
        "700": { "$value": "{color.terra.earth.700}", "$description": "Warning state - dark" }
      },
      "error": {
        "50": { "$value": "#fef2f2", "$description": "Error state - lightest" },
        "500": { "$value": "#ef4444", "$description": "Error state - primary" },
        "700": { "$value": "#b91c1c", "$description": "Error state - dark" }
      },
      "info": {
        "50": { "$value": "{color.terra.primary.50}", "$description": "Info state - lightest" },
        "500": { "$value": "{color.terra.primary.500}", "$description": "Info state - primary" },
        "700": { "$value": "{color.terra.primary.700}", "$description": "Info state - dark" }
      }
    },
    "neutral": {
      "$description": "Neutral colors for text, backgrounds, and borders - WCAG 2.2 AA compliant",
      "50": { "$value": "#fafafa", "$description": "Lightest neutral - background" },
      "100": { "$value": "#f4f4f5", "$description": "Very light neutral - surface" },
      "200": { "$value": "#e4e4e7", "$description": "Light neutral - border" },
      "300": { "$value": "#d4d4d8", "$description": "Neutral border - subtle" },
      "400": { "$value": "#a1a1aa", "$description": "Mid neutral - placeholder" },
      "500": { "$value": "#71717a", "$description": "Core neutral - secondary text" },
      "600": { "$value": "#52525b", "$description": "Dark neutral - body text" },
      "700": { "$value": "#3f3f46", "$description": "Darker neutral - headings" },
      "800": { "$value": "#27272a", "$description": "Very dark neutral - high contrast" },
      "900": { "$value": "#18181b", "$description": "Darkest neutral - maximum contrast" }
    }
  },
  "typography": {
    "$description": "Typography system optimized for government accessibility requirements",
    "fontFamily": {
      "sans": {
        "$value": ["Inter", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"],
        "$description": "Primary sans-serif font stack - government optimized"
      },
      "mono": {
        "$value": ["JetBrains Mono", "Fira Code", "Consolas", "Monaco", "Courier New", "monospace"],
        "$description": "Monospace font stack for code and data"
      }
    },
    "fontSize": {
      "$description": "Font sizes following 1.25 modular scale for optimal readability",
      "xs": { "$value": "0.75rem", "$description": "12px - captions, fine print" },
      "sm": { "$value": "0.875rem", "$description": "14px - small text, labels" },
      "base": { "$value": "1rem", "$description": "16px - body text, base size" },
      "lg": { "$value": "1.125rem", "$description": "18px - large body text" },
      "xl": { "$value": "1.25rem", "$description": "20px - sub-headings" },
      "2xl": { "$value": "1.5rem", "$description": "24px - section headings" },
      "3xl": { "$value": "1.875rem", "$description": "30px - page headings" },
      "4xl": { "$value": "2.25rem", "$description": "36px - hero headings" },
      "5xl": { "$value": "3rem", "$description": "48px - display headings" },
      "6xl": { "$value": "3.75rem", "$description": "60px - large display" }
    },
    "fontWeight": {
      "$description": "Font weights for hierarchy and emphasis",
      "light": { "$value": "300", "$description": "Light weight - minimal emphasis" },
      "normal": { "$value": "400", "$description": "Normal weight - body text" },
      "medium": { "$value": "500", "$description": "Medium weight - subtle emphasis" },
      "semibold": { "$value": "600", "$description": "Semi-bold - strong emphasis" },
      "bold": { "$value": "700", "$description": "Bold - headings, strong emphasis" },
      "extrabold": { "$value": "800", "$description": "Extra bold - hero text" }
    },
    "lineHeight": {
      "$description": "Line heights optimized for readability and accessibility",
      "tight": { "$value": "1.25", "$description": "Tight leading - large headings" },
      "snug": { "$value": "1.375", "$description": "Snug leading - sub-headings" },
      "normal": { "$value": "1.5", "$description": "Normal leading - body text" },
      "relaxed": { "$value": "1.625", "$description": "Relaxed leading - long form content" },
      "loose": { "$value": "2", "$description": "Loose leading - accessibility enhanced" }
    }
  },
  "spacing": {
    "$description": "Spatial system based on 8px grid for consistent layouts",
    "0": { "$value": "0", "$description": "No spacing" },
    "1": { "$value": "0.25rem", "$description": "4px - minimal spacing" },
    "2": { "$value": "0.5rem", "$description": "8px - base unit" },
    "3": { "$value": "0.75rem", "$description": "12px - small spacing" },
    "4": { "$value": "1rem", "$description": "16px - standard spacing" },
    "5": { "$value": "1.25rem", "$description": "20px - medium spacing" },
    "6": { "$value": "1.5rem", "$description": "24px - large spacing" },
    "8": { "$value": "2rem", "$description": "32px - section spacing" },
    "10": { "$value": "2.5rem", "$description": "40px - component spacing" },
    "12": { "$value": "3rem", "$description": "48px - layout spacing" },
    "16": { "$value": "4rem", "$description": "64px - page spacing" },
    "20": { "$value": "5rem", "$description": "80px - hero spacing" },
    "24": { "$value": "6rem", "$description": "96px - large layout" }
  },
  "borderRadius": {
    "$description": "Border radius system for consistent component styling",
    "none": { "$value": "0", "$description": "No radius - sharp corners" },
    "sm": { "$value": "0.125rem", "$description": "2px - subtle rounding" },
    "base": { "$value": "0.25rem", "$description": "4px - standard rounding" },
    "md": { "$value": "0.375rem", "$description": "6px - medium rounding" },
    "lg": { "$value": "0.5rem", "$description": "8px - large rounding" },
    "xl": { "$value": "0.75rem", "$description": "12px - extra large rounding" },
    "2xl": { "$value": "1rem", "$description": "16px - prominent rounding" },
    "3xl": { "$value": "1.5rem", "$description": "24px - hero rounding" },
    "full": { "$value": "9999px", "$description": "Full rounding - circles/pills" }
  },
  "shadow": {
    "$description": "Shadow system for depth and layering",
    "sm": {
      "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "$description": "Small shadow - subtle elevation"
    },
    "base": {
      "$value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
      "$description": "Base shadow - standard elevation"
    },
    "md": {
      "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
      "$description": "Medium shadow - prominent elevation"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
      "$description": "Large shadow - high elevation"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
      "$description": "Extra large shadow - maximum elevation"
    },
    "inner": {
      "$value": "inset 0 2px 4px 0 rgb(0 0 0 / 0.05)",
      "$description": "Inner shadow - inset elements"
    }
  },
  "animation": {
    "$description": "Animation timing and easing for TerraSphere interactions",
    "duration": {
      "fast": { "$value": "150ms", "$description": "Fast animations - micro-interactions" },
      "normal": { "$value": "300ms", "$description": "Normal animations - standard transitions" },
      "slow": { "$value": "500ms", "$description": "Slow animations - complex transitions" },
      "slower": { "$value": "750ms", "$description": "Slower animations - page transitions" }
    },
    "easing": {
      "linear": { "$value": "cubic-bezier(0, 0, 1, 1)", "$description": "Linear easing" },
      "ease": { "$value": "cubic-bezier(0.25, 0.1, 0.25, 1)", "$description": "Standard ease" },
      "easeIn": { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$description": "Ease in" },
      "easeOut": { "$value": "cubic-bezier(0, 0, 0.2, 1)", "$description": "Ease out" },
      "easeInOut": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$description": "Ease in-out" },
      "terra": { "$value": "cubic-bezier(0.4, 0, 0.1, 1)", "$description": "TerraSphere custom easing" }
    }
  }
}