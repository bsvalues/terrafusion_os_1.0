  "technical_stack": {
    "frontend": {
      "framework": "React 19",
      "language": "TypeScript",
      "state_management": "Zustand",
      "ui_framework": "Custom TerraFusion Design System",
      "visualization": "Three.js",
      "communication": "WebSocket + REST"
