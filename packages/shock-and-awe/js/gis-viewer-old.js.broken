/**
 * TerraFusion GIS Viewer
 * Interactive mapping and geospatial analysis
 */

class TerraFusionGIS {
    constructor() {
        this.map = null;
        this.markers = [];
        this.layers = {};
        this.currentProperty = null;
        this.heatmapData = [];
        this.isAnalyzing = false;
        
        this.init();
    }

    init() {
        this.createGISInterface();
        this.initializeMap();
        this.loadSampleData();
        this.bindEvents();
    }

    createGISInterface() {
        const gisContainer = document.createElement('div');
        gisContainer.id = 'gis-viewer';
        gisContainer.className = 'tf-fullscreen-app tf-cosmic-bg';
        gisContainer.innerHTML = `
            <div class="gis-container">
                <div class="gis-header">
                    <div class="gis-title">
                        <svg class="wizard-icon" viewBox="0 0 24 24" fill="currentColor" style="width: 60px; height: 60px; color: #00ffee;">
                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                            <circle cx="12" cy="9" r="2.5"/>
                        </svg>
                        TerraFusion GIS Pro
                    </div>
                    <button class="tf-feature-close" id="gis-close">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </button>
                </div>
                        <div class="gis-toolbar tf-toolbar">
                            <div class="tool-group">
                                <button class="tool-btn active" data-tool="select" title="Select Properties">
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M3 3h2v2H3V3zm4 0h2v2H7V3zm4 0h2v2h-2V3z"/>
                                    </svg>
                                </button>
                                <button class="tool-btn" data-tool="measure" title="Measure Distance">
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z"/>
                                    </svg>
                                </button>
                                <button class="tool-btn" data-tool="analyze" title="Spatial Analysis">
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
                                    </svg>
                                </button>
                            </div>
                            <div class="tool-group">
                                <select class="layer-select" id="layer-select">
                                    <option value="satellite">Satellite</option>
                                    <option value="streets">Streets</option>
                                    <option value="terrain">Terrain</option>
                                    <option value="zoning">Zoning</option>
                                </select>
                            </div>
                            <div class="tool-group">
                                <button class="tool-btn" data-tool="heatmap" title="Value Heatmap">
                                    🔥 Heatmap
                                </button>
                                <button class="tool-btn" data-tool="3d" title="3D View">
                                    📦 3D View
                                </button>
                            </div>
                        </div>
                    </div>

                <div class="gis-map-container">
                    <div id="terrafusion-map" class="gis-map"></div>
                    <div class="gis-controls">
                        <h4>Map Controls</h4>
                        <button data-action="zoom-in">🔍 Zoom In</button>
                        <button data-action="zoom-out">🔍 Zoom Out</button>
                        <button data-action="reset-view">🎯 Reset View</button>
                        <button data-action="toggle-3d">📦 3D View</button>
                        <button data-action="heatmap">🔥 Heatmap</button>
                    </div>
                </div>
            </div>
        `;
        
        document.body.appendChild(gisContainer);
    }

    show() {
        const container = document.getElementById('gis-viewer');
        container.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        this.initializeMap();
    }

    close() {
        const container = document.getElementById('gis-viewer');
        container.style.display = 'none';
        document.body.style.overflow = 'auto';
    }

                            <div class="sidebar-section property-info" id="property-info" style="display: none;">
                                <h4>Property Information</h4>
                                <div class="property-details">
                                    <div class="detail-item">
                                        <span class="detail-label">Address:</span>
                                        <span class="detail-value" id="prop-address">-</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">Assessed Value:</span>
                                        <span class="detail-value" id="prop-value">-</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">Square Footage:</span>
                                        <span class="detail-value" id="prop-sqft">-</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">Year Built:</span>
                                        <span class="detail-value" id="prop-year">-</span>
                                    </div>
                                    <div class="detail-item">
                                        <span class="detail-label">Lot Size:</span>
                                        <span class="detail-value" id="prop-lot">-</span>
                                    </div>
                                </div>
                                <button class="analyze-property-btn" id="analyze-property">
                                    🤖 AI Analysis
                                </button>
                            </div>

                            <div class="sidebar-section">
                                <h4>Search & Navigate</h4>
                                <div class="search-controls">
                                    <input type="text" class="search-input" id="address-search" 
                                           placeholder="Search address or parcel...">
                                    <button class="search-btn" id="search-btn">🔍</button>
                                </div>
                                <div class="quick-locations">
                                    <button class="location-btn" data-location="benton">Benton County</button>
                                    <button class="location-btn" data-location="yakima">Yakima County</button>
                                    <button class="location-btn" data-location="clark">Clark County</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="gis-footer tf-app-footer">
                        <div class="footer-info">
                            <span class="data-source">Data: Benton County Assessor | Updated: ${new Date().toLocaleDateString()}</span>
                        </div>
                        <div class="footer-controls">
                            <button class="btn btn-secondary" id="export-map">Export Map</button>
                            <button class="btn btn-primary" id="generate-report">Generate Report</button>
                        </div>
                    </div>
                </div>
            </div>
        `;

        document.body.appendChild(gisContainer);
    }

    initializeMap() {
        // Create a simple map implementation (would use Leaflet/MapBox in production)
        const mapContainer = document.getElementById('terrafusion-map');
        
        // Create map canvas
        const canvas = document.createElement('canvas');
        canvas.width = mapContainer.clientWidth;
        canvas.height = mapContainer.clientHeight;
        canvas.className = 'map-canvas-element';
        mapContainer.appendChild(canvas);
        
        this.mapCanvas = canvas;
        this.mapContext = canvas.getContext('2d');
        
        // Initialize map state
        this.mapState = {
            center: { lat: 46.2085, lng: -119.2021 }, // Benton County center
            zoom: 10,
            bounds: {
                north: 46.5,
                south: 45.9,
                east: -118.8,
                west: -119.6
            }
        };
        
        this.renderMap();
    }

    renderMap() {
        const ctx = this.mapContext;
        const canvas = this.mapCanvas;
        
        // Clear canvas
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        // Draw base map (simplified)
        ctx.fillStyle = '#e5f3ff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        
        // Draw grid
        this.drawGrid(ctx);
        
        // Draw properties
        this.drawProperties(ctx);
        
        // Draw overlays
        this.drawOverlays(ctx);
    }

    drawGrid(ctx) {
        ctx.strokeStyle = '#d1d5db';
        ctx.lineWidth = 1;
        
        const gridSize = 50;
        
        // Vertical lines
        for (let x = 0; x < this.mapCanvas.width; x += gridSize) {
            ctx.beginPath();
            ctx.moveTo(x, 0);
            ctx.lineTo(x, this.mapCanvas.height);
            ctx.stroke();
        }
        
        // Horizontal lines
        for (let y = 0; y < this.mapCanvas.height; y += gridSize) {
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(this.mapCanvas.width, y);
            ctx.stroke();
        }
    }

    drawProperties(ctx) {
        // Sample property data
        const properties = [
            { id: 1, x: 150, y: 200, value: 350000, type: 'residential' },
            { id: 2, x: 300, y: 180, value: 280000, type: 'residential' },
            { id: 3, x: 450, y: 220, value: 150000, type: 'commercial' },
            { id: 4, x: 200, y: 350, value: 420000, type: 'residential' },
            { id: 5, x: 380, y: 320, value: 75000, type: 'industrial' }
        ];
        
        properties.forEach(prop => {
            // Property marker
            ctx.fillStyle = this.getPropertyColor(prop.type);
            ctx.beginPath();
            ctx.arc(prop.x, prop.y, 8, 0, 2 * Math.PI);
            ctx.fill();
            
            // Property border
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 2;
            ctx.stroke();
            
            // Property label (simplified)
            ctx.fillStyle = '#374151';
            ctx.font = '12px Arial';
            ctx.fillText(`$${(prop.value / 1000).toFixed(0)}k`, prop.x + 15, prop.y + 5);
        });
    }

    getPropertyColor(type) {
        const colors = {
            residential: '#3b82f6',
            commercial: '#10b981',
            industrial: '#f59e0b'
        };
        return colors[type] || '#6b7280';
    }

    drawOverlays(ctx) {
        // Draw any active overlays (zoning, flood zones, etc.)
        if (this.layers.zoning) {
            this.drawZoning(ctx);
        }
        if (this.layers.heatmap) {
            this.drawHeatmap(ctx);
        }
    }

    drawZoning(ctx) {
        // Sample zoning overlay
        ctx.fillStyle = 'rgba(251, 191, 36, 0.3)';
        ctx.fillRect(100, 100, 200, 150);
        
        ctx.fillStyle = 'rgba(34, 197, 94, 0.3)';
        ctx.fillRect(350, 150, 180, 200);
        
        ctx.fillStyle = 'rgba(239, 68, 68, 0.3)';
        ctx.fillRect(200, 300, 250, 100);
    }

    drawHeatmap(ctx) {
        // Simple value-based heatmap
        const gradient = ctx.createRadialGradient(250, 250, 0, 250, 250, 100);
        gradient.addColorStop(0, 'rgba(255, 0, 0, 0.8)');
        gradient.addColorStop(0.5, 'rgba(255, 255, 0, 0.6)');
        gradient.addColorStop(1, 'rgba(0, 255, 0, 0.4)');
        
        ctx.fillStyle = gradient;
        ctx.fillRect(150, 150, 200, 200);
    }

    loadSampleData() {
        // Load sample property data for demonstration
        this.sampleProperties = [
            {
                id: 'PROP001',
                address: '123 Main St, Richland, WA',
                value: 425000,
                sqft: 2450,
                yearBuilt: 1995,
                lotSize: 0.31,
                coordinates: { lat: 46.2856, lng: -119.2844 }
            },
            {
                id: 'PROP002',
                address: '456 Oak Ave, Kennewick, WA',
                value: 380000,
                sqft: 2100,
                yearBuilt: 2001,
                lotSize: 0.25,
                coordinates: { lat: 46.2112, lng: -119.1372 }
            },
            {
                id: 'PROP003',
                address: '789 Pine St, Pasco, WA',
                value: 320000,
                sqft: 1950,
                yearBuilt: 1988,
                lotSize: 0.28,
                coordinates: { lat: 46.2396, lng: -119.1006 }
            }
        ];
    }

    bindEvents() {
        // Close GIS viewer
        document.getElementById('gis-close').addEventListener('click', () => this.close());
        document.getElementById('gis-backdrop').addEventListener('click', (e) => {
            if (e.target.id === 'gis-backdrop') this.close();
        });

        // Map controls
        document.getElementById('zoom-in').addEventListener('click', () => this.zoomIn());
        document.getElementById('zoom-out').addEventListener('click', () => this.zoomOut());
        document.getElementById('my-location').addEventListener('click', () => this.goToMyLocation());

        // Tool buttons
        document.querySelectorAll('.tool-btn').forEach(btn => {
            btn.addEventListener('click', () => this.selectTool(btn));
        });

        // Layer controls
        document.querySelectorAll('[data-layer]').forEach(checkbox => {
            checkbox.addEventListener('change', () => this.toggleLayer(checkbox));
        });

        // Analysis tools
        document.querySelectorAll('.analysis-btn').forEach(btn => {
            btn.addEventListener('click', () => this.runAnalysis(btn.dataset.analysis));
        });

        // Search
        document.getElementById('search-btn').addEventListener('click', () => this.searchAddress());
        document.getElementById('address-search').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') this.searchAddress();
        });

        // Quick locations
        document.querySelectorAll('[data-location]').forEach(btn => {
            btn.addEventListener('click', () => this.goToLocation(btn.dataset.location));
        });

        // Map interactions
        this.mapCanvas.addEventListener('click', (e) => this.handleMapClick(e));
        this.mapCanvas.addEventListener('mousemove', (e) => this.handleMapMouseMove(e));

        // Property analysis
        document.getElementById('analyze-property').addEventListener('click', () => this.analyzeProperty());

        // Export and report
        document.getElementById('export-map').addEventListener('click', () => this.exportMap());
        document.getElementById('generate-report').addEventListener('click', () => this.generateReport());
    }

    show() {
        const container = document.getElementById('terrafusion-gis');
        container.style.display = 'flex';
        container.style.position = 'fixed';
        container.style.top = '0';
        container.style.left = '0';
        container.style.width = '100vw';
        container.style.height = '100vh';
        container.style.zIndex = '9999';
        document.body.style.overflow = 'hidden';
        this.animateIn();
        
        // Resize canvas when shown
        setTimeout(() => {
            this.resizeCanvas();
            this.renderMap();
        }, 200);
    }

    close() {
        const container = document.getElementById('terrafusion-gis');
        container.style.opacity = '0';
        container.style.transform = 'scale(0.95)';
        setTimeout(() => {
            container.style.display = 'none';
            document.body.style.overflow = 'auto';
        }, 300);
    }

    animateIn() {
        const container = document.getElementById('terrafusion-gis');
        const modal = document.querySelector('.gis-modal');
        
        container.style.opacity = '0';
        container.style.transform = 'scale(0.95)';
        modal.style.transform = 'translateY(50px)';
        
        setTimeout(() => {
            container.style.transition = 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
            container.style.opacity = '1';
            container.style.transform = 'scale(1)';
            modal.style.transition = 'all 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
            modal.style.transform = 'translateY(0)';
        }, 50);
    }

    resizeCanvas() {
        const mapContainer = document.getElementById('terrafusion-map');
        this.mapCanvas.width = mapContainer.clientWidth;
        this.mapCanvas.height = mapContainer.clientHeight;
    }

    selectTool(btn) {
        document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        this.currentTool = btn.dataset.tool;
        console.log(`🔧 Selected tool: ${this.currentTool}`);
    }

    toggleLayer(checkbox) {
        const layer = checkbox.dataset.layer;
        this.layers[layer] = checkbox.checked;
        console.log(`🗺️ Layer ${layer}: ${checkbox.checked ? 'ON' : 'OFF'}`);
        this.renderMap();
    }

    runAnalysis(analysisType) {
        console.log(`📊 Running ${analysisType} analysis...`);
        this.isAnalyzing = true;
        
        // Simulate analysis
        setTimeout(() => {
            switch (analysisType) {
                case 'buffer':
                    this.showAnalysisResult('Buffer Analysis', 'Found 23 properties within 500m radius');
                    break;
                case 'density':
                    this.showAnalysisResult('Density Analysis', 'Property density: 4.2 units per acre');
                    break;
                case 'value':
                    this.showAnalysisResult('Value Analysis', 'Average property value: $385,000');
                    break;
                case 'trends':
                    this.showAnalysisResult('Market Trends', '12.3% value increase over last year');
                    break;
            }
            this.isAnalyzing = false;
        }, 2000);
    }

    showAnalysisResult(title, result) {
        // Create notification
        const notification = document.createElement('div');
        notification.className = 'analysis-notification';
        notification.innerHTML = `
            <div class="notification-content">
                <h4>${title}</h4>
                <p>${result}</p>
            </div>
        `;
        
        document.querySelector('.gis-content').appendChild(notification);
        
        // Auto-remove after 5 seconds
        setTimeout(() => {
            notification.remove();
        }, 5000);
    }

    handleMapClick(e) {
        const rect = this.mapCanvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        console.log(`🗺️ Map clicked at: ${x}, ${y}`);
        
        // Simulate property selection
        if (this.currentTool === 'select') {
            this.selectPropertyAt(x, y);
        }
    }

    handleMapMouseMove(e) {
        const rect = this.mapCanvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        // Update coordinate display (simplified)
        const lat = 46.2085 + (y - this.mapCanvas.height / 2) * 0.0001;
        const lng = -119.2021 + (x - this.mapCanvas.width / 2) * 0.0001;
        
        document.getElementById('current-coords').textContent = 
            `Lat: ${lat.toFixed(4)}, Lng: ${lng.toFixed(4)}`;
    }

    selectPropertyAt(x, y) {
        // Find nearest property (simplified)
        const property = this.sampleProperties[0]; // For demo
        
        this.currentProperty = property;
        this.showPropertyInfo(property);
    }

    showPropertyInfo(property) {
        const infoPanel = document.getElementById('property-info');
        infoPanel.style.display = 'block';
        
        document.getElementById('prop-address').textContent = property.address;
        document.getElementById('prop-value').textContent = `$${property.value.toLocaleString()}`;
        document.getElementById('prop-sqft').textContent = `${property.sqft.toLocaleString()} sq ft`;
        document.getElementById('prop-year').textContent = property.yearBuilt;
        document.getElementById('prop-lot').textContent = `${property.lotSize} acres`;
    }

    analyzeProperty() {
        if (!this.currentProperty) return;
        
        console.log('🤖 Running AI property analysis...');
        
        // Show analysis dialog
        const analysisDialog = document.createElement('div');
        analysisDialog.className = 'property-analysis-dialog';
        analysisDialog.innerHTML = `
            <div class="analysis-content">
                <h3>🤖 AI Property Analysis</h3>
                <div class="analysis-progress">
                    <div class="progress-item">
                        <span>📊 Market Comparison Analysis</span>
                        <div class="progress-bar"><div class="progress-fill"></div></div>
                    </div>
                    <div class="progress-item">
                        <span>🏗️ Structural Assessment</span>
                        <div class="progress-bar"><div class="progress-fill"></div></div>
                    </div>
                    <div class="progress-item">
                        <span>📍 Location Value Analysis</span>
                        <div class="progress-bar"><div class="progress-fill"></div></div>
                    </div>
                </div>
                <div class="analysis-results" style="display: none;">
                    <h4>Analysis Results</h4>
                    <div class="result-item">
                        <span class="result-label">Market Position:</span>
                        <span class="result-value">Above Average (+8%)</span>
                    </div>
                    <div class="result-item">
                        <span class="result-label">Investment Score:</span>
                        <span class="result-value">8.7/10</span>
                    </div>
                    <div class="result-item">
                        <span class="result-label">Appreciation Forecast:</span>
                        <span class="result-value">+3.2% annually</span>
                    </div>
                </div>
                <button class="close-analysis">Close</button>
            </div>
        `;
        
        document.querySelector('.gis-content').appendChild(analysisDialog);
        
        // Animate progress bars
        const progressBars = analysisDialog.querySelectorAll('.progress-fill');
        progressBars.forEach((bar, index) => {
            setTimeout(() => {
                bar.style.width = '100%';
            }, index * 1000);
        });
        
        // Show results after progress
        setTimeout(() => {
            analysisDialog.querySelector('.analysis-progress').style.display = 'none';
            analysisDialog.querySelector('.analysis-results').style.display = 'block';
        }, 3000);
        
        // Close button
        analysisDialog.querySelector('.close-analysis').addEventListener('click', () => {
            analysisDialog.remove();
        });
    }

    searchAddress() {
        const searchTerm = document.getElementById('address-search').value;
        console.log(`🔍 Searching for: ${searchTerm}`);
        
        // Simulate search (would integrate with geocoding service)
        if (searchTerm.toLowerCase().includes('main')) {
            this.selectPropertyAt(150, 200);
            this.showNotification('Property found and selected');
        } else {
            this.showNotification('Address not found in current view');
        }
    }

    goToLocation(location) {
        const locations = {
            benton: { lat: 46.2085, lng: -119.2021 },
            yakima: { lat: 46.6021, lng: -120.5059 },
            clark: { lat: 45.6387, lng: -122.5957 }
        };
        
        if (locations[location]) {
            this.mapState.center = locations[location];
            this.renderMap();
            console.log(`📍 Navigated to ${location}`);
        }
    }

    zoomIn() {
        this.mapState.zoom = Math.min(this.mapState.zoom + 1, 18);
        this.renderMap();
    }

    zoomOut() {
        this.mapState.zoom = Math.max(this.mapState.zoom - 1, 1);
        this.renderMap();
    }

    goToMyLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition((position) => {
                this.mapState.center = {
                    lat: position.coords.latitude,
                    lng: position.coords.longitude
                };
                this.renderMap();
                this.showNotification('Location updated');
            });
        }
    }

    showNotification(message) {
        const notification = document.createElement('div');
        notification.className = 'gis-notification';
        notification.textContent = message;
        
        document.querySelector('.gis-content').appendChild(notification);
        
        setTimeout(() => {
            notification.remove();
        }, 3000);
    }

    exportMap() {
        // Convert canvas to downloadable image
        const link = document.createElement('a');
        link.download = 'terrafusion-map.png';
        link.href = this.mapCanvas.toDataURL();
        link.click();
        
        this.showNotification('Map exported successfully');
    }

    generateReport() {
        console.log('📄 Generating GIS analysis report...');
        
        const report = {
            timestamp: new Date().toISOString(),
            properties: this.sampleProperties.length,
            analysisType: 'Regional Assessment',
            findings: [
                'Total properties analyzed: 147',
                'Average property value: $385,000',
                'Market trend: +12.3% YoY growth',
                'Investment grade: A- (Excellent)'
            ]
        };
        
        // Simulate report generation
        setTimeout(() => {
            this.showNotification('Comprehensive GIS report generated');
            console.log('📋 Report data:', report);
        }, 2000);
    }
}

// Export for use in main application
window.TerraFusionGIS = TerraFusionGIS;