{
  "id": "blockchain-dapp",
  "metadata": {
    "name": "Blockchain DApp",
    "description": "Decentralized application with Web3, Ethereum, and smart contracts",
    "category": "Blockchain Development",
    "tags": ["blockchain", "ethereum", "web3", "solidity", "dapp"],
    "dependencies": {
      "node": ">=18.0.0",
      "truffle": ">=5.0.0"
    },
    "requirements": [
      "Node.js 18+",
      "Truffle or Hardhat",
      "MetaMask browser extension",
      "Local blockchain (Ganache)"
    ],
    "author": "Terrafusion Team",
    "version": "1.0.0",
    "icon": "link"
  },
  "variables": [
    {
      "name": "PROJECT_NAME",
      "description": "Name of your DApp",
      "default_value": "my-dapp",
      "required": true,
      "validation_pattern": "^[a-z][a-z0-9-]*$"
    },
    {
      "name": "CONTRACT_NAME",
      "description": "Main smart contract name",
      "default_value": "MyContract",
      "required": true,
      "validation_pattern": "^[A-Z][a-zA-Z0-9]*$"
    },
    {
      "name": "NETWORK",
      "description": "Target network (development/testnet/mainnet)",
      "default_value": "development",
      "required": true,
      "validation_pattern": "^(development|testnet|mainnet)$"
    }
  ],
  "file_mappings": {},
  "post_install_commands": [
    "npm install",
    "npx truffle init",
    "echo 'Blockchain DApp created successfully!'",
    "echo 'Compile contracts: truffle compile'",
    "echo 'Deploy: truffle migrate'"
  ]
}
