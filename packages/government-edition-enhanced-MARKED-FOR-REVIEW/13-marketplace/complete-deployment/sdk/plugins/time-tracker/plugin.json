{
  "id": "time-tracker",
  "name": "Time Tracker",
  "version": "1.0.0",
  "description": "Track time spent in different workspace phases and generate reports",
  "author": "Terrafusion Team",
  "license": "MIT",
  "keywords": ["time", "tracking", "productivity", "analytics"],
  "categories": ["productivity", "analytics"],
  "plugin_type": "service",
  "entry_point": "plugin.rhai",
  "permissions": [
    {
      "resource": "storage",
      "actions": ["read", "write"]
    },
    {
      "resource": "events",
      "actions": ["subscribe"]
    }
  ],
  "dependencies": [],
  "min_launcher_version": "3.1.0",
  "configuration_schema": {
    "type": "object",
    "properties": {
      "auto_track": {
        "type": "boolean",
        "title": "Auto Track",
        "description": "Automatically track time when phases are active",
        "default": true
      },
      "idle_threshold": {
        "type": "integer",
        "title": "Idle Threshold (minutes)",
        "description": "Minutes of inactivity before considering user idle",
        "default": 5,
        "minimum": 1,
        "maximum": 60
      },
      "daily_goal": {
        "type": "integer",
        "title": "Daily Goal (hours)",
        "description": "Target hours to work per day",
        "default": 8,
        "minimum": 1,
        "maximum": 24
      },
      "export_format": {
        "type": "string",
        "title": "Export Format",
        "description": "Default format for time reports",
        "enum": ["json", "csv", "markdown"],
        "default": "csv"
      }
    }
  }
}
