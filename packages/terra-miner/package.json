    "preview:fast": "vite preview --host",
    "start:mcp": "python3 mcp-server/index.py",
    "start:consciousness": "python3 -c \"from mcp_server.index import mcp_server; mcp_server.start_server()\"",
    "test:consciousness": "python3 -m pytest mcp-server/tests/",
    "build:enhanced": "npm run build && python3 -m py_compile mcp-server/index.py",
    "validate:consciousness": "python3 -c \"from mcp_server.index import ConsciousnessAwareDataMiner; print('✅ Consciousness validation passed')\"",
