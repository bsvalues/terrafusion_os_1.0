<?xml version="1.0" encoding="UTF-8"?>
<!-- TerraFusion Customer Service MSI Installer -->
<!-- 379,000,000× Faster Government Support -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" 
           Name="TerraFusion Customer Service" 
           Language="1033" 
           Version="1.0.0.0" 
           Manufacturer="TerraFusion Government Solutions" 
           UpgradeCode="A9E4B7C2-3D5F-4A6B-8C9D-1E2F3A4B5C6D">
    
    <Package InstallerVersion="500" 
             Compressed="yes" 
             InstallScope="perMachine"
             Platform="x64"
             Description="TerraFusion Customer Service - AI-Powered Government Support System"
             Comments="8 AI Agents + 164-Agent BELICHICK Swarm. 379,000,000× Faster Resolution."
             Manufacturer="TerraFusion Government Solutions" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    
    <!-- Include WebView2 Bootstrapper -->
    <Property Id="WEBVIEW2RUNTIME" Value="1" />
    <Property Id="WEBVIEW2RUNTIMEURL" Value="https://go.microsoft.com/fwlink/p/?LinkId=2124703" />
    
    <!-- Media configuration -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    
    <!-- Icon -->
    <Icon Id="TerraFusion.ico" SourceFile="TerraFusion.ico"/>
    <Property Id="ARPPRODUCTICON" Value="TerraFusion.ico" />
    
    <!-- Application properties -->
    <Property Id="ARPURLINFOABOUT" Value="https://terrafusion.gov" />
    <Property Id="ARPURLUPDATEINFO" Value="https://terrafusion.gov/updates" />
    <Property Id="ARPHELPLINK" Value="https://terrafusion.gov/support" />
    <Property Id="ARPCONTACT" Value="support@terrafusion.gov" />
    <Property Id="ARPCOMMENTS" Value="Government. Transcended. 379,000,000× Faster." />
    
    <!-- Windows Authentication requirement -->
    <Property Id="WINDOWSAUTH" Value="1" />
    
    <!-- Launch conditions -->
    <Condition Message="This application requires Windows 10 version 1903 or higher.">
      <![CDATA[Installed OR (VersionNT >= 603)]]>
    </Condition>
    
    <Condition Message="This application requires administrative privileges.">
      <![CDATA[Privileged]]>
    </Condition>
    
    <!-- Feature structure -->
    <Feature Id="ProductFeature" 
             Title="TerraFusion Customer Service" 
             Level="1"
             Description="Complete Customer Service System with AI Support"
             Display="expand"
             ConfigurableDirectory="INSTALLFOLDER">
      
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="WebView2Components" />
      <ComponentGroupRef Id="AISwarmComponents" />
      <ComponentGroupRef Id="DatabaseComponents" />
      
      <Feature Id="DesktopShortcut" 
               Title="Desktop Shortcut" 
               Level="1"
               Description="Add shortcut to desktop" />
      
      <Feature Id="StartMenuShortcut" 
               Title="Start Menu Shortcut" 
               Level="1"
               Description="Add to Start Menu" />
    </Feature>
    
    <!-- Directory structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="CompanyFolder" Name="TerraFusion">
          <Directory Id="INSTALLFOLDER" Name="Customer Service">
            
            <!-- Main application components -->
            <Component Id="MainExecutable" Guid="B1C2D3E4-F5A6-7B8C-9D0E-1F2A3B4C5D6E">
              <File Id="TerraFusionLauncher.exe" 
                    Source="$(var.SourceDir)\TerraFusion.Launcher.exe" 
                    KeyPath="yes">
                <Shortcut Id="StartMenuShortcut"
                          Directory="ProgramMenuFolder"
                          Name="TerraFusion Customer Service"
                          Description="AI-Powered Government Support"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="TerraFusion.ico"
                          IconIndex="0"
                          Advertise="yes" />
              </File>
              
              <!-- File associations -->
              <ProgId Id="TerraFusion.Ticket" Description="TerraFusion Support Ticket">
                <Extension Id="tfticket" ContentType="application/x-terrafusion-ticket">
                  <Verb Id="open" Command="Open" TargetFile="TerraFusionLauncher.exe" Argument='"%1"' />
                </Extension>
              </ProgId>
            </Component>
            
            <!-- Configuration files -->
            <Component Id="AppSettings" Guid="C2D3E4F5-A6B7-8C9D-0E1F-2A3B4C5D6E7F">
              <File Id="appsettings.json" Source="$(var.SourceDir)\appsettings.json" KeyPath="yes" />
            </Component>
            
            <!-- PWA files -->
            <Directory Id="PWAFolder" Name="pwa">
              <Component Id="PWAFiles" Guid="D3E4F5A6-B7C8-9D0E-1F2A-3B4C5D6E7F8A">
                <File Id="index.html" Source="$(var.SourceDir)\pwa\index.html" KeyPath="yes" />
                <File Id="manifest.json" Source="$(var.SourceDir)\pwa\manifest.json" />
                <File Id="service-worker.js" Source="$(var.SourceDir)\pwa\service-worker.js" />
              </Component>
            </Directory>
            
            <!-- AI Swarm components -->
            <Directory Id="SwarmFolder" Name="swarm">
              <Component Id="SwarmOrchestrator" Guid="E4F5A6B7-C8D9-0E1F-2A3B-4C5D6E7F8A9B">
                <File Id="belichick-orchestrator.js" 
                      Source="$(var.SourceDir)\swarm\belichick-orchestrator.js" 
                      KeyPath="yes" />
              </Component>
            </Directory>
            
            <!-- Database files -->
            <Directory Id="DatabaseFolder" Name="database">
              <Component Id="DatabaseSchema" Guid="F5A6B7C8-D9E0-1F2A-3B4C-5D6E7F8A9B0C">
                <File Id="InitialCreate.sql" 
                      Source="$(var.SourceDir)\database\InitialCreate.sql" 
                      KeyPath="yes" />
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
      
      <!-- Program Menu folder -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="TerraFusion Customer Service"/>
      </Directory>
      
      <!-- Desktop folder -->
      <Directory Id="DesktopFolder" Name="Desktop">
        <Component Id="DesktopShortcut" Guid="A6B7C8D9-E0F1-2A3B-4C5D-6E7F8A9B0C1D">
          <Shortcut Id="DesktopShortcut"
                    Name="TerraFusion Support"
                    Description="379,000,000× Faster Support"
                    Target="[INSTALLFOLDER]TerraFusion.Launcher.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="TerraFusion.ico"
                    IconIndex="0" />
          <RemoveFolder Id="DesktopFolder" On="uninstall"/>
          <RegistryValue Root="HKCU" 
                         Key="Software\TerraFusion\CustomerService" 
                         Name="DesktopShortcut" 
                         Type="integer" 
                         Value="1" 
                         KeyPath="yes"/>
        </Component>
      </Directory>
    </Directory>
    
    <!-- Component groups -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AppSettings" />
    </ComponentGroup>
    
    <ComponentGroup Id="WebView2Components" Directory="INSTALLFOLDER">
      <Component Id="WebView2Loader" Guid="B7C8D9E0-F1A2-3B4C-5D6E-7F8A9B0C1D2E">
        <File Id="WebView2Loader.dll" 
              Source="$(var.SourceDir)\WebView2Loader.dll" 
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
    
    <ComponentGroup Id="AISwarmComponents" Directory="SwarmFolder">
      <ComponentRef Id="SwarmOrchestrator" />
    </ComponentGroup>
    
    <ComponentGroup Id="DatabaseComponents" Directory="DatabaseFolder">
      <ComponentRef Id="DatabaseSchema" />
    </ComponentGroup>
    
    <!-- Custom actions -->
    <CustomAction Id="InstallWebView2"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />
    
    <CustomAction Id="ConfigureDatabase"
                  Directory="DatabaseFolder"
                  ExeCommand="sqlcmd -S localhost -i InitialCreate.sql"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />
    
    <CustomAction Id="RegisterWindowsAuth"
                  Directory="INSTALLFOLDER"
                  ExeCommand="netsh http add urlacl url=http://+:5000/ user=DOMAIN\user"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />
    
    <!-- Installation sequence -->
    <InstallExecuteSequence>
      <Custom Action="InstallWebView2" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="ConfigureDatabase" After="InstallWebView2">NOT Installed</Custom>
      <Custom Action="RegisterWindowsAuth" After="ConfigureDatabase">NOT Installed</Custom>
    </InstallExecuteSequence>
    
    <!-- UI configuration -->
    <UIRef Id="WixUI_FeatureTree" />
    <UIRef Id="WixUI_ErrorProgressText" />
    
    <!-- License agreement -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Dialog.bmp" />
  </Product>
</Wix>