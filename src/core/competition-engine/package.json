{
  "name": "terrafusion-os",
  "version": "1.0.0",
  "type": "module",
  "description": "Championship-level workspace for converting 14 Terrafusion web apps to native Tauri desktop applications",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "cargo tauri dev",
    "dev:shared": "npm run build:shared -- --watch",
    "dev:apps": "concurrently --kill-others-on-fail \"npm run dev --workspace=apps/11-terra-fusion-dashboard\" \"npm run dev --workspace=apps/08-costforge-ai\"",
    "build": "npm run build:shared && npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "cargo tauri build",
    "build:all": "./infrastructure/scripts/build-all-apps.sh",
    "build:shared": "echo 'Shared workspaces not implemented yet - skipping'",
    "build:apps": "concurrently \"npm run build --workspace=apps/01-terra-agent\" \"npm run build --workspace=apps/02-terra-flow\" \"npm run build --workspace=apps/03-web-audit-tracker\" \"npm run build --workspace=apps/04-terra-levy\" \"npm run build --workspace=apps/05-terra-miner\" \"npm run build --workspace=apps/06-terra-fusion-sync\" \"npm run build --workspace=apps/07-gispro\" \"npm run build --workspace=apps/08-costforge-ai\" \"npm run build --workspace=apps/09-property-workbench\" \"npm run build --workspace=apps/10-terra-insight\" \"npm run build --workspace=apps/11-terra-fusion-dashboard\" \"npm run build --workspace=apps/12-terra-fusion-assessor\" \"npm run build --workspace=apps/13-marketplace\" \"npm run build --workspace=apps/14-terra-collections\"",
    "convert": "./infrastructure/scripts/convert-app.sh",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration:run": "./scripts/run-integration-tests.sh",
    "test:frontend": "vitest",
    "test:backend": "cargo test",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist coverage test-results logs reports",
    "precommit": "lint-staged",
    "postinstall": "npm run build:shared",
    "tauri": "tauri",
    "init-workspace": "./infrastructure/scripts/init-workspace.sh",
    "championship:convert": "./championship/deploy-conversion.sh",
    "championship:convert-all": "./championship/convert-all-apps.sh",
    "championship:monitor": "./championship/scoreboard/monitor.sh",
    "championship:audit": "./scripts/championship-audit.sh",
    "championship:build": "./scripts/championship-build-all.sh",
    "championship:test": "./scripts/run-integration-tests.sh --coverage-threshold 90 --performance-threshold 5000",
    "championship:deploy": "./scripts/local-deploy.sh",
    "lint:check": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test:full": "jest --coverage --watchAll=false",
    "test:visual": "node testing-suite/ultimate-testing-framework.js --mode=visual",
    "test:performance": "node testing-suite/ultimate-testing-framework.js --mode=performance",
    "test:ai-swarm": "node testing-suite/ultimate-testing-framework.js --mode=swarm",
    "test:critical": "jest --testPathPattern=\"(critical|smoke)\" --bail",
    "test:smoke": "jest --testPathPattern=smoke --bail",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "audit:security": "node scripts/audit-security.js",
    "audit:deps": "npm audit --audit-level=moderate",
    "coverage": "nyc report --reporter=html && open coverage/index.html",
    "dev:setup": "./scripts/team-setup.sh",
    "dev:utils": "node scripts/dev-utils.js",
    "dev:health": "node scripts/dev-utils.js health",
    "build:analyze": "npm run build && npx webpack-bundle-analyzer dist/static/js/*.js",
    "deploy:staging": "./scripts/deploy-to-staging.sh",
    "deploy:production": "./scripts/deploy-to-production.sh",
    "quality:full": "npm run lint && npm run type-check && npm run test:full && npm run audit:security"
  },
  "keywords": [
    "tauri",
    "desktop",
    "native",
    "terrafusion",
    "government",
    "infrastructure",
    "championship"
  ],
  "author": "Terrafusion Championship Team",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^1.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.279.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "tailwindcss": "^3.3.3",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.40.0",
    "@tauri-apps/cli": "^1.5.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "@vitejs/plugin-react": "^4.0.4",
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-playwright": "^0.18.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-watch-typeahead": "^2.2.2",
    "lint-staged": "^15.1.0",
    "postcss": "^8.4.28",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^4.4.9",
    "vitest": "^0.34.3"
  },
  "workspaces": [
    "modules/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests",
      "<rootDir>/shared",
      "<rootDir>/apps"
    ],
    "testMatch": [
      "**/__tests__/**/*.(ts|tsx|js)",
      "**/*.(test|spec).(ts|tsx|js)"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/*/src/**/*.{ts,tsx}",
      "shared/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/coverage/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 90,
        "statements": 90
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test-utils/jest-setup.ts"
    ],
    "testTimeout": 30000,
    "maxWorkers": 4,
    "verbose": true
  }
}
