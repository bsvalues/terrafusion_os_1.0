# TerraFusion Web Production Environment
# SUPREME DEPLOYMENT COMMANDER - WEB CONFIGURATION

# Application Configuration
VITE_APP_NAME="TerraFusion County OS"
VITE_APP_VERSION="1.0.0-championship"
VITE_APP_TAGLINE="Government. Transcended."

# API Configuration
VITE_API_BASE_URL="https://api.terrafusionmarket.io"
VITE_API_VERSION="v1"

# Feature Flags
VITE_ENABLE_AI_COSTFORGE=true
VITE_ENABLE_BENTON_DEMO=true
VITE_ENABLE_ALL_MODULES=true
VITE_ENABLE_ANALYTICS=true

# Performance Settings
VITE_CHUNK_SIZE_WARNING=1000
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Deployment Settings
VITE_DEPLOYMENT_TARGET="web"
VITE_BUILD_TARGET="production"

# County Data
VITE_BENTON_PROPERTIES_COUNT="94149"
VITE_ACTIVE_COUNTIES="10"
VITE_SPEED_IMPROVEMENT="379000000"

# Branding
VITE_BRAND_PRIMARY_COLOR="#00d2ff"
VITE_BRAND_SECONDARY_COLOR="#667eea"
VITE_BRAND_ACCENT_COLOR="#22d3ee"

# Analytics
VITE_GOOGLE_ANALYTICS_ID=""
VITE_ENABLE_ERROR_REPORTING=true

# Security
VITE_ENABLE_CSP=true
VITE_SECURE_HEADERS=true