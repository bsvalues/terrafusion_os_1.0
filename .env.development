# ===== Core =====
TF_ENV=demo
COUNTY_NAME=Benton County, WA
COUNTY_CODE=US-WA-BENTON

# ===== Networking =====
TF_NETWORK=terrafusion_demo
TF_SUBNET=172.30.10.0/24

# ===== Postgres / PostGIS =====
POSTGRES_USER=terrafusion
POSTGRES_PASSWORD=replace_me_local_dev_password
POSTGRES_DB=terrafusion
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== App Secrets (demo values) =====
JWT_SECRET=replace_me_local_jwt_secret
ENCRYPTION_KEY=replace_me_local_32_byte_key

# ===== AI / MCP (optional) =====
MCP_ENABLED=true
MCP_ENDPOINT=http://core:8080/mcp

# ===== Demo Configuration =====
DEMO_MODE=true
USE_STATIC_DATA=true

# ===== Paths =====
DATA_DIR=./data/benton
ARTIFACTS_DIR=./artifacts/benton
