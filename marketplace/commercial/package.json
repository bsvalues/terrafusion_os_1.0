{
  "name": "@terrafusion/commercial",
  "version": "1.0.0",
  "description": "Commercial licensing and ROI calculation system for Terrafusion OS",
  "main": "LicensingSystem.ts",
  "scripts": {
    "start": "ts-node LicensingSystem.ts",
    "dev": "ts-node --watch LicensingSystem.ts",
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src tests --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write src tests",
    "lint:fix": "eslint src tests --ext .ts,.tsx,.js,.jsx --fix",
    "format:check": "prettier --check src tests",
    "quality": "npm run lint && npm run format:check",
    "quality:fix": "npm run lint:fix && npm run format",
    "government:compliance": "npm run lint -- --rule 'jsx-a11y/*: error' --rule 'security/*: error'",
    "precommit": "npm run quality && npm test"
  },
  "dependencies": {
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "stripe": "^12.0.0",
    "express": "^4.18.0",
    "@types/express": "^4.17.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "prettier": "^3.2.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint-plugin-security": "^2.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0"
  },
  "keywords": [
    "commercial",
    "licensing",
    "roi",
    "government",
    "billing",
    "terrafusion"
  ],
  "author": "Terrafusion OS Team",
  "license": "Commercial",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/terrafusion-os"
  },
  "terrafusion": {
    "module": true,
    "category": "commercial",
    "government-compliant": true,
    "billing-enabled": true,
    "licensing-required": true
  }
}
