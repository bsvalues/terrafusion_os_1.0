{
  "name": "geospatial-mcp-server",
  "description": "MCP Server for geospatial",
  "version": "1.0.0",
  "category": "government-core",
  "capabilities": [],
  "tools": [
    "compliance-validator",
    "audit-trail-generator",
    "citizen-service-interface"
  ],
  "integration": {
    "terrafusionOS": true,
    "aiSwarm": false,
    "government": true
  },
  "transport": {
