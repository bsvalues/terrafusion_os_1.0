# TerraFusion Government EditorConfig
# THE TERRAFUSION WAY - Consistent coding standards

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,ts,tsx,jsx,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{py,rb,go}]
indent_size = 4

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf
