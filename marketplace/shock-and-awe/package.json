{
  "name": "@terrafusion/shock-and-awe",
  "version": "1.0.0",
  "description": "TerraFusion Shock & Awe - Revolutionary AI Government Demonstrations",
  "main": "src/main.tsx",
  "homepage": "https://shock-and-awe.terrafusionmarket.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:production": "node scripts/build-static.cjs",
    "package:deployment": "tar -czf terrafusion-deployment.tar.gz -C dist .",
    "preview": "vite preview",
    "deploy:hostinger:ps": "pwsh -ExecutionPolicy Bypass -File ./deploy-hostinger.ps1",
    "validate:deployment": "pwsh -ExecutionPolicy Bypass -File ./scripts/validate-deployment.ps1",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "validate": "npm run type-check && npm run lint && npm run test && npm run build",
    "clean": "rimraf dist",
    "cleanup:tauri": "rimraf src-tauri && rimraf src/hooks/useTauriCommands.ts",
    "quality": "npm run lint && npm run format:check",
    "quality:fix": "npm run lint:fix && npm run format",
    "government:compliance": "npm run lint -- --rule 'jsx-a11y/*: error' --rule 'security/*: error'",
    "precommit": "npm run quality && npm test"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.16",
    "@mui/material": "^5.14.17",
    "@react-three/drei": "^9.88.17",
    "@react-three/fiber": "^8.15.11",
    "@types/three": "^0.158.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.158.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.1.1",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "cssnano": "^7.1.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "eslint-plugin-security": "^2.1.0",
    "jsdom": "^22.1.0",
    "postcss-preset-env": "^10.4.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "terrafusion",
    "shock-and-awe",
    "ai-agents",
    "quantum-processing",
    "consciousness-evolution",
    "government-ai",
    "react",
    "typescript",
    "three-js",
    "static-web"
  ],
  "author": "TerraFusion Shock & Awe Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terrafusion/shock-and-awe"
  },
  "bugs": {
    "url": "https://github.com/terrafusion/shock-and-awe/issues"
  },
  "terrafusion": {
    "module": true,
    "category": "web-static",
    "ai-agents": 50247,
    "quantum-processing": true,
    "consciousness-evolution": true,
    "government-compliant": true,
    "production-ready": true,
    "tauri-enabled": false,
    "deployment-target": "hostinger-static"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
