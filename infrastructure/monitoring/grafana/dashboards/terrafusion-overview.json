{
  "dashboard": {
    "id": null,
    "title": "Terrafusion OS - System Overview",
    "tags": ["terrafusion", "overview", "government"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "System Health Overview",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"terrafusion-api\"}",
            "legendFormat": "API Health"
          },
          {
            "expr": "terrafusion_ai_agents_active",
            "legendFormat": "AI Agents Active"
          },
          {
            "expr": "terrafusion_modules_healthy",
            "legendFormat": "Healthy Modules"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 0.8},
                {"color": "green", "value": 0.95}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "AI Swarm Performance",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(terrafusion_ai_tasks_completed_total[5m])",
            "legendFormat": "Tasks/sec"
          },
          {
            "expr": "terrafusion_ai_swarm_efficiency",
            "legendFormat": "Swarm Efficiency"
          },
          {
            "expr": "terrafusion_ai_agents_active",
            "legendFormat": "Active Agents"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "barAlignment": 0,
              "lineWidth": 1,
              "fillOpacity": 10,
              "gradientMode": "none",
              "spanNulls": false,
              "insertNulls": false,
              "showPoints": "never",
              "pointSize": 5,
              "stacking": {"mode": "none", "group": "A"},
              "axisPlacement": "auto",
              "axisLabel": "",
              "axisColorMode": "text",
              "scaleDistribution": {"type": "linear"},
              "axisCenteredZero": false,
              "hideFrom": {"legend": false, "tooltip": false, "vis": false},
              "thresholdsStyle": {"mode": "off"}
            },
            "color": {"mode": "palette-classic"},
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Module Health Matrix",
        "type": "heatmap",
        "targets": [
          {
            "expr": "terrafusion_module_health_score",
            "legendFormat": "{{ module_name }}"
          }
        ],
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "API Performance Metrics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(terrafusion_api_request_duration_seconds_bucket[5m])) * 1000",
            "legendFormat": "95th Percentile (ms)"
          },
          {
            "expr": "histogram_quantile(0.50, rate(terrafusion_api_request_duration_seconds_bucket[5m])) * 1000",
            "legendFormat": "50th Percentile (ms)"
          },
          {
            "expr": "rate(terrafusion_api_requests_total[5m])",
            "legendFormat": "Requests/sec"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18}
      },
      {
        "id": 5,
        "title": "Database Performance",
        "type": "timeseries",
        "targets": [
          {
            "expr": "terrafusion_db_connections_active",
            "legendFormat": "Active Connections"
          },
          {
            "expr": "rate(terrafusion_db_queries_total[5m])",
            "legendFormat": "Queries/sec"
          },
          {
            "expr": "histogram_quantile(0.95, rate(terrafusion_db_query_duration_seconds_bucket[5m])) * 1000",
            "legendFormat": "Query Time 95th (ms)"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18}
      },
      {
        "id": 6,
        "title": "Government Compliance Metrics",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(terrafusion_audit_logs_total[5m]) * 300",
            "legendFormat": "Audit Logs/5min"
          },
          {
            "expr": "terrafusion_fisma_compliance_score",
            "legendFormat": "FISMA Score"
          },
          {
            "expr": "terrafusion_security_events_total",
            "legendFormat": "Security Events"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 80},
                {"color": "green", "value": 95}
              ]
            },
            "unit": "short"
          }
        },
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 26}
      },
      {
        "id": 7,
        "title": "Resource Utilization",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{namespace=\"terrafusion-production\"}[5m]) * 100",
            "legendFormat": "CPU Usage %"
          },
          {
            "expr": "container_memory_usage_bytes{namespace=\"terrafusion-production\"} / container_spec_memory_limit_bytes * 100",
            "legendFormat": "Memory Usage %"
          },
          {
            "expr": "rate(container_network_receive_bytes_total{namespace=\"terrafusion-production\"}[5m])",
            "legendFormat": "Network In"
          },
          {
            "expr": "rate(container_network_transmit_bytes_total{namespace=\"terrafusion-production\"}[5m])",
            "legendFormat": "Network Out"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {},
    "templating": {
      "list": [
        {
          "name": "environment",
          "type": "constant",
          "current": {
            "value": "production",
            "text": "production"
          },
          "options": [
            {
              "value": "production",
              "text": "production"
            }
          ]
        },
        {
          "name": "cluster",
          "type": "query",
          "query": "label_values(up, cluster)",
          "refresh": 1,
          "includeAll": false,
          "multi": false
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "enable": true,
          "datasource": "Terrafusion Prometheus",
          "expr": "terrafusion_deployment_event",
          "titleFormat": "Deployment",
          "textFormat": "{{ deployment_version }}",
          "iconColor": "rgba(0, 211, 255, 1)"
        }
      ]
    },
    "refresh": "30s",
    "schemaVersion": 30,
    "version": 1,
    "links": [
      {
        "title": "Terrafusion Documentation",
        "url": "https://docs.terrafusion.gov",
        "type": "link",
        "icon": "doc"
      },
      {
        "title": "Government Compliance Dashboard",
        "url": "/d/compliance",
        "type": "link",
        "icon": "bolt"
      }
    ]
  }
}