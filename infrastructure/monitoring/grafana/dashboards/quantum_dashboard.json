{
  "dashboard": {
    "id": null,
    "uid": "terrafusion-quantum",
    "title": "Terrafusion Quantum Monitoring",
    "tags": ["quantum", "qubits", "fidelity", "coherence", "terrafusion"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-2h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
        "type": "graph",
        "title": "Quantum Processor States",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "quantum_processor_state{processor=~\"QP-.*\"}",
            "legendFormat": "{{processor}} - {{state}}",
            "refId": "A"
          }
        ],
        "yaxes": [{ "format": "short" }, { "format": "short" }],
        "colors": ["#1F60C4", "#37872D", "#FA6400", "#C4162A", "#8440A1"]
      },
      {
        "id": 2,
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
        "type": "graph",
        "title": "Coherence Times (T1/T2)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "quantum_coherence_t1{processor=\"$processor\"}",
            "legendFormat": "T1 - {{qubit}}",
            "refId": "A"
          },
          {
            "expr": "quantum_coherence_t2{processor=\"$processor\"}",
            "legendFormat": "T2 - {{qubit}}",
            "refId": "B"
          }
        ],
        "yaxes": [{ "format": "µs", "min": 0 }, { "format": "short" }]
      },
      {
        "id": 3,
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
        "type": "graph",
        "title": "Gate Fidelities",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "quantum_gate_fidelity{gate_type=\"single_qubit\"}",
            "legendFormat": "Single Qubit",
            "refId": "A"
          },
          {
            "expr": "quantum_gate_fidelity{gate_type=\"two_qubit\"}",
            "legendFormat": "Two Qubit",
            "refId": "B"
          }
        ],
        "yaxes": [
          { "format": "percentunit", "min": 0.98, "max": 1.0 },
          { "format": "short" }
        ],
        "thresholds": [{ "value": 0.99, "colorMode": "critical" }]
      },
      {
        "id": 4,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "type": "heatmap",
        "title": "Quantum State Fidelity Matrix",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "quantum_state_fidelity{processor=\"$processor\"}",
            "format": "heatmap",
            "legendFormat": "{{qubit1}}-{{qubit2}}",
            "refId": "A"
          }
        ],
        "dataFormat": "timeseries",
        "yAxis": {
          "format": "short",
          "decimals": 0
        },
        "color": {
          "colorScheme": "spectrum",
          "exponent": 0.5,
          "mode": "spectrum"
        }
      },
      {
        "id": 5,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "type": "graph",
        "title": "Entanglement Metrics",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "quantum_entanglement_fidelity{state=\"bell\"}",
            "legendFormat": "Bell State Fidelity",
            "refId": "A"
          },
          {
            "expr": "quantum_entanglement_concurrence",
            "legendFormat": "Concurrence",
            "refId": "B"
          },
          {
            "expr": "quantum_entanglement_negativity",
            "legendFormat": "Negativity",
            "refId": "C"
          }
        ],
        "yaxes": [
          { "format": "percentunit", "min": 0, "max": 1 },
          { "format": "short" }
        ]
      },
      {
        "id": 6,
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
        "type": "graph",
        "title": "Decoherence Rates",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "quantum_decoherence_rate{type=\"amplitude_damping\"}",
            "legendFormat": "Amplitude Damping",
            "refId": "A"
          },
          {
            "expr": "quantum_decoherence_rate{type=\"phase_damping\"}",
            "legendFormat": "Phase Damping",
            "refId": "B"
          },
          {
            "expr": "quantum_decoherence_rate{type=\"depolarizing\"}",
            "legendFormat": "Depolarizing",
            "refId": "C"
          }
        ],
        "yaxes": [{ "format": "Hz", "logBase": 10 }, { "format": "short" }]
      },
      {
        "id": 7,
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
        "type": "graph",
        "title": "Environmental Factors",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "quantum_environment_temperature{sensor=\"mixing_chamber\"}",
            "legendFormat": "Temperature (mK)",
            "refId": "A"
          },
          {
            "expr": "quantum_environment_vibration{axis=\"rms\"}",
            "legendFormat": "Vibration (m/s²)",
            "refId": "B"
          },
          {
            "expr": "quantum_environment_magnetic_field{sensor=\"hall_probe_1\"}",
            "legendFormat": "Magnetic Field (nT)",
            "refId": "C"
          }
        ],
        "yaxes": [{ "format": "short", "logBase": 10 }, { "format": "short" }]
      },
      {
        "id": 8,
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
        "type": "bargauge",
        "title": "Quantum Volume by Processor",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "quantum_volume{processor=~\"QP-.*\"}",
            "legendFormat": "{{processor}}",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 32 },
                { "color": "green", "value": 256 }
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
        "type": "table",
        "title": "Quantum Error Correction Status",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "quantum_error_correction_status",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true
              },
              "renameByName": {
                "processor": "Processor",
                "code_type": "Error Code",
                "distance": "Distance",
                "logical_error_rate": "Logical Error Rate",
                "threshold": "Threshold"
              }
            }
          }
        ]
      },
      {
        "id": 10,
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 32 },
        "type": "stat",
        "title": "Quantum Health Score",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "quantum_health_score",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 60 },
                { "color": "green", "value": 90 }
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 11,
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 32 },
        "type": "stat",
        "title": "Active Qubits",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(quantum_active_qubits)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center"
        }
      },
      {
        "id": 12,
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 32 },
        "type": "stat",
        "title": "Avg Gate Fidelity",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "avg(quantum_gate_fidelity)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.98 },
                { "color": "green", "value": 0.995 }
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 13,
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 32 },
        "type": "stat",
        "title": "Entanglement Pairs",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(quantum_entangled_pairs)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center"
        }
      },
      {
        "id": 14,
        "gridPos": { "h": 4, "w": 4, "x": 16, "y": 32 },
        "type": "stat",
        "title": "Quantum Anomalies",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(quantum_anomalies_active)",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        }
      },
      {
        "id": 15,
        "gridPos": { "h": 4, "w": 4, "x": 20, "y": 32 },
        "type": "stat",
        "title": "Corrections Applied",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "increase(quantum_corrections_total[1h])",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center"
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "processor",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(quantum_processor_state, processor)",
          "multi": false,
          "includeAll": false,
          "current": {
            "text": "QP-1",
            "value": "QP-1"
          }
        },
        {
          "name": "qubit_range",
          "type": "textbox",
          "query": "0:19",
          "current": {
            "text": "0:19",
            "value": "0:19"
          }
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "quantum_error_correction_event",
          "name": "Error Corrections",
          "tagKeys": "processor,error_type",
          "titleFormat": "QEC: {{ error_type }}",
          "textFormat": "Applied on {{ processor }}"
        },
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "quantum_calibration_event",
          "name": "Calibrations",
          "tagKeys": "processor,gate_type",
          "titleFormat": "Calibration: {{ gate_type }}",
          "textFormat": "Processor {{ processor }}"
        }
      ]
    }
  }
}
