{
  "id": "geoanalytics",
  "name": "GeoAnalytics",
  "description": "Advanced geospatial analytics for property data",
  "version": "1.0.0",
  "entryPoint": "/apps/geoanalytics/frontend/index.tsx",
  "api": "/apps/geoanalytics/backend/main.py",
  "icon": "📊",
  "tags": ["analytics", "geospatial", "visualization", "plugin"],
  "category": "Analytics",
  "k8s": "/apps/geoanalytics/k8s",
  "enabled": true,
  "launchModes": {
    "codespaces": {
      "url": "https://github.com/your-org/terrafusion/codespaces/new?service=geoanalytics",
      "label": "Open in GitHub Codespaces",
      "icon": "🌐"
    },
    "electron": {
      "url": "electron://geoanalytics",
      "label": "Launch Desktop App",
      "icon": "🖥️"
    },
    "docker": {
      "command": "docker-compose -f apps/geoanalytics/docker-compose.yml up",
      "label": "Run with Docker",
      "icon": "🐳"
    },
    "kubernetes": {
      "command": "bash scripts/deploy_geoanalytics.sh",
      "label": "Deploy to K8s",
      "icon": "☸️"
    }
  },
  "permissions": [
    "property:read",
    "analytics:execute",
    "export:data"
  ],
  "config": {
    "defaultRadius": 1000,
    "maxRadius": 10000,
    "cacheTTL": 3600
  }
}