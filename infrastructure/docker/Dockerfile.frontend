# TerraFusion Frontend Production Dockerfile
# Multi-stage build for optimized React 18 + Electron container

# Build stage
FROM node:18-alpine AS build
WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/*

# Copy package files
COPY frontend/package*.json ./
COPY package*.json ../

# Install dependencies
RUN npm ci --only=production

# Copy source code
COPY frontend/ .

# Build application
RUN npm run build

# Production stage - nginx for serving static files
FROM nginx:1.25-alpine AS runtime

# Install security updates
RUN apk update && \
    apk upgrade && \
    apk add --no-cache \
        curl \
        tzdata && \
    rm -rf /var/cache/apk/*

# Copy custom nginx configuration
COPY infrastructure/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infrastructure/nginx/default.conf /etc/nginx/conf.d/default.conf

# Copy built application
COPY --from=build /app/dist /usr/share/nginx/html

# Copy security headers configuration
COPY infrastructure/nginx/security-headers.conf /etc/nginx/conf.d/security-headers.conf

# Create nginx user and set permissions
RUN addgroup -g 1000 nginx-terrafusion && \
    adduser -D -s /bin/sh -u 1000 -G nginx-terrafusion nginx-terrafusion && \
    chown -R nginx-terrafusion:nginx-terrafusion /usr/share/nginx/html && \
    chown -R nginx-terrafusion:nginx-terrafusion /var/cache/nginx && \
    chown -R nginx-terrafusion:nginx-terrafusion /var/log/nginx

# Switch to non-root user
USER nginx-terrafusion

# Expose port
EXPOSE 80 443

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]

# Metadata labels
LABEL maintainer="TerraFusion DevOps Team <devops@terrafusion.com>" \
      org.opencontainers.image.title="TerraFusion Frontend" \
      org.opencontainers.image.description="TerraFusion OS Government AI Platform Frontend" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.vendor="TerraFusion" \
      org.opencontainers.image.licenses="Proprietary" \
      org.opencontainers.image.source="https://github.com/terrafusion/terrafusion-os" \
      security.compliance="FISMA" \
      security.scan-date="2025-08-31"