{
  "all": true,
  "check-coverage": true,
  "lines": 95,
  "functions": 95,
  "branches": 90,
  "statements": 95,
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "exclude": [
    "**/*.d.ts",
    "**/*.test.*",
    "**/*.spec.*",
    "**/node_modules/**",
    "**/coverage/**",
    "**/dist/**"
  ],
  "reporter": [
    "text",
    "html",
    "lcov",
    "json-summary"
  ],
  "report-dir": "coverage",
  "temp-dir": ".nyc_output"
}
