# TerraFusion Championship Production Environment
# 379M× Faster Property Valuations - Government OS Platform

# Application Environment
# NODE_ENV=production  # Removed - Vite doesn't support NODE_ENV in .env files
TAURI_ENV=production
RUST_LOG=info
RUST_BACKTRACE=1
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Server Configuration
HOST=127.0.0.1
PORT=8000
WORKERS=4
TIMEOUT=120
KEEPALIVE=2
MAX_REQUESTS=10000
MAX_REQUESTS_JITTER=1000

# Database Configuration
DATABASE_URL=/opt/terrafusion/championship/data/terrafusionsync_94k.db
DATABASE_BACKUP_URL=/opt/terrafusion/championship/data/terrafusionsync_backup.db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_RECYCLE=3600

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_CACHE_TTL=3600

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8001
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_HOST=localhost:11434
HYBRID_LLM_ENABLED=true
AI_CACHE_ENABLED=true
AI_TIMEOUT=30

# Security Configuration
SECRET_KEY=your_super_secret_production_key_here_change_this
JWT_SECRET_KEY=your_jwt_secret_key_here_change_this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://terrafusion.gov,https://api.terrafusion.gov,https://www.terrafusion.gov
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# SSL Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/terrafusion.crt
SSL_KEY_PATH=/etc/ssl/private/terrafusion.key
SSL_CA_CERT_PATH=/etc/ssl/certs/ca-certificates.crt

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/terrafusion/app.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=10
LOG_ROTATE_WHEN=midnight

# Monitoring Configuration
MONITORING_ENABLED=true
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# Performance Configuration
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600
CACHE_MAX_SIZE=1000000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=1000/minute
COMPRESSION_ENABLED=true

# Business Configuration
MARKETPLACE_COMMISSION_RATE=0.30
VALUATION_SPEED_TARGET_MS=3000
PROPERTIES_LOADED=94149
COUNTIES_SUPPORTED=1
REVENUE_TRACKING_ENABLED=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=3600
BACKUP_RETENTION_DAYS=30
BACKUP_DIRECTORY=/opt/terrafusion/backups
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_GPG_RECIPIENT=backup@terrafusion.gov

# Email Configuration (for alerts)
SMTP_HOST=smtp.terrafusion.gov
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=alerts@terrafusion.gov
SMTP_PASSWORD=your_smtp_password_here
FROM_EMAIL=noreply@terrafusion.gov

# Webhook Configuration
WEBHOOK_ENABLED=true
WEBHOOK_SECRET=your_webhook_secret_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Development/Debug (disabled in production)
DEBUG=false
DEVELOPMENT_MODE=false
API_DOCS_ENABLED=false
PROFILING_ENABLED=false

# Feature Flags
BATCH_VALUATION_ENABLED=true
AI_INSIGHTS_ENABLED=true
REAL_TIME_UPDATES_ENABLED=true
MARKETPLACE_ENABLED=true
MULTI_TENANT_ENABLED=false

# Regional Configuration
TIMEZONE=America/Los_Angeles
LOCALE=en_US
CURRENCY=USD
DEFAULT_COUNTY=Benton
DEFAULT_STATE=WA

# Third-party Integrations
MARSHALL_SWIFT_ENABLED=false
ESRI_API_KEY=your_esri_api_key_here
MAPBOX_API_KEY=your_mapbox_api_key_here

# Resource Limits
MAX_UPLOAD_SIZE=52428800  # 50MB
MAX_BATCH_SIZE=10000
MAX_CONCURRENT_REQUESTS=1000
REQUEST_TIMEOUT=30

# CDN Configuration
CDN_ENABLED=false
CDN_URL=https://cdn.terrafusion.gov
STATIC_FILES_URL=/static

# Analytics
ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
HOTJAR_ENABLED=false